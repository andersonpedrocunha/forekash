{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forekash",
  "compatibility_date": "2026-05-19",

  // O Worker existe por causa do MR KASH no Slack: avisos no cron e resposta
  // quando chamam. Tudo que não começa com /api/ ele devolve pro ASSETS, então
  // o site continua servido exatamente como antes de ele existir.
  "main": "./src/worker.js",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sem isto o SPA responderia index.html para /api/* e o Slack nunca
    // chegaria no Worker.
    "run_worker_first": ["/api/*"]
  },

  // Dispara todo dia 17:30 em São Paulo (20:30 UTC — o Brasil não tem mais
  // horário de verão). Qual dia é de falar fica no código, não aqui.
  "triggers": { "crons": ["30 20 * * *"] },

  // Configuração não-secreta mora AQUI, não no painel.
  // Variável de texto criada pelo painel é apagada no deploy seguinte: o
  // wrangler troca a lista inteira pela que está neste arquivo. Foi o que
  // zerou a SUPABASE_URL e produziu "Invalid URL: undefined/rest/v1/...".
  // Secret sobrevive ao deploy; variável de texto, não. Então as quatro
  // chaves continuam como Secret no painel e o resto fica versionado.
  "vars": {
    "SUPABASE_URL": "https://xgjqnwdhqlxhkgwowwej.supabase.co",
    "FOREKASH_ORG_ID": "c7ba3646-2b74-49d5-acc2-b363352d06ed",
    "ANTHROPIC_WORKSPACE_ID": "wrkspc_0174fz36C7RtPvEkfqsJBDJn",
    "SLACK_CANAL_EQUIPE": "G5CT0UF9T",
    "MRK_SLACK_USERS": "U02H4P23B"
  },

  "observability": { "enabled": true }
}
