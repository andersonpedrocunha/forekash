{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forekash",
  "compatibility_date": "2026-05-19",

  // O Worker existe por causa do MR KASH no Slack: avisos no cron e resposta
  // quando chamam. Tudo que não começa com /api/ ele devolve pro ASSETS, então
  // o site continua servido exatamente como antes de ele existir.
  "main": "./src/worker.js",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    /* 404 DE VERDADE, e não o app inteiro com status 200.
    // Com single-page-application qualquer caminho inexistente devolvia o
    // index.html (8,6 MB) respondendo 200 — foi o que disfarçou o problema do
    // /deck, descrito logo abaixo. Um <script src> com typo, um fetch num
    // endpoint errado ou um asset renomeado voltavam "200 OK, tome HTML".
    // Seguro aqui porque o app não tem rota por caminho: start_url e scope são
    // "/", o único replaceState só limpa a query, e o fallback offline é do
    // sw.js (caches.match('/index.html')), não do servidor. */
    "not_found_handling": "404-page",
    // Sem isto o SPA responderia index.html para /api/* e o Slack nunca
    // chegaria no Worker. O mesmo vale pro /deck: a apresentação ao vivo é
    // servida pelo Worker, e sem estar nesta lista ela abria o app inteiro
    // em vez do deck — e ainda por cima com 200, que disfarça o problema.
    "run_worker_first": ["/api/*", "/deck", "/deck/*"]
  },

  // A cada 10 minutos. De hora em hora não servia: o Worker só conseguia
  // comparar a HORA, então um aviso marcado pras 14:30 saía às 14:00 e o
  // campo de minuto na tela era decoração. A janela de 10 min em
  // vaiDisparar() tem que continuar igual a este intervalo.
  "triggers": { "crons": ["*/10 * * * *"] },

  // Configuração não-secreta mora AQUI, não no painel.
  // Variável de texto criada pelo painel é apagada no deploy seguinte: o
  // wrangler troca a lista inteira pela que está neste arquivo. Foi o que
  // zerou a SUPABASE_URL e produziu "Invalid URL: undefined/rest/v1/...".
  // Secret sobrevive ao deploy; variável de texto, não. Então as quatro
  // chaves continuam como Secret no painel e o resto fica versionado.
  "vars": {
    "SUPABASE_URL": "https://xgjqnwdhqlxhkgwowwej.supabase.co",
    "FOREKASH_ORG_ID": "c7ba3646-2b74-49d5-acc2-b363352d06ed",
    "ANTHROPIC_WORKSPACE_ID": "wrkspc_0174fz36C7RtPvEkfqsJBDJn",
    "SLACK_CANAL_EQUIPE": "G5CT0UF9T",
    "MRK_SLACK_USERS": "U02H4P23B"
  },

  // Onde mora a instalação do Slack de cada workspace: team_id → org +
  // bot token. KV e não Supabase de propósito — o token do bot é credencial
  // do workspace inteiro, e o `module_blobs` é lido pelo navegador. Aqui só
  // o Worker alcança.
  "kv_namespaces": [
    { "binding": "SLACK_INSTALLS", "id": "ce8b987149d6492e95d1864355878320" }
  ],

  "observability": { "enabled": true }
}
