  const el = document.getElementById('imp-regime-bar');
  if(!el) return;
  const regime = impostos.regimeTributario || '';

  const pills = Object.keys(IMP_REGIMES).map(k => {
    const info = IMP_REGIMES[k];
    const cls = (k === regime) ? 'imp-regime-opt active' : 'imp-regime-opt';
    return `<button class="${cls}" onclick="setImpRegime('${k}')" title="${esc(info.desc)}">${esc(info.label)}</button>`;
  }).join('');

  // Controles contextuais de acordo com o regime
  let cfg = '';
  if(regime === 'simples'){
    cfg = `
      <div class="imp-regime-ctrl">
        <label>Alíquota DAS</label>
        <div class="imp-regime-inpwrap">
          <input type="text" value="${fmtBR(impostos.simplesAliquota, 2)}"
                 onblur="setImpSimplesAliquota(this.value)"
                 onkeydown="if(event.key==='Enter')this.blur()"
                 onfocus="this.select()">
          <span>%</span>
        </div>
      </div>`;
  } else if(regime === 'presumido' || regime === 'real'){
    const atvOpts = [
      { k:'servicos',  lbl:'Serviços' },
      { k:'comercio',  lbl:'Comércio' },
      { k:'industria', lbl:'Indústria' }
    ].map(o => `<button class="imp-regime-sub${impostos.atividade===o.k?' active':''}" onclick="setImpAtividade('${o.k}')">${o.lbl}</button>`).join('');
    cfg = `
      <div class="imp-regime-ctrl">
        <label>Atividade principal</label>
        <div class="imp-regime-subs">${atvOpts}</div>
      </div>`;
    if(impostos.atividade === 'servicos'){
      cfg += `
        <div class="imp-regime-ctrl">
          <label>Alíquota ISS</label>
          <div class="imp-regime-inpwrap">
            <input type="text" value="${fmtBR(impostos.issAliquota, 2)}"
                   onblur="setImpIssAliquota(this.value)"
                   onkeydown="if(event.key==='Enter')this.blur()"
                   onfocus="this.select()">
            <span>%</span>
          </div>
        </div>`;
    }
    // INSS RB (CPRB) — opcional. Se a empresa não paga CPRB, deixa em 0.
    cfg += `
      <div class="imp-regime-ctrl">
        <label title="Contribuição Previdenciária sobre a Receita Bruta (CPRB). Deixe 0 se não se aplica.">Alíquota INSS RB</label>
        <div class="imp-regime-inpwrap">
          <input type="text" value="${fmtBR(impostos.inssAliquota, 2)}"
                 onblur="setImpInssAliquota(this.value)"
                 onkeydown="if(event.key==='Enter')this.blur()"
                 onfocus="this.select()"
                 placeholder="0,00">
          <span>%</span>
        </div>
      </div>`;
    // Apuração mensal ou trimestral do IRPJ/CSLL — disponível no Lucro Presumido e no Lucro Real
    if(regime === 'presumido' || regime === 'real'){
      const apur = (impostos.apuracao === 'trimestral') ? 'trimestral' : 'mensal';
      const baseTip = (regime === 'real')
        ? 'IRPJ e CSLL apurados e recolhidos a cada trimestre sobre o lucro do DRC (pago em jan, abr, jul e out).'
        : 'IRPJ e CSLL apurados e recolhidos a cada trimestre sobre a presunção (pago em jan, abr, jul e out).';
      cfg += `
        <div class="imp-regime-ctrl">
          <label>Apuração IRPJ/CSLL</label>
          <div class="imp-regime-subs">
            <button class="imp-regime-sub${apur==='mensal'?' active':''}"
                    onclick="setImpApuracao('mensal')"
                    title="IRPJ e CSLL calculados e recolhidos todo mês">Mensal</button>
            <button class="imp-regime-sub${apur==='trimestral'?' active':''}"
                    onclick="setImpApuracao('trimestral')"
                    title="${esc(baseTip)}">Trimestral</button>
          </div>
        </div>`;
    }
  } else if(regime === 'mei'){
    cfg = `
      <div class="imp-regime-ctrl">
        <label>DAS-MEI mensal</label>
        <div class="imp-regime-inpwrap">
          <span>R$</span>
          <input type="text" value="${fmtBR(impostos.meiValor, 2)}"
                 onblur="setImpMeiValor(this.value)"
                 onkeydown="if(event.key==='Enter')this.blur()"
                 onfocus="this.select()">
        </div>
      </div>`;
  } else if(regime === 'custom'){
    const tbl = impostos.aliquotasCustom || {};
    const cards = IMP_CUSTOM_RUBRICAS.map(r => {
      const val = +tbl[r.id] || 0;
      const isActive = val > 0;
      return `
        <div class="imp-regime-cust${isActive ? ' on' : ''}">
          <span class="imp-regime-cust-lbl">${esc(r.label)}</span>
          <div class="imp-regime-inpwrap">
            <input type="text" value="${fmtBR(val, 2)}"
                   onblur="setImpAliquotaCustom('${r.id}', this.value)"
                   onkeydown="if(event.key==='Enter')this.blur()"
                   onfocus="this.select()">
            <span>%</span>
          </div>
        </div>`;
    }).join('');
    cfg = `
      <div class="imp-regime-ctrl" style="flex:1;min-width:0">
        <label>Alíquotas personalizadas (sobre a receita bruta)</label>
        <div class="imp-regime-custs">${cards}</div>
        <div class="imp-regime-cust-hint">Deixe em 0 para não prever aquele imposto.</div>
      </div>`;
  }

  const desc = IMP_REGIMES[regime] ? IMP_REGIMES[regime].desc : '';
  const isTrimestral = ((regime === 'presumido' || regime === 'real') && impostos.apuracao === 'trimestral');
  const hint = regime
    ? (isTrimestral
        ? `<span class="imp-regime-hint">Pagamento com competência do mês anterior. IRPJ/CSLL trimestrais saem em jan, abr, jul e out — demais tributos seguem mensais.</span>`
        : `<span class="imp-regime-hint">Cada coluna = imposto a pagar naquele mês, com base na receita do mês anterior (competência).</span>`)
    : `<span class="imp-regime-hint">Escolha um regime para ver a previsão automática dos impostos a partir da receita.</span>`;

  // Botão "Preencher com previsão" — disponível sempre que houver um regime ativo
  const fillBtn = regime
    ? `<button class="imp-regime-fill" onclick="fillImpForecastValues()"
               title="Copia os valores previstos para as células vazias da planilha (somente o ano atual).">
         <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
         <span>Preencher valores previstos</span>
       </button>`
    : '';

  el.innerHTML = `
    <div class="imp-regime-top">
      <div class="imp-regime-ttl">
        <span class="imp-regime-ico">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-5"/></svg>
        </span>
        <span>Regime tributário</span>
      </div>
      <div class="imp-regime-pills">${pills}</div>
      ${fillBtn}
    </div>
    ${cfg ? `<div class="imp-regime-cfg">${cfg}</div>` : ''}
    <div class="imp-regime-foot">
      ${regime ? `<span class="imp-regime-desc">${esc(desc)}</span>` : ''}
      ${hint}
    </div>
  `;
}

async function addImpCorRubrica(){
  const nome = await askText({
    title: 'Nova rubrica de imposto',
    label: 'Nome',
    placeholder: 'Ex.: IPTU, Taxa de Fiscalização, Contribuição Sindical',
    confirmText: 'Adicionar',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!s) return 'Informe o nome do imposto.';
      return null;
    }
  });
  if(!nome) return;
  const id = impNextRubId();
  const color = IMP_PALETTE[impostos.rubricas.length % IMP_PALETTE.length];
  impostos.rubricas.push({ id, nome: nome.trim(), color, builtin:false });
  impostos.correntes.push({ rubricaId: id, valores: {} });
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

function renameImpRubrica(id, nome){
  const r = impRubrica(id);
  if(!r || r.builtin) return;
  const v = (nome||'').trim();
  if(!v) return;
  r.nome = v;
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

async function delImpRubrica(id){
  const r = impRubrica(id);
  if(!r || r.builtin) return;
  const ok = await showConfirm({
    title: 'Excluir rubrica',
    message: `Remover <strong>${r.nome}</strong> e todos os seus valores mensais?`,
    confirmLabel: 'Excluir', destructive: true
  });
  if(!ok) return;
  impostos.rubricas = impostos.rubricas.filter(x => x.id !== id);
  impostos.correntes = impostos.correntes.filter(c => c.rubricaId !== id);
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

// ═══════════════════════════════════════════════════════════════
//  ABA 2 — PARCELAMENTO DE IMPOSTOS
//  Modelo simplificado: saldo inicial + parcela mensal + mês de início.
//  Saldo mês a mês = saldoInicial − parcelaMensal × mesesPagos (bounded)
// ═══════════════════════════════════════════════════════════════

// ── Taxa SELIC ─────────────────────────────────────────────────
// Converte SELIC anual → mensal efetiva: (1 + r)^(1/12) − 1
function impSelicMensal(){
  const a = (impostos && impostos.selicAnual) || 0;
  if(a <= 0) return 0;
  return Math.pow(1 + a/100, 1/12) - 1;
}

// Índice do mês (0-based) dentro do parcelamento, para um 'YYYY-MM' alvo.
// <0 = antes do início
function impParcMesIdx(p, ym){
  if(!p.mesInicio || !/^\d{4}-\d{2}$/.test(p.mesInicio)) return -9999;
  if(!/^\d{4}-\d{2}$/.test(ym)) return -9999;
  const [y,m]  = ym.split('-').map(Number);
  const [iy,im]= p.mesInicio.split('-').map(Number);
  return (y-iy)*12 + (m-im);
}

// Soma delta meses a um 'YYYY-MM' → novo 'YYYY-MM'
function impAddMonths(ym, delta){
  if(!/^\d{4}-\d{2}$/.test(ym)) return '';
  const [y,m] = ym.split('-').map(Number);
  const total = y*12 + (m-1) + delta;
  const ny = Math.floor(total/12);
  const nm = total - ny*12 + 1;
  return String(ny) + '-' + String(nm).padStart(2,'0');
}

// Hash simples dos pagamentos para cache key
function _impPagHash(pags){
  if(!pags) return '';
  const keys = Object.keys(pags).sort();
  const parts = [];
  for(const k of keys) parts.push(k + ':' + pags[k]);
  return parts.join(',');
}

// Plano mês a mês: a parcela PREVISTA de cada mês é a parcela EFETIVA do mês
// anterior corrigida pela SELIC mensal (juros sobre juros, sempre com base no
// mês anterior). Pagamentos reais cadastrados em p.pagamentos[ym] entram no
// lugar da prevista e passam a ser a base para a cadeia seguinte.
// Retorna { rows:[{idx,ym,saldoIni,juros,parcela,parcelaPrev,manual,manualVal,saldoFim}], quitadoEm, growing }
function _impParcPlan(p){
  if(!p || !p.saldoInicial || !p.parcelaMensal || !p.mesInicio){
    return { rows:[], quitadoEm:-1, growing:false };
  }
  const selicA = (impostos && impostos.selicAnual) || 0;
  const pagHash = _impPagHash(p.pagamentos);
  // Prefixo 'v2' ↓ identifica matemática com cadeia juros-sobre-juros a partir do mês anterior
  const key = 'v2|' + selicA + '|' + p.saldoInicial + '|' + p.parcelaMensal + '|' + p.mesInicio + '|' + pagHash;
  if(p._planKey === key && p._plan) return p._plan;
  const selicMes = impSelicMensal();
  const rows = [];
  let saldo = p.saldoInicial;
  let quitadoEm = -1;
  let stuck = 0;
  let prevEfet = null;   // base p/ cadeia — parcela efetiva do mês anterior
  const LIMIT = 600;     // 50 anos de teto — segurança
  for(let i = 0; i < LIMIT; i++){
    if(saldo <= 0.005){ quitadoEm = i; break; }
    const ym = impAddMonths(p.mesInicio, i);
    const juros = saldo * selicMes;
    const saldoComJuros = saldo + juros;
    // Parcela PREVISTA: mês 0 = parcela inicial; mês i = anterior × (1+selic)
    const parcelaPrev = (i === 0)
      ? p.parcelaMensal
      : prevEfet * (1 + selicMes);
    // Pagamento real (se cadastrado) SUBSTITUI a prevista
    const hasManual = !!(p.pagamentos && Object.prototype.hasOwnProperty.call(p.pagamentos, ym));
    const manualVal = hasManual ? (+p.pagamentos[ym] || 0) : null;
    const parcelaBruta = hasManual ? manualVal : parcelaPrev;
    // Não paga mais que o saldo devedor com juros
    const parcela  = Math.min(parcelaBruta, saldoComJuros);
    const saldoFim = Math.max(0, saldoComJuros - parcela);
    // Base deste mês = valor a partir do qual a SELIC foi aplicada p/ gerar parcelaPrev
    // (= prevEfet do mês anterior, ou a parcela inicial no mês 0)
    const baseMes = (i === 0) ? p.parcelaMensal : prevEfet;
    rows.push({
      idx: i, ym, saldoIni: saldo, juros,
      parcela, parcelaPrev, parcelaBruta,
      manual: hasManual, manualVal,
      saldoFim, baseMes
    });
    // Base para a próxima previsão:
    // - se houve pagamento manual > 0, usa esse valor (juros sobre juros a partir dele)
    // - se manual = 0 (pulou esse mês), mantém a cadeia do previsto p/ não zerar
    // - sem manual, a base é o próprio previsto desse mês
    prevEfet = (hasManual && manualVal > 0.005) ? manualVal : parcelaPrev;
    // Travamento: se saldo não cai por muitos meses seguidos, interrompe
    if(saldoFim >= saldo - 0.005 && saldoFim > 0){
      stuck++;
      if(stuck >= 240){  // 20 anos sem amortizar → encerra para não travar render
        // Preenche o restante com o último patamar (congelado)
        const last = rows[rows.length-1];
        for(let j = i + 1; j < LIMIT; j++){
          const ymj = impAddMonths(p.mesInicio, j);
          rows.push({
            idx: j, ym: ymj, saldoIni: last.saldoIni, juros: last.juros,
            parcela: last.parcela, parcelaPrev: last.parcelaPrev,
            parcelaBruta: last.parcelaBruta,
            manual: false, manualVal: null,
            saldoFim: last.saldoFim, baseMes: last.baseMes
          });
        }
        p._planKey = key;
        p._plan = { rows, quitadoEm:-1, growing:true };
        return p._plan;
      }
    } else {
      stuck = 0;
    }
    saldo = saldoFim;
  }
  const growing = quitadoEm < 0;
  p._planKey = key;
  p._plan = { rows, quitadoEm, growing };
  return p._plan;
}

// Número total de parcelas até quitar (0 se ainda não determinado / growing)
function impParcelasTotais(p){
  const plan = _impParcPlan(p);
  if(plan.growing) return 0;
  return plan.rows.length;
}

// Parcela a pagar NO MÊS dado
function impParcelaDoMes(p, ym){
  if(!p.saldoInicial || !p.parcelaMensal) return 0;
  const idx = impParcMesIdx(p, ym);
  if(idx < 0) return 0;
  const plan = _impParcPlan(p);
  const row = plan.rows[idx];
  return row ? row.parcela : 0;
}

// Juros (SELIC) do mês
function impJurosDoMes(p, ym){
  if(!p.saldoInicial || !p.parcelaMensal) return 0;
  const idx = impParcMesIdx(p, ym);
  if(idx < 0) return 0;
  const plan = _impParcPlan(p);
  const row = plan.rows[idx];
  return row ? row.juros : 0;
}

// Lista TODAS as parcelas em atraso (pagamentos[k] explicitamente === 0) antes do
// mês ym, com valor corrigido SELIC até `ym`. Inclui atrasos não-consecutivos.
// Retorna: [{ ym, idx, parcelaOrig, valorCorrigido }] em ordem cronológica.
function impParcAcumuladoList(p, ym){
  if(!p || !p.pagamentos) return [];
  const idx = impParcMesIdx(p, ym);
  if(idx <= 0) return [];
  const plan = _impParcPlan(p);
  if(!plan.rows || plan.rows.length === 0) return [];
  const selicMes = impSelicMensal();
  const items = [];
  for(let k = idx - 1; k >= 0; k--){
    const r = plan.rows[k];
    if(!r) break;
    if(r.manual && (r.manualVal || 0) <= 0.005){
      const monthsFwd = idx - k;
      const valorCorrigido = (r.parcelaPrev || 0) * Math.pow(1 + selicMes, monthsFwd);
      items.push({ ym: r.ym, idx: k, parcelaOrig: r.parcelaPrev || 0, valorCorrigido });
    }
    // NÃO dá break — meses pagos no meio não quebram a contagem de atrasos antigos.
  }
  items.reverse();  // ordem cronológica (mais antigo primeiro)
  return items;
}
// Mantém compatibilidade com chamadas antigas — retorna totais da lista.
function impParcAcumuladoAteMes(p, ym){
  const list = impParcAcumuladoList(p, ym);
  const acumulado = list.reduce((s, it) => s + it.valorCorrigido, 0);
  return { acumulado, skippedMonths: list.length };
}

// Saldo devedor AO FINAL do mês ym
function impParcSaldoFim(p, ym){
  if(!p.saldoInicial) return 0;
  if(!p.parcelaMensal) return p.saldoInicial;
  const idx = impParcMesIdx(p, ym);
  if(idx < 0) return p.saldoInicial;   // ainda não começou
  const plan = _impParcPlan(p);
  if(plan.rows.length === 0) return p.saldoInicial;
  if(idx >= plan.rows.length){
    return plan.growing ? plan.rows[plan.rows.length-1].saldoFim : 0;
  }
  return plan.rows[idx].saldoFim;
}

// Saldo devedor CONSOLIDADO (todos parcelamentos ativos) no mês ym
function impParcSaldoConsolidado(ym){
  let s = 0;
  for(const p of (impostos.parcelamentos||[])){
    if(p.ativo === false) continue;
    s += impParcSaldoFim(p, ym);
  }
  return s;
}

function renderImpParSheet(){
  const thead = document.getElementById('imp-par-thead');
  const tbody = document.getElementById('imp-par-tbody');
  const tfoot = document.getElementById('imp-par-tfoot');
  if(!thead || !tbody || !tfoot) return;
  const year = impActiveYearPar;

  const yrRow1 = `<tr class="yr">
    <th class="stk stk-1 l">Parcelamento</th>
    <th class="stk stk-2">Saldo Inicial</th>
    <th class="stk stk-3">Parcelas</th>
    <th class="stk stk-4">Valor Parcela Inicial</th>
    <th class="stk stk-5">Início</th>
    <th colspan="12" style="text-align:center">Parcelas de ${year}</th>
    <th class="yr-tot">Pago no Ano</th>
    <th class="yr-tot" style="background:#4C1D95 !important;color:#FBCFE8 !important">Saldo Dez/${year.slice(2)}</th>
    <th class="att">Anexo</th>
    <th class="del"></th>
  </tr>`;
  const mesCols = IMP_MESES.map(m => `<th class="mes">${m.toUpperCase()}/${year.slice(2)}</th>`).join('');
  const yrRow2 = `<tr class="mo">
    <th class="stk stk-1"></th>
    <th class="stk stk-2">R$</th>
    <th class="stk stk-3"></th>
    <th class="stk stk-4">R$</th>
    <th class="stk stk-5">MMM-YY</th>
    ${mesCols}
    <th class="yr-tot">R$</th>
    <th class="yr-tot" style="background:#4C1D95 !important;color:#FBCFE8 !important">R$</th>
    <th class="att"></th>
    <th class="del"></th>
  </tr>`;
  thead.innerHTML = yrRow1 + yrRow2;

  const rows = [];
  if(impostos.parcelamentos.length === 0){
    rows.push(`<tr class="empty-row"><td colspan="${5+12+4}">
      Nenhum parcelamento cadastrado. Clique em <b>+ Novo parcelamento</b> para adicionar.
    </td></tr>`);
  } else {
    for(const p of impostos.parcelamentos){
      rows.push(renderImpParRow(p, year));
    }
  }
  tbody.innerHTML = rows.join('');

  // Footer: totais por mês + total ano + saldo consolidado dez
  const monthTotals = new Array(12).fill(0);
  let grand = 0;
  for(let m=0;m<12;m++){
    const ym = impMesKey(year, m);
    for(const p of impostos.parcelamentos){
      const v = impParcelaDoMes(p, ym);
      monthTotals[m] += v;
      grand += v;
    }
  }
  const mesTot = monthTotals.map(v =>
    `<td>${v ? fmtShortBR(v) : '<span style="color:#64748B">—</span>'}</td>`
  ).join('');
  const saldoDez = impParcSaldoConsolidado(impMesKey(year, 11));

  tfoot.innerHTML = `<tr>
    <td class="stk stk-1">Total Parcelamentos</td>
    <td class="stk"></td>
    <td class="stk"></td>
    <td class="stk"></td>
    <td class="stk"></td>
    ${mesTot}
    <td class="yr-tot">${fmtBRL(grand)}</td>
    <td class="yr-tot" style="background:#4C1D95;color:#fff">${fmtBRL(saldoDez)}</td>
    <td></td>
    <td></td>
  </tr>`;
}

function renderImpParRow(p, year){
  const plan = _impParcPlan(p);
  // Prioriza o alvo digitado pelo usuário (evita divergência por arredondamento
  // do Math.ceil em setImpParNumParcelas). Fallback: comprimento real do plano.
  const total = (p.numParcelasAlvo && p.numParcelasAlvo > 0)
    ? p.numParcelasAlvo
    : plan.rows.length;
  const saldoFim = impParcSaldoFim(p, impMesKey(year, 11));
  const growing = plan.growing === true;
  const quitado = (p.saldoInicial > 0) && !growing && (saldoFim <= 0 && total > 0
                   && impParcMesIdx(p, impMesKey(year, 0)) >= total);

  // Células mensais: parcela (prevista ou real) + juros + botão PAGAR no hover
  const mesCells = IMP_MESES.map((_,m) => {
    const ym = impMesKey(year, m);
    const idx = impParcMesIdx(p, ym);
    const row = (idx >= 0 && idx < plan.rows.length) ? plan.rows[idx] : null;

    let cls = 'mes';
    let title = '';
    let display = '—';
    let clickable = false;

    if(idx < 0){
      cls += ' before';
      title = 'antes do início do parcelamento';
    } else if(!growing && idx >= total){
      cls += ' zero';
      title = 'já quitado';
      display = '✓';
    } else if(!row){
      cls += ' zero';
      title = 'sem parcela neste mês';
    } else {
      clickable = true;
      const numPar = `parcela ${idx+1}${growing?'':'/'+total}`;
      const prev = row.parcelaPrev;
      const real = row.manual ? row.manualVal : null;
      if(row.manual){
        // Classifica em relação ao previsto
        const delta = (real||0) - prev;
        const pct = prev > 0.005 ? (delta/prev) : 0;
        // Células pagas sempre com 2 casas decimais (formato consistente)
        if((real||0) <= 0.005){
          cls += ' pago-zero';
          display = fmtBR(real||0, 2);
          title = `${numPar} · PAGO: ${fmtBRL(real||0)} · previsto era ${fmtBRL(prev)}`;
        } else if(Math.abs(pct) < 0.005){
          cls += ' pago-igual';
          display = fmtBR(real, 2);
          title = `${numPar} · PAGO: ${fmtBRL(real)} (conforme previsto) · juros SELIC: ${fmtBRL(row.juros)}`;
        } else if(delta > 0){
          cls += ' pago-mais';
          display = fmtBR(real, 2);
          title = `${numPar} · PAGO: ${fmtBRL(real)} · previsto: ${fmtBRL(prev)} · ${fmtBR(pct*100,1)}% acima`;
        } else {
          cls += ' pago-menos';
          display = fmtBR(real, 2);
          title = `${numPar} · PAGO: ${fmtBRL(real)} · previsto: ${fmtBRL(prev)} · ${fmtBR(pct*100,1)}% abaixo`;
        }
      } else {
        // Previsto (calculado pela SELIC)
        display = fmtShortBR(prev);
        title = `${numPar} (previsto) · ${fmtBRL(prev)} · juros SELIC: ${fmtBRL(row.juros)} · amortização: ${fmtBRL(row.parcela-row.juros)} · Clique para registrar pagamento real`;
      }
    }

    // Badge "+N" quando há parcelas em atraso que devem ser quitadas neste mês.
    // O valor a quitar no mês aparece detalhado dentro do modal (parcelas listadas).
    let acumBadge = '';
    if(clickable){
      const list = impParcAcumuladoList(p, ym);
      if(list.length > 0){
        const totalAcum = list.reduce((s, it) => s + it.valorCorrigido, 0);
        const label = list.length === 1 ? '1 parcela em atraso' : list.length + ' parcelas em atraso';
        acumBadge = `<span class="imp-acum-badge" title="${label} pendente. Abra o modal pra quitar. Total corrigido SELIC: ${fmtBRL(totalAcum)}">+${list.length}</span>`;
        title += ` · ⚠️ ${label} — clique pra quitar`;
      }
    }

    const onClick = clickable
      ? ` onclick="openImpPagarDialog(${p.id}, '${ym}')"`
      : '';
    const hasBtn = clickable;
    const btnTitle = (row && row.manual) ? 'Editar pagamento' : 'Registrar pagamento';
    const btn = hasBtn
      ? `<button class="imp-pagar-btn" onclick="event.stopPropagation(); openImpPagarDialog(${p.id}, '${ym}')" title="${btnTitle}">✓</button>`
      : '';
    return `<td class="${cls}" title="${esc(title)}"${onClick}>${display}${acumBadge}${btn}</td>`;
  }).join('');

  // Pago no ano (usa valores efetivos do plano — reais quando há manual)
  let pagoAno = 0;
  for(let m=0;m<12;m++) pagoAno += impParcelaDoMes(p, impMesKey(year, m));

  const saldoIniVal = p.saldoInicial ? fmtBR(p.saldoInicial, 2) : '';
  const parcelaVal  = p.parcelaMensal ? fmtBR(p.parcelaMensal, 2) : '';
  const mesIniVal   = p.mesInicio || '';

  const isAtivo = p.ativo !== false;
  const statusTip = isAtivo
    ? 'Ativo — clique pra inativar'
    : 'Inativo' + (p.motivoInativo ? (' — ' + esc(p.motivoInativo).slice(0,80)) : '') + ' — clique pra reativar';
  const rowCls = 'imp-par-row'
    + (quitado ? ' quitado' : '')
    + (growing ? ' growing' : '')
    + (isAtivo ? '' : ' inativo');

  return `<tr class="${rowCls}" data-parc-id="${p.id}">
    <td class="stk stk-1">
      <div class="imp-par-nome">
        <span class="dot" style="background:#BE185D;width:10px;height:10px;border-radius:50%;flex:0 0 auto;box-shadow:0 0 0 2px #fff inset,0 0 0 3px #BE185D inset"></span>
        <input type="text" class="nm" value="${esc(p.nome)}" placeholder="Ex.: REFIS PGFN, PERT, DAS em atraso"
               onblur="setImpParNome(${p.id}, this.value)"
               onkeydown="if(event.key==='Enter') this.blur()">
        <button type="button" class="imp-par-status-btn${isAtivo?'':' off'}"
                onclick="toggleImpParAtivo(${p.id})" title="${statusTip}">
          ${isAtivo ? 'ativo' : 'inativo'}
        </button>
      </div>
    </td>
    <td class="stk stk-2">
      <input type="text" class="imp-par-field" value="${saldoIniVal}" placeholder="—"
             data-cellref="imppar:${p.id}:saldoInicial"
             onblur="setImpParSaldoInicial(${p.id}, this.value); this.value = (this.value && !isNaN(parseBR(this.value))) ? fmtBR(parseBR(this.value),2) : ''"
             onfocus="this.value = this.value.replace(/\\./g,''); this.select()"
             onkeydown="if(event.key==='Enter') this.blur()">
    </td>
    <td class="stk stk-3" title="${growing ? 'Parcela atual insuficiente para cobrir os juros SELIC — edite para recalcular' : (total > 0 ? 'Edite para recalcular o valor da parcela' : 'Preencha o saldo inicial para editar')}">
      ${
        !p.saldoInicial
          ? '<span style="color:#D1D5DB">—</span>'
          : (() => {
              // Parcelas pagas = nº de pagamentos registrados (p.pagamentos com valor > 0).
              // Só conta pagamento efetivado, não mês transcorrido — reflete a realidade.
              const pags = p.pagamentos || {};
              const pagas = Object.keys(pags).filter(k => parseFloat(pags[k]) > 0.005).length;
              const denom = growing ? '∞' : (total > 0 ? total : '?');
              const pct = (!growing && total > 0) ? Math.min(100, (pagas/total)*100) : 0;
              const fillCls = (!growing && total > 0 && pagas >= total) ? 'prog-fill is-quitado' : 'prog-fill';
              return `<div class="imp-npar-wrap">
                <div class="imp-npar-row">
                  <span class="imp-npar-pagas">${pagas}</span>
                  <span class="imp-npar-sep">/</span>
                  <input type="number" class="imp-npar-input${growing ? ' growing' : ''}"
                         value="${total > 0 ? total : ''}" placeholder="?" min="1" step="1"
                         style="width:58px;padding:2px 4px"
                         onclick="event.stopPropagation()"
                         onfocus="this.select()"
                         onblur="setImpParNumParcelas(${p.id}, this.value)"
                         onkeydown="if(event.key==='Enter') this.blur()"
                         title="Número de parcelas (mensais) até quitar — edite para recalcular o valor da parcela inicial">
                </div>
                <div class="prog-bar"><div class="${fillCls}" style="width:${pct.toFixed(1)}%"></div></div>
                <div class="imp-npar-lbl">${pagas} de ${denom} pagas</div>
              </div>`;
            })()
      }
    </td>
    <td class="stk stk-4">
      <input type="text" class="imp-par-field" value="${parcelaVal}" placeholder="—"
             data-cellref="imppar:${p.id}:parcela"
             onblur="setImpParParcela(${p.id}, this.value); this.value = (this.value && !isNaN(parseBR(this.value))) ? fmtBR(parseBR(this.value),2) : ''"
             onfocus="this.value = this.value.replace(/\\./g,''); this.select()"
             onkeydown="if(event.key==='Enter') this.blur()">
    </td>
    <td class="stk stk-5">
      <button type="button" class="imp-par-mes-btn" onclick="openImpParMesPicker(${p.id}, this)"
              title="Clique para escolher mês e ano">
        ${(()=>{
          if(!mesIniVal) return '<span style="color:#D1D5DB">—</span>';
          const [y,mm] = mesIniVal.split('-').map(Number);
          return IMP_MESES[mm-1].toUpperCase() + '-' + String(y).slice(2);
        })()}
      </button>
    </td>
    ${mesCells}
    <td class="yr-tot">${pagoAno ? fmtBRL(pagoAno) : '<span style="color:#D1D5DB">—</span>'}</td>
    <td class="yr-tot" style="background:#F5F3FF;color:#4C1D95">${
