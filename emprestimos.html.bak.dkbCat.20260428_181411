function renderDispoContaDetail(){
  const body  = document.getElementById('dispo-conta-detail-body'); if(!body) return;
  const title = document.getElementById('dispo-conta-detail-title');
  // Seleciona as contas alvo: todas do bancoId clicado; se sem banco, só a conta escolhida
  let contas = [];
  if(__dispoDetailBancoId){
    contas = dispo.contas.filter(c => c.bancoId === __dispoDetailBancoId);
  } else {
    const c = dispo.contas.find(c => c.id === __dispoDetailCidFallback);
    if(c) contas = [c];
  }
  // Ordena por preferência: CC primeiro, depois ativas, depois id
  contas.sort((a,b) => {
    const isCC = (c) => {
      const t = dispoTipo(c.tipoId);
      if(!t) return false;
      const ab = (t.abrev||'').toLowerCase(), nm = (t.nome||'').toLowerCase();
      return c.tipoId === 't-cc' || ab === 'cc' || nm.includes('conta corrente');
    };
    if(isCC(a) !== isCC(b)) return isCC(a) ? -1 : 1;
    if(!!a.ativo !== !!b.ativo) return a.ativo ? -1 : 1;
    return a.id - b.id;
  });
  // Título: usa nome do banco ou fallback
  const banco = __dispoDetailBancoId ? dispoBanco(__dispoDetailBancoId) : null;
  if(title){
    if(banco){
      title.textContent = banco.nome + ' · dados detalhados';
    } else if(contas[0]){
      title.textContent = 'Dados detalhados · Conta #' + contas[0].id;
    } else {
      title.textContent = 'Dados detalhados';
    }
  }
  if(!contas.length){
    body.innerHTML = `<p class="dispo-mgr-intro">Conta não encontrada.</p>`;
    return;
  }
  const intro = contas.length === 1
    ? 'Preencha os dados bancários desta conta. As alterações são salvas automaticamente ao sair de cada campo.'
    : `Este banco tem <strong>${contas.length} contas</strong>. Os dados de titular, PIX e gerente são por conta — preencha cada uma.`;
  const cards = contas.map(__dispoContaCardHTML).join('');
  body.innerHTML = `
    <p class="dispo-mgr-intro">${intro}</p>
    <div class="dispo-dados-list">${cards}</div>`;
  // Validação inicial do PIX em cada conta renderizada
  for(const c of contas){ dispoPixValidateRender(c.id); }
}

