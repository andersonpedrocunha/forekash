        ind({cls: x.recYoyPrev>0 ? (x.yoyPct>=0?'good':'bad') : 'info', lbl:'YoY Receita',
              val: x.recYoyPrev>0 ? fmtPct(x.yoyPct) : '—',
              sub: x.recYoyPrev>0 ? 'vs ' + fmt(x.recYoyPrev) + ' ano anterior' : 'sem dados ano anterior',
              help:'Variação % da receita do período vs mesma janela do ano anterior'}),
        ind({cls:'info', lbl:'Ticket Médio', val:fmt(x.ticketMedio), sub:'receita ÷ clientes', help:'Receita total dividida pelo número de clientes ativos no período'}),
        ind({cls:'purp', lbl:'LTV (proxy)', val:fmt(k.ltv), sub:'ticket mensal × 12', help:'Lifetime Value estimado: receita média mensal por cliente projetada por 12 meses'}),
        ind({cls:'good', lbl:'Receita / Mês', val:fmt(x.receitaMes), sub:'média no período', spark:s.recMes, sparkColor:'#10B981'}),
        ind({cls:'pink', lbl:'Receita / Cliente', val:fmt(x.ticketMedio), sub:'no período inteiro', help:'Mesmo que ticket médio — quanto cada cliente gerou em média'})
      ])
    + group('👥', 'Pessoas & Produtividade', 'RH', [
        ind({cls:'purp', lbl:'Headcount Médio', val:fmtN(k.headcount), sub:'pessoas no período', spark:s.hcMes, sparkColor:'#7C3AED', help:'Média de pessoas ativas com salário > 0 mês a mês'}),
        ind({cls: stPctFol.s==='ok'?'good':stPctFol.s==='att'?'warn':'bad', lbl:'% Folha / Receita', val:fmtPct(x.pctFolha), sub:'<span class="status ' + stPctFol.s + '">' + stPctFol.l + '</span>', help:'Quanto da receita é consumida pela folha. < 30% saudável (varia por setor)'}),
        ind({cls:'purp', lbl:'Salário Médio', val:fmt(x.salarioMedio), sub:'por pessoa/mês', help:'Folha total dividida pelo headcount médio e pelos meses do período'}),
        ind({cls:'good', lbl:'Receita / Func', val:fmt(x.receitaPorFunc), sub:'no período', help:'Quanto cada funcionário gerou de receita. Quanto maior, mais produtivo'}),
        ind({cls:'warn', lbl:'Custo / Func', val:fmt(x.custoPorFunc), sub:'folha ÷ headcount', help:'Custo total de folha por funcionário no período'}),
        ind({cls: stTurn.s==='ok'?'good':stTurn.s==='att'?'warn':'bad', lbl:'Turnover', val:fmtPct(k.turnover), sub:'<span class="status ' + stTurn.s + '">' + stTurn.l + '</span>', help:'% de pessoas que saíram em relação ao headcount inicial do período'})
      ])
    + group('🏷', 'Clientes & Retenção', 'base ativa', [
        ind({cls:'good', lbl:'Clientes Ativos', val:fmtN(k.clientesAtivos), sub:'com receita no período', spark:s.cliMes, sparkColor:'#16A34A', help:'Clientes únicos que tiveram receita no período'}),
        ind({cls: stChurn.s==='ok'?'good':stChurn.s==='att'?'warn':'bad', lbl:'Churn', val:fmtPct(k.churn), sub:'<span class="status ' + stChurn.s + '">' + stChurn.l + '</span>', deltaInvert:true, help:'% de clientes do mês inicial que sumiram no último mês do filtro'}),
        ind({cls:'pink', lbl:'% Comissões / Receita', val:fmtPct(x.pctComissoes), sub:'comissões ÷ receita', help:'Quanto da receita vai pra comissões dos vendedores'}),
        ind({cls:'pink', lbl:'% Estrutura / Receita', val:fmtPct(x.pctEstrutura), sub:'despesas fixas ÷ receita', help:'Quanto da receita é consumida por despesas estruturais'}),
        ind({cls:'bad',  lbl:'% Empréstimos / Receita', val:fmtPct(x.pctLoans), sub:'parcelas ÷ receita', help:'Quanto da receita vai pra pagar parcelas de empréstimos'}),
        ind({cls: stRunway.s==='ok'?'good':stRunway.s==='att'?'warn':'bad', lbl:'Runway',
              val: (isFinite(k.runway) && k.runway>=0 ? k.runway.toFixed(1) : '∞') + ' m',
              sub:'<span class="status ' + stRunway.s + '">' + stRunway.l + '</span>',
              help:'Quantos meses o saldo de caixa atual dura no ritmo de gasto'})
      ])
    + group('🎯', 'Aquisição (CAC)', 'configure em Customizações', [
        ind({cls: x.cacNovos > 0 ? 'purp' : 'warn', lbl:'CAC',
              val: x.cacNovos > 0 ? fmt(x.cac) : '—',
              sub:'por novo cliente no período',
              help:'Custo de Aquisição de Cliente — soma das despesas (estrutura + folha) marcadas como CAC, com % por linha, dividida pelos novos clientes do período. Configure em Customizações > Indicadores customizados.'}),
        ind({cls:'good', lbl:'Novos Clientes', val:fmtN(x.cacNovos), sub:'1ª receita no período', help:'Clientes que tiveram a primeira receita registrada dentro do período filtrado'}),
        ind({cls:'pink', lbl:'Invest. Aquisição', val:fmt(x.cacDespTotal), sub:'despesas marcadas no CAC', help:'Soma das despesas e folha marcadas como CAC no período (já com % aplicado por linha e por mês)'}),
        ind({cls: x.ltvCac >= 3 ? 'good' : x.ltvCac >= 1 ? 'warn' : 'bad', lbl:'LTV / CAC',
              val: x.ltvCac > 0 ? x.ltvCac.toFixed(1) + 'x' : '—',
              sub:'eficiência da máquina',
              help:'LTV ÷ CAC. Saudável > 3x. Abaixo de 1x significa que cada cliente custa mais do que vale ao longo da vida'}),
        ind({cls: x.cacPayback > 0 && x.cacPayback <= 6 ? 'good' : x.cacPayback <= 12 ? 'warn' : 'bad', lbl:'CAC Payback',
              val: x.cacPayback > 0 ? x.cacPayback.toFixed(1) + ' m' : '—',
              sub:'CAC ÷ ticket mensal',
              help:'Quantos meses pra recuperar o CAC com a receita média mensal por cliente. Saudável < 6 meses (varia por modelo)'}),
        ind({cls:'info', lbl:'Ticket Mensal', val:fmt(x.ticketMensal), sub:'receita média/cliente/mês', help:'Receita por cliente por mês — usado no cálculo do payback'})
      ])
    + '</div>';
  wrap.innerHTML = heroHtml + groupsHtml;
}

/* ════════════════════════════════════════════════════════
   CUSTOM DASHBOARD BUILDER — registro de widgets
   ════════════════════════════════════════════════════════ */
const ANA_WIDGETS = (function(){
  // helper de classe pro KPI card pequeno (sem height:100% pra ficar compacto)
  const indHtml = (cls, lbl, val, sub) =>
    '<div class="ana-ind ' + cls + '">'
    + '<div class="lbl">' + lbl + '</div>'
    + '<div class="val">' + val + '</div>'
    + (sub ? '<div class="sub">' + sub + '</div>' : '')
    + '</div>';
  const heroHtml = (cls, ico, lbl, val, sub) =>
    '<div class="ana-hero ' + cls + '" style="border:none">'
    + '<div class="ana-hero-hd"><span class="ico">' + ico + '</span><span class="lbl">' + lbl + '</span></div>'
    + '<div class="ana-hero-val">' + val + '</div>'
    + (sub ? '<div class="ana-hero-meta"><span class="sub">' + sub + '</span></div>' : '')
    + '</div>';
  // Helpers de formatação
  const fmt = (n) => fmtBRL(n||0);
  const fmtPct = (n) => (isFinite(n) ? n.toFixed(1).replace('.',',') : '0,0') + '%';
  const fmtN = (n) => Math.round(n||0).toLocaleString('pt-BR');

  // Cada widget tem: label, category, defaultCols, render(container, ctx)
  // ctx = { facts, k (kpis), x (extras), s (series), uid (canvas id pra charts) }
  const W = {};

  // ═══ Helper: renderiza narrativa em HTML bonito ═══
  function _anaEsc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function _anaRenderNarrativeHTML(txt, uid, isPresenting){
    txt = String(txt || '').trim();
    if(!txt){
      return '<div class="ana-narr-wrap" style="color:#94A3B8;font-style:italic">'
           + (isPresenting ? '' : 'Clique para escrever a narrativa…')
           + (isPresenting ? '' : '<span class="ana-narr-edit-hint">✏ click p/ editar</span>')
           + '</div>';
    }
    const editHint = isPresenting ? '' : '<span class="ana-narr-edit-hint">✏ click p/ editar</span>';

    // ─── FORMATO AGENDA: [AGENDA] ou [AGENDA:variant] na 1ª linha ───
    const mAgenda = txt.match(/^\[AGENDA(?::([a-z]+))?\]/i);
    if(mAgenda){
      const variant = (mAgenda[1] || 'default').toLowerCase();
      const variantClass = variant === 'cards' ? ' is-cards'
                         : variant === 'minimal' ? ' is-minimal'
                         : '';
      const body = txt.replace(/^\[AGENDA(?::[a-z]+)?\]\s*\n?/i, '');
      const lines = body.split(/\n/).map(l => l.trim()).filter(l => l.length > 0);
      // Detecta se ALGUM item tem tempo — pra decidir entre grid 2 ou 3 colunas
      const parsedItems = lines.map(l => l.split('|').map(p => p.trim()));
      const anyTime = parsedItems.some(parts => (parts[2] || '').length > 0);
      let html = '<div class="ana-narr-agenda' + variantClass + (anyTime ? '' : ' is-no-time') + '">' + editHint
              +   '<ol class="ana-narr-agenda-list">';
      for(let i = 0; i < parsedItems.length; i++){
        const parts = parsedItems[i];
        const num = ('0' + (i+1)).slice(-2);
        const title = parts[0] || '';
        const desc = parts[1] || '';
        const time = parts[2] || '';
        html += '<li class="ana-narr-agenda-item">'
              +   '<div class="ana-narr-agenda-num">' + num + '</div>'
              +   '<div class="ana-narr-agenda-content">'
              +     '<div class="ana-narr-agenda-title">' + _anaEsc(title) + '</div>'
              +     (desc ? '<div class="ana-narr-agenda-desc">' + _anaEsc(desc) + '</div>' : '')
              +   '</div>'
              +   (time ? '<div class="ana-narr-agenda-time">' + _anaEsc(time) + '</div>' : '')
              + '</li>';
      }
      html += '</ol></div>';
      return html;
    }

    // ─── FORMATO 3 COLUNAS: [3-COL] ou [3-COL:variant] na 1ª linha ───
    const m3col = txt.match(/^\[3-COL(?::([a-z]+))?\]/i);
    if(m3col){
      const variant = (m3col[1] || 'default').toLowerCase();
      const variantClass = variant === 'cards' ? ' is-cards'
                         : variant === 'numerals' ? ' is-numerals'
                         : variant === 'stripes' ? ' is-stripes'
                         : '';
      const body = txt.replace(/^\[3-COL(?::[a-z]+)?\]\s*\n/i, '');
      const cols = body.split(/\n---+\n/).slice(0, 3);
      const ICONS = {
        '✓': '<svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" stroke="#16A34A" stroke-width="3"/><path d="M20 33 L29 42 L45 24" stroke="#16A34A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>',
        '⚠': '<svg viewBox="0 0 64 64" fill="none"><path d="M32 8 L58 54 L6 54 Z" stroke="#DC2626" stroke-width="3" stroke-linejoin="round" fill="none"/><path d="M32 24 L32 38" stroke="#DC2626" stroke-width="4" stroke-linecap="round"/><circle cx="32" cy="46" r="2.5" fill="#DC2626"/></svg>',
        '◎': '<svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" stroke="#475569" stroke-width="3"/><circle cx="32" cy="32" r="18" stroke="#475569" stroke-width="2.5"/><circle cx="32" cy="32" r="6" fill="#475569"/></svg>'
      };
      const KIND_BY_ICON = { '✓': 'vitoria', '⚠': 'realidade', '◎': 'estrategia' };
      const EYEBROW_BY_KIND = { 'vitoria': 'POSITIVO', 'realidade': 'ATENÇÃO', 'estrategia': 'AÇÃO' };
      let html = '<div class="ana-narr-3col' + variantClass + '">' + editHint;
      let colIdx = 0;
      for(const colTxt of cols){
        colIdx++;
        const lines = colTxt.split(/\n/).map(l => l.trim()).filter(l => l.length > 0);
        if(lines.length === 0) continue;
        const firstLine = lines[0];
        const m = firstLine.match(/^([✓⚠◎])\s*(.+)$/);
        const iconChar = m ? m[1] : '';
        const icon = m ? ICONS[iconChar] || '' : '';
        const title = m ? m[2] : firstLine;
        const kind = m ? (KIND_BY_ICON[iconChar] || 'col-' + colIdx) : 'col-' + colIdx;
        const rest = lines.slice(1);
        const isList = rest.length > 0 && rest.every(l => /^\d+[\.\)]\s/.test(l));
        let bodyHtml = '';
        if(isList){
          bodyHtml = '<ol>' + rest.map(l => '<li>' + _anaEsc(l.replace(/^\d+[\.\)]\s*/, '')) + '</li>').join('') + '</ol>';
        } else {
          bodyHtml = rest.map(l => '<p>' + _anaEsc(l) + '</p>').join('');
        }
        // Para a variação NUMERAIS: gera o numeral "01", "02", "03"
        const numeral = '<div class="ana-narr-col-numeral">' + ('0' + colIdx).slice(-2) + '</div>';
        // Para a variação STRIPES: eyebrow colorido
        const eyebrow = '<div class="ana-narr-col-eyebrow">' + (EYEBROW_BY_KIND[kind] || '') + '</div>';
        html += '<div class="ana-narr-col" data-kind="' + kind + '">'
              +   (variant === 'numerals'
                   ? '<div class="ana-narr-col-icon">' + numeral + '</div>'
                   : variant === 'stripes'
                     ? eyebrow
                     : '<div class="ana-narr-col-icon">' + icon + '</div>')
              +   '<div class="ana-narr-col-title">' + _anaEsc(title) + '</div>'
              +   '<div class="ana-narr-col-body">' + bodyHtml + '</div>'
              + '</div>';
      }
      html += '</div>';
      return html;
    }

    // ─── FORMATO PADRÃO (prosa com seções UPPERCASE como eyebrows) ───    // ─── FORMATO PADRÃO (prosa com seções UPPERCASE como eyebrows) ───
    // Estrutura esperada: headline\n\nSEÇÃO\nbody\n\nSEÇÃO\nbody...
    const blocks = txt.split(/\n\n+/);
    let html = '<div class="ana-narr-wrap">' + editHint;
    let firstBlockIsHeadline = true;
    for(let i = 0; i < blocks.length; i++){
      const block = blocks[i].trim();
      if(!block) continue;
      const lines = block.split(/\n/);
      const firstLine = lines[0].trim();
      // Detecta SEÇÃO UPPERCASE (eyebrow)
      const isSection = firstLine.length > 2 && firstLine === firstLine.toUpperCase()
                     && /[A-ZÁÉÍÓÚÇÃÕÂÊÔ]/.test(firstLine) && lines.length > 1;
      if(isSection){
        firstBlockIsHeadline = false;
        const eyebrow = firstLine;
        const bodyLines = lines.slice(1);
        // É lista (linhas com "—") ?
        const isList = bodyLines.length > 0 && bodyLines.every(l => /^[—–-]\s/.test(l.trim()));
        let bodyHtml = '';
        if(isList){
          bodyHtml = '<ul class="ana-narr-list">'
                   + bodyLines.map(l => '<li>' + _anaEsc(l.trim().replace(/^[—–-]\s*/, '')) + '</li>').join('')
                   + '</ul>';
        } else {
          bodyHtml = '<div class="ana-narr-prose">' + _anaEsc(bodyLines.join(' ')) + '</div>';
        }
        html += '<div class="ana-narr-section">'
              +   '<div class="ana-narr-eyebrow">' + _anaEsc(eyebrow) + '</div>'
              +   bodyHtml
              + '</div>';
      } else if(firstBlockIsHeadline && i === 0){
        // Primeiro bloco sem header = headline
        html += '<div class="ana-narr-headline">' + _anaEsc(block) + '</div>';
        firstBlockIsHeadline = false;
      } else {
        // Bloco sem header = prosa simples
        html += '<div class="ana-narr-prose" style="margin-top:10px">' + _anaEsc(block) + '</div>';
      }
    }
    html += '</div>';
    return html;
  }
  try{ window._anaRenderNarrativeHTML = _anaRenderNarrativeHTML; }catch(e){}

  // ═══ HERO ═══
  // ═══ TEXTO — widget pra narrativas ═══
  W['text'] = { label:'Texto · Narrativa', category:'text', defaultCols:2,
    render:(c, ctx) => {
      const it = ctx.item;
      const txt = (it && it.text) || '';
      const isPresenting = !!(typeof _anaState !== 'undefined' && _anaState.presentation && _anaState.presentation.presenting);
      const editingFlag = '_anaTextEditing_' + ctx.uid;
      const inEditMode = !isPresenting && (window[editingFlag] === true);
      const curSlide = (typeof _anaSlideCurrent === 'function') ? _anaSlideCurrent() : null;
      const narrStyles = (curSlide && curSlide.styles && curSlide.styles.narrative) || {};
      const narrStyleStr = (typeof _anaStyleString === 'function') ? _anaStyleString(narrStyles) : '';
      // Detecta se o texto tem marcador especial [3-COL...] OU tags HTML
      const hasMarker = /^\[3-COL/i.test(txt.trim());
      const hasHTML = /<\w+[^>]*>/.test(txt);

      if(isPresenting || (!inEditMode && hasMarker)){
        // Apresentação OU narrativa estruturada (3-COL) → render bonito sem edit-on-click do template estruturado
        c.innerHTML = _anaRenderNarrativeHTML(txt, ctx.uid, isPresenting);
        const wrap = c.querySelector('.ana-narr-wrap, .ana-narr-3col');
        if(wrap && narrStyleStr) wrap.setAttribute('style', narrStyleStr);
        if(!isPresenting && wrap){
          wrap.addEventListener('click', (e) => {
            if(e.target.tagName === 'A') return;
            if(typeof _anaSetEditTarget === 'function') _anaSetEditTarget('narrative');
            window[editingFlag] = true;
            if(typeof _anaRenderPresent === 'function') _anaRenderPresent();
          });
        }
      } else {
        // Edit mode (ou narrativa sem marcador) → contentEditable rico
        // Permite formatar palavras individuais via toolbar (execCommand)
        const display = hasHTML ? txt : (txt.split('\n').map(l => l ? esc(l) : '<br>').join('<br>'));
        c.innerHTML = '<div class="ana-cw-text-editable" contenteditable="true"'
                    + ' data-text-uid="' + ctx.uid + '" data-style-target="narrative"'
                    + ' data-placeholder="Escreva a narrativa aqui... (use [3-COL] na 1ª linha pra layout 3 colunas)"'
                    + ' style="' + narrStyleStr + ';width:100%;height:100%;padding:10px 12px;font-size:.95rem;line-height:1.55;color:#1F2937;overflow:auto;cursor:text"'
                    + ' onfocus="if(typeof _anaSetEditTarget===\'function\') _anaSetEditTarget(\'narrative\')"'
                    + ' onblur="anaSlideTextSet(' + ctx.uid + ', this.innerHTML);"'
                    + ' onmousedown="event.stopPropagation()"'
                    + ' draggable="false">' + display + '</div>';
        if(inEditMode){
          setTimeout(() => {
            const ed = c.querySelector('.ana-cw-text-editable');
            if(ed){
              ed.focus();
              // Coloca cursor no fim
              const range = document.createRange();
              range.selectNodeContents(ed);
              range.collapse(false);
              const sel = window.getSelection();
              sel.removeAllRanges(); sel.addRange(range);
            }
          }, 30);
        }
      }
    }
  };

  W['hero-receita'] = { label:'Hero · Receita', category:'hero', defaultCols:2,
    render:(c, ctx) => { c.innerHTML = heroHtml('good','📈','Receita Total',
      fmt(ctx.k.receita), fmt(ctx.x.receitaMes) + '/mês · ' + ctx.k.clientesAtivos + ' clientes'); }};
  W['hero-ebitda'] = { label:'Hero · EBITDA', category:'hero', defaultCols:2,
    render:(c, ctx) => { c.innerHTML = heroHtml(ctx.k.ebitda>=0?'purp':'bad','💰','EBITDA',
      fmt(ctx.k.ebitda), 'margem ' + fmtPct(ctx.k.margem)); }};
  W['hero-saldo'] = { label:'Hero · Saldo & Runway', category:'hero', defaultCols:2,
    render:(c, ctx) => { c.innerHTML = heroHtml(ctx.k.runway>=6?'good':ctx.k.runway>=3?'warn':'bad','💵','Caixa & Runway',
      fmt(ctx.k.saldo), (isFinite(ctx.k.runway)&&ctx.k.runway>=0?ctx.k.runway.toFixed(1):'∞') + ' meses · burn ' + fmt(ctx.x.burnMes) + '/mês'); }};

  // ═══ KPIs ═══
  W['kpi-receita']    = { label:'KPI · Receita',     category:'kpi', defaultCols:1, render:(c,ctx) => { c.innerHTML = indHtml('good','Receita',fmt(ctx.k.receita),'período'); }};
  W['kpi-ebitda']     = { label:'KPI · EBITDA',      category:'kpi', defaultCols:1, render:(c,ctx) => { c.innerHTML = indHtml(ctx.k.ebitda>=0?'good':'bad','EBITDA',fmt(ctx.k.ebitda),'margem '+fmtPct(ctx.k.margem)); }};
  W['kpi-burn']       = { label:'KPI · Burn Rate',   category:'kpi', defaultCols:1, render:(c,ctx) => { c.innerHTML = indHtml('warn','Burn Rate',fmt(ctx.x.burnMes),'custos/mês'); }};
  W['kpi-saldo']      = { label:'KPI · Saldo Final', category:'kpi', defaultCols:1, render:(c,ctx) => { c.innerHTML = indHtml('info','Saldo Final',fmt(ctx.k.saldo),'último mês'); }};
  W['kpi-runway']     = { label:'KPI · Runway',      category:'kpi', defaultCols:1, render:(c,ctx) => { c.innerHTML = indHtml(ctx.k.runway>=6?'good':ctx.k.runway>=3?'warn':'bad','Runway',(isFinite(ctx.k.runway)&&ctx.k.runway>=0?ctx.k.runway.toFixed(1):'∞')+' meses','saldo ÷ burn'); }};
