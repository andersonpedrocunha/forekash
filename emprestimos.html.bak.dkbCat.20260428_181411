// ─── Anexos de Pessoa (registry-level) ─────────────────
// Reusa os helpers globais anexoNewId / anexoFmtSize / anexoReadFile /
// anexoIconLabel / ANEXO_MAX_BYTES já definidos pro módulo de clientes —
// o formato do item é o mesmo (id, nome, tipo, tamanho, dataUrl, dataAnexo).
async function addAnexosPessoa(rid, files){
  const r = pesRegistry().find(x => x.id === rid);
  if(!r) return;
  if(!Array.isArray(r.anexos)) r.anexos = [];
  const arr = Array.from(files || []);
  if(arr.length === 0) return;

  const grandes = arr.filter(f => f.size > ANEXO_MAX_BYTES);
  const ok      = arr.filter(f => f.size <= ANEXO_MAX_BYTES);

  if(grandes.length){
    await askConfirm({
      title: 'Arquivo muito grande',
      message: grandes.length === 1
        ? `"${grandes[0].name}" tem ${anexoFmtSize(grandes[0].size)} — o limite é ${anexoFmtSize(ANEXO_MAX_BYTES)} por arquivo.`
        : `${grandes.length} arquivos excedem o limite de ${anexoFmtSize(ANEXO_MAX_BYTES)} por arquivo e foram ignorados.`,
      variant: 'warn',
      confirmLabel: 'Entendi',
      cancelLabel: ''
    });
  }

  for(const f of ok){
    try{
      const url = await anexoReadFile(f);
      r.anexos.push({
        id: anexoNewId(),
        nome: f.name || 'arquivo',
        tipo: f.type || '',
        tamanho: f.size || 0,
        dataUrl: url,
        dataAnexo: new Date().toISOString()
      });
    }catch(e){
      console.warn('Falha ao anexar', f && f.name, e);
    }
  }
  pessoasSave();
  if(_pesCardOpenId != null) renderPesCardBody();
}

function downloadAnexoPessoa(rid, anexoId){
  const r = pesRegistry().find(x => x.id === rid);
  if(!r || !Array.isArray(r.anexos)) return;
  const a = r.anexos.find(x => x.id === anexoId);
  if(!a || !a.dataUrl) return;
  const el = document.createElement('a');
  el.href = a.dataUrl;
  el.download = a.nome || 'anexo';
  document.body.appendChild(el);
  el.click();
  setTimeout(() => el.remove(), 0);
}

async function removeAnexoPessoa(rid, anexoId){
  const r = pesRegistry().find(x => x.id === rid);
  if(!r || !Array.isArray(r.anexos)) return;
  const idx = r.anexos.findIndex(x => x.id === anexoId);
  if(idx === -1) return;
  const a = r.anexos[idx];
  const ok = await askConfirm({
    title: 'Remover anexo',
    message: `Remover "${a.nome}" desta pessoa? Esta ação não pode ser desfeita.`,
    variant: 'danger',
    confirmLabel: 'Remover',
    cancelLabel: 'Cancelar'
  });
  if(!ok) return;
  r.anexos.splice(idx, 1);
  pessoasSave();
  if(_pesCardOpenId != null) renderPesCardBody();
}

