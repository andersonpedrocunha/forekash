                       ? ', ' + Object.keys(regra.clientesPct).length + ' específico(s)'
                       : '') + ')'
                  : (regra.pct||0) + '%') +
           ' · ' + (regra.base === 'clientes' ? 'Clientes específicos' :
                    regra.base === 'exceto'   ? 'Todos exceto X' : 'Todos clientes') +
           ' · ' + (regra.tipoBase === 'liquida' ? 'Líquida' : 'Bruta') +
           ((parseFloat(regra.abaterImpostos)||0) > 0
              ? ' · <span style="color:#B45309">−' + regra.abaterImpostos + '% imp.</span>'
              : '')
        )).map(line => '<div class="vend-regra-line">' + line + '</div>').join('')
      : '<span style="color:#9CA3AF">— sem regra vigente —</span>';
    const isAtivo = v.ativo !== false;
    const nomeDisplay = v.nome || '(sem nome)';
    // Toggle de ativo (estilo switch, igual ao de pessoas)
    const toggleHtml = `<label class="pes-sw-wrap" style="display:inline-flex;margin:0">
      <input type="checkbox" class="pes-sw" ${isAtivo?'checked':''}
             onchange="toggleVendAtivo(${v.id}, this.checked)"
             title="${isAtivo?'Vendedor ativo — clique pra inativar':'Vendedor inativo — clique pra ativar'}">
    </label>`;
    // Cor sutil nas células de venda/geração/paga
    const pagoRatio = comMes > 0 ? (pagaMes/comMes) : 0;
    const pagaColor = pagoRatio >= 1 ? '#047857' : pagoRatio > 0 ? '#B45309' : '#9CA3AF';
    return `<tr>
      <td style="text-align:left;font-weight:700;padding-left:14px">${esc(nomeDisplay)}${(!v.pessoaId)?' <span class="vend-externo-badge" title="Vendedor externo — sem pessoa vinculada">EXT</span>':''}<button class="vend-rel-ico" onclick="openVendRelatorio(${v.id})" title="Ver relatório (clientes + pagamentos)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v8M12 6v12M16 13v5"/></svg></button></td>
      <td style="text-align:center">${toggleHtml}</td>
      <td style="text-align:left;font-size:.78rem">${regraTxt}</td>
      <td style="text-align:right;font-variant-numeric:tabular-nums;font-weight:600;color:#059669">${vendaMes>0?fmtBRL(vendaMes):'—'}</td>
      <td style="text-align:right;font-variant-numeric:tabular-nums;font-weight:700">${comMes>0?fmtBRL(comMes):'—'}</td>
      <td style="text-align:right;font-variant-numeric:tabular-nums;font-weight:700;color:${pagaColor}">${pagaMes>0?fmtBRL(pagaMes):'—'}</td>
      <td style="text-align:right;font-variant-numeric:tabular-nums;font-weight:800;color:${atrasoVend>0?'#B91C1C':'#9CA3AF'}" title="Comissão gerada em meses passados ainda não paga">${atrasoVend>0?fmtBRL(atrasoVend):'—'}</td>
      <td style="text-align:right;font-variant-numeric:tabular-nums;font-weight:700;color:${previsaoVend>0?'#4C1D95':'#9CA3AF'}" title="Comissão a gerar a partir de ${esc(periodoLbl)} ainda não paga">${previsaoVend>0?fmtBRL(previsaoVend):'—'}</td>
      <td style="text-align:center">
        <button class="pes-row-btn" onclick="openVendedorEditor(${v.id})" title="Editar"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4z"/></svg></button>
        <button class="pes-row-btn delete" onclick="delVendedor(${v.id})" title="Remover"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14z"/></svg></button>
      </td>
    </tr>`;
  }).join('');
  if(tfoot) tfoot.innerHTML = '';
  // Top 3 vendedores por comissão gerada no período
  const top3 = allVends.sort((a,b) => b.valor - a.valor).slice(0, 3);
  _renderVendKpis({
    periodoLbl, atrasoLblPeriodo,
    totalVendaMes, totalGeradaMes, totalPagaMes, totalAtraso, totalPrevisao,
