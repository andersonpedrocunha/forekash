const HOME_NEWS_SRC_KEY   = 'home_news_src_v1';
const HOME_NEWS_SEEN_KEY  = 'home_news_seen_v1';
const HOME_NEWS_SEEN_MAX  = 500; // cap — evita crescer sem limite
let   _homeNewsLock = false;
let   _homeNewsSeen = null; // Set de URLs já abertas (lazy-load)

function homeNewsSeenLoad(){
  if(_homeNewsSeen) return _homeNewsSeen;
  try{
    const raw = localStorage.getItem(HOME_NEWS_SEEN_KEY);
    const arr = raw ? JSON.parse(raw) : [];
    _homeNewsSeen = new Set(Array.isArray(arr) ? arr : []);
  }catch(e){
    _homeNewsSeen = new Set();
  }
  return _homeNewsSeen;
}
function homeNewsSeenHas(url){
  if(!url) return false;
  return homeNewsSeenLoad().has(url);
}
function homeNewsSeenAdd(url){
  if(!url) return;
  const s = homeNewsSeenLoad();
  if(s.has(url)) return;
  s.add(url);
  // Aplica o cap: remove os mais antigos (como Set mantém ordem de inserção)
  if(s.size > HOME_NEWS_SEEN_MAX){
    const arr = [...s];
    const trimmed = arr.slice(arr.length - HOME_NEWS_SEEN_MAX);
    _homeNewsSeen = new Set(trimmed);
  }
  try{ localStorage.setItem(HOME_NEWS_SEEN_KEY, JSON.stringify([..._homeNewsSeen])); }catch(e){}
}
// Hook global — chamado no onclick do link
function homeNewsMarkSeen(url, el){
  homeNewsSeenAdd(url);
  if(el && el.classList){
    el.classList.add('is-seen');
    // Injeta check se ainda não existe
    if(!el.querySelector('.home-news-check')){
      const meta = el.querySelector('.home-news-meta');
      if(meta){
        const span = document.createElement('span');
        span.className = 'home-news-check';
        span.innerHTML = '<svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>';
        meta.appendChild(span);
      }
    }
  }
}

function homeNewsCurrentSource(){
  let s = null;
  try{ s = localStorage.getItem(HOME_NEWS_SRC_KEY) || null; }catch(e){}
  if(!s || !HOME_NEWS_SOURCES[s]) s = 'infomoney-mercados';
  return s;
}
function homeNewsChangeSource(src){
  if(!HOME_NEWS_SOURCES[src]) return;
  try{ localStorage.setItem(HOME_NEWS_SRC_KEY, src); }catch(e){}
  homeFetchNews(true);
}
function homeNewsTimeAgo(dt){
  if(!dt || isNaN(dt.getTime())) return '';
  const diffMs = Date.now() - dt.getTime();
  const diffMin = Math.round(diffMs / 60000);
  if(diffMin < 1)    return 'agora';
  if(diffMin < 60)   return 'há ' + diffMin + 'min';
  const diffH = Math.round(diffMin / 60);
  if(diffH < 24)     return 'há ' + diffH + 'h';
  const diffD = Math.round(diffH / 24);
  if(diffD === 1)    return 'ontem';
  if(diffD < 7)      return 'há ' + diffD + ' dias';
  // Formatar data absoluta em pt-BR (ex: "14/abr")
  const mesAbrev = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  return dt.getDate() + '/' + mesAbrev[dt.getMonth()];
}
function homeNewsStripHtml(s){
  if(!s) return '';
  const tmp = document.createElement('div');
  tmp.innerHTML = String(s);
  return (tmp.textContent || tmp.innerText || '').trim();
}
async function homeFetchNews(force){
  const src  = homeNewsCurrentSource();
  const meta = HOME_NEWS_SOURCES[src];
  if(!meta) return;

  // Cache
  if(!force){
    try{
      const raw = localStorage.getItem(HOME_NEWS_CACHE_KEY);
      if(raw){
        const c = JSON.parse(raw);
        if(c && c.src === src && c.ts && (Date.now() - c.ts) < HOME_NEWS_CACHE_TTL && Array.isArray(c.items)){
          homeRenderNews(c.items);
          return;
        }
      }
    }catch(e){}
  }

  if(_homeNewsLock) return;
  _homeNewsLock = true;

  // Estado de loading visual
  const btn = document.getElementById('home-news-refresh-btn');
  if(btn) btn.classList.add('is-loading');
  // Se não tem cache renderizado, mostra skeleton
  const listEl = document.getElementById('home-news-list');
  if(listEl && force && !listEl.querySelector('.home-news-item')){
    // mantém skeleton existente
  }

  // Tenta via rss2json.com (JSON-friendly, suporta CORS)
  const apiUrl = 'https://api.rss2json.com/v1/api.json?rss_url=' + encodeURIComponent(meta.rss);
  let items = null, errMsg = null;
  try{
    const r = await fetch(apiUrl, { cache:'no-store' });
    if(r.ok){
      const j = await r.json();
      if(j && j.status === 'ok' && Array.isArray(j.items)){
        items = j.items.slice(0, 8).map(it => ({
          title:  homeNewsStripHtml(it.title || ''),
          link:   String(it.link || ''),
          pubDate: it.pubDate || '',
          source: meta.short
        })).filter(it => it.title && it.link);
      } else {
        errMsg = (j && j.message) || 'Feed inválido';
      }
    } else {
      errMsg = 'HTTP ' + r.status;
    }
  }catch(e){
    errMsg = e && e.message || 'Sem conexão';
  }

  if(items && items.length){
    try{ localStorage.setItem(HOME_NEWS_CACHE_KEY, JSON.stringify({ src, ts: Date.now(), items })); }catch(e){}
    homeRenderNews(items);
  } else {
    // Fallback: tenta usar o último cache mesmo expirado
    let stale = null;
    try{
      const raw = localStorage.getItem(HOME_NEWS_CACHE_KEY);
      if(raw){
        const c = JSON.parse(raw);
        if(c && c.src === src && Array.isArray(c.items) && c.items.length) stale = c.items;
      }
    }catch(e){}
    if(stale) homeRenderNews(stale);
    else      homeRenderNewsEmpty(errMsg || 'Não foi possível carregar as notícias');
  }

  if(btn) btn.classList.remove('is-loading');
  _homeNewsLock = false;

  // Sincroniza select com fonte atual
  const pick = document.getElementById('home-news-src');
  if(pick && pick.value !== src) pick.value = src;
}
function homeRenderNews(items){
  const list = document.getElementById('home-news-list');
  if(!list) return;
  if(!items || !items.length){
    homeRenderNewsEmpty('Sem manchetes no momento');
    return;
  }
  const arrow = '<svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
  const esc = (s) => String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');

  const checkIco = '<svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>';
  const html = items.slice(0, 6).map(it => {
    const dt  = it.pubDate ? new Date(it.pubDate) : null;
    const rel = dt && !isNaN(dt.getTime()) ? homeNewsTimeAgo(dt) : '';
    const seen = homeNewsSeenHas(it.link);
    const cls  = 'home-news-item' + (seen ? ' is-seen' : '');
    return `<li>
      <a class="${cls}" href="${esc(it.link)}" target="_blank" rel="noopener noreferrer"
         onclick="homeNewsMarkSeen('${esc(it.link)}', this)">
        <span class="home-news-dot"></span>
        <span class="home-news-body">
          <div class="home-news-headline">${esc(it.title)}</div>
          <div class="home-news-meta">
            <span class="home-news-src">${esc(it.source || '')}</span>
            ${rel ? `<span class="home-news-dotsep"></span><span class="home-news-time">${esc(rel)}</span>` : ''}
            ${seen ? `<span class="home-news-check" title="Já lida">${checkIco}</span>` : ''}
          </div>
        </span>
        <span class="home-news-arrow">${arrow}</span>
      </a>
    </li>`;
  }).join('');
  list.innerHTML = html;
}
function homeRenderNewsEmpty(msg){
  const list = document.getElementById('home-news-list');
  if(!list) return;
  const src = HOME_NEWS_SOURCES[homeNewsCurrentSource()];
  const link = src ? src.rss.replace('/feed/','').replace('/rss','') : '#';
  list.innerHTML = `<li class="home-news-empty">
    ${msg || 'Não foi possível carregar as notícias.'}<br>
    <a href="${link}" target="_blank" rel="noopener noreferrer">Abrir a fonte em nova aba →</a>
  </li>`;
}

