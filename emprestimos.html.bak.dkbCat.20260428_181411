  if(!formula) return;
  const ids = new Set();
  String(formula).replace(/\[ref:([^\]\[]+)\]/g, function(_, id){ ids.add(id); return _; });
  for(const id of ids){
    const el = document.querySelector('[data-cellref="'+id.replace(/"/g,'\\"')+'"]');
    if(el && el !== __formulaActiveInput) el.classList.add('formula-ref-highlight');
  }
}

// ── Helpers do arrasto ──────────────────────────────────────────────────────
function __buildRefTokenFromCells(cells){
  const ids = cells.map(c => c.getAttribute('data-cellref'));
  if(ids.length === 1) return '[ref:' + ids[0] + ']';
  return 'SOMA(' + ids.map(id => '[ref:' + id + ']').join(';') + ')';
}
function __renderFormulaDragToken(){
  const ds = __formulaDragState; if(!ds) return;
  const token = __buildRefTokenFromCells(ds.cellsOrdered);
  ds.inp.value = ds.before + token + ds.after;
  const caret = ds.before.length + token.length;
  try{
    if(document.activeElement !== ds.inp) ds.inp.focus();
    ds.inp.setSelectionRange(caret, caret);
  }catch(_){}
  ds.committed = true;
  __updateFormulaPreview();
}
function __endFormulaDrag(){
  const ds = __formulaDragState;
  __formulaDragState = null;
  __formulaDragJustEnded = Date.now();
  document.body.classList.remove('formula-dragging');
  document.querySelectorAll('.formula-drag-ref')
    .forEach(el => el.classList.remove('formula-drag-ref'));
  if(ds){
    // Pequeno flash na(s) célula(s) finais para feedback visual
    for(const c of ds.cellsOrdered){
      c.classList.add('formula-ref-flash');
      setTimeout(() => c.classList.remove('formula-ref-flash'), 600);
    }
    setTimeout(() => {
      try{ if(document.activeElement !== ds.inp) ds.inp.focus(); }catch(_){}
      __updateFormulaPreview();
    }, 0);
  }
