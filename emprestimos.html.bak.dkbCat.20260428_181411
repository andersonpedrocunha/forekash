function _dkbFmtNumBR(n){
  if(typeof n !== 'number' || !isFinite(n)) n = parseFloat(n) || 0;
  const fixed = n.toFixed(2);
  const parts = fixed.split('.');
  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  return parts[0] + ',' + parts[1];
}
function _dkbParseNumBR(s){
  if(typeof s === 'number') return s;
  if(!s) return 0;
  const cleaned = String(s).replace(/[^\d,.\-]/g,'').replace(/\./g,'').replace(',','.');
  const n = parseFloat(cleaned);
  return isFinite(n) ? n : 0;
}
function _dkbPagFormatBlur(el){
  if(!el) return;
  const n = _dkbParseNumBR(el.value);
  el.value = _dkbFmtNumBR(n);
  _dkbPagCalc();
}
try {
  window._dkbFmtNumBR = _dkbFmtNumBR;
  window._dkbParseNumBR = _dkbParseNumBR;
  window._dkbPagFormatBlur = _dkbPagFormatBlur;
} catch(e){}

function _dkbPagCalc(){
  const v = _dkbParseNumBR(document.getElementById('dkb-fld-valpago')?.value);
  const j = _dkbParseNumBR(document.getElementById('dkb-fld-juros')?.value);
  const m = _dkbParseNumBR(document.getElementById('dkb-fld-multa')?.value);
  const d = _dkbParseNumBR(document.getElementById('dkb-fld-desc')?.value);
  const total = v + j + m - d;
  const elT = document.getElementById('dkb-pag-total');
  if(elT) elT.textContent = _dkbFmtNumBR(total);
  const ctx = _dkbModalCtx;
  let orig = 0;
  if(ctx){
    const ad = DKB_ADAPTERS[ctx.ctxId];
    const it = ad && (ad.items() || []).find(x => x.id === ctx.itemId);
    if(it){ const valores = ad.valoresOf(it); orig = parseFloat(valores[ctx.ym]) || 0; }
  }
  const saldo = Math.max(0, orig - v);
  const elS = document.getElementById('dkb-pag-saldo');
  const elH = document.getElementById('dkb-pag-saldo-hint');
  if(elS){ elS.textContent = 'R$ ' + _dkbFmtNumBR(saldo); elS.classList.toggle('zero', saldo <= 0.001); }
  if(elH){
    if(saldo > 0.001){ elH.textContent = '⚠ Pagamento parcial — saldo permanece em aberto.'; elH.style.color = '#FCD34D'; }
    else if(v > orig + 0.001){ elH.textContent = 'ℹ Valor maior que o original (juros/multa cobertos).'; elH.style.color = '#86EFAC'; }
    else { elH.textContent = 'Quitação total · esta parcela será encerrada.'; elH.style.color = '#94A3B8'; }
  }
}
try { window._dkbPagCalc = _dkbPagCalc; } catch(e){}

