// Auto-persiste anexo/comprovante do modal DKB no item de origem (sem precisar clicar Salvar)
function _dkbAnexoAutoPersist(field, list){
  try {
    const c = _dkbModalCtx;
    if(!c) return;
    const ad = (typeof DKB_ADAPTERS !== 'undefined') ? DKB_ADAPTERS[c.ctxId] : null;
    if(!ad) return;
    const it = (ad.items() || []).find(x => x.id === c.itemId);
    if(!it) return;
