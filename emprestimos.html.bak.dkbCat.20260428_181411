<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Controle de Empréstimos — Taller</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  <script>
    if(typeof pdfjsLib !== 'undefined'){
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    }
  </script>
  <style>
    :root {
      --bg:       #0F172A;
      --surf:     #1E293B;
      --blue:     #3B82F6;
      --blue-d:   #2563EB;
      --tx:       #111827;
      --txm:      #6B7280;
      --txl:      #9CA3AF;
      --page:     #F3F4F6;
      --card:     #FFFFFF;
      --bdr:      #E5E7EB;
      --red:      #EF4444;
      --red-bg:   #FEF2F2;
      --green:    #10B981;
      --green-bg: #D1FAE5;
      --r: 10px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',Roboto,sans-serif;
         background:var(--page);color:var(--tx);min-height:100vh;font-size:14px}

    /* ── HEADER ── */
    .hdr{background:var(--bg);height:56px;padding:0 28px;display:flex;align-items:center;
         justify-content:space-between;position:sticky;top:0;z-index:100;
         border-bottom:1px solid rgba(255,255,255,0.05)}
    .logo{display:flex;align-items:center;user-select:none}
    .logo svg{display:block;shape-rendering:geometricPrecision;
              image-rendering:-webkit-optimize-contrast}
    .logo img{display:block;max-height:50px;max-width:220px;width:auto;height:auto;object-fit:contain}
    .hdr-r{display:flex;align-items:center;gap:18px}
    .save-dot{display:inline-flex;align-items:center;gap:5px;font-size:0.7rem;color:#4B5563}
    .save-dot i{width:6px;height:6px;border-radius:50%;background:#22C55E;display:inline-block}
    .hdr-lbl{font-size:0.72rem;color:#4B5563;letter-spacing:0.04em}

    /* ── MAIN ── */
    .main{max-width:1480px;margin:0 auto;padding:26px 22px 52px}
    .pg-title{font-size:1.35rem;font-weight:700;letter-spacing:-0.015em}
    .pg-sub{font-size:0.8rem;color:var(--txm);margin-top:3px;margin-bottom:20px}

    /* ── TABS ── */
    .tabs{display:flex;border-bottom:2px solid var(--bdr);margin-bottom:18px}
    .tab-btn{padding:8px 18px;font-size:0.8rem;font-weight:600;color:var(--txm);
             background:none;border:none;cursor:pointer;
             border-bottom:2px solid transparent;margin-bottom:-2px;
             transition:color .15s,border-color .15s}
    .tab-btn:hover{color:var(--blue)}
    .tab-btn.active{color:var(--blue-d);border-bottom-color:var(--blue-d)}
    .tab-pane{display:none}.tab-pane.active{display:block}

    /* ── CARD ── */
    .card{background:var(--card);border-radius:var(--r);
          box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04);overflow:hidden}
    .toolbar{display:flex;align-items:center;justify-content:space-between;
             padding:10px 14px;border-bottom:1px solid var(--bdr);
             background:#FAFAFA;flex-wrap:wrap;gap:8px}
    .tl{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .ti{font-size:0.73rem;color:var(--txm)}

    /* ── BUTTONS ── */
    .btn{border:none;border-radius:7px;padding:6px 12px;font-size:0.73rem;font-weight:600;
         cursor:pointer;display:inline-flex;align-items:center;gap:5px;
         transition:opacity .15s,background .15s;white-space:nowrap;font-family:inherit}
    .btn-p{background:var(--blue-d);color:#fff}
    .btn-p:hover{background:#1D4ED8}
    .btn-g{background:#F3F4F6;color:var(--txm);border:1px solid var(--bdr)}
    .btn-g:hover{background:#E5E7EB;color:var(--tx)}
    .btn-tog{background:#F3F4F6;color:var(--txm);border:1px solid var(--bdr);
             padding:5px 11px;font-size:0.72rem}
    .btn-tog.on{background:var(--blue-d);color:#fff;border-color:var(--blue-d)}

    /* ── TABLE ── */
    .tbl-wrap{overflow-x:auto}
    table{width:100%;border-collapse:collapse}
    thead th{background:var(--bg);color:#94A3B8;text-align:left;padding:8px 10px;
             font-size:0.66rem;font-weight:700;text-transform:uppercase;
             letter-spacing:.06em;white-space:nowrap}
    thead th.c{text-align:center}
    thead th.r{text-align:right}
    tbody tr{border-bottom:1px solid var(--bdr);transition:background .1s}
    tbody tr:hover{background:#F8FAFF}
    tbody tr:last-child{border-bottom:none}
    tbody td{padding:2px 4px;vertical-align:top}
    tbody td.c{text-align:center;vertical-align:middle}
    tbody td.r{text-align:right;vertical-align:middle}
    tbody td.m{font-family:'Menlo','Consolas',monospace}

    .ci{width:100%;border:1px solid transparent;border-radius:6px;padding:5px 7px;
        font-size:0.775rem;background:transparent;color:var(--tx);outline:none;
        font-family:inherit;transition:border-color .12s,background .12s}
    .ci:focus{border-color:var(--blue);background:#EFF6FF;
              box-shadow:0 0 0 2px rgba(59,130,246,.12)}
    .ci.r{text-align:right}
    .ci.m{font-family:'Menlo','Consolas',monospace}
    .ci.red{color:#DC2626;font-weight:600}

    .c-meta{font-size:.62rem;color:var(--txl);padding:1px 2px 3px;
            white-space:nowrap;line-height:1.3}
    .btn-hist{background:none;border:none;cursor:pointer;color:var(--blue);
              font-size:.62rem;padding:0;text-decoration:underline;
              text-underline-offset:2px;font-family:inherit}
    .btn-hist:hover{color:var(--blue-d)}

    .parc-row{display:flex;align-items:center;gap:4px}
    .parc-sep{color:var(--txl);font-size:.75rem;flex-shrink:0}
    .prog-bar{height:3px;background:#E5E7EB;border-radius:2px;margin:3px 2px 2px;overflow:hidden}
    .prog-fill{height:100%;background:linear-gradient(90deg,var(--blue-d),var(--blue));
               border-radius:2px;transition:width .3s}

    .c-drag   {width:26px;min-width:26px;text-align:center;vertical-align:middle;
               padding:0 !important;color:#9CA3AF;cursor:grab;user-select:none;
               transition:color .12s,background .12s}
    .c-drag:hover{color:#4C1D95;background:#F5F3FF}
    .c-drag:active{cursor:grabbing}
    tr.loan-dragging{opacity:.4}
    tr.loan-drop-before{box-shadow:inset 0 3px 0 #4C1D95}
    tr.loan-drop-after {box-shadow:inset 0 -3px 0 #4C1D95}
    .c-banco  {min-width:148px}.c-desc  {min-width:165px}
    .c-valor  {min-width:122px}.c-taxa  {min-width:96px}
    .c-parcela{min-width:130px}.c-parc  {min-width:130px}
    .c-saldo  {min-width:158px}.c-term  {min-width:122px}
    .c-tipo   {min-width:96px;text-align:center}
    .tipo-sel{font-size:.68rem;font-weight:700;border:1px solid var(--bdr);border-radius:5px;
              padding:3px 5px;background:#F8FAFF;color:var(--tx);cursor:pointer;width:100%}
    .tipo-sel.sac    {background:#FEF3C7;border-color:#FCD34D;color:#92400E}
    .tipo-sel.price  {background:#F0FDF4;border-color:#BBF7D0;color:#065F46}
    .tipo-sel.custom {background:#EFF6FF;border-color:#BFDBFE;color:#1D4ED8}

    /* ── Manager modal: modalidades de empréstimo ── */
    .loan-mod-intro{font-size:.78rem;color:var(--txm);line-height:1.55;margin:0 0 14px;
                    padding:10px 12px;background:#F9FAFB;border-radius:8px;
                    border-left:3px solid var(--blue-d)}
    .loan-mod-intro strong{color:var(--tx)}
    .loan-mod-list{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
    .loan-mod-item{display:flex;align-items:center;gap:10px;padding:7px 10px;
                   background:#fff;border:1px solid var(--bdr);border-radius:8px}
    .loan-mod-item .tipo-sel{font-size:.68rem;padding:4px 8px}
    .loan-mod-nome{flex:1;border:1px solid transparent;background:transparent;
                   padding:6px 8px;border-radius:6px;font-family:inherit;font-size:.82rem;
                   color:var(--tx);outline:none;transition:all .12s}
    .loan-mod-nome:focus{border-color:var(--blue);background:#F8FBFF}
    .loan-mod-nome:disabled{color:var(--txm);cursor:not-allowed;opacity:.75}
    .loan-mod-engine{display:inline-flex;background:#F3F4F6;border:1px solid var(--bdr);
                     border-radius:7px;padding:2px;gap:0}
    .loan-mod-engine button{border:none;background:transparent;padding:4px 10px;
                            border-radius:5px;font-family:inherit;font-size:.7rem;
                            font-weight:700;color:var(--txm);cursor:pointer;
                            transition:all .12s;letter-spacing:.02em}
    .loan-mod-engine button:hover:not(:disabled){color:var(--tx);background:#E5E7EB}
    .loan-mod-engine button.price.active{background:#F0FDF4;color:#065F46;
                                         box-shadow:0 1px 2px rgba(0,0,0,.06)}
    .loan-mod-engine button.sac.active  {background:#FEF3C7;color:#92400E;
                                         box-shadow:0 1px 2px rgba(0,0,0,.06)}
    .loan-mod-engine button:disabled{cursor:not-allowed;opacity:.55}
    .loan-mod-uses{font-size:.68rem;color:var(--txl);min-width:54px;text-align:right;
                   font-variant-numeric:tabular-nums}
    .loan-mod-uses.zero{color:#CBD5E1}
    .loan-mod-del{background:none;border:none;cursor:pointer;color:#9CA3AF;
                  padding:5px;border-radius:6px;transition:all .12s;
                  display:inline-flex;align-items:center;justify-content:center}
    .loan-mod-del svg{width:15px;height:15px}
    .loan-mod-del:hover:not(:disabled){color:#DC2626;background:var(--red-bg)}
    .loan-mod-del:disabled{opacity:.3;cursor:not-allowed}
    .loan-mod-add-row{display:flex;gap:8px;align-items:center;padding:10px;
                      background:#F9FAFB;border:1px dashed var(--bdr);border-radius:8px}
    .loan-mod-add-row input{flex:1;border:1px solid var(--bdr);border-radius:6px;
                            padding:7px 10px;font-family:inherit;font-size:.82rem;
                            color:var(--tx);outline:none;background:#fff}
    .loan-mod-add-row input:focus{border-color:var(--blue);background:#F8FBFF}
    .loan-mod-add-btn{background:var(--blue-d);color:#fff;border:none;border-radius:7px;
                      padding:7px 12px;font-family:inherit;font-size:.76rem;font-weight:700;
                      cursor:pointer;display:inline-flex;align-items:center;gap:5px}
    .loan-mod-add-btn:hover{background:#1E40AF}
    .loan-mod-add-btn svg{width:11px;height:11px}
    .banco-manual{margin-top:2px;font-style:italic}

    /* ── COLUNA CONTRATO ── */
    .c-cont{min-width:72px;text-align:center;vertical-align:middle}
    .btn-attach{background:none;border:1px dashed #D1D5DB;border-radius:7px;
                padding:5px 9px;font-size:.68rem;cursor:pointer;color:var(--txm);
                transition:all .15s;display:inline-flex;align-items:center;gap:4px;
                font-family:inherit;white-space:nowrap}
    .btn-attach:hover{border-color:var(--blue);color:var(--blue-d);background:#EFF6FF;border-style:solid}
    .btn-attach.has-files{background:#EFF6FF;border-color:#BFDBFE;color:var(--blue-d);
                          border-style:solid;font-weight:600}

    /* ── MODAL CONTRATOS ── */
    .att-item{display:flex;align-items:center;gap:10px;padding:10px 0;
              border-bottom:1px solid var(--bdr)}
    .att-item:last-of-type{border-bottom:none}
    .att-icon{width:34px;height:34px;border-radius:8px;background:#F1F5F9;
              display:flex;align-items:center;justify-content:center;
              flex-shrink:0;font-size:1.05rem}
    .att-name{font-size:.78rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;
              white-space:nowrap;max-width:260px}
    .att-meta{font-size:.65rem;color:var(--txm);margin-top:1px}
    .att-actions{display:flex;gap:5px;flex-shrink:0;margin-left:auto}
    .drop-zone{border:2px dashed var(--bdr);border-radius:10px;padding:26px 20px;
               text-align:center;cursor:pointer;transition:all .18s;margin-top:14px;
               display:block}
    .drop-zone:hover,.drop-zone.drag-over{border-color:var(--blue);background:#EFF6FF}
    .drop-zone-txt{font-size:.78rem;color:var(--txm);line-height:1.6}
    .att-warn{background:#FFFBEB;border:1px solid #FCD34D;border-radius:7px;
              padding:8px 12px;font-size:.7rem;color:#92400E;margin-top:10px}
    .empty-row td{text-align:center;padding:52px;color:var(--txl);font-size:.82rem}

    /* ── Row reorder (drag handle) ── */
    .row-drag-handle{display:inline-flex;align-items:center;justify-content:center;
                     width:0;height:18px;color:#94A3B8;background:transparent;border:none;
                     padding:0;cursor:grab;opacity:0;overflow:hidden;
                     transition:width .12s ease, opacity .12s ease;
                     flex:none;user-select:none;margin-right:0}
    .row-drag-handle svg{width:12px;height:14px;display:block}
    .row-drag-handle:hover{color:#475569}
    .row-drag-handle:active{cursor:grabbing;color:#2563EB}
    tr:hover > td .row-drag-handle,
    tr.row-drag-hover .row-drag-handle{width:14px;opacity:1;margin-right:2px}
    tr.row-dragging > td{opacity:.4}
    tr.row-drop-above > td{box-shadow:inset 0 2px 0 0 var(--blue)}
    tr.row-drop-below > td{box-shadow:inset 0 -2px 0 0 var(--blue)}

    /* ── SUMMARY ── */
    .summary{display:flex;flex-wrap:wrap;gap:22px;padding:11px 16px;
             border-top:1px solid var(--bdr);background:#FAFAFA}
    .si{display:flex;flex-direction:column;gap:1px}
    .si .lbl{font-size:.63rem;color:var(--txl);font-weight:700;
             text-transform:uppercase;letter-spacing:.07em}
    .si .val{font-size:.9rem;font-weight:700;color:var(--tx)}
    .si .val.red{color:#DC2626}.si .val.grn{color:#059669}

    .btn-del{background:none;border:none;cursor:pointer;color:var(--red);
             padding:4px;border-radius:5px;display:inline-flex;align-items:center;
             transition:background .12s}
    .btn-del:hover{background:var(--red-bg)}

    /* Guia compacto: extração automática por PDF (uma linha só) */
    .emp-pdf-guide{position:relative;background:linear-gradient(135deg,#FEF3C7 0%,#FFFBEB 100%);
                   border:1px solid #FCD34D;border-radius:7px;padding:6px 32px 6px 12px;
                   margin:0 0 10px;color:#78350F}
    .emp-pdf-guide-close{position:absolute;top:3px;right:4px;width:20px;height:20px;
                         border-radius:4px;background:transparent;border:0;cursor:pointer;
                         color:#92400E;font-size:1rem;line-height:1;
                         display:inline-flex;align-items:center;justify-content:center}
    .emp-pdf-guide-close:hover{background:rgba(146,64,14,.1)}
    .emp-pdf-guide-body{display:flex;align-items:center;gap:6px;flex-wrap:wrap;
                        font-size:.68rem;line-height:1.45;color:#78350F}
    .emp-pdf-guide-ico{width:13px;height:13px;flex:0 0 auto;stroke-width:2.2}
    .emp-pdf-guide-btn{display:inline-block;background:#FDE68A;border:1px solid #F59E0B;
                       padding:0 5px;border-radius:3px;font-weight:700;font-size:.78em;
                       vertical-align:middle}
    /* Chip pra reabrir o guia depois de ocultar */
    .emp-pdf-guide-reopen{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;
                          background:#FEF3C7;border:1px dashed #FCD34D;border-radius:5px;
                          cursor:pointer;font-size:.64rem;font-weight:700;color:#92400E;
                          font-family:inherit;margin:0 0 10px;transition:all .12s}
    .emp-pdf-guide-reopen:hover{background:#FDE68A;border-style:solid}

    /* Botão "Buscar taxa no contrato" (aba Empréstimos, coluna Juros) */
    .c-taxa-wrap{display:flex;align-items:center;gap:4px}
    .c-taxa-wrap .ci{flex:1;min-width:0}
    .btn-taxa-auto{flex:0 0 auto;background:#EEF2FF;border:1px solid #C7D2FE;cursor:pointer;
                   color:#4338CA;padding:3px 5px;border-radius:5px;
                   display:inline-flex;align-items:center;justify-content:center;
                   transition:all .12s}
    .btn-taxa-auto:hover{background:#E0E7FF;border-color:#818CF8;color:#3730A3;
                         box-shadow:0 1px 3px rgba(99,102,241,.15)}
    .btn-taxa-auto:disabled{opacity:.5;cursor:not-allowed}
    .btn-taxa-auto svg{display:block}

    /* Modal de extração de taxa */
    .taxa-modal-ov{position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:1000;
                   display:flex;align-items:center;justify-content:center;padding:20px;
                   animation:regAddFade .15s ease-out}
    .taxa-modal{background:#fff;border-radius:12px;max-width:580px;width:100%;max-height:80vh;
                display:flex;flex-direction:column;box-shadow:0 25px 50px -12px rgba(0,0,0,.45);
                overflow:hidden}
    .taxa-modal-hd{padding:16px 20px;border-bottom:1px solid var(--bdr);display:flex;
                   align-items:center;justify-content:space-between;gap:12px}
    .taxa-modal-ttl{font-size:.95rem;font-weight:800;color:#0F172A;margin:0}
    .taxa-modal-ttl small{display:block;font-size:.62rem;color:var(--txl);font-weight:500;margin-top:2px}
    .taxa-modal-close{width:30px;height:30px;border-radius:6px;background:transparent;border:0;
                      cursor:pointer;color:#64748B;font-size:1.4rem;line-height:1}
    .taxa-modal-close:hover{background:#F1F5F9;color:#0F172A}
    .taxa-modal-bd{padding:18px 20px;overflow:auto;flex:1;min-height:0}
    .taxa-modal-loading{text-align:center;padding:30px 20px;color:var(--txl);font-size:.82rem}
    .taxa-modal-loading .spinner{width:32px;height:32px;border:3px solid #E0E7FF;border-top-color:#6366F1;
                                  border-radius:50%;margin:0 auto 14px;animation:taxaSpin .8s linear infinite}
    @keyframes taxaSpin{to{transform:rotate(360deg)}}
    .taxa-candidate{padding:12px 14px;border:1px solid var(--bdr);border-radius:8px;margin-bottom:8px;
                    cursor:pointer;transition:all .12s;background:#fff;display:flex;gap:10px;align-items:flex-start}
    .taxa-candidate:hover{background:#EEF2FF;border-color:#818CF8;transform:translateY(-1px);
                          box-shadow:0 2px 8px rgba(99,102,241,.12)}
    .taxa-candidate-val{font-size:1.05rem;font-weight:800;color:#4338CA;white-space:nowrap;
                        min-width:90px;flex:0 0 auto}
    .taxa-candidate-val .eq{display:block;font-size:.6rem;font-weight:500;color:var(--txl);margin-top:2px}
    .taxa-candidate-ctx{flex:1;font-size:.72rem;color:#475569;line-height:1.45}
    .taxa-candidate-ctx .hit{background:#FDE68A;padding:0 2px;border-radius:2px;font-weight:700;color:#78350F}
    .taxa-candidate-ctx .src{display:block;margin-top:4px;font-size:.58rem;color:#94A3B8;text-transform:uppercase;letter-spacing:.05em}
    .taxa-empty{padding:24px;text-align:center;color:var(--txl);font-size:.82rem;font-style:italic;
                border:1px dashed var(--bdr);border-radius:8px;background:#FAFBFC}
    .taxa-modal-ft{padding:12px 20px;border-top:1px solid var(--bdr);background:#F8FAFC;
                   display:flex;justify-content:space-between;gap:10px;align-items:center}
    .taxa-modal-ft .hint{font-size:.64rem;color:var(--txl)}
    .taxa-modal-cancel{padding:8px 14px;background:#fff;border:1px solid var(--bdr);border-radius:6px;
                       font-size:.74rem;font-weight:700;color:#475569;cursor:pointer;font-family:inherit}

    /* Botão Editar por linha — toggle bloqueado ↔ editando */
    .loan-row-actions{display:inline-flex;gap:2px;align-items:center}
    .btn-edit{background:none;border:1px solid transparent;cursor:pointer;color:#64748B;
              padding:4px 6px;border-radius:5px;display:inline-flex;align-items:center;
              transition:all .12s}
    .btn-edit:hover{background:#E0E7FF;color:#4338CA;border-color:#C7D2FE}
    .btn-edit.is-on{background:#DCFCE7;color:#166534;border-color:#86EFAC}
    .btn-edit.is-on:hover{background:#BBF7D0;color:#14532D}

    /* Botão "Extrair do contrato" (ações da linha) */
    .btn-extract{background:#FEF3C7;border:1px solid #FCD34D;cursor:pointer;color:#78350F;
                 padding:4px 6px;border-radius:5px;display:inline-flex;align-items:center;
                 transition:all .12s}
    .btn-extract:hover{background:#FDE68A;border-color:#F59E0B;color:#78350F;
                       box-shadow:0 1px 3px rgba(245,158,11,.2)}

    /* Modal de revisão da extração completa */
    .extr-row{display:grid;grid-template-columns:28px 200px 1fr;gap:10px;align-items:flex-start;
              padding:10px 12px;border:1px solid var(--bdr);border-radius:8px;margin-bottom:6px;
              background:#fff}
    .extr-row:hover{background:#FAFBFC}
    .extr-row-chk{display:flex;align-items:center;justify-content:center;padding-top:4px}
    .extr-row-chk input{accent-color:#6366F1;cursor:pointer;transform:scale(1.1)}
    .extr-row-lbl{display:flex;flex-direction:column;gap:2px;padding-top:2px;
                  font-size:.76rem;font-weight:700;color:#0F172A}
    .extr-row-icon{font-size:1rem;margin-right:6px}
    .extr-row-multi{font-size:.58rem;font-weight:600;color:#4338CA;background:#EEF2FF;
                    padding:1px 5px;border-radius:3px;width:fit-content;margin-top:3px}
    .extr-row-main{display:flex;flex-direction:column;gap:5px;min-width:0}
    .extr-row-val{font-size:.84rem;font-weight:700;color:#0F172A;padding:3px 0}
    .extr-row-sel{padding:6px 26px 6px 10px;font-size:.78rem;font-weight:600;color:#0F172A;
                  border:1px solid #E2E8F0;border-radius:6px;background:#fff;cursor:pointer;font-family:inherit;
                  appearance:none;-webkit-appearance:none;
                  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748B' stroke-width='2.4'><path d='M6 9l6 6 6-6'/></svg>");
                  background-repeat:no-repeat;background-position:right 8px center;background-size:11px}
    .extr-row-sel:focus{outline:none;border-color:#6366F1;box-shadow:0 0 0 2px rgba(99,102,241,.15)}
    .extr-row-ctx{font-size:.68rem;color:var(--txl);line-height:1.4;
                   background:#F8FAFC;padding:5px 8px;border-radius:4px;font-style:italic}

    /* Linha travada (read-only) — border sutil nos inputs, sem foco */
    tr.is-locked .ci{background:transparent!important;border-color:transparent!important;
                      cursor:default;color:var(--tx)}
    tr.is-locked .ci:focus{outline:none;box-shadow:none;border-color:transparent!important}
    tr.is-locked select.tipo-sel{pointer-events:none;opacity:.85}
    tr.is-locked .dispo-banco-cell{cursor:default;pointer-events:none}
    /* Em edição: borders explícitas pra indicar que os campos estão ativos */
    tr.is-editing .ci{border-color:#C7D2FE;background:#FAFAFF}
    tr.is-editing .ci:focus{border-color:#6366F1;box-shadow:0 0 0 2px rgba(99,102,241,.15);
                             background:#fff}
    tr.is-editing{background:linear-gradient(90deg,#FAFAFF 0%,#fff 60%)}

    /* ── CHART CARD ── */
    .chart-card{background:var(--card);border-radius:var(--r);
                box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04);
                padding:22px 26px}
    .ch-title{font-size:.92rem;font-weight:700}
    .ch-sub{font-size:.77rem;color:var(--txm);margin:2px 0 18px}
    .ch-wrap{position:relative}
    .filter-row{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:16px}
    .filter-lbl{font-size:.72rem;color:var(--txm);font-weight:600;margin-right:4px}

    /* ── MODALS ── */
    .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.48);
             z-index:400;align-items:center;justify-content:center}
    .overlay.open{display:flex}

    /* ══ Confirm modal (substitui confirm() nativo) ══ */
    .confirm-overlay{position:fixed;inset:0;background:rgba(15,23,42,.55);
                     display:flex;align-items:center;justify-content:center;
                     z-index:9999;backdrop-filter:blur(3px);
                     animation:confirm-fade .15s ease-out}
    .confirm-modal{background:#fff;border-radius:14px;max-width:460px;width:92vw;
                   padding:28px 28px 20px;box-shadow:0 20px 60px rgba(0,0,0,.35);
                   text-align:left;animation:confirm-pop .18s cubic-bezier(.17,.84,.44,1);
                   font-family:inherit}
    .confirm-icon{width:46px;height:46px;border-radius:50%;
                  display:flex;align-items:center;justify-content:center;
                  margin-bottom:14px;flex-shrink:0}
    .confirm-icon.danger{background:#FEE2E2;color:#DC2626}
    .confirm-icon.info{background:#DBEAFE;color:#2563EB}
    .confirm-icon svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:2;
                      stroke-linecap:round;stroke-linejoin:round}
    .confirm-title{font-size:1.08rem;font-weight:800;letter-spacing:-.02em;
                   color:var(--tx);margin:0 0 8px;line-height:1.3;font-family:inherit}
    .confirm-msg{font-size:.88rem;color:var(--txm);margin:0 0 22px;line-height:1.55;
                 font-family:inherit}
    .confirm-msg strong{color:var(--tx);font-weight:700}
    .confirm-actions{display:flex;justify-content:flex-end;gap:10px}
    .confirm-btn{padding:9px 18px;border-radius:8px;border:1px solid transparent;
                 font-family:inherit;font-size:.85rem;font-weight:700;cursor:pointer;
                 transition:all .12s;letter-spacing:-.01em;min-width:90px}
    .confirm-cancel{background:#fff;border-color:var(--bdr);color:var(--tx)}
    .confirm-cancel:hover{background:#F9FAFB;border-color:#D1D5DB}
    .confirm-ok{background:var(--blue);color:#fff;border-color:var(--blue)}
    .confirm-ok:hover{background:var(--blue-d);border-color:var(--blue-d)}
    .confirm-ok.danger{background:#DC2626;border-color:#DC2626}
    .confirm-ok.danger:hover{background:#B91C1C;border-color:#B91C1C}
    .confirm-ok:focus{outline:none;box-shadow:0 0 0 3px rgba(59,130,246,.28)}
    .confirm-ok.danger:focus{box-shadow:0 0 0 3px rgba(220,38,38,.28)}
    .confirm-cancel:focus{outline:none;box-shadow:0 0 0 3px rgba(107,114,128,.22)}
    @keyframes confirm-fade{from{opacity:0}to{opacity:1}}
    @keyframes confirm-pop{from{opacity:0;transform:translateY(10px) scale(.96)}to{opacity:1;transform:none}}
    .modal{background:#fff;border-radius:12px;width:500px;max-width:94vw;
           max-height:74vh;overflow:hidden;display:flex;flex-direction:column;
           box-shadow:0 20px 50px rgba(0,0,0,.24)}
    .modal.wide{width:560px}
    .mod-head{padding:13px 16px;background:var(--bg);color:#fff;
              display:flex;align-items:center;justify-content:space-between}
    .mod-head h3{font-size:.82rem;font-weight:700}
    .btn-close{background:none;border:none;color:#94A3B8;cursor:pointer;
               font-size:1rem;padding:2px 5px;border-radius:4px}
    .btn-close:hover{color:#fff;background:rgba(255,255,255,.1)}
    .mod-body{padding:14px 16px;overflow-y:auto;flex:1}

    .hi{display:flex;align-items:center;justify-content:space-between;
        padding:9px 0;border-bottom:1px solid var(--bdr);font-size:.78rem;gap:10px}
    .hi:last-child{border-bottom:none}
    .hi-val{font-weight:700;color:#DC2626;font-size:.88rem}
    .hi-date{color:var(--txm);font-size:.72rem;white-space:nowrap}
    .badge{font-size:.6rem;padding:2px 6px;border-radius:4px;font-weight:700;white-space:nowrap}
    .b-grn{background:var(--green-bg);color:#065F46}
    .b-red{background:var(--red-bg);color:#991B1B}
    .b-blu{background:#EFF6FF;color:#1D4ED8}
    .no-hi{text-align:center;color:var(--txl);padding:28px;font-size:.82rem}

    .share-sec{margin-bottom:20px}
    .share-sec h4{font-size:.8rem;font-weight:700;margin-bottom:5px}
    .share-sec p{font-size:.77rem;color:var(--txm);margin-bottom:10px;line-height:1.5}
    .divider{border:none;border-top:1px solid var(--bdr);margin:16px 0}

    /* ── BIG TOTAL (aba Atual) ── */
    .big-total{
      display:flex;align-items:flex-start;gap:24px;flex-wrap:wrap;
      padding:14px 20px 12px;border-bottom:1px solid var(--bdr);
      background:var(--card);
    }
    .bt-item{display:flex;flex-direction:column;gap:3px}
    .bt-lbl{font-size:.67rem;font-weight:700;text-transform:uppercase;
            letter-spacing:.07em;color:var(--txl)}
    .bt-val{font-size:clamp(1.3rem,3.5vw,2rem);font-weight:800;letter-spacing:-0.04em;line-height:1}
    .bt-val.c-blue{color:var(--blue-d)}
    .bt-val.c-red {color:#DC2626}
    .bt-val.c-grn {color:#059669}
    .bt-sub{font-size:.73rem;color:var(--txm);margin-top:1px}

    /* ── ANÁLISE TAB ── */
    .an-kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:14px;margin-bottom:18px}
    .an-kpi{background:var(--card);border-radius:var(--r);padding:15px 17px;
            box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04)}
    .an-kpi-lbl{font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;
                color:var(--txl);margin-bottom:5px}
    .an-kpi-val{font-size:1.35rem;font-weight:800;letter-spacing:-0.03em;line-height:1.15}
    .an-kpi-sub{font-size:.67rem;color:var(--txm);margin-top:3px}
    .an-kpi-val.red{color:#DC2626}.an-kpi-val.blue{color:var(--blue-d)}
    .an-kpi-val.grn{color:#059669}.an-kpi-val.amb{color:#D97706}.an-kpi-val.pur{color:#7C3AED}

    .an-2col{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}
    @media(max-width:780px){.an-2col{grid-template-columns:1fr}}
    .an-card{background:var(--card);border-radius:var(--r);padding:20px;
             box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04)}
    .an-card-full{background:var(--card);border-radius:var(--r);margin-bottom:18px;overflow:hidden;
                  box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04)}
    .an-card-hd{padding:16px 20px 12px;border-bottom:1px solid var(--bdr)}

    .an-strat-item{display:flex;align-items:flex-start;gap:10px;padding:10px 0;
                   border-bottom:1px solid var(--bdr)}
    .an-strat-item:last-of-type{border-bottom:none}
    .an-strat-rank{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;
                   justify-content:center;font-size:.67rem;font-weight:800;flex-shrink:0;margin-top:1px}
    .an-strat-rank.p1{background:#FEF3C7;color:#92400E}
    .an-strat-rank.p2{background:#F3F4F6;color:#374151}
    .an-strat-rank.px{background:#FEF2F2;color:#991B1B}
    .an-strat-info{flex:1;min-width:0}
    .an-strat-name{font-size:.78rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .an-strat-detail{font-size:.67rem;color:var(--txm);margin-top:2px}
    .an-strat-taxa{font-size:.78rem;font-weight:700;color:#DC2626;white-space:nowrap;flex-shrink:0}

    .an-alert{background:#FEF2F2;border:1px solid #FCA5A5;border-radius:8px;
              padding:10px 12px;margin-bottom:14px;font-size:.73rem;color:#991B1B}
    .an-tip{background:#EFF6FF;border:1px solid #BFDBFE;border-radius:8px;
            padding:9px 12px;font-size:.69rem;color:#1D4ED8;margin-top:12px;line-height:1.5}

    .an-cf-item{display:flex;align-items:center;gap:14px;padding:9px 0;border-bottom:1px solid var(--bdr)}
    .an-cf-item:last-of-type{border-bottom:none}
    .an-cf-icon{width:32px;height:32px;border-radius:8px;background:#D1FAE5;display:flex;
                align-items:center;justify-content:center;flex-shrink:0;font-size:.9rem}
    .an-cf-date{font-size:.71rem;font-weight:700;color:var(--txm);min-width:65px}
    .an-cf-name{font-size:.78rem;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .an-cf-val{font-size:.78rem;font-weight:700;color:#059669;white-space:nowrap}
    .an-cf-acc{font-size:.67rem;color:var(--txm);white-space:nowrap}

    .an-donut-leg{margin-top:10px;max-height:160px;overflow-y:auto}
    .an-leg-row{display:flex;align-items:center;gap:7px;padding:3px 0}
    .an-leg-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}
    .an-leg-name{font-size:.71rem;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .an-leg-pct{font-size:.71rem;font-weight:700;color:var(--txm)}

    /* ── SUMMARY TOP (aba Empréstimos) ── */
    .summary-top{
      display:flex;flex-wrap:wrap;gap:0;
      border-bottom:1px solid var(--bdr);
      background:#FAFAFA;
    }
    .st-item{
      flex:1;min-width:140px;padding:14px 18px;
      border-right:1px solid var(--bdr);
      display:flex;flex-direction:column;gap:3px;
    }
    .st-item:last-child{border-right:none}
    .st-lbl{font-size:.63rem;font-weight:700;text-transform:uppercase;
            letter-spacing:.07em;color:var(--txl)}
    .st-val{font-size:1.25rem;font-weight:800;color:var(--tx);letter-spacing:-0.02em}
    .st-val.red{color:#DC2626}
    .st-val.grn{color:#059669}
    .st-sub{font-size:.6rem;color:#94A3B8;font-weight:500;margin-top:1px}

    /* ── DÍVIDA legend ── */
    .div-legend{display:flex;gap:18px;flex-wrap:wrap;margin-bottom:14px}
    .leg-item{display:flex;align-items:center;gap:6px;font-size:.75rem;color:var(--txm)}
    .leg-dot{width:12px;height:12px;border-radius:3px;flex-shrink:0}

    .toast{position:fixed;bottom:32px;left:50%;transform:translateX(-50%) translateY(20px);
           background:#1F2937;color:#fff;padding:14px 24px;border-radius:10px;
           font-size:.88rem;font-weight:600;opacity:0;
           transition:opacity .25s ease, transform .25s ease;
           /* Acima dos modais (.confirm-overlay = z-index:9999) */
           z-index:100000;white-space:nowrap;pointer-events:none;
           box-shadow:0 10px 30px rgba(0,0,0,.35), 0 0 0 1px rgba(255,255,255,.08);
           border:2px solid #7C3AED;letter-spacing:.01em;max-width:90vw}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

    /* ── REGISTRO TAB ── */
    .reg-nav{display:flex;align-items:center;gap:8px}
    /* Popícone 📅 (data + banco) */
    .reg-cell-wrap{position:relative;display:flex;align-items:center;gap:4px}
    .reg-cell-wrap input.ci{flex:1}
    .reg-cell-cal-btn{flex-shrink:0;width:26px;height:26px;border:1px solid #E2E8F0;background:#fff;border-radius:5px;cursor:pointer;font-size:.86rem;line-height:1;padding:0;color:#64748B;transition:all .12s;font-family:inherit;display:inline-flex;align-items:center;justify-content:center}
    .reg-cell-cal-btn:hover{background:#F1F5F9;color:#0F172A;border-color:#CBD5E1}
    .reg-cell-cal-btn.has-data{background:#F5F3FF;border-color:#7C3AED;color:#5B21B6}
    .reg-cell-cal-btn.has-data:hover{background:#EDE9FE}
    .reg-cell-cal-btn.is-baixa{background:#16A34A;border-color:#15803D;color:#fff}
    .reg-cell-cal-btn.is-baixa:hover{background:#15803D;color:#fff}
    .reg-cell-cal-btn.is-reabrir{background:#FEE2E2;border-color:#FCA5A5;color:#B91C1C}
    .reg-cell-cal-btn.is-reabrir:hover{background:#FCA5A5;color:#fff}
    /* Linha com baixa registrada */
    tr.reg-row.is-baixa{background:#F0FDF4 !important}
    tr.reg-row.is-baixa td{background:transparent !important}
    tr.reg-row.is-baixa input.ci{background:#F8FAFC;color:#475569;cursor:not-allowed}
    .reg-cell-hint{display:block;font-size:.62rem;color:#64748B;margin-top:1px;font-weight:600;letter-spacing:.01em;text-align:right}
    .reg-cell-hint.is-saldo{color:#7C3AED}
    /* Popover */
    .reg-pop{position:fixed;z-index:100000;background:#fff;border:1px solid #E2E8F0;border-radius:10px;box-shadow:0 12px 30px rgba(15,23,42,.18);padding:12px;min-width:230px;display:none;font-family:inherit}
    .reg-pop.is-open{display:block}
    .reg-pop h4{margin:0 0 8px;font-size:.78rem;font-weight:800;color:#0F172A;display:flex;align-items:center;gap:6px}
    .reg-pop h4 .x{margin-left:auto;background:transparent;border:none;cursor:pointer;font-size:1.05rem;line-height:1;color:#94A3B8;padding:2px 4px;border-radius:3px;font-family:inherit}
    .reg-pop h4 .x:hover{background:#F1F5F9;color:#1E293B}
    .reg-pop label{display:block;font-size:.66rem;font-weight:700;color:#475569;margin-bottom:3px;text-transform:uppercase;letter-spacing:.04em}
    .reg-pop input, .reg-pop select{width:100%;padding:6px 9px;border:1px solid #CBD5E1;border-radius:6px;font-family:inherit;font-size:.78rem;background:#fff;color:#0F172A;margin-bottom:8px}
    .reg-pop input:focus, .reg-pop select:focus{outline:none;border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.12)}
    .reg-pop-foot{display:flex;gap:6px;margin-top:4px}
    .reg-pop-foot button{flex:1;padding:5px 8px;border-radius:5px;border:1px solid;cursor:pointer;font-family:inherit;font-size:.72rem;font-weight:700;transition:all .12s}
    .reg-pop-foot .clear{background:#fff;border-color:#FECACA;color:#B91C1C}
    .reg-pop-foot .clear:hover{background:#FEE2E2}
    .reg-pop-foot .ok{background:#7C3AED;border-color:#6D28D9;color:#fff}
    .reg-pop-foot .ok:hover{background:#6D28D9}

    .reg-mes-lbl{font-size:.67rem;font-weight:700;text-transform:uppercase;
                 letter-spacing:.07em;color:var(--txl)}
    .reg-month-input{border:1px solid var(--bdr);border-radius:7px;padding:5px 9px;
                     font-size:.8rem;font-family:inherit;background:#fff;color:var(--tx);
                     outline:none;cursor:pointer}
    .reg-month-input:focus{border-color:var(--blue);box-shadow:0 0 0 2px rgba(59,130,246,.12)}
    .reg-empty{text-align:center;padding:44px;color:var(--txl);font-size:.82rem}
    .reg-prev-col{color:var(--txm);font-family:'Menlo','Consolas',monospace;font-size:.8rem}
    .reg-var-pos{color:#DC2626;font-weight:700}
    .reg-var-neg{color:#059669;font-weight:700}
    .reg-var-nt {color:var(--txl)}
    .reg-foot{padding:9px 16px 12px;font-size:.63rem;color:var(--txl);border-top:1px solid var(--bdr)}

    /* ══════════════════════════════════════════════════════
       APP LAYOUT — sidebar + content (inspiração Airtable)
       ══════════════════════════════════════════════════════ */
    .app-layout{display:flex;min-height:calc(100vh - 56px);align-items:stretch}
    .sidebar{width:232px;background:#fff;border-right:1px solid var(--bdr);
             padding:14px 10px 20px;flex-shrink:0;
             position:sticky;top:56px;align-self:flex-start;
             height:calc(100vh - 56px);overflow-y:auto;
             display:flex;flex-direction:column}
    .sb-bottom{margin-top:auto}
    .sb-section{padding:10px 10px 6px;font-size:.6rem;font-weight:700;
                color:var(--txl);text-transform:uppercase;letter-spacing:.08em}
    .sb-item{display:flex;align-items:center;gap:10px;padding:7px 10px;
             border-radius:7px;cursor:pointer;margin-bottom:1px;
             color:var(--tx);font-size:.82rem;font-weight:500;
             transition:background .12s,color .12s;user-select:none;border:none;background:none;
             width:100%;text-align:left;font-family:inherit}
    .sb-item:hover{background:#F3F4F6}
    .sb-item.active{background:#EFF6FF;color:var(--blue-d);font-weight:600}
    .sb-icon{width:26px;height:26px;border-radius:6px;display:flex;
             align-items:center;justify-content:center;flex-shrink:0;
             color:#fff;font-size:.82rem;line-height:1}
    .sb-icon.c-gray  {background:#64748B}
    .sb-icon.c-purple{background:#8B5CF6}
    .sb-icon.c-green {background:#10B981}
    .sb-icon.c-amber {background:#F59E0B}
    .sb-icon.c-blue  {background:#3B82F6}
    .sb-icon.c-red   {background:#EF4444}
    .sb-icon.c-teal  {background:#14B8A6}
    .sb-icon.c-rose  {background:#E11D48}
    .sb-icon svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2.2}
    .sb-badge{margin-left:auto;font-size:.62rem;padding:1px 7px;
              border-radius:10px;background:#F59E0B;color:#fff;font-weight:700;letter-spacing:.04em}
    .sb-div{height:1px;background:var(--bdr);margin:10px 6px}

    /* ── MÓDULOS EM DESTAQUE (configurável, até 3) ── */
    /* ─── Sidebar groups (colapsáveis) ─── */
    .sb-group{margin:6px 0 0;display:flex;flex-direction:column;gap:2px}
    .sb-group-hd{display:flex;align-items:center;gap:8px;padding:7px 10px;background:transparent;border:none;cursor:pointer;
      border-radius:7px;font-family:inherit;font-size:.66rem;font-weight:800;color:#94A3B8;
      text-transform:uppercase;letter-spacing:.1em;width:100%;text-align:left;transition:all .12s}
    .sb-group-hd:hover{background:#F1F5F9;color:#475569}
    .sb-group-hd .ic{font-size:.85rem;line-height:1}
    .sb-group-hd .lbl{flex:1}
    .sb-group-hd .count{background:#E2E8F0;color:#64748B;border-radius:9px;padding:1px 6px;font-size:.6rem;font-weight:700;letter-spacing:0}
    .sb-group-hd .caret{font-size:.65rem;color:#CBD5E1;transition:transform .15s;line-height:1}
    .sb-group.is-open .sb-group-hd .caret{transform:rotate(180deg);color:#94A3B8}
    .sb-group.has-active .sb-group-hd{color:#0F172A}
    .sb-group.has-active .sb-group-hd .ic{filter:saturate(1.2)}
    .sb-group-items{display:flex;flex-direction:column;gap:2px;padding:2px 0 4px 6px;
      border-left:1.5px dashed #E2E8F0;margin-left:14px;overflow:hidden}
    .sb-group:not(.is-open) .sb-group-items{display:none}
