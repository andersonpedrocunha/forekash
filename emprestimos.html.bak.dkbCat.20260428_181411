  // Map palavra-chave -> exemplo de pergunta que o sistema responde
  const dicas = [
    { kw: ['cart', 'fatura', 'limite'], ex: '"quais cartões eu tenho?" / "fatura em aberto"' },
    { kw: ['banco', 'conta', 'reserva', 'saldo'], ex: '"quais contas eu tenho?" / "qual o saldo atual?"' },
    { kw: ['fornec'], ex: '"quais meus fornecedores?"' },
    { kw: ['colab', 'pessoa', 'time', 'equipe', 'headcount'], ex: '"quantas pessoas no time?" / "lista colaboradores"' },
    { kw: ['client', 'concentra'], ex: '"quem são meus clientes?" / "que cliente puxa mais?"' },
    { kw: ['centro', 'cc'], ex: '"quais centros de custo?"' },
    { kw: ['extrato', 'lanc', 'pagar', 'venc', 'atraso', 'atrasad'], ex: '"próximos vencimentos" / "tem coisa atrasada?"' },
    { kw: ['empresa', 'cnpj', 'razao', 'regime'], ex: '"dados da empresa" / "qual meu regime tributário?"' },
