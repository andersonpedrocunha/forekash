  // Limpa tudo exceto SETTINGS_KEY e KEY_MODULE
  ALL_LS_KEYS.forEach(k => {
    if(k === SETTINGS_KEY || k === KEY_MODULE) return;
    try{ localStorage.removeItem(k); }catch(e){}
  });
  try{ seedDemoData({force:true}); }catch(e){ console.error(e); }
  location.reload();
}

async function resetAllData(){
  const proceed = (typeof showConfirm === 'function')
    ? await showConfirm({
        title:'Apagar TODOS os dados?',
        message:'Todos os módulos (empréstimos, receita, pessoas, estrutura, disponibilidades, fluxo) e suas configurações serão <b>permanentemente apagados</b>. Esta ação não pode ser desfeita.',
        confirmText:'Apagar tudo',
        cancelText:'Cancelar',
        danger:true
      })
    : window.confirm('Apagar TODOS os dados? Esta ação não pode ser desfeita.');
  if(!proceed) return;
  const again = (typeof showConfirm === 'function')
    ? await showConfirm({
        title:'Confirmação final',
        message:'Tem <b>certeza absoluta</b>? Considere baixar um backup antes.',
        confirmText:'Sim, apagar',
        cancelText:'Cancelar',
        danger:true
      })
    : true;
  if(!again) return;
  ALL_LS_KEYS.forEach(k => {
    try{ localStorage.removeItem(k); }catch(e){}
  });
  try{ sessionStorage.clear(); }catch(e){}
  location.reload();
}

// ═══════════════════════════════════════════════════
//  FILL HANDLE  (arrastar valor entre células, estilo Excel)
//  Funciona em Receita, Pessoas, Estrutura, Disponibilidades e Fluxo.
//  Replica o valor da célula-origem para qualquer retângulo de células
//  do MESMO tipo de input dentro da MESMA tabela (horizontal, vertical
//  ou diagonal).
// ═══════════════════════════════════════════════════
(function initFillHandle(){
  const FILL_CLASSES = ['rec-input','pes-sal-input','est-val-input','dispo-val-input','flx-inp','imp-val-input','imp-base-input','orc-prev-input','outras-cell'];

  function fillClassOf(el){
    if(!el || !el.classList) return null;
    for(const c of FILL_CLASSES){ if(el.classList.contains(c)) return c; }
    return null;
  }

  // Constrói uma grade 2D [linha][coluna] de todas as células do mesmo
  // tipo dentro da tabela (ou container) da célula-origem. Ignora linhas
  // que não contenham esse tipo de input (ex.: totais, cabeçalhos).
  function buildGrid(source, cls){
    const container = source.closest('table') || source.closest('.sheet') || source.closest('[data-fill-container]') || document.body;
    const rows = [];
    const trs = container.querySelectorAll('tr');
    for(const tr of trs){
      const inputs = Array.from(tr.querySelectorAll('input.' + cls));
      if(inputs.length) rows.push(inputs);
    }
    // Localiza (r,c) da origem
    let sr = -1, sc = -1;
    for(let r=0; r<rows.length; r++){
      const c = rows[r].indexOf(source);
      if(c >= 0){ sr = r; sc = c; break; }
    }
    return { rows, sr, sc };
  }

  // Elemento único (singleton) da alça de arrastar, posicionado na viewport
  const handle = document.createElement('div');
  handle.className = 'xl-fill-handle';
  handle.setAttribute('title','Arraste para replicar este valor (horizontal, vertical ou diagonal)');
  document.body.appendChild(handle);

  let currentInput = null;

  function positionHandle(input){
    currentInput = input;
    // Orçamento Previsto: o <input> é menor que a célula (fica dentro de .c-prev
    // com padding). Ancora a alça no canto da célula (.c-prev), não do input.
    let anchor = input;
    if(input.classList && input.classList.contains('orc-prev-input')){
      anchor = input.closest('.c-prev') || input.closest('td') || input;
    }
    const r = anchor.getBoundingClientRect();
    // viewport-relative (handle é position:fixed)
    handle.style.left = (r.right - 4) + 'px';
    handle.style.top  = (r.bottom - 4) + 'px';
    handle.style.display = 'block';
  }
  function hideHandle(){
    handle.style.display = 'none';
    currentInput = null;
  }

  // Posiciona a alça sempre que um input preenchível ganha foco
  // (dblclick pra editar, Tab navigation, etc). A visibilidade é controlada
  // pela seleção — não escondemos só por perder foco.
  document.addEventListener('focusin', e => {
    if(fillClassOf(e.target)) positionHandle(e.target);
  });
  // Rolagem / resize: esconde (o retângulo do input pode ter mudado)
  window.addEventListener('scroll', hideHandle, true);
  window.addEventListener('resize', hideHandle);

  // ─── Drag state ───
  let drag = null;

  function clearPreview(){
    if(!drag) return;
    for(const el of drag.highlighted) el.classList.remove('xl-fill-preview');
    drag.highlighted.clear();
    drag.source.classList.remove('xl-fill-preview');
  }

  handle.addEventListener('mousedown', ev => {
    ev.preventDefault();     // impede blur do input atual
    ev.stopPropagation();
    if(!currentInput) return;
    const source = currentInput;
    const cls = fillClassOf(source);
    if(!cls) return;
    const grid = buildGrid(source, cls);
    if(grid.sr < 0) return;
    drag = { source, cls, grid, highlighted: new Set() };
    handle.classList.add('active');
    document.body.style.cursor = 'crosshair';
  });

  document.addEventListener('mousemove', ev => {
    if(!drag) return;
    const target = document.elementFromPoint(ev.clientX, ev.clientY);
    const input  = target && target.closest ? target.closest('input.' + drag.cls) : null;
    clearPreview();
    if(!input) return;
    // Localiza (tr, tc) do alvo na grade
    let tr = -1, tc = -1;
    for(let r=0; r<drag.grid.rows.length; r++){
      const c = drag.grid.rows[r].indexOf(input);
      if(c >= 0){ tr = r; tc = c; break; }
    }
    if(tr < 0) return;
    // Retângulo de (sr,sc) até (tr,tc)
    const r0 = Math.min(drag.grid.sr, tr), r1 = Math.max(drag.grid.sr, tr);
    const c0 = Math.min(drag.grid.sc, tc), c1 = Math.max(drag.grid.sc, tc);
    for(let r=r0; r<=r1; r++){
      const row = drag.grid.rows[r];
      if(!row) continue;
      for(let c=c0; c<=c1; c++){
        const cell = row[c];
        if(!cell || cell === drag.source) continue;
        cell.classList.add('xl-fill-preview');
        drag.highlighted.add(cell);
      }
    }
    if(drag.highlighted.size > 0) drag.source.classList.add('xl-fill-preview');
  });

  document.addEventListener('mouseup', () => {
    if(!drag) return;
    const val = drag.source.value;
    let skippedLocked = 0;
    for(const el of drag.highlighted){
      try{
        // Regra: respeita células travadas (readonly = tem ✓ marcado).
        if(el.readOnly){ skippedLocked++; el.classList.remove('xl-fill-preview'); continue; }
        el.value = val;
        // Dispara o onblur inline do próprio input — salva e formata
        // do jeito que o módulo espera (parseBR, fmtBR, etc).
        el.dispatchEvent(new Event('blur', {bubbles: false}));
      }catch(err){
        try{ console.warn('[TALLER] fill-drag: erro ao replicar valor:', err); }catch(_){}
      }
      el.classList.remove('xl-fill-preview');
    }
    if(skippedLocked > 0){
      try{ notifyLocked(); }catch(_){}
    }
    drag.source.classList.remove('xl-fill-preview');
    handle.classList.remove('active');
    document.body.style.cursor = '';
    drag = null;
    // Reposiciona a alça (o retângulo da célula pode ter mudado após format)
    if(currentInput) positionHandle(currentInput);
  });

  // Duplo-clique na alça: replica para todas as células da MESMA linha
  // à direita da origem (atalho clássico do Excel).
  handle.addEventListener('dblclick', ev => {
    ev.preventDefault();
    if(!currentInput) return;
    const source = currentInput;
    const cls = fillClassOf(source);
    if(!cls) return;
    const grid = buildGrid(source, cls);
    if(grid.sr < 0) return;
    const row = grid.rows[grid.sr];
    const val = source.value;
    let skippedLocked = 0;
    for(let c = grid.sc + 1; c < row.length; c++){
      const cell = row[c];
      if(!cell) continue;
      try{
        // Regra: respeita células travadas (readonly = tem ✓ marcado).
        if(cell.readOnly){ skippedLocked++; continue; }
        cell.value = val;
        cell.dispatchEvent(new Event('blur', {bubbles: false}));
      }catch(err){
        try{ console.warn('[TALLER] fill-dblclick: erro:', err); }catch(_){}
      }
    }
    if(skippedLocked > 0){ try{ notifyLocked(); }catch(_){} }
    if(currentInput) positionHandle(currentInput);
  });

  // ═══════════════════════════════════════════════════
  //  SELEÇÃO DE CÉLULAS (estilo Google Sheets)
  //  • 1 clique  = seleciona a célula (não entra em edição)
  //  • 2 cliques = entra em modo de edição
  //  • Shift+clique = estende a seleção da âncora até a clicada
  //  • Clique e arraste de A até B = seleciona o retângulo A..B
  //  • Mostra Soma · Média · Mín · Máx · Contagem (2+ células)
  //  Funciona em TODAS as planilhas editáveis do projeto.
  // ═══════════════════════════════════════════════════
  const selection = new Set();
  const summaryBar = document.createElement('div');
  summaryBar.className = 'xl-sel-summary';
  document.body.appendChild(summaryBar);

  let anchorCell = null;      // célula âncora (para Shift+clique e drag-select)
  let mouseDownCell = null;
  let isRangeSelecting = false;

  function clearSelection(){
    for(const c of selection) c.classList.remove('xl-sel-cell');
    selection.clear();
    summaryBar.style.display = 'none';
    anchorCell = null;
    hideHandle();
  }

  function parseCellNumber(el){
    // Lê do input (.value) OU do placeholder (quando célula pullable sem override)
    // OU do textContent (quando célula somente-leitura como TDs com spans).
    let v = '';
    if(el && typeof el.value === 'string' && el.value.trim()){
      v = el.value;
    } else if(el && el.placeholder && el.placeholder.trim()){
      v = el.placeholder;
    } else if(el){
      // Se for um TD ou SPAN, pega o texto. Se for um input vazio, textContent é ''.
      v = (el.textContent || '').toString();
    }
    v = v.trim();
    if(!v || v === '—' || v === '-') return null;
    // Remove prefixos de moeda (R$, US$, €) e espaços
    v = v.replace(/^[−-]?\s*(R\$|US\$|€|\$)\s*/i, (_, s) => s ? '' : '')
         .replace(/[^\d,.\-−]/g, '');  // deixa só dígitos, vírgula, ponto e sinal
    // Normaliza sinal de menos unicode e BR format
    v = v.replace(/−/g, '-');
    try{
      if(typeof parseBR === 'function'){
        const n = parseBR(v);
        if(typeof n === 'number' && !isNaN(n)) return n;
      }
    }catch(_){}
    const n = parseFloat(v.replace(/\./g,'').replace(',','.'));
    return isNaN(n) ? null : n;
  }

  function fmtAgg(v){
    try{ if(typeof fmtBRL === 'function') return fmtBRL(v); }catch(_){}
    return 'R$ ' + v.toFixed(2).replace('.',',').replace(/\B(?=(\d{3})+(?!\d))/g,'.');
  }

  function updateSummary(){
    if(selection.size < 2){ summaryBar.style.display = 'none'; return; }
    const nums = [];
    for(const el of selection){
      const n = parseCellNumber(el);
      if(n !== null && !isNaN(n)) nums.push(n);
    }
    if(nums.length === 0){
      summaryBar.innerHTML =
        '<span class="xl-sel-lbl">Contagem</span><b>' + selection.size + '</b>';
      summaryBar.style.display = 'block';
      return;
    }
    const sum = nums.reduce((a,b)=>a+b,0);
    const avg = sum/nums.length;
    const max = Math.max.apply(null, nums);
    const min = Math.min.apply(null, nums);
    const sep = '<span class="xl-sel-sep">·</span>';
    // Verifica se alguma célula tem botão de baixa associado (flx-check, pes-pagar, etc.)
    const checkBtns = _findSelectionCheckButtons(selection);
    let actionHtml = '';
    if(checkBtns.length > 0){
      const allOn = checkBtns.every(b => _batchIsCheckOn(b));
      if(allOn){
        actionHtml = '<button class="xl-sel-action undo" type="button" title="Desfazer baixa em '+checkBtns.length+' célula(s)">'+
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>'+
          'Reabrir '+checkBtns.length+'</button>';
      } else {
        actionHtml = '<button class="xl-sel-action" type="button" title="Dar baixa em '+checkBtns.length+' célula(s)">'+
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'+
          'Baixar '+checkBtns.length+'</button>';
      }
    }
    summaryBar.innerHTML =
      '<span class="xl-sel-lbl">Soma</span><b>'     + fmtAgg(sum) + '</b>' + sep +
      '<span class="xl-sel-lbl">Média</span><b>'    + fmtAgg(avg) + '</b>' + sep +
      '<span class="xl-sel-lbl">Mín</span><b>'      + fmtAgg(min) + '</b>' + sep +
      '<span class="xl-sel-lbl">Máx</span><b>'      + fmtAgg(max) + '</b>' + sep +
      '<span class="xl-sel-lbl">Contagem</span><b>' + nums.length + '</b>' + actionHtml;
    summaryBar.style.display = 'block';
    // Wire do botão de ação em lote (precisa após setar innerHTML)
    const actBtn = summaryBar.querySelector('.xl-sel-action');
    if(actBtn){
      actBtn.onclick = () => _batchToggleCheck(selection);
    }
  }
  // Extrai 'YYYY-MM' de qualquer botão de baixa, tentando várias estratégias
  // (dataset, input irmão, onclick attr, ou data-mes + ano ativo do módulo).
  function _getBtnYM(btn){
    if(!btn) return null;
    const td = btn.closest && btn.closest('td');
    // 1. Explicit data-ym no botão ou TD
    let k = btn.dataset && btn.dataset.ym;
    if(k && /^\d{4}-\d{2}$/.test(k)) return k;
    if(td && td.dataset){
      k = td.dataset.ym || td.dataset.pesKey;
      if(k && /^\d{4}-\d{2}$/.test(k)) return k;
    }
    // 2. Input irmão com data-ym ou data-pes-key
    if(td){
      const inp = td.querySelector('input[data-ym],input[data-pes-key]');
      if(inp){
        k = inp.dataset.ym || inp.dataset.pesKey;
        if(k && /^\d{4}-\d{2}$/.test(k)) return k;
      }
    }
    // 3. Parse onclick — todos os handlers usam 'YYYY-MM' como arg
    const oc = btn.getAttribute && btn.getAttribute('onclick');
    if(oc){
      const mm = oc.match(/['"](\d{4}-\d{2})['"]/);
      if(mm) return mm[1];
    }
    // 4. data-mes ('jan','fev',...) + ano ativo do módulo-container
    if(td && td.dataset && td.dataset.mes){
      const MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
      const idx = MESES.indexOf(String(td.dataset.mes).toLowerCase());
      if(idx >= 0){
        let year = null;
        try {
          if(btn.closest('#mod-receita, .rec-sheet-wrap') && typeof recActiveYear !== 'undefined') year = recActiveYear;
          else if(btn.closest('.pes-sheet') && typeof pessoas !== 'undefined' && pessoas && pessoas.activeYear) year = pessoas.activeYear;
          else if(btn.closest('.est-sheet') && typeof estActiveYear !== 'undefined') year = estActiveYear;
          else if(btn.closest('.flx-sheet') && typeof flxActiveYear !== 'undefined') year = flxActiveYear;
          else if(btn.closest('.imp-cor-sheet, #mod-impostos') && typeof impCorActiveYear !== 'undefined') year = impCorActiveYear;
          else if(btn.closest('.dispo-sheet') && typeof dispoActiveYear !== 'undefined') year = dispoActiveYear;
        } catch(e){}
        if(year) return String(year) + '-' + String(idx+1).padStart(2,'0');
      }
    }
    return null;
  }
  // Retorna true se o YM é posterior ao mês corrente
  function _isYMFuture(ym){
    if(!ym || !/^\d{4}-\d{2}$/.test(ym)) return false;
    const now = new Date();
    const curIdx = now.getFullYear()*12 + now.getMonth();
    const [y, m] = ym.split('-').map(Number);
    const tgtIdx = y*12 + (m-1);
    return tgtIdx > curIdx;
  }
  // Segurança: clique único pra REABRIR uma baixa pede confirmação. Shift+click
  // (ou Alt+click) pula a confirmação pra quem sabe o que tá fazendo. Clique pra
  // BAIXAR é livre EXCETO quando a célula está num mês futuro (regime de caixa).
  document.addEventListener('click', function(e){
    if(!e.target || !e.target.closest) return;
    const btn = e.target.closest('.flx-check, .pes-pagar-btn, .est-pagar-btn, .imp-cor-pagar-btn, .rec-cell-toggle, .orc-cell-toggle, .dispo-cell-toggle');
    if(!btn) return;
    // Bypass: se veio de um re-click programático após confirmação, deixa seguir
    if(btn.dataset._bypassConfirm === '1'){
      delete btn.dataset._bypassConfirm;
      return;
    }
    // Regime de caixa: bloqueia BAIXAR em meses futuros (não afeta reabertura)
    const isOn = _batchIsCheckOn(btn);
    if(!isOn){
      const ym = _getBtnYM(btn);
      if(ym && _isYMFuture(ym)){
        e.preventDefault();
        e.stopPropagation();
        if(typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
        try {
          if(typeof toast === 'function')
            toast('⚠️ Não dá pra baixar em mês futuro — regime de caixa', 3500);
        } catch(_){}
        return;
      }
    }
    // Só intercepta se tá ON (reabertura). Baixar é livre (abaixo do bloqueio futuro).
    if(!isOn) return;
    // Shift ou Alt pulam o diálogo
    if(e.shiftKey || e.altKey) return;
    // Bloqueia propagação pra que o handler original não rode
    e.preventDefault();
    e.stopPropagation();
    if(typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
    (async () => {
      let ok = false;
      try {
        if(typeof showConfirm === 'function'){
          ok = await showConfirm({
            title: 'Reabrir esta baixa?',
            message: 'A célula vai voltar a aceitar atualizações automáticas e pode ser sobrescrita quando você clicar em "Voltar com a projeção".\n\n💡 Segure Shift (ou Alt) ao clicar pra pular esta confirmação.',
            confirmLabel: 'Sim, reabrir',
            cancelLabel: 'Cancelar',
            destructive: true
          });
        }
      } catch(_){}
      if(!ok) return;
      // Re-clica com flag bypass pro handler original rodar agora
      btn.dataset._bypassConfirm = '1';
      try { btn.click(); } catch(_){}
    })();
  }, true);  // capture = true: roda antes do onclick inline

  // Seletores de botões de "baixa" usados em todas as planilhas do projeto.
  // Cada módulo tem sua própria classe, mas a lógica é a mesma: clicar alterna.
  const _BATCH_CHECK_SELECTORS = [
    '.flx-check',            // DRC/DRE (Demonstrativo)
    '.pes-pagar-btn',        // Folha (Pessoas)
    '.est-pagar-btn',        // Despesas Recorrentes (Estrutura)
    '.imp-cor-pagar-btn',    // Impostos Correntes
    '.rec-cell-toggle',      // Receita
    '.orc-cell-toggle',      // Orçamento (se existir)
    '.dispo-cell-toggle'     // Disponibilidades (se existir)
  ];
  const _BATCH_CHECK_SELECTOR = _BATCH_CHECK_SELECTORS.join(',');
  // Classes aplicadas ao TD/botão que indicam estado "baixado" (pago/confirmado).
  const _BATCH_ON_CLASSES_BTN = ['on'];
  const _BATCH_ON_CLASSES_TD  = ['pago', 'pago-igual', 'pago-mais', 'pago-menos', 'pago-zero', 'recebido', 'flx-confirmed'];
  // Retorna true se este botão/célula está "baixado" atualmente.
  function _batchIsCheckOn(btn){
    if(!btn) return false;
    for(const c of _BATCH_ON_CLASSES_BTN) if(btn.classList.contains(c)) return true;
    const td = btn.closest('td');
    if(td){
      for(const c of _BATCH_ON_CLASSES_TD) if(td.classList.contains(c)) return true;
    }
    return false;
  }
  // Procura TODOS os botões de baixa associados às células selecionadas.
  // Estratégia por célula: sobe até o <td> pai e procura qualquer botão das
  // classes conhecidas. Células sem botão são ignoradas (sem erro).
  function _findSelectionCheckButtons(sel){
    const out = [];
    const seen = new Set();
    for(const cell of sel){
      const td = cell.closest('td');
      if(!td) continue;
      // Algumas planilhas têm o botão DENTRO do TD; outras podem ter em ancestral próximo
      const btns = td.querySelectorAll(_BATCH_CHECK_SELECTOR);
      btns.forEach(b => {
        if(!seen.has(b)){ seen.add(b); out.push(b); }
      });
    }
    return out;
  }
  // Executa toggle de "baixa" em lote nas células selecionadas que tenham check.
  async function _batchToggleCheck(sel){
    let btns = _findSelectionCheckButtons(sel);
    if(btns.length === 0){
      try { if(typeof toast === 'function') toast('Nenhuma célula da seleção tem baixa disponível'); } catch(e){}
      return;
    }
    const allOn = btns.every(b => _batchIsCheckOn(b));
    const mode = allOn ? 'reabrir' : 'baixar';
    // Regime de caixa: ao BAIXAR em lote, ignora células de meses futuros
    if(mode === 'baixar'){
      const filtered = btns.filter(b => {
        const ym = _getBtnYM(b);
        return !(ym && _isYMFuture(ym));
      });
      const skipped = btns.length - filtered.length;
      btns = filtered;
      if(skipped > 0){
        try { if(typeof toast === 'function') toast('⚠️ ' + skipped + ' célula(s) de mês futuro ignorada(s) — regime de caixa', 3500); } catch(e){}
      }
      if(btns.length === 0){
        try { if(typeof toast === 'function') toast('Nenhuma célula da seleção pode ser baixada (todas estão no futuro)'); } catch(e){}
        return;
      }
    }
    // Confirmação
    let ok = true;
    try {
      if(typeof showConfirm === 'function'){
        ok = await showConfirm({
          title: (mode === 'baixar' ? 'Dar baixa em ' : 'Reabrir ') + btns.length + ' célula(s)?',
          message: (mode === 'baixar'
            ? 'Vai marcar ' + btns.length + ' célula(s) selecionada(s) como baixada(s) (✓). Os valores ficam bloqueados contra alterações automáticas e preservados pelo botão "Voltar com a projeção".'
            : 'Vai remover a baixa (✓) de ' + btns.length + ' célula(s) selecionada(s). Os valores voltam a aceitar atualizações automáticas e podem ser sobrescritos ao voltar à projeção.'),
          confirmLabel: (mode === 'baixar' ? 'Sim, baixar todas' : 'Sim, reabrir todas'),
          cancelLabel: 'Cancelar',
          destructive: (mode === 'reabrir')
        });
      }
    } catch(e){}
    if(!ok) return;
    // Aciona cada botão. histCommit é acionado pelos save*() internos.
    try { if(typeof _hist !== 'undefined') _hist.suspended = true; } catch(e){}
    let changed = 0;
    for(const btn of btns){
      const isOn = _batchIsCheckOn(btn);
      if((mode === 'baixar' && !isOn) || (mode === 'reabrir' && isOn)){
        // Bypassa a confirmação individual — a ação em lote já foi confirmada em bloco
        try { btn.dataset._bypassConfirm = '1'; } catch(_){}
        try { btn.click(); changed++; } catch(e){}
      }
    }
    try { if(typeof _hist !== 'undefined') _hist.suspended = false; } catch(e){}
    try { if(typeof histCommit === 'function') histCommit('baixa em lote (' + changed + ')'); } catch(e){}
    try {
      if(typeof toast === 'function'){
        toast(mode === 'baixar'
          ? '✓ ' + changed + ' célula(s) baixada(s)'
          : '↺ ' + changed + ' célula(s) reabertas');
      }
    } catch(e){}
  }

  function selectSingle(input){
    for(const c of selection) c.classList.remove('xl-sel-cell');
    selection.clear();
    input.classList.add('xl-sel-cell');
    selection.add(input);
    anchorCell = input;
    positionHandle(input);
    summaryBar.style.display = 'none';  // 1 célula, sem barra
  }

  // Alterna uma única célula na seleção — usado por Cmd/Ctrl+clique
  // para permitir escolher células NÃO contíguas (estilo Excel/Sheets).
  function toggleCellInSelection(input){
    if(!input) return;
    if(selection.has(input)){
      input.classList.remove('xl-sel-cell');
      selection.delete(input);
      // Se a âncora saiu da seleção, adota qualquer célula remanescente como âncora
      if(anchorCell === input){
        anchorCell = selection.size ? selection.values().next().value : null;
      }
    } else {
      // Célula de tipo diferente? começa nova seleção
      if(selection.size > 0){
        const anyCell = selection.values().next().value;
        if(fillClassOf(anyCell) !== fillClassOf(input)){
          for(const c of selection) c.classList.remove('xl-sel-cell');
          selection.clear();
        }
      }
      input.classList.add('xl-sel-cell');
      selection.add(input);
      anchorCell = input;
    }
    if(selection.size === 1){
      const only = selection.values().next().value;
      positionHandle(only);
      summaryBar.style.display = 'none';
    } else if(selection.size === 0){
      hideHandle();
      summaryBar.style.display = 'none';
    } else {
      // Em seleção múltipla, o fill-handle não faz sentido — esconde
      hideHandle();
      updateSummary();
    }
  }

  function setRangeSelection(fromEl, toEl){
    for(const c of selection) c.classList.remove('xl-sel-cell');
    selection.clear();
    const cls = fillClassOf(fromEl);
    if(!cls || fillClassOf(toEl) !== cls){ summaryBar.style.display='none'; return; }
    const grid = buildGrid(fromEl, cls);
    if(grid.sr < 0){ summaryBar.style.display='none'; return; }
    let tr = -1, tc = -1;
    for(let r=0; r<grid.rows.length; r++){
      const c = grid.rows[r].indexOf(toEl);
      if(c >= 0){ tr = r; tc = c; break; }
    }
    if(tr < 0){ summaryBar.style.display='none'; return; }
    const r0 = Math.min(grid.sr, tr), r1 = Math.max(grid.sr, tr);
    const c0 = Math.min(grid.sc, tc), c1 = Math.max(grid.sc, tc);
    for(let r=r0; r<=r1; r++){
      const row = grid.rows[r];
      if(!row) continue;
      for(let c=c0; c<=c1; c++){
        const cell = row[c];
        if(!cell) continue;
        cell.classList.add('xl-sel-cell');
        selection.add(cell);
      }
    }
    positionHandle(toEl);
    updateSummary();
  }

  // Cmd/Ctrl+arrasto — adiciona um RETÂNGULO à seleção existente (snapshot),
  // em vez de substituí-la. Usado durante cmd+drag.
  function addRangeToSelection(snapshot, fromEl, toEl){
    // Restaura o snapshot
    for(const c of selection) c.classList.remove('xl-sel-cell');
    selection.clear();
    for(const c of snapshot){
      c.classList.add('xl-sel-cell');
      selection.add(c);
    }
    // Adiciona o retângulo (se tipos forem compatíveis)
    const cls = fillClassOf(fromEl);
    if(!cls || fillClassOf(toEl) !== cls){ updateSummary(); return; }
    const grid = buildGrid(fromEl, cls);
    if(grid.sr < 0){ updateSummary(); return; }
    let tr = -1, tc = -1;
    for(let r=0; r<grid.rows.length; r++){
      const c = grid.rows[r].indexOf(toEl);
      if(c >= 0){ tr = r; tc = c; break; }
    }
    if(tr < 0){ updateSummary(); return; }
    const r0 = Math.min(grid.sr, tr), r1 = Math.max(grid.sr, tr);
    const c0 = Math.min(grid.sc, tc), c1 = Math.max(grid.sc, tc);
    for(let r=r0; r<=r1; r++){
      const row = grid.rows[r];
      if(!row) continue;
      for(let c=c0; c<=c1; c++){
        const cell = row[c];
        if(!cell) continue;
        cell.classList.add('xl-sel-cell');
        selection.add(cell);
      }
    }
    anchorCell = toEl;
    // Em seleção múltipla espalhada, a alça de fill não faz sentido
    hideHandle();
    updateSummary();
  }

  // Snapshot da seleção no momento do Cmd/Ctrl+mousedown — só é usado
  // se o usuário realmente arrastar (move). Restaurado ao fim do drag.
  let cmdDragSnapshot = null;

  // ── Mousedown (capture phase) — intercepta ANTES do focus nativo ──
  document.addEventListener('mousedown', e => {
    if(e.button !== 0) return;
    // Ignora cliques na alça ou na barra flutuante
    if(e.target.closest && (e.target.closest('.xl-fill-handle') || e.target.closest('.xl-sel-summary'))) return;

    // Modo fórmula ativo em outra célula [data-cellref]? Recua — o handler de inserção
    // de referência (definido bem antes) trata o clique e preserva o foco. Sem esse
    // early-bail, o blur abaixo mata o modo fórmula e o token não chega a ser inserido.
    if(typeof __formulaActiveInput !== 'undefined' && __formulaActiveInput
       && document.body.contains(__formulaActiveInput)
       && typeof __isFormulaMode === 'function' && __isFormulaMode(__formulaActiveInput)){
      const targetCell = e.target.closest && e.target.closest('[data-cellref]');
      if(targetCell && targetCell !== __formulaActiveInput) return;
    }

    const input = e.target.closest && e.target.closest('input');
    const isFillable = input && fillClassOf(input);

    if(!isFillable){
      // Clique fora de qualquer célula preenchível → limpa seleção + blur
      if(document.activeElement && document.activeElement.blur && fillClassOf(document.activeElement)){
        try{ document.activeElement.blur(); }catch(_){}
      }
      clearSelection();
      mouseDownCell = null;
      return;
    }

    // Cmd/Ctrl+clique OU Cmd/Ctrl+arrasto: seleção de células NÃO contíguas
    // (estilo Excel/Google Sheets).
    //   - clique simples → alterna a célula
    //   - segura e arrasta → adiciona um RETÂNGULO à seleção existente
    // metaKey = ⌘ no Mac / tecla Windows; ctrlKey = Ctrl no Windows/Linux.
    if((e.metaKey || e.ctrlKey) && !e.shiftKey){
      e.preventDefault();
      e.stopPropagation();
      if(document.activeElement && document.activeElement.blur && fillClassOf(document.activeElement)){
        try{ document.activeElement.blur(); }catch(_){}
      }
      // Guarda snapshot SOMENTE se a seleção atual é do mesmo tipo —
      // caso contrário o arrasto começa do zero.
      let compatible = true;
      if(selection.size > 0){
        const anyCell = selection.values().next().value;
        if(fillClassOf(anyCell) !== fillClassOf(input)) compatible = false;
      }
      cmdDragSnapshot = compatible ? new Set(selection) : null;
      // Efeito imediato (clique sem arrasto): alterna a célula
      toggleCellInSelection(input);
      // Habilita possível drag a partir desta célula
      mouseDownCell = input;
      isRangeSelecting = false;
      return;
    }

    // Se já está editando ESTE input, comportamento nativo (mover cursor de texto)
    if(document.activeElement === input){
      mouseDownCell = null;
      return;
    }

    // Se estava editando OUTRO input preenchível, commita o edit agora
    if(document.activeElement && document.activeElement.blur && fillClassOf(document.activeElement)){
      try{ document.activeElement.blur(); }catch(_){}
    }

    // Shift+clique: estende seleção da âncora até a célula clicada
    if(e.shiftKey && anchorCell && anchorCell !== input
       && fillClassOf(anchorCell) === fillClassOf(input)){
      e.preventDefault();
      e.stopPropagation();
      setRangeSelection(anchorCell, input);
      mouseDownCell = null;
      return;
    }

    // Clique simples: SELECIONA (não foca) — bloqueia o focus nativo
    e.preventDefault();
    e.stopPropagation();
    selectSingle(input);
    // Prepara possível drag-to-select
    mouseDownCell = input;
    isRangeSelecting = false;
  }, true);

  // ── Duplo-clique → entra em modo de edição ──
  document.addEventListener('dblclick', e => {
    const input = e.target.closest && e.target.closest('input');
    if(!input || !fillClassOf(input)) return;
    e.preventDefault();
    e.stopPropagation();
    // Limpa seleção visual na célula para dar lugar ao caret de edição
    for(const c of selection) c.classList.remove('xl-sel-cell');
    selection.clear();
    summaryBar.style.display = 'none';
    try{
      input.focus();
      // onfocus inline do próprio módulo trata seleção de texto (quando existe)
    }catch(_){}
  }, true);

  // ── Mousemove — se o usuário arrasta de A até B, forma retângulo ──
  document.addEventListener('mousemove', e => {
    if(drag) return;            // fill-drag tem prioridade
    if(!mouseDownCell) return;
    if(e.buttons === 0){
      mouseDownCell = null;
      cmdDragSnapshot = null;
      isRangeSelecting = false;
      return;
    }
    const under = document.elementFromPoint(e.clientX, e.clientY);
    const input = under && under.closest ? under.closest('input') : null;
    if(input && fillClassOf(input) === fillClassOf(mouseDownCell) && input !== mouseDownCell){
      isRangeSelecting = true;
      if(cmdDragSnapshot !== null){
        // Cmd/Ctrl+arrasto → adiciona o retângulo à seleção existente
        addRangeToSelection(cmdDragSnapshot, mouseDownCell, input);
      } else {
        setRangeSelection(mouseDownCell, input);
      }
      e.preventDefault();
    }
  });

  document.addEventListener('mouseup', () => {
    mouseDownCell = null;
    cmdDragSnapshot = null;
    // isRangeSelecting permanece; a seleção fica visível até o próximo clique
  });

  // ── Teclado: Escape limpa seleção / sai de edição ──
  document.addEventListener('keydown', e => {
    if(e.key === 'Escape'){
      if(document.activeElement && document.activeElement.blur && fillClassOf(document.activeElement)){
        try{ document.activeElement.blur(); }catch(_){}
      }
      clearSelection();
    }
  });

  // Enter numa célula selecionada (mas não em edição) entra em edição
  document.addEventListener('keydown', e => {
    if(e.key !== 'Enter') return;
    if(document.activeElement && fillClassOf(document.activeElement)) return;  // já editando
    if(selection.size !== 1 || !anchorCell) return;
    e.preventDefault();
    try{ anchorCell.focus(); }catch(_){}
  });
})();

