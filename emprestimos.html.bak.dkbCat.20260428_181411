function mrcashCustos(snap, ind){
  const fixo = snap.estrutura.totalAno;
  const folha = snap.pessoas.folhaAno;
  const imp = snap.impostos.totalCorrente;
  const empAno = snap.emprestimos.totalAno || ((snap.emprestimos.parcelaMensal || 0) * 12);
  const rec = snap.receita.anual;
  const totalCustos = folha + fixo + imp + empAno;
  const pct = v => rec > 0 ? ((v/rec)*100).toFixed(1) : '0.0';
  let msg = `Custos anuais projetados:<ul>`;
  msg += `<li><b>Folha</b>: ${fmtBRL(folha)} (${pct(folha)}% da receita)</li>`;
  msg += `<li><b>Estrutura de Custos</b>: ${fmtBRL(fixo)} (${pct(fixo)}%)</li>`;
  msg += `<li><b>Impostos correntes</b>: ${fmtBRL(imp)} (${pct(imp)}%)</li>`;
  if(empAno > 0) msg += `<li><b>Empréstimos</b>: ${fmtBRL(empAno)} (${pct(empAno)}%)</li>`;
  msg += `</ul>Total de custos: <b>${fmtBRL(totalCustos)}</b> (${pct(totalCustos)}% da receita).`;
  const mg = rec - totalCustos;
  const mgPct = rec > 0 ? (mg/rec)*100 : 0;
  msg += ` Margem residual estimada: <b>${fmtBRL(mg)}</b> (${mgPct.toFixed(1)}%).`;
  return msg;
}

