  // Mostra SÓ quando há edição ativa (digitação/drag) em modo fórmula.
  // Focar uma célula sem digitar não dispara o preview.
  if(!inp || !document.body.contains(inp) || !__isFormulaMode(inp) || !__formulaEditingActive){
    __hideFormulaPreview();
    return;
  }
  const tip = __ensureFormulaPreviewEl();
  const val = (inp.value || '').trim();
  // Linha 1: fórmula expandida (refs → valores) para leitura rápida
  const display = __expandFormulaForDisplay(val);
  const r = evalSimpleFormula(val);

  // Importante: NUNCA acusar "inválida" enquanto o usuário digita.
  // Se der pra calcular, mostra o resultado abaixo. Se não der, mostra só a fórmula.
  let html = '<div class="pv-row-formula"><span class="pv-eq">\u0192x</span>'
           + '<span class="pv-expr">' + esc(display) + '</span></div>';
  if(r.ok){
    html += '<div class="pv-row-result"><span class="pv-eq">=</span>'
          + '<b>' + fmtBR(r.value, 2) + '</b></div>';
  }
  tip.innerHTML = html;
  tip.classList.remove('err');

  tip.style.display = 'block';
  // Posição: abaixo do input, horizontalmente alinhado; flip pra cima se estourar
  const rect = inp.getBoundingClientRect();
  const tipW = tip.offsetWidth, tipH = tip.offsetHeight;
  const vw = window.innerWidth, vh = window.innerHeight;
  let left = Math.max(4, Math.min(rect.left, vw - tipW - 4));
  let top  = rect.bottom + 6;
  if(top + tipH + 4 > vh) top = Math.max(4, rect.top - tipH - 6);
  tip.style.left = left + 'px';
  tip.style.top  = top  + 'px';
