function cartImportOFXFile(inp, cartaoId){
  const f = inp.files && inp.files[0];
  if(!f) return;
  const reader = new FileReader();
  reader.onload = (e) => {
    const text = e.target.result || '';
    cartImportOFXProcess(cartaoId, text, f.name);
  };
  reader.readAsText(f, 'UTF-8');
}
function cartImportOFXProcess(cartaoId, raw, filename){
  if(!raw){ if(typeof toast === 'function') toast('Arquivo vazio'); return; }
  const blockRe = /<STMTTRN>([\s\S]*?)<\/STMTTRN>/gi;
  const txns = [];
  let m;
  while((m = blockRe.exec(raw)) !== null) txns.push(m[1]);
  if(txns.length === 0){ if(typeof toast === 'function') toast('Nenhuma transação encontrada'); return; }
  const getTag = (block, tag) => {
    const re = new RegExp('<' + tag + '>([^<\\r\\n]*)', 'i');
    const mm = re.exec(block);
    return mm ? mm[1].trim() : '';
  };
  const c = cartoes.list.find(x => x.id === cartaoId);
  if(!c) return;
  let added = 0;
  // Parcela: detecta "PARC" + "N/M" ou "N de M" no memo
  const detectParcela = (memo) => {
    const m1 = /(\d{1,2})\s*\/\s*(\d{1,2})/.exec(memo);
    if(m1){
      const a = parseInt(m1[1],10), t = parseInt(m1[2],10);
      if(t > 1 && a >= 1 && a <= t) return { atual: a, total: t };
    }
    return null;
  };
  for(const block of txns){
    const dt = getTag(block, 'DTPOSTED');
    const amt = getTag(block, 'TRNAMT');
    const memo = getTag(block, 'MEMO') || getTag(block, 'NAME') || '';
    if(!dt || !amt) continue;
    const dm = /^(\d{4})(\d{2})(\d{2})/.exec(dt);
    if(!dm) continue;
    const data = dm[1] + '-' + dm[2] + '-' + dm[3];
    const valNum = parseFloat(amt);
    if(!isFinite(valNum) || valNum === 0) continue;
    // Em cartão de crédito: débitos costumam ser positivos no OFX (é o valor da compra)
    const valor = Math.abs(valNum);
    const ciclo = _cartFaturaCicloFor(c, data);
    const fat = cartGetOrCreateFatura(cartaoId, ciclo.refY, ciclo.refM);
    if(!fat) continue;
    const parcela = detectParcela(memo);
    cartoes.lancamentos.push({
      id: cartoes.nextLancId++,
      cartaoId, faturaId: fat.id,
      data, descricao: memo || 'Lançamento', valor,
      categoria: '', parcela: parcela
    });
    added++;
  }
  cartSave();
  const result = document.getElementById('cart-imp-result');
  if(result){
    result.innerHTML = '<div style="background:#DCFCE7;border:1px solid #BBF7D0;color:#166534;padding:10px 14px;border-radius:8px;font-size:.84rem;font-weight:600;margin-top:14px">✓ ' + added + ' lançamento(s) importado(s) de "' + cartEsc(filename) + '"</div>';
  }
  renderCartoes();
}

