    .fk-card:hover{transform:translateY(-3px);box-shadow:0 12px 30px -12px rgba(15,23,42,.15);border-color:#D1D5DB}
    .fk-card .fk-card-ico{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;
                          background:linear-gradient(135deg,#ECFDF5,#E0E7FF);color:#047857;margin-bottom:16px}
    .fk-card .fk-card-ico svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
    .fk-card h3{font-size:1.08rem;font-weight:800;color:#0F172A;letter-spacing:-.01em;margin:0 0 8px}
    .fk-card p{font-size:.92rem;color:#4B5563;line-height:1.55;margin:0}

    .fk-section.dark{background:#0F172A;color:#F8FAFC;border-top:none}
    .fk-section.dark .fk-section-head h2{color:#F8FAFC}
    .fk-section.dark .fk-section-head p{color:#94A3B8}
    .fk-section.dark .fk-card{background:rgba(255,255,255,.03);border-color:rgba(255,255,255,.08)}
    .fk-section.dark .fk-card:hover{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.15)}
    .fk-section.dark .fk-card h3{color:#F8FAFC}
    .fk-section.dark .fk-card p{color:#94A3B8}
    .fk-section.dark .fk-card .fk-card-ico{background:rgba(16,185,129,.15);color:#10B981}

    /* ── Seção "A Taller" (founder story) ── */
    .fk-taller-sec{background:#0B1120;color:#F8FAFC;border-top:none;position:relative;overflow:hidden}
    .fk-taller-sec::before{content:'';position:absolute;top:-180px;right:-120px;width:520px;height:520px;
                           background:radial-gradient(circle,rgba(16,185,129,.14),transparent 65%);
                           pointer-events:none;animation:fkAurora 18s ease-in-out infinite}
    .fk-taller-sec::after{content:'';position:absolute;bottom:-220px;left:-140px;width:560px;height:560px;
                          background:radial-gradient(circle,rgba(99,102,241,.1),transparent 70%);
                          pointer-events:none;animation:fkAurora 22s ease-in-out infinite reverse}
    .fk-taller-sec .fk-section-inner{position:relative;z-index:1}
    .fk-taller-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:56px;align-items:center}
    .fk-taller-copy .fk-kicker{display:inline-block;font-size:.78rem;font-weight:800;color:#10B981;
                               letter-spacing:.12em;text-transform:uppercase;margin-bottom:18px}
    .fk-taller-copy h2{font-size:2.3rem;font-weight:900;letter-spacing:-.025em;color:#F8FAFC;
                       line-height:1.08;margin:0 0 22px}
    .fk-taller-copy h2 em{font-style:normal;background:linear-gradient(135deg,#10B981 0%,#6366F1 100%);
                          -webkit-background-clip:text;background-clip:text;color:transparent}
    .fk-taller-lead{font-size:1.02rem;color:#CBD5E1;line-height:1.65;margin:0 0 16px}
    .fk-taller-lead b{color:#F8FAFC;font-weight:700}
    .fk-taller-link{display:inline-flex;align-items:center;gap:8px;margin-top:14px;padding:12px 22px;
                    background:#10B981;color:#0B1120;border-radius:10px;text-decoration:none;
                    font-size:.92rem;font-weight:800;letter-spacing:.01em;transition:all .15s;
                    box-shadow:0 10px 25px -12px rgba(16,185,129,.55)}
    .fk-taller-link:hover{background:#34D399;transform:translateY(-2px);
                          box-shadow:0 14px 30px -10px rgba(16,185,129,.65)}
    .fk-taller-link svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.6;
                        stroke-linecap:round;stroke-linejoin:round}

    .fk-taller-quote{position:relative;padding:34px 32px 30px;
                     background:linear-gradient(160deg,rgba(255,255,255,.04) 0%,rgba(255,255,255,.015) 100%);
                     border:1px solid rgba(255,255,255,.08);border-radius:18px;
                     backdrop-filter:blur(10px)}
    .fk-taller-quote-mark{position:absolute;top:-10px;left:24px;font-size:5rem;font-weight:900;
                          line-height:1;color:#10B981;opacity:.35;font-family:Georgia,serif;pointer-events:none}
    .fk-taller-quote blockquote{margin:0;font-size:1.08rem;color:#E2E8F0;line-height:1.55;
                                 font-style:italic;font-weight:500;letter-spacing:-.005em;padding-top:10px}
    .fk-taller-signature{display:flex;align-items:center;gap:14px;margin-top:22px;padding-top:18px;
                         border-top:1px solid rgba(255,255,255,.08)}
    .fk-taller-signature-logo{height:26px;width:auto;fill:#F8FAFC;opacity:.92;flex-shrink:0}
    .fk-taller-signature-sub{font-size:.76rem;color:#94A3B8;line-height:1.4}

    .fk-taller-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:56px;
                     padding-top:36px;border-top:1px solid rgba(255,255,255,.08)}
    .fk-taller-stat{padding:18px 20px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);
                    border-radius:12px}
    .fk-taller-stat-val{font-size:1.15rem;font-weight:900;color:#10B981;letter-spacing:-.01em;margin-bottom:4px}
    .fk-taller-stat-lbl{font-size:.82rem;color:#94A3B8;line-height:1.45}

    @media (max-width:900px){
      .fk-taller-grid{grid-template-columns:1fr;gap:32px}
      .fk-taller-copy h2{font-size:1.7rem}
      .fk-taller-stats{grid-template-columns:1fr;gap:10px;margin-top:40px;padding-top:28px}
    }

    /* Origem — layout centralizado (sem aside de depoimento) */
    .fk-origem-wrap{max-width:820px;margin:0 auto;text-align:center}
    .fk-origem-wrap .fk-kicker{display:inline-block;font-size:.78rem;font-weight:800;color:#10B981;
                               letter-spacing:.14em;text-transform:uppercase;margin-bottom:14px}
    .fk-origem-wrap h2{font-size:2.3rem;font-weight:900;letter-spacing:-.025em;color:#F8FAFC;
                       line-height:1.1;margin:0 0 22px}
    .fk-origem-wrap h2 em{font-style:normal;background:linear-gradient(135deg,#10B981 0%,#6366F1 100%);
                          -webkit-background-clip:text;background-clip:text;color:transparent}
    .fk-origem-wrap .fk-taller-lead{font-size:1.04rem;color:#CBD5E1;line-height:1.7;margin:0 auto 16px;max-width:720px}
    .fk-origem-wrap .fk-taller-lead b{color:#F8FAFC;font-weight:700}
    .fk-origem-wrap .fk-taller-link{margin-top:22px}
    @media (max-width:900px){
      .fk-origem-wrap h2{font-size:1.7rem}
    }

    /* ══════════════════════════════════════════════════════
       Por dentro (showcase fiel às telas reais do produto)
       ══════════════════════════════════════════════════════ */
    .fk-show-sec{background:#F9FAFB;position:relative;overflow:hidden}
    .fk-show-sec::before{content:'';position:absolute;top:-120px;right:-80px;width:360px;height:360px;
                         background:radial-gradient(circle at 30% 30%, rgba(16,185,129,.08) 0%, transparent 60%);
                         pointer-events:none}
    .fk-show-sec::after{content:'';position:absolute;bottom:-160px;left:-100px;width:400px;height:400px;
                        background:radial-gradient(circle at 70% 70%, rgba(99,102,241,.07) 0%, transparent 60%);
                        pointer-events:none}
    .fk-show-sec .fk-section-inner{position:relative;z-index:1}

    /* Tabs de módulo (imita a sidebar) */
    .fk-show-tabs{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin-bottom:26px}
    .fk-show-tab{display:inline-flex;align-items:center;gap:7px;padding:7px 14px;background:#fff;
                 border:1px solid #E5E7EB;border-radius:999px;font-size:.78rem;font-weight:600;color:#6B7280;
                 cursor:default;user-select:none}
    .fk-show-tab svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .fk-show-tab.act{background:#0F172A;color:#fff;border-color:#0F172A}

    /* "Janela" de navegador */
    .fk-show-window{max-width:1100px;margin:0 auto;background:#fff;border:1px solid #E5E7EB;border-radius:14px;
                    box-shadow:0 30px 80px -30px rgba(15,23,42,.28),0 10px 30px -15px rgba(15,23,42,.12);
                    overflow:hidden}
    .fk-show-chrome{display:flex;align-items:center;gap:7px;padding:10px 14px;border-bottom:1px solid #F3F4F6;
                    background:linear-gradient(180deg,#FAFBFC 0%,#F3F4F6 100%)}
    .fk-show-dot{width:11px;height:11px;border-radius:50%;background:#E5E7EB}
    .fk-show-dot.r{background:#FCA5A5}
    .fk-show-dot.y{background:#FCD34D}
    .fk-show-dot.g{background:#86EFAC}
    .fk-show-path{margin-left:10px;font-size:.72rem;color:#9CA3AF;font-family:ui-monospace,Menlo,Consolas,monospace}
    .fk-show-body{padding:26px 28px;background:#F9FAFB}

    /* Page header dentro da janela */
    .fk-show-pg{margin-bottom:18px}
    .fk-show-pg h3{margin:0;font-size:1.35rem;font-weight:800;color:#0F172A;letter-spacing:-.02em}
    .fk-show-pg h3 .chip-ia{font-size:.58rem;font-weight:800;letter-spacing:.08em;padding:3px 7px;border-radius:6px;
                             background:linear-gradient(110deg,#6366F1,#8B5CF6,#A855F7);color:#fff;
                             vertical-align:middle;margin-left:6px;text-transform:uppercase}
    .fk-show-pg p{margin:4px 0 0;font-size:.8rem;color:#6B7280;line-height:1.5}

    /* Year tabs (pill ano) */
    .fk-show-year{display:inline-flex;gap:4px;background:#fff;border:1px solid #E5E7EB;border-radius:10px;
                  padding:3px;margin-bottom:14px}
    .fk-show-year span{padding:5px 12px;font-size:.74rem;font-weight:700;color:#6B7280;border-radius:7px;letter-spacing:.02em}
    .fk-show-year span.act{background:#0F172A;color:#fff}

    /* KPI cards com borda esquerda colorida (estilo rec-kpi real) */
    .fk-show-kgrid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:16px}
    .fk-show-k{background:#fff;border-radius:10px;padding:12px 14px;border-left:4px solid transparent;
               border:1px solid #E5E7EB;border-left-width:4px}
    .fk-show-k.rec{border-left-color:#10B981}
    .fk-show-k.ab{border-left-color:#F59E0B}
    .fk-show-k.to{border-left-color:#2563EB}
    .fk-show-k.tk{border-left-color:#14B8A6}
    .fk-show-k.sm{border-left-color:#8B5CF6}
    .fk-show-k-lbl{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#6B7280}
    .fk-show-k-val{font-size:1.1rem;font-weight:800;letter-spacing:-.02em;color:#0F172A;margin-top:3px;font-variant-numeric:tabular-nums}
    .fk-show-k-val.grn{color:#059669}
    .fk-show-k-val.amb{color:#D97706}
    .fk-show-k-val.blu{color:#2563EB}
    .fk-show-k-val.tea{color:#0F766E}
    .fk-show-k-val.pur{color:#7C3AED}
    .fk-show-k-sub{font-size:.62rem;color:#9CA3AF;margin-top:2px}

    /* Filtro chips (imita filtro por tipo da Receita) */
    .fk-show-chips{display:flex;gap:6px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
    .fk-show-chips-lbl{font-size:.68rem;color:#6B7280;font-weight:600;margin-right:2px}
    .fk-show-chip{display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:999px;font-size:.7rem;
                  font-weight:600;border:1px solid #E5E7EB;background:#fff;color:#6B7280}
    .fk-show-chip.on{background:#0F172A;color:#fff;border-color:#0F172A}
    .fk-show-chip .dot{width:7px;height:7px;border-radius:50%;background:#10B981}
    .fk-show-chip.tA .dot{background:#6366F1}
    .fk-show-chip.tB .dot{background:#10B981}
    .fk-show-chip.tC .dot{background:#F59E0B}
    .fk-show-chip.tD .dot{background:#8B5CF6}

    /* Planilha Receita real */
    .fk-sheet-wrap{background:#fff;border:1px solid #E5E7EB;border-radius:10px;overflow:hidden}
    .fk-sheet-table{width:100%;border-collapse:separate;border-spacing:0;font-size:.8rem}
    .fk-sheet-table th{background:#F3F4F6;color:#6B7280;font-weight:700;text-align:right;padding:8px 10px;
                       border-bottom:1px solid #E5E7EB;font-size:.62rem;text-transform:uppercase;letter-spacing:.06em;
                       white-space:nowrap}
    .fk-sheet-table th.l,.fk-sheet-table th.l2,.fk-sheet-table th.c{text-align:left}
    .fk-sheet-table th.c{text-align:center}
    .fk-sheet-table th.sub-total{position:relative;padding-top:4px}
    .fk-sheet-table th .sub{display:block;font-size:.56rem;color:#9CA3AF;font-weight:600;margin-top:1px}
    .fk-sheet-table td{padding:9px 10px;border-bottom:1px solid #F3F4F6;color:#374151;text-align:right;
                       font-variant-numeric:tabular-nums;white-space:nowrap}
    .fk-sheet-table td.l{text-align:left}
    .fk-sheet-table td.c{text-align:center}
    .fk-sheet-table tbody tr:hover td{background:#FAFBFC}
    .fk-sheet-table td.paid{background:#D1FAE5;color:#065F46;font-weight:700;position:relative}
