    .diag-scope-opt{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid #E2E8F0;border-radius:8px;cursor:pointer;background:#fff;transition:all .12s}
    .diag-scope-opt:hover{border-color:#7C3AED;background:#FAFBFC}
    .diag-scope-opt input{accent-color:#7C3AED;width:16px;height:16px;flex-shrink:0;margin:0}
    .diag-scope-opt .ico{font-size:1.2rem;flex-shrink:0;width:32px;height:32px;border-radius:8px;background:#F8FAFC;display:flex;align-items:center;justify-content:center}
    .diag-scope-opt .meta{flex:1;display:flex;flex-direction:column;gap:1px}
    .diag-scope-opt .meta b{font-size:.84rem;font-weight:700;color:#0F172A}
    .diag-scope-opt .meta span{font-size:.72rem;color:#64748B}
