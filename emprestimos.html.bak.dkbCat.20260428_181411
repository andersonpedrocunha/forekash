        let algumPreenchido = false;
        if(reg.parcelaEfetivada === '' || reg.parcelaEfetivada == null){ reg.parcelaEfetivada = parcelaLoan; algumPreenchido = true; }
        if(reg.jurosEfetivado === '' || reg.jurosEfetivado == null){ reg.jurosEfetivado = juros; algumPreenchido = true; }
        if(reg.amortEfetivada === '' || reg.amortEfetivada == null){ reg.amortEfetivada = amort; algumPreenchido = true; }
        if(reg.saldoEfetivado === '' || reg.saldoEfetivado == null){ reg.saldoEfetivado = saldoFim; algumPreenchido = true; }
        if(algumPreenchido){ reg.ts = new Date().toISOString(); autoPreenchidos++; }
      }
