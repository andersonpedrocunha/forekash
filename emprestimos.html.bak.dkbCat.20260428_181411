// ─── Logo do cliente (opcional) ───
// A logo é armazenada como data URL no próprio cliente. Antes de salvar,
// redimensiona para no máximo 256px no maior lado (economia de localStorage,
// preservando transparência via PNG). SVGs são mantidos como estão (vetoriais).
async function resizeImageToDataURL(file, maxSide){
  return new Promise((resolve, reject) => {
    const rd = new FileReader();
    rd.onload = () => {
      const raw = rd.result;
      if(file.type === 'image/svg+xml'){ resolve(raw); return; }
      const img = new Image();
      img.onload = () => {
        try{
          let w = img.naturalWidth, h = img.naturalHeight;
          if(!w || !h){ resolve(raw); return; }
          if(w <= maxSide && h <= maxSide){
            resolve(raw);
            return;
          }
          const ratio = Math.min(maxSide/w, maxSide/h);
          w = Math.round(w * ratio);
          h = Math.round(h * ratio);
          const cv = document.createElement('canvas');
          cv.width = w; cv.height = h;
          const ctx = cv.getContext('2d');
          ctx.clearRect(0, 0, w, h);
          ctx.drawImage(img, 0, 0, w, h);
          resolve(cv.toDataURL('image/png'));
        }catch(err){ reject(err); }
      };
      img.onerror = () => reject(new Error('Não foi possível abrir a imagem.'));
      img.src = raw;
    };
    rd.onerror = () => reject(rd.error || new Error('Falha ao ler o arquivo.'));
    rd.readAsDataURL(file);
  });
}

