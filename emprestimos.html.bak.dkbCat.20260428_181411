function _recKbCells(){
  const out = [];
  if(typeof receita === 'undefined' || !receita || !receita.years) return out;
  const from = _recKbState.from;
  const to   = _recKbState.to;
  const mesIdx = (mAbbr) => REC_MESES.indexOf(mAbbr);
  const q = (_recKbState.search || '').toLowerCase().trim();
  for(const yKey of Object.keys(receita.years)){
    const yNum = parseInt(yKey, 10);
    if(!isFinite(yNum)) continue;
    const d = receita.years[yKey] || {};
    for(const r of (d.clients || [])){
      const c = (receita.clientes || []).find(x => x.id === r.clienteId);
      const nomeCli = c ? (c.nome || '(sem nome)') : '(cliente removido)';
      const color   = c ? (c.color || '#94A3B8') : '#94A3B8';
      const pais    = c ? (c.pais || '') : '';
      const meses = r.meses || {};
      for(const mAbbr of REC_MESES){
        const cell = meses[mAbbr];
        if(!cell || cell.valor === '' || cell.valor == null) continue;
        const v = parseFloat(cell.valor);
        if(!isFinite(v) || v === 0) continue;
        const m = mesIdx(mAbbr);
        if(m < 0) continue;
        const ymObj = { y: yNum, m: m };
        if(from && _recKbCmpYM(ymObj, from) < 0) continue;
        if(to   && _recKbCmpYM(ymObj, to)   > 0) continue;
        if(q){
          const nome = (nomeCli || '').toLowerCase();
          const desc = ((r.descricao || r.tipo || '')).toLowerCase();
          if(!nome.includes(q) && !desc.includes(q)) continue;
        }
        out.push({
          year: yNum, mesAbbr: mAbbr, m: m,
          rowId: r.id, clienteId: r.clienteId,
          nome: nomeCli, color: color, pais: pais,
          desc: r.descricao || r.tipo || '',
          valor: v,
          status: cell.status === 'recebido' ? 'recebido' : 'aberto',
          dataVencimento: cell.dataVencimento || '',
          dataRecebimento: cell.dataRecebimento || '',
          notas: cell.notas || '',
          numeroDocumento: cell.numeroDocumento || '',
          dataEmissao: cell.dataEmissao || '',
          banco: cell.banco || ''
        });
      }
    }
  }
  return out;
}

function _recKbClassify(card){
  if(card.status === 'recebido') return 'recebido';
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  // Próximos 7 dias (incluindo hoje)
  const semanaFim = new Date(today);
  semanaFim.setDate(today.getDate() + 7);
  // Se há dataVencimento, ela é a fonte da verdade
  if(card.dataVencimento){
    const d = new Date(card.dataVencimento + 'T00:00:00');
    if(!isNaN(d.getTime())){
      if(d < today) return 'atraso';
      if(d < semanaFim) return 'semana';
      if(d.getFullYear() === today.getFullYear() && d.getMonth() === today.getMonth()) return 'mes';
      return 'vencer';
    }
  }
  // Fallback: usa só o mês/ano de referência
  const cy = today.getFullYear(), cm = today.getMonth();
  if(card.year < cy) return 'atraso';
  if(card.year > cy) return 'vencer';
  if(card.m < cm) return 'atraso';
  if(card.m > cm) return 'vencer';
  return 'mes';
}

