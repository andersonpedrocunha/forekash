/* ─── Validadores PIX ──────────────────────────────
   Regras oficiais: CPF (11 dígitos + DV), CNPJ (14 dígitos + DV),
   Email (RFC simplificada), Telefone BR (DDD + 8/9 dígitos, com ou sem +55),
   Chave aleatória (UUID v4 de 36 caracteres formatado). */
function isValidCNPJ(s){
  const d = onlyDigits(s);
  if(d.length !== 14) return false;
  if(/^(\d)\1{13}$/.test(d)) return false;
  const calc = (slice) => {
    const weights = slice.length === 12
      ? [5,4,3,2,9,8,7,6,5,4,3,2]
      : [6,5,4,3,2,9,8,7,6,5,4,3,2];
    let sum = 0;
    for(let i=0;i<slice.length;i++) sum += parseInt(slice[i],10) * weights[i];
    const r = sum % 11;
    return r < 2 ? 0 : 11 - r;
  };
  const d1 = calc(d.slice(0,12));
  const d2 = calc(d.slice(0,13));
  return d1 === parseInt(d[12],10) && d2 === parseInt(d[13],10);
}
function isValidEmailAddress(s){
  const v = String(s||'').trim();
  if(!v) return false;
  // Simples mas razoável: "x@y.z" com partes não vazias e sem espaços.
  return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
}
function isValidPhoneBR(s){
  const d = onlyDigits(s);
  // 10 = DDD + fixo (8 dígitos), 11 = DDD + celular (9 dígitos),
  // 12/13 = com código do país (+55)
  if(d.length === 10 || d.length === 11) return true;
  if(d.length === 12 && d.startsWith('55')) return true;
  if(d.length === 13 && d.startsWith('55')) return true;
  return false;
}
function isValidPixAleatoria(s){
  const v = String(s||'').trim().toLowerCase();
  // UUID v4/aleatória do Banco Central: 8-4-4-4-12 hex (36 chars com traços)
  // Aceita também 32 hex sem traços por conveniência.
  if(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v)) return true;
  if(/^[0-9a-f]{32}$/i.test(v)) return true;
  return false;
}
// Retorna {state:'ok'|'err'|'empty'|'notype', msg:string, hint?:string}
function validatePix(tipo, val){
  const v = String(val||'').trim();
  if(!v) return { state:'empty', msg:'' };
  if(!tipo) return { state:'notype', msg:'Selecione o tipo da chave PIX para validar.' };
  if(tipo === 'cpf'){
    return isValidCPF(v)
      ? { state:'ok',  msg:'CPF válido' }
      : { state:'err', msg:'CPF inválido — verifique os dígitos.' };
  }
  if(tipo === 'cnpj'){
    return isValidCNPJ(v)
      ? { state:'ok',  msg:'CNPJ válido' }
      : { state:'err', msg:'CNPJ inválido — verifique os dígitos.' };
  }
  if(tipo === 'email'){
    return isValidEmailAddress(v)
      ? { state:'ok',  msg:'E-mail válido' }
      : { state:'err', msg:'E-mail inválido — formato esperado: nome@dominio.com.' };
  }
  if(tipo === 'telefone'){
    return isValidPhoneBR(v)
      ? { state:'ok',  msg:'Telefone válido' }
      : { state:'err', msg:'Telefone inválido — inclua DDD (ex.: (11) 99999-9999).' };
  }
  if(tipo === 'aleatoria'){
    return isValidPixAleatoria(v)
      ? { state:'ok',  msg:'Chave aleatória válida' }
      : { state:'err', msg:'Chave aleatória inválida — precisa ser UUID (8-4-4-4-12).' };
  }
  return { state:'empty', msg:'' };
}
function dispoPixValidateRender(id){
  const c = dispo.contas.find(x => x.id === id); if(!c) return;
  const d = dispoEnsureDados(c);
  const res = validatePix(d.pixTipo, d.pix);
  const wrap = document.querySelector(`.dispo-dados-pix[data-cid="${id}"]`);
  if(!wrap) return;
  wrap.classList.remove('ok','err','notype');
  if(res.state === 'ok')       wrap.classList.add('ok');
  else if(res.state === 'err') wrap.classList.add('err');
  else if(res.state === 'notype') wrap.classList.add('notype');
  const msgEl = wrap.querySelector('.dispo-dados-pix-msg');
  if(msgEl) msgEl.textContent = res.msg || '';
}
