            totalDespMes += parseFloat(v)||0;
          }
        }
        const pct = totalDespMes > 0 ? (totalDesp / totalDespMes * 100) : 0;
        return ' <span class="cfg-cac-absorvido is-on" style="margin-left:8px">' + pct.toFixed(1) + '% absorvido total</span>';
      })()
    + '</div>'
