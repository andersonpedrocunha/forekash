}

// Redimensiona e salva uma foto para a pessoa (registry).
// Aceita qualquer imagem, reduz pra ~256x256 e salva como dataURL.
function onPesFotoChange(rid, input){
  const file = input && input.files && input.files[0];
  if(!file) return;
  if(!/^image\//.test(file.type)){
    toast('Arquivo não é uma imagem.', 2500);
    input.value = '';
    return;
  }
  const reader = new FileReader();
  reader.onload = ev => {
    const img = new Image();
    img.onload = () => {
      try{
        const MAX = 256;
        const scale = Math.min(1, MAX / Math.max(img.width, img.height));
        const w = Math.max(1, Math.round(img.width  * scale));
        const h = Math.max(1, Math.round(img.height * scale));
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        const dataUrl = canvas.toDataURL('image/jpeg', 0.86);
        const r = pesRegistry().find(x => x.id === rid);
        if(r){
          r.foto = dataUrl;
          pessoasSave();
          if(_pesCardOpenId != null) renderPesCardBody();
          renderPessoas();
        }
      }catch(e){
        toast('Não foi possível processar a imagem.', 2800);
      }
      input.value = '';
    };
    img.onerror = () => { toast('Imagem inválida.', 2500); input.value = ''; };
    img.src = ev.target.result;
  };
  reader.onerror = () => { toast('Erro ao ler arquivo.', 2500); input.value = ''; };
  reader.readAsDataURL(file);
}

