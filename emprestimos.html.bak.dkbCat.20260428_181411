function cacSetItemPct(itemId, val){
  _cacLoad();
  let p = parseFloat(val);
  if(!isFinite(p)) p = 0;
  p = Math.max(0, Math.min(100, p));
  const existing = _cacEnsureObj(_cacConfig.itens, itemId);
  const closed = (existing && existing.closed) ? existing.closed : {};
  if(p === 0 && Object.keys(closed).length === 0){
    delete _cacConfig.itens[itemId];
  } else {
    _cacConfig.itens[itemId] = { default: p, closed: closed };
  }
  _cacSave();
  renderCacConfig();
}
function cacSetItemPctClosed(itemId, mesKey, val){
  _cacLoad();
  const obj = _cacEnsureObj(_cacConfig.itens, itemId) || (_cacConfig.itens[itemId] = { default:0, closed:{} });
  const trimmed = String(val == null ? '' : val).trim();
  if(trimmed === ''){
    delete obj.closed[mesKey];
  } else {
    let p = parseFloat(trimmed);
    if(!isFinite(p)) return;
    p = Math.max(0, Math.min(100, p));
    obj.closed[mesKey] = p;
  }
  _cacSave();
  renderCacConfig();
}
// Fecha mês: snapshot do default atual congela em closed[mesKey]
function cacFecharMes(kind, id, mesKey){
  _cacLoad();
  const map = (kind === 'item') ? _cacConfig.itens : _cacConfig.pessoas;
  const obj = _cacEnsureObj(map, id) || (map[id] = { default:0, closed:{} });
  obj.closed[mesKey] = obj.default || 0;
  _cacSave();
  renderCacConfig();
  if(typeof toast === 'function') toast('🔒 Mês fechado em ' + (obj.default || 0) + '%');
}
// Reabre mês: remove o snapshot e volta a usar o default
function cacReabrirMes(kind, id, mesKey){
  _cacLoad();
  const map = (kind === 'item') ? _cacConfig.itens : _cacConfig.pessoas;
  const obj = map[id];
  if(obj && typeof obj === 'object' && obj.closed){
    delete obj.closed[mesKey];
    if(obj.default === 0 && Object.keys(obj.closed).length === 0) delete map[id];
  }
  _cacSave();
  renderCacConfig();
  if(typeof toast === 'function') toast('Mês reaberto · usa o padrão');
}
// Bulk: fecha todos os meses até e incluindo o mês atual de referência
function cacFecharAteMes(kind, id, mesAteKey){
  _cacLoad();
  const map = (kind === 'item') ? _cacConfig.itens : _cacConfig.pessoas;
  const obj = _cacEnsureObj(map, id) || (map[id] = { default:0, closed:{} });
  const [yA, mA] = mesAteKey.split('-').map(n => parseInt(n,10));
  // Fecha 24 meses pra trás até o mês atual com o default
  let count = 0;
  for(let i = 0; i < 24; i++){
    const d = new Date(yA, mA - 1 - i, 1);
    const k = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0');
    if(!(k in obj.closed)){
      obj.closed[k] = obj.default || 0;
      count++;
    }
  }
  _cacSave();
  renderCacConfig();
  if(typeof toast === 'function') toast('🔒 ' + count + ' meses fechados em ' + (obj.default||0) + '%');
}
