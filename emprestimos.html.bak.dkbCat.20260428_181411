// Sincroniza loan.saldo com o saldoEfetivado do mês EFETIVADO mais recente
// (se houver). Isso faz com que a aba principal de Empréstimos e seus KPIs/totais
// reflitam a realidade registrada. Se não houver nenhum mês efetivado com saldo,
// loan.saldo fica como estava.
function _updateLoanSaldoFromEfetivados(loan){
  if(!loan || !Array.isArray(loan.registros)) return false;
  const efetivados = loan.registros
    .filter(r => r && r.mes
              && typeof isMesEfetivado === 'function' && isMesEfetivado(r.mes)
              && r.saldoEfetivado !== '' && r.saldoEfetivado != null)
    .sort((a,b) => b.mes.localeCompare(a.mes));
  if(efetivados.length === 0) return false;
  const novoSaldo = parseFloat(efetivados[0].saldoEfetivado) || 0;
  if(Math.abs((parseFloat(loan.saldo)||0) - novoSaldo) < 0.005) return false;
  loan.saldo = novoSaldo;
  return true;
}

