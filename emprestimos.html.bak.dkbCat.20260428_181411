function _viagMsAberta(v){
  if(!v.criadoEm) return null;
  try {
    const created = new Date(v.criadoEm).getTime();
    const end = v.fechadoEm ? new Date(v.fechadoEm).getTime() : Date.now();
    const ms = end - created;
    return (isFinite(ms) && ms >= 0) ? ms : 0;
  } catch(e){ return null; }
}
