const HOME_QUOTE_DISABLED_KEY = 'home_quote_disabled_v1';
const HOME_QUOTE_CUSTOM_KEY   = 'home_quote_custom_v1';

function homeQuoteDisabledSet(){
  try{
    const raw = localStorage.getItem(HOME_QUOTE_DISABLED_KEY);
    const arr = raw ? JSON.parse(raw) : [];
    return new Set(Array.isArray(arr) ? arr : []);
  }catch(e){ return new Set(); }
}
function homeQuoteDisabledSave(set){
  try{ localStorage.setItem(HOME_QUOTE_DISABLED_KEY, JSON.stringify([...set])); }catch(e){}
}
function homeQuoteCustomLoad(){
  try{
    const raw = localStorage.getItem(HOME_QUOTE_CUSTOM_KEY);
    const arr = raw ? JSON.parse(raw) : [];
    if(!Array.isArray(arr)) return [];
    return arr.filter(t => t && typeof t === 'object' && t.id && t.nome
                        && Array.isArray(t.frases) && t.frases.length)
              .map(t => ({ id:String(t.id), nome:String(t.nome),
                           grupo: t.grupo ? String(t.grupo) : 'Personalizados',
                           bio: typeof t.bio === 'string' ? t.bio.trim().slice(0, 280) : '',
                           frases: t.frases.filter(f => typeof f === 'string' && f.trim()).map(f => f.trim()),
                           custom: true }));
  }catch(e){ return []; }
}
function homeQuoteCustomSave(arr){
  try{ localStorage.setItem(HOME_QUOTE_CUSTOM_KEY, JSON.stringify(arr)); }catch(e){}
}
function homeQuoteAllThinkers(){
  // Base + custom (custom fica ao final, no grupo "Personalizados")
  return [...QUOTE_THINKERS, ...homeQuoteCustomLoad()];
}
function homeQuoteIsEnabled(id){ return !homeQuoteDisabledSet().has(id); }
function homeQuoteTogglePensador(id){
  const s = homeQuoteDisabledSet();
  if(s.has(id)) s.delete(id); else s.add(id);
  homeQuoteDisabledSave(s);
  homeQuoteRenderSettings();
  homeRenderQuote();
}
function homeQuoteSelectAll(){ homeQuoteDisabledSave(new Set()); homeQuoteRenderSettings(); homeRenderQuote(); }
function homeQuoteSelectNone(){
  const s = new Set(homeQuoteAllThinkers().map(t => t.id));
  homeQuoteDisabledSave(s); homeQuoteRenderSettings(); homeRenderQuote();
}

// Pool plano: [{id, nome, frase, bio}, ...]
function homeQuotePool(){
  const dis = homeQuoteDisabledSet();
  const pool = [];
  for(const t of homeQuoteAllThinkers()){
    if(dis.has(t.id)) continue;
    for(const f of t.frases) pool.push({ id:t.id, nome:t.nome, frase:f, bio: t.bio || '' });
  }
  return pool;
}

// Slugify ASCII para IDs
function homeQuoteSlug(s){
  return String(s || '').toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}
