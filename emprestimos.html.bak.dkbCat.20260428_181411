    /* ══ DIAGNÓSTICO · AI FEEL — gradiente aurora, streaming, chips, shimmer, follow-up ════ */
    /* Aurora — gradiente animado no botão "Gerar Diagnóstico" e card de saúde */
    @keyframes diagAurora{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
    .diag-run-btn{background:linear-gradient(110deg,#6366F1,#8B5CF6,#A855F7,#6366F1)!important;
                  background-size:200% 200%!important;animation:diagAurora 4s ease infinite;
                  box-shadow:0 4px 14px rgba(139,92,246,.3),0 2px 6px rgba(99,102,241,.2)}
    .diag-run-btn::before{content:"✦";margin-right:2px;font-size:.85em;opacity:.9}
    .diag-ia-chip{background:linear-gradient(110deg,#6366F1,#8B5CF6,#A855F7,#6366F1)!important;
                  background-size:200% 200%;animation:diagAurora 5s ease infinite}
    /* Card de saúde com sutil borda gradiente animada */
    .diag-health{position:relative;overflow:hidden}
    .diag-health::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;
                         background:linear-gradient(120deg,rgba(99,102,241,.0),rgba(139,92,246,.35),
                                    rgba(16,185,129,.25),rgba(99,102,241,.0));
                         background-size:200% 200%;animation:diagAurora 6s ease infinite;
                         -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
                         -webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}

    /* Sparkle (✨) discretos ao lado dos títulos de seção durante streaming */
    @keyframes diagSparkle{0%,100%{opacity:.3;transform:scale(.85)}50%{opacity:1;transform:scale(1.1)}}
    .diag-sparkle{display:inline-block;margin-left:6px;font-size:.7em;
                  background:linear-gradient(135deg,#6366F1,#A855F7);
                  -webkit-background-clip:text;background-clip:text;color:transparent;
                  animation:diagSparkle 1.6s ease-in-out infinite;vertical-align:middle}

    /* Streaming cursor (piscante) */
    @keyframes diagCursor{0%,50%{opacity:1}51%,100%{opacity:0}}
    .diag-streaming::after{content:"▌";display:inline-block;color:#8B5CF6;margin-left:1px;
                           animation:diagCursor 1s steps(1) infinite;font-weight:400}

    /* Shimmer / skeleton loader — linhas pulsando enquanto conteúdo ainda vai streamar */
    @keyframes diagShimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
    .diag-skeleton{height:12px;border-radius:5px;
                   background:linear-gradient(90deg,#F1F5F9 0%,#E2E8F0 50%,#F1F5F9 100%);
                   background-size:200% 100%;animation:diagShimmer 1.5s linear infinite}
    .diag-skeleton + .diag-skeleton{margin-top:8px}
    .diag-skeleton.sk-short{width:40%}
    .diag-skeleton.sk-med{width:72%}
    .diag-skeleton.sk-long{width:92%}

    /* Chip de explicabilidade — exibe confiança e fontes por alerta/insight */
    .diag-explain{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;padding-top:8px;
                  border-top:1px dashed var(--bdr)}
    .diag-explain-chip{font-size:.62rem;font-weight:600;padding:3px 8px;border-radius:999px;
                       background:#F1F5F9;color:#475569;
                       display:inline-flex;align-items:center;gap:4px;line-height:1.3}
    .diag-explain-chip svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2.2}
    .diag-explain-chip.conf{background:#EDE9FE;color:#5B21B6}
    .diag-explain-chip.src{background:#E0E7FF;color:#3730A3}
    .diag-explain-chip.model{background:#D1FAE5;color:#065F46}

    /* Follow-up chips — botões conversacionais ao final do relatório */
    .diag-followup{background:var(--card);border:1px solid var(--bdr);border-radius:14px;
                   padding:18px 20px}
    .diag-followup-hd{display:flex;align-items:center;gap:8px;margin-bottom:10px;
                      font-size:.74rem;font-weight:700;color:var(--tx)}
    .diag-followup-hd::before{content:"✦";color:#8B5CF6;font-size:.9rem}
    .diag-followup-list{display:flex;gap:8px;flex-wrap:wrap}
    .diag-followup-chip{font-size:.74rem;font-weight:600;padding:8px 14px;border-radius:999px;
                        border:1px solid #E0E7FF;background:#fff;color:#4338CA;cursor:pointer;
                        transition:all .15s;display:inline-flex;align-items:center;gap:6px}
    .diag-followup-chip:hover{background:#EEF2FF;border-color:#A5B4FC;
                              transform:translateY(-1px);box-shadow:0 2px 8px rgba(99,102,241,.15)}
    .diag-followup-chip::before{content:"→";color:#6366F1;font-weight:700}

    /* Botões de regenerar / reescrever em cada seção */
    .diag-section-hd{position:relative}
    .diag-section-actions{margin-left:auto;display:flex;gap:4px}
    .diag-section-act{background:transparent;border:1px solid transparent;border-radius:6px;
                      padding:4px 8px;font-size:.68rem;font-weight:600;color:var(--txl);
                      cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:4px}
    .diag-section-act:hover{background:#F3F4F6;color:#4338CA;border-color:#E5E7EB}
    .diag-section-act svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.2}
    .diag-section-act.on{background:#EDE9FE;color:#5B21B6;border-color:#DDD6FE}

    /* Passo "ativo" no loading agora mostra um mini-processo pulsando (em vez de só cor) */
    .diag-loading-step.active .diag-ls-bullet{
      background:conic-gradient(from 0deg,#8B5CF6,#A855F7,#8B5CF6);
      animation:diagSpin 1s linear infinite;
      box-shadow:0 0 0 3px rgba(139,92,246,.2),0 0 12px rgba(139,92,246,.35)}
    .diag-loading-sub{font-size:.68rem;color:var(--txl);margin-top:2px;margin-left:24px;
                      font-style:italic;opacity:0;max-height:0;overflow:hidden;
                      transition:opacity .2s,max-height .25s}
    .diag-loading-step.active .diag-loading-sub{opacity:1;max-height:30px}

    /* ══ Destaque pulsante em números-chave no texto ══════════ */
    @keyframes diagNumPulse{
      0%  {background:rgba(139,92,246,0);  box-shadow:0 0 0 0 rgba(139,92,246,0)}
      20% {background:rgba(139,92,246,.18);box-shadow:0 0 0 3px rgba(139,92,246,.12)}
      100%{background:rgba(139,92,246,.06);box-shadow:0 0 0 0 rgba(139,92,246,0)}
    }
    .diag-num{display:inline-block;padding:1px 6px;margin:0 1px;border-radius:6px;
              background:rgba(139,92,246,.06);
              font-variant-numeric:tabular-nums;font-weight:600;color:#4C1D95;
              transition:background .2s,box-shadow .2s;position:relative}
    .diag-num.pulse{animation:diagNumPulse 1.2s ease-out 1}
    .diag-num:hover{background:rgba(139,92,246,.15);box-shadow:0 0 0 2px rgba(139,92,246,.2)}
    .diag-num[data-calc]:hover::after{
      content:attr(data-calc);
      position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);
      background:#1E1B4B;color:#E0E7FF;font-size:.72rem;font-weight:400;
      padding:10px 14px;border-radius:10px;white-space:normal;
      width:max-content;max-width:340px;min-width:200px;
      text-align:left;line-height:1.5;
      box-shadow:0 10px 28px rgba(30,27,75,.35),0 0 0 1px rgba(139,92,246,.2);
      z-index:50;pointer-events:none}
    .diag-num[data-calc]:hover::before{
      content:"";position:absolute;bottom:calc(100% + 3px);left:50%;transform:translateX(-50%);
      border:5px solid transparent;border-top-color:#1E1B4B;z-index:51;pointer-events:none}
    /* cursor help só quando tem tooltip */
    .diag-num{cursor:default}
    .diag-num[data-calc]{cursor:help}

    /* ══ Barra de progresso fina no topo durante streaming ══ */
    .diag-progress{position:sticky;top:0;left:0;right:0;height:3px;z-index:10;
                   background:linear-gradient(90deg,#EDE9FE 0%,#F3F4F6 100%);
                   border-radius:0 0 3px 3px;overflow:hidden;margin:0 -20px 12px;
                   opacity:0;transition:opacity .25s}
    .diag-progress.on{opacity:1}
    .diag-progress-fill{height:100%;width:0;
                        background:linear-gradient(90deg,#6366F1,#8B5CF6,#10B981);
                        background-size:200% 100%;animation:diagAurora 3s linear infinite;
                        transition:width .35s cubic-bezier(.16,1,.3,1)}
    .diag-progress-lbl{position:absolute;right:8px;top:6px;font-size:.62rem;font-weight:700;
                       color:#6366F1;letter-spacing:.02em;opacity:.8}

    /* ══ Botões de copiar / exportar no header do resultado ══ */
    .diag-export-btns{display:inline-flex;gap:4px;margin-left:auto;align-items:center}
    .diag-export-btn{background:#fff;border:1px solid var(--bdr);border-radius:8px;
                     padding:6px 10px;font-size:.7rem;font-weight:600;color:var(--txl);
                     cursor:pointer;transition:all .15s;
                     display:inline-flex;align-items:center;gap:5px}
    .diag-export-btn:hover{background:#EDE9FE;border-color:#C4B5FD;color:#5B21B6;
                           transform:translateY(-1px);box-shadow:0 2px 6px rgba(139,92,246,.12)}
    .diag-export-btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2}
    .diag-export-btn.ok{background:#D1FAE5;border-color:#6EE7B7;color:#065F46}

    /* ══ Popover "Como o score é calculado" ══════════════════ */
    .diag-score-explain-btn{background:none;border:1px dashed #C4B5FD;
                            border-radius:999px;padding:3px 10px;font-size:.62rem;
                            font-weight:600;color:#6D28D9;cursor:pointer;margin-top:8px;
                            display:inline-flex;align-items:center;gap:4px;
                            transition:all .15s}
    .diag-score-explain-btn:hover{background:#EDE9FE;border-style:solid}
    .diag-score-explain-btn svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2.2}
    .diag-score-explain-pop{margin-top:10px;padding:12px 14px;border-radius:10px;
                            background:#F5F3FF;border:1px solid #DDD6FE;font-size:.72rem;
                            color:#4C1D95;line-height:1.5;animation:diagFadeIn .25s ease}
    .diag-score-explain-pop b{color:#2E1065}
    .diag-score-explain-pop ul{margin:6px 0 0;padding-left:18px}
    .diag-score-explain-pop li{margin:2px 0}
    @keyframes diagFadeIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}

    .diag-history{background:var(--card);border:1px solid var(--bdr);border-radius:14px;
                  padding:18px 20px}
    .diag-history h4{font-size:.78rem;font-weight:700;color:var(--tx);margin:0 0 10px;
                     letter-spacing:-.01em}
    .diag-history-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:6px}
    .diag-history-item{display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:8px;
                       cursor:pointer;transition:background .1s}
    .diag-history-item:hover{background:#F3F4F6}
    .diag-history-item.current{background:#EFF6FF;border:1px solid #BFDBFE}
    .diag-history-score{width:36px;height:36px;border-radius:9px;flex-shrink:0;
                        display:flex;align-items:center;justify-content:center;
                        font-size:.82rem;font-weight:800;color:#fff}
    .diag-history-score.s-good{background:#10B981}
    .diag-history-score.s-mid {background:#F59E0B}
    .diag-history-score.s-bad {background:#DC2626}
    .diag-history-info{flex:1;min-width:0}
    .diag-history-date{font-size:.74rem;font-weight:600;color:var(--tx)}
    .diag-history-sub {font-size:.65rem;color:var(--txl);margin-top:1px}
    .diag-history-del{background:transparent;border:none;color:#94A3B8;cursor:pointer;
                      padding:4px 6px;border-radius:6px;font-size:.78rem}
    .diag-history-del:hover{background:#FEE2E2;color:#DC2626}

    /* ══ DIAGNÓSTICO · ML (previsões & padrões) ═════════════ */
    .diag-section.ml .diag-section-ico{background:linear-gradient(135deg,#8B5CF6,#6366F1);color:#fff}
    .diag-ml-quality{display:inline-flex;align-items:center;gap:4px;font-size:.62rem;
                     font-weight:700;letter-spacing:.04em;text-transform:uppercase;
                     padding:3px 9px;border-radius:999px;margin-left:10px;vertical-align:middle}
    .diag-ml-quality.good{background:#D1FAE5;color:#047857}
    .diag-ml-quality.warn{background:#FEF3C7;color:#92400E}
    .diag-ml-quality.bad {background:#FEE2E2;color:#B91C1C}
    .diag-ml-meta{font-size:.64rem;color:var(--txl);margin-left:10px;font-weight:600;
                  letter-spacing:.01em;text-transform:none}

    .diag-ml-forecast{background:linear-gradient(135deg,#F5F3FF 0%,#EEF2FF 100%);
                      border:1px solid #DDD6FE;border-radius:12px;padding:16px 18px;
                      margin-bottom:14px;box-shadow:0 1px 3px rgba(139,92,246,.05)}
    .diag-ml-forecast-hd{display:flex;align-items:flex-start;justify-content:space-between;
                         gap:14px;margin-bottom:12px;flex-wrap:wrap}
    .diag-ml-forecast-title{font-size:.95rem;font-weight:800;color:#4C1D95;margin-bottom:3px}
    .diag-ml-forecast-sub{font-size:.72rem;color:#6D28D9;line-height:1.5}
    .diag-ml-forecast-sub b{font-weight:700;color:#5B21B6}
    .diag-ml-forecast-delta{font-size:1.55rem;font-weight:800;color:#4C1D95;
                            line-height:1;text-align:right;display:flex;flex-direction:column;
                            align-items:flex-end;gap:3px}
    .diag-ml-forecast-delta small{font-size:.6rem;font-weight:600;color:#7C3AED;
                                  letter-spacing:.02em;text-transform:uppercase}
    .diag-ml-forecast-delta.diag-hi-pos{color:#047857}
    .diag-ml-forecast-delta.diag-hi-neg{color:#B91C1C}
    .diag-ml-forecast-foot{display:flex;gap:20px;flex-wrap:wrap;
                           padding-top:10px;margin-top:10px;border-top:1px solid #E9D5FF;
                           font-size:.72rem;color:#6D28D9}
    .diag-ml-forecast-foot b{color:#4C1D95;font-weight:700}
    .diag-ml-forecast svg{display:block;width:100%;height:auto;
                          background:#fff;border-radius:8px;padding:8px;box-sizing:border-box}

    .diag-ml-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
                  gap:12px}
    .diag-ml-block{background:#fff;border:1px solid var(--bdr);border-radius:10px;
                   padding:14px 16px}
    .diag-ml-block-hd{display:flex;align-items:center;gap:8px;margin-bottom:10px;
                      font-size:.82rem;color:var(--tx);flex-wrap:wrap}
    .diag-ml-block-hd b{font-weight:700}
    .diag-ml-block-sub{font-size:.65rem;color:var(--txl);font-weight:500}
    .diag-ml-block-icon{width:22px;height:22px;border-radius:6px;display:inline-flex;
                        align-items:center;justify-content:center;font-size:.78rem;font-weight:700;
                        flex-shrink:0}
    .diag-ml-block-icon.alt{background:#FEF3C7;color:#B45309}
    .diag-ml-block-icon.clu{background:#DBEAFE;color:#1D4ED8}
    .diag-ml-block-icon.cor{background:#CCFBF1;color:#0F766E}
    .diag-ml-block-icon.saz{background:#EDE9FE;color:#6D28D9}

    .diag-ml-anoms{display:flex;flex-direction:column;gap:8px}
    .diag-ml-anom{display:grid;grid-template-columns:1fr auto;row-gap:2px;column-gap:12px;
                  padding:9px 12px;border-radius:8px;border-left:3px solid transparent}
    .diag-ml-anom.up{background:#FEF2F2;border-left-color:#DC2626}
    .diag-ml-anom.down{background:#F0F9FF;border-left-color:#0284C7}
    .diag-ml-anom-lbl{font-size:.72rem;font-weight:600;color:var(--tx)}
    .diag-ml-anom-val{font-size:.82rem;font-weight:700;color:var(--tx);text-align:right;
                      font-variant-numeric:tabular-nums}
    .diag-ml-anom-exp{grid-column:1/-1;font-size:.68rem;color:var(--txm);line-height:1.4}
    .diag-ml-anom-exp b{color:var(--tx);font-weight:700}
    .diag-ml-anom.up .diag-ml-anom-exp b{color:#B91C1C}
    .diag-ml-anom.down .diag-ml-anom-exp b{color:#0369A1}

    .diag-ml-clusters{display:flex;flex-direction:column;gap:10px}
    .diag-ml-cluster{padding:10px 12px;border-radius:8px;background:#F8FAFC;
                     border:1px solid transparent}
    .diag-ml-cluster.anc{background:linear-gradient(135deg,#FEF3C7,#FDE68A 60%,#FEF3C7);
                         border-color:#FCD34D}
    .diag-ml-cluster.rel{background:linear-gradient(135deg,#DBEAFE,#BFDBFE 60%,#DBEAFE);
                         border-color:#93C5FD}
    .diag-ml-cluster.pon{background:#F1F5F9;border-color:#E2E8F0}
    .diag-ml-cluster-hd{display:flex;align-items:center;justify-content:space-between;
                        gap:8px;margin-bottom:4px}
    .diag-ml-cluster-hd b{font-size:.78rem;font-weight:800;color:var(--tx);letter-spacing:.01em}
    .diag-ml-cluster-qt{font-size:.65rem;font-weight:600;color:var(--txm);
                        background:rgba(255,255,255,.6);padding:2px 8px;border-radius:999px}
    .diag-ml-cluster-val{font-size:.98rem;font-weight:800;color:var(--tx);
                         font-variant-numeric:tabular-nums;margin-bottom:6px}
    .diag-ml-cluster-bar{height:6px;background:rgba(15,23,42,.08);border-radius:999px;
                         overflow:hidden;margin-bottom:6px}
    .diag-ml-cluster-bar span{display:block;height:100%;border-radius:999px;
                              background:linear-gradient(90deg,#6366F1,#8B5CF6);
                              transition:width .6s ease}
    .diag-ml-cluster.anc .diag-ml-cluster-bar span{background:linear-gradient(90deg,#F59E0B,#D97706)}
    .diag-ml-cluster.rel .diag-ml-cluster-bar span{background:linear-gradient(90deg,#3B82F6,#2563EB)}
    .diag-ml-cluster.pon .diag-ml-cluster-bar span{background:linear-gradient(90deg,#64748B,#475569)}
    .diag-ml-cluster-sub{font-size:.66rem;color:var(--txm);line-height:1.45}
    .diag-ml-cluster-names{margin-top:3px;font-size:.65rem;color:var(--txl);
                           font-style:italic;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

    .diag-ml-corrs{display:flex;flex-direction:column;gap:10px}
    .diag-ml-corr{padding:9px 12px;border-radius:8px;background:#F8FAFC;border:1px solid #E2E8F0}
    .diag-ml-corr-lbl{font-size:.72rem;color:var(--txm);margin-bottom:3px}
    .diag-ml-corr-lbl b{color:var(--tx);font-weight:700}
    .diag-ml-corr-val{font-size:.82rem;font-weight:700;color:var(--tx);
                      display:flex;align-items:center;gap:8px;margin-bottom:6px}
    .diag-ml-corr-tag{font-size:.62rem;font-weight:600;color:var(--txm);
                      background:#fff;padding:2px 7px;border-radius:999px;
                      border:1px solid var(--bdr);letter-spacing:.02em}
    .diag-ml-corr-bar{height:5px;background:rgba(15,23,42,.06);border-radius:999px;
                      overflow:hidden;margin-bottom:5px}
    .diag-ml-corr-bar span{display:block;height:100%;border-radius:999px;transition:width .6s ease}
    .diag-ml-corr-bar.up span{background:linear-gradient(90deg,#10B981,#059669)}
    .diag-ml-corr-bar.down span{background:linear-gradient(90deg,#EF4444,#DC2626)}
    .diag-ml-corr-sub{font-size:.66rem;color:var(--txm);line-height:1.45}
    .diag-ml-corr-sub b{color:var(--tx);font-weight:700}

    .diag-ml-saz-bars{display:grid;grid-template-columns:repeat(12,1fr);gap:3px;
                      align-items:end;height:90px;padding:6px 4px 0;
                      border-bottom:1px dashed var(--bdr);margin-bottom:8px}
    .diag-ml-saz-bar{display:flex;flex-direction:column;align-items:center;height:100%;
                     justify-content:flex-end;position:relative;gap:3px;cursor:default}
    .diag-ml-saz-bar .diag-ml-saz-fill{width:70%;background:#CBD5E1;border-radius:3px 3px 0 0;
                                       transition:height .6s ease;min-height:4px}
    .diag-ml-saz-bar.up .diag-ml-saz-fill{background:linear-gradient(180deg,#10B981,#059669)}
    .diag-ml-saz-bar.down .diag-ml-saz-fill{background:linear-gradient(180deg,#EF4444,#DC2626)}
    .diag-ml-saz-bar small{font-size:.58rem;color:var(--txl);font-weight:600;
                           letter-spacing:.02em;text-transform:uppercase}
    .diag-ml-saz-txt{font-size:.7rem;color:var(--txm);line-height:1.5}
    .diag-ml-saz-txt b{color:var(--tx);font-weight:700}

    /* ══ MR KASH — IA conversacional do Diagnóstico ════ */
    .diag-mrcash{margin-top:20px;background:linear-gradient(135deg,#0F172A 0%,#1E293B 100%);
                 border-radius:16px;overflow:hidden;
                 box-shadow:0 4px 20px rgba(15,23,42,.12),0 1px 3px rgba(15,23,42,.06);
                 position:relative}
    .diag-mrcash::before{content:'';position:absolute;top:0;right:0;width:320px;height:220px;
                         background:radial-gradient(ellipse at top right,rgba(52,211,153,.14),transparent 60%);
                         pointer-events:none}
    .diag-mrcash-hd{display:flex;align-items:center;gap:14px;padding:18px 22px 16px;
                    border-bottom:1px solid rgba(255,255,255,.06);position:relative}
    .diag-mrcash-avatar{width:48px;height:48px;border-radius:14px;flex-shrink:0;
                        background:#FAFAF7;
                        display:flex;align-items:center;justify-content:center;
                        overflow:hidden;position:relative;
                        box-shadow:0 4px 12px rgba(0,0,0,.35),inset 0 0 0 1px rgba(255,255,255,.08)}
    .diag-mrcash-avatar svg{width:100%;height:100%;display:block}
    .diag-mrcash-avatar .diag-mrcash-img,
    .diag-mrcash-msg-avatar .diag-mrcash-img{width:100%;height:100%;object-fit:cover;display:block;user-select:none;-webkit-user-drag:none}
    .diag-mrcash-title{font-size:1.05rem;font-weight:800;color:#F8FAFC;
                       letter-spacing:.02em;margin:0;line-height:1.1;
                       display:flex;align-items:center;gap:8px}
    .diag-mrcash-status{width:8px;height:8px;border-radius:50%;background:#10B981;
                        box-shadow:0 0 8px rgba(16,185,129,.6);
                        animation:mrcashPulse 2s infinite}
    @keyframes mrcashPulse{0%,100%{opacity:1}50%{opacity:.5}}
    .diag-mrcash-sub{font-size:.72rem;color:#94A3B8;margin-top:3px;line-height:1.4}
    .diag-mrcash-body{padding:18px 22px;max-height:460px;overflow-y:auto;
                      display:flex;flex-direction:column;gap:14px;
                      background:linear-gradient(180deg,transparent 0%,rgba(15,23,42,.3) 100%)}
    .diag-mrcash-body::-webkit-scrollbar{width:6px}
    .diag-mrcash-body::-webkit-scrollbar-track{background:transparent}
    .diag-mrcash-body::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:3px}
    .diag-mrcash-msg{display:flex;gap:10px;max-width:100%;animation:mrcashSlide .25s ease-out}
    @keyframes mrcashSlide{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
    .diag-mrcash-msg.user{flex-direction:row-reverse}
    .diag-mrcash-msg-avatar{width:30px;height:30px;border-radius:9px;flex-shrink:0;
                            display:flex;align-items:center;justify-content:center;
                            overflow:hidden;font-size:.85rem;font-weight:800}
    .diag-mrcash-msg-avatar svg{width:100%;height:100%;display:block}
    .diag-mrcash-msg.bot .diag-mrcash-msg-avatar{
      background:#FAFAF7;
      color:#fff;
      box-shadow:0 2px 6px rgba(0,0,0,.25)}
    .diag-mrcash-msg.user .diag-mrcash-msg-avatar{
      background:linear-gradient(135deg,#3B82F6,#2563EB);color:#fff;
      box-shadow:0 2px 6px rgba(59,130,246,.3)}
    .diag-mrcash-bubble{padding:11px 15px;border-radius:14px;font-size:.82rem;
                        line-height:1.55;max-width:620px;word-wrap:break-word}
    .diag-mrcash-msg.bot .diag-mrcash-bubble{
      background:rgba(255,255,255,.05);color:#E2E8F0;
      border:1px solid rgba(255,255,255,.06);
      border-top-left-radius:4px}
    .diag-mrcash-msg.user .diag-mrcash-bubble{
      background:linear-gradient(135deg,#3B82F6,#2563EB);color:#fff;
      border-top-right-radius:4px}
    .diag-mrcash-bubble b{color:#F8FAFC;font-weight:700}
    .diag-mrcash-msg.bot .diag-mrcash-bubble b{color:#6EE7B7}
    .diag-mrcash-bubble em{color:#A5B4FC;font-style:normal;font-weight:600}
    .diag-mrcash-bubble ul{margin:6px 0 2px;padding-left:18px}
    .diag-mrcash-bubble li{margin:2px 0;line-height:1.5}
    .diag-mrcash-bubble code{background:rgba(148,163,184,.15);padding:1px 6px;border-radius:4px;
                             font-size:.75rem;font-family:ui-monospace,monospace;color:#FBBF24}
    .diag-mrcash-bubble small{display:block;margin-top:6px;font-size:.68rem;
                              color:#94A3B8;font-weight:500}
    /* === Override: numeros (.diag-num) dentro do chat (fundo escuro) === */
    .diag-mrcash-msg.bot .diag-mrcash-bubble .diag-num{
      background:rgba(167,139,250,.18);
      color:#FDE68A;
      border:1px solid rgba(253,230,138,.25);
      font-weight:700}
    .diag-mrcash-msg.bot .diag-mrcash-bubble .diag-num:hover{
      background:rgba(167,139,250,.30);
      box-shadow:0 0 0 2px rgba(253,230,138,.25)}
    .diag-mrcash-msg.bot .diag-mrcash-bubble .diag-num.diag-hi-pos{color:#86EFAC;border-color:rgba(134,239,172,.3)}
    .diag-mrcash-msg.bot .diag-mrcash-bubble .diag-num.diag-hi-neg{color:#FCA5A5;border-color:rgba(252,165,165,.3)}
    .diag-mrcash-msg.bot .diag-mrcash-bubble .diag-hi-pos{color:#86EFAC !important;font-weight:700}
    .diag-mrcash-msg.bot .diag-mrcash-bubble .diag-hi-neg{color:#FCA5A5 !important;font-weight:700}
    /* === Tabelas dentro do chat: cores legíveis em fundo escuro === */
    .diag-mrcash-msg.bot .diag-mrcash-bubble table{
      width:100%;border-collapse:collapse;font-size:.78rem;margin:6px 0}
    .diag-mrcash-msg.bot .diag-mrcash-bubble table thead tr{
      background:rgba(167,139,250,.18) !important;color:#E0E7FF !important}
    .diag-mrcash-msg.bot .diag-mrcash-bubble table th{
      padding:5px 8px !important;color:#E0E7FF !important;font-weight:700}
    .diag-mrcash-msg.bot .diag-mrcash-bubble table td{
      padding:4px 8px !important;border-top:1px solid rgba(255,255,255,.08) !important;
      color:#E2E8F0 !important}
    .diag-mrcash-msg.bot .diag-mrcash-bubble table td b,
    .diag-mrcash-msg.bot .diag-mrcash-bubble table th b{color:#FDE68A !important}
    /* === Caixa de risco com borda colorida === */
    .diag-mrcash-msg.bot .diag-mrcash-bubble div[style*="border-left"]{
      background:rgba(255,255,255,.04) !important;
      color:#E2E8F0 !important}
    .diag-mrcash-typing{display:inline-flex;gap:3px;padding:4px 2px}
    .diag-mrcash-typing span{width:6px;height:6px;border-radius:50%;background:#64748B;
                             animation:mrcashType 1.2s infinite}
    .diag-mrcash-typing span:nth-child(2){animation-delay:.15s}
    .diag-mrcash-typing span:nth-child(3){animation-delay:.3s}
    @keyframes mrcashType{0%,60%,100%{opacity:.3;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}
    .diag-mrcash-suggestions{display:flex;gap:8px;flex-wrap:wrap;
                             padding:4px 22px 14px;position:relative}
    .diag-mrcash-suggest{background:rgba(255,255,255,.05);
                         border:1px solid rgba(255,255,255,.08);
                         color:#CBD5E1;padding:7px 13px;border-radius:18px;
                         font-size:.72rem;font-weight:600;cursor:pointer;
                         transition:background .15s,border-color .15s,color .15s,transform .1s}
    .diag-mrcash-suggest:hover{background:rgba(16,185,129,.12);
                               border-color:rgba(16,185,129,.35);color:#6EE7B7}
    .diag-mrcash-suggest:active{transform:scale(.96)}
    .diag-mrcash-inputrow{display:flex;gap:10px;padding:14px 18px 16px;
                          background:rgba(15,23,42,.4);
                          border-top:1px solid rgba(255,255,255,.05);
                          position:relative}
    .diag-mrcash-input{flex:1;background:rgba(255,255,255,.06);
                       border:1px solid rgba(255,255,255,.08);
                       color:#F8FAFC;padding:11px 16px;border-radius:10px;
                       font-size:.82rem;outline:none;font-family:inherit;
                       transition:background .15s,border-color .15s;min-width:0}
    .diag-mrcash-input::placeholder{color:#64748B}
    .diag-mrcash-input:focus{background:rgba(255,255,255,.09);
                             border-color:rgba(16,185,129,.4)}
    .diag-mrcash-send{background:linear-gradient(135deg,#10B981 0%,#059669 100%);
                      color:#fff;border:none;padding:0 20px;border-radius:10px;
                      font-weight:700;font-size:.8rem;cursor:pointer;
                      box-shadow:0 2px 6px rgba(16,185,129,.3);
                      transition:transform .1s,box-shadow .15s;
                      display:flex;align-items:center;gap:6px;flex-shrink:0}
    .diag-mrcash-send:hover{box-shadow:0 4px 10px rgba(16,185,129,.4)}
    .diag-mrcash-send:active{transform:scale(.97)}
    .diag-mrcash-send:disabled{opacity:.4;cursor:not-allowed;box-shadow:none;transform:none}
    .diag-mrcash-send svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;
                          stroke-linecap:round;stroke-linejoin:round}

    /* ══ CONFIGURAÇÕES ═════════════════════════════════ */
    .cfg-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;
              margin-bottom:22px;flex-wrap:wrap}
    .cfg-head h1{font-size:1.55rem;font-weight:800;letter-spacing:-0.025em;color:var(--tx);margin:0 0 4px}
    .cfg-head p{color:var(--txm);font-size:.82rem;margin:0;max-width:580px;line-height:1.55}
    .cfg-section{background:var(--card);border:1px solid var(--bdr);border-radius:14px;
                 padding:22px 24px;margin-bottom:16px;
                 box-shadow:0 1px 3px rgba(15,23,42,.04),0 2px 10px rgba(15,23,42,.03)}
    .cfg-section-hd{display:flex;align-items:center;gap:12px;margin-bottom:6px}
    .cfg-section-ico{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;
                     justify-content:center;flex-shrink:0}
    .cfg-section-ico svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2;
                         stroke-linecap:round;stroke-linejoin:round}
    .cfg-section.perfil    .cfg-section-ico{background:#DBEAFE;color:#1D4ED8}
    .cfg-section.seguranca .cfg-section-ico{background:#E0E7FF;color:#4338CA}
    .cfg-section.logo      .cfg-section-ico{background:#FCE7F3;color:#BE185D}
    .cfg-section.destaque  .cfg-section-ico{background:#CCFBF1;color:#0F766E}
    .cfg-section.ferramentas .cfg-section-ico{background:#FEF3C7;color:#92400E}
    .cfg-section.dados     .cfg-section-ico{background:#D1FAE5;color:#047857}
    .cfg-section.storage   .cfg-section-ico{background:#EDE9FE;color:#6D28D9}
    .cfg-section.sobre     .cfg-section-ico{background:#FEF3C7;color:#B45309}
    .cfg-section.danger    .cfg-section-ico{background:#FEE2E2;color:#B91C1C}
    .cfg-section.indicadores .cfg-section-ico{background:#F3E8FF;color:#6D28D9}

    /* ── Configurador CAC dentro de Configurações ── */
    .cfg-cac-kpis{display:grid;grid-template-columns:repeat(3, 1fr);gap:10px;margin-bottom:16px}
    .cfg-cac-kpi{padding:12px 16px;background:#FAFBFC;border:1px solid var(--bdr);border-radius:8px}
    .cfg-cac-kpi-lbl{font-size:.62rem;font-weight:800;color:#6B7280;text-transform:uppercase;
      letter-spacing:.1em;font-family:Consolas,Menlo,monospace;margin-bottom:4px}
    .cfg-cac-kpi-val{font-size:1.2rem;font-weight:900;color:#0F172A;letter-spacing:-.02em;line-height:1.1}
    .cfg-cac-kpi-sub{font-size:.66rem;color:#94A3B8;margin-top:2px}
    .cfg-cac-kpi.is-result{background:linear-gradient(135deg, #5B21B6 0%, #6D28D9 100%);border-color:#5B21B6}
    .cfg-cac-kpi.is-result .cfg-cac-kpi-lbl{color:#DDD6FE}
    .cfg-cac-kpi.is-result .cfg-cac-kpi-val{color:#fff}
    .cfg-cac-kpi.is-result .cfg-cac-kpi-sub{color:#C4B5FD}

    .cfg-cac-period{display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:.78rem;color:#475569}
    .cfg-cac-period select{padding:5px 8px;border:1px solid var(--bdr);border-radius:5px;
      font-size:.74rem;font-family:inherit;background:#fff;cursor:pointer;font-weight:700}

    .cfg-cac-tags{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:6px;margin-bottom:6px}
    .cfg-cac-tag{display:flex;align-items:center;gap:8px;padding:8px 12px;border:1.5px solid #E5E7EB;
      border-radius:7px;cursor:pointer;background:#fff;transition:all .12s}
    .cfg-cac-tag:hover{border-color:#94A3B8;background:#FAFBFC}
    .cfg-cac-tag.is-checked{border-color:#6D28D9;background:#F5F3FF}
    .cfg-cac-tag input{margin:0;cursor:pointer;flex-shrink:0;width:14px;height:14px;accent-color:#6D28D9}
    .cfg-cac-tag-color{width:6px;height:14px;border-radius:2px;flex-shrink:0}
    .cfg-cac-tag-name{font-weight:700;font-size:.8rem;color:#0F172A;flex:1;min-width:0;
      overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .cfg-cac-tag-amt{font-size:.7rem;color:#6B7280;font-family:Consolas,Menlo,monospace;
      font-weight:700;flex-shrink:0}
    .cfg-cac-tag.is-checked .cfg-cac-tag-amt{color:#0F172A}
    .cfg-cac-empty{padding:14px;background:#FEF3C7;border-left:3px solid #F59E0B;border-radius:6px;
      font-size:.78rem;color:#92400E;line-height:1.4}

    /* CAC v2 — blocos por seção (Despesas / Pessoas) */
    .cfg-cac-block{margin-top:18px;border:1px solid var(--bdr);border-radius:10px;overflow:hidden;background:#fff}
    .cfg-cac-block-hd{padding:12px 14px;background:linear-gradient(180deg, #FAFBFC 0%, #F1F5F9 100%);
      border-bottom:1px solid var(--bdr);font-size:.86rem;font-weight:800;color:#0F172A;
      display:flex;align-items:center;gap:10px;letter-spacing:-.005em}
    .cfg-cac-block-hd small{font-weight:500;color:#6B7280;font-size:.72rem;letter-spacing:0}

    /* Grupo (tag de despesa ou tipo de pessoa) — colapsável */
    .cfg-cac-tag-grp{border-bottom:1px solid #F1F5F9}
    .cfg-cac-tag-grp:last-child{border-bottom:none}
    .cfg-cac-tag-grp-hd{padding:10px 14px;display:flex;align-items:center;gap:10px;cursor:pointer;
      background:#fff;transition:background .12s}
    .cfg-cac-tag-grp-hd:hover{background:#FAFBFC}
    .cfg-cac-tag-grp.is-open .cfg-cac-tag-grp-hd{background:#F1F5F9}
    .cfg-cac-tag-grp-name{font-weight:800;font-size:.86rem;color:#0F172A;flex-shrink:0;min-width:120px}
    .cfg-cac-tag-grp-meta{flex:1;font-size:.72rem;color:#6B7280;font-family:Consolas,Menlo,monospace;letter-spacing:.02em}
    .cfg-cac-tag-grp-meta strong{color:#6D28D9}
    .cfg-cac-grp-chev{color:#94A3B8;font-size:.8rem;transition:transform .15s;flex-shrink:0}
    .cfg-cac-tag-grp.is-open .cfg-cac-grp-chev{transform:rotate(90deg)}
    .cfg-cac-tag-grp-bd{display:none;background:#FAFBFC;padding:4px 14px 12px}
    .cfg-cac-tag-grp.is-open .cfg-cac-tag-grp-bd{display:block}

    .cfg-cac-quick{padding:3px 8px;background:#fff;border:1px solid #CBD5E1;border-radius:4px;
      font-size:.66rem;font-weight:800;color:#475569;cursor:pointer;font-family:Consolas,Menlo,monospace;
      letter-spacing:.02em;transition:all .1s;flex-shrink:0}
    .cfg-cac-quick:hover{background:#0F172A;color:#fff;border-color:#0F172A}
    .cfg-cac-absorvido{padding:3px 9px;background:#F1F5F9;color:#94A3B8;font-size:.66rem;font-weight:800;
      border-radius:4px;font-family:Consolas,Menlo,monospace;letter-spacing:.04em;text-transform:uppercase;
      flex-shrink:0;white-space:nowrap;border:1px solid #E2E8F0}
    .cfg-cac-absorvido.is-on{background:#5B21B6;color:#fff;border-color:#5B21B6;
      box-shadow:0 1px 3px rgba(91,33,182,.3)}

    /* Linha de item (despesa individual ou pessoa) */
    .cfg-cac-item{display:grid;grid-template-columns:1fr 110px 70px 18px 100px;gap:10px;align-items:center;
      padding:6px 0;font-size:.82rem;border-bottom:1px solid rgba(15,23,42,.04)}
    .cfg-cac-item:last-child{border-bottom:none}
    .cfg-cac-item-name{font-weight:600;color:#1F2937;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .cfg-cac-item-amt{font-family:Consolas,Menlo,monospace;font-size:.74rem;color:#6B7280;text-align:right;font-weight:700}
    .cfg-cac-item-pct{padding:4px 8px;border:1px solid #CBD5E1;border-radius:4px;font-size:.78rem;
      font-family:Consolas,Menlo,monospace;font-weight:700;text-align:center;outline:none;background:#fff}
    .cfg-cac-item-pct:focus{border-color:#6D28D9;box-shadow:0 0 0 2px rgba(109,40,217,.15)}
    .cfg-cac-item-pctlbl{font-size:.7rem;color:#94A3B8;font-family:Consolas,Menlo,monospace;font-weight:700}
    .cfg-cac-item-result{font-family:Consolas,Menlo,monospace;font-size:.74rem;color:#94A3B8;text-align:right;font-weight:700}
    .cfg-cac-item.is-active .cfg-cac-item-result{color:#6D28D9;font-weight:800}
    .cfg-cac-item.is-expanded{background:#F5F3FF;border-radius:8px;padding:8px 10px}

    .cfg-cac-cal-btn{position:relative;width:28px;height:28px;border:1px solid #CBD5E1;border-radius:5px;
      background:#fff;cursor:pointer;font-size:.95rem;display:flex;align-items:center;justify-content:center;
      transition:all .12s;flex-shrink:0;padding:0}
    .cfg-cac-cal-btn:hover{background:#F1F5F9;border-color:#94A3B8}
    .cfg-cac-cal-btn.is-active{background:#5B21B6;border-color:#5B21B6;color:#fff}
    .cfg-cac-cal-btn.has-overrides{border-color:#F59E0B}
    .cfg-cac-cal-badge{position:absolute;top:-5px;right:-5px;background:#F59E0B;color:#fff;
      font-size:.55rem;font-weight:800;font-family:Consolas,Menlo,monospace;border-radius:8px;
      min-width:14px;height:14px;display:flex;align-items:center;justify-content:center;padding:0 3px;
      box-shadow:0 1px 2px rgba(0,0,0,.15)}
    .cfg-cac-item.is-expanded{grid-column:1 / -1}
    .cfg-cac-item.is-expanded{display:grid}

    /* Grid de overrides expandido */
    .cfg-cac-ov-grid{grid-column:1 / -1;background:#fff;border:1px solid #E2E8F0;border-radius:8px;
      padding:12px;margin-top:6px}
    .cfg-cac-ov-hint{font-size:.7rem;color:#6B7280;margin-bottom:10px;line-height:1.4}
    .cfg-cac-ov-months{display:grid;grid-template-columns:repeat(12, 1fr);gap:6px;margin-bottom:10px}
    @media (max-width: 1100px){ .cfg-cac-ov-months{grid-template-columns:repeat(6, 1fr)} }
    @media (max-width: 600px){ .cfg-cac-ov-months{grid-template-columns:repeat(3, 1fr)} }
    .cfg-cac-ov-month{display:flex;flex-direction:column;gap:3px;align-items:center}
    .cfg-cac-ov-lbl{font-size:.6rem;font-weight:800;color:#94A3B8;font-family:Consolas,Menlo,monospace;letter-spacing:.04em}
    .cfg-cac-ov-month input{width:100%;padding:5px 4px;border:1px solid #E2E8F0;border-radius:4px;
      font-size:.75rem;font-family:Consolas,Menlo,monospace;font-weight:700;text-align:center;outline:none;
      background:#FAFBFC;color:#1F2937}
    .cfg-cac-ov-month input::placeholder{color:#CBD5E1;font-weight:500}
    .cfg-cac-ov-month input:focus{border-color:#6D28D9;background:#fff;box-shadow:0 0 0 2px rgba(109,40,217,.15)}
    .cfg-cac-ov-month.is-current input{border-color:#0F172A;background:#fff}
    .cfg-cac-ov-month.is-current .cfg-cac-ov-lbl{color:#0F172A}
    .cfg-cac-ov-month.is-open input{background:#F1F5F9;color:#94A3B8;font-style:italic;cursor:not-allowed}
    .cfg-cac-ov-month.is-closed input{background:#FEF3C7;border-color:#F59E0B;color:#92400E;font-weight:800}
    .cfg-cac-ov-lock{margin-top:3px;width:100%;padding:3px 0;border:1px solid #CBD5E1;border-radius:4px;
      background:#fff;cursor:pointer;font-size:.78rem;transition:all .12s;line-height:1}
    .cfg-cac-ov-lock:hover{background:#F1F5F9;border-color:#94A3B8}
    .cfg-cac-ov-month.is-closed .cfg-cac-ov-lock{background:#F59E0B;border-color:#F59E0B;color:#fff}
    .cfg-cac-ov-month.is-closed .cfg-cac-ov-lock:hover{background:#D97706;border-color:#D97706}
    .cfg-cac-ov-legend{display:inline-flex;align-items:center;gap:6px;margin-right:14px;font-size:.7rem}
    .cfg-cac-ov-legend .dot{width:10px;height:10px;border-radius:50%;display:inline-block;flex-shrink:0}
    .cfg-cac-ov-legend .dot.dot-open{background:#CBD5E1}
    .cfg-cac-ov-legend .dot.dot-closed{background:#F59E0B}
    .cfg-cac-item-pct.is-closed{background:#FEF3C7;border-color:#F59E0B;color:#92400E;font-weight:800}
    .cfg-cac-ov-actions{display:flex;justify-content:flex-end;padding-top:8px;border-top:1px solid #F1F5F9}

    /* Linha do item expandida vira grid 2 linhas */
    .cfg-cac-item{grid-template-columns:1fr 110px 70px 18px 100px 32px}
    .cfg-cac-item.is-expanded > .cfg-cac-ov-grid{grid-column:1 / -1;margin-top:8px}
    .cfg-cac-item.is-inativo{opacity:.55;background:repeating-linear-gradient(45deg, rgba(220,38,38,.025) 0 6px, transparent 6px 12px)}

    /* Ferramentas — linha com toggle para ativar/desativar utilitários */
    .cfg-tool-row{display:flex;align-items:center;gap:14px;padding:14px 16px;
                  border:1px solid var(--bdr);border-radius:12px;background:#fff;
                  transition:background .12s,border-color .12s,box-shadow .12s}
    .cfg-tool-row:hover{background:#FFFBEB;border-color:#FBBF24}
    .cfg-tool-row.off{background:#F8FAFC;border-color:#E2E8F0}
    .cfg-tool-row.off:hover{background:#F1F5F9;border-color:#CBD5E1}
    .cfg-tool-ico{width:46px;height:46px;flex-shrink:0;border-radius:12px;display:flex;
                  align-items:center;justify-content:center;
                  background:linear-gradient(145deg,#1a1a1a 0%,#2d2d2d 100%);
                  box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 2px 4px rgba(0,0,0,.2);
                  flex-direction:column;gap:0;line-height:1}
    .cfg-tool-ico-hp{font-size:.7rem;font-weight:900;color:#F59E0B;letter-spacing:-.04em;
                     font-family:'Inter',system-ui,sans-serif;line-height:1;
                     text-transform:lowercase}
    .cfg-tool-ico-num{font-size:.72rem;font-weight:900;color:#eaeaea;letter-spacing:-.03em;
                      line-height:1;font-family:'Inter',system-ui,sans-serif}
    .cfg-tool-row.off .cfg-tool-ico{filter:grayscale(.8) brightness(.9)}
    /* Conversor de Taxas: ícone de setas opostas em violeta */
    .cfg-tool-ico.cfg-tool-ico-rate{background:linear-gradient(135deg,#4338CA 0%,#6366F1 100%)}
    .cfg-tool-ico.cfg-tool-ico-rate svg{width:24px;height:24px;color:#fff;stroke:currentColor;
                                         filter:drop-shadow(0 1px 2px rgba(0,0,0,.2))}
    .cfg-tool-body{flex:1;min-width:0}
    .cfg-tool-ttl{font-size:.92rem;font-weight:700;color:var(--tx);letter-spacing:-.005em;
                  display:flex;align-items:center;gap:8px}
    .cfg-tool-badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:999px;
                    font-size:.66rem;font-weight:700;letter-spacing:.02em;text-transform:uppercase}
    .cfg-tool-badge.on{background:#DCFCE7;color:#166534}
    .cfg-tool-badge.off{background:#F1F5F9;color:#64748B}
    .cfg-tool-desc{font-size:.78rem;color:var(--txm);margin-top:4px;line-height:1.45}

    /* ════ Módulo VIAGENS — Prestação de Contas ════ */
    .viag-wrap{padding:14px 0}
    .viag-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:18px;padding:14px 18px;
      background:linear-gradient(180deg, #FAFBFC 0%, #F1F5F9 100%);border:1px solid var(--bdr);border-radius:10px}
    .viag-search{flex:1;min-width:180px;max-width:260px;padding:8px 12px;border:1px solid var(--bdr);border-radius:6px;font-size:.86rem;
      font-family:inherit;background:#fff;outline:none;max-width:340px}
    .viag-search:focus{border-color:#0F766E;box-shadow:0 0 0 3px rgba(15,118,110,.1)}
    .viag-filter{display:flex;gap:6px;flex-wrap:wrap}
    .viag-filter button{padding:6px 12px;border:1px solid var(--bdr);background:#fff;border-radius:6px;
      font-size:.74rem;font-weight:700;color:#475569;cursor:pointer;font-family:inherit;transition:all .12s}
    .viag-filter button:hover{border-color:#94A3B8;background:#FAFBFC}
    .viag-filter button.active{background:#0F766E;border-color:#0F766E;color:#fff}
    .viag-new-btn{margin-left:auto;padding:9px 18px;background:#0F766E;color:#fff;border:none;border-radius:6px;
      font-size:.84rem;font-weight:700;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:6px;transition:all .12s}
    .viag-new-btn:hover{background:#0E6B65;transform:translateY(-1px);box-shadow:0 4px 12px rgba(15,118,110,.25)}

    /* KPIs do dashboard de viagens */
    .viag-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
    @media (max-width:900px){ .viag-kpi-row{grid-template-columns:repeat(2,1fr)} }
    .viag-kpi{padding:14px 18px;background:#fff;border:1px solid var(--bdr);border-radius:10px}
    .viag-kpi-lbl{font-size:.66rem;font-weight:800;color:var(--txm);text-transform:uppercase;
      letter-spacing:.1em;font-family:Consolas,Menlo,monospace;margin-bottom:4px}
    .viag-kpi-val{font-size:1.5rem;font-weight:900;color:var(--txd);letter-spacing:-.02em;line-height:1.1}
    .viag-kpi-sub{font-size:.7rem;color:var(--txm);margin-top:3px}
    .viag-kpi.hl{background:linear-gradient(135deg,#0F766E 0%,#0D9488 100%);border-color:#0F766E}
    .viag-kpi.hl .viag-kpi-lbl{color:#A7F3D0}
    .viag-kpi.hl .viag-kpi-val{color:#fff}
    .viag-kpi.hl .viag-kpi-sub{color:#CCFBF1}

    /* Grid de relatórios */
    .viag-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px}
    .viag-card{background:#fff;border:1px solid var(--bdr);border-radius:12px;padding:16px;
      cursor:pointer;transition:all .14s;position:relative;display:flex;flex-direction:column;gap:10px}
    .viag-card:hover{border-color:#0F766E;box-shadow:0 4px 14px rgba(15,118,110,.1);transform:translateY(-2px)}

    /* ── KANBAN ── */
    .viag-kanban{display:grid;grid-template-columns:repeat(5, minmax(220px, 1fr));gap:12px;align-items:start;
      overflow-x:auto;padding-bottom:14px}
    @media (max-width:1200px){ .viag-kanban{grid-template-columns:repeat(5, 240px)} }
    .viag-kb-col{background:#F8FAFC;border:1px solid var(--bdr);border-radius:10px;display:flex;
      flex-direction:column;min-height:200px;transition:all .12s}
    .viag-kb-col.is-drop{background:#ECFDF5;border-color:#0F766E;border-style:dashed;border-width:2px}
    .viag-kb-col-hd{padding:10px 14px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;
      justify-content:space-between;border-radius:10px 10px 0 0;font-weight:800;font-size:.74rem;
      letter-spacing:.04em;text-transform:uppercase;font-family:Consolas,Menlo,monospace}
    .viag-kb-col-rascunho   {background:#F1F5F9;color:#475569}
    .viag-kb-col-enviado    {background:#DBEAFE;color:#1E40AF}
    .viag-kb-col-aprovado   {background:#D1FAE5;color:#047857}
    .viag-kb-col-reembolsado{background:#E9D5FF;color:#6B21A8}
    .viag-kb-col-rejeitado  {background:#FEE2E2;color:#B91C1C}
    .viag-kb-col-count{padding:2px 8px;background:rgba(255,255,255,.6);border-radius:10px;
      font-size:.7rem;font-family:Consolas,Menlo,monospace;font-weight:800;color:inherit;letter-spacing:.04em}
    .viag-kb-col-bd{padding:10px;display:flex;flex-direction:column;gap:8px;flex:1;min-height:60px}
    .viag-kb-empty{padding:20px;text-align:center;color:#CBD5E1;font-style:italic;font-size:.78rem}

    .viag-kb-card{background:#fff;border:1px solid var(--bdr);border-radius:8px;padding:11px 13px;
      cursor:grab;transition:all .12s;display:flex;flex-direction:column;gap:6px;
      box-shadow:0 1px 2px rgba(15,23,42,.04)}
    .viag-kb-card:hover{border-color:#0F766E;box-shadow:0 4px 10px rgba(15,118,110,.15);transform:translateY(-1px)}
    .viag-kb-card:active{cursor:grabbing}
    .viag-kb-card-name{font-weight:800;color:#0F172A;font-size:.86rem;letter-spacing:-.01em;line-height:1.3}
    .viag-kb-card-meta{display:flex;flex-direction:column;gap:2px;font-size:.7rem;color:var(--txm);font-family:Consolas,Menlo,monospace;letter-spacing:.02em}
    .viag-kb-card-foot{display:flex;gap:10px;padding-top:6px;border-top:1px solid #F1F5F9;justify-content:space-between}
    .viag-kb-card-tot{display:flex;flex-direction:column;gap:1px}
    .viag-kb-card-tot .lbl{font-size:.6rem;font-weight:700;color:var(--txl);text-transform:uppercase;letter-spacing:.06em;font-family:Consolas,Menlo,monospace}
    .viag-kb-card-tot .val{font-weight:800;color:#0F172A;font-size:.84rem;font-family:Consolas,Menlo,monospace}
    .viag-kb-card-tot .val.bal-pos{color:#047857}
    .viag-kb-card-tot .val.bal-neg{color:#DC2626}
    .viag-kb-card-split{display:flex;gap:8px;font-size:.62rem;font-family:Consolas,Menlo,monospace;font-weight:700;letter-spacing:.04em;padding-top:4px;border-top:1px dashed #F1F5F9}

    /* Selo de assinatura no card kanban */
    .viag-kb-card-sig{display:inline-flex;align-items:center;gap:4px;padding:2px 7px;background:#F0FDF4;color:#047857;
      border:1px solid #6EE7B7;border-radius:4px;font-size:.62rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
      font-family:Consolas,Menlo,monospace;margin-top:4px;align-self:flex-start}

    /* Toggle assinatura no toolbar */
    .viag-sig-toggle{display:inline-flex;align-items:center;gap:6px;padding:5px 11px;background:#fff;
      border:1px solid var(--bdr);border-radius:6px;font-size:.74rem;font-weight:700;cursor:pointer;color:#475569;
      transition:all .12s;margin-left:auto;font-family:inherit}
    .viag-sig-toggle:hover{border-color:#7C3AED;color:#5B21B6}
    .viag-sig-toggle input{margin:0;cursor:pointer;accent-color:#7C3AED;width:14px;height:14px}
    .viag-sig-toggle input:checked + span{color:#5B21B6}
    .viag-sig-toggle:has(input:checked){background:#F5F3FF;border-color:#7C3AED}
    /* Engrenagem do Kanban (opções) */
    .viag-gear-wrap{position:relative;display:inline-block}
    .viag-gear-btn{display:inline-flex;align-items:center;justify-content:center;
      padding:5px;background:#fff;border:1px solid #E2E8F0;border-radius:6px;
      cursor:pointer;line-height:1;color:#475569;transition:all .12s;font-family:inherit}
    .viag-gear-btn svg{display:block;transition:transform .25s ease}
    .viag-gear-btn:hover svg{transform:rotate(35deg)}
    .viag-gear-btn.is-open svg{transform:rotate(60deg)}
    /* Avatar do colaborador no card do kanban */
    .viag-kb-colab{display:inline-flex;align-items:center;gap:5px;line-height:1.1}
    .viag-kb-ava{width:16px;height:16px;border-radius:50%;object-fit:cover;border:1px solid #E5E7EB;flex-shrink:0}
    .viag-kb-ava-fb{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;flex-shrink:0;font-size:.85rem;line-height:1}
    .viag-gear-btn:hover{background:#F8FAFC;border-color:#7C3AED;color:#5B21B6}
    .viag-gear-btn.is-open{background:#F5F3FF;border-color:#7C3AED;color:#5B21B6}
    .viag-gear-menu{position:absolute;top:calc(100% + 6px);right:0;z-index:1000;
      background:#fff;border:1px solid #E2E8F0;border-radius:8px;
      box-shadow:0 6px 20px rgba(15,23,42,.08);min-width:240px;padding:6px}
    .viag-gear-menu[hidden]{display:none}
    .viag-gear-item{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:5px;
      cursor:pointer;font-size:.82rem;color:#1E293B;user-select:none}
    .viag-gear-item:hover{background:#F8FAFC}
    .viag-gear-item input[type=checkbox]{margin:0;cursor:pointer;accent-color:#7C3AED;width:14px;height:14px}
    .viag-gear-item.is-action{color:#5B21B6;font-weight:500;border-top:1px solid #E2E8F0;margin-top:4px;padding-top:10px}
    .viag-gear-sep{height:1px;background:#E2E8F0;margin:4px 0}
    /* Modal de editar nomes de coluna */
    .viag-cols-modal-ov{position:fixed;inset:0;background:rgba(15,23,42,.5);z-index:99999;
      display:flex;align-items:center;justify-content:center;padding:20px}
    .viag-cols-modal{background:#fff;border-radius:12px;width:min(440px,96vw);max-height:92vh;overflow:auto}
    .viag-cols-modal-hd{padding:16px 20px;border-bottom:1px solid #E2E8F0;display:flex;align-items:center;gap:10px}
    .viag-cols-modal-hd h3{margin:0;font-size:1rem;color:#1E293B}
    .viag-cols-modal-bd{padding:14px 20px}
    .viag-cols-modal-row{margin-bottom:12px}
    .viag-cols-modal-row label{display:block;font-size:.74rem;font-weight:600;color:#64748B;margin-bottom:4px}
    .viag-cols-modal-row input{width:100%;padding:7px 10px;border:1px solid #CBD5E1;border-radius:6px;
      font-size:.85rem;font-family:inherit;box-sizing:border-box}
    .viag-cols-modal-row input:focus{outline:none;border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.15)}
    .viag-cols-modal-foot{padding:12px 20px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:8px}
    .viag-cols-modal-foot button{padding:7px 14px;border-radius:6px;border:1px solid;cursor:pointer;font-size:.82rem;font-weight:500;font-family:inherit}
    .viag-cols-modal-foot .btn-cancel{background:#fff;border-color:#CBD5E1;color:#475569}
    .viag-cols-modal-foot .btn-cancel:hover{background:#F8FAFC}
    .viag-cols-modal-foot .btn-save{background:#7C3AED;border-color:#7C3AED;color:#fff}
    .viag-cols-modal-foot .btn-save:hover{background:#6D28D9}
    .viag-cols-modal-foot .btn-reset{background:#fff;border-color:#CBD5E1;color:#475569;margin-right:auto}
    .viag-cols-modal-foot .btn-reset:hover{background:#F8FAFC;color:#1E293B}

    /* Modal aprovação */
    .viag-approval-modal{position:fixed;inset:0;background:rgba(15,23,42,.6);backdrop-filter:blur(4px);
      display:flex;align-items:center;justify-content:center;z-index:99999;padding:20px}
    .viag-approval-card{background:#fff;border-radius:14px;width:min(620px,96vw);max-height:92vh;
      display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(15,23,42,.4)}
    .viag-approval-hd{padding:18px 22px;background:linear-gradient(135deg,#5B21B6 0%,#7C3AED 100%);
      color:#fff;display:flex;align-items:flex-start;gap:14px}
    .viag-approval-hd h2{margin:0;font-size:1.1rem;font-weight:800;letter-spacing:-.01em}
    .viag-approval-hd p{margin:2px 0 0;font-size:.74rem;opacity:.85}
    .viag-approval-x{margin-left:auto;background:transparent;border:none;color:#fff;font-size:1.4rem;
      cursor:pointer;padding:0 8px;opacity:.8;line-height:1}
    .viag-approval-bd{padding:18px 22px;overflow:auto;flex:1}
    .viag-approval-summary{background:#FAFBFC;border:1px solid var(--bdr);border-radius:8px;padding:12px 14px;margin-bottom:18px}
    .viag-approval-summary-row{display:flex;justify-content:space-between;align-items:center;padding:4px 0;
      border-bottom:1px solid #F1F5F9;font-size:.82rem}
    .viag-approval-summary-row:last-child{border-bottom:none}
    .viag-approval-summary-row .lbl{color:var(--txm);font-weight:600;font-size:.74rem;text-transform:uppercase;letter-spacing:.06em;font-family:Consolas,Menlo,monospace}
    .viag-approval-summary-row .val{color:var(--txd);font-weight:700}
    .viag-approval-field{margin-bottom:14px}
    .viag-approval-field label{display:block;font-size:.66rem;font-weight:800;color:var(--txm);text-transform:uppercase;
      letter-spacing:.08em;font-family:Consolas,Menlo,monospace;margin-bottom:6px}
    .viag-approval-field select, .viag-approval-field input{width:100%;padding:8px 10px;border:1px solid var(--bdr);
      border-radius:6px;font-size:.86rem;font-family:inherit;background:#fff;outline:none;color:var(--txd);box-sizing:border-box}
    .viag-approval-field select:focus, .viag-approval-field input:focus{border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.1)}
    #viag-appr-canvas{width:100%;height:160px;border:1.5px dashed #C4B5FD;border-radius:8px;background:#FAFBFC;
      cursor:crosshair;display:block;touch-action:none}
    .viag-approval-foot{padding:14px 22px;background:#FAFBFC;border-top:1px solid #E5E7EB;
      display:flex;gap:8px;justify-content:flex-end}
    .viag-approval-foot button{padding:9px 22px;border-radius:6px;font-size:.86rem;font-weight:700;cursor:pointer;font-family:inherit}
    .viag-approval-foot .btn-cancel{background:#fff;color:#475569;border:1px solid #CBD5E1}
    .viag-approval-foot .btn-cancel:hover{background:#F1F5F9}
    .viag-approval-foot .btn-approve{background:#5B21B6;color:#fff;border:none}
    .viag-approval-foot .btn-approve:hover{background:#6D28D9}

    /* Visualização da aprovação no editor */
    .viag-approved-box{background:linear-gradient(135deg,#F0FDF4 0%,#ECFDF5 100%);border:1px solid #6EE7B7;
      border-radius:10px;padding:14px 18px;margin-top:14px;display:flex;align-items:center;gap:14px}
    .viag-approved-box-icon{font-size:1.6rem;flex-shrink:0}
    .viag-approved-box-text{flex:1;min-width:0}
    .viag-approved-box-text strong{color:#047857;font-weight:800;display:block;font-size:.92rem;letter-spacing:-.005em}
    .viag-approved-box-text small{color:#065F46;font-size:.74rem;font-family:Consolas,Menlo,monospace;letter-spacing:.02em}
    .viag-approved-box-sig{max-height:60px;max-width:160px;border:1px solid #6EE7B7;border-radius:5px;background:#fff;flex-shrink:0}
    .viag-appr-codigo{display:inline-block;padding:2px 7px;background:#fff;border:1px solid #6EE7B7;
      border-radius:4px;font-family:Consolas,Menlo,monospace;font-weight:800;color:#047857;letter-spacing:.06em;
      font-size:.7rem;margin:0 4px}
    .viag-appr-verify{margin-left:6px;padding:2px 9px;background:#fff;border:1px solid #6EE7B7;border-radius:4px;
      font-size:.7rem;font-weight:700;color:#047857;cursor:pointer;font-family:inherit;transition:all .12s}
    .viag-appr-verify:hover{background:#D1FAE5;border-color:#047857}
    .viag-rej-codigo{display:inline-block;padding:2px 7px;background:#fff;border:1px solid #FCA5A5;
      border-radius:4px;font-family:Consolas,Menlo,monospace;font-weight:800;color:#991B1B;letter-spacing:.06em;
      font-size:.7rem;margin:0 4px}
    .viag-rej-verify{margin-left:6px;padding:2px 9px;background:#fff;border:1px solid #FCA5A5;border-radius:4px;
      font-size:.7rem;font-weight:700;color:#991B1B;cursor:pointer;font-family:inherit;transition:all .12s}
    .viag-rej-verify:hover{background:#FEE2E2;border-color:#991B1B}
    /* Canvas vermelho pro modal de rejeição */
    #viag-reject-canvas{width:100%;height:140px;border:1.5px dashed #FCA5A5;border-radius:8px;background:#FAFBFC;
      cursor:crosshair;display:block;touch-action:none}

    /* Box de rejeição (estilo similar ao approved-box mas vermelho) */
    .viag-rejected-box{background:linear-gradient(135deg,#FEF2F2 0%,#FEE2E2 100%);border:1px solid #FCA5A5;
      border-radius:10px;padding:14px 18px;margin-top:10px;display:flex;align-items:flex-start;gap:14px}
    .viag-rejected-box .viag-approved-box-text strong{color:#991B1B}
    .viag-rejected-box .viag-approved-box-text small{color:#7F1D1D}
    .viag-rejected-motivo{margin-top:8px;padding:10px 12px;background:#fff;border:1px solid #FCA5A5;border-radius:6px;
      font-size:.84rem;color:#7F1D1D;line-height:1.45;white-space:pre-wrap}

    /* Selo de rejeição no card kanban */
    .viag-kb-card-rej{padding:5px 8px;background:#FEF2F2;color:#B91C1C;border:1px solid #FCA5A5;border-radius:4px;
      font-size:.66rem;font-weight:600;line-height:1.3;margin-top:4px;font-style:italic;letter-spacing:.01em}

    /* Toggle de visualização Kanban/Tabela */
    .viag-view-toggle{display:inline-flex;border:1px solid var(--bdr);border-radius:8px;overflow:hidden;
      background:#fff;margin-bottom:10px}
    .viag-view-toggle button{padding:8px 18px;background:transparent;border:none;cursor:pointer;
      font-size:.82rem;font-weight:700;color:#64748B;font-family:inherit;border-right:1px solid var(--bdr);
      transition:all .12s;display:inline-flex;align-items:center;gap:6px}
    .viag-view-toggle button:last-child{border-right:none}
    .viag-view-toggle button:hover{background:#F1F5F9;color:#1F2937}
    .viag-view-toggle button.is-active{background:#0F172A;color:#fff}

    /* Tabela */
    .viag-table-wrap{overflow-x:auto;background:#fff;border:1px solid var(--bdr);border-radius:10px}
    .viag-table{width:100%;border-collapse:separate;border-spacing:0;min-width:900px;font-size:.84rem}
    .viag-table th{padding:11px 14px;background:linear-gradient(180deg,#FAFBFC 0%,#F1F5F9 100%);
      border-bottom:1px solid var(--bdr);font-weight:800;color:#475569;font-size:.7rem;
      text-transform:uppercase;letter-spacing:.08em;font-family:Consolas,Menlo,monospace;text-align:left;
      cursor:pointer;user-select:none;position:sticky;top:0;z-index:1;transition:background .12s}
    .viag-table th:hover{background:linear-gradient(180deg,#F1F5F9 0%,#E2E8F0 100%);color:#1F2937}
    .viag-table th.is-sorted{background:#0F172A;color:#fff}
    .viag-table th.right{text-align:right}
    .viag-table td{padding:10px 14px;border-bottom:1px solid #F1F5F9;color:#1F2937;vertical-align:middle}
    .viag-table tbody tr{cursor:pointer;transition:background .1s}
    .viag-table tbody tr:hover{background:#F8FAFC}
    .viag-table tbody tr:last-child td{border-bottom:none}
    .viag-table td.bold{font-weight:800;color:#0F172A}
    .viag-table td.mono{font-family:Consolas,Menlo,monospace;font-size:.78rem;font-weight:700;color:#475569}
    .viag-table td.right{text-align:right}
    .viag-table td.pos{color:#047857}
    .viag-table td.neg{color:#DC2626}
    .viag-table td .viag-status{font-size:.62rem;padding:3px 8px}
    .viag-table td .viag-kb-age{font-size:.62rem;padding:2px 6px}
    .viag-tbl-sig-mini{display:inline-flex;width:24px;height:24px;align-items:center;justify-content:center;
      border-radius:4px;font-size:.95rem;cursor:help}
    .viag-tbl-sig-mini.ok{background:#D1FAE5;border:1px solid #6EE7B7}
    .viag-tbl-sig-mini.bad{background:#FEE2E2;border:1px solid #FCA5A5}

    /* ── Dashboard Viagens ── */
    .viag-dash{display:flex;flex-direction:column;gap:14px}
    .viag-dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media (max-width:900px){ .viag-dash-grid{grid-template-columns:1fr} }
    .viag-dash-card{background:#fff;border:1px solid var(--bdr);border-radius:10px;padding:16px}
    .viag-dash-card h3{margin:0 0 12px;font-size:13px;font-weight:600;color:#0F172A;letter-spacing:0.2px}
    /* KPIs */
    .viag-dash-kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
    @media (max-width:1100px){ .viag-dash-kpis{grid-template-columns:repeat(3,1fr)} }
    @media (max-width:560px){ .viag-dash-kpis{grid-template-columns:repeat(2,1fr)} }
    .viag-dash-kpi{background:#fff;border:1px solid var(--bdr);border-radius:10px;padding:14px 14px 12px;
      display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden}
    .viag-dash-kpi::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:#9CA3AF}
    .viag-dash-kpi-success{background:#F0FDF4}
    .viag-dash-kpi-success::before{background:#16A34A}
    .viag-dash-kpi-warn{background:#FFFBEB}
    .viag-dash-kpi-warn::before{background:#D97706}
    .viag-dash-kpi-info{background:#EFF6FF}
    .viag-dash-kpi-info::before{background:#2563EB}
    .viag-dash-kpi-danger{background:#FEF2F2}
    .viag-dash-kpi-danger::before{background:#DC2626}
    .viag-dash-kpi-ico{font-size:14px;opacity:.8}
    .viag-dash-kpi-val{font-size:24px;font-weight:700;color:#0F172A;line-height:1.1;letter-spacing:-0.01em}
    .viag-dash-kpi-lbl{font-size:11px;color:#475569;font-weight:600;letter-spacing:0.2px;display:flex;flex-direction:column;gap:1px}
    .viag-dash-kpi-lbl small{font-size:10px;color:#94A3B8;font-weight:500;letter-spacing:0;text-transform:none}
    /* Bar rows */
    .viag-dash-bar-row{display:grid;grid-template-columns:140px 1fr 96px;gap:10px;align-items:center;padding:5px 0;font-size:12px}
    .viag-dash-bar-lbl{color:#475569;font-weight:500;display:inline-flex;align-items:center;gap:6px;
      overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .viag-dash-bar-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;display:inline-block}
    .viag-dash-bar-track{height:8px;background:#F3F4F6;border-radius:4px;overflow:hidden}
    .viag-dash-bar-fill{height:100%;border-radius:4px;background:#9CA3AF;transition:width .3s}
    .viag-dash-bar-val{font-weight:700;color:#0F172A;text-align:right;font-size:12px}
    .viag-dash-bar-val small{color:#94A3B8;font-weight:500;font-size:10px}
    .viag-dash-empty{color:#94A3B8;font-size:12px;font-style:italic;text-align:center;padding:14px 0}
    /* Split bar (Empresa vs Funcionário) */
    .viag-dash-split{display:flex;flex-direction:column;gap:10px}
    .viag-dash-split-bar{display:flex;height:24px;border-radius:6px;overflow:hidden;background:#F3F4F6}
    .viag-dash-split-emp{background:#0F766E;height:100%;transition:width .3s}
    .viag-dash-split-func{background:#7C3AED;height:100%;transition:width .3s}
    .viag-dash-split-legend{display:flex;flex-direction:column;gap:6px}
    .viag-dash-split-leg-item{display:flex;align-items:center;gap:8px;font-size:12px;color:#475569}
    .viag-dash-split-leg-item .dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}
    .viag-dash-split-leg-item .lbl{flex:1;font-weight:500}
    .viag-dash-split-leg-item .val{font-weight:700;color:#0F172A}
    .viag-dash-split-leg-item small{color:#94A3B8;font-weight:500}
    /* Tendência mensal — barras verticais */
    .viag-dash-mensal{display:flex;align-items:flex-end;gap:8px;height:140px;padding:6px 0}
    .viag-dash-mensal-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;height:100%}
    .viag-dash-mensal-bar-wrap{flex:1;width:100%;display:flex;align-items:flex-end;justify-content:center}
    .viag-dash-mensal-bar{width:80%;background:linear-gradient(180deg,#14B8A6,#0F766E);border-radius:4px 4px 0 0;
      min-height:2px;transition:height .3s}
    .viag-dash-mensal-val{font-size:10px;color:#0F172A;font-weight:700;line-height:1}
    .viag-dash-mensal-lbl{font-size:10px;color:#94A3B8;font-weight:500;letter-spacing:0.2px}
    /* Insights */
    .viag-dash-insight{display:flex;align-items:flex-start;gap:8px;padding:10px 12px;border-radius:8px;
      margin-bottom:6px;font-size:12px;line-height:1.45}
    .viag-dash-insight:last-child{margin-bottom:0}
    .viag-dash-insight .ico{font-size:14px;flex-shrink:0;line-height:1.4}
    .viag-dash-insight .txt{color:#374151}
    .viag-dash-insight .txt b{font-weight:700;color:#0F172A}
    .viag-dash-insight-danger{background:#FEF2F2;border-left:3px solid #DC2626}
    .viag-dash-insight-warn{background:#FFFBEB;border-left:3px solid #D97706}
    .viag-dash-insight-info{background:#EFF6FF;border-left:3px solid #2563EB}
    .viag-dash-insight-success{background:#F0FDF4;border-left:3px solid #16A34A}

    /* Visão Por Categoria */
    .viag-cat-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px;padding:14px 18px;
      background:linear-gradient(135deg,#0F766E 0%,#0D9488 100%);border-radius:10px;color:#fff}
    @media (max-width:760px){ .viag-cat-summary{grid-template-columns:repeat(2,1fr)} }
    .viag-cat-summary-cell{display:flex;flex-direction:column;gap:2px;align-items:flex-start}
    .viag-cat-summary-cell .lbl{font-size:.66rem;font-weight:800;color:#A7F3D0;text-transform:uppercase;letter-spacing:.1em;font-family:Consolas,Menlo,monospace}
    .viag-cat-summary-cell .val{font-size:1.4rem;font-weight:900;color:#fff;letter-spacing:-.02em;line-height:1}

    .viag-cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
    .viag-cat-card{background:#fff;border:1px solid var(--bdr);border-radius:10px;padding:14px 16px;cursor:pointer;
      transition:all .14s;display:flex;flex-direction:column;gap:8px}
    .viag-cat-card:hover{border-color:#0F766E;box-shadow:0 4px 14px rgba(15,118,110,.1);transform:translateY(-1px)}
    .viag-cat-card.is-expanded{grid-column:span 2;background:#F8FAFC}
    @media (max-width:600px){ .viag-cat-card.is-expanded{grid-column:span 1} }
    .viag-cat-card-hd{display:flex;align-items:center;gap:8px}
    .viag-cat-card-icon{font-size:1.2rem;flex-shrink:0}
    .viag-cat-card-name{font-weight:800;color:#0F172A;font-size:.92rem;flex:1;letter-spacing:-.005em}
    .viag-cat-card-pct{font-family:Consolas,Menlo,monospace;font-size:.72rem;font-weight:800;color:#0F766E;
      background:#F0FDFA;padding:2px 8px;border-radius:4px;border:1px solid #5EEAD4;letter-spacing:.04em}
    .viag-cat-card-val{font-size:1.6rem;font-weight:900;color:#0F172A;letter-spacing:-.02em;line-height:1.05;font-family:Consolas,Menlo,monospace}
    .viag-cat-card-bar{height:6px;background:#F1F5F9;border-radius:3px;overflow:hidden}
    .viag-cat-card-bar .fill{height:100%;border-radius:3px;transition:width .3s}
    .viag-cat-card-meta{display:flex;gap:10px;font-size:.72rem;color:#6B7280;font-family:Consolas,Menlo,monospace;letter-spacing:.02em}
    .viag-cat-card-split{display:flex;gap:8px;font-size:.7rem;font-family:Consolas,Menlo,monospace;font-weight:700;letter-spacing:.04em;
      padding-top:4px;border-top:1px dashed #F1F5F9}
    .viag-cat-card-split:empty{display:none}

    /* Drill-down (despesas individuais) */
    .viag-cat-card-drill{margin-top:8px;padding-top:10px;border-top:1px solid #E2E8F0;display:flex;flex-direction:column;gap:4px;max-height:340px;overflow:auto}
    .viag-cat-drill-item{display:grid;grid-template-columns:90px 1fr 1.5fr 100px;gap:8px;padding:6px 8px;
      background:#fff;border:1px solid #F1F5F9;border-radius:5px;font-size:.78rem;align-items:center;cursor:pointer;
      transition:all .1s}
    .viag-cat-drill-item:hover{background:#F0FDFA;border-color:#5EEAD4}
    .viag-cat-drill-item .dt{color:#94A3B8;font-family:Consolas,Menlo,monospace;font-size:.72rem;font-weight:700}
    .viag-cat-drill-item .tit{color:#0F172A;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .viag-cat-drill-item .desc{color:#64748B;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .viag-cat-drill-item .val{color:#0F172A;font-weight:800;font-family:Consolas,Menlo,monospace;text-align:right}

    /* Categorias vazias */
    .viag-cat-empty-section{grid-column:1 / -1;margin-top:14px;padding:14px 16px;background:#FAFBFC;border:1px dashed var(--bdr);border-radius:10px}
    .viag-cat-empty-hd{font-size:.7rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.1em;font-family:Consolas,Menlo,monospace;margin-bottom:8px}
    .viag-cat-empty-list{display:flex;flex-wrap:wrap;gap:6px}
    .viag-cat-empty-tag{padding:4px 10px;background:#fff;border:1px solid var(--bdr);border-radius:4px;font-size:.74rem;color:#94A3B8;font-style:italic}

    /* ═══════════════════════════════════════════════
       BOARD UNIFICADO — visual idêntico ao kanban_v8.html
       ═══════════════════════════════════════════════ */
    .bd-wrap{
      --bd-text-1:#111;--bd-text-2:#555;--bd-text-3:#999;
      --bd-bg-1:#fff;--bd-bg-2:#f4f4f4;--bd-bg-info:#EFF6FF;
      --bd-bdr-1:#e5e5e5;--bd-bdr-2:#d1d1d1;--bd-bdr-info:#93C5FD;
      --bd-radius:8px;--bd-radius-lg:12px;
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
      background:#fafafa;padding:1rem 0
    }
    .bd-wrap *{box-sizing:border-box}

    /* Toolbar (header com filtros) */
    .bd-toolbar{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:1rem;padding:0}
    .bd-tabs-views{display:inline-flex;gap:2px;border-bottom:1px solid var(--bd-bdr-1);padding-bottom:0;margin-right:8px}
    .bd-tabs-views button{background:transparent;border:none;padding:7px 14px;font-size:13px;font-weight:500;
      color:var(--bd-text-2);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;
      border-radius:4px 4px 0 0;font-family:inherit}
    .bd-tabs-views button:hover{color:var(--bd-text-1)}
    .bd-tabs-views button.active{color:var(--bd-text-1);border-bottom-color:var(--bd-text-1)}

    .bd-search{padding:6px 12px;font-size:13px;border:0.5px solid var(--bd-bdr-2);border-radius:var(--bd-radius);
      font-family:inherit;background:var(--bd-bg-1);color:var(--bd-text-1);outline:none;min-width:180px;max-width:240px}
    .bd-search:focus{border-color:var(--bd-bdr-2)}

    .bd-pri-btn,.bd-tag-btn,.bd-tipo-btn{background:none;border:0.5px solid var(--bd-bdr-2);border-radius:999px;
      font-size:12px;font-weight:500;color:var(--bd-text-3);padding:4px 11px;cursor:pointer;
      display:inline-flex;align-items:center;gap:4px;white-space:nowrap;font-family:inherit;transition:all .15s}
    .bd-pri-btn:hover,.bd-tag-btn:hover,.bd-tipo-btn:hover{color:var(--bd-text-1)}
    .bd-pri-btn.active,.bd-tag-btn.active,.bd-tipo-btn.active{color:var(--bd-text-1);background:var(--bd-bg-2);border-color:var(--bd-bdr-2)}

    .bd-import-btn,.bd-export-btn{background:transparent;border:0.5px solid var(--bd-bdr-2);border-radius:var(--bd-radius);
      padding:6px 12px;font-size:13px;color:var(--bd-text-1);cursor:pointer;font-family:inherit}
    .bd-import-btn:hover,.bd-export-btn:hover{background:var(--bd-bg-2)}
    .bd-new-btn{background:#111;border:none;border-radius:var(--bd-radius);padding:6px 14px;font-size:13px;
      color:#fff;cursor:pointer;font-family:inherit;font-weight:500}
    .bd-new-btn:hover{background:#000}

    /* KPIs financeiros (compactos no estilo v8) */
    .bd-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px}
    @media (max-width:900px){ .bd-kpi-row{grid-template-columns:repeat(2,1fr)} }
    .bd-kpi{padding:10px 14px;background:var(--bd-bg-1);border:0.5px solid var(--bd-bdr-1);border-radius:var(--bd-radius)}
    .bd-kpi-lbl{font-size:11px;color:var(--bd-text-3);font-weight:500;margin-bottom:3px}
    .bd-kpi-val{font-size:20px;font-weight:600;color:var(--bd-text-1);line-height:1.1}
    .bd-kpi-sub{font-size:10px;color:var(--bd-text-3);margin-top:2px}
    .bd-kpi.is-rec .bd-kpi-val{color:#27500A}
    .bd-kpi.is-pag .bd-kpi-val{color:#A32D2D}
    .bd-kpi.is-aprov .bd-kpi-val{color:#3C3489}
    .bd-kpi.is-overdue{background:#FCEBEB;border-color:#E24B4A}
    .bd-kpi.is-overdue .bd-kpi-val,.bd-kpi.is-overdue .bd-kpi-lbl{color:#A32D2D}

    /* Kanban — 5 colunas */
    .bd-kanban{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;align-items:start}
    @media (max-width:760px){ .bd-kanban{grid-template-columns:repeat(2,1fr)} }
    .bd-col{background:var(--bd-bg-2);border-radius:var(--bd-radius-lg);padding:10px;display:flex;flex-direction:column;min-height:140px}
    .bd-col.bd-col-blocked{background:#FDF2F2}
    .bd-col.bd-col-blocked .bd-col-name{color:#A32D2D}
    .bd-col.bd-col-done{background:#F0F0F0}
    .bd-col.bd-col-done .bd-col-name{color:#aaa}
    .bd-col.is-drop{background:var(--bd-bg-info);outline:1.5px dashed var(--bd-bdr-info)}
    .bd-col-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
    .bd-col-name{font-size:11px;font-weight:500;color:var(--bd-text-2);text-transform:uppercase;letter-spacing:.06em}
    .bd-col-n{font-size:11px;background:var(--bd-bg-1);border:0.5px solid var(--bd-bdr-1);border-radius:999px;
      padding:1px 7px;color:var(--bd-text-2)}

    /* Cards */
    .bd-card{background:var(--bd-bg-1);border:0.5px solid var(--bd-bdr-1);border-radius:var(--bd-radius);
      margin-bottom:7px;padding:9px 11px;cursor:grab;position:relative;transition:border-color .12s}
    .bd-card:hover{border-color:var(--bd-bdr-2)}
    .bd-card.dragging{opacity:.3}
    .bd-card.is-done{opacity:.5}
    .bd-card.is-done .bd-card-name{text-decoration:line-through;color:var(--bd-text-3)}
    .bd-card-tags{display:flex;flex-wrap:wrap;gap:3px;margin-bottom:5px}
    .bd-tag{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px}
    .bd-card-name{font-size:13px;font-weight:500;color:var(--bd-text-1);line-height:1.4;margin-bottom:6px}
    .bd-card-meta{display:flex;flex-wrap:wrap;gap:4px;align-items:center;margin-top:0}
    .bd-pbadge{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px}
    .bd-p-alta{background:#FCEBEB;color:#A32D2D}
    .bd-p-media{background:#FAEEDA;color:#854F0B}
    .bd-p-baixa{background:#EAF3DE;color:#3B6D11}
    .bd-vbadge{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;display:inline-flex;align-items:center;gap:3px}
    .bd-vbadge.rec{background:#E1F5EE;color:#085041}
    .bd-vbadge.pag{background:#FCEBEB;color:#A32D2D}
    .bd-vbadge.outro{background:#F1EFE8;color:#444441}
    .bd-tipobadge{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;background:#F1EFE8;color:#444441;display:inline-flex;align-items:center;gap:3px}
    .bd-card-resp{font-size:11px;color:var(--bd-text-2);display:inline-flex;align-items:center;gap:3px}
    .bd-card-deadline{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;display:inline-flex;align-items:center;gap:3px}
    .bd-deadline-ok{background:#EAF3DE;color:#3B6D11}
    .bd-deadline-warn{background:#FAEEDA;color:#854F0B}
    .bd-deadline-overdue{background:#FCEBEB;color:#A32D2D}
    .bd-card-age{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;background:#E6F1FB;color:#0C447C;display:inline-flex;align-items:center;gap:3px}

    .bd-col-add{width:100%;background:transparent;border:0.5px dashed var(--bd-bdr-1);border-radius:var(--bd-radius);
      padding:7px;font-size:12px;color:var(--bd-text-2);cursor:pointer;margin-top:6px;font-family:inherit}
    .bd-col-add:hover{background:var(--bd-bg-2);color:var(--bd-text-1)}

    /* Modal — branco minimal estilo v8 */
    .bd-modal-ov{position:fixed !important;top:0 !important;left:0 !important;right:0 !important;bottom:0 !important;
      width:100vw;height:100vh;background:rgba(15,23,42,.55) !important;
      display:flex;align-items:center;justify-content:center;z-index:99999 !important;padding:20px;
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
    .bd-modal{background:#ffffff !important;border-radius:12px;width:min(440px,96vw);max-height:92vh;
      display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.32);
      position:relative;z-index:1}
    .bd-modal-hd{padding:14px 18px;display:flex;align-items:center;gap:10px;border-bottom:0.5px solid var(--bd-bdr-1)}
    .bd-modal-hd h2{margin:0;font-size:15px;font-weight:600;color:var(--bd-text-1);flex:1}
    .bd-modal-x{background:transparent;border:none;color:var(--bd-text-3);font-size:18px;cursor:pointer;padding:0 4px}
    .bd-modal-x:hover{color:var(--bd-text-1)}
    .bd-modal-bd{padding:16px 20px;overflow:auto;flex:1;display:flex;flex-direction:column;gap:14px}
    .bd-field{display:flex;flex-direction:column;gap:6px}
    .bd-field label{font-size:11px;color:#555;font-weight:600;letter-spacing:0.2px}
    .bd-field input,.bd-field select,.bd-field textarea{padding:8px 11px;border:1px solid #E5E7EB;border-radius:var(--bd-radius);
      font-size:13px;font-family:inherit;background:#FAFAFA;color:var(--bd-text-1);outline:none;width:100%;box-sizing:border-box;transition:border-color .12s,background .12s,box-shadow .12s}
    .bd-field input:hover,.bd-field select:hover,.bd-field textarea:hover{border-color:#D1D5DB}
    .bd-field input:focus,.bd-field select:focus,.bd-field textarea:focus{border-color:#111;background:#fff;box-shadow:0 0 0 3px rgba(17,17,17,.05)}
    .bd-field-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    /* Containers de lista escondem quando vazios */
    .bd-st-list:empty,.bd-asg-list:empty,.bd-notes-list:empty,.bd-att-list:empty{display:none}

    .bd-tag-pick{display:flex;flex-wrap:wrap;gap:5px;padding:8px;border:1px solid #E5E7EB;
      border-radius:var(--bd-radius);background:var(--bd-bg-2);min-height:38px}
    .bd-tag-pick-item{font-size:11px;font-weight:500;padding:3px 9px;border-radius:999px;cursor:pointer;
      opacity:.55;transition:opacity .12s;border:0.5px solid transparent}
    .bd-tag-pick-item:hover{opacity:.8}
    .bd-tag-pick-item.sel{opacity:1;border-color:rgba(0,0,0,.08)}
    /* Wrap para acomodar botões editar/excluir */
    .bd-tag-pick-wrap{display:inline-flex;align-items:center;position:relative}
    .bd-tag-act-btn{display:none;background:#fff;border:1px solid #D1D5DB;color:#555;
       width:18px;height:18px;border-radius:50%;font-size:9px;cursor:pointer;padding:0;
       align-items:center;justify-content:center;font-family:inherit;line-height:1;margin-left:-2px}
    .bd-tag-pick-wrap:hover .bd-tag-act-btn{display:inline-flex}
    .bd-tag-act-btn:hover{background:#F3F4F6;border-color:#9CA3AF;color:#111}
    .bd-tag-act-edit{margin-left:3px}
    .bd-tag-act-del:hover{background:#FEF2F2;border-color:#FCA5A5;color:#DC2626}
    /* Form de edição inline */
    .bd-tag-edit-form{display:inline-flex;align-items:center;gap:5px;padding:4px 6px;
       background:#fff;border:1px solid #111;border-radius:8px;box-shadow:0 2px 6px rgba(0,0,0,.08)}
    .bd-tag-edit-form input{padding:4px 8px;border:1px solid #E5E7EB;border-radius:5px;
       font-size:12px;font-family:inherit;background:#FAFAFA;outline:none;width:130px}
    .bd-tag-edit-form input:focus{border-color:#111;background:#fff}
    .bd-tag-color-row{display:inline-flex;gap:3px;padding:0 2px}
    .bd-tag-color-dot{width:14px;height:14px;border-radius:50%;cursor:pointer;
       border:2px solid transparent;box-sizing:border-box;transition:transform .12s}
    .bd-tag-color-dot:hover{transform:scale(1.15)}
    .bd-tag-color-dot.sel{border-color:#111;transform:scale(1.1)}
    .bd-tag-edit-ok,.bd-tag-edit-no{padding:0;width:22px;height:22px;border:none;border-radius:5px;
       cursor:pointer;font-size:12px;font-family:inherit;line-height:1;display:inline-flex;
       align-items:center;justify-content:center}
    .bd-tag-edit-ok{background:#111;color:#fff}
    .bd-tag-edit-ok:hover{background:#000}
    .bd-tag-edit-no{background:#F3F4F6;color:#555}
    .bd-tag-edit-no:hover{background:#E5E7EB;color:#111}
    .bd-tag-new-row{display:flex;gap:5px;margin-top:5px}
    .bd-tag-new-row input{flex:1;padding:5px 9px;border:0.5px solid var(--bd-bdr-2);border-radius:6px;font-size:12px}
    .bd-tag-new-row button{padding:5px 11px;background:#111;color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:12px;font-weight:500;font-family:inherit}

    /* Subtasks */
    .bd-st-list{display:flex;flex-direction:column;gap:3px;padding:6px;border:1px solid #E5E7EB;border-radius:var(--bd-radius);background:#FAFAFA;margin-bottom:5px}
    .bd-st-empty{display:none}
    .bd-st-item{display:flex;align-items:center;gap:8px;padding:5px 8px;background:var(--bd-bg-1);border:0.5px solid transparent;border-radius:5px;transition:all .12s}
    .bd-st-item:hover{border-color:var(--bd-bdr-1)}
    .bd-st-item input[type="checkbox"]{margin:0;width:14px;height:14px;cursor:pointer;accent-color:#3B6D11;flex-shrink:0}
    .bd-st-item .bd-st-text{flex:1;border:none;background:transparent;font-size:13px;font-family:inherit;color:var(--bd-text-1);outline:none;padding:2px 4px;border-radius:3px}
    .bd-st-item .bd-st-text:focus{background:var(--bd-bg-2)}
    .bd-st-item.is-done .bd-st-text{text-decoration:line-through;color:var(--bd-text-3)}
    .bd-st-item .bd-st-rm{background:transparent;border:none;color:var(--bd-text-3);cursor:pointer;font-size:13px;padding:2px 6px;border-radius:3px;line-height:1;flex-shrink:0;opacity:0;transition:all .12s;font-family:inherit}
    .bd-st-item:hover .bd-st-rm{opacity:1}
    .bd-st-item .bd-st-rm:hover{background:#FCEBEB;color:#A32D2D}
    .bd-st-new-row{display:flex;gap:6px}
    .bd-st-new-row input{flex:1;padding:7px 11px;border:1px solid #E5E7EB;border-radius:6px;font-size:12px;font-family:inherit;background:#FAFAFA;outline:none;transition:border-color .12s,background .12s}
    .bd-st-new-row input:focus{border-color:#111;background:#fff}
    .bd-st-new-row button{padding:7px 12px;background:#fff;color:#111;border:1px solid #D1D5DB;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;font-family:inherit}
    .bd-st-new-row button:hover{background:#F3F4F6;border-color:#9CA3AF}

    /* Progress badge no card */
    .bd-card-prog{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;background:#F1EFE8;color:#444441;display:inline-flex;align-items:center;gap:3px}
    .bd-card-prog.is-complete{background:#EAF3DE;color:#3B6D11}
    .bd-card-asg{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;background:#EEEDFE;color:#3C3489;display:inline-flex;align-items:center;gap:3px}
    .bd-card-att{font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;background:#FBEAF0;color:#72243E;display:inline-flex;align-items:center;gap:3px}

    /* Assignees no modal */
    .bd-asg-list{display:flex;flex-wrap:wrap;gap:5px;padding:7px;border:1px solid #E5E7EB;border-radius:var(--bd-radius);background:#FAFAFA;margin-bottom:5px}
    .bd-asg-empty{display:none}
    .bd-asg-chip{display:inline-flex;align-items:center;gap:6px;padding:3px 4px 3px 4px;background:#EEEDFE;color:#3C3489;border-radius:999px;font-size:12px;font-weight:500}
    .bd-asg-chip .bd-asg-name{padding-right:2px}
    /* Avatar de pessoa — foto/iniciais redondas */
    .bd-pes-ava{display:inline-flex;align-items:center;justify-content:center;border-radius:50%;
                overflow:hidden;flex-shrink:0;font-weight:600;background:#E5E7EB;color:#374151;
                font-family:inherit;line-height:1;user-select:none}
    .bd-pes-ava img{width:100%;height:100%;object-fit:cover;display:block}
    .bd-pes-ava-sm{width:20px;height:20px;font-size:9px}
    .bd-pes-ava-mini{width:18px;height:18px;font-size:8px;border:1.5px solid #fff;box-shadow:0 0 0 0.5px rgba(0,0,0,.08)}
    .bd-pes-ava-more{background:#E5E7EB;color:#555;font-size:9px}
    .bd-card-asg-stack{display:inline-flex;align-items:center}
    .bd-card-asg-stack .bd-pes-ava-mini{margin-left:-5px}
    .bd-card-asg-stack .bd-pes-ava-mini:first-child{margin-left:0}
    .bd-asg-chip .bd-asg-rm{background:transparent;border:none;color:#3C3489;cursor:pointer;font-size:13px;padding:0 5px;line-height:1;border-radius:50%;opacity:.7;transition:opacity .12s;font-family:inherit}
    .bd-asg-chip .bd-asg-rm:hover{opacity:1;background:rgba(60,52,137,.12)}
    .bd-asg-pick-row{display:flex;gap:6px}
    .bd-asg-pick-row select{flex:1;padding:7px 11px;border:1px solid #E5E7EB;border-radius:6px;font-size:12px;font-family:inherit;background:#FAFAFA;outline:none;transition:border-color .12s,background .12s}
    .bd-asg-pick-row select:focus{border-color:#111;background:#fff}
    .bd-asg-pick-row input{flex:1;padding:7px 11px;border:1px solid #E5E7EB;border-radius:6px;font-size:12px;font-family:inherit;background:#FAFAFA;display:none;outline:none;transition:border-color .12s,background .12s}
    .bd-asg-pick-row input:focus{border-color:#111;background:#fff}
    .bd-asg-pick-row button{padding:7px 12px;background:#fff;color:#111;border:1px solid #D1D5DB;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;font-family:inherit}
    .bd-asg-pick-row button:hover{background:#F3F4F6;border-color:#9CA3AF}

    /* Attachments no modal */
    .bd-att-list{display:flex;flex-direction:column;gap:3px;padding:6px;border:1px solid #E5E7EB;border-radius:var(--bd-radius);background:#FAFAFA;margin-bottom:5px}
    /* ── Notas ── */
    .bd-notes-list{display:flex;flex-direction:column;gap:10px;padding:10px 12px;border:1px solid #E5E7EB;border-radius:var(--bd-radius);background:#FAFAFA;max-height:240px;overflow-y:auto;margin-bottom:5px}
    .bd-notes-empty{display:none}
    .bd-note-item{display:flex;flex-direction:column;gap:2px}
    .bd-note-meta{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--bd-text-3)}
    .bd-note-badge{display:inline-flex;align-items:center;padding:1px 6px;border-radius:4px;font-size:9px;font-weight:700;letter-spacing:0.4px;line-height:1.4}
    .bd-note-badge-auto{background:#DBEAFE;color:#1E40AF}
    .bd-note-ts{font-size:11px}
    .bd-note-rm{margin-left:auto;background:transparent;border:none;color:#999;cursor:pointer;font-size:12px;padding:0 4px;border-radius:50%;line-height:1;font-family:inherit;opacity:0;transition:opacity .12s}
    .bd-note-item:hover .bd-note-rm{opacity:.7}
    .bd-note-rm:hover{opacity:1!important;color:#DC2626}
    .bd-note-text{font-size:13px;color:var(--bd-text-1);line-height:1.4;padding-left:1px}
    .bd-note-item.is-auto .bd-note-text{font-style:italic;color:var(--bd-text-2)}
    .bd-note-new-row{display:flex;gap:6px;align-items:stretch}
    .bd-note-new-row input{flex:1;padding:8px 11px;border:1px solid #E5E7EB;border-radius:6px;font-size:13px;font-family:inherit;background:#FAFAFA;outline:none;transition:border-color .12s,background .12s}
    .bd-note-new-row input:focus{border-color:#111;background:#fff;box-shadow:0 0 0 3px rgba(17,17,17,.05)}
    .bd-note-new-row button{padding:8px 12px;background:#fff;color:#111;border:1px solid #D1D5DB;border-radius:6px;cursor:pointer;font-size:14px;font-family:inherit;line-height:1;min-width:38px}
    .bd-note-new-row button:hover{background:#F3F4F6;border-color:#9CA3AF}
    .bd-att-empty{display:none}
    .bd-att-item{display:flex;align-items:center;gap:8px;padding:5px 8px;background:var(--bd-bg-1);border:0.5px solid transparent;border-radius:5px;font-size:12px}
    .bd-att-item:hover{border-color:var(--bd-bdr-1)}
    .bd-att-ico{font-size:14px;flex-shrink:0}
    .bd-att-name{flex:1;color:#0C447C;cursor:pointer;text-decoration:underline;text-decoration-color:transparent;transition:text-decoration-color .12s;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .bd-att-name:hover{text-decoration-color:#0C447C}
    .bd-att-size{font-size:11px;color:var(--bd-text-3);font-family:Consolas,Menlo,monospace;flex-shrink:0}
    .bd-att-rm{background:transparent;border:none;color:var(--bd-text-3);cursor:pointer;font-size:13px;padding:2px 6px;border-radius:3px;line-height:1;flex-shrink:0;font-family:inherit;opacity:0;transition:opacity .12s}
    .bd-att-item:hover .bd-att-rm{opacity:1}
    .bd-att-rm:hover{background:#FCEBEB;color:#A32D2D}
    .bd-att-btn{padding:7px 14px;background:#fff;border:0.5px dashed var(--bd-bdr-2);border-radius:6px;cursor:pointer;font-size:12px;font-weight:500;color:var(--bd-text-2);font-family:inherit;width:100%}
    .bd-att-btn:hover{border-color:#3C3489;color:#3C3489;background:#FAFBFC}

    .bd-modal-foot{padding:11px 18px;border-top:0.5px solid var(--bd-bdr-1);display:flex;gap:8px;align-items:center;background:#fafafa}
    .bd-modal-foot .btn-del{background:transparent;color:#A32D2D;border:0.5px solid #E5C6C6;padding:6px 12px;border-radius:var(--bd-radius);font-size:12px;font-weight:500;cursor:pointer;font-family:inherit}
    .bd-modal-foot .btn-del:hover{background:#FCEBEB}
    .bd-modal-foot .btn-c{background:transparent;color:var(--bd-text-2);border:0.5px solid var(--bd-bdr-2);padding:7px 14px;border-radius:var(--bd-radius);font-size:13px;font-weight:500;cursor:pointer;font-family:inherit}
    .bd-modal-foot .btn-c:hover{background:var(--bd-bg-2);color:var(--bd-text-1)}
    .bd-modal-foot .btn-s{background:#111;color:#fff;border:none;padding:7px 18px;border-radius:var(--bd-radius);font-size:13px;font-weight:500;cursor:pointer;font-family:inherit}
    .bd-modal-foot .btn-s:hover{background:#000}

    /* Checklist (linhas com circle toggle) */
    .bd-checklist{display:flex;flex-direction:column;background:var(--bd-bg-1);border:0.5px solid var(--bd-bdr-1);border-radius:var(--bd-radius-lg);overflow:hidden}
    .bd-cl-row{display:flex;align-items:flex-start;gap:14px;padding:14px 18px;border-bottom:0.5px solid var(--bd-bdr-1);cursor:pointer;transition:background .12s}
    .bd-cl-row:last-child{border-bottom:none}
    .bd-cl-row:hover{background:var(--bd-bg-2)}
    .bd-cl-row.is-done .bd-cl-name{text-decoration:line-through;color:var(--bd-text-3)}
    .bd-cl-row.is-done{opacity:.7}
    .bd-cl-check{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--bd-bdr-2);background:transparent;
      cursor:pointer;flex-shrink:0;margin-top:2px;transition:all .12s;padding:0;font-size:0;line-height:0}
    .bd-cl-check:hover{border-color:#3B6D11;background:#EAF3DE}
    .bd-cl-check.checked{background:#3B6D11;border-color:#3B6D11;position:relative}
    .bd-cl-check.checked::before{content:'✓';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700;line-height:1}
    .bd-cl-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:6px}
    .bd-cl-name{font-size:14px;font-weight:600;color:var(--bd-text-1);line-height:1.4}
    .bd-cl-pills{display:flex;flex-wrap:wrap;gap:5px;align-items:center}
    .bd-cl-pills .bd-tag,.bd-cl-pills .bd-pbadge{font-size:11px;padding:2px 9px;border-radius:999px;font-weight:500}
    .bd-cl-col{font-size:11px;font-weight:500;padding:2px 9px;border-radius:999px;background:var(--bd-bg-2);color:var(--bd-text-3)}
    .bd-cl-deadline{font-size:11px;font-weight:500;padding:2px 9px;border-radius:999px;display:inline-flex;align-items:center;gap:3px}
    .bd-cl-deadline.bd-deadline-ok{background:#EAF3DE;color:#3B6D11}
    .bd-cl-deadline.bd-deadline-warn{background:#FAEEDA;color:#854F0B}
    .bd-cl-deadline.bd-deadline-overdue{background:#FCEBEB;color:#A32D2D}
    .bd-cl-dias{font-size:11px;font-weight:500;padding:2px 9px;border-radius:999px;background:#E6F1FB;color:#0C447C}

    /* Divider entre ativos e concluídos */
    .bd-cl-divider{display:flex;align-items:center;gap:14px;margin:18px 0 10px;color:var(--bd-text-3);font-size:13px;font-weight:500}
    .bd-cl-divider::before,.bd-cl-divider::after{content:'';flex:1;height:1px;background:var(--bd-bdr-1)}
    .bd-checklist-done{opacity:.85}

    /* Calendário */
    .bd-cal-wrap{background:var(--bd-bg-1);border:0.5px solid var(--bd-bdr-1);border-radius:var(--bd-radius-lg);overflow:hidden}
    .bd-cal-hd{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:0.5px solid var(--bd-bdr-1);background:var(--bd-bg-2)}
    .bd-cal-nav{background:var(--bd-bg-1);border:0.5px solid var(--bd-bdr-2);border-radius:6px;width:32px;height:32px;
      cursor:pointer;font-size:16px;color:var(--bd-text-1);font-family:inherit;line-height:1}
    .bd-cal-nav:hover{background:var(--bd-bdr-1)}
    .bd-cal-month{font-size:15px;font-weight:600;color:var(--bd-text-1);flex:1;text-align:center;text-transform:capitalize}
    .bd-cal-today{background:var(--bd-bg-1);border:0.5px solid var(--bd-bdr-2);border-radius:6px;padding:6px 14px;font-size:12px;font-weight:500;color:var(--bd-text-1);cursor:pointer;font-family:inherit}
    .bd-cal-today:hover{background:var(--bd-bdr-1)}
    .bd-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:0}
    .bd-cal-hdr{background:var(--bd-bg-2);border-bottom:0.5px solid var(--bd-bdr-1)}
    .bd-cal-hcell{padding:8px;text-align:center;font-size:11px;font-weight:500;color:var(--bd-text-3);text-transform:uppercase;letter-spacing:.04em}
    .bd-cal-cell{min-height:96px;padding:6px;border-right:0.5px solid var(--bd-bdr-1);border-bottom:0.5px solid var(--bd-bdr-1);
      background:var(--bd-bg-1);display:flex;flex-direction:column;gap:3px;overflow:hidden}
    .bd-cal-cell:nth-child(7n){border-right:none}
    .bd-cal-other{background:#FAFAFA;color:var(--bd-text-3)}
    .bd-cal-other .bd-cal-day{color:var(--bd-text-3);opacity:.5}
    .bd-cal-today-cell{background:#FFFBEA}
    .bd-cal-today-cell .bd-cal-day{background:#854F0B;color:#fff;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;line-height:1;font-weight:600}
    .bd-cal-day{font-size:12px;font-weight:500;color:var(--bd-text-2);padding:1px 3px}
    .bd-cal-cards{display:flex;flex-direction:column;gap:2px;flex:1;overflow:hidden}
    .bd-cal-card{font-size:11px;font-weight:500;padding:2px 7px;border-radius:4px;cursor:pointer;
      overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.4;border-left:3px solid #999}
    .bd-cal-card.bd-p-alta{background:#FCEBEB;color:#A32D2D;border-left-color:#A32D2D}
    .bd-cal-card.bd-p-media{background:#FAEEDA;color:#854F0B;border-left-color:#854F0B}
    .bd-cal-card.bd-p-baixa{background:#EAF3DE;color:#3B6D11;border-left-color:#3B6D11}
    .bd-cal-card:hover{filter:brightness(.95)}
    .bd-cal-card.is-done{opacity:.5;text-decoration:line-through}
    .bd-cal-card.is-overdue{font-weight:700}
    .bd-cal-more{font-size:10px;color:var(--bd-text-3);padding:1px 4px;font-style:italic}
    .bd-cal-no-date{padding:14px 16px;border-top:0.5px solid var(--bd-bdr-1);background:#FAFAFA}
    .bd-cal-no-date-hd{font-size:11px;font-weight:500;color:var(--bd-text-3);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px}
    .bd-cal-no-date-list{display:flex;flex-wrap:wrap;gap:5px}
    .bd-cal-no-date-list .bd-cal-card{display:inline-block;max-width:200px}

    /* ═══ Sidebar interna do módulo Workflows ═══ */
    .wf-layout{display:grid;grid-template-columns:240px 1fr;gap:18px;align-items:start;margin-top:6px;transition:grid-template-columns .22s ease}
    .wf-layout.is-collapsed{grid-template-columns:56px 1fr}
    @media (max-width:900px){ .wf-layout,.wf-layout.is-collapsed{grid-template-columns:1fr} }
    .wf-sidebar{background:#FAFBFC;border:1px solid var(--bdr);border-radius:10px;padding:10px 8px;
      display:flex;flex-direction:column;gap:2px;position:sticky;top:14px;position:relative}
    /* Botão de collapse */
    .wf-collapse-btn{position:absolute;top:10px;right:-12px;width:24px;height:24px;
      background:#fff;border:1px solid var(--bdr);border-radius:50%;cursor:pointer;
      display:flex;align-items:center;justify-content:center;color:#475569;
      box-shadow:0 1px 3px rgba(15,23,42,.08);z-index:5;transition:all .15s;padding:0}
    .wf-collapse-btn:hover{background:#0F172A;color:#fff;border-color:#0F172A;transform:scale(1.08)}
    .wf-collapse-btn svg{transition:transform .22s ease}
    .wf-layout.is-collapsed .wf-collapse-btn svg{transform:rotate(180deg)}
    /* Modo colapsado: esconde texto, centraliza ícone */
    .wf-layout.is-collapsed .wf-sidebar-section{display:none}
    .wf-layout.is-collapsed .wf-nav-text{display:none}
    .wf-layout.is-collapsed .wf-nav-item{padding:10px 0;justify-content:center;border-left-width:0}
    .wf-layout.is-collapsed .wf-nav-item.active{border-left-width:0;border-bottom:0;
      box-shadow:inset 3px 0 0 #10B981}
    .wf-layout.is-collapsed .wf-nav-icon{width:auto;font-size:1.3rem}
    @media (max-width:900px){ .wf-sidebar{position:static} }
    .wf-sidebar-section{font-size:.62rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.12em;
      font-family:Consolas,Menlo,monospace;padding:6px 12px 4px}
    .wf-nav-item{background:transparent;border:none;padding:9px 12px;border-radius:8px;
      cursor:pointer;display:flex;align-items:center;gap:10px;width:100%;text-align:left;
      font-family:inherit;color:#475569;transition:all .12s;border-left:3px solid transparent}
    .wf-nav-item:hover:not(.is-soon){background:#fff;color:#0F172A}
    .wf-nav-item.active{background:#0F172A;color:#fff;border-left-color:#10B981}
    .wf-nav-item.active .wf-nav-sub{color:#94A3B8}
    .wf-nav-item.is-soon{opacity:.45;cursor:not-allowed;font-style:italic}
    .wf-nav-icon{font-size:1.2rem;flex-shrink:0;width:24px;text-align:center;line-height:1}
    .wf-nav-text{display:flex;flex-direction:column;gap:1px;flex:1;min-width:0}
    .wf-nav-title{font-size:.84rem;font-weight:700;letter-spacing:-.005em;line-height:1.2}
    .wf-nav-sub{font-size:.66rem;color:#94A3B8;font-family:Consolas,Menlo,monospace;letter-spacing:.02em;line-height:1.3}
    .wf-content{min-width:0}
    /* ── Cadastro (Clientes / Fornecedores) ── */
    .wf-cad-wrap{display:flex;flex-direction:column;gap:14px;margin-top:6px}
    .wf-cad-hd h2{margin:0;font-size:1.15rem;font-weight:700;color:#0F172A;letter-spacing:-0.01em}
    .wf-cad-hd p{margin:4px 0 0;font-size:.78rem;color:#64748B}
    .wf-cad-toolbar{display:flex;align-items:center;gap:10px;padding:12px 14px;background:#fff;
      border:1px solid var(--bdr);border-radius:8px}
    .wf-cad-toolbar input{flex:1;max-width:320px;padding:8px 12px;border:1px solid #E5E7EB;
      border-radius:6px;font-size:.86rem;font-family:inherit;background:#FAFAFA;outline:none;
      transition:border-color .12s,background .12s}
    .wf-cad-toolbar input:focus{border-color:#0F172A;background:#fff}
    .wf-cad-count{font-size:.74rem;color:#94A3B8;font-weight:500;margin-left:auto}
    .wf-cad-table{width:100%;background:#fff;border:1px solid var(--bdr);border-radius:8px;
      border-collapse:separate;border-spacing:0;overflow:hidden;font-size:.84rem}
    .wf-cad-table thead th{padding:10px 14px;text-align:left;font-size:.7rem;font-weight:700;
      color:#94A3B8;background:#F8FAFC;border-bottom:1px solid var(--bdr);
      text-transform:uppercase;letter-spacing:0.05em}
    .wf-cad-table tbody td{padding:10px 14px;border-bottom:1px solid #F1F5F9;color:#334155;vertical-align:middle}
    .wf-cad-table tbody tr:last-child td{border-bottom:none}
    .wf-cad-table tbody tr:hover{background:#F8FAFC}
    .wf-cad-name-cell{display:flex;align-items:center;gap:10px}
    .wf-cad-name{font-weight:600;color:#0F172A}
    .wf-cad-sub{font-size:.72rem;color:#94A3B8;margin-top:1px}
    .wf-cad-ava{width:32px;height:32px;border-radius:50%;object-fit:cover;flex-shrink:0;border:1px solid #E5E7EB}
    .wf-cad-ava-ini{width:32px;height:32px;border-radius:50%;flex-shrink:0;display:inline-flex;
      align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:.74rem;letter-spacing:0.5px}
    .wf-cad-pill{display:inline-block;padding:2px 8px;border-radius:999px;background:#F1F5F9;
      color:#475569;font-size:.7rem;font-weight:600}
    .wf-cad-status{display:inline-block;padding:2px 8px;border-radius:999px;font-size:.7rem;font-weight:600}
    .wf-cad-status.is-on{background:#DCFCE7;color:#166534}
    .wf-cad-status.is-off{background:#FEE2E2;color:#991B1B}
