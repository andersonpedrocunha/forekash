    prev.innerHTML = url
      ? '<img src="' + url.replace(/"/g,'&quot;') + '" alt="Preview" />'
      : DEFAULT_LOGO_SVG;
  }
}

async function settingsOnLogoUpload(ev){
  const file = ev.target.files && ev.target.files[0];
  ev.target.value = ''; // permite re-selecionar o mesmo arquivo
  if(!file) return;
  // Valida tipo
  if(!/^image\//.test(file.type)){
    if(typeof showInfo === 'function'){
      showInfo({ title:'Arquivo inválido', message:'Selecione um arquivo de imagem (PNG, JPG, SVG ou WebP).' });
    }
    return;
  }
  // Valida tamanho
  if(file.size > 500 * 1024){
    if(typeof showInfo === 'function'){
      showInfo({ title:'Imagem muito grande', message:'O limite é 500 KB. Tente comprimir a imagem ou usar um SVG.' });
    }
    return;
  }
  const reader = new FileReader();
  reader.onload = () => {
    const dataUrl = String(reader.result || '');
    if(!dataUrl.startsWith('data:image/')) return;
    if(!settings) settingsLoad();
    settings.logoDataUrl = dataUrl;
    settingsSave();
    applyLogo();
    const flag = document.getElementById('cfg-saved-flag');
    if(flag){ flag.classList.add('show'); setTimeout(() => flag.classList.remove('show'), 1800); }
  };
  reader.readAsDataURL(file);
}

function settingsResetLogo(){
  if(!settings) settingsLoad();
  if(!settings.logoDataUrl) return; // já é o padrão
  settings.logoDataUrl = '';
  settingsSave();
  applyLogo();
}

