function bdImportFile(input){
  const file = input.files && input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const obj = JSON.parse(e.target.result);
      if(!obj || typeof obj !== 'object'){ throw new Error('JSON inválido'); }
      // Espera shape do kanban_v8: { globalTags, cards, nCard, nTag }
      const doImport = () => {
        if(Array.isArray(obj.globalTags)) board.globalTags = obj.globalTags;
        if(Array.isArray(obj.cards)) board.cards = obj.cards;
        if(typeof obj.nCard === 'number') board.nCard = obj.nCard;
        if(typeof obj.nTag === 'number') board.nTag = obj.nTag;
        bdSave();
        bdLoad(); // executa migração
        bdRender();
        if(typeof toast === 'function') toast('✓ Importado: ' + (obj.cards?.length || 0) + ' cards · ' + (obj.globalTags?.length || 0) + ' tags');
      };
      if(board.cards.length > 0){
        if(typeof anaConfirm === 'function'){
          anaConfirm({
            eyebrow: 'Importar JSON',
            title: 'Substituir ' + board.cards.length + ' cards atuais?',
            message: 'O conteúdo atual será sobrescrito pelo JSON importado.',
            okText: 'Sim, substituir',
            cancelText: 'Cancelar',
            danger: true
          }, doImport);
        } else if(window.confirm('Substituir conteúdo atual?')){ doImport(); }
      } else { doImport(); }
    } catch(err){
      console.error('import failed:', err);
      if(typeof toast === 'function') toast('❌ JSON inválido');
    }
  };
  reader.readAsText(file);
  input.value = '';
}
function bdExport(){
  const payload = JSON.stringify(board, null, 2);
  const blob = new Blob([payload], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'forekash_board_' + new Date().toISOString().slice(0,10) + '.json';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
  if(typeof toast === 'function') toast('⬆ JSON baixado');
}

