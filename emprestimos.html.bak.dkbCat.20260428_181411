// Formata a duração de um único ciclo (ex.: "1 ano e 3 meses")
function fmtCicloDuracao(p){
  const df = diffAnosMesesEntre(p.inicio, p.fim || '');
  if(!df) return '—';
  const anos = df.anos, meses = df.meses;
  const parts = [];
  if(anos  > 0) parts.push(anos  + (anos  === 1 ? ' ano'  : ' anos'));
  if(meses > 0) parts.push(meses + (meses === 1 ? ' mês' : ' meses'));
  if(parts.length === 0){
    const msDia = 86400000;
    const nDias = Math.max(0, Math.round((df.end - df.start) / msDia));
    return nDias + (nDias === 1 ? ' dia' : ' dias');
  }
  return parts.join(' e ');
}

