    .fk-diag-chip.up{background:#D1FAE5;color:#065F46;border-color:#A7F3D0}
    .fk-diag-chip.dn{background:#FEE2E2;color:#991B1B;border-color:#FECACA}

    .fk-diag-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .fk-diag-sec{padding:14px 16px;background:#F9FAFB;border:1px solid #E5E7EB;border-radius:8px}
    .fk-diag-sec-hd{display:flex;align-items:center;gap:8px;margin-bottom:8px}
    .fk-diag-sec-hd .ico{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;
                          background:#EDE9FE;color:#7C3AED}
    .fk-diag-sec-hd .ico svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .fk-diag-sec-hd .ico.g{background:#D1FAE5;color:#059669}
    .fk-diag-sec-hd .ico.a{background:#FEF3C7;color:#D97706}
    .fk-diag-sec-hd .ico.b{background:#DBEAFE;color:#2563EB}
    .fk-diag-sec-hd h5{margin:0;font-size:.82rem;font-weight:800;color:#0F172A;letter-spacing:-.01em}
    .fk-diag-sec-cnt{margin-left:auto;font-size:.62rem;background:#fff;padding:2px 7px;border-radius:999px;color:#6B7280;font-weight:700;border:1px solid #E5E7EB}
    .fk-diag-alert{display:flex;gap:9px;padding:8px 0;font-size:.76rem;line-height:1.5;color:#374151;align-items:flex-start;
                   border-top:1px dashed #E5E7EB}
    .fk-diag-alert:first-of-type{border-top:none;padding-top:4px}
    .fk-diag-alert b{color:#0F172A;font-weight:700}
    .fk-diag-alert .ab{width:4px;border-radius:2px;background:#F59E0B;flex-shrink:0;align-self:stretch}
    .fk-diag-alert.ok .ab{background:#10B981}
    .fk-diag-alert.err .ab{background:#EF4444}
    .fk-diag-alert .num{color:#7C3AED;font-weight:700;font-variant-numeric:tabular-nums}
    .fk-diag-sec p{margin:0;font-size:.78rem;color:#374151;line-height:1.6}
    .fk-diag-sec p b{color:#0F172A;font-weight:700}
    .fk-diag-sec p .num{color:#7C3AED;font-weight:700;font-variant-numeric:tabular-nums;background:#F5F3FF;padding:0 4px;border-radius:3px}

    /* ═══ DRC (fluxo) · mock ═══ */
    .fk-drc{max-width:1100px;margin:0 auto;background:#fff;border:1px solid #E5E7EB;border-radius:12px;overflow:hidden}
    .fk-drc-hd{padding:16px 20px;border-bottom:1px solid #F3F4F6}
    .fk-drc-hd h4{margin:0;font-size:1rem;font-weight:800;color:#0F172A;letter-spacing:-.01em}
    .fk-drc-hd p{margin:2px 0 0;font-size:.72rem;color:#6B7280}
    .fk-drc-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:14px 20px;background:#FAFBFC}
    .fk-drc-kpi{padding:10px 12px;background:#fff;border:1px solid #E5E7EB;border-radius:8px}
    .fk-drc-kpi .lbl{font-size:.6rem;color:#6B7280;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
    .fk-drc-kpi .val{font-size:1.05rem;font-weight:800;color:#0F172A;margin-top:3px;font-variant-numeric:tabular-nums}
    .fk-drc-kpi .val.grn{color:#059669}
    .fk-drc-kpi .val.red{color:#DC2626}
    .fk-drc-kpi .sub{font-size:.62rem;color:#9CA3AF;margin-top:2px}

    .fk-drc-tbl{width:100%;border-collapse:separate;border-spacing:0;font-size:.76rem}
    .fk-drc-tbl th{background:#F3F4F6;color:#6B7280;font-weight:700;padding:8px 10px;text-align:right;
                   border-bottom:1px solid #E5E7EB;font-size:.6rem;text-transform:uppercase;letter-spacing:.06em}
    .fk-drc-tbl th.l{text-align:left}
    .fk-drc-tbl td{padding:8px 10px;border-bottom:1px solid #F3F4F6;color:#374151;text-align:right;font-variant-numeric:tabular-nums}
    .fk-drc-tbl td.l{text-align:left;font-weight:600;color:#0F172A}
    .fk-drc-tbl td.lb{padding-left:20px;color:#6B7280;font-weight:500}
    .fk-drc-tbl tr.rec td{color:#059669;background:#F0FDF4}
    .fk-drc-tbl tr.cus td{color:#DC2626;background:#FEF2F2}
    .fk-drc-tbl tr.res td{background:#0F172A;color:#fff;font-weight:800;border-bottom:none}
    .fk-drc-tbl tr.res td.grn{color:#86EFAC}
    .fk-drc-tbl tr.lb-detail td{font-size:.74rem;color:#9CA3AF}

    /* Legenda */
    .fk-show-legend{text-align:center;margin-top:22px;font-size:.78rem;color:#9CA3AF;line-height:1.5}
    .fk-show-legend b{color:#6B7280;font-weight:700}

    /* Mockup dividers */
    .fk-show-div{max-width:1100px;margin:36px auto;display:flex;align-items:center;gap:16px}
    .fk-show-div-ln{flex:1;height:1px;background:linear-gradient(90deg,transparent,#E5E7EB,transparent)}
    .fk-show-div-lb{font-size:.68rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#9CA3AF}

    @media (max-width:1000px){
      .fk-show-kgrid{grid-template-columns:repeat(2,1fr)}
      .fk-drc-kpis{grid-template-columns:repeat(2,1fr)}
      .fk-diag-grid{grid-template-columns:1fr}
      .fk-sheet-table th:nth-child(n+10),.fk-sheet-table td:nth-child(n+10){display:none}
      .fk-show-body{padding:18px}
    }
    @media (max-width:680px){
      .fk-show-kgrid{grid-template-columns:1fr}
      .fk-drc-kpis{grid-template-columns:1fr}
      .fk-sheet-table th:nth-child(n+7),.fk-sheet-table td:nth-child(n+7){display:none}
      .fk-sheet-table th.sub-total,.fk-sheet-table td.total{display:table-cell}
    }

    /* ── Preços ── */
    .fk-plans{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;max-width:1280px;margin:0 auto}
    .fk-plan{padding:28px 22px;background:#fff;border:1.5px solid #E5E7EB;border-radius:18px;position:relative;
             display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s}
    .fk-plan:hover{transform:translateY(-4px);box-shadow:0 16px 40px -16px rgba(15,23,42,.18)}
    .fk-plan.featured{border-color:#0F172A;background:linear-gradient(180deg,#fff 0%,#F9FAFB 100%);
                      box-shadow:0 12px 36px -12px rgba(15,23,42,.25)}
    .fk-plan.featured::before{content:'Mais escolhido';position:absolute;top:-12px;left:50%;transform:translateX(-50%);
                               padding:5px 14px;background:#0F172A;color:#fff;font-size:.66rem;font-weight:800;
                               letter-spacing:.08em;text-transform:uppercase;border-radius:999px}
    .fk-plan-name{font-size:.78rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#10B981}
    .fk-plan-desc{margin-top:10px;font-size:.9rem;color:#4B5563;line-height:1.5;min-height:44px}
    .fk-plan-price{margin-top:22px;display:flex;align-items:baseline;gap:6px}
    .fk-plan-price .cur{font-size:1rem;font-weight:700;color:#6B7280}
    .fk-plan-price .val{font-size:2.6rem;font-weight:900;letter-spacing:-.03em;color:#0F172A;line-height:1}
    .fk-plan-price .per{font-size:.82rem;color:#6B7280}
    .fk-plan-sub{font-size:.8rem;color:#9CA3AF;margin-top:4px}
    .fk-plan-cta{margin-top:22px;padding:12px 18px;border-radius:9px;font-weight:700;font-size:.9rem;
                 font-family:inherit;cursor:pointer;text-align:center;transition:all .15s;
                 background:#F3F4F6;color:#0F172A;border:1px solid #E5E7EB;display:block;width:100%}
    .fk-plan-cta:hover{background:#E5E7EB}
    .fk-plan.featured .fk-plan-cta{background:#0F172A;color:#fff;border-color:#0F172A}
    .fk-plan.featured .fk-plan-cta:hover{background:#1E293B;box-shadow:0 4px 12px rgba(15,23,42,.25)}
    .fk-plan-feat{list-style:none;padding:0;margin:24px 0 0;font-size:.9rem;color:#374151;flex:1}
    .fk-plan-feat li{display:flex;align-items:flex-start;gap:10px;padding:7px 0;line-height:1.5}
    .fk-plan-feat li svg{width:15px;height:15px;flex-shrink:0;margin-top:3px;stroke:#10B981;
                          fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
    .fk-plan-feat li.off{color:#9CA3AF}
    .fk-plan-feat li.off svg{stroke:#D1D5DB}

    /* ── Footer ── */
    .fk-foot{padding:40px 44px;background:#0F172A;color:#94A3B8;font-size:.82rem;border-top:none}
    .fk-foot-inner{max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
    .fk-foot a{color:#CBD5E1;text-decoration:none}
    .fk-foot a:hover{color:#F8FAFC}
    .fk-foot-credit{display:flex;align-items:center;gap:10px}
    .fk-foot-credit svg{height:18px;fill:#64748B}

    /* ── Modal de autenticação ── */
    .fk-auth-backdrop{position:fixed;inset:0;z-index:10000;background:rgba(15,23,42,.55);
                      backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:20px}
    .fk-auth-backdrop.open{display:flex;animation:fkFadeIn .18s}
    .fk-auth-modal{width:100%;max-width:440px;background:#fff;border-radius:18px;
                   box-shadow:0 30px 80px -20px rgba(15,23,42,.4);padding:36px 36px 32px;
                   position:relative;animation:fkSlide .22s ease-out}
    .fk-auth-close{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:8px;
                   background:transparent;border:none;color:#6B7280;cursor:pointer;font-size:20px;
                   display:flex;align-items:center;justify-content:center}
    .fk-auth-close:hover{background:#F3F4F6;color:#0F172A}
    .fk-auth-brand{display:flex;align-items:center;gap:10px;margin-bottom:22px}
    .fk-auth-brand .fk-logo-icon{width:30px;height:30px}
    .fk-auth-brand .fk-logo-text{font-size:1.2rem;font-weight:900;letter-spacing:-.03em;color:#0F172A;line-height:1;display:inline-flex;align-items:baseline}
    .fk-auth-brand .fk-logo-text em{font-style:normal;color:#10B981}

    .fk-tabs{display:flex;gap:4px;padding:4px;background:#F3F4F6;border-radius:10px;
             margin-bottom:24px;border:1px solid #E5E7EB}
    .fk-tabs button{flex:1;border:none;background:transparent;padding:10px 14px;border-radius:7px;
                    font-size:.82rem;font-weight:700;color:#6B7280;cursor:pointer;letter-spacing:.01em;
                    font-family:inherit;transition:all .15s}
    .fk-tabs button:hover{color:#111827}
    .fk-tabs button.active{background:#fff;color:#111827;box-shadow:0 1px 3px rgba(0,0,0,.06)}

    .fk-panel{display:none}
    .fk-panel.active{display:block;animation:fkSlide .25s ease-out}
    .fk-panel h2{font-size:1.45rem;font-weight:800;letter-spacing:-.02em;color:#111827;margin:0 0 4px;line-height:1.2}
    .fk-panel .fk-panel-sub{font-size:.86rem;color:#6B7280;margin-bottom:20px}

    .fk-field{margin-bottom:13px}
    .fk-field label{display:block;font-size:.72rem;font-weight:700;color:#374151;margin-bottom:6px;
                    letter-spacing:.02em;text-transform:uppercase}
    .fk-field input{width:100%;padding:10px 13px;border:1.5px solid #E5E7EB;border-radius:9px;
                    background:#fff;font-size:.92rem;font-family:inherit;color:#111827;
                    transition:border-color .12s,box-shadow .12s;outline:none}
    .fk-field input:focus{border-color:#3B82F6;box-shadow:0 0 0 3px rgba(59,130,246,.12)}
    .fk-field input::placeholder{color:#9CA3AF}

    .fk-pass-wrap{position:relative}
    .fk-pass-toggle{position:absolute;right:10px;top:50%;transform:translateY(-50%);
                    background:none;border:none;cursor:pointer;color:#6B7280;padding:6px;
                    display:flex;align-items:center;justify-content:center;border-radius:6px}
    .fk-pass-toggle:hover{background:#F3F4F6;color:#111827}
    .fk-pass-toggle svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}

    .fk-remember{display:flex;align-items:center;gap:8px;margin:12px 0 18px;font-size:.8rem;
                 color:#6B7280;cursor:pointer;user-select:none}
    .fk-remember input{width:16px;height:16px;accent-color:#3B82F6;cursor:pointer}

    .fk-cta{width:100%;padding:12px 18px;background:#0F172A;color:#fff;border:none;border-radius:9px;
            font-size:.9rem;font-weight:700;font-family:inherit;cursor:pointer;letter-spacing:.01em;
            transition:all .15s;display:flex;align-items:center;justify-content:center;gap:8px}
    .fk-cta:hover{background:#1E293B;transform:translateY(-1px);box-shadow:0 4px 12px rgba(15,23,42,.25)}
    .fk-cta:active{transform:translateY(0)}
    .fk-cta:disabled{opacity:.6;cursor:wait;transform:none}
    .fk-cta svg{width:14px;height:14px}

    .fk-alert{margin-top:14px;padding:10px 12px;border-radius:8px;font-size:.82rem;
              background:#FEF2F2;color:#991B1B;border:1px solid #FECACA;display:none}
    .fk-alert.show{display:block;animation:fkShake .35s}
    .fk-alert.ok{background:#F0FDF4;color:#065F46;border-color:#BBF7D0}

    .fk-legal{margin-top:20px;font-size:.72rem;color:#9CA3AF;line-height:1.5;text-align:center}

    /* ── Responsivo ── */
    @media (max-width:1180px){
      .fk-plans{grid-template-columns:repeat(2,minmax(0,1fr));max-width:760px}
    }
    @media (max-width:1000px){
      .fk-hero-inner{grid-template-columns:1fr;gap:48px}
      .fk-hero h1{font-size:2.4rem}
      .fk-grid{grid-template-columns:1fr}
      .fk-nav-tabs{display:none}
    }
    @media (max-width:700px){
      .fk-plans{grid-template-columns:1fr;max-width:420px}
    }
    @media (max-width:640px){
      .fk-nav{padding:12px 20px;gap:12px}
      .fk-hero{padding:64px 20px 72px}
      .fk-section{padding:64px 20px}
      .fk-hero h1{font-size:2rem}
      .fk-foot{padding:28px 20px}
    }

    /* ── Menu de usuário no header ── */
    .hdr-user{position:relative;display:flex;align-items:center;gap:10px;margin-left:14px}
    .hdr-user-btn{display:flex;align-items:center;gap:9px;padding:5px 10px 5px 5px;
                  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);
                  border-radius:20px;cursor:pointer;color:#F8FAFC;font-family:inherit;
                  font-size:.78rem;font-weight:600;transition:all .15s}
    .hdr-user-btn:hover{background:rgba(255,255,255,.1)}
    .hdr-user-avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#3B82F6,#6366F1);
                     display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;
                     color:#fff;text-transform:uppercase;overflow:hidden;background-size:cover;background-position:center}
    .hdr-user-avatar.has-photo{background-color:transparent !important;background-image:var(--user-photo)}
    /* ── Avatar uploader na seção Perfil ── */
    .cfg-photo-row{display:flex;gap:14px;align-items:center;margin-bottom:14px}
    .cfg-photo-avatar{width:72px;height:72px;border-radius:18px;flex-shrink:0;position:relative;cursor:pointer;
      background:linear-gradient(135deg,#3B82F6,#6366F1);display:flex;align-items:center;justify-content:center;
      color:#fff;font-size:1.4rem;font-weight:800;text-transform:uppercase;letter-spacing:-.02em;
      overflow:hidden;border:1.5px solid rgba(15,23,42,.06);transition:all .15s;
      box-shadow:0 1px 3px rgba(15,23,42,.08)}
    .cfg-photo-avatar:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(15,23,42,.12)}
    .cfg-photo-avatar img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
    .cfg-photo-avatar .cfg-photo-overlay{position:absolute;inset:0;background:rgba(15,23,42,.55);color:#fff;
      display:flex;align-items:center;justify-content:center;gap:5px;font-size:.66rem;font-weight:700;
      letter-spacing:.04em;text-transform:uppercase;opacity:0;transition:opacity .15s}
    .cfg-photo-avatar:hover .cfg-photo-overlay{opacity:1}
    .cfg-photo-avatar .cfg-photo-overlay svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2.2}
    .cfg-photo-info{flex:1;min-width:0}
    .cfg-photo-info-tit{font-size:.84rem;font-weight:700;color:#0F172A;margin:0 0 2px}
    .cfg-photo-info-sub{font-size:.74rem;color:#64748B;margin:0 0 8px;line-height:1.45}
    .cfg-photo-actions{display:flex;gap:6px;flex-wrap:wrap}
    .cfg-photo-actions button{padding:5px 11px;border:1px solid #E2E8F0;border-radius:6px;background:#fff;
      cursor:pointer;font-family:inherit;font-size:.74rem;font-weight:600;color:#475569;transition:all .12s}
    .cfg-photo-actions button:hover{background:#F1F5F9;color:#0F172A;border-color:#CBD5E1}
    .cfg-photo-actions button.danger{color:#B91C1C;border-color:#FECACA}
    .cfg-photo-actions button.danger:hover{background:#FEE2E2;color:#7F1D1D}
    .cfg-photo-input{display:none}
    .hdr-user-menu{position:absolute;top:calc(100% + 6px);right:0;min-width:220px;background:#fff;
                   border:1px solid #E5E7EB;border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.15);
                   padding:8px;display:none;z-index:200}
    .hdr-user-menu.open{display:block;animation:fkSlide .18s}
    .hdr-user-menu .mn-head{padding:10px 12px;border-bottom:1px solid #F3F4F6;margin-bottom:6px}
    .hdr-user-menu .mn-head b{display:block;color:#111827;font-size:.88rem}
    .hdr-user-menu .mn-head span{display:block;color:#6B7280;font-size:.75rem;margin-top:2px}
    .hdr-user-menu button{width:100%;text-align:left;padding:9px 12px;background:transparent;border:none;
                           border-radius:6px;color:#374151;font-size:.85rem;font-family:inherit;
                           cursor:pointer;display:flex;align-items:center;gap:9px}
    .hdr-user-menu button:hover{background:#F3F4F6;color:#111827}
    .hdr-user-menu button.danger{color:#DC2626}
    .hdr-user-menu button.danger:hover{background:#FEF2F2;color:#991B1B}
    .hdr-user-menu .mn-div{height:1px;background:#F3F4F6;margin:6px 4px}
    .hdr-user-menu svg{width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}

    /* ── Módulo Suporte ── */
    .sup-head{margin-bottom:24px}
    .sup-head h1{margin:0;font-size:1.55rem;font-weight:800;color:#0F172A;letter-spacing:-.015em}
    .sup-head p{margin:6px 0 0;color:#64748B;font-size:.92rem;max-width:760px;line-height:1.55}
    .sup-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:22px;align-items:start}
    @media (max-width:1100px){ .sup-layout{grid-template-columns:1fr} }
    .sup-section{background:#fff;border:1px solid #E5E7EB;border-radius:14px;padding:22px 24px;
                  box-shadow:0 1px 2px rgba(15,23,42,.04)}
    .sup-sec-hd{display:flex;align-items:center;gap:12px;margin-bottom:6px}
    .sup-sec-ico{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;
                  flex-shrink:0}
    .sup-sec-ico svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .sup-sec-hd h3{margin:0;font-size:1.02rem;font-weight:800;color:#0F172A;letter-spacing:-.01em}
    .sup-sec-sub{margin:0 0 16px;color:#6B7280;font-size:.84rem;line-height:1.5}
    .sup-section.faq .sup-sec-ico{background:#DBEAFE;color:#1D4ED8}
    .sup-section.form .sup-sec-ico{background:#DCFCE7;color:#047857}

    /* FAQ — accordion */
    .sup-search{position:relative;margin-bottom:14px}
    .sup-search input{width:100%;padding:10px 12px 10px 36px;border:1px solid #E5E7EB;border-radius:9px;
                      font-family:inherit;font-size:.88rem;color:#0F172A;background:#F9FAFB;transition:all .15s}
    .sup-search input:focus{outline:none;border-color:#3B82F6;background:#fff;box-shadow:0 0 0 3px rgba(59,130,246,.12)}
    .sup-search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:15px;height:15px;
                     stroke:#9CA3AF;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
    .sup-faq-list{display:flex;flex-direction:column;gap:8px}
    .sup-faq{border:1px solid #E5E7EB;border-radius:10px;overflow:hidden;background:#F9FAFB;transition:all .15s}
    .sup-faq.open{background:#fff;border-color:#CBD5E1;box-shadow:0 2px 8px -2px rgba(15,23,42,.08)}
    .sup-faq-q{width:100%;text-align:left;background:transparent;border:none;padding:13px 16px;
                font-family:inherit;font-size:.9rem;font-weight:600;color:#0F172A;cursor:pointer;
                display:flex;align-items:center;justify-content:space-between;gap:12px;transition:color .15s}
    .sup-faq-q:hover{color:#1D4ED8}
    .sup-faq-q svg{width:16px;height:16px;stroke:#94A3B8;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;
                    transition:transform .2s;flex-shrink:0}
    .sup-faq.open .sup-faq-q svg{transform:rotate(180deg);stroke:#1D4ED8}
    .sup-faq-a{display:none;padding:0 16px 14px;color:#475569;font-size:.88rem;line-height:1.6}
    .sup-faq.open .sup-faq-a{display:block;animation:fkSlide .18s}
    .sup-faq-a b{color:#0F172A}
    .sup-faq-a code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.82rem;background:#F1F5F9;
                      padding:1px 6px;border-radius:4px;color:#0F172A}
    .sup-faq-empty{padding:16px;text-align:center;color:#9CA3AF;font-size:.85rem}
    .sup-faq-cat{display:inline-block;margin-right:8px;padding:1px 7px;border-radius:999px;
                  background:#EEF2FF;color:#4338CA;font-size:.66rem;font-weight:700;letter-spacing:.04em;
                  text-transform:uppercase;vertical-align:middle}

    /* Formulário de chamado */
    .sup-form{display:flex;flex-direction:column;gap:14px}
    .sup-form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    @media (max-width:560px){ .sup-form-row{grid-template-columns:1fr} }
    .sup-field{display:flex;flex-direction:column;gap:5px}
    .sup-field label{font-size:.78rem;font-weight:700;color:#374151;letter-spacing:.01em}
    .sup-field label .req{color:#DC2626;margin-left:3px}
    .sup-field input,.sup-field select,.sup-field textarea{
      padding:10px 12px;border:1px solid #E5E7EB;border-radius:9px;
      font-family:inherit;font-size:.88rem;color:#0F172A;background:#fff;transition:all .15s;
      font-weight:500;width:100%;box-sizing:border-box}
    .sup-field textarea{min-height:120px;resize:vertical;line-height:1.5}
    .sup-field input:focus,.sup-field select:focus,.sup-field textarea:focus{
      outline:none;border-color:#10B981;box-shadow:0 0 0 3px rgba(16,185,129,.14)}
    .sup-field input[readonly]{background:#F9FAFB;color:#6B7280;cursor:not-allowed}
    .sup-form-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:4px;flex-wrap:wrap}
    .sup-submit{padding:11px 22px;background:#0F172A;color:#fff;border:none;border-radius:9px;
                 font-family:inherit;font-size:.88rem;font-weight:700;cursor:pointer;display:inline-flex;
                 align-items:center;gap:8px;transition:all .15s}
    .sup-submit:hover{background:#1E293B;box-shadow:0 4px 12px rgba(15,23,42,.2)}
    .sup-submit:disabled{opacity:.5;cursor:not-allowed}
    .sup-submit svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
    .sup-hint{font-size:.75rem;color:#9CA3AF;line-height:1.45}
    .sup-alert{margin-top:10px;padding:10px 12px;border-radius:9px;font-size:.84rem;display:none;
                align-items:center;gap:8px;line-height:1.45}
    .sup-alert.show{display:flex;animation:fkSlide .2s}
    .sup-alert.err{background:#FEF2F2;color:#991B1B;border:1px solid #FECACA}
    .sup-alert.ok{background:#F0FDF4;color:#065F46;border:1px solid #BBF7D0}
    .sup-alert svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

    /* Histórico de chamados */
    .sup-tickets{margin-top:18px;padding-top:18px;border-top:1px dashed #E5E7EB}
    .sup-tickets-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
    .sup-tickets-hd h4{margin:0;font-size:.82rem;font-weight:800;color:#374151;letter-spacing:.03em;text-transform:uppercase}
    .sup-tickets-count{font-size:.72rem;color:#6B7280;font-weight:600}
    .sup-ticket{padding:11px 13px;background:#F9FAFB;border:1px solid #F3F4F6;border-radius:9px;margin-bottom:7px;
                 font-size:.82rem;display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center}
    .sup-ticket-pr{padding:2px 8px;border-radius:999px;font-size:.66rem;font-weight:800;letter-spacing:.04em;
                    text-transform:uppercase}
    .sup-ticket-pr.b{background:#DBEAFE;color:#1D4ED8}
    .sup-ticket-pr.n{background:#E0E7FF;color:#4338CA}
    .sup-ticket-pr.a{background:#FEE2E2;color:#991B1B}
    .sup-ticket-title{color:#0F172A;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .sup-ticket-meta{color:#9CA3AF;font-size:.72rem;text-align:right;white-space:nowrap}
    .sup-tickets-empty{padding:14px;text-align:center;color:#9CA3AF;font-size:.8rem;background:#F9FAFB;border-radius:9px}

    /* Anexos / prints */
    .sup-drop{border:1.5px dashed #D1D5DB;border-radius:10px;padding:18px;background:#F9FAFB;cursor:pointer;
               transition:all .15s;text-align:left;outline:none}
    .sup-drop:hover,.sup-drop:focus{border-color:#10B981;background:#F0FDF4}
    .sup-drop.dragging{border-color:#10B981;background:#ECFDF5;border-style:solid}
    .sup-drop-body{display:flex;align-items:center;gap:14px}
    .sup-drop svg{width:26px;height:26px;stroke:#9CA3AF;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
    .sup-drop:hover svg,.sup-drop.dragging svg{stroke:#10B981}
    .sup-drop-txt{font-size:.85rem;color:#374151;line-height:1.5;display:flex;flex-direction:column;gap:2px}
    .sup-drop-txt b{font-weight:700;color:#0F172A}
    .sup-drop-txt .sup-hint{margin-top:2px;font-size:.72rem}
    .sup-thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
    @media (max-width:560px){ .sup-thumbs{grid-template-columns:repeat(2,1fr)} }
    .sup-thumb{position:relative;border:1px solid #E5E7EB;border-radius:9px;overflow:hidden;background:#fff;
                aspect-ratio:4/3}
    .sup-thumb img{display:block;width:100%;height:100%;object-fit:cover}
    .sup-thumb-meta{position:absolute;bottom:0;left:0;right:0;padding:3px 6px;font-size:.66rem;color:#fff;
                     background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.65) 100%);
                     display:flex;justify-content:space-between;align-items:center;gap:4px}
    .sup-thumb-meta span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
    .sup-thumb-rm{position:absolute;top:5px;right:5px;width:22px;height:22px;border-radius:50%;
                   border:none;background:rgba(15,23,42,.75);color:#fff;cursor:pointer;
                   display:flex;align-items:center;justify-content:center;padding:0;transition:all .12s}
    .sup-thumb-rm:hover{background:#DC2626;transform:scale(1.1)}
    .sup-thumb-rm svg{width:12px;height:12px;stroke:#fff;fill:none;stroke-width:2.6;stroke-linecap:round}

    /* Anexos na linha do ticket histórico */
    .sup-ticket-att{margin-left:6px;font-size:.7rem;color:#6B7280;display:inline-flex;align-items:center;gap:3px}
    .sup-ticket-att svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

    /* ═══════════════════════════════════════════════════════════════════
       HP 12C — Calculadora Financeira Flutuante (réplica fiel do clássico)
       ═══════════════════════════════════════════════════════════════════ */

    /* FAB — botão flutuante no canto inferior direito */
    /* ── Ferramenta: Conversor de Taxas (FAB + janela flutuante) ── */
    .rateconv-fab{position:fixed;right:22px;bottom:214px;z-index:9998;
                  width:50px;height:50px;border-radius:50%;border:0;cursor:pointer;
                  background:linear-gradient(135deg,#4338CA 0%,#6366F1 100%);color:#fff;
                  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;
                  box-shadow:0 6px 20px rgba(67,56,202,.35),0 2px 4px rgba(0,0,0,.1);
                  transition:transform .15s, box-shadow .15s}
    .rateconv-fab:hover{transform:translateY(-2px) scale(1.05);
                        box-shadow:0 10px 25px rgba(67,56,202,.45),0 4px 8px rgba(0,0,0,.15)}
    .rateconv-fab.hidden{display:none}
    .rateconv-fab svg{width:18px;height:18px;margin-top:2px}
    .rateconv-fab-lbl{font-size:.56rem;font-weight:800;opacity:.85;letter-spacing:.04em}

    .rateconv-win{position:fixed;right:22px;bottom:208px;z-index:9999;
                  width:360px;max-width:calc(100vw - 44px);
                  background:#fff;border-radius:14px;overflow:hidden;
                  box-shadow:0 25px 60px -12px rgba(15,23,42,.35),0 6px 20px rgba(0,0,0,.1);
                  border:1px solid #E2E8F0;
                  animation:rateconvSlide .2s ease-out}
    @keyframes rateconvSlide{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
    .rateconv-win.hidden{display:none}
    .rateconv-hd{padding:12px 16px;background:linear-gradient(135deg,#4338CA 0%,#6366F1 100%);color:#fff;
                 display:flex;align-items:center;justify-content:space-between}
    .rateconv-hd-ttl{font-size:.88rem;font-weight:800;letter-spacing:.01em}
    .rateconv-hd-close{width:26px;height:26px;background:rgba(255,255,255,.15);border:0;
                       border-radius:5px;cursor:pointer;color:#fff;font-size:1.2rem;line-height:1;
                       display:inline-flex;align-items:center;justify-content:center}
    .rateconv-hd-close:hover{background:rgba(255,255,255,.3)}
    .rateconv-body{padding:14px 16px 12px}
    .rateconv-input-row{margin-bottom:12px}
    .rateconv-input-lbl{display:block;font-size:.6rem;font-weight:800;color:#64748B;
                        text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}
    .rateconv-input-wrap{display:flex;align-items:stretch;gap:0;
                         border:1px solid #E2E8F0;border-radius:8px;overflow:hidden;
                         transition:border-color .12s,box-shadow .12s}
    .rateconv-input-wrap:focus-within{border-color:#6366F1;box-shadow:0 0 0 3px rgba(99,102,241,.15)}
    .rateconv-input{flex:1;min-width:0;border:0;outline:none;padding:10px 12px;
                    font-size:1rem;font-weight:800;color:#0F172A;font-family:inherit;
                    background:#fff;font-variant-numeric:tabular-nums;text-align:right}
    .rateconv-pct{display:flex;align-items:center;padding:0 8px;background:#F1F5F9;
                  color:#64748B;font-weight:800;border-left:1px solid #E2E8F0;font-size:.9rem}
    .rateconv-period{border:0;outline:none;border-left:1px solid #E2E8F0;padding:0 28px 0 10px;
                     font-size:.74rem;font-weight:700;color:#334155;
                     background:#F8FAFC;cursor:pointer;font-family:inherit;
                     appearance:none;-webkit-appearance:none;
                     background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748B' stroke-width='2.4'><path d='M6 9l6 6 6-6'/></svg>");
                     background-repeat:no-repeat;background-position:right 8px center;background-size:11px}

    .rateconv-output{display:flex;flex-direction:column;gap:3px;margin-bottom:12px}
    .rateconv-row{display:flex;align-items:center;justify-content:space-between;
                  padding:8px 12px;border-radius:7px;background:#F8FAFC;
                  border:1px solid transparent;transition:all .12s}
    .rateconv-row.is-base{background:#EEF2FF;border-color:#C7D2FE}
    .rateconv-row-lbl{display:flex;align-items:center;gap:6px;
                      font-size:.7rem;font-weight:700;color:#475569}
    .rateconv-row-lbl .per{font-size:.56rem;color:#94A3B8;font-weight:600}
    .rateconv-row.is-base .rateconv-row-lbl{color:#4338CA}
    .rateconv-row-val{font-size:.88rem;font-weight:800;color:#0F172A;
                      font-variant-numeric:tabular-nums}
    .rateconv-row.is-base .rateconv-row-val{color:#4338CA}
    .rateconv-row-val .unit{font-size:.6rem;font-weight:600;color:#94A3B8;margin-left:3px}

    .rateconv-footer{display:flex;align-items:center;gap:8px;padding-top:10px;
                     border-top:1px solid #F1F5F9}
    .rateconv-base-lbl{font-size:.62rem;font-weight:700;color:#64748B;
                       text-transform:uppercase;letter-spacing:.06em}
    .rateconv-base-group{display:inline-flex;background:#F1F5F9;border:1px solid #E2E8F0;
                         border-radius:6px;padding:1px;gap:1px}
    .rateconv-base-btn{padding:3px 9px;background:transparent;border:0;border-radius:5px;cursor:pointer;
                       font-size:.66rem;font-weight:700;color:#64748B;font-family:inherit}
    .rateconv-base-btn:hover{color:#334155}
    .rateconv-base-btn.is-on{background:#fff;color:#4338CA;box-shadow:0 1px 2px rgba(15,23,42,.08)}

    .hp12-fab{position:fixed;right:22px;bottom:86px;z-index:9998;
              width:54px;height:54px;border-radius:50%;border:none;cursor:pointer;
              background:linear-gradient(135deg,#2d2d2d 0%,#151515 100%);
              color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;
              box-shadow:0 6px 18px rgba(0,0,0,.3),0 2px 6px rgba(0,0,0,.18),
                         inset 0 1px 0 rgba(255,255,255,.08);
              font-family:'Helvetica Neue','Arial',sans-serif;
              transition:transform .15s,box-shadow .15s;padding:0}
    .hp12-fab:hover{transform:translateY(-2px) scale(1.04);
                    box-shadow:0 10px 26px rgba(0,0,0,.38),0 4px 10px rgba(0,0,0,.2)}
    .hp12-fab:active{transform:translateY(0) scale(1)}
    .hp12-fab-hp{display:inline-flex;align-items:center;justify-content:center;
                  background:#df6f3d;color:#fff;font-size:.58rem;font-weight:900;
                  letter-spacing:-.02em;padding:0 4px;border-radius:2px;line-height:1.15;
                  margin-bottom:2px}
    .hp12-fab-num{font-size:.88rem;font-weight:900;letter-spacing:-.03em;line-height:1;color:#eaeaea}
    .hp12-fab.hidden{display:none}
    .hp12-fab[hidden]{display:none}

    /* ════════════════════════════════════════════════════════════
       POMODORO — FAB flutuante + Janela
       ════════════════════════════════════════════════════════════ */
    .pomo-fab{position:fixed;right:22px;bottom:150px;z-index:9998;
              width:54px;height:54px;border-radius:50%;border:none;cursor:pointer;
              background:linear-gradient(135deg,#dc2626 0%,#b91c1c 100%);
              color:#fff;display:flex;align-items:center;justify-content:center;
              box-shadow:0 6px 18px rgba(220,38,38,.4),0 2px 6px rgba(0,0,0,.18);
              transition:transform .15s,box-shadow .15s;padding:0;font-family:inherit}
    .pomo-fab:hover{transform:translateY(-2px) scale(1.04);box-shadow:0 10px 26px rgba(220,38,38,.5)}
    .pomo-fab:active{transform:translateY(0) scale(1)}
    .pomo-fab-icon{font-size:1.4rem;line-height:1}
    .pomo-fab.running{animation:pomo-pulse 2s ease-in-out infinite}
    .pomo-fab.running::after{content:'';position:absolute;inset:-3px;border-radius:50%;
              border:2px solid rgba(220,38,38,.5);animation:pomo-ring 2s ease-out infinite}
    @keyframes pomo-pulse{0%,100%{box-shadow:0 6px 18px rgba(220,38,38,.4)}50%{box-shadow:0 6px 28px rgba(220,38,38,.7)}}
    @keyframes pomo-ring{0%{transform:scale(1);opacity:.7}100%{transform:scale(1.4);opacity:0}}
    .pomo-fab .pomo-fab-mini{position:absolute;top:-4px;right:-4px;background:#fff;color:#0F172A;
              border-radius:99px;padding:1px 5px;font-size:.6rem;font-weight:900;letter-spacing:-.02em;
              box-shadow:0 1px 3px rgba(0,0,0,.2);min-width:14px;text-align:center}
    .pomo-fab.hidden{display:none}

    /* Janela do Pomodoro */
    .pomo-win{position:fixed;z-index:9999;width:340px;
              background:linear-gradient(180deg,#fff 0%,#FAFBFC 100%);
              border-radius:18px;box-shadow:0 24px 64px rgba(15,23,42,.32),0 8px 20px rgba(15,23,42,.18);
              font-family:inherit;user-select:none;overflow:hidden;border:1px solid rgba(15,23,42,.08)}
    .pomo-win.hidden{display:none}
    .pomo-chrome{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid #F1F5F9;
              background:linear-gradient(180deg,#FEE2E2 0%,#FECACA 100%);cursor:move}
    .pomo-chrome.work{background:linear-gradient(180deg,#FEE2E2 0%,#FECACA 100%);color:#7F1D1D}
    .pomo-chrome.short{background:linear-gradient(180deg,#DCFCE7 0%,#BBF7D0 100%);color:#14532D}
    .pomo-chrome.long{background:linear-gradient(180deg,#DBEAFE 0%,#BFDBFE 100%);color:#1E3A8A}
    .pomo-chrome .pomo-icon{font-size:1.1rem}
    .pomo-chrome .pomo-title{flex:1;font-size:.86rem;font-weight:800;letter-spacing:-.01em}
    .pomo-chrome .pomo-close{background:transparent;border:none;cursor:pointer;color:inherit;font-size:1.2rem;line-height:1;padding:4px 6px;border-radius:4px;font-family:inherit;opacity:.6}
    .pomo-chrome .pomo-close:hover{opacity:1;background:rgba(0,0,0,.08)}
    .pomo-body{padding:18px 20px}
    /* Phase tabs */
    .pomo-tabs{display:flex;gap:4px;background:#F1F5F9;border-radius:8px;padding:3px;margin-bottom:18px}
    .pomo-tab{flex:1;padding:6px 8px;background:transparent;border:none;border-radius:5px;cursor:pointer;
              font-family:inherit;font-size:.7rem;font-weight:700;color:#64748B;transition:all .12s}
    .pomo-tab:hover{color:#1E293B}
    .pomo-tab.active.work{background:#DC2626;color:#fff;box-shadow:0 1px 3px rgba(220,38,38,.3)}
    .pomo-tab.active.short{background:#10B981;color:#fff;box-shadow:0 1px 3px rgba(16,185,129,.3)}
    .pomo-tab.active.long{background:#3B82F6;color:#fff;box-shadow:0 1px 3px rgba(59,130,246,.3)}
    /* Display */
    .pomo-disp{position:relative;width:200px;height:200px;margin:0 auto 16px;display:flex;align-items:center;justify-content:center}
    .pomo-disp svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
    .pomo-disp svg circle{fill:none;stroke-width:8;stroke-linecap:round}
    .pomo-disp svg .bg{stroke:#F1F5F9}
    .pomo-disp svg .fg{transition:stroke-dashoffset .3s linear}
    .pomo-disp.work .fg{stroke:#DC2626}
    .pomo-disp.short .fg{stroke:#10B981}
    .pomo-disp.long .fg{stroke:#3B82F6}
    .pomo-disp-time{position:relative;font-size:2.4rem;font-weight:800;letter-spacing:-.04em;color:#0F172A;font-variant-numeric:tabular-nums}
    .pomo-disp-time small{display:block;font-size:.6rem;font-weight:600;color:#94A3B8;text-transform:uppercase;letter-spacing:.1em;margin-top:4px}
    /* Controls */
    .pomo-ctrls{display:flex;gap:8px;margin-bottom:14px}
    .pomo-ctrls button{flex:1;padding:10px 14px;border:1px solid #E2E8F0;border-radius:8px;
              background:#fff;cursor:pointer;font-family:inherit;font-size:.82rem;font-weight:700;color:#0F172A;
              transition:all .12s;display:flex;align-items:center;justify-content:center;gap:6px}
    .pomo-ctrls button:hover{background:#F1F5F9;border-color:#CBD5E1}
    .pomo-ctrls .pomo-go{background:#DC2626;border-color:#B91C1C;color:#fff}
    .pomo-ctrls .pomo-go:hover{background:#B91C1C}
    .pomo-ctrls .pomo-go.short{background:#10B981;border-color:#0F766E}
    .pomo-ctrls .pomo-go.short:hover{background:#0F766E}
    .pomo-ctrls .pomo-go.long{background:#3B82F6;border-color:#1E40AF}
    .pomo-ctrls .pomo-go.long:hover{background:#1E40AF}
    /* Stats */
    .pomo-stats{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;
              background:#F8FAFC;border:1px solid #E2E8F0;border-radius:8px;font-size:.74rem;color:#475569;margin-bottom:14px}
    .pomo-stats b{color:#0F172A;font-weight:800;font-size:.86rem}
    .pomo-stats .dots{display:inline-flex;gap:3px}
    .pomo-stats .dots span{width:8px;height:8px;border-radius:50%;background:#E2E8F0}
    .pomo-stats .dots span.on{background:#DC2626}
    /* Settings (durations) */
    .pomo-cfg{border-top:1px solid #F1F5F9;padding-top:12px}
    .pomo-cfg-tit{font-size:.66rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px}
    .pomo-cfg-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
    .pomo-cfg-fld{display:flex;flex-direction:column;gap:3px}
    .pomo-cfg-fld label{font-size:.66rem;font-weight:700;color:#64748B;text-transform:uppercase;letter-spacing:.04em}
    .pomo-cfg-fld input{padding:5px 8px;border:1px solid #E2E8F0;border-radius:5px;font-family:inherit;font-size:.78rem;color:#0F172A;background:#fff;text-align:center;font-weight:600}
    .pomo-cfg-fld input:focus{outline:none;border-color:#DC2626;box-shadow:0 0 0 3px rgba(220,38,38,.12)}
    .pomo-cfg-toggle{display:flex;align-items:center;gap:8px;margin-top:10px;font-size:.74rem;color:#475569;cursor:pointer}
    .pomo-cfg-toggle input{accent-color:#DC2626}

    /* Janela flutuante */
    .hp12-win{position:fixed;z-index:9999;width:500px;
              background:linear-gradient(180deg,#262626 0%,#1a1a1a 55%,#151515 100%);
              border-radius:22px;
              box-shadow:0 30px 80px rgba(0,0,0,.55),0 12px 28px rgba(0,0,0,.3),
                         inset 0 1px 0 rgba(255,255,255,.09),
                         inset 0 -1px 0 rgba(0,0,0,.6);
              font-family:'Helvetica Neue',Arial,sans-serif;user-select:none;
              padding:14px 18px 16px}
    .hp12-win.hidden{display:none}
    .hp12-win.off{filter:brightness(.35) saturate(.2)}

    /* Chrome do topo (HP + modelo + close + drag handle) */
    .hp12-chrome{display:flex;align-items:center;justify-content:space-between;
                 padding:2px 4px 10px;cursor:grab;position:relative}
    .hp12-chrome:active{cursor:grabbing}
    .hp12-brand{display:flex;align-items:center;gap:10px}
    .hp12-brand-hp{display:inline-flex;align-items:center;justify-content:center;
                    background:#df6f3d;color:#fff;font-weight:900;font-size:.78rem;
                    letter-spacing:-.02em;padding:2px 7px 3px;border-radius:2px;line-height:1}
    .hp12-brand-txt{display:flex;flex-direction:column;line-height:1}
    .hp12-brand-model{color:#efefef;font-weight:800;font-size:.92rem;letter-spacing:.02em}
    .hp12-brand-sub{color:#8a8a8a;font-weight:500;font-size:.56rem;letter-spacing:.12em;
                     text-transform:uppercase;margin-top:2px}
    .hp12-close{width:24px;height:24px;border-radius:50%;border:none;background:#2a2a2a;
                color:#bababa;cursor:pointer;display:flex;align-items:center;justify-content:center;
                font-size:1rem;line-height:1;transition:background .12s,color .12s;padding:0}
    .hp12-close:hover{background:#dc2626;color:#fff}

    /* Display LCD */
    .hp12-lcd{background:linear-gradient(180deg,#a8af9c 0%,#8e9783 60%,#818a77 100%);
              border-radius:5px;padding:11px 16px 10px;margin:2px 4px 12px;
              box-shadow:inset 0 3px 6px rgba(0,0,0,.55),inset 0 -1px 2px rgba(255,255,255,.22),
                         0 1px 0 rgba(255,255,255,.04);
              position:relative;min-height:44px;display:flex;align-items:center;justify-content:flex-end;
              overflow:hidden}
    .hp12-lcd-val{font-family:'Courier New','Lucida Console',monospace;font-weight:700;
                  font-size:1.52rem;letter-spacing:.12em;color:#141a12;line-height:1;
                  text-shadow:0 1px 0 rgba(255,255,255,.08)}
    .hp12-lcd-flags{position:absolute;left:12px;bottom:3px;display:flex;gap:10px;
                    font-family:'Courier New',monospace;font-size:.52rem;font-weight:700;
                    color:#141a12;letter-spacing:.15em;text-transform:uppercase;pointer-events:none}
    .hp12-lcd-flag{opacity:.15;transition:opacity .12s}
    .hp12-lcd-flag.on{opacity:.92}
    .hp12-lcd-flag.f{color:#c2641a}
    .hp12-lcd-flag.g{color:#24577f}

    /* Grid de teclas */
    .hp12-keys{display:grid;grid-template-columns:repeat(10,1fr);gap:12px 6px;padding:4px 4px 2px;
               margin-top:6px}

    /* Tecla base */
    .hp12-key{position:relative;
              background:linear-gradient(180deg,#3d3d3d 0%,#2b2b2b 55%,#1f1f1f 100%);
              border:1px solid #0a0a0a;border-radius:5px;padding:6px 3px 4px;cursor:pointer;
              box-shadow:0 2px 0 #0a0a0a,0 3px 5px rgba(0,0,0,.4),
                         inset 0 1px 0 rgba(255,255,255,.13),
                         inset 0 -1px 0 rgba(0,0,0,.5);
              display:flex;flex-direction:column;align-items:center;justify-content:center;
              min-height:38px;transition:transform .06s,box-shadow .06s,background .12s;
              font-family:'Helvetica Neue',Arial,sans-serif;outline:none}
    .hp12-key:hover{background:linear-gradient(180deg,#4a4a4a 0%,#353535 55%,#272727 100%)}
    .hp12-key:active,.hp12-key.pressed{transform:translateY(1px);
                                       box-shadow:0 1px 0 #0a0a0a,0 1px 2px rgba(0,0,0,.35),
                                                  inset 0 1px 0 rgba(255,255,255,.05)}

    /* Label principal (meio da tecla, branco) */
    .hp12-key-lbl{color:#fff;font-size:.74rem;font-weight:700;line-height:1;letter-spacing:-.01em;
                   text-align:center}
    .hp12-key-lbl sup{font-size:.75em;vertical-align:super;font-weight:700}
    .hp12-key-lbl sub{font-size:.75em;vertical-align:sub}

    /* Label g (azul claro, abaixo do label principal, no rodapé da tecla) */
    .hp12-key-g{color:#6bb2f0;font-size:.5rem;font-weight:800;letter-spacing:.03em;
                margin-top:2px;line-height:1;text-align:center;min-height:7px}

    /* Label f (laranja/dourado, flutuante acima da tecla — impresso na carcaça) */
    .hp12-key-f{position:absolute;top:-10px;left:0;right:0;text-align:center;
                color:#e89f4b;font-size:.5rem;font-weight:800;letter-spacing:.03em;
                line-height:1;pointer-events:none;white-space:nowrap}

    /* ENTER — 2 colunas, fonte menor */
    .hp12-key.enter{grid-column:span 2}
    .hp12-key.enter .hp12-key-lbl{font-size:.68rem;letter-spacing:.04em}

    /* 0 — 2 colunas (linha 4) */
    .hp12-key.wide-zero{grid-column:span 2}

    /* f/g como teclas especiais — laranja e azul-claro */
    .hp12-key.f-key .hp12-key-lbl{color:#e89f4b;font-size:.88rem}
    .hp12-key.g-key .hp12-key-lbl{color:#6bb2f0;font-size:.88rem}

    /* Operadores (÷, ×, −, +) levemente destacados */
    .hp12-key.op .hp12-key-lbl{font-size:1rem}

    /* ON em tom mais claro (é diferente no HP real) */
    .hp12-key.on-key{background:linear-gradient(180deg,#4a4a4a 0%,#333 55%,#242424 100%)}
    .hp12-key.on-key .hp12-key-lbl{font-size:.68rem;color:#e0e0e0}

    /* Tecla highlighted quando shift está ativo */
    .hp12-key.hl-f{box-shadow:0 0 0 2px #e89f4b,0 2px 0 #0a0a0a,0 3px 5px rgba(0,0,0,.4)}
    .hp12-key.hl-g{box-shadow:0 0 0 2px #6bb2f0,0 2px 0 #0a0a0a,0 3px 5px rgba(0,0,0,.4)}

    /* Foot (linha de modelo no rodapé da carcaça) */
    .hp12-foot{display:flex;align-items:center;justify-content:space-between;
               padding:10px 8px 0;color:#6e6e6e;font-size:.55rem;letter-spacing:.15em;
               text-transform:uppercase;margin-top:4px}
    .hp12-foot-left{font-weight:800;color:#a2a2a2}
    .hp12-foot-right{font-style:italic;color:#8a8a8a;letter-spacing:.1em}

    /* Tooltip de erro (Error 0, Error 4 etc.) — apenas estilizado via .hp12-lcd-val */
    .hp12-lcd-val.err{color:#5a1f1f;font-style:italic;font-size:1.2rem}

    /* Responsive: abaixo de 560px reduz */
    @media (max-width:560px){
      .hp12-win{width:calc(100vw - 32px);max-width:440px}
      .hp12-key{min-height:34px}
      .hp12-key-lbl{font-size:.68rem}
      .hp12-lcd-val{font-size:1.35rem}
    }
  </style>
</head>
