    .rec-kb-card-meta .pill .kb-pill-ava img{width:100%;height:100%;object-fit:cover;display:block}
    .rec-kb-card-meta .pill.notas{background:#FEF3C7;color:#92400E;cursor:help}
    .rec-kb-card-meta .pill.doc{background:#E0F2FE;color:#075985;font-variant-numeric:tabular-nums;
      max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    /* Timeline de notas no modal */
    .rec-kb-notas-list{max-height:240px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;
      padding:6px;background:#F8FAFC;border:1px solid #E5E7EB;border-radius:6px;margin-bottom:8px}
    .rec-kb-notas-list:empty{display:none}
    .rec-kb-nota{background:#fff;border:1px solid #E5E7EB;border-radius:6px;padding:8px 10px;
      display:flex;flex-direction:column;gap:4px;font-size:.78rem}
    .rec-kb-nota-hd{display:flex;align-items:center;justify-content:space-between;gap:8px}
    .rec-kb-nota-hd .ts{font-size:.68rem;color:#64748B;font-weight:600}
    .rec-kb-nota-del{background:transparent;border:none;color:#94A3B8;cursor:pointer;font-size:.85rem;
      padding:2px 5px;border-radius:4px;line-height:1}
    .rec-kb-nota-del:hover{background:#FEE2E2;color:#991B1B}
    .rec-kb-nota-text{font-size:.78rem;color:#1E293B;line-height:1.4;white-space:pre-wrap;word-break:break-word}
    .rec-kb-nota-anex-wrap{margin-top:2px}
    .rec-kb-nota-anex{padding:4px 9px;background:#EFF6FF;border:1px solid #93C5FD;border-radius:5px;
      cursor:pointer;font-size:.7rem;color:#1E40AF;font-family:inherit;display:inline-flex;align-items:center;gap:4px;font-weight:600}
    .rec-kb-nota-anex:hover{background:#DBEAFE;border-color:#3B82F6}
    .rec-kb-nota-form{display:flex;flex-direction:column;gap:6px;margin-top:6px}
    .rec-kb-nota-form textarea{padding:7px 10px;border:1px solid #CBD5E1;border-radius:6px;
      font-size:.82rem;font-family:inherit;background:#fff;width:100%;box-sizing:border-box;min-height:54px;resize:vertical}
    .rec-kb-nota-form textarea:focus{outline:none;border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.15)}
    .rec-kb-nota-form-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .rec-kb-nota-attach-btn{padding:5px 11px;background:#fff;border:1px solid #CBD5E1;border-radius:5px;
      cursor:pointer;font-size:.74rem;font-weight:600;font-family:inherit;color:#475569}
    .rec-kb-nota-attach-btn:hover{border-color:#7C3AED;color:#5B21B6}
    .rec-kb-nota-anexo-chip{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;
      background:#EFF6FF;border:1px solid #93C5FD;border-radius:5px;font-size:.72rem;color:#1E40AF;font-weight:600}
    .rec-kb-nota-anexo-chip button{background:transparent;border:none;color:#1E40AF;cursor:pointer;
      font-size:.85rem;padding:0 2px;line-height:1}
    .rec-kb-nota-anexo-chip button:hover{color:#991B1B}
    .rec-kb-nota-add-btn{padding:6px 14px;background:#7C3AED;border:1px solid #7C3AED;color:#fff;
      border-radius:5px;cursor:pointer;font-size:.76rem;font-weight:700;font-family:inherit}
    .rec-kb-nota-add-btn:hover{background:#6D28D9}
    /* Modal de preview de anexo */
    .rec-kb-anexo-modal{position:fixed;inset:0;background:rgba(15,23,42,.85);z-index:99999;
      display:flex;align-items:center;justify-content:center;padding:20px;flex-direction:column}
    .rec-kb-anexo-modal-content{flex:1;display:flex;align-items:center;justify-content:center;
      max-width:96vw;max-height:calc(100vh - 80px);overflow:auto}
    .rec-kb-anexo-modal-content img{max-width:100%;max-height:calc(100vh - 100px);object-fit:contain;
      border-radius:6px;background:#fff}
    .rec-kb-anexo-modal-content iframe{width:min(900px,96vw);height:calc(100vh - 100px);background:#fff;border-radius:6px}
    .rec-kb-anexo-modal-bar{margin-top:12px;display:flex;align-items:center;gap:10px;
      background:#fff;padding:9px 14px;border-radius:8px}
    .rec-kb-anexo-modal-bar .rec-kb-anexo-name{font-size:.78rem;color:#1E293B;font-weight:600}
    .rec-kb-anexo-modal-bar .dl{padding:6px 12px;background:#10B981;color:#fff;text-decoration:none;
      border-radius:5px;font-size:.76rem;font-weight:700}
    .rec-kb-anexo-modal-bar .dl:hover{background:#059669}
    .rec-kb-anexo-modal-bar .cl{padding:6px 12px;background:#fff;border:1px solid #CBD5E1;color:#475569;
      border-radius:5px;cursor:pointer;font-size:.76rem;font-weight:700;font-family:inherit}
    .rec-kb-anexo-modal-bar .cl:hover{background:#F1F5F9}
    /* ══ KASHBOARD INDICADORES 2.0 — hero + sparklines + status ══ */
    .ana-ind-wrap{display:flex;flex-direction:column;gap:14px;margin-bottom:16px}
    /* HERO — 3 cards grandes no topo (visão executiva) */
    .ana-hero-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
    .ana-hero{background:linear-gradient(135deg,#fff 0%,#FAFAFA 100%);
               border:1px solid #E5E7EB;border-radius:14px;padding:16px 18px;
               box-shadow:0 2px 8px rgba(15,23,42,.04);position:relative;overflow:hidden}
    .ana-hero::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px}
    .ana-hero.good::before{background:linear-gradient(180deg,#10B981,#059669)}
    .ana-hero.warn::before{background:linear-gradient(180deg,#F59E0B,#D97706)}
    .ana-hero.bad::before {background:linear-gradient(180deg,#EF4444,#DC2626)}
    .ana-hero.purp::before{background:linear-gradient(180deg,#A78BFA,#7C3AED)}
    .ana-hero.info::before{background:linear-gradient(180deg,#22D3EE,#0891B2)}
    .ana-hero-hd{display:flex;align-items:center;gap:8px;margin-bottom:8px}
    .ana-hero-hd .ico{font-size:1.1rem}
    .ana-hero-hd .lbl{font-size:.66rem;font-weight:800;color:#6B7280;
                       text-transform:uppercase;letter-spacing:.05em}
    .ana-hero-hd .help{margin-left:auto;color:#94A3B8;cursor:help;font-size:.95rem;
                        position:relative;line-height:1;display:inline-flex}
    .ana-hero-hd .help:hover{color:#4C1D95}
    .ana-hero-val{font-size:1.55rem;font-weight:900;color:#0F172A;line-height:1.05;
                   font-variant-numeric:tabular-nums;letter-spacing:-.02em}
    .ana-hero.good .ana-hero-val{color:#047857}
    .ana-hero.bad .ana-hero-val {color:#B91C1C}
    .ana-hero.warn .ana-hero-val{color:#B45309}
    .ana-hero.purp .ana-hero-val{color:#5B21B6}
    .ana-hero.info .ana-hero-val{color:#155E75}
    .ana-hero-meta{display:flex;align-items:center;gap:8px;margin-top:6px;flex-wrap:wrap}
    .ana-hero-meta .sub{font-size:.7rem;color:#6B7280;font-weight:600}
    .ana-hero-spark{margin-top:10px;height:38px;width:100%;display:block}
    /* Delta pill */
    .ana-delta{display:inline-flex;align-items:center;gap:3px;font-size:.66rem;
                font-weight:800;padding:2px 7px;border-radius:999px;letter-spacing:.02em;
                font-variant-numeric:tabular-nums;line-height:1.1}
    .ana-delta.up {background:#D1FAE5;color:#047857}
    .ana-delta.dn {background:#FEE2E2;color:#B91C1C}
    .ana-delta.neu{background:#F3F4F6;color:#6B7280}
    /* GROUPS — agora num grid responsivo, mais compactos */
    .ana-ind-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:12px}
    .ana-ind-group{background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:12px 14px}
    .ana-ind-group-hd{display:flex;align-items:center;gap:8px;margin-bottom:10px;
                       padding-bottom:8px;border-bottom:1px solid #F1F5F9}
    .ana-ind-group-hd h4{margin:0;font-size:.8rem;font-weight:800;color:#1E1B4B;letter-spacing:-.01em}
    .ana-ind-group-hd .ico{font-size:1rem}
    .ana-ind-group-hd small{margin-left:auto;font-size:.66rem;color:#9CA3AF;font-weight:600}
    .ana-ind-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
    .ana-ind{background:#F8FAFC;border:1px solid #E5E7EB;border-radius:8px;padding:9px 11px;
              border-left:3px solid #C4B5FD;position:relative;display:flex;flex-direction:column;gap:2px}
    .ana-ind .lbl{font-size:.6rem;font-weight:700;color:#6B7280;text-transform:uppercase;
                   letter-spacing:.04em;line-height:1.2;display:flex;align-items:center;gap:4px}
    .ana-ind .lbl .help{color:#94A3B8;cursor:help;font-size:.86rem;
                        position:relative;line-height:1;display:inline-flex}
    .ana-ind .lbl .help:hover{color:#4C1D95}
    .ana-ind .val{font-size:1rem;font-weight:800;color:#1F2937;line-height:1.15;
                   font-variant-numeric:tabular-nums;letter-spacing:-.01em}
    .ana-ind .sub{font-size:.62rem;color:#9CA3AF;font-weight:600;line-height:1.2}
    .ana-ind .delta{position:absolute;top:7px;right:9px}
    .ana-ind .ind-spark{margin-top:4px;height:18px;width:100%;display:block}
    .ana-ind.good{border-left-color:#10B981} .ana-ind.good .val{color:#047857}
    .ana-ind.warn{border-left-color:#F59E0B} .ana-ind.warn .val{color:#B45309}
    .ana-ind.bad {border-left-color:#DC2626} .ana-ind.bad .val{color:#B91C1C}
    .ana-ind.info{border-left-color:#0891B2} .ana-ind.info .val{color:#155E75}
    .ana-ind.purp{border-left-color:#7C3AED} .ana-ind.purp .val{color:#5B21B6}
    .ana-ind.pink{border-left-color:#EC4899} .ana-ind.pink .val{color:#BE185D}
    .ana-ind.amber{border-left-color:#F59E0B} .ana-ind.amber .val{color:#B45309}
    /* Status pill embaixo do indicador */
    .ana-ind .status{display:inline-block;font-size:.58rem;font-weight:800;padding:1px 6px;
                      border-radius:999px;letter-spacing:.04em;text-transform:uppercase}
    .ana-ind .status.ok  {background:#D1FAE5;color:#047857}
    .ana-ind .status.att {background:#FEF3C7;color:#92400E}
    .ana-ind .status.crit{background:#FEE2E2;color:#B91C1C}
    @media (max-width:900px){
      .ana-hero-grid{grid-template-columns:1fr}
      .ana-ind-grid{grid-template-columns:1fr}
    }
    /* ══ KASHBOARD CUSTOM — dashboard builder ══ */
    .ana-custom-toolbar{display:flex;align-items:center;gap:8px;margin-bottom:12px;
                         padding:10px 14px;background:#F8FAFC;border:1px solid #E5E7EB;
                         border-radius:10px;flex-wrap:wrap}
    .ana-cm-divider{width:1px;height:18px;background:#E5E7EB;margin:0 4px}

    /* Toggle de Status (Todos/Baixados/Em aberto) */
    .ana-status-toggle{display:inline-flex;background:#F3F4F6;border-radius:5px;padding:1px;gap:1px}
    .ana-status-btn{background:transparent;border:none;color:#6B7280;cursor:pointer;
                     padding:3px 8px;border-radius:4px;font-size:.65rem;font-weight:700;
                     font-family:inherit;letter-spacing:.02em;line-height:1.3;transition:all .12s}
    .ana-status-btn:hover:not(.active){background:#fff;color:#1F2937}
    .ana-status-btn.active[data-st="all"]{background:#7C3AED;color:#fff;box-shadow:0 1px 3px rgba(124,58,237,.25)}
    .ana-status-btn.active[data-st="baixado"]{background:#10B981;color:#fff;box-shadow:0 1px 3px rgba(16,185,129,.25)}
    .ana-status-btn.active[data-st="aberto"]{background:#F59E0B;color:#fff;box-shadow:0 1px 3px rgba(245,158,11,.25)}
    /* Toggle Edit/View */
    .ana-mode-toggle{display:inline-flex;background:#F3F4F6;border-radius:7px;padding:2px;gap:1px}
    .ana-mode-btn{background:transparent;border:none;color:#6B7280;cursor:pointer;
                   padding:5px 12px;border-radius:5px;font-size:.72rem;font-weight:700;
                   font-family:inherit;letter-spacing:.02em;line-height:1;transition:all .12s}
    .ana-mode-btn:hover:not(.active){background:#fff;color:#1F2937}
    .ana-mode-btn.active{background:#7C3AED;color:#fff;box-shadow:0 2px 4px rgba(124,58,237,.25)}
    /* MODO VIEW — esconde controles e biblioteca */
    .ana-custom-mode-view .ana-edit-only{display:none !important}
    .ana-custom-mode-view .ana-custom-sidebar{display:none}
    .ana-custom-mode-view .ana-custom-layout{grid-template-columns:1fr !important}
    .ana-custom-mode-view .ana-custom-canvas{background:transparent;border-color:transparent;padding:0}
    .ana-custom-mode-view .ana-custom-widget{box-shadow:0 2px 8px rgba(15,23,42,.06);
                                              border-color:#F1F5F9}
    .ana-custom-mode-view .ana-cw-hd{display:none}
    .ana-custom-mode-view .ana-custom-widget{cursor:default}
    .ana-custom-mode-view .ana-custom-widget[draggable]{pointer-events:auto}
    .ana-custom-mode-view .ana-custom-widget *{user-select:text}
    .ana-custom-mode-view .ana-cw-body{padding:14px 16px}
    .ana-cm-active{font-size:.72rem;color:#4C1D95;font-weight:700;
                    padding:4px 10px;background:#EDE9FE;border-radius:6px;
                    max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
                    border:1px solid #C4B5FD}
    .ana-cm-active.empty{color:#9CA3AF;background:#F3F4F6;border-color:#E5E7EB}
    /* Grid de previews dos modelos */
    .ana-model-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
    .ana-model-card{background:#fff;border:1px solid #E5E7EB;border-radius:10px;
                     padding:12px;display:flex;flex-direction:column;gap:8px;
                     transition:all .15s;position:relative}
    .ana-model-card:hover{border-color:#C4B5FD;box-shadow:0 4px 12px rgba(124,58,237,.12)}
    .ana-model-card.active{border-color:#7C3AED;background:#F5F3FF;
                            box-shadow:0 0 0 2px rgba(124,58,237,.15)}
    .ana-model-card.empty{border-style:dashed;background:#F9FAFB;
                           justify-content:center;align-items:center;min-height:170px;
                           color:#9CA3AF;font-style:italic;font-size:.82rem;cursor:pointer}
    .ana-model-card.empty:hover{border-color:#7C3AED;color:#5B21B6;background:#F5F3FF}
    .ana-model-hd{display:flex;align-items:center;gap:6px}
    .ana-model-name{flex:1;font-weight:800;font-size:.86rem;color:#1F2937;
                     padding:3px 6px;border:1px solid transparent;border-radius:5px;
                     font-family:inherit;background:transparent;
                     overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .ana-model-name:hover{background:#F9FAFB;border-color:#E5E7EB}
    .ana-model-name:focus{background:#fff;border-color:#7C3AED;outline:none;
                            box-shadow:0 0 0 2px rgba(124,58,237,.15)}
    .ana-model-meta{font-size:.66rem;color:#9CA3AF;font-weight:600;
                     display:flex;justify-content:space-between;align-items:center}
    .ana-model-active-badge{font-size:.58rem;font-weight:800;color:#fff;background:#7C3AED;
                             padding:2px 7px;border-radius:999px;letter-spacing:.04em}
    /* Mini preview do layout */
    .ana-model-preview{display:grid;grid-template-columns:repeat(4,1fr);gap:3px;
                        padding:8px;background:#F9FAFB;border:1px dashed #E5E7EB;
                        border-radius:6px;min-height:80px;align-content:start}
    .ana-model-pv-empty{grid-column:span 4;text-align:center;color:#CBD5E1;
                         font-style:italic;font-size:.7rem;padding:18px 0}
    .ana-model-pv-cell{padding:4px 5px;border-radius:3px;background:#fff;
                        border:1px solid #E5E7EB;font-size:.55rem;font-weight:700;
                        color:#475569;overflow:hidden;text-overflow:ellipsis;
                        white-space:nowrap;line-height:1.3;min-height:18px}
    .ana-model-pv-cell.hero {background:#A78BFA;color:#fff;border-color:#7C3AED}
    .ana-model-pv-cell.kpi  {background:#DBEAFE;color:#1E40AF;border-color:#93C5FD}
    .ana-model-pv-cell.chart{background:#D1FAE5;color:#065F46;border-color:#6EE7B7}
    .ana-model-pv-cell.cols-1{grid-column:span 1}
    .ana-model-pv-cell.cols-2{grid-column:span 2}
    .ana-model-pv-cell.cols-3{grid-column:span 3}
    .ana-model-pv-cell.cols-4{grid-column:span 4}
    .ana-model-actions{display:flex;gap:5px;flex-wrap:wrap}
    .ana-model-actions button{flex:1;min-width:0;padding:5px 8px;border:1px solid #E5E7EB;
                                border-radius:5px;background:#fff;color:#1F2937;cursor:pointer;
                                font-size:.7rem;font-weight:700;font-family:inherit;
                                transition:all .12s}
    .ana-model-actions button:hover{background:#F3F4F6;border-color:#9CA3AF}
    .ana-model-actions button.primary{background:#7C3AED;color:#fff;border-color:#7C3AED}
    .ana-model-actions button.primary:hover{background:#6D28D9}
    .ana-model-actions button.danger:hover{background:#FEE2E2;color:#B91C1C;border-color:#FCA5A5}
    /* Preview dos modelos do PIVOT */
    .ana-pm-preview{display:flex;flex-direction:column;gap:5px;background:#F9FAFB;
                     border:1px dashed #E5E7EB;border-radius:6px;padding:8px 10px;font-size:.7rem}
    .ana-pm-row{display:flex;align-items:center;gap:6px}
    .ana-pm-lbl{font-size:.6rem;font-weight:800;color:#6B7280;text-transform:uppercase;
                 letter-spacing:.04em;min-width:54px}
    .ana-pm-chips{display:flex;flex-wrap:wrap;gap:3px;flex:1}
    .ana-pm-chip{display:inline-block;padding:2px 7px;border-radius:4px;font-size:.62rem;
                  font-weight:700;letter-spacing:.02em}
    .ana-pm-chip-row{background:#DBEAFE;color:#1E40AF}
    .ana-pm-chip-col{background:#FEF3C7;color:#92400E}
    .ana-pm-chip-val{background:#D1FAE5;color:#065F46}
    .ana-pm-empty-chip{font-size:.62rem;color:#9CA3AF;font-style:italic}
    .ana-custom-layout{display:grid;grid-template-columns:1fr 220px;gap:12px;align-items:start}
    .ana-custom-layout.lib-collapsed{grid-template-columns:1fr 0px}
    .ana-custom-layout.lib-collapsed .ana-custom-sidebar{display:none}
    .ana-custom-canvas{display:grid;grid-template-columns:repeat(4, 1fr);
                        grid-auto-rows:120px;grid-auto-flow:row dense;gap:12px;
                        min-height:200px;background:#F9FAFB;border:1.5px dashed #CBD5E1;
                        border-radius:10px;padding:12px}
    .ana-custom-canvas.drop-active{border-color:#7C3AED;background:#F5F3FF}
    .ana-cw-placeholder{grid-column:span 1;background:linear-gradient(135deg,
                          rgba(124,58,237,.18) 0%, rgba(124,58,237,.08) 100%);
                          border:2px dashed #7C3AED;border-radius:10px;
                          min-height:80px;display:flex;align-items:center;justify-content:center;
                          color:#7C3AED;font-size:.66rem;font-weight:800;
                          text-transform:uppercase;letter-spacing:.05em;
                          animation:phPulse 1s ease-in-out infinite;
                          /* CRÍTICO: não intercepta eventos de drag — deixa passar pro canvas */
                          pointer-events:none}
    .ana-cw-placeholder::before{content:'soltar aqui'}
    @keyframes phPulse{
      0%,100%{ background:rgba(124,58,237,.18) }
      50%   { background:rgba(124,58,237,.28) }
    }
    /* Library sidebar */
    .ana-custom-sidebar{background:#fff;border:1px solid #E5E7EB;border-radius:10px;
                         padding:12px;position:sticky;top:12px;
                         max-height:calc(100vh - 180px);display:flex;flex-direction:column}
    .ana-sidebar-hd{display:flex;align-items:baseline;justify-content:space-between;
                     margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid #F1F5F9}
    .ana-sidebar-hd h4{margin:0;font-size:.78rem;font-weight:800;color:#1E1B4B;letter-spacing:-.01em}
    .ana-sidebar-hd small{font-size:.62rem;color:#9CA3AF;font-weight:600}
    .ana-sidebar-tabs{display:flex;gap:2px;background:#F3F4F6;border-radius:6px;padding:2px;margin-bottom:8px}
    .ana-sidebar-cat{flex:1;background:transparent;border:none;color:#6B7280;cursor:pointer;
                      padding:5px 6px;border-radius:4px;font-size:.7rem;font-weight:700;
                      font-family:inherit;line-height:1;transition:all .12s}
    .ana-sidebar-cat:hover:not(.active){background:#fff;color:#1F2937}
    .ana-sidebar-cat.active{background:#7C3AED;color:#fff}
    .ana-sidebar-list{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:4px;
                       padding-right:4px}
    .ana-sidebar-list::-webkit-scrollbar{width:6px}
    .ana-sidebar-list::-webkit-scrollbar-thumb{background:#CBD5E1;border-radius:3px}
    .ana-lib-chip{display:flex;align-items:center;gap:6px;padding:6px 8px;
                   background:#F8FAFC;border:1px solid #E5E7EB;border-radius:6px;
                   cursor:grab;font-family:inherit;font-size:.7rem;font-weight:600;
                   color:#1F2937;transition:all .12s;text-align:left;user-select:none;
                   line-height:1.2}
    .ana-lib-chip:hover{background:#EDE9FE;border-color:#C4B5FD;color:#4C1D95;transform:translateX(2px)}
    .ana-lib-chip:active{cursor:grabbing}
    .ana-lib-chip.dragging{opacity:.4}
