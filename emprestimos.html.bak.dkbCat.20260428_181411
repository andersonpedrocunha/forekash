function _repUpdatePreview(prefix){
  const mode = document.getElementById(prefix + '-fld-rep-mode')?.value || 'once';
  // Acha a data: para ext usa ext-fld-data, para dkb/rec usa o vencimento ou hoje
  let dataStr = '';
  if(prefix === 'ext'){
    dataStr = (document.getElementById('ext-fld-data')?.value || '').trim();
  } else if(prefix === 'dkb'){
    dataStr = (document.getElementById('dkb-fld-venc')?.value || '').trim();
  } else if(prefix === 'rec'){
    dataStr = (document.getElementById('rec-kb-fld-venc')?.value || '').trim();
  }
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dataStr);
  if(!m) return;
  const MES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  let preview = '';
  if(mode === 'multi'){
    const n = parseInt(document.getElementById(prefix + '-fld-rep-count')?.value, 10) || 1;
    const freq = document.getElementById(prefix + '-fld-rep-freq-multi')?.value || 'mensal';
    const f = _EXT_FREQ.find(x => x.id === freq);
    if(f && n > 0){
      const inicio = new Date(parseInt(m[1],10), parseInt(m[2],10)-1, 1);
      const ultimoMes = inicio.getMonth() + (n-1)*f.mes;
      const ultY = inicio.getFullYear() + Math.floor(ultimoMes/12);
      const ultM = ((ultimoMes % 12) + 12) % 12;
      preview = MES[parseInt(m[2],10)-1] + '/' + m[1].slice(2) + ' → ' + MES[ultM] + '/' + String(ultY).slice(2);
    }
    const el = document.getElementById(prefix + '-rep-preview-multi');
    if(el) el.textContent = preview ? '⤳ ' + preview : '—';
  } else if(mode === 'always'){
    const freq = document.getElementById(prefix + '-fld-rep-freq-always')?.value || 'mensal';
    const f = _EXT_FREQ.find(x => x.id === freq);
    if(f){
      const yIni = parseInt(m[1],10);
      const yFim = yIni + 4;
      preview = MES[parseInt(m[2],10)-1] + '/' + m[1].slice(2) + ' → dez/' + String(yFim).slice(2) + ' (' + f.lbl.toLowerCase() + ')';
    }
    const el = document.getElementById(prefix + '-rep-preview-always');
    if(el) el.textContent = preview ? '⤳ ' + preview : '—';
  }
}
// Lê config atual, retorna { mode, freq, count }
function _repReadCfg(prefix, dataStr){
  const mode = document.getElementById(prefix + '-fld-rep-mode')?.value || 'once';
  let freq = 'mensal', count = 1;
  if(mode === 'multi'){
    count = Math.max(1, Math.min(60, parseInt(document.getElementById(prefix + '-fld-rep-count')?.value, 10) || 1));
    freq = document.getElementById(prefix + '-fld-rep-freq-multi')?.value || 'mensal';
  } else if(mode === 'always'){
    freq = document.getElementById(prefix + '-fld-rep-freq-always')?.value || 'mensal';
    const f = _EXT_FREQ.find(x => x.id === freq);
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dataStr || '');
    if(f && m){
      const yIni = parseInt(m[1],10);
      const inicio = new Date(yIni, parseInt(m[2],10)-1, 1);
      const fim = new Date(yIni + 4, 11, 1);
      const diffMeses = (fim.getFullYear()-inicio.getFullYear())*12 + (fim.getMonth()-inicio.getMonth());
      count = Math.max(1, Math.floor(diffMeses / f.mes) + 1);
    }
  }
  return { mode, freq, count };
}
