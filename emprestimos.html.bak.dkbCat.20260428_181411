const parseBR= s => {
  if(s===''||s==null)return '';
  const str = s.toString().trim();
  if(str.startsWith('=')){
    const r = evalSimpleFormula(str);
    return r.ok ? r.value : '';
  }
  const n=parseFloat(str.replace(/\./g,'').replace(',','.'));
  return isNaN(n)?'':n;
};

// ─── Seleção de células em fórmulas + preview flutuante + recálculo automático ───
// Enquanto o input ativo tem valor começando com "=":
//   · clique numa célula [data-cellref]  → insere [ref:ID] no cursor
//   · arraste por várias células         → insere SOMA([ref:A];[ref:B];…) no cursor
//   · tooltip flutuante mostra o resultado do cálculo em tempo real
//   · células referenciadas ficam destacadas (outline âmbar)
// Após blur, agenda __recomputeAllFormulas() (fixed-point, cap=6) que propaga mudanças.
let __formulaActiveInput = null;
let __formulaRecomputing = false;
