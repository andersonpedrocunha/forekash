function anaArchiveView(id){
  // Abre apresentação arquivada no modo apresentar (read-only) sem mexer no estado
  _anaInitSavedStores();
  const p = _anaState.archive.find(x => x.id === id);
  if(!p) return;
  const slides = p.slides || [];
  if(slides.length === 0){ if(typeof toast === 'function') toast('Apresentação vazia'); return; }
  // Define override — presenter usará isso em vez de _anaState.presentation.slides
  _anaPresentOverride = {
    name: p.name,
    slides: JSON.parse(JSON.stringify(slides)),
    idx: 0
  };
  anaArchiveClose();
  // Aciona presenter (que vai detectar o override)
  _anaPresentSlidesGetter = () => _anaPresentOverride.slides;
  _anaPresentIdxGetter   = () => _anaPresentOverride.idx;
  _anaPresentIdxSetter   = (v) => { _anaPresentOverride.idx = v; };
  // Inicia
  _anaState.presentation.presenting = true;
  const fs = document.getElementById('ana-present-fs');
  if(fs) fs.style.display = 'flex';
  document.addEventListener('keydown', _anaPresentKeyHandler);
  try { (fs.requestFullscreen || fs.webkitRequestFullscreen || (()=>{})).call(fs); } catch(e){}
  _anaPresentRenderSlide();
  if(typeof toast === 'function') toast('▶ Abrindo "' + p.name + '" (somente leitura)');
}
