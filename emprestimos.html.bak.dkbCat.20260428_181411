        + '<button type="button" onclick="diagScopeNone()" style="padding:5px 10px;background:#fff;border:1px solid #E2E8F0;border-radius:5px;cursor:pointer;font-family:inherit;font-weight:600;color:#475569">Nenhum</button>'
