  } else {
    for(const v of filtered){
      const isSel = validSel.has(v);
      const safeV = v.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
      listHtml += '<button type="button" class="ext-multi-opt' + (isSel ? ' is-sel' : '') + '" '
        + 'onclick="event.stopPropagation();_extMultiToggleVal(\'' + kind + '\',\'' + safeV + '\')">'
        + '<span class="chk"></span>'
