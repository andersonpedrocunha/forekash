function _anaPivotBuildMatrix(){
  // Reusa o engine pra obter rowKeys, colKeys, matrix
  const cfg = _anaState.pivot;
  const facts = _anaCollectFacts();
  if(facts.length === 0 || cfg.values.length === 0){
    return { error: 'Sem dados ou sem métricas configuradas' };
  }
  const piv = _anaPivot(facts, cfg.rows, cfg.cols, cfg.values);
  return { cfg, piv, facts };
}
function _anaPeriodoStr(){
  const m = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
  const de = m[_anaState.mesDe] + '/' + String(_anaState.anoDe).slice(2);
  const ate= m[_anaState.mesAte] + '/' + String(_anaState.anoAte).slice(2);
  return de + ' → ' + ate;
}
function _anaCsvEsc(s){
  const t = String(s == null ? '' : s);
  return /[";\n\r]/.test(t) ? '"' + t.replace(/"/g, '""') + '"' : t;
}
function _anaCsvNum(n){
  if(n == null || isNaN(n)) return '';
  return (Math.round(n * 100) / 100).toString().replace('.', ',');
}
function anaPivotExportCSV(){
  const r = _anaPivotBuildMatrix();
  if(r.error){ if(typeof toast === 'function') toast('⚠️ ' + r.error); return; }
  const { cfg, piv } = r;
  const lines = [];
  // Cabeçalho meta
  lines.push(['KASHBOARD — Pivot exportado'].map(_anaCsvEsc).join(';'));
  lines.push(['Período', _anaPeriodoStr()].map(_anaCsvEsc).join(';'));
  lines.push(['Status filtro', _anaState.statusFilter || 'all'].map(_anaCsvEsc).join(';'));
  lines.push(['Módulos', _anaState.modulos.join(', ')].map(_anaCsvEsc).join(';'));
  lines.push(['Gerado em', new Date().toLocaleString('pt-BR')].map(_anaCsvEsc).join(';'));
  lines.push('');
  // Header da tabela
  const headerRow = [];
  cfg.rows.forEach(rid => {
    const f = ANA_FIELDS.find(x => x.id === rid);
    headerRow.push(f ? f.label : rid);
  });
  if(cfg.rows.length === 0) headerRow.push('—');
  for(const ck of piv.colKeys){
    cfg.values.forEach(vd => {
      const f = ANA_FIELDS.find(x => x.id === vd.field);
      const lbl = (cfg.cols.length > 0 ? ck + ' · ' : '') + (f?f.label:vd.field) + ' (' + (ANA_AGG_LBL[vd.agg]||vd.agg) + ')';
      headerRow.push(lbl);
    });
  }
  lines.push(headerRow.map(_anaCsvEsc).join(';'));
  // Body
  for(const rk of piv.rowKeys){
    const row = [];
    if(cfg.rows.length > 0){
      String(rk).split(' | ').forEach(p => row.push(p));
    } else row.push('Total');
    for(const ck of piv.colKeys){
      const arr = piv.matrix[rk] && piv.matrix[rk][ck] ? piv.matrix[rk][ck] : [];
      arr.forEach(v => row.push(_anaCsvNum(v)));
    }
    lines.push(row.map(_anaCsvEsc).join(';'));
  }
  // Tfoot — totais por coluna
  const totRow = [];
  if(cfg.rows.length > 0){
    cfg.rows.forEach((_,i) => totRow.push(i===0?'Total':''));
  } else totRow.push('Total');
  for(const ck of piv.colKeys){
    cfg.values.forEach((vd,i) => {
      let tot = 0, hasAny = false;
      for(const rk of piv.rowKeys){
        const v = piv.matrix[rk] && piv.matrix[rk][ck] && piv.matrix[rk][ck][i];
        if(v != null){ tot += v; hasAny = true; }
      }
      totRow.push(hasAny ? _anaCsvNum(tot) : '');
    });
  }
  lines.push(totRow.map(_anaCsvEsc).join(';'));
  // Download — BOM utf-8 pro Excel
  const csv = '\ufeff' + lines.join('\r\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'kashboard-pivot-' + new Date().toISOString().slice(0,10) + '.csv';
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 100);
  if(typeof toast === 'function') toast('✅ CSV exportado');
}
