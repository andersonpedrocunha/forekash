//  PERSISTENCE + MIGRATION
// ═══════════════════════════════════════════════════
function migrate(l){
  l.parcelaVal    = l.parcelaVal    ?? '';
  l.parcelaHist   = l.parcelaHist   ?? [];
  l.parcelasPagas = l.parcelasPagas ?? '';
  l.saldoHist     = l.saldoHist     ?? [];
  l.bancoManual   = l.bancoManual   ?? '';
  l.tipo          = l.tipo          ?? 'price'; // 'price' | 'sac' | <id de modalidade customizada>
  l.contratos     = l.contratos     ?? [];      // [{name,type,data,size,ts}]
  l.inicio        = l.inicio        ?? '';      // YYYY-MM-DD — primeira data de pagamento (carência). Vazio = começa já.
  l.registros     = l.registros     ?? [];      // [{mes, parcelaEfetivada, jurosEfetivado, amortEfetivada, saldoEfetivado, extras:[...], ts}]
  // Garante que cada registro tem array de extras (lançamentos adicionais do mês)
  for(const r of l.registros){
    if(!Array.isArray(r.extras)) r.extras = [];
    // Cada extra: { id, tipo:'parcela_extra'|'amort_parcial', parcela, juros, amort, descricao, ts }
    for(const ex of r.extras){
      if(!ex.id) ex.id = 'ex_' + Math.random().toString(36).slice(2,8);
      if(!ex.tipo) ex.tipo = 'parcela_extra';
    }
  }
  return l;
}

function loadData(){
  let raw = localStorage.getItem(KEY_NOW);
  if(!raw){ for(const k of KEY_OLD){ raw=localStorage.getItem(k); if(raw)break; } }
  try{
    if(raw){
      const d=JSON.parse(raw);
      loans  = (d.loans||[]).map(migrate);
      nextId = d.nextId || (loans.reduce((m,l)=>Math.max(m,l.id||0),0)+1);
      saveData();
    }
  }catch(e){ loans=[]; nextId=1; }
  loanModalidadesLoad();
  render();
}

function saveData(){
  try{
    localStorage.setItem(KEY_NOW,JSON.stringify({loans,nextId,savedAt:new Date().toISOString()}));
  }catch(e){ toast('⚠️ Erro ao salvar dados',4000); }
}

// ─── Modalidades (Price, SAC + customizadas) ───
function loanModalidadesLoad(){
  try{
    const raw = localStorage.getItem(LOAN_MODALIDADES_KEY);
    if(raw){
      const parsed = JSON.parse(raw);
      if(Array.isArray(parsed)) loanModalidades = parsed;
    }
  }catch(e){ loanModalidades = []; }
  if(!Array.isArray(loanModalidades)) loanModalidades = [];
  // Garante que Price e SAC sempre existem (no começo, e nessa ordem)
  const byId = new Map(loanModalidades.map(m => [m.id, m]));
  const result = [];
  for(const def of LOAN_MODALIDADES_BUILTIN){
    const existing = byId.get(def.id);
    if(existing){
      existing.builtin = true;
      existing.nome    = def.nome;  // Nome fixo p/ builtins
      existing.engine  = def.engine;
      result.push(existing);
      byId.delete(def.id);
    } else {
      result.push({...def});
    }
  }
  // Anexa as não-builtin preservando ordem original
  const VALID_ENGINES = new Set(['price','sac']);
  for(const m of loanModalidades){
    if(!LOAN_MODALIDADES_BUILTIN.some(b => b.id === m.id)){
      m.engine  = VALID_ENGINES.has(m.engine) ? m.engine : 'price';
      m.builtin = false;
      result.push(m);
    }
  }
  loanModalidades = result;
  // Migração do demo/legacy: "pronampe" preservado com engine price
  loansMigrateModalidades();
  loanModalidadesSave();
}

function loanModalidadesSave(){
  try{ localStorage.setItem(LOAN_MODALIDADES_KEY, JSON.stringify(loanModalidades)); }catch(e){}
}

function loansMigrateModalidades(){
  const known = new Set(loanModalidades.map(m => m.id));
  for(const l of (loans||[])){
    const t = (l && l.tipo) ? String(l.tipo).toLowerCase() : '';
    if(!t){ l.tipo = 'price'; continue; }
    if(known.has(t)) continue;
    // Cria modalidade custom preservando o nome original
    const nome = t.charAt(0).toUpperCase() + t.slice(1);
    loanModalidades.push({ id:t, nome, engine:'price', builtin:false });
    known.add(t);
  }
}

function getLoanModalidade(id){
  return loanModalidades.find(m => m.id === id) || null;
}
function getLoanEngine(tipoId){
  const m = getLoanModalidade(tipoId);
  if(m) return m.engine || 'price';
  // Fallback para strings legadas sem registry
  if(tipoId === 'sac') return 'sac';
  return 'price';
}
function isSACEngine(tipoId){ return getLoanEngine(tipoId) === 'sac'; }
function getModalidadeClass(tipoId){
  const m = getLoanModalidade(tipoId);
  if(!m) return getLoanEngine(tipoId); // cai nos builtins por fallback
  if(m.builtin) return m.id;           // 'price' | 'sac'
  return 'custom';
}
function getModalidadeNome(tipoId){
  const m = getLoanModalidade(tipoId);
  return m ? m.nome : (tipoId || 'Price');
}

