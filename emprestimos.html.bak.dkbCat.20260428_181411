async function catmapDelete(id){
  const c = catmapById(id); if(!c) return;
  // Se for userCreated (criada via modal), deleta tag em estrutura.tags e entrada catmap.
  // Se for puramente manual (não é userCreated), só remove a entrada catmap.
  // Bloqueadas (autoDiscovered sem userCreated) não passam por aqui — o botão nem aparece.
  if(_catmapIsLocked(c)) return;
  // Conta uso: itens em estrutura.itens vinculados a essa tag
  let usos = 0;
  let tagId = null;
  if(c.userCreated && c.moduloId === 'estrutura' && typeof estrutura !== 'undefined' && estrutura){
    if(Array.isArray(estrutura.tags)){
      const tag = estrutura.tags.find(t => (t.nome||'').trim().toLowerCase() === (c.nome||'').trim().toLowerCase());
      if(tag) tagId = tag.id;
    }
    if(tagId != null && Array.isArray(estrutura.itens)){
      usos = estrutura.itens.filter(it => it.tagId === tagId).length;
    }
  }
  const useFn = (typeof _dkbConfirm === 'function') ? _dkbConfirm : null;
  const usoMsg = usos > 0
    ? ('<div class="dkb-confirm-meta">⚠ <b>' + usos + '</b> lançamento(s) usam esta categoria. Eles ficarão sem tag (precisarão ser recategorizados).</div>')
    : '';
  if(useFn){
    const ok = await useFn({
      icon: '🗑',
      title: 'Excluir categoria?',
      html: 'Excluir <b>"' + _extEsc(c.nome) + '"</b>?' + usoMsg
        + '<div class="dkb-confirm-meta" style="color:#475569">A tag em Estrutura também será removida.</div>',
      okText: 'Sim, excluir',
      cancelText: 'Cancelar'
    });
    if(!ok) return;
  } else {
    if(!confirm('Excluir categoria "' + c.nome + '"?' + (usos > 0 ? ' (' + usos + ' lançamentos afetados)' : ''))) return;
  }
  // Remove tag em estrutura (se userCreated)
  if(c.userCreated && tagId != null && typeof estrutura !== 'undefined'){
    estrutura.tags = (estrutura.tags || []).filter(t => t.id !== tagId);
    // Itens usando essa tag ficam órfãos (tagId não bate com nenhuma tag) — fica visível em vermelho
    // mas o user pode recategorizar manualmente
    if(typeof estSave === 'function') estSave();
  }
  // Remove entry no catmap
  catmapData.categorias = (catmapData.categorias || []).filter(x => x.id !== id);
  _catmapSave();
  catmapRender();
  if(typeof toast === 'function') toast('Categoria excluída');
}

