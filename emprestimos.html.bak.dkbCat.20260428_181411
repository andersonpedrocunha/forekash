// Calcula indicadores extras (que não estão em _anaCalcKPIs) e monta a grade
function _anaCalcIndicadoresExtra(k, facts){
  const meses = (_anaState.anoAte*12 + _anaState.mesAte) - (_anaState.anoDe*12 + _anaState.mesDe) + 1;
  const out = {};
  out.meses = meses;
  out.burnMes = meses > 0 ? (k.folha + k.estrutura + k.comissoes + k.loans) / meses : 0;
  out.receitaMes = meses > 0 ? k.receita / meses : 0;
  out.ticketMedio = k.clientesAtivos > 0 ? k.receita / k.clientesAtivos : 0;
  out.ticketMensal = (k.clientesAtivos > 0 && meses > 0) ? (k.receita / k.clientesAtivos / meses) : 0;
  out.receitaPorFunc = k.headcount > 0 ? k.receita / k.headcount : 0;
  out.custoPorFunc   = k.headcount > 0 ? k.folha / k.headcount : 0;
  out.salarioMedio   = k.headcount > 0 ? (out.receitaMes > 0 ? k.folha / k.headcount / meses : 0) : 0;
  out.pctFolha       = k.receita > 0 ? (k.folha / k.receita * 100) : 0;
  out.pctEstrutura   = k.receita > 0 ? (k.estrutura / k.receita * 100) : 0;
  out.pctComissoes   = k.receita > 0 ? (k.comissoes / k.receita * 100) : 0;
  out.pctLoans       = k.receita > 0 ? (k.loans / k.receita * 100) : 0;
  out.cashConversion = k.receita > 0 ? (k.saldo / k.receita * 100) : 0;
  out.breakEven      = k.receita > 0 ? ((k.folha + k.estrutura + k.comissoes) / k.receita * 100) : 0;
  out.totalCustos    = k.folha + k.estrutura + k.comissoes + k.loans;

  // ═══ CAC do período — soma de meses com % por linha (config Customizações) ═══
  // Usa o mesmo motor usado em Customizações > Indicadores customizados
  out.cacDespTotal = 0;
  out.cacNovos = 0;
  out.cac = 0;
  try {
    if(typeof _cacLoad === 'function') _cacLoad();
    if(typeof _cacTotalEstrutura === 'function' && typeof _cacTotalPessoas === 'function' && typeof _cacNovosClientes === 'function'){
      const yms = _anaPeriodYms();
      for(const ym of yms){
        out.cacDespTotal += _cacTotalEstrutura(ym) + _cacTotalPessoas(ym);
        out.cacNovos     += _cacNovosClientes(ym);
      }
      out.cac = out.cacNovos > 0 ? out.cacDespTotal / out.cacNovos : 0;
      // LTV/CAC se LTV existe
      out.ltvCac = (out.cac > 0 && k.ltv > 0) ? (k.ltv / out.cac) : 0;
      // Payback aproximado (em meses): CAC / ticket mensal médio
      out.cacPayback = (out.cac > 0 && out.ticketMensal > 0) ? (out.cac / out.ticketMensal) : 0;
    }
  } catch(e){ console.warn('CAC calc:', e); }


  // Crescimento MoM (atual vs mês anterior do filtro) e YoY (último mês vs mesmo do ano anterior)
  // Receita por mês
  const yms = _anaPeriodYms();
  const recPorMes = yms.map(ym => facts.filter(f => f.modulo==='receita' && f.ym===ym)
                                        .reduce((s,f) => s + (parseFloat(f.valor)||0), 0));
  out.momPct = (recPorMes.length >= 2 && recPorMes[recPorMes.length-2] > 0)
    ? ((recPorMes[recPorMes.length-1] - recPorMes[recPorMes.length-2]) / recPorMes[recPorMes.length-2] * 100)
    : 0;
  // YoY: comparar mesma janela ano anterior
  if(typeof receita !== 'undefined' && receita && receita.years){
    let recPrevYr = 0;
    const MESES_NM = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
    _anaIterPeriodo((y, m) => {
      const prevY = String(parseInt(y,10) - 1);
      const yData = receita.years[prevY]; if(!yData) return;
      for(const cli of (yData.clients || [])){
        const cell = (cli.meses || {})[MESES_NM[m]];
        if(cell) recPrevYr += parseFloat(cell.valor) || 0;
      }
    });
    out.recYoyPrev = recPrevYr;
    out.yoyPct = recPrevYr > 0 ? ((k.receita - recPrevYr) / recPrevYr * 100) : 0;
  } else { out.recYoyPrev = 0; out.yoyPct = 0; }
  return out;
}

// SVG sparkline — gera path simples a partir de array de números
function _anaSpark(values, opts){
  const o = opts || {};
  const w = o.w || 100, h = o.h || 36;
  const stroke = o.stroke || '#7C3AED';
  const fill = o.fill || 'rgba(124,58,237,.12)';
  if(!values || values.length < 2){
    return '<svg class="' + (o.cls||'') + '" viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none"></svg>';
  }
  const min = Math.min(...values, 0);
  const max = Math.max(...values, 0);
  const range = (max - min) || 1;
  const stepX = w / (values.length - 1);
  const yOf = v => h - 2 - ((v - min) / range) * (h - 4);
  let d = '';
  values.forEach((v, i) => { d += (i===0 ? 'M' : 'L') + (i*stepX).toFixed(1) + ',' + yOf(v).toFixed(1) + ' '; });
  const dArea = d + 'L' + ((values.length-1)*stepX).toFixed(1) + ',' + h + ' L0,' + h + ' Z';
  // ponto final destacado
  const lastX = ((values.length-1)*stepX).toFixed(1);
  const lastY = yOf(values[values.length-1]).toFixed(1);
  return '<svg class="' + (o.cls||'') + '" viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none">'
       + '<path d="' + dArea + '" fill="' + fill + '" stroke="none"/>'
       + '<path d="' + d + '" fill="none" stroke="' + stroke + '" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>'
       + '<circle cx="' + lastX + '" cy="' + lastY + '" r="2.2" fill="' + stroke + '"/>'
       + '</svg>';
}

// Calcula séries por mês pra cada métrica — usado pra sparklines + delta
function _anaCalcSeries(facts){
  const yms = _anaPeriodYms();
  const sumMod = (mod) => yms.map(ym => facts.filter(f => f.modulo===mod && f.ym===ym).reduce((s,f) => s + (parseFloat(f.valor)||0), 0));
  const recMes = sumMod('receita');
  const folMes = sumMod('pessoas');
  const estMes = sumMod('estrutura');
  const comMes = sumMod('comissoes');
  const lnsMes = sumMod('loans');
  const ebitMes = recMes.map((r,i) => r - folMes[i] - estMes[i] - comMes[i]);
  // Saldo por mês (snapshot do dispo)
  const saldoMes = yms.map(ym => {
    let s = 0;
    if(typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.contas)){
      for(const c of dispo.contas) s += parseFloat((c.saldos||{})[ym]) || 0;
    }
    return s;
  });
  // Headcount por mês
  const hcMes = yms.map(ym => {
    let c = 0;
    if(typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.people)){
      for(const p of pessoas.people){
        if(p.sim || p.ativo === false) continue;
        if((p.salarios||{})[ym] && parseFloat(p.salarios[ym]) > 0) c++;
      }
    }
    return c;
  });
  // Clientes ativos por mês
  const cliSet = yms.map(ym => new Set(facts.filter(f => f.modulo==='receita' && f.ym===ym).map(f => f.entidade)));
  const cliMes = cliSet.map(s => s.size);
  return { yms, recMes, folMes, estMes, comMes, lnsMes, ebitMes, saldoMes, hcMes, cliSet, cliMes };
}

// Compara últimos N meses vs N meses anteriores pra calcular delta
function _anaDeltaSerie(serie){
  const n = serie.length;
  if(n < 2) return { pct:0, dir:'neu' };
  // Usa metade vs metade (se n grande) ou último vs anterior
  if(n >= 4){
    const half = Math.floor(n/2);
    const sumPrev = serie.slice(0, half).reduce((s,v)=>s+v,0);
    const sumCur  = serie.slice(half).reduce((s,v)=>s+v,0);
    if(sumPrev === 0) return { pct:0, dir:'neu' };
    const pct = (sumCur - sumPrev) / Math.abs(sumPrev) * 100;
    return { pct, dir: Math.abs(pct) < 1 ? 'neu' : (pct > 0 ? 'up' : 'dn') };
  }
  const a = serie[n-1], b = serie[n-2];
  if(b === 0) return { pct:0, dir:'neu' };
  const pct = (a - b) / Math.abs(b) * 100;
  return { pct, dir: Math.abs(pct) < 1 ? 'neu' : (pct > 0 ? 'up' : 'dn') };
}

