function mrcashConfianca(ml){
  const fc = ml && ml.forecast && ml.forecast.receita;
  if(!fc) return `A projeção (modelo Regressão+Holt) só é treinada quando você roda o diagnóstico. <br><br>Sem ela, posso te mostrar dados factuais (saldo, folha, dívida, taxa, etc) — mas o forecast em si fica disponível depois de gerar o diagnóstico no módulo <b>Diagnóstico</b>.`;
  const r2Pct = Math.round(fc.r2*100);
  const qual = r2Pct > 70 ? 'forte' : (r2Pct > 40 ? 'moderado' : 'fraco');
  let msg = `O <b>R²</b> mede o quanto a tendência histórica "explica" a variação da receita: vai de 0 (nada) a 1 (perfeito). `;
  msg += `No seu caso, R²=<code>${fc.r2.toFixed(2)}</code> → ajuste <em>${qual}</em> (${r2Pct}%).`;
  if(r2Pct >= 70) msg += `<br><br>Isso quer dizer que a reta captura bem o padrão — a projeção para os próximos meses é <b>relativamente confiável</b> se nada mudar dramaticamente.`;
  else if(r2Pct >= 40) msg += `<br><br>O modelo explica parte do padrão mas há ruído relevante. Use a projeção como cenário base, mas considere o intervalo de confiança (±${fmtBRL(1.5*fc.rmse)}) — pode variar bastante.`;
  else msg += `<br><br>Com R² baixo, a receita tem <b>variância grande que o modelo não captura</b>. Pode ser poucos pontos, ciclos fortes, ou entrada/saída de clientes grandes. Trate a projeção como <em>direção</em>, não como número final.`;
  return msg;
}

function mrcashModelo(ml){
  const fc = ml && ml.forecast && ml.forecast.receita;
  if(!fc) return 'Ainda não treinei modelo de receita — faltam dados.';
  let msg = `Uso um <b>ensemble</b> (combinação ponderada) de dois modelos clássicos:<ul>`;
  msg += `<li><b>Regressão Linear</b>: ajusta a melhor reta <code>y = a + b·x</code> por mínimos quadrados. Captura tendência de longo prazo.</li>`;
  msg += `<li><b>Holt (suavização exponencial dupla)</b>: suaviza nível + tendência com pesos que caem exponencialmente no tempo. Reage mais rápido a mudanças recentes.</li>`;
  msg += `</ul>A previsão final é uma <b>média ponderada</b> dos dois — quando o R² da regressão é alto, ela pesa mais; quando não, o Holt assume o comando. Também calculo o <b>RMSE</b> (erro quadrático médio) para gerar o intervalo de confiança em ±1,5σ.`;
  msg += `<br><br>Tudo 100% local no seu navegador, sem enviar dados pra ninguém.`;
  return msg;
}

function mrcashForecast(ml, snap){
  const fc = ml && ml.forecast && ml.forecast.receita;
  if(!fc){
    if(snap && snap.receita && snap.receita.anual > 0){
      return `Pra te dar a projeção mês-a-mês, preciso treinar o modelo (LR+Holt) — isso roda quando você gera o diagnóstico. <br><br>O que posso te dizer agora: receita anual prevista é <b>${fmtBRL(snap.receita.anual)}</b>${snap.receita.realizadoAno?`, com <b>${fmtBRL(snap.receita.realizadoAno)}</b> realizado nos meses fechados`:''}.<br><br>Vá em <b>Diagnóstico → Gerar</b> pra ver a projeção completa.`;
    }
    return `A projeção mês-a-mês requer rodar o diagnóstico (módulo <b>Diagnóstico</b>) — ele treina o modelo LR+Holt e gera as próximas previsões.`;
  }
  const next3 = fc.forecast.slice(0,3);
  const soma3 = next3.reduce((s,v)=>s+v,0);
  const media3 = soma3/3;
  const last3 = fc.serie.slice(-3);
  const mLast = last3.reduce((s,v)=>s+v,0)/last3.length;
  const delta = mLast > 0 ? ((media3-mLast)/mLast)*100 : 0;
  const trend = fc.slope > 0 ? 'crescente' : (fc.slope < 0 ? 'decrescente' : 'estável');
  let msg = `Para os <b>próximos 3 meses</b>, a média projetada é <b>${fmtBRL(media3)}/mês</b> (tendência <em>${trend}</em> de ${fmtBRL(Math.abs(fc.slope))}/mês). `;
  msg += `Isso representa ${delta >= 0 ? '+' : ''}${delta.toFixed(1)}% vs. a média dos últimos 3 meses (${fmtBRL(mLast)}).`;
  msg += `<br><br>Intervalo de confiança: ±${fmtBRL(1.5*fc.rmse)} por mês (1,5σ). R²=${fc.r2.toFixed(2)}.`;
  const fc6 = fc.forecast.slice(0,6).reduce((s,v)=>s+v,0);
  msg += `<br>Soma dos <b>6 meses projetados</b>: ${fmtBRL(fc6)}.`;
  return msg;
}

function mrcashAnomalias(ml){
  const an = ml && ml.anomalies;
  if(!an || !an.length) return 'Não detectei anomalias relevantes (|z| ≥ 1,8) nas séries analisadas. Tudo dentro do comportamento esperado.';
  const up = an.filter(a => a.tipo === 'alta');
  const dn = an.filter(a => a.tipo === 'baixa');
  let msg = `Identifiquei <b>${an.length} anomalia${an.length===1?'':'s'}</b> (pontos a mais de 1,8 desvios-padrão da média): `;
  if(up.length) msg += `${up.length} para cima (pico)`;
  if(up.length && dn.length) msg += ', ';
  if(dn.length) msg += `${dn.length} para baixo (queda brusca)`;
  msg += '.<ul>';
  an.slice(0,5).forEach(a => {
    msg += `<li><b>${esc(a.label)}</b> em ${esc(a.mesLbl)}: ${fmtBRL(a.valor)} (z=${a.z.toFixed(1)}, esperado ~${fmtBRL(a.esperado)})</li>`;
  });
  msg += '</ul>Vale investigar o porquê — pode ser entrada/saída de cliente, one-off, erro de lançamento ou evento real.';
  return msg;
}

function mrcashClusters(ml){
  const cl = ml && ml.clusters;
  if(!cl) return 'Não consegui clusterizar os clientes — precisa ter pelo menos 3 clientes com receita registrada.';
  const tot = cl.summary.reduce((s,c)=>s+c.total,0) || 1;
  let msg = `Agrupei seus <b>${cl.clients.length}</b> clientes em <b>${cl.k}</b> grupos por volume de receita (algoritmo <em>k-means 1D</em>):<ul>`;
  cl.summary.forEach(c => {
    const pct = (c.total/tot)*100;
    msg += `<li><b>${esc(c.label)}</b> (${c.qtd} cliente${c.qtd===1?'':'s'}): ${fmtBRL(c.total)} no ano (${pct.toFixed(0)}% do total)</li>`;
  });
  msg += `</ul>`;
  const ancPct = (cl.summary[0].total/tot)*100;
  if(ancPct > 55) msg += `⚠️ As âncoras representam <b>${ancPct.toFixed(0)}%</b> da receita — concentração alta. A saída de uma delas vira crise rápida.`;
  else msg += `Distribuição razoavelmente saudável — nenhum grupo domina perigosamente.`;
  return msg;
}

function mrcashSazonal(ml){
  const s = ml && ml.seasonality;
  if(!s || !s.mensal) return 'Não consegui calcular sazonalidade — preciso de pelo menos <b>12 meses</b> de receita com valores em todos os meses.';
  const max = s.fortes[0], min = s.fracos[0];
  const amp = max.desvio - min.desvio;
  let msg = `Analisando 12 meses de histórico, o padrão sazonal tem <b>amplitude de ${amp.toFixed(0)} pontos percentuais</b> entre o melhor e o pior mês.`;
  msg += `<br><br>Meses <b>fortes</b>: ${s.fortes.map(m=>`${esc(m.mes)} (${m.desvio>0?'+':''}${m.desvio.toFixed(0)}%)`).join(', ')}.`;
  msg += `<br>Meses <b>fracos</b>: ${s.fracos.map(m=>`${esc(m.mes)} (${m.desvio.toFixed(0)}%)`).join(', ')}.`;
  if(amp >= 40) msg += `<br><br>Com amplitude alta, vale <b>reservar caixa nos meses fortes</b> para atravessar os fracos sem apertos.`;
  else if(amp >= 20) msg += `<br><br>Sazonalidade moderada — conhecer o padrão ajuda no planejamento de despesas e contratações.`;
  else msg += `<br><br>Receita bem distribuída ao longo do ano — menos risco de vale sazonal.`;
  return msg;
}

function mrcashCorrelacoes(ml){
  const cs = ml && ml.correlations;
  if(!cs || !cs.length) return 'Não encontrei correlações significativas entre as séries (|r| < 0,4 ou dados insuficientes).';
  let msg = `Calculei a <b>correlação de Pearson</b> (com lag de até 3 meses) entre pares de séries. Resultados com |r| ≥ 0,4:<ul>`;
  cs.slice(0,4).forEach(c => {
    const sinal = c.r > 0 ? 'positiva' : 'negativa';
    const lagTxt = c.lag === 0 ? 'simultânea' : `com ${c.lag} ${c.lag===1?'mês':'meses'} de defasagem`;
    msg += `<li><b>${esc(c.labelA)} × ${esc(c.labelB)}</b>: r=${c.r.toFixed(2)} (${sinal}, ${lagTxt})</li>`;
  });
  msg += `</ul>Lag = mudança em A antecede mudança em B por N meses — útil para saber quais indicadores "avisam" problemas antes.`;
  return msg;
}

