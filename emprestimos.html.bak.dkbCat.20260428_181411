//  CONTRATOS (anexos por empréstimo)
// ═══════════════════════════════════════════════════
// Kind: 'loan' (empréstimo) ou 'impPar' (parcelamento de imposto)
let activeContratoKind = 'loan';
function _contratoResolve(id, kind){
  if(kind === 'impPar'){
    if(typeof impostos === 'undefined' || !impostos || !Array.isArray(impostos.parcelamentos)) return null;
    return impostos.parcelamentos.find(p => p.id === id) || null;
  }
  return loans.find(l => l.id === id) || null;
}
function _contratoSave(kind){
  if(kind === 'impPar'){ try { impSave(); } catch(e){} return; }
  try { saveData(); } catch(e){}
}
function _contratoLabel(ent, id, kind){
  if(kind === 'impPar'){
    return (ent && ent.nome) ? ent.nome : `Parcelamento #${id}`;
  }
  return (ent && (ent.bancoManual || ent.banco)) || `Empréstimo #${id}`;
}

function openContratos(id, kind){
  activeContratoKind = kind || 'loan';
  activeContratoId = id;
  const ent = _contratoResolve(id, activeContratoKind);
  if(!ent) return;
  const label = _contratoLabel(ent, id, activeContratoKind);
  document.getElementById('cont-title').textContent = 'Contratos — ' + label;
  renderContratosBody(ent);
  document.getElementById('ov-contratos').classList.add('open');
}

function closeContratos(){
  document.getElementById('ov-contratos').classList.remove('open');
  activeContratoId = null;
  activeContratoKind = 'loan';
}

function renderContratosBody(ent){
  const contratos = (ent && ent.contratos) || [];
  const warn = document.getElementById('cont-warn');
  warn.style.display = contratos.length > 0 ? 'block' : 'none';

  const body = document.getElementById('cont-body');
  if(contratos.length === 0){
    body.innerHTML = '<p style="text-align:center;color:var(--txm);font-size:.8rem;padding:8px 0">Nenhum anexo ainda.</p>';
    return;
  }
  const kindArg = "'" + activeContratoKind + "'";

  body.innerHTML = contratos.map((f,i)=>{
    const icon = fileIcon(f.type);
    const sizeFmt = f.size < 1024*1024
      ? (f.size/1024).toFixed(1)+' KB'
      : (f.size/(1024*1024)).toFixed(2)+' MB';
    const date = new Date(f.ts).toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric'});
    return `
    <div class="att-item" id="att-${ent.id}-${i}">
      <div class="att-icon">${icon}</div>
      <div style="flex:1;min-width:0">
        <div class="att-name" title="${esc(f.name)}">${esc(f.name)}</div>
        <div class="att-meta">${sizeFmt} &nbsp;·&nbsp; ${date}</div>
      </div>
      <div class="att-actions">
        <button class="btn btn-g" style="padding:3px 9px;font-size:.72rem" onclick="downloadContrato(${ent.id},${i},${kindArg})" title="Baixar">⬇</button>
        <button class="btn" style="padding:3px 9px;font-size:.72rem;background:#FEE2E2;color:#DC2626;border:1px solid #FECACA" onclick="removeContrato(${ent.id},${i},${kindArg})" title="Remover">✕</button>
      </div>
    </div>`;
  }).join('');
}

function fileIcon(type){
  if(!type) return '📎';
  if(type==='application/pdf') return '📄';
  if(type.startsWith('image/')) return '🖼️';
  if(type.includes('word') || type.includes('document')) return '📝';
  if(type.includes('sheet') || type.includes('excel')) return '📊';
  if(type.includes('zip') || type.includes('compressed')) return '🗜️';
  return '📎';
}

function handleContratoDrop(event){
  event.preventDefault();
  document.getElementById('cont-drop').classList.remove('drag-over');
  if(activeContratoId === null) return;
  processContratoFiles(activeContratoId, Array.from(event.dataTransfer.files), activeContratoKind);
}

function addContratosFromInput(event){
  if(activeContratoId === null) return;
  processContratoFiles(activeContratoId, Array.from(event.target.files), activeContratoKind);
  event.target.value = ''; // reset so same file can be re-added
}

function processContratoFiles(id, files, kind){
  const _kind = kind || 'loan';
  const ent = _contratoResolve(id, _kind);
  if(!ent) return;
  const MAX = 3 * 1024 * 1024; // 3 MB
  let errors = [];

  const readers = files.map(file => new Promise(resolve=>{
    if(file.size > MAX){
      errors.push(`"${file.name}" excede 3 MB`);
      resolve(null);
      return;
    }
    const reader = new FileReader();
    reader.onload = e => resolve({
      name: file.name,
      type: file.type,
      size: file.size,
      data: e.target.result,   // base64 dataURL
      ts:   Date.now()
    });
    reader.onerror = ()=>{ errors.push(`Erro ao ler "${file.name}"`); resolve(null); };
    reader.readAsDataURL(file);
  }));

  Promise.all(readers).then(results=>{
    const valid = results.filter(Boolean);
    if(valid.length){
      ent.contratos = [...(ent.contratos||[]), ...valid];
      try {
        _contratoSave(_kind);
      } catch(e){
        toast('⚠️ Sem espaço no localStorage — reduza o tamanho dos arquivos.',5000);
        // rollback
        ent.contratos.splice(ent.contratos.length - valid.length, valid.length);
        return;
      }
      renderContratosBody(ent);
      updateContratoBadge(id, ent.contratos.length, _kind);
      toast(`✅ ${valid.length} arquivo(s) anexado(s)`);
    }
    if(errors.length) toast('⚠️ ' + errors.join('; '), 5000);
  });
}

function removeContrato(id, idx, kind){
  const _kind = kind || 'loan';
  const ent = _contratoResolve(id, _kind);
  if(!ent) return;
  ent.contratos.splice(idx, 1);
  _contratoSave(_kind);
  renderContratosBody(ent);
  updateContratoBadge(id, ent.contratos.length, _kind);
  toast('🗑️ Anexo removido');
}

function downloadContrato(id, idx, kind){
  const _kind = kind || 'loan';
  const ent = _contratoResolve(id, _kind);
