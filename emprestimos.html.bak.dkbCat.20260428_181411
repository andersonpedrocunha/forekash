function anaEditSetSize(delta){
  const el = _anaFocusedEditable();
  if(!el){ if(typeof toast === 'function') toast('Clique no texto que deseja editar'); return; }
  _anaRestoreFocus(el);
  // Pega seleção VIVA (mais confiável que saved range)
  const sel = window.getSelection();
  const hasSel = sel && sel.rangeCount > 0 && !sel.isCollapsed;
  // Lê tamanho EXATO do nó da seleção (preferindo o anchor, senão o common ancestor)
  let curSize = 16;
  let probeNode = null;
  if(hasSel){
    probeNode = sel.anchorNode;
    if(probeNode && probeNode.nodeType === 3) probeNode = probeNode.parentElement;
    // Se o pai é o próprio el (texto bare), usa el; senão busca o span/font mais próximo com size
    if(probeNode){
      // Procura o ancestral mais próximo que tem style.fontSize ou font[size]
      let n = probeNode;
      while(n && n !== el){
        if(n.style && n.style.fontSize) { curSize = parseFloat(n.style.fontSize); break; }
        n = n.parentElement;
      }
      if(!isFinite(curSize) || !curSize) curSize = parseFloat(getComputedStyle(probeNode).fontSize) || 16;
    }
  } else {
    // Sem seleção: pega tamanho atual do elemento
    curSize = parseFloat(getComputedStyle(el).fontSize) || 16;
  }
  const newSize = Math.max(8, Math.min(96, Math.round(curSize) + delta));
  if(hasSel){
    try {
      document.execCommand('styleWithCSS', false, true);
      document.execCommand('fontSize', false, '7');
      // Substitui <font size="7"> por <span style="font-size:Xpx">
      el.querySelectorAll('font[size="7"]').forEach(f => {
        const span = document.createElement('span');
        span.style.fontSize = newSize + 'px';
        while(f.firstChild) span.appendChild(f.firstChild);
        f.replaceWith(span);
      });
      // Re-captura seleção (DOM mudou)
      _anaCaptureSelection();
    } catch(e){ console.error(e); }
  } else {
    _anaCurStyles().fontSize = newSize;
    el.style.fontSize = newSize + 'px';
  }
  const sizeDisp = document.getElementById('ana-edit-size-display');
  if(sizeDisp) sizeDisp.textContent = newSize;
  _anaPersistContent();
}
