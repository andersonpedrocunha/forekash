const EXTRATO_KEY = 'forekash:extrato:v1';
let extratoData = { lancamentos: [], nextId: 1 };
let _extState = {
  mode: 'caixa',     // 'caixa' | 'competencia'
  grain: 'mes',      // 'dia' | 'semana' | 'mes' | 'ano'
  period: null,      // {y,m,d} dependendo do grain
  descricoes: [],    // descrições selecionadas (multi)
  clientes: [],      // contrapartes selecionadas (multi)
  contas: [],
  conta: '', /* legacy — mantido como compat */
  documento: '',     // texto livre
  centroCustoId: ''  // string vazia ou id numérico stringificado
};
// estado das buscas internas dos dropdowns multi
let _extMultiSearch = { desc: '', cli: '', conta: '' };
let _extSelected = new Set(); // ids selecionados pra ações em lote
let _extExpandedFat = new Set(); // ids de faturas expandidas (cartao-fat:N)
function _extLoad(){
  try {
    const raw = localStorage.getItem(EXTRATO_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && typeof obj === 'object'){
        extratoData = Object.assign(extratoData, obj);
        if(!Array.isArray(extratoData.lancamentos)) extratoData.lancamentos = [];
        if(typeof extratoData.nextId !== 'number') extratoData.nextId = 1;
      }
    }
  } catch(e){}
}
function _extSave(){
  try { localStorage.setItem(EXTRATO_KEY, JSON.stringify(extratoData)); } catch(e){}
}
_extLoad();

function _extInitPeriod(){
  if(_extState.period) return;
  const t = new Date();
  _extState.period = { y: t.getFullYear(), m: t.getMonth(), d: t.getDate() };
}
_extInitPeriod();

function _extFmtBRL(n){
  return (typeof fmtBRL === 'function') ? fmtBRL(n||0) : ('R$ ' + (n||0).toFixed(2).replace('.', ','));
}
function _extEsc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function _extPeriodRange(){
  // Retorna {from:'YYYY-MM-DD', to:'YYYY-MM-DD'} pra filtrar
  const p = _extState.period;
  const pad = (n) => String(n).padStart(2,'0');
  if(_extState.grain === 'dia'){
    const ymd = p.y + '-' + pad(p.m+1) + '-' + pad(p.d);
    return { from: ymd, to: ymd };
  }
  if(_extState.grain === 'semana'){
    const d = new Date(p.y, p.m, p.d);
    // Semana = segunda a domingo
    const dow = d.getDay() || 7; // 1..7
    const seg = new Date(d); seg.setDate(d.getDate() - (dow-1));
    const dom = new Date(seg); dom.setDate(seg.getDate() + 6);
    const fmt = (dd) => dd.getFullYear() + '-' + pad(dd.getMonth()+1) + '-' + pad(dd.getDate());
    return { from: fmt(seg), to: fmt(dom) };
  }
  if(_extState.grain === 'mes'){
    const lastDay = new Date(p.y, p.m+1, 0).getDate();
    return { from: p.y + '-' + pad(p.m+1) + '-01', to: p.y + '-' + pad(p.m+1) + '-' + pad(lastDay) };
  }
  if(_extState.grain === 'ano'){
    return { from: p.y + '-01-01', to: p.y + '-12-31' };
  }
  return null;
}
function _extPeriodLabel(){
  const p = _extState.period;
  const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  if(_extState.grain === 'dia'){
    return String(p.d).padStart(2,'0') + ' de ' + meses[p.m] + ' de ' + p.y;
  }
  if(_extState.grain === 'semana'){
    const r = _extPeriodRange();
    return 'Semana de ' + r.from.slice(8,10) + '/' + r.from.slice(5,7) + ' a ' + r.to.slice(8,10) + '/' + r.to.slice(5,7);
  }
  if(_extState.grain === 'mes'){
    return meses[p.m] + ' de ' + p.y;
  }
  if(_extState.grain === 'ano'){
    return 'Ano de ' + p.y;
  }
  return '—';
}

// Coleta lançamentos das fontes (Receita + Manual). Retorna array unificado.
function _extCollect(){
  const out = [];
  // 1) Manuais
  for(const l of (extratoData.lancamentos || [])){
    out.push({
      id: 'm:' + l.id,
      sourceKind: 'manual',
      data: l.data || '',
      tipo: l.tipo || 'gasto',
      categoria: l.categoria || '',
      descricao: l.descricao || '',
      contraparte: l.contraparte || '',
      conta: l.conta || '',
      valor: parseFloat(l.valor) || 0,
      status: l.status || 'pago',
      dataPagamento: l.dataPagamento || '',
      numeroDocumento: l.numeroDocumento || '',
      centroCustoId: l.centroCustoId || null,
      grupoId: l.grupoId || null,
      manual: true,
      raw: l
    });
  }
  // 2) Receita (entradas)
  try {
    const REC_M_NAMES = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    if(typeof receita !== 'undefined' && receita && receita.years){
      const meses_lower = (typeof REC_MESES !== 'undefined') ? REC_MESES : ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
      for(const yKey of Object.keys(receita.years)){
        const y = parseInt(yKey, 10);
        if(!isFinite(y)) continue;
        const d = receita.years[yKey] || {};
        for(const r of (d.clients || [])){
          const c = (receita.clientes || []).find(x => x.id === r.clienteId);
          const nome = c ? (c.nome || '') : '(cliente removido)';
          const meses = r.meses || {};
          for(const mAbbr of meses_lower){
            const cell = meses[mAbbr];
            if(!cell || cell.valor === '' || cell.valor == null) continue;
            const v = parseFloat(cell.valor); if(!isFinite(v) || v === 0) continue;
            const m = meses_lower.indexOf(mAbbr);
            const lastDay = new Date(y, m+1, 0).getDate();
            const dueDefault = y + '-' + String(m+1).padStart(2,'0') + '-' + String(lastDay).padStart(2,'0');
            const venc = cell.dataVencimento || dueDefault;
            const recebimento = cell.dataRecebimento || '';
            const isRec = cell.status === 'recebido';
            // Resolve nome do banco vinculado à célula (cell.banco é bancoId)
            let recContaNome = '';
            if(cell.banco && typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.bancos)){
              const b = dispo.bancos.find(x => x.id === cell.banco);
              if(b) recContaNome = b.nome || '';
            }
            out.push({
              id: 'rec:' + y + ':' + r.id + ':' + mAbbr,
              sourceKind: 'receita',
              data: isRec ? (recebimento || venc) : venc,
              dataPagamento: recebimento,
              dataVencimento: venc,
              tipo: 'ganho',
              categoria: 'Receita',
              descricao: r.descricao || (REC_M_NAMES[m] + '/' + y),
              contraparte: nome,
              conta: recContaNome,
              valor: v,
              status: isRec ? 'pago' : 'pendente',
              numeroDocumento: cell.numeroDocumento || '',
              fornecedorId: cell.fornecedorId || null,
              centroCustoId: cell.centroCustoId || null,
              grupoId: cell.grupoId || null,
              manual: false,
              raw: { year: y, mesAbbr: mAbbr, rowId: r.id }
            });
          }
        }
      }
    }
  } catch(e){ console.warn('extrato/receita:', e); }
  // 3) Despesas — via DKB_ADAPTERS (estrutura, pessoas, impostos correntes/parcelamentos)
  try {
    if(typeof DKB_ADAPTERS !== 'undefined' && DKB_ADAPTERS){
      const ctxMap = {
        'est-fixa':  { categoria: 'Estrutura' },
        'pes':       { categoria: 'Folha' },
        'imp-cor':   { categoria: 'Impostos' },
        'imp-par':   { categoria: 'Parcelamento' }
      };
      for(const ctxId of Object.keys(ctxMap)){
        const ad = DKB_ADAPTERS[ctxId];
        if(!ad) continue;
        const cmeta = ctxMap[ctxId];
        const items = (ad.items && ad.items()) || [];
        for(const it of items){
          const valores = (ad.valoresOf ? ad.valoresOf(it) : {}) || {};
          const itName = ad.nameOf ? ad.nameOf(it) : (it.nome || '(sem nome)');
          for(const ym of Object.keys(valores)){
            const v = parseFloat(valores[ym]);
            if(!isFinite(v) || v === 0) continue;
            const parts = String(ym).split('-');
            const yNum = parseInt(parts[0],10), mo = parseInt(parts[1],10) - 1;
            if(!isFinite(yNum) || !isFinite(mo)) continue;
            const lastDay = new Date(yNum, mo+1, 0).getDate();
            const dueDefault = ym + '-' + String(lastDay).padStart(2,'0');
            const cellMeta = (it.meta && it.meta[ym]) || {};
            const isPago = ad.pagoOf ? ad.pagoOf(it, ym) : false;
            // Resolve fornecedor: meta sobrescreve auto; auto vem do adapter (pessoas usa pessoaId)
            let cellFornId = cellMeta.fornecedorId || null;
            if(!cellFornId && ad.autoFornecedorId){
              try { cellFornId = ad.autoFornecedorId(it) || null; } catch(e){}
            }
            let contraparte = '';
            if(cellFornId && typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.registry)){
              const fr = pessoas.registry.find(r => r.id === cellFornId);
              if(fr) contraparte = fr.nome || '';
            }
            // Resolve banco (nome do banco em dispo.bancos)
            let contaNome = '';
            if(cellMeta.banco && typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.bancos)){
              const b = dispo.bancos.find(x => x.id === cellMeta.banco);
              if(b) contaNome = b.nome || '';
            }
            const venc = cellMeta.dataVencimento || dueDefault;
            const pag  = cellMeta.dataPagamento || cellMeta.dataRecebimento || '';
            const emis = cellMeta.dataEmissao || '';
            out.push({
              id: 'dkb:' + ctxId + ':' + it.id + ':' + ym,
              sourceKind: ctxId,
              data: isPago ? (pag || venc) : venc,
              dataPagamento: pag,
              dataVencimento: venc,
              dataEmissao: emis,
              tipo: 'gasto',
              categoria: cmeta.categoria,
              descricao: itName,
              contraparte: contraparte,
              conta: contaNome,
              valor: v,
              status: isPago ? 'pago' : 'pendente',
              numeroDocumento: cellMeta.numeroDocumento || '',
              fornecedorId: cellFornId || null,
              centroCustoId: cellMeta.centroCustoId || null,
              grupoId: cellMeta.grupoId || null,
              manual: false,
              raw: { ctxId: ctxId, itemId: it.id, ym: ym }
            });
          }
        }
      }
    }
  } catch(e){ console.warn('extrato/dkb:', e); }
  // 5) Empréstimos — gera 1 lançamento por parcela mensal
  try {
    if(typeof loans !== 'undefined' && Array.isArray(loans) && loans.length > 0){
      // Helpers locais robustos
      const parseValor = (v) => {
        if(typeof v === 'number') return v;
        if(v == null || v === '') return 0;
        const s = String(v).trim();
        if(/^-?\d+(\.\d+)?$/.test(s)) return parseFloat(s);
        // Formato BR: 1.500,50
        const cleaned = s.replace(/[^\d,.-]/g, '').replace(/\./g, '').replace(',', '.');
        const n = parseFloat(cleaned);
        return isFinite(n) ? n : 0;
      };
      const parseInicio = (s) => {
        if(!s) return null;
        s = String(s).trim();
        // YYYY-MM-DD
        let m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
        if(m) return { y: +m[1], mo: +m[2]-1, d: +m[3] };
        // YYYY-MM
        m = s.match(/^(\d{4})-(\d{1,2})$/);
        if(m) return { y: +m[1], mo: +m[2]-1, d: 5 };
        // DD/MM/YYYY
        m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
        if(m) return { y: +m[3], mo: +m[2]-1, d: +m[1] };
        // MM/YYYY
        m = s.match(/^(\d{1,2})\/(\d{4})$/);
        if(m) return { y: +m[2], mo: +m[1]-1, d: 5 };
        // YYYY (só ano — assume janeiro)
        m = s.match(/^(\d{4})$/);
        if(m) return { y: +m[1], mo: 0, d: 5 };
        return null;
      };
      const pad = (n) => String(n).padStart(2,'0');
      const tToday = new Date();
      let added = 0;
      const skipped = [];
      // Helper: inicio inferido a partir de parcelasPagas → today menos N meses
      // Assim a parcela (parcelasPagas+1) cai no mês atual, dando contexto correto
      const inferirInicio = (parcelasPagas) => {
        let mm = tToday.getMonth() - parcelasPagas, yy = tToday.getFullYear();
        while(mm < 0){ mm += 12; yy--; }
        return { y: yy, mo: mm, d: tToday.getDate() };
      };
      for(const ln of loans){
        let parcelaVal = parseValor(ln.parcelaVal);
        let totalParcelas = parseInt(ln.parcelas, 10) || 0;
        const parcelasPagas = parseInt(ln.parcelasPagas, 10) || 0;
        // Fallback: parcelaVal a partir de valor total
        if(parcelaVal <= 0 && totalParcelas > 0){
          const valTotal = parseValor(ln.valor);
          if(valTotal > 0) parcelaVal = valTotal / totalParcelas;
        }
        if(parcelaVal <= 0 && totalParcelas > 0){
          const valSaldo = parseValor(ln.saldo);
          if(valSaldo > 0) parcelaVal = valSaldo / totalParcelas;
        }
        if(totalParcelas <= 0 && parcelaVal > 0){
          const valTotal = parseValor(ln.valor);
          if(valTotal > 0) totalParcelas = Math.ceil(valTotal / parcelaVal);
        }
        if(parcelaVal <= 0){ skipped.push({id: ln.id, motivo: 'parcelaVal=0', loan: ln}); continue; }
        if(totalParcelas <= 0){ skipped.push({id: ln.id, motivo: 'parcelas=0', loan: ln}); continue; }
        // Inicio: usa o real se houver; senão back-calcula pra que a próxima parcela
        // a pagar (parcelasPagas + 1) caia no mês corrente.
        const ini = parseInicio(ln.inicio) || inferirInicio(parcelasPagas);
        // Resolve nome do banco do EMPRÉSTIMO (origem do dinheiro / credor)
        // O loan tem ln.bancoId (id do banco em dispo.bancos) e ln.banco (nome legacy/sync)
        let bancoNome = '';
        let bancoObj = null;
        const dispoBancos = (typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.bancos)) ? dispo.bancos : [];
        // 1) Procura por bancoId
        if(ln.bancoId){
          bancoObj = dispoBancos.find(x => x.id === ln.bancoId) || null;
          if(bancoObj) bancoNome = bancoObj.nome || '';
        }
        // 2) Fallback: ln.banco como string-nome (versões antigas)
        if(!bancoNome && ln.banco){
          // Se ln.banco bate com algum id, usa esse banco
          bancoObj = dispoBancos.find(x => x.id === ln.banco) || null;
          if(bancoObj) bancoNome = bancoObj.nome || '';
          else {
            // Procura por nome
            bancoObj = dispoBancos.find(x => (x.nome||'').trim().toLowerCase() === String(ln.banco).trim().toLowerCase()) || null;
            if(bancoObj) bancoNome = bancoObj.nome || '';
            else bancoNome = String(ln.banco).trim();
          }
        }
        // 3) Manual
        if(!bancoNome) bancoNome = (ln.bancoManual || '').trim();

        // Resolve fornecedor do empréstimo (cobre todas as parcelas pendentes/futuras)
        // Ordem de prioridade:
        //   1) ln.fornecedorId explícito → procura no registry
        //   2) banco do empréstimo com CNPJ → match com registry por CNPJ (auto-cria se não existir)
        //   3) banco com nome → match no registry por nome (case-insensitive)
        let lnFornId = null;
        let lnFornNome = '';
        const reg = (typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.registry)) ? pessoas.registry : [];
        if(ln.fornecedorId){
          const fr = reg.find(r => r.id === ln.fornecedorId);
          if(fr){ lnFornId = fr.id; lnFornNome = fr.nome || ''; }
        }
        // Fallback 2: pelo CNPJ do banco (cria fornecedor se não existir)
        if(!lnFornId && bancoObj){
          if(typeof _extEnsureBancoFornecedor === 'function'){
            try {
              const fid = _extEnsureBancoFornecedor(bancoObj.id);
              if(fid){
                const fr = reg.find(r => r.id === fid);
                if(fr){ lnFornId = fr.id; lnFornNome = fr.nome || ''; }
              }
            } catch(_){}
          }
        }
        // Fallback 3: pelo nome do banco
        if(!lnFornId && bancoNome){
          const fr = reg.find(r => (r.nome || '').trim().toLowerCase() === bancoNome.trim().toLowerCase());
          if(fr){ lnFornId = fr.id; lnFornNome = fr.nome || ''; }
        }
        const baseDesc = (ln.descricao || ('Empréstimo' + (bancoNome ? ' ' + bancoNome : ''))).trim();
        for(let i = 0; i < totalParcelas; i++){
          let mm = ini.mo + i, yy = ini.y;
          while(mm > 11){ mm -= 12; yy++; }
          while(mm < 0){ mm += 12; yy--; }
          // Aplica diaVencimento (override) se definido no empréstimo
          const lastD = new Date(yy, mm + 1, 0).getDate();
          let dd;
          if(ln.diaVencimento){
            const dExp = parseInt(ln.diaVencimento, 10);
            dd = (dExp >= 1 && dExp <= 31) ? Math.min(dExp, lastD) : Math.min(ini.d, lastD);
          } else {
            dd = Math.min(ini.d, lastD);
          }
          // Override por parcela (se houver)
          if(Array.isArray(ln.vencimentos) && ln.vencimentos[i]){
            const ovr = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ln.vencimentos[i]);
            if(ovr){
              const ymd = ln.vencimentos[i];
              // sobrescreve abaixo
            }
          }
          const ymd = (Array.isArray(ln.vencimentos) && ln.vencimentos[i] && /^\d{4}-\d{2}-\d{2}$/.test(ln.vencimentos[i]))
            ? ln.vencimentos[i]
            : (yy + '-' + pad(mm+1) + '-' + pad(dd));
          const isPago = (i < parcelasPagas);
          // Conta de exibição:
          //   • Pendente: banco do empréstimo (conta de origem do dinheiro / credor)
          //   • Pago: conta usada na baixa (ln.pagamentos[i].conta), com fallback pro banco do empréstimo
          let contaParcela = bancoNome;
          let dataPagParcela = '';
          let valorPagoParcela = null;
          if(isPago && ln.pagamentos && ln.pagamentos[i]){
            const pg = ln.pagamentos[i];
            if(pg.conta) contaParcela = pg.conta;
            if(pg.data) dataPagParcela = pg.data;
            if(typeof pg.valorPago === 'number') valorPagoParcela = pg.valorPago;
          } else if(isPago){
            dataPagParcela = ymd; // legacy: sem dados de baixa
          }
          out.push({
            id: 'loan:' + ln.id + ':' + i,
            sourceKind: 'loans',
            data: ymd,
            dataPagamento: dataPagParcela,
            dataVencimento: ymd,
            dataEmissao: ymd,
            tipo: 'gasto',
            categoria: 'Empréstimo',
            descricao: baseDesc + ' · parcela ' + (i+1) + '/' + totalParcelas,
            contraparte: lnFornNome || bancoNome,
            fornecedorId: lnFornId || null,
            autoFornecedorId: lnFornId || null,
            conta: contaParcela,
            valor: (valorPagoParcela != null ? valorPagoParcela : parcelaVal),
            status: isPago ? 'pago' : 'pendente',
            numeroDocumento: '',
            manual: false,
            raw: { loanId: ln.id, parcelaIdx: i, parcelasPagas: parcelasPagas, totalParcelas: totalParcelas }
          });
          added++;
        }
      }
      // Log diagnóstico — visível no F12 → Console
      try {
        console.log('[extrato/loans] gerei ' + added + ' parcelas a partir de ' + loans.length + ' empréstimo(s)');
        if(skipped.length > 0){
          console.warn('[extrato/loans] ' + skipped.length + ' empréstimo(s) PULADOS:', skipped);
        }
      } catch(_){}
    } else {
      try { console.log('[extrato/loans] loans não está disponível ou está vazio. typeof loans=' + (typeof loans)); } catch(_){}
    }
  } catch(e){ console.warn('extrato/loans:', e); }

  // 5) Cartões de crédito
  // ─ Caixa: 1 linha por FATURA (agrupada) com expansão ▶ pra ver lançamentos
  // ─ Competência: 1 linha por LANÇAMENTO individual (data da compra)
  try {
    if(typeof cartoes !== 'undefined' && cartoes && Array.isArray(cartoes.lancamentos)){
      const fatById = new Map();
      for(const f of (cartoes.faturas || [])) fatById.set(f.id, f);
      const cartById = new Map();
      for(const c of (cartoes.list || [])) cartById.set(c.id, c);
      // Agrupa lançamentos por fatura
      const lansByFat = {};
      for(const l of cartoes.lancamentos){
        if(!l.faturaId) continue;
        if(!lansByFat[l.faturaId]) lansByFat[l.faturaId] = [];
        lansByFat[l.faturaId].push(l);
      }
      // Helper que constrói item individual (usado em Competência ou como child)
      const buildLancItem = (l, f, c) => {
        const apelido = c ? c.apelido : 'Cartão';
        const fatPaga = (f.status === 'paga' && f.pagamento);
        const dataCompra = l.data || (f.ciclo && f.ciclo.ate) || f.vencimento;
        let dataVenc = f.vencimento || dataCompra;
        try {
          if(c && f.refY && f.refM){
            const lastDayRef = new Date(f.refY, f.refM, 0).getDate();
            const diaVenc = c.diaVencimento || 10;
            const dayUse = Math.min(diaVenc, lastDayRef);
            dataVenc = f.refY + '-' + String(f.refM).padStart(2,'0') + '-' + String(dayUse).padStart(2,'0');
          }
        } catch(e){}
        const dataPag = fatPaga ? (f.pagamento.data || dataVenc) : '';
        let fornId = l.fornecedorId || null;
        let contraparte = l.estabelecimento || '';
        if(fornId && typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.registry)){
          const fr = pessoas.registry.find(r => r.id === fornId);
          if(fr) contraparte = fr.nome || contraparte;
        }
        const contaShow = fatPaga ? (f.pagamento.conta || '') : ('💳 ' + apelido);
        const cat = (l.categoria || '').trim() || ('Cartão · ' + apelido);
        let descShow = l.descricao || '(sem descrição)';
        if(l.moedaOrigem && l.moedaOrigem !== 'BRL' && l.valorOrigem){
          descShow = '🌐 ' + descShow;
        }
        // Anexo: próprio ou root da série de parcelas
        let anexoLan = l.anexo || null;
        if(!anexoLan && l.parcela && l.parcela.parentId && Array.isArray(cartoes.lancamentos)){
          const root = cartoes.lancamentos.find(x => x.parcela && x.parcela.parentId === l.parcela.parentId && x.parcela.atual === 1 && x.anexo);
          if(root) anexoLan = root.anexo;
        }
        return {
          id: 'cartao:' + l.id,
          sourceKind: 'cartao',
          data: dataCompra,
          dataPagamento: dataPag,
          dataVencimento: dataVenc,
          dataEmissao: dataCompra,
          tipo: 'gasto',
          categoria: cat,
          descricao: descShow,
          contraparte: contraparte,
          fornecedorId: fornId,
          autoFornecedorId: fornId,
          conta: contaShow,
          valor: parseFloat(l.valor) || 0,
          status: fatPaga ? 'pago' : 'pendente',
          numeroDocumento: l.numeroDocumento || '',
          centroCustoId: l.centroCustoId || null,
          moedaOrigem: l.moedaOrigem || null,
          valorOrigem: l.valorOrigem || null,
          anexo: anexoLan,
          manual: false,
          raw: { lancamentoId: l.id, faturaId: f.id, cartaoId: f.cartaoId }
        };
      };

      if(_extState.mode === 'competencia'){
        // Modo COMPETÊNCIA: 1 item por lançamento individual
        for(const l of cartoes.lancamentos){
          const f = fatById.get(l.faturaId);
          if(!f) continue;
          const c = cartById.get(l.cartaoId);
          out.push(buildLancItem(l, f, c));
        }
      } else {
        // Modo CAIXA: 1 item por FATURA agregada com expansão
        for(const f of (cartoes.faturas || [])){
          const lans = lansByFat[f.id] || [];
          if(lans.length === 0) continue;
          const c = cartById.get(f.cartaoId);
          const apelido = c ? c.apelido : 'Cartão';
          const fatPaga = (f.status === 'paga' && f.pagamento);
          // Data lógica de vencimento: refY/refM com diaVencimento clamped
          let dataVenc = f.vencimento;
          try {
            if(c && f.refY && f.refM){
              const lastDayRef = new Date(f.refY, f.refM, 0).getDate();
              const diaVenc = c.diaVencimento || 10;
              const dayUse = Math.min(diaVenc, lastDayRef);
              dataVenc = f.refY + '-' + String(f.refM).padStart(2,'0') + '-' + String(dayUse).padStart(2,'0');
            }
          } catch(e){}
          const dataPag = fatPaga ? (f.pagamento.data || dataVenc) : '';
          // Total da fatura: soma dos lançamentos (ou valorPago real se paga, com juros/multa/desconto)
          let total = 0;
          for(const l of lans) total += parseFloat(l.valor) || 0;
          if(fatPaga){
            total = (f.pagamento.valorPago || 0) + (f.pagamento.juros || 0) + (f.pagamento.multa || 0) - (f.pagamento.desconto || 0);
          }
          // Children itens (no formato de item do Extrato) pra renderizar na expansão
          const children = lans.map(l => buildLancItem(l, f, c));
          // Mês de referência pra descrição
          const meses = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
          const mesLbl = meses[(f.refM||1)-1] + '/' + (f.refY||'');
          out.push({
            id: 'cartao-fat:' + f.id,
            sourceKind: 'cartao-fatura',
            data: dataVenc,
            dataPagamento: dataPag,
            dataVencimento: dataVenc,
            dataEmissao: dataVenc,
            tipo: 'gasto',
            categoria: 'Cartão · ' + apelido,
            descricao: 'Fatura ' + apelido + ' · ' + mesLbl,
            contraparte: '',
            conta: fatPaga ? (f.pagamento.conta || '') : ('💳 ' + apelido),
            valor: total,
            status: fatPaga ? 'pago' : 'pendente',
            numeroDocumento: '',
            manual: false,
            expandable: true,
            children: children,
            raw: { faturaId: f.id, cartaoId: f.cartaoId }
          });
        }
      }
    }
  } catch(e){ console.warn('extrato/cartoes:', e); }
  // 4) Receita — usa vencimento como fallback de emissão pra modo Competência
  for(const it of out){
    if(it.sourceKind === 'receita' && !it.dataEmissao){
      it.dataEmissao = it.dataVencimento || it.data || '';
    }
  }
  // 5) Agrupa lançamentos multi-itens (mesmo grupoId + mesma data) numa linha só.
  // Só agrupa se houver 2+ itens compartilhando (grupoId, data). Isso preserva
  // recorrências (mesmo grupoId em datas diferentes) como linhas independentes.
  try {
    const groups = new Map();
    const passthrough = [];
    for(const it of out){
      if(!it || !it.grupoId){ passthrough.push(it); continue; }
      const dKey = it.data || '';
      const key = String(it.grupoId) + '|' + dKey;
      if(!groups.has(key)) groups.set(key, []);
      groups.get(key).push(it);
    }
    const collapsed = [];
    for(const [, items] of groups){
      if(items.length === 1){ collapsed.push(items[0]); continue; }
      const first = items[0];
      const total = items.reduce((s, x) => s + (parseFloat(x.valor) || 0), 0);
      const descs = items.map(x => (x.descricao || '').trim()).filter(Boolean);
      const cats = Array.from(new Set(items.map(x => (x.categoria || '').trim()).filter(Boolean)));
      const counters = Array.from(new Set(items.map(x => (x.contraparte || '').trim()).filter(Boolean)));
      const allPaid = items.every(x => (x.status || '') === 'pago');
      const anyPaid = items.some(x => (x.status || '') === 'pago');
      const parentId = 'grp:' + first.grupoId + ':' + (first.data || '');
      // Categoria do parent: se todos compartilham, usa essa; senão "Multi itens".
      // Quando vem de Estrutura, mantém 'Estrutura' (renderer mostrará "Multi tags" via override).
      let parentCat = 'Multi itens';
      if(cats.length === 1) parentCat = cats[0];
      else if(items.every(x => x.categoria === 'Estrutura')) parentCat = 'Estrutura';
      const parentCounter = counters.length === 1 ? counters[0] : (counters.length > 1 ? (counters.length + ' fornecedores') : '');
      collapsed.push({
        id: parentId,
        sourceKind: 'multi-item',
        data: first.data,
        dataPagamento: first.dataPagamento || '',
        dataVencimento: first.dataVencimento || first.data || '',
        dataEmissao: first.dataEmissao || first.data || '',
        tipo: first.tipo,
        categoria: parentCat,
        descricao: descs.join('; ') || ('Multi itens (' + items.length + ')'),
        contraparte: parentCounter,
        conta: first.conta || '',
        valor: total,
        status: allPaid ? 'pago' : (anyPaid ? 'pendente' : (first.status || 'pendente')),
        numeroDocumento: '',
        fornecedorId: null,
        centroCustoId: first.centroCustoId || null,
        grupoId: first.grupoId,
        manual: items.every(x => x.manual),
        expandable: true,
        children: items,
        isMultiItem: true,
        multiItemCount: items.length,
        raw: { grupoId: first.grupoId, count: items.length }
      });
    }
    out.length = 0;
    for(const it of passthrough) out.push(it);
    for(const it of collapsed)   out.push(it);
  } catch(e){ console.warn('extrato/grupoId-collapse:', e); }
  return out;
}

// Helper: data de vencimento "efetiva" pra detectar atraso.
// • Items derivados (receita/despesa) usam dataVencimento || data
// • Items manuais (sem vencimento explícito) usam a data principal
function _extDueDate(it){
  return it.dataVencimento || it.data || '';
}
// Status efetivo pra display: 'pago' | 'pendente' | 'atrasado'
// Regra: pendente + due date no passado (< hoje) → 'atrasado'
function _extEffStatus(it){
  if(it.status === 'pago') return 'pago';
  const due = _extDueDate(it);
  if(!due) return 'pendente';
  // Compara strings YYYY-MM-DD com hoje
  const t = new Date();
  const today = t.getFullYear() + '-' + String(t.getMonth()+1).padStart(2,'0') + '-' + String(t.getDate()).padStart(2,'0');
  if(due < today) return 'atrasado';
  return 'pendente';
}

// Calcula a data efetiva do lançamento conforme regime contábil:
// • Competência: data do lançamento → dataEmissao || dataVencimento
// • Caixa: data do dinheiro → se pago: dataPagamento; se pendente: dataVencimento
function _extDateLbl(yyyymmdd){
  if(!yyyymmdd) return '';
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(yyyymmdd);
  if(!m) return yyyymmdd;
  return m[3] + '/' + m[2];
}

function _extDateOf(it){
  if(_extState.mode === 'competencia'){
    return it.dataEmissao || it.dataVencimento || it.data || '';
  }
  if(it.status === 'pago' && it.dataPagamento) return it.dataPagamento;
  return it.dataVencimento || it.data || '';
}

function _extFilter(items){
  const r = _extPeriodRange();
  const conta = _extState.conta || '';
  const docFilter = (_extState.documento || '').toLowerCase().trim();
  const ccFilter = _extState.centroCustoId || '';
  const descSet = new Set((_extState.descricoes || []).map(s => (s||'').trim()).filter(Boolean));
  const cliSet  = new Set((_extState.clientes   || []).map(s => (s||'').trim()).filter(Boolean));
  return items.filter(it => {
    const dEff = _extDateOf(it);
    if(r && dEff){
      if(dEff < r.from || dEff > r.to) return false;
    }
    // Filtro de contas (multi-select)
    const contasSel = (Array.isArray(_extState.contas) ? _extState.contas : []).filter(Boolean);
    // Compat com filtro single antigo (_extState.conta) — adiciona ao array efetivo
    if(_extState.conta && !contasSel.includes(_extState.conta)) contasSel.push(_extState.conta);
    if(contasSel.length > 0){
      let match = false;
      for(const cv of contasSel){
        if(cv && cv.startsWith && cv.startsWith('cartao:')){
          const cartId = parseInt(cv.split(':')[1], 10);
          if((it.sourceKind === 'cartao' || it.sourceKind === 'cartao-fatura') && it.raw && it.raw.cartaoId === cartId){ match = true; break; }
        } else if(cv && (cv.startsWith('reserva:') || cv.startsWith('conta:'))){
          // Conta de Disponibilidades (caixa ou reserva): match pelo nome do banco no it.conta
          const contaId = parseInt(cv.split(':')[1], 10);
          try {
            if(typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.contas) && Array.isArray(dispo.bancos) && Array.isArray(dispo.tipos)){
              const c = dispo.contas.find(x => x.id === contaId);
              const banco = c ? dispo.bancos.find(b => b.id === c.bancoId) : null;
              const tp = c ? dispo.tipos.find(t => t.id === c.tipoId) : null;
              if(banco){
                const lbl = banco.nome + (tp && tp.nome ? ' · ' + tp.nome : '');
                if(it.conta === banco.nome || it.conta === lbl){ match = true; break; }
              }
            }
          } catch(e){}
        } else {
          if(it.conta === cv){ match = true; break; }
        }
      }
      if(!match) return false;
    }
    if(docFilter){
      const docVal = (it.numeroDocumento || '').toLowerCase();
      if(!docVal.includes(docFilter)) return false;
    }
    if(ccFilter){
      // ccFilter é string; centroCustoId no item é number
      const itCC = it.centroCustoId != null ? String(it.centroCustoId) : '';
      if(itCC !== ccFilter) return false;
    }
    if(descSet.size > 0){
      const d = (it.descricao || '').trim();
      if(!descSet.has(d)) return false;
    }
    if(cliSet.size > 0){
      const c = (it.contraparte || '').trim();
      if(!cliSet.has(c)) return false;
    }
    return true;
  });
}

function _extSortAsc(items){
  return items.slice().sort((a,b) => {
    const da = _extDateOf(a);
    const db = _extDateOf(b);
    return (da || '').localeCompare(db || '');
  });
}

// Resolve a tag do item de Estrutura associado ao lançamento.
// O id do item no Extrato é tipo "dkb:est-fixa:{itemId}:{ym}". Pegamos o itemId,
// achamos em estrutura.itens, e pegamos a tag pelo tagId em estrutura.tags.
function _extEstruturaTagOf(it){
  if(!it || it.categoria !== 'Estrutura') return null;
  if(typeof estrutura === 'undefined' || !estrutura) return null;
  if(!Array.isArray(estrutura.itens) || !Array.isArray(estrutura.tags)) return null;
  // Tenta extrair itemId do it.id (formato dkb:est-fixa:{itemId}:{ym})
  let itemId = null;
  if(typeof it.id === 'string' && it.id.startsWith('dkb:est-fixa:')){
    const parts = it.id.split(':');
    if(parts.length >= 3){
      const candidate = parts.slice(2, parts.length - 1).join(':');
      const asNum = parseInt(candidate, 10);
      itemId = isNaN(asNum) ? candidate : asNum;
    }
  }
  if(itemId == null) return null;
  const item = estrutura.itens.find(x => x.id === itemId || String(x.id) === String(itemId));
  if(!item || !item.tagId) return null;
  const tag = estrutura.tags.find(t => t.id === item.tagId);
  if(!tag) return null;
  return { nome: tag.nome || '(sem nome)', cor: tag.cor || tag.color || null };
}

function _extCatColor(it){
  if(it.tipo === 'ganho') return '#16A34A';        // verde — entradas
  if(it.tipo === 'transferencia') return '#2563EB';// azul — transferências
  return '#DC2626';                                 // vermelho — toda saída de caixa
}

