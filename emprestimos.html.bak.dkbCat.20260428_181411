    kpiRow.innerHTML =
        '<div class="ext-kpi ganho"><div class="ext-kpi-lbl">Entradas</div><div class="ext-kpi-val">' + _extFmtBRL(totGanho) + '</div><div class="ext-kpi-sub">' + filtered.filter(i=>i.tipo==="ganho").length + " lançamento(s)</div></div>"
      + '<div class="ext-kpi gasto"><div class="ext-kpi-lbl">Saídas</div><div class="ext-kpi-val">−' + _extFmtBRL(totGasto) + '</div><div class="ext-kpi-sub">' + filtered.filter(i=>i.tipo==="gasto").length + " lançamento(s)</div></div>"
      + '<div class="ext-kpi saldo' + (saldo < 0 ? ' is-neg' : '') + '"><div class="ext-kpi-lbl">Saldo do Período</div><div class="ext-kpi-val">' + _extFmtBRL(saldo) + '</div><div class="ext-kpi-sub">' + count + " lançamento(s) · " + pendente + " pendente(s)" + (atrasado > 0 ? " · <span style=\"color:#DC2626;font-weight:700\">" + atrasado + " atrasado(s)</span>" : "") + "</div></div>"
      + '<div class="ext-kpi transf"><div class="ext-kpi-lbl">Transferências</div><div class="ext-kpi-val">' + _extFmtBRL(totTransf) + '</div><div class="ext-kpi-sub">' + filtered.filter(i=>i.tipo==="transferencia").length + " mov(s)</div></div>";
  }

  // Tabela
