// Calcula saldo efetivado pra um mês: saldo_anterior − amort_main − sum(amort dos extras).
function _regEstimarSaldo(loan, mesStr){
  if(!loan || !mesStr) return 0;
  const reg = (loan.registros||[]).find(r => r.mes === mesStr);
  let amortTotal = 0;
  if(reg){
    if(reg.amortEfetivada !== '' && reg.amortEfetivada != null) amortTotal += parseFloat(reg.amortEfetivada) || 0;
    for(const ex of (reg.extras || [])){
      if(ex.amort !== '' && ex.amort != null) amortTotal += parseFloat(ex.amort) || 0;
    }
  }
  // Mês anterior (no calendário)
  const [y, mo] = mesStr.split('-').map(Number);
  const prev = new Date(y, mo - 2, 1);
  const prevStr = prev.getFullYear() + '-' + String(prev.getMonth()+1).padStart(2,'0');
  const prevReg = (loan.registros||[]).find(r => r.mes === prevStr);
  const saldoAnterior = (prevReg && prevReg.saldoEfetivado !== '' && prevReg.saldoEfetivado != null)
    ? (parseFloat(prevReg.saldoEfetivado) || 0)
    : (parseFloat(loan.saldo) || 0);
  return Math.max(0, saldoAnterior - amortTotal);
}

