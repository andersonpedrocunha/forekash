    ? `<img class="dispo-banco-logo" src="${logo}" alt="${esc(banco.nome)}"
            data-fb="${fb||''}" data-ini="${esc(ini)}" data-bc="${esc(banco.color||'#E5E7EB')}"
            onerror="dispoLogoImgFallback(this)">`
