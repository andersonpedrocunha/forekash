function createLoanBanco(loanId){
  const nome   = (document.getElementById('loan-nb-nome').value || '').trim();
  const domain = (document.getElementById('loan-nb-domain').value || '').trim().toLowerCase().replace(/^https?:\/\//,'').replace(/\/.*$/,'');
  const color  = document.getElementById('loan-nb-color').value || '#E5E7EB';
  if(!nome){ toast('⚠️ Informe o nome do banco.'); return; }
  const id = dispoNextId('bancos');
  dispo.bancos.push({ id, nome, domain: domain || null, color });
  dispoSave();
  setLoanBanco(loanId, id);
  closeDispoPickers();
}

function saveTipo(id,sel){
  const loan=loans.find(l=>l.id===id); if(!loan)return;
  if(sel.value === '__new__'){
    sel.value = loan.tipo || 'price';
    sel.className = 'tipo-sel ' + getModalidadeClass(sel.value);
    openNewModalidadeDialog(id);
    return;
  }
  if(sel.value === '__manage__'){
    sel.value = loan.tipo || 'price';
    sel.className = 'tipo-sel ' + getModalidadeClass(sel.value);
    openLoanModalidadeManager();
    return;
  }
  loan.tipo = sel.value;
  saveData();
  sel.className = 'tipo-sel ' + getModalidadeClass(sel.value);
}

async function openNewModalidadeDialog(loanId){
  const nome = await askText({
    title: 'Nova modalidade',
    label: 'Nome da modalidade',
    placeholder: 'Ex: Pronampe, FGI, Consignado…',
    confirmText: 'Criar',
    hint: 'O cálculo da parcela segue o modelo Price (parcela fixa). Para amortização decrescente use a modalidade SAC.',
    validate: (v) => {
      const t = (v||'').trim();
      if(!t) return 'Informe um nome.';
      if(t.length > 40) return 'Nome muito longo (máx 40).';
      const id = loanModalidadeIdFromNome(t);
      if(loanModalidades.some(m => m.id === id)) return 'Já existe uma modalidade com esse nome.';
      return null;
    }
  });
  if(nome == null) return;
  const trimmed = nome.trim();
  const id = loanModalidadeIdFromNome(trimmed);
  loanModalidades.push({ id, nome: trimmed, engine: 'price', builtin: false });
  loanModalidadesSave();
  // Aplica a modalidade recém-criada ao empréstimo
  const loan = loans.find(l => l.id === loanId);
  if(loan){
    loan.tipo = id;
    saveData();
  }
  render();
  toast(`Modalidade "${trimmed}" criada.`);
}

function loanModalidadeIdFromNome(nome){
  return (nome||'').toString()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .toLowerCase().trim()
    .replace(/[^a-z0-9]+/g,'-')
    .replace(/^-+|-+$/g,'')
    .slice(0, 30) || ('mod-' + Date.now());
}

// ─── Manager modal: editar/excluir modalidades ───
function openLoanModalidadeManager(){
  const ov = document.getElementById('ov-loan-mod'); if(!ov) return;
  renderLoanModalidadeManager();
  ov.classList.add('open');
}
function closeLoanModalidadeManager(){
  const ov = document.getElementById('ov-loan-mod'); if(ov) ov.classList.remove('open');
}
function loanModalidadeUsage(id){
  return (loans||[]).filter(l => (l.tipo||'price') === id).length;
}
function renderLoanModalidadeManager(){
  const body = document.getElementById('loan-mod-body'); if(!body) return;
  const itemsHtml = loanModalidades.map(m => {
    const use       = loanModalidadeUsage(m.id);
    const pillCls   = m.builtin ? m.id : 'custom';
    const canDelete = !m.builtin && use === 0;
    const canEdit   = !m.builtin;
    const delTitle  = m.builtin
      ? 'Modalidade padrão — não pode ser excluída'
      : (use > 0 ? `Em uso por ${use} empréstimo${use===1?'':'s'} — realoque antes` : 'Excluir modalidade');
    return `
      <div class="loan-mod-item" data-mod-id="${esc(m.id)}">
        <span class="tipo-sel ${pillCls}" style="pointer-events:none;min-width:62px;max-width:62px;text-align:center">
          ${esc(m.nome)}
        </span>
        <input class="loan-mod-nome" value="${esc(m.nome)}" placeholder="Nome"
               ${canEdit ? '' : 'disabled'}
               ${canEdit ? `onchange="renameLoanModalidade('${esc(m.id)}', this.value)"` : ''}>
        <div class="loan-mod-engine" role="tablist" ${canEdit?'':'data-locked="1"'}>
          <button class="price${m.engine==='price'?' active':''}"
                  ${canEdit?`onclick="setLoanModalidadeEngine('${esc(m.id)}','price')"`:'disabled'}
                  title="Parcela fixa">Price</button>
          <button class="sac${m.engine==='sac'?' active':''}"
                  ${canEdit?`onclick="setLoanModalidadeEngine('${esc(m.id)}','sac')"`:'disabled'}
                  title="Amortização decrescente">SAC</button>
        </div>
        <span class="loan-mod-uses${use?'':' zero'}">${use} ${use===1?'uso':'usos'}</span>
        <button class="loan-mod-del" ${canDelete ? '' : 'disabled'} title="${delTitle}"
                onclick="delLoanModalidade('${esc(m.id)}')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m2 0v14a2 2 0 01-2 2H8a2 2 0 01-2-2V6m4 4v8m4-8v8"/>
          </svg>
        </button>
      </div>`;
  }).join('');
  body.innerHTML = `
    <p class="loan-mod-intro">
      <strong>Price</strong> e <strong>SAC</strong> são modalidades padrão do sistema e não podem ser removidas.
      Modalidades customizadas podem ser renomeadas, ter o método de cálculo alterado (Price = parcela fixa, SAC = amortização decrescente) ou excluídas quando não estão em uso.
    </p>
    <div class="loan-mod-list">
      ${itemsHtml}
    </div>
    <div class="loan-mod-add-row">
      <input id="loan-mod-new-nome" placeholder="Nova modalidade (ex: Pronampe, FGI…)"
             onkeydown="if(event.key==='Enter')addLoanModalidadeFromManager()">
      <div class="loan-mod-engine" id="loan-mod-new-engine">
        <button class="price active" data-eng="price" onclick="_loanModNewEng(this,'price')" title="Parcela fixa">Price</button>
        <button class="sac" data-eng="sac" onclick="_loanModNewEng(this,'sac')" title="Amortização decrescente">SAC</button>
      </div>
      <button class="loan-mod-add-btn" onclick="addLoanModalidadeFromManager()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        Adicionar
      </button>
    </div>`;
}
function _loanModNewEng(btn, eng){
  const g = btn.parentElement;
  g.querySelectorAll('button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  g.setAttribute('data-eng', eng);
}
function addLoanModalidadeFromManager(){
  const inp = document.getElementById('loan-mod-new-nome');
  const engBtn = document.querySelector('#loan-mod-new-engine .active');
  const nome = (inp && inp.value || '').trim();
  const eng  = (engBtn && engBtn.dataset.eng) || 'price';
  if(!nome){ if(inp) inp.focus(); return; }
  const id = loanModalidadeIdFromNome(nome);
  if(loanModalidades.some(m => m.id === id)){
    toast('Já existe uma modalidade com esse nome.'); return;
  }
  loanModalidades.push({ id, nome, engine: (eng==='sac'?'sac':'price'), builtin:false });
  loanModalidadesSave();
  if(inp) inp.value = '';
  renderLoanModalidadeManager();
  render();
  toast(`Modalidade "${nome}" criada.`);
}
function renameLoanModalidade(id, nome){
  const m = getLoanModalidade(id); if(!m || m.builtin) return;
  const trimmed = (nome||'').trim();
  if(!trimmed){ renderLoanModalidadeManager(); return; }
  m.nome = trimmed;
  loanModalidadesSave();
  render();
  renderLoanModalidadeManager();
}
function setLoanModalidadeEngine(id, eng){
  const m = getLoanModalidade(id); if(!m || m.builtin) return;
  m.engine = (eng === 'sac') ? 'sac' : 'price';
  loanModalidadesSave();
  render();
  renderLoanModalidadeManager();
}
async function delLoanModalidade(id){
  const m = getLoanModalidade(id); if(!m) return;
  if(m.builtin){ toast('Não é possível excluir modalidade padrão.'); return; }
  const use = loanModalidadeUsage(id);
  if(use > 0){
    toast(`Modalidade em uso por ${use} empréstimo${use===1?'':'s'} — realoque antes.`);
    return;
  }
  const ok = await showConfirm({
    title: 'Excluir modalidade',
    message: `Remover a modalidade <strong>${esc(m.nome)}</strong>?`,
    confirmLabel: 'Excluir', destructive: true
  });
  if(!ok) return;
  loanModalidades = loanModalidades.filter(x => x.id !== id);
  loanModalidadesSave();
  render();
  renderLoanModalidadeManager();
}

function unfmt(el){ const s=el.value.toString().replace(/\./g,'').replace(',','.'); el.value=isNaN(parseFloat(s))?'':parseFloat(s); }
function fmtInp(el,d=2){ const n=parseFloat(el.value); el.value=(!isNaN(n)&&el.value!=='')?fmtBR(n,d):''; }

