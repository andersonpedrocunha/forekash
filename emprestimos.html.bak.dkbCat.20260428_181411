// ─── Toggle ativo direto na linha ───
function wfCadToggleAtivoCli(cid){
  if(typeof recClientes !== 'function') return;
  const c = recClientes().find(x => x.id === cid);
  if(!c) return;
  c.ativo = !(c.ativo !== false);
  if(typeof receitaSave === 'function') receitaSave();
  renderWfClientes();
  if(typeof toast === 'function') toast(c.ativo ? '✓ Cliente ativado' : 'Cliente inativado');
}
function wfCadToggleAtivoForn(pid){
  if(typeof pessoas === 'undefined' || !Array.isArray(pessoas.people)) return;
  const rows = pessoas.people.filter(p => p.pessoaId === pid && !p.sim);
  if(rows.length === 0){
    if(typeof toast === 'function') toast('Sem linhas para alternar (adicione no módulo Pessoas)');
    return;
  }
  const algumAtivo = rows.some(r => r.ativo !== false);
  // Se algum estiver ativo, inativa todos. Senão, ativa todos.
  const novoAtivo = !algumAtivo;
  rows.forEach(r => { r.ativo = novoAtivo; });
  if(typeof pessoasSave === 'function') pessoasSave();
  renderWfFornecedores();
  if(typeof toast === 'function') toast(novoAtivo ? '✓ Pessoa ativada' : 'Pessoa inativada');
}
try {
  window.wfCadToggleAtivoCli = wfCadToggleAtivoCli;
  window.wfCadToggleAtivoForn = wfCadToggleAtivoForn;
} catch(e){}

