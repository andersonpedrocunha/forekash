];

// Presunção de lucro (IRPJ/CSLL) por tipo de atividade — regra geral
// Serviços em geral: 32% / Comércio e indústria: IRPJ 8%, CSLL 12%
function _impPresuncaoIR(){
  return (impostos.atividade === 'servicos') ? 0.32 : 0.08;
}
function _impPresuncaoCS(){
  return (impostos.atividade === 'servicos') ? 0.32 : 0.12;
}

// Calcula a previsão de um imposto específico para um determinado mês de PAGAMENTO.
// A competência segue o padrão brasileiro: o imposto pago em M refere-se à receita
// (ou ao lucro) do mês anterior M-1. No regime trimestral do Lucro Presumido, IRPJ e
// CSLL são pagos em janeiro (Q4 do ano anterior), abril (Q1), julho (Q2) e outubro (Q3).
function impForecastValor(rubricaId, year, mIdx){
  const regime = impostos.regimeTributario;
  if(!regime) return null;

  // MEI não depende de receita — valor fixo apenas na rubrica DAS
  if(regime === 'mei'){
    if(rubricaId === 'das') return +impostos.meiValor || 0;
    return null;
  }

  const id = String(rubricaId).toLowerCase();
  const isServicos = (impostos.atividade === 'servicos');

  // Receita do mês de competência (mês anterior ao de pagamento)
  const receitaComp = impReceitaMesCompetencia(year, mIdx);

  // Flags para tratamento especial (trimestral presumido, lucro real IRPJ/CSLL)
  const isTrimestralPresumido = (regime === 'presumido' && impostos.apuracao === 'trimestral' && (id === 'irpj' || id === 'csll'));
  const isLucroRealResultado  = (regime === 'real' && (id === 'irpj' || id === 'csll'));

  // Para tributos mensais comuns, sem receita de competência → sem previsão
  if(receitaComp <= 0 && !isTrimestralPresumido && !isLucroRealResultado) return null;

  if(regime === 'simples'){
    // Único tributo: DAS, calculado pela alíquota informada sobre a receita da competência
    if(id === 'das'){
      const aliq = (+impostos.simplesAliquota || 0) / 100;
      return receitaComp * aliq;
    }
    return null;
  }

  if(regime === 'presumido'){
    if(id === 'pis')    return receitaComp * 0.0065;
    if(id === 'cofins') return receitaComp * 0.03;
    if(id === 'iss' && isServicos){
      return receitaComp * ((+impostos.issAliquota || 0) / 100);
    }
    if(id === 'inss'){
      const aliq = +impostos.inssAliquota || 0;
      if(aliq <= 0) return null;
      return receitaComp * (aliq / 100);
    }
    // IRPJ e CSLL — apuração mensal ou trimestral
    if(id === 'irpj' || id === 'csll'){
      const trimestral = (impostos.apuracao === 'trimestral');
      if(trimestral){
        // Só aparece no mês de pagamento do trimestre: jan/abr/jul/out
        if(!impEhPagamentoTrimestre(mIdx)) return null;
        const receitaTri = impReceitaTrimestreCompetencia(year, mIdx);
        if(receitaTri <= 0) return null;
        if(id === 'irpj'){
          const base = receitaTri * _impPresuncaoIR();
          let irpj = base * 0.15;
          // Adicional de 10% sobre a parcela que exceder R$ 60.000 no trimestre
          if(base > 60000) irpj += (base - 60000) * 0.10;
          return irpj;
        }
        // CSLL trimestral
        return receitaTri * _impPresuncaoCS() * 0.09;
      }
      // Apuração mensal — competência do mês anterior
      if(id === 'irpj'){
        const base = receitaComp * _impPresuncaoIR();
        let irpj = base * 0.15;
        // Adicional de 10% sobre a parcela da base que exceder R$ 20.000 no mês
        if(base > 20000) irpj += (base - 20000) * 0.10;
        return irpj;
      }
      return receitaComp * _impPresuncaoCS() * 0.09;
    }
    return null;
  }

  if(regime === 'real'){
    if(id === 'pis')    return receitaComp * 0.0165;
    if(id === 'cofins') return receitaComp * 0.076;
    if(id === 'iss' && isServicos){
      return receitaComp * ((+impostos.issAliquota || 0) / 100);
    }
    if(id === 'inss'){
      const aliq = +impostos.inssAliquota || 0;
      if(aliq <= 0) return null;
      return receitaComp * (aliq / 100);
    }
    // IRPJ e CSLL sobre o LUCRO apurado no Demonstrativo (DRC) do mês de competência.
    // Prejuízo → sem imposto devido.
    if(id === 'irpj' || id === 'csll'){
      const trimestral = (impostos.apuracao === 'trimestral');
      if(trimestral){
        // Só aparece no mês de pagamento do trimestre: jan/abr/jul/out
        if(!impEhPagamentoTrimestre(mIdx)) return null;
        const lucroTri = impLucroTrimestreCompetencia(year, mIdx);
        if(lucroTri <= 0) return null;
        if(id === 'irpj'){
          let irpj = lucroTri * 0.15;
          // Adicional de 10% sobre o que exceder R$ 60.000 no trimestre
          if(lucroTri > 60000) irpj += (lucroTri - 60000) * 0.10;
          return irpj;
        }
        // CSLL trimestral
        return lucroTri * 0.09;
      }
      // Apuração mensal — lucro do mês anterior (competência)
      let lucro = 0;
      try{
        if(typeof flxResultadoMes === 'function'){
          if(mIdx === 0){
            lucro = +flxResultadoMes(String(+year - 1), 11) || 0;
          } else {
            lucro = +flxResultadoMes(year, mIdx - 1) || 0;
          }
        }
      }catch(e){}
      if(lucro <= 0) return null;
      if(id === 'irpj'){
        let irpj = lucro * 0.15;
        if(lucro > 20000) irpj += (lucro - 20000) * 0.10;
        return irpj;
      }
      return lucro * 0.09;
    }
    return null;
  }

  if(regime === 'custom'){
    const tbl = impostos.aliquotasCustom || {};
    const aliq = +tbl[id];
    if(!isFinite(aliq) || aliq <= 0) return null;
    return receitaComp * (aliq / 100);
  }

  return null;
}

