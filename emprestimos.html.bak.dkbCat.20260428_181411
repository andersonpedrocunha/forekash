function updateImpParKpis(){
  const year = impActiveYearPar;
  const hojeYM = impMesKey(String(new Date().getFullYear()), new Date().getMonth());
  // Saldo devedor consolidado "hoje" (mês corrente)
  const saldoHoje = impParcSaldoConsolidado(hojeYM);
  // Parcelas no ano ativo
  let pagoAno = 0;
  for(let m=0;m<12;m++){
    const ym = impMesKey(year, m);
    for(const p of impostos.parcelamentos){
      pagoAno += impParcelaDoMes(p, ym);
    }
  }
  // Parcela mensal somada (ativos, mês corrente)
  let parcelaMensal = 0;
  let ativos = 0;
  for(const p of impostos.parcelamentos){
    if(p.ativo === false) continue;
    const v = impParcelaDoMes(p, hojeYM);
    if(v > 0) ativos++;
    parcelaMensal += v;
  }
  const count = impostos.parcelamentos.length;

  const elS  = document.getElementById('imp-par-kpi-saldo');   if(elS)  elS.textContent = fmtBRL(saldoHoje);
  const elA  = document.getElementById('imp-par-kpi-ano');     if(elA)  elA.textContent = fmtBRL(pagoAno);
  const elM  = document.getElementById('imp-par-kpi-mensal');  if(elM)  elM.textContent = fmtBRL(parcelaMensal);
  const elC  = document.getElementById('imp-par-kpi-count');   if(elC)  elC.textContent = count;
  const elCS = document.getElementById('imp-par-kpi-count-sub');
  if(elCS) elCS.textContent = count === 0 ? 'nenhum cadastrado'
                             : (ativos + ' ativo' + (ativos===1?'':'s') + ' no mês');
  const elMS = document.getElementById('imp-par-kpi-mensal-sub');
  if(elMS) elMS.textContent = 'total das parcelas em ' + hojeYM;
}

