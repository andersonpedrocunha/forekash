    .fk-sheet-table tfoot td.grn{color:#86EFAC}
    .fk-sheet-cli{display:flex;align-items:center;gap:8px}
    .fk-sheet-cli-av{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;
                     font-size:.58rem;font-weight:800;color:#fff;flex-shrink:0}
    .fk-sheet-flag{font-size:.9rem;line-height:1}
    .fk-sheet-at{display:inline-block;width:22px;height:12px;border-radius:6px;background:#10B981;position:relative;vertical-align:middle}
    .fk-sheet-at::after{content:'';position:absolute;top:1px;right:1px;width:10px;height:10px;border-radius:50%;background:#fff}
    .fk-sheet-at.off{background:#D1D5DB}
    .fk-sheet-at.off::after{left:1px;right:auto}
    .fk-sheet-tipo{display:inline-block;padding:2px 7px;border-radius:5px;font-size:.62rem;font-weight:700;
                   background:#EEF2FF;color:#4338CA;letter-spacing:.02em}
    .fk-sheet-tipo.recur{background:#D1FAE5;color:#065F46}
    .fk-sheet-tipo.proj{background:#FEF3C7;color:#92400E}
    .fk-sheet-tipo.lead{background:#EDE9FE;color:#6D28D9}

    /* Banda separador de leads */
    .fk-sheet-sep td{background:#FAF5FF;color:#7C3AED;text-transform:uppercase;letter-spacing:.06em;
                     font-size:.62rem;font-weight:800;padding:6px 10px;border-top:1px dashed #E9D5FF;border-bottom:1px dashed #E9D5FF}

    /* Legenda Receita */
    .fk-show-lg{display:flex;gap:16px;font-size:.7rem;color:#6B7280;margin-top:12px;flex-wrap:wrap;align-items:center}
    .fk-show-lg-it{display:flex;align-items:center;gap:6px}
    .fk-show-lg-sq{width:12px;height:12px;border-radius:3px;flex-shrink:0}
    .fk-show-lg-sq.rec{background:#D1FAE5;border:1px solid #6EE7B7}
    .fk-show-lg-sq.ab{background:#FEF3C7;border:1px solid #FCD34D}
    .fk-show-lg-sq.sm{background:#EDE9FE;border:1px solid #C4B5FD}

    /* ═══ Diagnóstico IA · mock card ═══ */
    .fk-diag{background:#fff;border:1px solid #E5E7EB;border-radius:12px;overflow:hidden;
             max-width:1100px;margin:0 auto}
    .fk-diag-hd{padding:18px 22px;background:#0F172A;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
    .fk-diag-hd h3{margin:0;font-size:1.2rem;font-weight:800;letter-spacing:-.02em}
    .fk-diag-hd h3 .chip-ia{font-size:.58rem;font-weight:800;letter-spacing:.08em;padding:3px 7px;border-radius:6px;
                             background:linear-gradient(110deg,#6366F1,#8B5CF6,#A855F7);color:#fff;
                             vertical-align:middle;margin-left:6px;text-transform:uppercase}
    .fk-diag-hd p{margin:4px 0 0;font-size:.74rem;color:#94A3B8;line-height:1.5}
    .fk-diag-gen{background:linear-gradient(135deg,#6366F1,#8B5CF6);color:#fff;padding:8px 14px;border-radius:8px;
                 font-size:.78rem;font-weight:700;display:inline-flex;align-items:center;gap:6px;border:none}
    .fk-diag-gen svg{width:14px;height:14px;fill:currentColor}

    .fk-diag-body{padding:22px}
