function _viagRenderTable(lista){
  if(lista.length === 0){
    return '<div class="viag-empty"><span class="viag-empty-icon">📊</span><div class="viag-empty-title">Nenhum relatório</div><div class="viag-empty-sub">Use o toolbar pra criar ou ajuste os filtros</div></div>';
  }
  // Sort
  const sortBy = _viagSettings.sortBy || 'dataInicio';
  const sortDir = _viagSettings.sortDir === 'asc' ? 1 : -1;
  const sorted = lista.slice().sort((a,b) => {
    let av, bv;
    if(sortBy === 'dataInicio')      { av = a.dataInicio||''; bv = b.dataInicio||''; }
    else if(sortBy === 'titulo')     { av = (a.titulo||'').toLowerCase(); bv = (b.titulo||'').toLowerCase(); }
    else if(sortBy === 'destino')    { av = (a.destino||'').toLowerCase(); bv = (b.destino||'').toLowerCase(); }
    else if(sortBy === 'colaborador'){ av = (a.colaborador||'').toLowerCase(); bv = (b.colaborador||'').toLowerCase(); }
    else if(sortBy === 'status')     { av = a.status||''; bv = b.status||''; }
    else if(sortBy === 'total')      { av = _viagTotalDesp(a); bv = _viagTotalDesp(b); }
    else if(sortBy === 'saldo')      { av = _viagSaldo(a); bv = _viagSaldo(b); }
    else if(sortBy === 'aging')      { av = _viagMsAberta(a) || 0; bv = _viagMsAberta(b) || 0; }
    else if(sortBy === 'criadoEm')   { av = a.criadoEm||''; bv = b.criadoEm||''; }
    else { av = ''; bv = ''; }
    if(av < bv) return -1 * sortDir;
    if(av > bv) return  1 * sortDir;
    return 0;
  });
  const arrow = (f) => sortBy === f ? (sortDir === 1 ? ' ▲' : ' ▼') : '';
  const th = (f, lbl, cls) => '<th class="' + (cls||'') + (sortBy === f ? ' is-sorted' : '') + '" onclick="viagSortBy(\'' + f + '\')">' + lbl + arrow(f) + '</th>';
  let html = '<div class="viag-table-wrap"><table class="viag-table">'
    + '<thead><tr>'
    +   th('status', 'Status')
    +   th('titulo', 'Título')
    +   th('colaborador', 'Colaborador')
    +   th('destino', 'Destino')
    +   th('dataInicio', 'Data')
    +   th('total', 'Total', 'right')
    +   th('saldo', 'Saldo', 'right')
    +   th('aging', '⏱ Aging')
    +   '<th>🔏</th>'
    + '</tr></thead><tbody>';
  for(const v of sorted){
    const tot = _viagTotalDesp(v);
    const saldo = _viagSaldo(v);
    const st = _viagStatus(v.status || 'rascunho');
    const ms = _viagMsAberta(v);
    const dias = _viagDiasAberta(v);
    const closed = _viagIsClosed(v);
    const ageCls = _viagAgeClass(dias || 0, closed);
    const fmtAge = ms != null ? _viagFmtDuracao(ms) : '—';
    const datas = _viagFmtData(v.dataInicio) + (v.dataFim && v.dataFim !== v.dataInicio ? ' → ' + _viagFmtData(v.dataFim) : '');
    let signCol = '';
    if(v.aprovacao) signCol = '<span class="viag-tbl-sig-mini ok" title="Aprovado por ' + esc(v.aprovacao.aprovador||'') + (v.aprovacao.codigo ? ' · ' + v.aprovacao.codigo : '') + '">🔏</span>';
    else if(v.rejeicao) signCol = '<span class="viag-tbl-sig-mini bad" title="Rejeitado por ' + esc(v.rejeicao.por||'') + (v.rejeicao.codigo ? ' · ' + v.rejeicao.codigo : '') + '">❌</span>';
    html += '<tr onclick="viagOpenEditor(' + v.id + ')">'
      + '<td><span class="viag-status ' + st.id + '">' + st.nome + '</span></td>'
      + '<td class="bold">' + esc(v.titulo || '(sem título)') + '</td>'
      + '<td>' + esc(v.colaborador || '—') + '</td>'
      + '<td>' + esc(v.destino || '—') + '</td>'
      + '<td class="mono">' + datas + '</td>'
      + '<td class="right mono">' + _viagFmt(tot) + '</td>'
      + '<td class="right mono ' + (saldo >= 0 ? 'pos' : 'neg') + '">' + _viagFmt(saldo) + '</td>'
      + '<td><span class="viag-kb-age ' + ageCls + '">' + fmtAge + '</span></td>'
      + '<td>' + signCol + '</td>'
      + '</tr>';
  }
  html += '</tbody></table></div>';
  return html;
}
function _viagRenderDashboard(lista){
  if(lista.length === 0){
    return '<div class="viag-empty"><span class="viag-empty-icon">📈</span>'
      + '<div class="viag-empty-title">Sem dados pra exibir</div>'
      + '<div class="viag-empty-sub">Crie viagens com despesas pra ver o overview</div></div>';
  }
  // ─── Agregações ───
  const totalViagens = lista.length;
  let totalGasto = 0, totalEmp = 0, totalFunc = 0, totalDespesas = 0;
  const byCat = {};       // categoria → total
  const byStatus = {};    // status → count
  const byDestino = {};   // destino → total
  const byColab = {};     // colaborador → total
  const byMes = {};       // YYYY-MM → total
  let valorPendente = 0;
  let tempoAprovacao = []; // ms entre enviado e aprovado/reembolsado
  for(const v of lista){
    const status = v.status || 'rascunho';
    byStatus[status] = (byStatus[status] || 0) + 1;
    const dest = (v.destino || '—').trim() || '—';
    const colab = (v.colaborador || '—').trim() || '—';
    let totalV = 0;
    let funcV = 0;
    for(const d of (v.despesas || [])){
      const val = parseFloat(d.valor) || 0;
      const cat = d.categoria || 'outros';
      totalV += val;
      totalDespesas++;
      byCat[cat] = (byCat[cat] || 0) + val;
      if((d.pagamento || 'funcionario') === 'empresa') totalEmp += val;
      else { totalFunc += val; funcV += val; }
      // Mês da despesa
      if(d.data){
        const ym = d.data.slice(0, 7);
        byMes[ym] = (byMes[ym] || 0) + val;
      } else if(v.dataInicio){
        const ym = v.dataInicio.slice(0, 7);
        byMes[ym] = (byMes[ym] || 0) + val;
      }
    }
    totalGasto += totalV;
    byDestino[dest] = (byDestino[dest] || 0) + totalV;
    byColab[colab] = (byColab[colab] || 0) + totalV;
    // Pendente: viagens não-finalizadas com despesas do funcionário
    if(status !== 'reembolsado' && status !== 'rejeitado'){
      valorPendente += funcV;
    }
    // Tempo de aprovação
    if(v.enviadoEm && (v.aprovadoEm || v.reembolsadoEm)){
      try {
        const t1 = new Date(v.enviadoEm).getTime();
        const t2 = new Date(v.aprovadoEm || v.reembolsadoEm).getTime();
        if(t2 > t1) tempoAprovacao.push(t2 - t1);
      } catch(e){}
    }
  }
  const ticketMedio = totalViagens > 0 ? totalGasto / totalViagens : 0;
  const tempoMedioMs = tempoAprovacao.length ? tempoAprovacao.reduce((s,v)=>s+v,0) / tempoAprovacao.length : 0;
  const tempoMedioFmt = tempoMedioMs > 0 ? _viagFmtDuracao(tempoMedioMs) : '—';
  const pctEmp = totalGasto > 0 ? (totalEmp / totalGasto * 100) : 0;
  const pctFunc = totalGasto > 0 ? (totalFunc / totalGasto * 100) : 0;

  // ─── KPIs hero ───
  const kpi = (lbl, val, ico, tone, sub) => '<div class="viag-dash-kpi viag-dash-kpi-' + tone + '">'
    + '<div class="viag-dash-kpi-ico">' + ico + '</div>'
    + '<div class="viag-dash-kpi-val">' + val + '</div>'
    + '<div class="viag-dash-kpi-lbl">' + lbl + (sub ? '<small>' + sub + '</small>' : '') + '</div>'
    + '</div>';
  const kpisHtml = '<div class="viag-dash-kpis">'
    + kpi('Total gasto',     _viagFmt(totalGasto),    '💰', 'success', totalDespesas + ' despesa(s)')
    + kpi('A reembolsar',    _viagFmt(valorPendente), '💵', valorPendente>0 ? 'warn' : 'neutral', valorPendente>0 ? 'pendente' : 'tudo quitado')
    + kpi('Ticket médio',    _viagFmt(ticketMedio),   '🧾', 'info', 'por viagem')
    + kpi('Tempo aprovação', tempoMedioFmt,           '⏱',  'info', tempoAprovacao.length + ' ciclo(s)')
    + kpi('Total relatórios', totalViagens,           '📋', 'neutral', '')
    + kpi('Categorias',      Object.keys(byCat).length, '🏷', 'neutral', 'usadas')
    + '</div>';

  // ─── Distribuição por status (barras horizontais) ───
  const statusColors = { rascunho:'#94A3B8', enviado:'#3B82F6', aprovado:'#A855F7', reembolsado:'#10B981', rejeitado:'#EF4444' };
  const maxStatus = Math.max(1, ...Object.values(byStatus));
  const statusBars = VIAG_STATUS.map(st => {
    const v = byStatus[st.id] || 0;
    const pct = (v / maxStatus) * 100;
    return '<div class="viag-dash-bar-row">'
      + '<span class="viag-dash-bar-lbl"><span class="viag-dash-bar-dot" style="background:' + statusColors[st.id] + '"></span>' + st.nome + '</span>'
      + '<div class="viag-dash-bar-track"><div class="viag-dash-bar-fill" style="width:' + pct + '%;background:' + statusColors[st.id] + '"></div></div>'
      + '<span class="viag-dash-bar-val">' + v + '</span>'
      + '</div>';
  }).join('');

  // ─── Top categorias (barras horizontais com valor) ───
  const catTopArr = Object.entries(byCat).sort((a,b) => b[1] - a[1]).slice(0, 6);
  const maxCat = Math.max(1, ...catTopArr.map(([,v]) => v));
  const catBars = catTopArr.length ? catTopArr.map(([cId, val]) => {
    const cat = _viagCat(cId);
    const pct = (val / maxCat) * 100;
    const pctTot = totalGasto > 0 ? (val / totalGasto * 100) : 0;
    return '<div class="viag-dash-bar-row">'
      + '<span class="viag-dash-bar-lbl">' + cat.icon + ' ' + cat.nome + '</span>'
      + '<div class="viag-dash-bar-track"><div class="viag-dash-bar-fill" style="width:' + pct + '%;background:linear-gradient(90deg,#0F766E,#14B8A6)"></div></div>'
      + '<span class="viag-dash-bar-val">' + _viagFmt(val) + ' <small>' + pctTot.toFixed(0) + '%</small></span>'
      + '</div>';
  }).join('') : '<div class="viag-dash-empty">Sem categorias</div>';

  // ─── Empresa vs Funcionário (split visual) ───
  const splitHtml = '<div class="viag-dash-split">'
    + '<div class="viag-dash-split-bar">'
    +   '<div class="viag-dash-split-emp" style="width:' + pctEmp + '%" title="Empresa: ' + _viagFmt(totalEmp) + '"></div>'
    +   '<div class="viag-dash-split-func" style="width:' + pctFunc + '%" title="Funcionário: ' + _viagFmt(totalFunc) + '"></div>'
    + '</div>'
    + '<div class="viag-dash-split-legend">'
    +   '<div class="viag-dash-split-leg-item"><span class="dot" style="background:#0F766E"></span><span class="lbl">💳 Empresa</span><span class="val">' + _viagFmt(totalEmp) + ' <small>(' + pctEmp.toFixed(0) + '%)</small></span></div>'
    +   '<div class="viag-dash-split-leg-item"><span class="dot" style="background:#7C3AED"></span><span class="lbl">💵 Funcionário</span><span class="val">' + _viagFmt(totalFunc) + ' <small>(' + pctFunc.toFixed(0) + '%)</small></span></div>'
    + '</div>'
    + '</div>';

  // ─── Top destinos ───
  const destTop = Object.entries(byDestino).sort((a,b) => b[1] - a[1]).slice(0, 5);
  const maxDest = Math.max(1, ...destTop.map(([,v]) => v));
  const destHtml = destTop.length ? destTop.map(([nome, val]) => {
    const pct = (val / maxDest) * 100;
    return '<div class="viag-dash-bar-row">'
      + '<span class="viag-dash-bar-lbl">📍 ' + _bdEsc(nome) + '</span>'
      + '<div class="viag-dash-bar-track"><div class="viag-dash-bar-fill" style="width:' + pct + '%;background:#3B82F6"></div></div>'
      + '<span class="viag-dash-bar-val">' + _viagFmt(val) + '</span>'
      + '</div>';
  }).join('') : '<div class="viag-dash-empty">Sem destinos</div>';

  // ─── Top colaboradores ───
  const colabTop = Object.entries(byColab).sort((a,b) => b[1] - a[1]).slice(0, 5);
  const maxColab = Math.max(1, ...colabTop.map(([,v]) => v));
  const colabHtml = colabTop.length ? colabTop.map(([nome, val]) => {
    const pct = (val / maxColab) * 100;
    return '<div class="viag-dash-bar-row">'
      + '<span class="viag-dash-bar-lbl">👤 ' + _bdEsc(nome) + '</span>'
      + '<div class="viag-dash-bar-track"><div class="viag-dash-bar-fill" style="width:' + pct + '%;background:#A855F7"></div></div>'
      + '<span class="viag-dash-bar-val">' + _viagFmt(val) + '</span>'
      + '</div>';
  }).join('') : '<div class="viag-dash-empty">Sem colaboradores</div>';

  // ─── Tendência mensal (últimos 6 meses) ───
  const mesesOrd = Object.keys(byMes).sort();
  const mesesUlt = mesesOrd.slice(-6);
  const maxMes = Math.max(1, ...mesesUlt.map(m => byMes[m] || 0));
  const monthFmt = (ym) => {
    const [y, m] = ym.split('-');
    const nomes = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
    return nomes[parseInt(m,10)-1] + '/' + y.slice(2);
  };
  const mensalHtml = mesesUlt.length ? '<div class="viag-dash-mensal">'
    + mesesUlt.map(m => {
      const v = byMes[m] || 0;
      const h = (v / maxMes) * 100;
      return '<div class="viag-dash-mensal-col">'
        + '<div class="viag-dash-mensal-bar-wrap"><div class="viag-dash-mensal-bar" style="height:' + h + '%" title="' + _viagFmt(v) + '"></div></div>'
        + '<div class="viag-dash-mensal-val">' + _viagFmt(v).replace('R$ ','') + '</div>'
        + '<div class="viag-dash-mensal-lbl">' + monthFmt(m) + '</div>'
        + '</div>';
    }).join('')
    + '</div>'
    : '<div class="viag-dash-empty">Sem dados mensais</div>';

  // ─── Insights ───
  const insights = [];
  const rejeitadas = byStatus.rejeitado || 0;
  const enviadas   = byStatus.enviado   || 0;
  const aprovadas  = byStatus.aprovado  || 0;
  if(valorPendente > 0)  insights.push({ ico:'💵', tone:'warn', text:'<b>' + _viagFmt(valorPendente) + '</b> pendente de reembolso ao funcionário' });
  if(enviadas > 0)       insights.push({ ico:'📤', tone:'info', text:'<b>' + enviadas + '</b> relatório' + (enviadas>1?'s':'') + ' aguardando aprovação' });
  if(aprovadas > 0)      insights.push({ ico:'✅', tone:'info', text:'<b>' + aprovadas + '</b> relatório' + (aprovadas>1?'s':'') + ' aprovado' + (aprovadas>1?'s':'') + ' aguardando reembolso' });
  if(rejeitadas > 0)     insights.push({ ico:'❌', tone:'danger', text:'<b>' + rejeitadas + '</b> relatório' + (rejeitadas>1?'s':'') + ' rejeitado' + (rejeitadas>1?'s':'') + ' — revise os motivos' });
  if(catTopArr.length > 0){
    const [topId, topVal] = catTopArr[0];
    const topPctTot = totalGasto > 0 ? (topVal / totalGasto * 100) : 0;
    if(topPctTot > 40) insights.push({ ico:'📊', tone:'info', text:'<b>' + _viagCat(topId).nome + '</b> representa <b>' + topPctTot.toFixed(0) + '%</b> dos gastos — categoria dominante' });
  }
  if(tempoAprovacao.length >= 3 && tempoMedioMs > 7*86400000) insights.push({ ico:'⏰', tone:'warn', text:'Tempo médio de aprovação está em <b>' + tempoMedioFmt + '</b> — acima de 7 dias' });
  if(insights.length === 0) insights.push({ ico:'✨', tone:'success', text:'Tudo no controle. Sem alertas no momento.' });
  const insightsHtml = insights.slice(0, 5).map(i =>
    '<div class="viag-dash-insight viag-dash-insight-' + i.tone + '"><span class="ico">' + i.ico + '</span><span class="txt">' + i.text + '</span></div>'
  ).join('');

  // ─── Layout ───
  return '<div class="viag-dash">'
    + kpisHtml
    + '<div class="viag-dash-grid">'
    +   '<div class="viag-dash-card"><h3>📊 Status dos relatórios</h3>' + statusBars + '</div>'
    +   '<div class="viag-dash-card"><h3>💳 Quem pagou</h3>' + splitHtml + '</div>'
    + '</div>'
    + '<div class="viag-dash-grid">'
    +   '<div class="viag-dash-card"><h3>🏷 Top categorias</h3>' + catBars + '</div>'
    +   '<div class="viag-dash-card"><h3>📈 Tendência mensal (últimos 6m)</h3>' + mensalHtml + '</div>'
    + '</div>'
    + '<div class="viag-dash-grid">'
    +   '<div class="viag-dash-card"><h3>📍 Top destinos</h3>' + destHtml + '</div>'
    +   '<div class="viag-dash-card"><h3>👥 Top colaboradores</h3>' + colabHtml + '</div>'
    + '</div>'
    + '<div class="viag-dash-card"><h3>💡 Insights</h3>' + insightsHtml + '</div>'
    + '</div>';
}

function _viagRenderCategoria(lista){
  if(lista.length === 0){
    return '<div class="viag-empty"><span class="viag-empty-icon">📦</span><div class="viag-empty-title">Nenhum dado pra agregar</div><div class="viag-empty-sub">Crie viagens com despesas pra ver o agrupamento por categoria</div></div>';
  }
  // Agrega despesas por categoria + por forma de pagamento
  const byCat = {};
  for(const v of lista){
    for(const d of (v.despesas || [])){
      const cId = d.categoria || 'outros';
      if(!byCat[cId]) byCat[cId] = { total: 0, count: 0, totalEmp: 0, totalFunc: 0, items: [] };
      const val = parseFloat(d.valor) || 0;
      byCat[cId].total += val;
      byCat[cId].count++;
      if((d.pagamento || 'funcionario') === 'empresa') byCat[cId].totalEmp += val;
      else byCat[cId].totalFunc += val;
      byCat[cId].items.push({ d, v });
    }
  }
  const totalGeral = Object.values(byCat).reduce((s,c) => s + c.total, 0);
  const totalCount = Object.values(byCat).reduce((s,c) => s + c.count, 0);
  // Ordena: categorias com dados (por total desc) primeiro, depois vazias
  const ordered = VIAG_CATEGORIAS
    .map(cat => Object.assign({}, cat, byCat[cat.id] || { total: 0, count: 0, totalEmp: 0, totalFunc: 0, items: [] }))
    .sort((a,b) => b.total - a.total);

  // Header com totais
  let html = '<div class="viag-cat-summary">'
    + '<div class="viag-cat-summary-cell"><span class="lbl">Total agregado</span><span class="val">' + _viagFmt(totalGeral) + '</span></div>'
    + '<div class="viag-cat-summary-cell"><span class="lbl">Despesas</span><span class="val">' + totalCount + '</span></div>'
    + '<div class="viag-cat-summary-cell"><span class="lbl">Categorias usadas</span><span class="val">' + ordered.filter(c => c.count > 0).length + ' / ' + VIAG_CATEGORIAS.length + '</span></div>'
    + '<div class="viag-cat-summary-cell"><span class="lbl">Viagens</span><span class="val">' + lista.length + '</span></div>'
    + '</div>';

  // Grid de cards
  html += '<div class="viag-cat-grid">';
  for(const c of ordered){
    if(c.count === 0) continue;
    const pct = totalGeral > 0 ? (c.total / totalGeral * 100) : 0;
    const avg = c.count > 0 ? c.total / c.count : 0;
    html += '<div class="viag-cat-card" onclick="viagToggleCatDrill(\'' + c.id + '\', this)">'
      + '<div class="viag-cat-card-hd">'
      +   '<span class="viag-cat-card-icon">' + c.icon + '</span>'
      +   '<span class="viag-cat-card-name">' + c.nome + '</span>'
      +   '<span class="viag-cat-card-pct">' + pct.toFixed(1) + '%</span>'
      + '</div>'
      + '<div class="viag-cat-card-val">' + _viagFmt(c.total) + '</div>'
      + '<div class="viag-cat-card-bar"><div class="fill" style="width:' + pct + '%;background:linear-gradient(90deg,#0F766E,#14B8A6)"></div></div>'
      + '<div class="viag-cat-card-meta">'
      +   '<span>' + c.count + ' despesa' + (c.count === 1 ? '' : 's') + '</span>'
      +   '<span>· média ' + _viagFmt(avg) + '</span>'
      + '</div>'
      + '<div class="viag-cat-card-split">'
      +   (c.totalFunc > 0 ? '<span style="color:#7C3AED">💵 ' + _viagFmt(c.totalFunc) + '</span>' : '')
      +   (c.totalEmp > 0 ? '<span style="color:#0F766E">💳 ' + _viagFmt(c.totalEmp) + '</span>' : '')
      + '</div>'
      + '<div class="viag-cat-card-drill" data-cat="' + c.id + '" style="display:none">'
      +   c.items.slice(0, 50).map(({d, v}) => {
            const tFmt = _viagFmt(parseFloat(d.valor)||0);
            const dt = d.data ? _viagFmtData(d.data) : '—';
            return '<div class="viag-cat-drill-item" onclick="event.stopPropagation();viagOpenEditor(' + v.id + ')">'
              + '<span class="dt">' + dt + '</span>'
              + '<span class="tit">' + esc(v.titulo || '(sem título)') + '</span>'
              + '<span class="desc">' + esc(d.descricao || '—') + '</span>'
              + '<span class="val">' + tFmt + '</span>'
              + '</div>';
          }).join('')
      +   (c.items.length > 50 ? '<div style="text-align:center;padding:8px;color:#94A3B8;font-style:italic;font-size:.78rem">+ ' + (c.items.length - 50) + ' itens não exibidos</div>' : '')
      + '</div>'
      + '</div>';
  }
  // Categorias sem dados (collapsable)
  const empty = ordered.filter(c => c.count === 0);
  if(empty.length > 0){
    html += '<div class="viag-cat-empty-section">'
      + '<div class="viag-cat-empty-hd">Categorias sem despesas no período (' + empty.length + ')</div>'
      + '<div class="viag-cat-empty-list">'
      +   empty.map(c => '<span class="viag-cat-empty-tag">' + c.icon + ' ' + c.nome + '</span>').join('')
      + '</div></div>';
  }
  html += '</div>';
  return html;
}
function viagToggleCatDrill(catId, cardEl){
  const drill = cardEl.querySelector('.viag-cat-card-drill');
  if(!drill) return;
  const isOpen = drill.style.display !== 'none';
  drill.style.display = isOpen ? 'none' : 'block';
  cardEl.classList.toggle('is-expanded', !isOpen);
}
try { window.viagToggleCatDrill = viagToggleCatDrill; } catch(e){}
function viagSetFilter(st, btn){
  _viagFilter = st;
  document.querySelectorAll('#viag-filter button').forEach(b => b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  renderViagens();
}

function viagOpenEditor(id){
  viagLoad();
  if(id == null){
    // Novo relatório
    const today = new Date().toISOString().slice(0, 10);
    _viagEditingId = null;
    var v = {
      id: viagens.nextId++,
      titulo: '', destino: '', colaborador: '', proposito: '',
      dataInicio: today, dataFim: today,
      adiantamento: 0, status: 'rascunho',
      despesas: [],
      criadoEm: new Date().toISOString()
    };
    viagens.itens.push(v);
    viagSave();
    _viagEditingId = v.id;
  } else {
    _viagEditingId = id;
  }
  _viagRenderEditor();
  document.getElementById('viag-editor-overlay').style.display = 'flex';
}
function viagCloseEditor(){
  document.getElementById('viag-editor-overlay').style.display = 'none';
  _viagEditingId = null;
  renderViagens();
}
function _viagCurrent(){
  return viagens.itens.find(v => v.id === _viagEditingId);
}
// Card travado (somente leitura) quando aprovado/reembolsado/rejeitado.
// Status permanece mutável e serve de "chave" pra destravar (mude pra Enviado).
function _viagIsLocked(v){
  if(!v) return false;
  return v.status === 'aprovado' || v.status === 'reembolsado' || v.status === 'rejeitado';
}
try { window._viagIsLocked = _viagIsLocked; } catch(e){}
function _viagToastLocked(){
  if(typeof toast === 'function') toast('🔒 Card travado — mude o Status pra Enviado pra editar');
}
function _viagRenderEditor(){
  const v = _viagCurrent();
  if(!v) return;
  document.getElementById('viag-editor-title').textContent = v.titulo || 'Novo relatório de viagem';
  // Travamento — em aprovado/reembolsado/rejeitado o card vira somente leitura
  const _vLocked = _viagIsLocked(v);
  const _vDis = _vLocked ? ' disabled' : '';
  const _vStName = (VIAG_STATUS.find(s => s.id === v.status) || {}).nome || v.status;
  const _vLockedBox = _vLocked
    ? '<div class="viag-locked-box"><span class="viag-locked-ico">🔒</span>'
      + '<div class="viag-locked-txt"><strong>Card travado</strong> — relatório em <em>' + esc(_vStName) + '</em>. Para alterar dados, mude o <strong>Status</strong> de volta pra <em>Enviado</em>.</div>'
      + '</div>'
    : '';
  // Body
  const body = document.getElementById('viag-editor-body');
  body.innerHTML = _vLockedBox +
    // Form básico
      (v.aprovacao
        ? '<div class="viag-approved-box">'
          + '<span class="viag-approved-box-icon">🔏</span>'
          + '<div class="viag-approved-box-text">'
          +   '<strong>Aprovado por ' + esc(v.aprovacao.aprovador) + '</strong>'
          +   '<small>em ' + new Date(v.aprovacao.data).toLocaleString('pt-BR', {dateStyle:'short', timeStyle:'short'})
          +     (v.aprovacao.codigo ? ' · código <span class="viag-appr-codigo">' + esc(v.aprovacao.codigo) + '</span>' : '')
          +     (v.aprovacao.hash ? ' <button class="viag-appr-verify" onclick="viagVerificarAprovacao(' + v.id + ')" title="Recalcula o hash e compara — verifica se a assinatura foi alterada após a aprovação">✓ Verificar integridade</button>' : '')
          +   '</small>'
          + '</div>'
          + '<img class="viag-approved-box-sig" src="' + v.aprovacao.assinatura + '" alt="assinatura">'
          + '</div>'
        : '')
    + (v.rejeicao
        ? '<div class="viag-rejected-box">'
          + '<span class="viag-approved-box-icon">❌</span>'
          + '<div class="viag-approved-box-text">'
          +   '<strong>Rejeitado por ' + esc(v.rejeicao.por||'') + '</strong>'
          +   '<small>em ' + new Date(v.rejeicao.data).toLocaleString('pt-BR', {dateStyle:'short', timeStyle:'short'})
          +     (v.rejeicao.codigo ? ' · código <span class="viag-rej-codigo">' + esc(v.rejeicao.codigo) + '</span>' : '')
          +     (v.rejeicao.hash ? ' <button class="viag-rej-verify" onclick="viagVerificarRejeicao(' + v.id + ')" title="Recalcula o hash e compara">✓ Verificar integridade</button>' : '')
          +   '</small>'
