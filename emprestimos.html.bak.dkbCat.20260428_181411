// ─── Modal: data de saída ────────────────────────────
let _pesSaidaCtx = null;
function askPesDataSaida(p){
  return new Promise(resolve => {
    _pesSaidaCtx = { personId: p.id, resolve, done: false };
    const input = document.getElementById('pesaida-input');
    const sub = document.getElementById('pesaida-subtitle');
    const hint = document.getElementById('pesaida-hint');
    const prev = document.getElementById('pesaida-preview');
    const nome = pesRegView(p).nome || 'esta pessoa';
    if(sub)  sub.innerHTML = `Informe a data em que <b>${esc(nome)}</b> deixou a empresa.`;
    if(hint) hint.textContent = '';
    if(prev) prev.textContent = '';
    if(input){
      // default = hoje, mas se já tem dataSaida antiga, usa ela
      const today = new Date();
      const iso = [today.getFullYear(),
                   String(today.getMonth()+1).padStart(2,'0'),
                   String(today.getDate()).padStart(2,'0')].join('-');
      input.value = p.dataSaida || iso;
      input.onkeydown = (ev) => {
        if(ev.key === 'Enter'){ ev.preventDefault(); askPesSaidaConfirm(); }
        else if(ev.key === 'Escape'){ askPesSaidaCancel(); }
      };
      input.oninput = () => updatePesSaidaPreview();
    }
    updatePesSaidaPreview();
    const ov = document.getElementById('ov-pes-saida');
    if(ov) ov.classList.add('open');
    setTimeout(() => { try{ input && input.focus(); }catch(e){} }, 30);
  });
}
function updatePesSaidaPreview(){
  if(!_pesSaidaCtx) return;
  const input = document.getElementById('pesaida-input');
  const prev = document.getElementById('pesaida-preview');
  const hint = document.getElementById('pesaida-hint');
  if(!input || !prev || !hint) return;
  hint.textContent = '';
  const p = pessoas.people.find(x => x.id === _pesSaidaCtx.personId);
  if(!p){ prev.textContent = ''; return; }
  const val = input.value;
  const d = parsePesDate(val);
  if(!d){ prev.textContent = ''; return; }
  if(p.dataEntrada){
    const t = computeTempoEmpresa(p.dataEntrada, val);
    if(t) prev.innerHTML = `Tempo na empresa: <b>${esc(fmtTempoEmpresa(t))}</b>`;
    else  prev.innerHTML = `<span style="color:#DC2626">Data de saída anterior à data de entrada (${esc(fmtPesDateBR(p.dataEntrada))}).</span>`;
  } else {
    prev.innerHTML = `<span style="color:var(--txl)">Sem data de entrada — tempo na empresa não pode ser calculado.</span>`;
  }
}
function askPesSaidaConfirm(){
  if(!_pesSaidaCtx || _pesSaidaCtx.done) return;
  const input = document.getElementById('pesaida-input');
  const hint  = document.getElementById('pesaida-hint');
  const val   = input ? input.value : '';
  const d     = parsePesDate(val);
  if(!d){ if(hint) hint.textContent = 'Informe uma data válida.'; return; }
  const p = pessoas.people.find(x => x.id === _pesSaidaCtx.personId);
  if(p && p.dataEntrada){
    const from = parsePesDate(p.dataEntrada);
    if(from && d < from){
      if(hint) hint.textContent = 'A data de saída não pode ser anterior à data de entrada.';
      return;
    }
  }
  const resolve = _pesSaidaCtx.resolve;
  _pesSaidaCtx.done = true;
  const ov = document.getElementById('ov-pes-saida');
  if(ov) ov.classList.remove('open');
  _pesSaidaCtx = null;
  resolve(val);
}
function askPesSaidaCancel(){
  if(!_pesSaidaCtx || _pesSaidaCtx.done) return;
  const resolve = _pesSaidaCtx.resolve;
  _pesSaidaCtx.done = true;
  const ov = document.getElementById('ov-pes-saida');
  if(ov) ov.classList.remove('open');
  _pesSaidaCtx = null;
  resolve(null);
}

function pesCurMonthKey(){
  const d = new Date();
  return String(d.getFullYear()) + '-' + String(d.getMonth()+1).padStart(2,'0');
}

function computePesReajustes(p){
  // Percorre todos os meses de todos os anos em ordem cronológica
  // e detecta mudanças no salário (ignora vazios).
  // Só considera meses que já passaram (ou o mês atual) — valores
  // em meses futuros são projeções, não reajustes efetivos.
  const curKey = pesCurMonthKey();
  const keys = Object.keys(p.salarios || {})
    .filter(k => /^\d{4}-\d{2}$/.test(k))
    .filter(k => p.salarios[k] !== undefined && p.salarios[k] !== null && p.salarios[k] !== 0)
    .filter(k => k <= curKey)
    .sort();

  // A variação entre o 1º e o 2º mês de salário é sempre desconsiderada:
  // costuma ser apenas o complemento do pagamento parcial da pessoa que
  // entrou no meio do mês — não é reajuste de verdade. Reajustes reais
  // em meses posteriores continuam detectados normalmente.
  const skipKey = keys.length >= 2 ? keys[1] : null;

  const history = [];
  let prev = null;
  for(const k of keys){
    const v = p.salarios[k];
    if(prev !== null && v !== prev.val){
      if(k !== skipKey){
        history.push({ key:k, from: prev.val, to: v,
                       pct: prev.val ? ((v - prev.val) / prev.val) * 100 : 0 });
      }
    }
    prev = { key:k, val:v };
  }
  return history; // mais antigo primeiro
}

function pesKeyToLabel(k){
  // k = 'YYYY-MM'
  const [y, mm] = k.split('-');
  const i = parseInt(mm, 10) - 1;
  const m = (i >= 0 && i < 12) ? PES_MESES_LONG[i] : mm;
  return `${m} ${y}`;
}

function openPesCard(id){
  const p = pessoas.people.find(x=>x.id===id);
  if(!p) return;
  _pesCardOpenId = id;
  _pcardTab = 'detalhes';
  renderPesCardBody();
  const ov = document.getElementById('ov-pes-card');
  if(ov) ov.classList.add('open');
}

function closePesCard(){
  // Cleanup de draft: se foi criado por "+ Novo colaborador" e o nome do registry continua vazio, remove.
  try {
    if(_pesCardOpenId != null){
      const p = pessoas.people.find(x => x.id === _pesCardOpenId);
      if(p){
        const reg = (typeof pesRegOf === 'function') ? pesRegOf(p) : null;
        const nomeVazio = !reg || !reg.nome || !reg.nome.trim();
        if(p._draft && nomeVazio){
          // Remove a row e o registry vinculado
          pessoas.people = pessoas.people.filter(x => x.id !== p.id);
          if(reg){
            pessoas.registry = pessoas.registry.filter(r => r.id !== reg.id);
          }
          if(typeof pessoasSave === 'function') pessoasSave();
          if(typeof renderWfColaboradores === 'function') renderWfColaboradores();
        } else if(p._draft){
          delete p._draft;
          if(reg) delete reg._draft;
          if(typeof pessoasSave === 'function') pessoasSave();
        }
      }
    }
  } catch(e){}
  const ov = document.getElementById('ov-pes-card');
  if(ov) ov.classList.remove('open');
  _pesCardOpenId = null;
}

function renderPesCardBody(){
  const id = _pesCardOpenId;
  if(id == null) return;
  const p = pessoas.people.find(x=>x.id===id);
  const body = document.getElementById('pcard-body');
  const titleEl = document.getElementById('pcard-title');
  if(!p || !body){ closePesCard(); return; }

  const view = pesRegView(p);
  const nome = view.nome || (p.sim ? 'Candidato sem nome' : 'Pessoa sem nome');
  const t = pesTipo(p.tipoId);
  const tipoNome = t ? t.nome : 'Sem tipo';
  const tipoColor = t ? t.color : '#E5E7EB';
  const tipoTxt = t ? PES_TIPO_TXT : 'var(--tx)';
  const initials = (nome || '?').trim().split(/\s+/).slice(0,2)
                    .map(s => s[0] || '').join('').toUpperCase() || '?';

  const hist = computePesReajustes(p);
  const last = hist.length ? hist[hist.length - 1] : null;
  const lastLabel = last ? pesKeyToLabel(last.key) : '—';

  const dataEntrada = p.dataEntrada || '';
  const dataSaida   = p.dataSaida   || '';
  const tempo = p.dataEntrada
    ? computeTempoEmpresa(p.dataEntrada, p.ativo ? null : (p.dataSaida || null))
    : null;
  const tempoLbl = p.ativo ? 'Tempo de empresa' : 'Tempo total na empresa';
  const tempoTxt = tempo ? fmtTempoEmpresa(tempo) : '—';

  // Remuneração atual: valor do mês vigente para esta pessoa
  const curMesKey = pesCurMonthKey();
  const remAtual = (p.salarios && p.salarios[curMesKey]) ? p.salarios[curMesKey] : 0;
  const remLbl = p.ativo ? 'Remuneração atual' : 'Última remuneração';
  // Quando inativa, procura o último mês com salário (até o mês atual)
  let remAtualShow = remAtual;
  let remAtualSub = '';
  if(p.ativo){
    remAtualSub = pesKeyToLabel(curMesKey);
  } else {
    // Se tem dataSaida, pega o valor do mês da saída; senão, último mês disponível
    const saidaD = parsePesDate(p.dataSaida);
    let targetKey = null;
    if(saidaD){
      const mm = String(saidaD.getMonth()+1).padStart(2,'0');
      targetKey = saidaD.getFullYear() + '-' + mm;
    }
    const allKeys = Object.keys(p.salarios || {})
      .filter(k => /^\d{4}-\d{2}$/.test(k))
      .filter(k => p.salarios[k] > 0)
      .filter(k => k <= curMesKey)
      .sort();
    if(targetKey && p.salarios[targetKey] > 0){
      remAtualShow = p.salarios[targetKey];
      remAtualSub = pesKeyToLabel(targetKey);
    } else if(allKeys.length){
      const lk = allKeys[allKeys.length-1];
      remAtualShow = p.salarios[lk];
      remAtualSub = pesKeyToLabel(lk);
    } else {
      remAtualShow = 0;
      remAtualSub = '';
    }
  }

  // Alerta de reajuste atrasado (passou de 1 ano desde o último reajuste)
  // Se não há reajuste registrado, considera a data de entrada como baseline.
  let alertHtml = '';
  if(p.ativo){
    const histForAlert = computePesReajustes(p);
    const baselineKey = histForAlert.length
      ? histForAlert[histForAlert.length-1].key
      : (p.dataEntrada ? p.dataEntrada.slice(0,7) : null);
    if(baselineKey){
      const today = new Date();
      const curY = today.getFullYear();
      const curM = today.getMonth(); // 0..11
      const [by, bm] = baselineKey.split('-').map(n => parseInt(n,10));
      const mesesDesde = (curY - by) * 12 + (curM - (bm - 1));
      if(mesesDesde >= 12){
        const mesLabel = pesKeyToLabel(baselineKey);
        const tempoStr = mesesDesde >= 24
          ? `há mais de ${Math.floor(mesesDesde/12)} anos`
          : `há ${mesesDesde} meses`;
        const tipo = mesesDesde >= 18 ? 'danger' : 'warn';
        const origem = histForAlert.length
          ? `Último reajuste em <b>${esc(mesLabel)}</b> (${tempoStr})`
          : `Sem reajuste desde a entrada em <b>${esc(mesLabel)}</b> (${tempoStr})`;
        alertHtml = `
          <div class="pcard-alert ${tipo}">
            <span class="pcard-alert-ico">
