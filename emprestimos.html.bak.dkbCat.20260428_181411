function bdToggleDone(id){
  const c = board.cards.find(x => x.id === id);
  if(!c) return;
  if(c.col === 'done'){
    c.col = 'todo';
    c.doneAt = null;
    try { _bdAutoNote(c, 'Reaberto (movido para "A fazer")'); } catch(e){}
  } else {
    c._prevCol = c.col;
    c.col = 'done';
    c.doneAt = new Date().toISOString();
    try { _bdAutoNote(c, 'Concluído'); } catch(e){}
  }
  bdSave();
  bdRender();
}
try { window.bdToggleDone = bdToggleDone; } catch(e){}
function _bdDaysUntil(deadlineISO){
  if(!deadlineISO) return null;
  try {
    const d = new Date(deadlineISO + 'T23:59:59').getTime();
    const now = Date.now();
    return Math.ceil((d - now) / 86400000);
  } catch(e){ return null; }
}
function _bdRenderDash(){
  const cs = board.cards;
  const ativas = cs.filter(c => c.col !== 'done');
  const concluidos = cs.filter(c => c.col === 'done');
  // KPIs hero
  const atrasadas = ativas.filter(c => { const d = _bdDaysUntil(c.deadline); return d != null && d < 0; });
  const vencem7d  = ativas.filter(c => { const d = _bdDaysUntil(c.deadline); return d != null && d >= 0 && d <= 7; });
  const semResp   = ativas.filter(c => !(c.assignees||[]).length);
  const semDead   = ativas.filter(c => !c.deadline);
  const bloqueadas = ativas.filter(c => c.col === 'blocked');
  // Concluídos últimos 30d
  const cutoff30 = Date.now() - 30*86400000;
  const done30d = concluidos.filter(c => c.doneAt && new Date(c.doneAt).getTime() >= cutoff30).length;
  // Tempo médio aberto (ativos)
  const tempos = ativas.map(c => _bdMsAberta(c)).filter(x => x != null && x > 0);
  const tempoMedio = tempos.length ? tempos.reduce((s,v) => s+v, 0) / tempos.length : 0;
  const tempoMedioFmt = tempoMedio > 0 ? _bdFmtAberta(tempoMedio) : '—';

  // Por coluna (todos os cards) e prioridade (só ativos)
  const porCol = {};
  for(const c of cs) porCol[c.col] = (porCol[c.col] || 0) + 1;
  const porPri = { alta:0, media:0, baixa:0 };
  for(const c of ativas) porPri[c.priority] = (porPri[c.priority] || 0) + 1;
  const maxCol = Math.max(1, ...BD_COLS.map(co => porCol[co.id]||0));
  const maxPri = Math.max(1, porPri.alta, porPri.media, porPri.baixa);

  // Por responsável (ativos)
  const porResp = {};
  for(const c of ativas){
    for(const a of (c.assignees||[])){
      const k = String(a.pesId || a.nome || 'externo');
      if(!porResp[k]) porResp[k] = { count:0, pesId:a.pesId, nome:a.nome };
      porResp[k].count++;
    }
  }
  const respTop = Object.values(porResp).sort((a,b) => b.count - a.count).slice(0, 5);
  const maxResp = Math.max(1, ...respTop.map(r => r.count));

  // Tags
  const porTag = {};
  for(const c of ativas) for(const tid of (c.tagIds || [])) porTag[tid] = (porTag[tid] || 0) + 1;
  const tagTop = Object.entries(porTag).sort((a,b) => b[1] - a[1]).slice(0, 8);
  const maxTag = Math.max(1, ...tagTop.map(([,v]) => v));

  // Listas acionáveis (top 5)
  const atrasadasTop = atrasadas.slice().sort((a,b) => (a.deadline||'').localeCompare(b.deadline||'')).slice(0, 5);
  const proximosTop = ativas.filter(c => { const d = _bdDaysUntil(c.deadline); return d != null && d >= 0; })
                            .sort((a,b) => (a.deadline||'').localeCompare(b.deadline||''))
                            .slice(0, 5);

  // ── KPI Hero cards
  const kpi = (lbl, val, ico, tone, sub) => '<div class="bd-kpi bd-kpi-' + tone + '">'
    + '<div class="bd-kpi-ico">' + ico + '</div>'
    + '<div class="bd-kpi-val">' + val + '</div>'
    + '<div class="bd-kpi-lbl">' + lbl + (sub ? '<small>' + sub + '</small>' : '') + '</div>'
    + '</div>';
  const kpisHtml = '<div class="bd-kpis">'
    + kpi('Ativas',        ativas.length,   '📋', 'neutral', '')
    + kpi('Atrasadas',     atrasadas.length, '⚠️', atrasadas.length>0 ? 'danger' : 'neutral', atrasadas.length>0 ? 'precisam ação' : 'tudo em dia')
    + kpi('Vencem em 7d',  vencem7d.length, '⏰', vencem7d.length>0 ? 'warn' : 'neutral', '')
    + kpi('Concluídas 30d', done30d,         '✅', 'success', '')
    + kpi('Sem responsável', semResp.length, '👤', semResp.length>0 ? 'warn' : 'neutral', '')
    + kpi('Tempo médio',   tempoMedioFmt,   '⏱',  'info', 'em aberto')
    + '</div>';

  // ── Distribuição por coluna (barras horizontais)
  const colBars = BD_COLS.map(co => {
    const v = porCol[co.id] || 0;
    const pct = (v / maxCol) * 100;
    return '<div class="bd-bar-row">'
      + '<span class="bd-bar-lbl">' + _bdEsc(co.nome) + '</span>'
      + '<div class="bd-bar-track"><div class="bd-bar-fill bd-bar-col-' + co.id + '" style="width:' + pct + '%"></div></div>'
      + '<span class="bd-bar-val">' + v + '</span>'
      + '</div>';
  }).join('');

  // ── Distribuição por prioridade (barras com cores)
  const priColors = { alta:'#E24B4A', media:'#BA7517', baixa:'#1D9E75' };
  const priLbl = { alta:'Alta', media:'Média', baixa:'Baixa' };
  const priBars = ['alta','media','baixa'].map(p => {
    const v = porPri[p] || 0;
    const pct = (v / maxPri) * 100;
    return '<div class="bd-bar-row">'
      + '<span class="bd-bar-lbl"><span class="bd-bar-dot" style="background:' + priColors[p] + '"></span>' + priLbl[p] + '</span>'
      + '<div class="bd-bar-track"><div class="bd-bar-fill" style="width:' + pct + '%;background:' + priColors[p] + '"></div></div>'
      + '<span class="bd-bar-val">' + v + '</span>'
      + '</div>';
  }).join('');

  // ── Lista atrasadas
  const atrasadasHtml = atrasadasTop.length ? atrasadasTop.map(c => {
    const d = _bdDaysUntil(c.deadline);
    const dias = Math.abs(d);
    return '<div class="bd-list-row" onclick="bdOpenCardModal(' + c.id + ')">'
      + '<div class="bd-list-name">' + _bdEsc(c.name) + '</div>'
      + '<div class="bd-list-meta"><span class="bd-list-tag bd-list-danger">' + dias + 'd atrasado</span></div>'
      + '</div>';
  }).join('') : '<div class="bd-list-empty">Nenhuma atrasada 🎉</div>';

  // ── Lista próximos prazos
  const proximosHtml = proximosTop.length ? proximosTop.map(c => {
    const d = _bdDaysUntil(c.deadline);
    const lblD = d === 0 ? 'hoje' : (d === 1 ? 'amanhã' : 'em ' + d + 'd');
    const tone = d <= 1 ? 'bd-list-warn' : 'bd-list-info';
    return '<div class="bd-list-row" onclick="bdOpenCardModal(' + c.id + ')">'
      + '<div class="bd-list-name">' + _bdEsc(c.name) + '</div>'
      + '<div class="bd-list-meta"><span class="bd-list-tag ' + tone + '">' + lblD + '</span></div>'
      + '</div>';
  }).join('') : '<div class="bd-list-empty">Sem prazos próximos</div>';

  // ── Carga por responsável (com avatar)
  const respHtml = respTop.length ? respTop.map(r => {
    const pct = (r.count / maxResp) * 100;
    const ava = (typeof _bdPesAvatar === 'function') ? _bdPesAvatar(r.pesId, r.nome, 'bd-pes-ava-sm') : '';
    return '<div class="bd-resp-row">'
      + '<span class="bd-resp-info">' + ava + '<span class="bd-resp-name">' + _bdEsc(r.nome || '—') + '</span></span>'
      + '<div class="bd-bar-track"><div class="bd-bar-fill" style="width:' + pct + '%;background:#7F77DD"></div></div>'
      + '<span class="bd-bar-val">' + r.count + '</span>'
      + '</div>';
  }).join('') : '<div class="bd-list-empty">Nenhum card atribuído</div>';

  // ── Tags com barras
  const tagsHtml = tagTop.length ? tagTop.map(([tid, v]) => {
    const t = _bdTag(tid); if(!t) return '';
    const pct = (v / maxTag) * 100;
    return '<div class="bd-bar-row">'
      + '<span class="bd-bar-lbl"><span class="bd-tag" style="background:' + t.color.bg + ';color:' + t.color.text + '">' + _bdEsc(t.text) + '</span></span>'
      + '<div class="bd-bar-track"><div class="bd-bar-fill" style="width:' + pct + '%;background:' + (t.color.dot || '#888') + '"></div></div>'
      + '<span class="bd-bar-val">' + v + '</span>'
      + '</div>';
  }).join('') : '<div class="bd-list-empty">Nenhum marcador atribuído</div>';

  // ── Insights (texto curto e acionável)
  const insights = [];
  if(atrasadas.length > 0) insights.push({ ico:'🚨', tone:'danger', text:'<b>' + atrasadas.length + '</b> task' + (atrasadas.length>1?'s':'') + ' atrasada' + (atrasadas.length>1?'s':'') + ' precisam de ação imediata' });
  if(bloqueadas.length > 0) insights.push({ ico:'🛑', tone:'warn', text:'<b>' + bloqueadas.length + '</b> task' + (bloqueadas.length>1?'s':'') + ' na coluna Bloqueado' });
  if(semResp.length > 0) insights.push({ ico:'👤', tone:'warn', text:'<b>' + semResp.length + '</b> task' + (semResp.length>1?'s':'') + ' sem responsável atribuído' });
  if(semDead.length > 0) insights.push({ ico:'📅', tone:'info', text:'<b>' + semDead.length + '</b> task' + (semDead.length>1?'s':'') + ' sem deadline definido' });
  if(porPri.alta > ativas.length * 0.4 && ativas.length > 3) insights.push({ ico:'🔴', tone:'warn', text:'Concentração alta de prioridade <b>Alta</b> (' + porPri.alta + ' de ' + ativas.length + ' ativas) — revise critérios' });
  if(done30d > 0) insights.push({ ico:'🎯', tone:'success', text:'Boa! <b>' + done30d + '</b> task' + (done30d>1?'s':'') + ' concluída' + (done30d>1?'s':'') + ' nos últimos 30 dias' });
  if(insights.length === 0) insights.push({ ico:'✨', tone:'success', text:'Tudo no controle. Sem alertas no momento.' });
  const insightsHtml = insights.slice(0, 5).map(i =>
    '<div class="bd-insight bd-insight-' + i.tone + '"><span class="bd-insight-ico">' + i.ico + '</span><span class="bd-insight-txt">' + i.text + '</span></div>'
  ).join('');

  // ── Layout final (grid)
  return '<div class="bd-dash">'
    + kpisHtml
    + '<div class="bd-dash-grid">'
    +   '<div class="bd-dash-card bd-dash-span-2"><h3>📊 Por coluna</h3>' + colBars + '</div>'
    +   '<div class="bd-dash-card bd-dash-span-2"><h3>🎯 Por prioridade</h3>' + priBars + '</div>'
    + '</div>'
    + '<div class="bd-dash-grid bd-dash-grid-3">'
    +   '<div class="bd-dash-card"><h3>🔥 Atrasadas</h3>' + atrasadasHtml + '</div>'
    +   '<div class="bd-dash-card"><h3>⏳ Próximos prazos</h3>' + proximosHtml + '</div>'
    +   '<div class="bd-dash-card"><h3>👥 Carga por responsável</h3>' + respHtml + '</div>'
    + '</div>'
    + '<div class="bd-dash-grid">'
    +   '<div class="bd-dash-card"><h3>🏷 Top marcadores</h3>' + tagsHtml + '</div>'
    +   '<div class="bd-dash-card"><h3>💡 Insights</h3>' + insightsHtml + '</div>'
    + '</div>'
    + '</div>';
}

// ── Drag & drop ──
function bdDragCard(ev, id){
  _bdDragId = id;
  ev.dataTransfer.effectAllowed = 'move';
  try { ev.dataTransfer.setData('text/plain', String(id)); } catch(e){}
}
function bdDropCard(ev, newCol){
  ev.preventDefault();
  ev.stopPropagation();
  document.querySelectorAll('.bd-col.is-drop').forEach(el => el.classList.remove('is-drop'));
  if(_bdDragId == null) return;
  const c = board.cards.find(x => x.id === _bdDragId);
  _bdDragId = null;
  if(!c || c.col === newCol) return;
  const oldCol = c.col;
  c.col = newCol;
  if(newCol === 'done' && !c.doneAt) c.doneAt = new Date().toISOString();
  if(newCol !== 'done' && c.doneAt) c.doneAt = null;
  // Auto-note
  try {
    const colNome = (typeof BD_COLS !== 'undefined') ? ((BD_COLS.find(x => x.id === newCol)||{}).nome || newCol) : newCol;
    _bdAutoNote(c, 'Movido para "' + colNome + '"');
  } catch(e){}
  bdSave();
  bdRender();
}

// ── Modal CRUD ──
function bdOpenCardModal(id, defaultCol){
  bdLoad();
  const isNew = (id == null);
  let c;
  if(isNew){
    c = {
      id: board.nCard++,
      name: '', priority: 'media', col: defaultCol || 'todo',
      tagIds: [], deadline: null, valor: null, tipoFin: null,
      responsavelPesId: null, responsavelNome: '', moduloVinculado: null,
      createdAt: new Date().toISOString(), doneAt: null
    };
    _bdEditId = c.id;
    _bdEditTagIds = [];
  } else {
    c = board.cards.find(x => x.id === id);
    if(!c) return;
    _bdEditId = c.id;
    _bdEditTagIds = (c.tagIds || []).slice();
  }
  document.getElementById('bd-modal-title').textContent = isNew ? 'Novo card' : 'Editar card';
  document.getElementById('bd-btn-del').style.display = isNew ? 'none' : 'inline-flex';
  // Build form
  const colOpts = BD_COLS.map(co => '<option value="' + co.id + '"' + (c.col === co.id ? ' selected' : '') + '>' + co.nome + '</option>').join('');
  const priOpts = ['alta','media','baixa'].map(p => '<option value="' + p + '"' + (c.priority === p ? ' selected' : '') + '>' + p.charAt(0).toUpperCase() + p.slice(1) + '</option>').join('');
  const tipoOpts = '<option value="">— Sem tipo —</option>' + BD_TIPOS.map(t => '<option value="' + t.id + '"' + (c.tipoFin === t.id ? ' selected' : '') + '>' + t.icon + ' ' + t.nome + '</option>').join('');
  const modOpts = '<option value="">— Sem vínculo —</option>' + BD_MODULOS.map(m => '<option value="' + m.id + '"' + (c.moduloVinculado === m.id ? ' selected' : '') + '>' + m.nome + '</option>').join('');
  // Pessoas dropdown
  const pplList = (typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.people)) ? pessoas.people : [];
  const sortedPpl = pplList.slice().sort((a,b) => (a.nome||'').localeCompare(b.nome||''));
  let respOpts = '<option value="">— Sem responsável —</option>';
  respOpts += sortedPpl.map(p => '<option value="' + p.id + '"' + (c.responsavelPesId === p.id ? ' selected' : '') + '>' + _bdEsc(p.nome||'(sem nome)') + (p.ativo === false ? ' (inativo)' : '') + '</option>').join('');
  respOpts += '<option value="__externo__"' + (c.responsavelPesId === '__externo__' || (!c.responsavelPesId && c.responsavelNome) ? ' selected' : '') + '>👤 Externo (digitar nome)</option>';
  document.getElementById('bd-modal-body').innerHTML =
      '<div class="bd-field"><label>Descrição *</label><input type="text" id="bd-i-name" value="' + _bdEsc(c.name||'') + '" placeholder="Ex: Revisar relatório · Enviar proposta..." autofocus></div>'
    + '<div class="bd-field"><label>☑ Subtarefas <small style="font-weight:500;color:#999;text-transform:none;letter-spacing:0" id="bd-st-count"></small></label>'
    +   '<div class="bd-st-list" id="bd-st-list">' + _bdRenderSubtaskList(c) + '</div>'
    +   '<div class="bd-st-new-row"><input type="text" id="bd-st-new" placeholder="Nova subtarefa..." onkeypress="if(event.key===\'Enter\'){_bdAddSubtask();event.preventDefault();}"><button onclick="_bdAddSubtask()">+ Adicionar</button></div>'
    + '</div>'
    + '<div class="bd-field-row">'
    +   '<div class="bd-field"><label>Coluna</label><select id="bd-i-col">' + colOpts + '</select></div>'
    +   '<div class="bd-field"><label>Prioridade</label><select id="bd-i-pri">' + priOpts + '</select></div>'
    + '</div>'
    + '<div class="bd-field"><label>📅 Prazo (deadline)</label><input type="date" id="bd-i-deadline" value="' + (c.deadline||'') + '"></div>'
    + '<div class="bd-field"><label>👤 Responsáveis</label>'
    +   '<div class="bd-asg-list" id="bd-asg-list">' + _bdRenderAssignees(c) + '</div>'
    +   '<div class="bd-asg-pick-row">'
    +     '<select id="bd-asg-pick" onchange="_bdAssigneePick(this)">' + _bdAssigneeOpts() + '</select>'
    +     '<input type="text" id="bd-asg-ext" placeholder="Nome externo" style="display:none">'
    +     '<button onclick="_bdAddAssignee()">+ Adicionar</button>'
    +   '</div>'
    + '</div>'
    + '<div class="bd-field"><label>📝 Notas</label>'
    +   '<div class="bd-notes-list" id="bd-notes-list">' + _bdRenderNotes(c) + '</div>'
    +   '<div class="bd-note-new-row">'
    +     '<input type="text" id="bd-note-new" placeholder="Escrever nota..." onkeypress="if(event.key===\'Enter\'){_bdAddNote();event.preventDefault();}">'
    +     '<button onclick="_bdAddNote()" title="Adicionar nota">↵</button>'
    +   '</div>'
    + '</div>'
    + '<div class="bd-field"><label>📎 Anexos</label>'
    +   '<div class="bd-att-list" id="bd-att-list">' + _bdRenderAttachments(c) + '</div>'
    +   '<input type="file" id="bd-att-input" style="display:none" multiple onchange="_bdAddAttachments(this)">'
    +   '<button class="bd-att-btn" onclick="document.getElementById(\'bd-att-input\').click()">📎 Anexar arquivos (até 1MB cada)</button>'
    + '</div>'
    + '<div class="bd-field"><label>🏷 Marcadores</label>'
    +   '<div class="bd-tag-pick" id="bd-tag-pick">' + _bdRenderTagPick() + '</div>'
    +   '<div class="bd-tag-new-row"><input type="text" id="bd-tag-new" placeholder="Nome do novo marcador..." onkeypress="if(event.key===\'Enter\'){_bdCreateTag();event.preventDefault();}"><button onclick="_bdCreateTag()">+ Criar</button></div>'
    + '</div>';
  const ov = document.getElementById('bd-modal-ov');
  if(ov && ov.parentElement !== document.body){
    document.body.appendChild(ov);
  }
  ov.style.display = 'flex';
  setTimeout(() => { const i = document.getElementById('bd-i-name'); if(i) i.focus(); }, 50);
}
function _bdRespChange(val){
  const ext = document.getElementById('bd-i-resp-ext');
  if(!ext) return;
  ext.style.display = (val === '__externo__') ? 'block' : 'none';
  if(val === '__externo__'){ ext.focus(); }
}
// Estado local: qual tag está sendo editada inline (null = nenhuma)
let _bdEditingTagId = null;

function _bdRenderTagPick(){
  return board.globalTags.map(t => {
    if(_bdEditingTagId === t.id){
      // Modo edição inline: input + color picker + salvar/cancelar
      const dots = BD_COLORS.map((c,i) =>
        '<span class="bd-tag-color-dot' + (c.bg === t.color.bg ? ' sel' : '') + '"'
        + ' style="background:' + c.dot + '"'
        + ' data-cidx="' + i + '" onclick="_bdSetEditTagColor(' + i + ')" title="Cor ' + (i+1) + '"></span>'
      ).join('');
      return '<span class="bd-tag-edit-form">'
        +    '<input type="text" id="bd-tag-edit-input" value="' + _bdEsc(t.text) + '" autofocus'
        +    '   onkeypress="if(event.key===&quot;Enter&quot;){_bdSaveEditTag(&quot;' + t.id + '&quot;);event.preventDefault();}'
        +    '              else if(event.key===&quot;Escape&quot;){_bdCancelEditTag();event.preventDefault();}">'
        +    '<span class="bd-tag-color-row">' + dots + '</span>'
        +    '<button class="bd-tag-edit-ok"  onclick="_bdSaveEditTag(\'' + t.id + '\')" title="Salvar">✓</button>'
        +    '<button class="bd-tag-edit-no"  onclick="_bdCancelEditTag()"           title="Cancelar">✕</button>'
        + '</span>';
    }
    const sel = _bdEditTagIds.includes(t.id);
    return '<span class="bd-tag-pick-wrap">'
      +    '<span class="bd-tag-pick-item' + (sel ? ' sel' : '') + '"'
      +    '   style="background:' + t.color.bg + ';color:' + t.color.text + '"'
      +    '   onclick="_bdToggleEditTag(\'' + t.id + '\')">'
      +    (sel ? '✓ ' : '+ ') + _bdEsc(t.text)
      +    '</span>'
      +    '<button class="bd-tag-act-btn bd-tag-act-edit"'
      +    '   onclick="event.stopPropagation();_bdEditTag(\'' + t.id + '\')" title="Editar">✎</button>'
      +    '<button class="bd-tag-act-btn bd-tag-act-del"'
      +    '   onclick="event.stopPropagation();_bdDeleteTag(\'' + t.id + '\')" title="Excluir">✕</button>'
      + '</span>';
  }).join('');
}
function _bdToggleEditTag(tid){
  // Não toggle se está em modo edição
  if(_bdEditingTagId) return;
  const i = _bdEditTagIds.indexOf(tid);
  if(i >= 0) _bdEditTagIds.splice(i, 1);
  else _bdEditTagIds.push(tid);
  document.getElementById('bd-tag-pick').innerHTML = _bdRenderTagPick();
}
function _bdCreateTag(){
  const inp = document.getElementById('bd-tag-new');
  const txt = (inp?.value || '').trim();
  if(!txt) return;
  const colorIdx = board.globalTags.length % BD_COLORS.length;
  const newTag = { id: 't' + (board.nTag++), text: txt, color: BD_COLORS[colorIdx] };
  board.globalTags.push(newTag);
  _bdEditTagIds.push(newTag.id);
  bdSave();
  inp.value = '';
  document.getElementById('bd-tag-pick').innerHTML = _bdRenderTagPick();
}
function _bdEditTag(tid){
  _bdEditingTagId = tid;
  document.getElementById('bd-tag-pick').innerHTML = _bdRenderTagPick();
  setTimeout(() => { const i = document.getElementById('bd-tag-edit-input'); if(i){ i.focus(); i.select(); } }, 30);
}
function _bdCancelEditTag(){
  _bdEditingTagId = null;
  document.getElementById('bd-tag-pick').innerHTML = _bdRenderTagPick();
}
let _bdEditTagPendingColor = null;
function _bdSetEditTagColor(idx){
  _bdEditTagPendingColor = idx;
  // Re-render dots com seleção atualizada
  const tag = board.globalTags.find(t => t.id === _bdEditingTagId);
  if(!tag) return;
  document.querySelectorAll('.bd-tag-color-dot').forEach((el, i) => {
    el.classList.toggle('sel', i === idx);
  });
}
function _bdSaveEditTag(tid){
  const tag = board.globalTags.find(t => t.id === tid);
  if(!tag){ _bdCancelEditTag(); return; }
  const inp = document.getElementById('bd-tag-edit-input');
  const newText = (inp?.value || '').trim();
  if(!newText){ if(typeof toast === 'function') toast('⚠ Nome do marcador não pode ser vazio'); return; }
  tag.text = newText;
  if(_bdEditTagPendingColor != null && BD_COLORS[_bdEditTagPendingColor]){
    tag.color = BD_COLORS[_bdEditTagPendingColor];
  }
  _bdEditTagPendingColor = null;
  _bdEditingTagId = null;
  bdSave();
  document.getElementById('bd-tag-pick').innerHTML = _bdRenderTagPick();
  // Re-renderiza o board pra refletir mudanças nos cards
  if(typeof bdRender === 'function') bdRender();
  if(typeof toast === 'function') toast('✓ Marcador atualizado');
}
function _bdDeleteTag(tid){
  const tag = board.globalTags.find(t => t.id === tid);
  if(!tag) return;
  // Conta quantos cards usam essa tag
  const usedBy = board.cards.filter(c => (c.tagIds||[]).includes(tid)).length;
  const msg = usedBy > 0
    ? 'O marcador "' + tag.text + '" será removido permanentemente e desvinculado de ' + usedBy + ' card(s).'
    : 'O marcador "' + tag.text + '" será removido permanentemente.';
  const doDel = () => {
    // Remove da lista global
    board.globalTags = board.globalTags.filter(t => t.id !== tid);
    // Remove dos cards
    board.cards.forEach(c => {
      if(Array.isArray(c.tagIds)) c.tagIds = c.tagIds.filter(x => x !== tid);
    });
    // Remove da seleção do card aberto
    _bdEditTagIds = _bdEditTagIds.filter(x => x !== tid);
