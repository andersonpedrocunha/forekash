// Reorder Pessoas: só permite trocar ordem dentro do mesmo tipo + mesmo status ativo/inativo.
// Simulações (p.sim) ficam fora do drag.
function reorderPessoa(srcId, dstId, placeAbove){
  const src = pessoas.people.find(p => String(p.id) === String(srcId));
  const dst = pessoas.people.find(p => String(p.id) === String(dstId));
  if(!src || !dst) return;
  if(src.sim || dst.sim) return;
  if((src.tipoId || '') !== (dst.tipoId || '')) return;
  if(!!src.ativo !== !!dst.ativo) return;
  if(arrayReorder(pessoas.people, src, dst, placeAbove)){
    pessoasSave();
    renderPesSheet();
  }
}
ROW_REORDERERS.pes = reorderPessoa;

function setPesAtivo(id, val){
  const p = pessoas.people.find(x=>x.id===id);
  if(!p) return;
  const goingInactive = !val && p.ativo;
  const goingActive   =  val && !p.ativo;
  if(goingInactive){
    // Pergunta a data de saída antes de inativar
    askPesDataSaida(p).then(date => {
      if(date === null){
        // cancelado — reverte switch e re-renderiza
        renderPessoas();
        if(_pesCardOpenId === id) renderPesCardBody();
        return;
      }
      p.dataSaida = date;
      p.ativo = false;
      pessoasSave();
      renderPessoas();
      if(_pesCardOpenId === id) renderPesCardBody();
    });
    return;
  }
  if(goingActive){
    // Reativando: limpa data de saída
    p.dataSaida = '';
  }
  p.ativo = !!val;
  pessoasSave();
  renderPessoas(); // re-render para refletir no total
  if(_pesCardOpenId === id) renderPesCardBody();
}

