function buildMeta(hist,id,type){
  const last=hist.length>0?hist[hist.length-1]:null;
  const ts=last?`🕐 ${fmtTs(last.ts)}`:'🕐 Nunca atualizado';
  const link=hist.length>0?`&nbsp;·&nbsp;<button class="btn-hist" onclick="showHist(${id},'${type}')">ver ${hist.length} reg.</button>`:'';
  return ts+link;
}

// Guia de uso da extração por PDF — persiste "ocultado" no localStorage
const EMP_PDF_GUIDE_KEY = 'emp_pdf_guide_hidden_v1';
function hideEmpPdfGuide(){
  try { localStorage.setItem(EMP_PDF_GUIDE_KEY, '1'); } catch(e){}
  const g = document.getElementById('emp-pdf-guide');
  const r = document.getElementById('emp-pdf-guide-reopen');
  if(g) g.style.display = 'none';
  if(r) r.style.display = 'inline-flex';
}
function showEmpPdfGuide(){
  try { localStorage.removeItem(EMP_PDF_GUIDE_KEY); } catch(e){}
  const g = document.getElementById('emp-pdf-guide');
  const r = document.getElementById('emp-pdf-guide-reopen');
  if(g) g.style.display = '';
  if(r) r.style.display = 'none';
}
(function _empPdfGuideInit(){
  // Aplica estado inicial no DOMContentLoaded
  const apply = () => {
    try {
      const hidden = localStorage.getItem(EMP_PDF_GUIDE_KEY) === '1';
      const g = document.getElementById('emp-pdf-guide');
      const r = document.getElementById('emp-pdf-guide-reopen');
      if(g) g.style.display = hidden ? 'none' : '';
      if(r) r.style.display = hidden ? 'inline-flex' : 'none';
    } catch(e){}
  };
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);
  else apply();
})();

// Linhas de empréstimo ficam travadas (read-only) por padrão.
// Apertar ✏ Editar coloca a linha em modo edição; ✓ Concluir trava de novo.
const loanEditingIds = new Set();
function isLoanEditing(id){ return loanEditingIds.has(id); }
function toggleLoanEdit(id){
  if(loanEditingIds.has(id)) loanEditingIds.delete(id);
  else loanEditingIds.add(id);
  render();
}

function render(){
  const tbody=document.getElementById('loan-body');
  tbody.innerHTML='';
  // Migração sob demanda: converte loan.banco (string) → loan.bancoId (registro compartilhado)
  try{ loansMigrateBancos(); }catch(_){}
  if(loans.length===0){
    tbody.innerHTML=`<tr class="empty-row"><td colspan="12">Nenhum empréstimo cadastrado.<br><span style="font-size:.73rem">Clique em "Novo Empréstimo" para adicionar.</span></td></tr>`;
    updateSummary(); return;
  }
  loans.forEach(loan=>{
    const tr=document.createElement('tr'); tr.dataset.id=loan.id;
    const editing = isLoanEditing(loan.id);
    tr.className = editing ? 'is-editing' : 'is-locked';
    const ro = editing ? '' : ' readonly';
    const dis = editing ? '' : ' disabled';
    const tot=parseInt(loan.parcelas)||0, pag=parseInt(loan.parcelasPagas)||0;
    const pct=tot>0?Math.min(100,(pag/tot)*100):0;
    // Célula banco no mesmo estilo de Disponibilidades (logo + nome + chevron)
    const loanBanco = loanBancoResolve(loan);
