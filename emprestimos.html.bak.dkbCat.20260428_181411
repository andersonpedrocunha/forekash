    .fk-diag-ring-val{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
                      display:inline-flex;align-items:baseline;gap:1px;line-height:1;white-space:nowrap}
    .fk-diag-ring-num{font-size:2.1rem;font-weight:900;letter-spacing:-.03em;line-height:1;
                      background:linear-gradient(135deg,#10B981 0%,#6366F1 100%);
                      -webkit-background-clip:text;background-clip:text;
                      -webkit-text-fill-color:transparent;color:transparent}
    .fk-diag-ring-den{font-size:.78rem;color:#94A3B8;font-weight:700;letter-spacing:-.01em;line-height:1;
                      -webkit-text-fill-color:#94A3B8}
