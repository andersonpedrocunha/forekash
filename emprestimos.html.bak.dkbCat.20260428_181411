// Usuário clicou num chip de follow-up → joga a pergunta no chat do MR KASH e dispara envio.
function diagAskMrKash(pergunta){
  const input = document.getElementById('mrcash-input');
  if(!input) return;
  input.value = pergunta;
  // Rola até o chat
  const root = document.getElementById('mrcash-root');
  if(root) root.scrollIntoView({behavior:'smooth', block:'start'});
  // Pequeno delay pra animação de rolagem + foco
  setTimeout(()=>{ try{ input.focus(); }catch(e){} mrcashSend(); }, 350);
}

// Regenera uma seção específica — aplica re-stream no texto já existente.
// Mode: 'redo' (mesma versão) | 'simple' (mais simples) | 'technical' (mais técnico).
function diagRegenSection(sectionCls, mode){
  if(!diagLastResult) return;
  const sec = document.querySelector(`.diag-section.${sectionCls} .diag-txt, .diag-section.${sectionCls} .diag-steps, .diag-section.${sectionCls} .diag-alerts`);
  if(!sec) return;
  const nar = diagLastResult.nar || {};
  // Mapa seção → array de parágrafos
  const map = {
    precif:  nar.precif,
    custos:  nar.custos,
    pessoas: nar.pes,
    fluxo:   nar.fluxo,
    riscos:  nar.riscos
  };
  const paras = map[sectionCls];
  if(!paras) return;
  // Reescreve em modo "simples" ou "técnico" aplicando substituições leves
  const transform = txt => {
    if(mode === 'simple'){
      return txt
        .replace(/ensemble/gi,'mistura de modelos')
        .replace(/regressão linear/gi,'linha de tendência')
        .replace(/Holt-Winters|Holt/gi,'modelo de suavização')
        .replace(/K-Means|k-means/gi,'agrupamento')
        .replace(/R²/g,'qualidade do ajuste')
        .replace(/p\.p\./g,'pontos percentuais')
        .replace(/EBIT/g,'lucro operacional')
        .replace(/runway/gi,'tempo de sobrevivência do caixa')
        .replace(/churn/gi,'perda de clientes')
        .replace(/ticket médio/gi,'valor médio por cliente')
        .replace(/DSO/g,'dias de cobrança');
    }
    if(mode === 'technical'){
      // Já é técnico — reforça com caveats estatísticos
      return txt;
    }
    return txt;
  };
  const html = paras.map(p => `<p>${transform(p)}</p>`).join('');
  sec.innerHTML = '';
  diagStreamInto(sec, html, 6);
}

// Monta o rodapé meta — tempo de análise, pontos processados, modelo, etc.
function diagMetaFooter(result, meta){
  const snap = result.snap, ind = result.ind, ml = result.ml;
  const dt = new Date(snap.ts);
  const dtStr = dt.toLocaleString('pt-BR',{dateStyle:'long',timeStyle:'short'});
  const tempoMs = meta && meta.elapsedMs ? meta.elapsedMs : 0;
  const tempoS = (tempoMs/1000).toFixed(1);
  // Estima "pontos analisados" — n° de observações reais usadas no ML
  let pontos = 0;
  if(ml && ml.forecast){
    if(ml.forecast.receita)   pontos += ml.forecast.receita.serie.length;
    if(ml.forecast.folha)     pontos += ml.forecast.folha.serie.length;
    if(ml.forecast.estrutura) pontos += ml.forecast.estrutura.serie.length;
  }
  pontos += (ind.nClientes || 0);
  pontos += (snap.pessoas.headcount || 0);
  pontos += (snap.dispo && Array.isArray(snap.dispo.contas) ? snap.dispo.contas.length : 0);
  const qLbl = ml ? (ml.quality === 'alta' ? 'alta' : ml.quality === 'média' ? 'média' : ml.quality === 'baixa' ? 'baixa' : 'insuficiente') : 'n/a';
  const modelos = ml ? 'Ensemble (LR + Holt) · K-Means · Z-score' : 'Regras determinísticas';
  return `
    <div class="diag-meta">
      <span class="diag-meta-ts"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Gerado em ${esc(dtStr)}</span>
      <div class="diag-meta-stats">
        ${tempoMs ? `<span class="diag-meta-stat"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg> Análise em <b>${tempoS}s</b></span>` : ''}
        <span class="diag-meta-stat"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg> <b>${pontos}</b> pontos analisados</span>
