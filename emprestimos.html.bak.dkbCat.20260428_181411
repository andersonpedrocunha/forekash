      'Caixa hoje em ' + fmt(k.saldo) + '. No burn de ' + fmt(x.burnMes) + '/mês, isso significa ' + rwTxt + ' de pista — fôlego ' + rwQual + '.',
      fmt(k.saldo) + ' em caixa, queima média de ' + fmt(x.burnMes) + ' por mês. Pista projetada de ' + rwTxt + ' (' + rwQual + ').',
      'A liquidez está em ' + fmt(k.saldo) + ' e a operação consome ' + fmt(x.burnMes) + ' mensais. Resultado: ' + rwTxt + ' até cruzar a linha.',
      'Posição de caixa ' + fmt(k.saldo) + '. Burn ' + fmt(x.burnMes) + '/mês entrega ' + rwTxt + ' de runway — cenário ' + rwQual + '.'
    ]));
  }

  // ─── CLIENTES ───
  if(subjects.has('clientes')){
    const chQual = k.churn < 5 ? 'sob controle' : k.churn < 15 ? 'em monitoramento' : 'preocupante';
    const concTxt = top3Pct > 50 ? ' Top 3 representam ' + fmtPct(top3Pct) + ' — concentração alta, vale diversificar.' : top3Pct > 30 ? ' Top 3 = ' + fmtPct(top3Pct) + ' (concentração média).' : '';
    partes.push(_anaPickVar([
      'A carteira ativa de ' + k.clientesAtivos + ' clientes movimentou ' + fmt(k.receita) + ' — ticket médio ' + fmt(x.ticketMedio) + ', LTV ' + fmt(k.ltv) + '. Churn ' + fmtPct(k.churn) + ', ' + chQual + '.' + concTxt,
      k.clientesAtivos + ' clientes ativos sustentam a operação. Ticket médio ' + fmt(x.ticketMedio) + ', LTV ' + fmt(k.ltv) + ', retenção ' + fmtPct(100-k.churn) + '.' + concTxt,
      'Base de ' + k.clientesAtivos + ' clientes gerando ' + fmt(x.ticketMedio) + ' por relação. Churn em ' + fmtPct(k.churn) + ' — ' + chQual + '.' + concTxt,
      'Quem comprou: ' + k.clientesAtivos + ' clientes. Quanto cada um vale: ' + fmt(k.ltv) + ' de LTV. Ritmo de saída: ' + fmtPct(k.churn) + '.' + concTxt
    ]));
  }

  // ─── PESSOAS ───
  if(subjects.has('pessoas')){
    const tQual = k.turnover < 10 ? 'sob controle' : k.turnover < 20 ? 'em alerta' : 'elevado';
    const fQual = x.pctFolha < 30 ? 'saudável' : x.pctFolha < 50 ? 'no limite' : 'pesada';
    partes.push(_anaPickVar([
      'O time tem ' + Math.round(k.headcount) + ' pessoas e custa ' + fmt(k.folha) + ' no período — ' + fmtPct(x.pctFolha) + ' da receita (' + fQual + '). Turnover ' + fmtPct(k.turnover) + ', ' + tQual + '.',
      Math.round(k.headcount) + ' colaboradores entregam ' + fmt(x.receitaPorFunc) + ' de receita per capita. Folha ' + fQual + ' em ' + fmtPct(x.pctFolha) + ' do faturamento.',
      'Operação roda com ' + Math.round(k.headcount) + ' pessoas, custo médio ' + fmt(x.salarioMedio) + '/pessoa. Folha pesa ' + fmtPct(x.pctFolha) + ' (' + fQual + '), rotatividade ' + tQual + '.',
      'Headcount em ' + Math.round(k.headcount) + '. Custo total ' + fmt(k.folha) + ' representa ' + fmtPct(x.pctFolha) + ' da receita — ' + fQual + '.'
    ]));
  }

  // ─── DÍVIDA ───
  if(subjects.has('divida')){
    const dQual = x.pctLoans > 30 ? 'pesado' : x.pctLoans > 15 ? 'moderado' : 'controlado';
    partes.push(_anaPickVar([
      'O estoque devedor está em ' + fmt(k.endividamento) + ', comprometendo ' + fmtPct(x.pctLoans) + ' da receita — patamar ' + dQual + '.',
      fmt(k.endividamento) + ' em empréstimos. Serviço da dívida toma ' + fmtPct(x.pctLoans) + ' do faturamento (' + dQual + ').',
      'Posição de dívida: ' + fmt(k.endividamento) + '. Cada R$ 100 de receita devolve R$ ' + (x.pctLoans).toFixed(0) + ' aos bancos.',
      'Compromisso financeiro de ' + fmt(k.endividamento) + ' — ' + dQual + ' frente à geração de receita do período.'
    ]));
  }
  return partes.join(' ');
}
