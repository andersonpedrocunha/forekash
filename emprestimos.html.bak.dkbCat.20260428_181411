function recKbSetFilter(field, value){
  _recKbState.quick = null; // edição manual sai dos atalhos
  if(field === 'fromMes'){ _recKbState.from = _recKbState.from || { y: new Date().getFullYear(), m:0 }; _recKbState.from.m = parseInt(value,10) || 0; }
  else if(field === 'fromAno'){ _recKbState.from = _recKbState.from || { y: new Date().getFullYear(), m:0 }; _recKbState.from.y = parseInt(value,10) || new Date().getFullYear(); }
  else if(field === 'toMes'){ _recKbState.to = _recKbState.to || { y: new Date().getFullYear(), m:11 }; _recKbState.to.m = parseInt(value,10) || 0; }
  else if(field === 'toAno'){ _recKbState.to = _recKbState.to || { y: new Date().getFullYear(), m:11 }; _recKbState.to.y = parseInt(value,10) || new Date().getFullYear(); }
  else if(field === 'search'){ _recKbState.search = value || ''; }
  recRenderKanban();
}
try { window.recKbSetFilter = recKbSetFilter; } catch(e){}

function recKbQuick(preset){
  const now = new Date();
  const cy = now.getFullYear(), cm = now.getMonth();
  if(preset === 'mes'){
    _recKbState.from = { y: cy, m: cm };
    _recKbState.to   = { y: cy, m: cm };
  } else if(preset === '3m'){
    _recKbState.from = { y: cy, m: cm };
    let endY = cy, endM = cm + 2;
    while(endM > 11){ endM -= 12; endY++; }
    _recKbState.to = { y: endY, m: endM };
  } else if(preset === 'ano'){
    _recKbState.from = { y: cy, m: 0 };
    _recKbState.to   = { y: cy, m: 11 };
  } else if(preset === 'tudo'){
    const ys = _recKbAvailableYears();
    _recKbState.from = { y: ys[0], m: 0 };
    _recKbState.to   = { y: ys[ys.length-1], m: 11 };
  }
  _recKbState.quick = preset;
  recRenderKanban();
}
try { window.recKbQuick = recKbQuick; } catch(e){}

// Drag & drop
let _recKbDrag = null;
function _recKbCardDragStart(e, year, mesAbbr, rowId){
  _recKbDrag = { year, mesAbbr, rowId };
  if(e.dataTransfer){
    e.dataTransfer.effectAllowed = 'move';
    try { e.dataTransfer.setData('text/plain', String(rowId)); } catch(_){}
  }
  if(e.currentTarget) e.currentTarget.classList.add('is-dragging');
}
function _recKbCardDragEnd(e){
  _recKbDrag = null;
  document.querySelectorAll('.rec-kb-card.is-dragging').forEach(el => el.classList.remove('is-dragging'));
  document.querySelectorAll('.rec-kb-col.is-drop').forEach(el => el.classList.remove('is-drop'));
}
function _recKbDragOver(e){
  if(!_recKbDrag) return;
  e.preventDefault();
  if(e.dataTransfer) e.dataTransfer.dropEffect = 'move';
  e.currentTarget.classList.add('is-drop');
}
function _recKbDragLeave(e){
  e.currentTarget.classList.remove('is-drop');
}
function _recKbDrop(e, colId){
  e.preventDefault();
  e.currentTarget.classList.remove('is-drop');
  const drag = _recKbDrag;
  _recKbDrag = null;
  if(!drag) return;
  const d = receita && receita.years && receita.years[drag.year];
  if(!d) return;
  const row = (d.clients || []).find(x => x.id === drag.rowId);
  if(!row || !row.meses || !row.meses[drag.mesAbbr]) return;
  const cell = row.meses[drag.mesAbbr];
  if(cell.valor === '' || cell.valor == null) return;
  const novo = colId === 'recebido' ? 'recebido' : 'aberto';
  if(cell.status === novo){ recRenderKanban(); return; }
  // Se for marcar como recebido — pergunta a data abrindo o modal
  if(novo === 'recebido'){
    recKbCardOpen(drag.year, drag.mesAbbr, drag.rowId, { dragToRecebido: true });
    return;
  }
  // Saindo de recebido — limpa data de recebimento
  cell.status = 'aberto';
  if(cell.dataRecebimento) delete cell.dataRecebimento;
  if(typeof receitaSave === 'function') receitaSave();
  _recKbSyncSheetCell(drag.year, drag.mesAbbr, drag.rowId);
  if(typeof updateRecTotals === 'function'){ try { updateRecTotals(); } catch(_){} }
  recRenderKanban();
  if(typeof toast === 'function') toast('Voltou pra Em Aberto (data de recebimento removida)');
}
// Sincroniza visual da célula da planilha com o status atual da cell.
// Só age se o ano for o ativo na planilha (caso contrário, o re-render acontece
// quando o usuário navegar pra esse ano nas year tabs).
function _recKbSyncSheetCell(year, mesAbbr, rowId){
  if(typeof recActiveYear === 'undefined' || year !== recActiveYear) return;
  try {
    const d = receita && receita.years && receita.years[year];
    if(!d) return;
    const row = (d.clients || []).find(r => r.id === rowId);
    if(!row || !row.meses || !row.meses[mesAbbr]) return;
    const cell = row.meses[mesAbbr];
    const td = document.querySelector('tr[data-rec="client-' + rowId + '"] td.rec-cell[data-mes="' + mesAbbr + '"]');
    if(td){
      td.classList.remove('recebido','aberto');
      td.classList.add(cell.status === 'recebido' ? 'recebido' : 'aberto');
      const tog = td.querySelector('.rec-cell-toggle');
      if(tog) tog.textContent = cell.status === 'recebido' ? '✓' : '';
    } else {
      // Célula ainda não está no DOM — força um re-render completo da planilha
      // (acontece se o usuário entrou direto no kanban sem antes carregar a planilha)
      if(typeof renderReceita === 'function'){ try { renderReceita(); } catch(_){} }
    }
  } catch(e){}
}
