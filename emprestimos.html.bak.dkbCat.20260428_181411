// Recalcula o "Valor" no header do modal (base + soma dos itens adicionais)
function _itemsRecalcHeaderTotal(prefix){
  const headerId = (prefix === 'dkb') ? 'dkb-info-valor-total'
                 : (prefix === 'rec') ? 'rec-info-valor-total'
                 : null;
  if(!headerId) return;
  const el = document.getElementById(headerId);
  if(!el) return;
  const base = parseFloat(el.getAttribute('data-base')) || 0;
  const arr = _itemsState(prefix);
  const extra = arr.reduce((s, it) => s + (parseFloat(it.valor) || 0), 0);
  const total = base + extra;
  el.textContent = (typeof fmtBRL === 'function') ? fmtBRL(total) : ('R$ ' + total.toFixed(2).replace('.', ','));
  // Pequeno indicador visual quando há itens adicionais
  if(extra > 0){
    el.title = 'Base: ' + (typeof fmtBRL === 'function' ? fmtBRL(base) : ('R$ ' + base.toFixed(2))) + ' + Itens: ' + (typeof fmtBRL === 'function' ? fmtBRL(extra) : ('R$ ' + extra.toFixed(2)));
    el.style.fontStyle = 'italic';
  } else {
    el.removeAttribute('title');
    el.style.fontStyle = '';
  }
}

// Combobox por item — versão genérica
function _itemsCbxSource(prefix, i, name){
  const tipo = _itemsTipo(prefix);
  if(name === 'cat') return _extOfficialCats(tipo);
  if(name === 'counter') return _extOfficialCounters(tipo);
  return [];
}
function _itemsCbxRender(prefix, i, name){
  const inp = document.getElementById(prefix + '-it-' + name + '-' + i);
  const pop = document.getElementById(prefix + '-it-cbx-pop-' + name + '-' + i);
  if(!inp || !pop) return;
  const q = (inp.value || '').trim();
  const qLow = q.toLowerCase();
  const all = _itemsCbxSource(prefix, i, name);
  const filtered = q ? all.filter(x => x.toLowerCase().includes(qLow)) : all.slice();
  const exact = q && all.some(x => x.toLowerCase() === qLow);
  let html = '';
  if(filtered.length === 0 && !q){
    html += '<div class="cart-cbx-item empty">Nenhum cadastro ainda — digite para criar</div>';
  } else {
    for(let k=0; k<filtered.length; k++){
      const v = filtered[k];
      html += '<div class="cart-cbx-item" onmousedown="event.preventDefault();_itemsCbxPick(\'' + prefix + '\',' + i + ',\'' + name + '\',' + k + ')">' + _dkbEsc(v) + '</div>';
    }
  }
  if(q && !exact){
    const tipo = _itemsTipo(prefix);
    let lbl;
    if(name === 'cat') lbl = 'Cadastrar categoria "' + _dkbEsc(q) + '"' + (tipo === 'gasto' ? ' (em Estrutura)' : '');
    else lbl = (tipo === 'ganho' ? 'Cadastrar cliente "' : 'Cadastrar fornecedor "') + _dkbEsc(q) + '"';
    html += '<div class="cart-cbx-add" onmousedown="event.preventDefault();_itemsCbxCreate(\'' + prefix + '\',' + i + ',\'' + name + '\')">' + lbl + '</div>';
  }
  pop.innerHTML = html;
}
function _itemsCbxOpen(prefix, i, name){
  const pop = document.getElementById(prefix + '-it-cbx-pop-' + name + '-' + i);
  if(!pop) return;
  _itemsCbxRender(prefix, i, name);
  pop.classList.add('open');
  setTimeout(() => {
    const handler = (e) => {
      if(!pop.contains(e.target)){
        const inp = document.getElementById(prefix + '-it-' + name + '-' + i);
        if(inp && e.target === inp) return;
        pop.classList.remove('open');
        document.removeEventListener('mousedown', handler, true);
      }
    };
    document.addEventListener('mousedown', handler, true);
  }, 0);
}
function _itemsCbxClose(prefix, i, name){
  const pop = document.getElementById(prefix + '-it-cbx-pop-' + name + '-' + i);
  if(pop) pop.classList.remove('open');
}
function _itemsCbxToggle(prefix, i, name){
  const pop = document.getElementById(prefix + '-it-cbx-pop-' + name + '-' + i);
  if(!pop) return;
  if(pop.classList.contains('open')) _itemsCbxClose(prefix, i, name);
  else _itemsCbxOpen(prefix, i, name);
}
function _itemsCbxFilter(prefix, i, name){
  _itemsCbxRender(prefix, i, name);
  const pop = document.getElementById(prefix + '-it-cbx-pop-' + name + '-' + i);
  if(pop) pop.classList.add('open');
}
function _itemsCbxPick(prefix, i, name, idx){
  const inp = document.getElementById(prefix + '-it-' + name + '-' + i);
  if(!inp) return;
  const all = _itemsCbxSource(prefix, i, name);
  const q = (inp.value || '').trim().toLowerCase();
  const filtered = q ? all.filter(x => x.toLowerCase().includes(q)) : all.slice();
  const v = filtered[idx];
  if(v){
    inp.value = v;
    _itemsUpdate(prefix, i, name === 'cat' ? 'categoria' : 'contraparte', v);
  }
  _itemsCbxClose(prefix, i, name);
}
function _itemsCbxCreate(prefix, i, name){
  const inp = document.getElementById(prefix + '-it-' + name + '-' + i);
  if(!inp) return;
  const v = (inp.value || '').trim();
  if(!v) return;
  const tipo = _itemsTipo(prefix);
  if(name === 'cat' && tipo === 'gasto'){
    try {
      if(typeof estrutura !== 'undefined' && estrutura){
        if(!Array.isArray(estrutura.tags)) estrutura.tags = [];
        const exists = estrutura.tags.find(t => (t.nome||'').trim().toLowerCase() === v.toLowerCase());
        if(!exists){
          let color = '#94A3B8';
          if(typeof EST_COLOR_PALETTE !== 'undefined') color = EST_COLOR_PALETTE[estrutura.tags.length % EST_COLOR_PALETTE.length];
          const id = (typeof estNextTagId === 'function') ? estNextTagId() : (Date.now() % 1000000);
          estrutura.tags.push({ id, nome: v, color });
          if(typeof estSave === 'function') estSave();
          if(typeof toast === 'function') toast('✓ Categoria "' + v + '" cadastrada');
        }
      }
    } catch(_){}
  } else if(name === 'counter'){
    if(tipo === 'ganho'){
      try {
        if(typeof receita !== 'undefined' && receita){
          if(!Array.isArray(receita.clientes)) receita.clientes = [];
          const exists = receita.clientes.find(c => (c.nome||'').trim().toLowerCase() === v.toLowerCase());
          if(!exists){
            if(!receita.nextClienteId) receita.nextClienteId = 1;
            const colors = (typeof REC_COLORS !== 'undefined') ? REC_COLORS : ['#3B82F6'];
            receita.clientes.push({ id: receita.nextClienteId++, nome: v, pais:'', color: colors[receita.clientes.length % colors.length] });
            if(typeof receitaSave === 'function') receitaSave();
            if(typeof toast === 'function') toast('✓ Cliente "' + v + '" cadastrado');
          }
        }
      } catch(_){}
    } else {
      try {
        if(typeof pessoas !== 'undefined' && pessoas){
          if(!Array.isArray(pessoas.registry)) pessoas.registry = [];
          const exists = pessoas.registry.find(r => r && r.kind !== 'colaborador' && (r.nome||'').trim().toLowerCase() === v.toLowerCase());
          if(!exists){
            if(!pessoas.nextRegId) pessoas.nextRegId = 1;
            pessoas.registry.push({ id: pessoas.nextRegId++, nome: v, foto:'', anexos:[], tags:[], kind:'fornecedor', tipoPessoa:'pj', ativo:true });
            if(typeof pessoasSave === 'function') pessoasSave();
            if(typeof toast === 'function') toast('✓ Fornecedor "' + v + '" cadastrado');
          }
        }
      } catch(_){}
    }
  }
  _itemsUpdate(prefix, i, name === 'cat' ? 'categoria' : 'contraparte', v);
  _itemsCbxClose(prefix, i, name);
}

