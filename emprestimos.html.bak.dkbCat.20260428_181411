  if(_anaLastFocused && document.body.contains(_anaLastFocused)) return _anaLastFocused;
  // fallback por target
  if(_anaEditTarget === 'title') return document.querySelector('.ana-slide-edit-title[contenteditable="true"]');
  if(_anaEditTarget === 'subtitle') return document.querySelector('.ana-slide-edit-sub[contenteditable="true"]');
  if(_anaEditTarget === 'narrative') return document.querySelector('.ana-cw-text-editable');
  return null;
}
// Captura focus em qualquer contenteditable
document.addEventListener('focusin', (e) => {
  const t = e.target;
  if(t && t.getAttribute && t.getAttribute('contenteditable') === 'true'){
    _anaLastFocused = t;
  }
});
// Salva range sempre que seleção muda DENTRO de um editable
document.addEventListener('selectionchange', () => {
  const sel = window.getSelection();
  if(!sel || sel.rangeCount === 0) return;
  const range = sel.getRangeAt(0);
  // Verifica se o range está dentro de um contenteditable
  let n = range.commonAncestorContainer;
  if(n && n.nodeType === 3) n = n.parentElement;
  while(n && n !== document.body){
    if(n.getAttribute && n.getAttribute('contenteditable') === 'true'){
      _anaSavedRange = range.cloneRange();
      _anaLastFocused = n;
      break;
    }
    n = n.parentElement;
  }
});
function _anaRestoreFocus(el){
  if(!el) return;
  const wasAlreadyFocused = (document.activeElement === el);
  try { el.focus({ preventScroll:true }); } catch(e){ try{ el.focus(); }catch(_){} }
  // Só substitui a seleção live se o foco realmente saiu E temos range salvo
  if(!wasAlreadyFocused && _anaSavedRange){
    try {
      // Verifica se o saved range ainda é válido (nó ainda no DOM)
      const node = _anaSavedRange.startContainer;
      if(node && document.body.contains(node)){
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(_anaSavedRange);
      }
    } catch(e){}
  }
}
function _anaCaptureSelection(){
  // Re-captura a seleção viva (chamar depois de mutações de DOM)
  const sel = window.getSelection();
  if(sel && sel.rangeCount > 0){
    _anaSavedRange = sel.getRangeAt(0).cloneRange();
  }
}
function _anaHasSelection(){
  const sel = window.getSelection();
  return sel && sel.rangeCount > 0 && !sel.isCollapsed;
}
function _anaPersistContent(){
