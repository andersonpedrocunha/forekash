function _anaExec(cmd, val){
  const el = _anaFocusedEditable();
  if(!el){ if(typeof toast === 'function') toast('Clique no texto que deseja editar'); return; }
  _anaRestoreFocus(el);
  try {
    document.execCommand('styleWithCSS', false, true);
    document.execCommand(cmd, false, val);
    _anaCaptureSelection();
  } catch(e){}
