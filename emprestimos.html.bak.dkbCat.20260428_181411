// Encontra o parent agrupado e seus children no _extCollect()
function _extFindGroupChildren(grupoId, data){
  if(!grupoId || !data) return null;
  try {
    const all = (typeof _extCollect === 'function') ? _extCollect() : [];
    const parent = all.find(x => x && x.expandable && x.grupoId === grupoId && x.data === data);
    if(parent && Array.isArray(parent.children)) return { parent, children: parent.children };
  } catch(e){ console.warn('_extFindGroupChildren:', e); }
