    .diag-section{background:var(--card);border:1px solid var(--bdr);border-radius:14px;
                  padding:20px 22px;box-shadow:0 1px 3px rgba(15,23,42,.03)}
    .diag-section-hd{display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .diag-section-ico{width:32px;height:32px;border-radius:9px;flex-shrink:0;
                      display:flex;align-items:center;justify-content:center;color:#fff}
    .diag-section-ico svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.2;
                          stroke-linecap:round;stroke-linejoin:round}
    .diag-section.alertas .diag-section-ico{background:#DC2626}
    .diag-section.precif  .diag-section-ico{background:#2563EB}
    .diag-section.custos  .diag-section-ico{background:#EA580C}
    .diag-section.pessoas .diag-section-ico{background:#0D9488}
    .diag-section.fluxo   .diag-section-ico{background:#7C3AED}
    .diag-section.riscos  .diag-section-ico{background:#B91C1C}
    .diag-section.passos  .diag-section-ico{background:#059669}
    .diag-section-title{font-size:.98rem;font-weight:700;color:var(--tx);letter-spacing:-.01em;
                        flex:1;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .diag-section-count{font-size:.64rem;font-weight:700;padding:2px 8px;border-radius:999px;
                        background:#F3F4F6;color:#64748B;letter-spacing:.02em}

    .diag-txt{font-size:.82rem;line-height:1.7;color:#374151}
