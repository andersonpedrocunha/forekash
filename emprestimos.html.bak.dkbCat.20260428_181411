  const search = document.createElement('input');
  search.type = 'text';
  search.className = 'rec-pais-search';
  search.placeholder = 'Buscar país…';

  const list2 = document.createElement('div');
  list2.className = 'rec-pais-list';

  function render(filter){
    list2.innerHTML = '';
    const raw = (filter||'').trim();
    const f = _normStr(raw);
    // Opção "sem país"
    const noneOpt = document.createElement('div');
    noneOpt.className = 'rec-pais-opt none' + (!currentPais ? ' selected' : '');
    noneOpt.innerHTML = '<span class="f">—</span><span>Sem país</span>';
    noneOpt.onclick = (ev)=>{ ev.stopPropagation(); setPaisForRow(type,id,''); };
    if(!f) list2.appendChild(noneOpt);

    let matches = 0;
    const paises = recAllPaises();
    for(const p of paises){
      const okNome = _normStr(p.nome).includes(f);
      const okCode = (p.code||'').toLowerCase().includes(f);
      if(f && !okNome && !okCode) continue;
      matches++;
      const opt = document.createElement('div');
      opt.className = 'rec-pais-opt' + (currentPais === p.code ? ' selected' : '');
      opt.innerHTML = `<span class="f">${p.flag}</span><span>${esc(p.nome)}</span>`;
      opt.onclick = (ev)=>{ ev.stopPropagation(); setPaisForRow(type,id,p.code); };
      list2.appendChild(opt);
    }

    // Oferece adicionar um novo país quando:
    //  (a) o usuário digitou algo e não há nenhum resultado existente, OU
    //  (b) achamos no dicionário um país que ainda não está na lista preferida.
    if(raw){
      const suger = lookupPaisByName(raw);
      const jaExiste = suger && paises.some(p => p.code === suger.code);
      if(suger && !jaExiste){
        const add = document.createElement('div');
        add.className = 'rec-pais-opt add';
        add.innerHTML = `<span class="f">${suger.flag}</span><span>Adicionar ${esc(suger.nome)}</span>`;
        add.onclick = (ev)=>{
          ev.stopPropagation();
          const novo = addPaisCustom(suger.nome);
          if(novo) setPaisForRow(type, id, novo.code);
        };
        list2.appendChild(add);
      } else if(!suger && matches === 0){
        // Sem correspondência no dicionário — deixa o usuário adicionar
        // manualmente com bandeira genérica.
        const add = document.createElement('div');
        add.className = 'rec-pais-opt add';
        add.innerHTML = `<span class="f">🌍</span><span>Adicionar "${esc(raw)}"</span>`;
        add.onclick = (ev)=>{
          ev.stopPropagation();
          const novo = addPaisCustom(raw);
          if(novo) setPaisForRow(type, id, novo.code);
        };
        list2.appendChild(add);
      }
    }
  }
  render('');
  search.addEventListener('input', ()=>render(search.value));
  search.addEventListener('keydown', e=>{
    if(e.key==='Escape'){ e.stopPropagation(); closePaisPicker(); }
  });
  pop.addEventListener('click', e=>e.stopPropagation());

  pop.appendChild(search);
  pop.appendChild(list2);

  const rect = btn.getBoundingClientRect();
  pop.style.top  = Math.min(rect.bottom+6, window.innerHeight - 340)+'px';
  pop.style.left = Math.min(rect.left, window.innerWidth - 260)+'px';
  document.body.appendChild(pop);
  setTimeout(()=>{
    search.focus();
    document.addEventListener('click', closePaisPicker, {once:true});
  }, 40);
}

function closePaisPicker(){
  const p = document.getElementById('pais-pop');
  if(p) p.remove();
}

function setPaisForRow(type, id, code){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  const c = clienteOf(row);
  if(c){
    // Atualiza o cliente globalmente — todas as linhas do grupo refletem
    c.pais = code || '';
  }
  // Atualiza fallback na linha (usado quando órfã)
  row.pais = code || '';
  receitaSave();
  closePaisPicker();
  // Re-renderiza para propagar o país a todas as linhas do cliente e atualizar filtros
  renderReceita();
}

function updateRecRowTotal(type, id){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  let total = 0;
  for(const m of REC_MESES){
    const c = row.meses[m];
    if(c && c.valor !== '' && c.valor != null) total += parseFloat(c.valor)||0;
  }
  const td = document.querySelector(`tr[data-rec="${type}-${id}"] td.stk-5`);
  if(td) td.textContent = total>0 ? fmtBRL(total) : '—';
}

function updateRecTotals(){
  if(!receita) return;
  const d = receita.years[recActiveYear]; if(!d) return;
  let tRec=0, tAbt=0, tSim=0;
  const porMes = {};
  for(const m of REC_MESES) porMes[m]=0;

  // Conta clientes "ativos" — com pelo menos um valor em algum mês
  let activeClients = 0;
  for(const r of d.clients){
    let rowHas = false;
    for(const m of REC_MESES){
      const c = r.meses[m]; if(!c || c.valor==='' || c.valor==null) continue;
      const v = parseFloat(c.valor)||0;
      porMes[m] += v;
      if(c.status==='recebido') tRec+=v; else tAbt+=v;
      rowHas = true;
    }
    if(rowHas) activeClients++;
  }
  let simClients = 0;
  for(const r of d.leads){
    let rowHas = false;
    for(const m of REC_MESES){
      const c = r.meses[m]; if(!c || c.valor==='' || c.valor==null) continue;
      const v = parseFloat(c.valor)||0;
      tSim += v;
      if(recIncluirSim){
        porMes[m] += v;
        if(c.status==='recebido') tRec+=v; else tAbt+=v;
      }
      rowHas = true;
    }
    if(rowHas) simClients++;
  }
  const tTot = tRec + tAbt;
  // Ticket médio: divide o total efetivo pelo número de "linhas com valor"
  // que entram no cálculo (sempre clientes, e leads se a inclusão estiver ligada).
  const divisor = activeClients + (recIncluirSim ? simClients : 0);
  const ticket = divisor > 0 ? tTot/divisor : 0;

  const setE = (id,val)=>{ const e=document.getElementById(id); if(e) e.textContent=val; };
  setE('rec-kpi-recebido', fmtBRL(tRec));
  setE('rec-kpi-aberto',   fmtBRL(tAbt));
  setE('rec-kpi-total',    fmtBRL(tTot));
  setE('rec-kpi-sim',      fmtBRL(tSim));
  setE('rec-kpi-ticket',   fmtBRL(ticket));
  const totalClients = d.clients.length;
  const incluiSimTxt = (recIncluirSim && simClients>0)
    ? ` + ${simClients} simulação${simClients>1?'ões':''}`
    : '';
  setE('rec-kpi-ticket-sub',
    activeClients > 0 || (recIncluirSim && simClients > 0)
      ? `média entre ${activeClients} cliente${activeClients!==1?'s':''} ativo${activeClients!==1?'s':''}${totalClients>activeClients?` (de ${totalClients})`:''}${incluiSimTxt}`
      : 'nenhum cliente com receita no ano'
  );
  const pct = tTot>0 ? Math.round(tRec/tTot*100) : 0;
  setE('rec-kpi-recebido-sub', pct+'% da receita prevista');
  setE('rec-kpi-total-year', recActiveYear);

  for(const m of REC_MESES){
    setE('rec-total-'+m, porMes[m]>0 ? fmtBRL(porMes[m]) : '—');
  }
  setE('rec-total-ano', tTot>0 ? fmtBRL(tTot) : 'R$ 0,00');
}

function renderReceita(){
  if(!receita) return;
  // Tabs de ano
  const ytContainer = document.getElementById('rec-year-tabs');
  if(!ytContainer) return;
  const years = Object.keys(receita.years).sort();
  ytContainer.innerHTML = years.map(y=>`
    <button class="rec-year-tab ${y===recActiveYear?'active':''}" onclick="switchRecYear('${y}')">
      <span>${y}</span>
      <span class="rec-year-dup" onclick="event.stopPropagation();duplicateRecYear('${y}')" title="Duplicar este ano">⧉</span>
      ${years.length>1 ? `<span class="rec-year-del" onclick="event.stopPropagation();delRecYear('${y}')" title="Remover ano">✕</span>` : ''}
    </button>
  `).join('') + `<button class="rec-year-add" onclick="addRecYear()">+ Novo ano</button>`;

  const d = receita.years[recActiveYear];

  // Computa informações de agrupamento de linhas do mesmo cliente (mesmo clienteId)
  // em sequência. Retorna um array paralelo: [{isFirst, groupSize, isSub}].
  // Linhas órfãs (clienteId=0) NÃO são agrupadas entre si.
  const computeGroups = (rows) => {
    const info = rows.map(() => ({isFirst:false, isSub:false, groupSize:1}));
    let i = 0;
    while(i < rows.length){
      const cid = rows[i].clienteId || 0;
      let j = i;
      if(cid){
        while(j+1 < rows.length && (rows[j+1].clienteId||0) === cid) j++;
      }
      const size = j - i + 1;
      info[i].isFirst = true; info[i].groupSize = size;
      for(let k=i+1;k<=j;k++){ info[k].isSub = true; info[k].groupSize = size; }
      i = j + 1;
    }
    return info;
  };

  const renderRow = (r, type, g) => {
    const isSim = (type==='lead');
    const isSub = g && g.isSub;
    const view = clienteView(r); // { id, nome, pais, color }
    const groupBadge = g && g.isFirst && g.groupSize > 1
      ? `<span class="rec-proj-badge" title="${g.groupSize} projetos para este cliente">+${g.groupSize-1} projeto${g.groupSize-1===1?'':'s'}</span>`
      : '';
    const cells = REC_MESES.map(m=>{
      const c = r.meses[m] || {valor:'', status:'aberto'};
      const hasRaw = (c.valor !== '' && c.valor != null);
      const numVal = hasRaw ? +c.valor : 0;
      const has = hasRaw && !Number.isNaN(numVal) && numVal !== 0;
      const cls = has ? (c.status==='recebido' ? 'recebido' : 'aberto') : '';
      const simCls = isSim ? 'sim' : '';
      const icon = c.status==='recebido' ? '✓' : '';
      const locked = has && c.status === 'recebido';
      const ro = locked ? ' readonly' : '';
      const roTitle = locked ? ' title="Remova o ✓ para editar"' : '';
      const roClick = locked ? ' onmousedown="notifyLocked()"' : '';
      return `<td class="rec-cell ${cls} ${simCls}" data-mes="${m}">
        <input class="rec-input num" type="text" value="${has ? esc(fmtBR(c.valor)) : ''}"
               placeholder="0,00"
               data-cellref="rec:${type}:${r.id}:${m}"${ro}${roTitle}${roClick}
               onfocus="this.select()"
               onblur="saveRecMes('${type}',${r.id},'${m}',this.value);var _rv=parseBR(this.value);this.value=(_rv===''||_rv===0)?'':fmtBR(_rv)"
               onkeydown="if(event.key==='Enter'){this.blur();}else if(event.key==='Escape'){this.blur();}">
        <button type="button" class="rec-cell-toggle" onclick="event.stopPropagation();toggleRecMesStatus('${type}',${r.id},'${m}')" title="Alternar recebido / em aberto">${icon}</button>
      </td>`;
    }).join('');

    const placeholder = isSim ? 'Selecione lead…' : 'Selecione cliente…';
    const tipos = recTipos();
    const tipoAtivo = recTipoByNome(r.tipo);
    const tipoCls = tipoAtivo ? 'filled' : 'empty';
    const tipoStyle = tipoAtivo
      ? `--tc:${tipoAtivo.color};--ttxt:${REC_TIPO_TXT}`
      : '';
    const tipoOptions = ['<option value="">— Selecionar —</option>']
      .concat(tipos.map(t=>`<option value="${esc(t.nome)}"${r.tipo===t.nome?' selected':''}>${esc(t.nome)}</option>`))
      .join('');
    const paisObj = recPaisByCode(view.pais);
    const paisDisp = paisObj ? paisObj.flag : '—';
    const paisEmpty = paisObj ? '' : 'empty';
    const paisTitle = paisObj ? paisObj.nome : 'Escolher país';
    // Estado "ativo" do cliente (entidade global). Leads e órfãos não expõem o toggle.
    const cliEntity = clienteOf(r);
    const cliAtivo  = cliEntity ? !!cliEntity.ativo : true;
    const rowExtraCls = (!isSim && cliEntity && !cliAtivo) ? ' cli-inativo' : '';
    const ativoCell = (!isSim && cliEntity)
      ? `<td class="stk stk-ativo">
           <div class="rec-ativo-wrap">
             <button type="button" class="rec-ativo-toggle${cliAtivo?' on':''}"
                     onclick="toggleClienteAtivo(${cliEntity.id})"
                     title="${cliAtivo?'Cliente ativo — clique para inativar':'Cliente inativo — clique para ativar'}"
                     aria-label="${cliAtivo?'Ativo':'Inativo'}"></button>
           </div>
         </td>`
      : `<td class="stk stk-ativo"><span class="rec-ativo-sub" aria-hidden="true"></span></td>`;
    // Ícone info só aparece em linhas com cliente cadastrado (não leads / órfãos) e só no cabeçalho do grupo.
    const infoIconHtml = (!isSim && cliEntity && !isSub)
      ? `<button type="button" class="rec-cli-info" title="Ver detalhes do cliente"
                 onclick="event.stopPropagation();openClienteDetail(${cliEntity.id})">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
         </button>`
      : '';
    // Texto exibido no botão de cliente
    const nomeDisp    = view.nome || placeholder;
    const nomeEmptyCl = view.nome ? '' : 'empty';
    const clienteTitle = view.id
      ? `Cliente #${view.id}: ${view.nome} · clique para trocar, renomear ou criar outro`
      : 'Clique para selecionar ou criar um cliente';
    const firstColInner = isSub
      ? `<span class="rec-row-indicator" style="background:${view.color}"></span>
         <span class="rec-sub-arrow" title="mesmo cliente acima">↳</span>
         <button type="button" class="rec-cli-btn ${nomeEmptyCl}" title="${esc(clienteTitle)}"
                 onclick="openClientePicker('${type}',${r.id},this,event)">
           <span class="rec-cli-txt">${esc(nomeDisp)}</span>
           <span class="rec-cli-caret">▾</span>
         </button>`
      : `<span class="rec-row-indicator" style="background:${view.color}"></span>
         <span class="rec-color-dot" style="background:${view.color}" title="Mudar cor" onclick="openRecPalette('${type}',${r.id},this,event)"></span>
         <button type="button" class="rec-cli-btn ${nomeEmptyCl}" title="${esc(clienteTitle)}"
                 onclick="openClientePicker('${type}',${r.id},this,event)">
           <span class="rec-cli-txt">${esc(nomeDisp)}</span>
           <span class="rec-cli-caret">▾</span>
         </button>
         ${infoIconHtml}
         ${groupBadge}`;
    const reorderMod = (type === 'lead') ? 'rec-lead' : 'rec-client';
    const reorderAttrs = rowDragAttrs(reorderMod, r.id, cliAtivo, '');
    return `<tr data-rec="${type}-${r.id}" class="${isSim?'is-sim':''}${rowExtraCls}" style="--rc:${view.color}" ${reorderAttrs}>
      <td class="stk stk-1">
        <div class="rec-first-wrap${isSub?' is-sub':''}">
          ${rowHandleHtml()}
          ${firstColInner}
        </div>
      </td>
      <td class="stk stk-2">
        <button class="rec-pais-btn ${paisEmpty}" title="${esc(paisTitle)}"
                onclick="openPaisPicker('${type}',${r.id},this,event)">${paisDisp}</button>
      </td>
      ${ativoCell}
      <td class="stk stk-3">
        <select class="rec-tipo-select ${tipoCls}" style="${tipoStyle}"
                onchange="changeRecTipo('${type}',${r.id},this)">
          ${tipoOptions}
        </select>
      </td>
      <td class="stk stk-4">
        <input class="rec-projeto-input" type="text" value="${esc(r.projeto||'')}"
               placeholder="Descrição do projeto"
               onblur="saveRecField('${type}',${r.id},'projeto',this.value)">
      </td>
      <td class="stk stk-5">${'—'}</td>
      ${cells}
      <td style="text-align:center;padding:0 4px">
        <div class="rec-row-actions">
          <button class="rec-row-btn edit" onclick="editRecRow('${type}',${r.id})" title="Editar nome">
            <svg viewBox="0 0 24 24"><path d="M17 3a2.828 2.828 0 014 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
          </button>
          <button class="rec-row-btn addproj" onclick="addProjetoSameClient('${type}',${r.id})" title="Novo projeto para este cliente">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          </button>
          <button class="rec-row-btn dup" onclick="dupRecRow('${type}',${r.id})" title="Duplicar linha (cópia idêntica)">
            <svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          </button>
          <button class="rec-row-btn delete" onclick="delRecRow('${type}',${r.id})" title="Excluir linha">
            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
          </button>
        </div>
      </td>
    </tr>`;
  };

  const bodyC = document.getElementById('rec-body-clients');
  const bodyS = document.getElementById('rec-body-sep');
  const bodyL = document.getElementById('rec-body-leads');

  // Aplica filtros. País + ativo lidos do cliente (entidade global).
  // Órfãos (sem clienteId) são considerados "ativos" — não podem ser inativados.
  const isRowAtivo = r => {
    if(!r.clienteId) return true;
    const c = clienteOf(r);
    if(!c) return true;
    return c.ativo !== false;
  };
  const pass = r => {
    if(recFilterTipo && r.tipo !== recFilterTipo) return false;
    if(recFilterPais && clienteView(r).pais !== recFilterPais) return false;
    if(recFilterAtivo === 'ativos'   && !isRowAtivo(r)) return false;
    if(recFilterAtivo === 'inativos' &&  isRowAtivo(r)) return false;
    return true;
  };
  // Clientes passam pelo filtro; clientes inativos vão para o final da lista
  // mantendo a ordem original dentro de cada partição (estável).
  const clientsFiltered = d.clients.filter(pass);
  const clientsAtivos   = clientsFiltered.filter(r =>  isRowAtivo(r));
  const clientsInativos = clientsFiltered.filter(r => !isRowAtivo(r));
  const clientsVisible  = [...clientsAtivos, ...clientsInativos];
  const leadsVisible    = d.leads.filter(pass);

  const paisFiltroObj = recPaisByCode(recFilterPais);
  const filtrosAtivos = [];
  if(recFilterTipo) filtrosAtivos.push(`tipo "${recFilterTipo}"`);
  if(paisFiltroObj)  filtrosAtivos.push(`país ${paisFiltroObj.flag} ${paisFiltroObj.nome}`);
  if(recFilterAtivo === 'ativos')   filtrosAtivos.push('apenas ativos');
  if(recFilterAtivo === 'inativos') filtrosAtivos.push('apenas inativos');
  const emptyMsg = filtrosAtivos.length
    ? `Nenhum cliente com ${filtrosAtivos.join(' e ')} em ${recActiveYear}.`
    : `Nenhum cliente cadastrado em ${recActiveYear}. Clique em "Novo cliente" abaixo para começar.`;

  const groupsC = computeGroups(clientsVisible);
  const groupsL = computeGroups(leadsVisible);

  bodyC.innerHTML = clientsVisible.length
    ? clientsVisible.map((r,idx)=>renderRow(r,'client',groupsC[idx])).join('')
    : `<tr class="rec-empty-row"><td colspan="19">${emptyMsg}</td></tr>`;

  const simSubTxt = recIncluirSim
    ? 'leads projetados · <strong>entram</strong> no total do ano'
    : 'leads projetados · <strong>não entram</strong> no total do ano';
  bodyS.innerHTML = `<tr class="rec-sep-row">
    <td colspan="19">🔮 Simular <span class="sep-sub">· ${simSubTxt}</span></td>
  </tr>`;

  bodyL.innerHTML = leadsVisible.map((r,idx)=>renderRow(r,'lead',groupsL[idx])).join('');

  // Atualiza totais por linha (todos, não apenas visíveis — totais consideram tudo)
  for(const r of d.clients) updateRecRowTotal('client', r.id);
  for(const r of d.leads)   updateRecRowTotal('lead',   r.id);
  updateRecTotals();

  // Renderiza a barra de filtro (chips) dinamicamente
  renderRecTipoBar(clientsVisible.length + leadsVisible.length);
}

// Reorder Receita: 'client' reordena d.clients (respeita ativo/inativo),
// 'lead' reordena d.leads.
function reorderReceitaRow(type, srcId, dstId, placeAbove){
  const d = receita && receita.years && receita.years[recActiveYear];
  if(!d) return;
  const arr = type === 'lead' ? d.leads : d.clients;
  const src = arr.find(r => String(r.id) === String(srcId));
  const dst = arr.find(r => String(r.id) === String(dstId));
  if(!src || !dst) return;
  if(type === 'client'){
    const srcCli = clienteOf(src), dstCli = clienteOf(dst);
    const srcAt = srcCli ? (srcCli.ativo !== false) : true;
    const dstAt = dstCli ? (dstCli.ativo !== false) : true;
    if(srcAt !== dstAt) return;
  }
  if(arrayReorder(arr, src, dst, placeAbove)){
    receitaSave();
    renderReceita();
  }
}
ROW_REORDERERS['rec-client'] = (s, d, p) => reorderReceitaRow('client', s, d, p);
ROW_REORDERERS['rec-lead']   = (s, d, p) => reorderReceitaRow('lead',   s, d, p);

// Renderiza a barra de filtros da Receita (status ativos/inativos + tipo + país).
function renderRecTipoBar(visibleCount){
  const bar = document.getElementById('rec-filter-bar');
  if(!bar) return;
  const tipos = recTipos();
  const nomesValidos = new Set(tipos.map(t => t.nome));
  // Se o filtro aponta para um tipo que foi removido, limpa
  if(recFilterTipo && !nomesValidos.has(recFilterTipo)){
    recFilterTipo = '';
  }
  const d = receita.years[recActiveYear] || {clients:[],leads:[]};
  const todasLinhas = [...(d.clients||[]), ...(d.leads||[])];

  // ── Pill group Ativos/Inativos ──
  // Conta linhas de rows que respeitam os OUTROS filtros (tipo + país),
  // para que os contadores reflitam o universo visível atual.
  const preFilter = r => {
    if(recFilterTipo && r.tipo !== recFilterTipo) return false;
    if(recFilterPais && clienteView(r).pais !== recFilterPais) return false;
    return true;
  };
  const universo = todasLinhas.filter(preFilter);
  const isAtivo = r => {
    if(!r.clienteId) return true;
    const c = clienteOf(r);
    if(!c) return true;
    return c.ativo !== false;
  };
  const nTodos    = universo.length;
  const nAtivos   = universo.filter(isAtivo).length;
  const nInativos = universo.length - nAtivos;
  const cur = recFilterAtivo || 'all';
  const mkItem = (key, lbl, n) => `
