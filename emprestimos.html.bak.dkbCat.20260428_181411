function bdLoad(){
  try {
    const raw = localStorage.getItem(BD_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && typeof obj === 'object'){
        if(Array.isArray(obj.globalTags)) board.globalTags = obj.globalTags;
        if(Array.isArray(obj.cards)) board.cards = obj.cards;
        if(typeof obj.nCard === 'number') board.nCard = obj.nCard;
        if(typeof obj.nTag === 'number') board.nTag = obj.nTag;
      }
    }
  } catch(e){ console.warn('board load:', e); }
  // Migração: garante campos novos em cards antigos
  for(const c of board.cards){
    if(!Array.isArray(c.tagIds)) c.tagIds = [];
    if(c.priority == null) c.priority = 'media';
    if(c.col == null) c.col = 'backlog';
    if(c.deadline === undefined) c.deadline = null;
    if(c.valor === undefined) c.valor = null;
    if(c.tipoFin === undefined) c.tipoFin = null;
    if(c.responsavelPesId === undefined) c.responsavelPesId = null;
    if(c.responsavelNome === undefined) c.responsavelNome = '';
    if(c.moduloVinculado === undefined) c.moduloVinculado = null;
    if(!c.createdAt) c.createdAt = new Date().toISOString();
    if(c.doneAt === undefined) c.doneAt = null;
    if(!Array.isArray(c.subtasks)) c.subtasks = [];
    if(!Array.isArray(c.assignees)) c.assignees = [];
    if(!Array.isArray(c.attachments)) c.attachments = [];
    if(!Array.isArray(c.notes)) c.notes = [];
  }
}
function bdSave(){
  try { localStorage.setItem(BD_KEY, JSON.stringify(board)); }
  catch(e){ console.error('board save:', e); }
}
bdLoad();

function _bdFmt(n){ return (typeof fmtBRL === 'function') ? fmtBRL(n||0) : 'R$ ' + (n||0).toFixed(2); }
function _bdEsc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function _bdFmtData(s){
  if(!s) return '—';
  try { const [y,m,d] = s.split('-'); return d + '/' + m + '/' + String(y).slice(2); } catch(e){ return s; }
}
function _bdTag(id){ return board.globalTags.find(t => t.id === id) || null; }
function _bdTipo(id){ return BD_TIPOS.find(t => t.id === id) || null; }
function _bdModulo(id){ return BD_MODULOS.find(m => m.id === id) || null; }
function _bdResponsavelNome(c){
  if(c.responsavelPesId && typeof pessoas !== 'undefined' && pessoas && pessoas.people){
    const p = pessoas.people.find(p => p.id === c.responsavelPesId);
    if(p) return p.nome || '';
  }
  return c.responsavelNome || '';
}
function _bdDeadlineCls(s){
  if(!s) return '';
  try {
    const d = new Date(s + 'T23:59:59').getTime();
    const now = Date.now();
    const diffDays = (d - now) / 86400000;
    if(diffDays < 0) return 'bd-deadline-overdue';
    if(diffDays < 3) return 'bd-deadline-warn';
    return 'bd-deadline-ok';
  } catch(e){ return ''; }
}
function _bdFilteredCards(){
  let cs = board.cards.slice();
  const search = (document.getElementById('bd-search')?.value || '').toLowerCase().trim();
  if(search){
    cs = cs.filter(c => (c.name||'').toLowerCase().includes(search) ||
                        _bdResponsavelNome(c).toLowerCase().includes(search));
  }
  if(_bdFilters.pri) cs = cs.filter(c => c.priority === _bdFilters.pri);
  if(_bdFilters.tag) cs = cs.filter(c => (c.tagIds||[]).includes(_bdFilters.tag));

  return cs;
}

function bdSetView(v){
