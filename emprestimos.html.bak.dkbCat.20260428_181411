// Helper Fluxo: soma valores do outrasOp pra um mês, filtrando por catmap.dreLineId
function _flxOutrasOpMes(lineId, year, mIdx){
  if(!outrasOp || !outrasOp.valores) return 0;
  const view = (typeof flxView === 'string') ? flxView : 'drc';
  const ym = _outrasOpYM(year, mIdx);
  let tot = 0;
  for(const catId of Object.keys(outrasOp.valores)){
    const cat = (catmapData && Array.isArray(catmapData.categorias))
      ? catmapData.categorias.find(c => String(c.id) === String(catId)) : null;
    if(!cat) continue;
    const targetLine = (view === 'dre') ? cat.dreLineId : cat.drcLineId;
    if(targetLine !== lineId) continue;
    const v = outrasOp.valores[catId][ym];
    if(v) tot += parseFloat(v) || 0;
  }
  return tot;
}

