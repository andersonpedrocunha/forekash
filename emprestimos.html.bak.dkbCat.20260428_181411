// Picker de país para pessoas — espelha a UX do openPaisPicker da Receita.
function openPesPaisPicker(rid, btn, event){
  if(event) event.stopPropagation();
  closePaisPicker();
  const r = pesRegistry().find(x => x.id === rid);
  if(!r) return;
  const currentCode = r.nacionalidade || '';

  const pop = document.createElement('div');
  pop.className = 'rec-pais-pop';
  pop.id = 'pais-pop';

  const search = document.createElement('input');
  search.type = 'text';
  search.className = 'rec-pais-search';
  search.placeholder = 'Buscar país…';

  const list2 = document.createElement('div');
  list2.className = 'rec-pais-list';

  function render(filter){
    list2.innerHTML = '';
    const raw = (filter || '').trim();
    const f = _normStr(raw);

    // Opção "sem nacionalidade"
    const noneOpt = document.createElement('div');
    noneOpt.className = 'rec-pais-opt none' + (!currentCode ? ' selected' : '');
    noneOpt.innerHTML = '<span class="f">—</span><span>Sem nacionalidade</span>';
    noneOpt.onclick = (ev) => { ev.stopPropagation(); setPesNacionalidade(rid, ''); };
    if(!f) list2.appendChild(noneOpt);

    let matches = 0;
    const paises = recAllPaises();
    for(const p of paises){
      const okNome = _normStr(p.nome).includes(f);
      const okCode = (p.code || '').toLowerCase().includes(f);
      if(f && !okNome && !okCode) continue;
      matches++;
      const opt = document.createElement('div');
      opt.className = 'rec-pais-opt' + (currentCode === p.code ? ' selected' : '');
      opt.innerHTML = `<span class="f">${p.flag}</span><span>${esc(p.nome)}</span>`;
      opt.onclick = (ev) => { ev.stopPropagation(); setPesNacionalidade(rid, p.code); };
      list2.appendChild(opt);
    }

    // Sugestão "Adicionar X" (mesma lógica da Receita: dicionário ou genérico)
    if(raw){
      const suger = lookupPaisByName(raw);
      const jaExiste = suger && paises.some(p => p.code === suger.code);
      if(suger && !jaExiste){
        const add = document.createElement('div');
        add.className = 'rec-pais-opt add';
        add.innerHTML = `<span class="f">${suger.flag}</span><span>Adicionar ${esc(suger.nome)}</span>`;
        add.onclick = (ev) => {
          ev.stopPropagation();
          const novo = addPaisCustom(suger.nome);
          if(novo) setPesNacionalidade(rid, novo.code);
        };
        list2.appendChild(add);
      } else if(!suger && matches === 0){
        const add = document.createElement('div');
        add.className = 'rec-pais-opt add';
        add.innerHTML = `<span class="f">🌍</span><span>Adicionar "${esc(raw)}"</span>`;
        add.onclick = (ev) => {
          ev.stopPropagation();
          const novo = addPaisCustom(raw);
          if(novo) setPesNacionalidade(rid, novo.code);
        };
        list2.appendChild(add);
      }
    }
  }
  render('');
  search.addEventListener('input', () => render(search.value));
  search.addEventListener('keydown', e => {
    if(e.key === 'Escape'){ e.stopPropagation(); closePaisPicker(); }
  });
  pop.addEventListener('click', e => e.stopPropagation());

  pop.appendChild(search);
  pop.appendChild(list2);

  const rect = btn.getBoundingClientRect();
  pop.style.top  = Math.min(rect.bottom + 6, window.innerHeight - 340) + 'px';
  pop.style.left = Math.min(rect.left, window.innerWidth - 260) + 'px';
  // o card de detalhe da pessoa tem z-index alto — garante que o picker fique por cima
  pop.style.zIndex = 10100;
  document.body.appendChild(pop);
  setTimeout(() => {
    search.focus();
    document.addEventListener('click', closePaisPicker, {once: true});
  }, 40);
}

