    +   '<div class="ana-confirm-foot">'
    +     '<button type="button" class="ana-confirm-btn ana-confirm-btn-cancel" data-act="cancel">' + cfg.cancelText + '</button>'
    +     '<button type="button" class="ana-confirm-btn ana-confirm-btn-ok" data-act="ok">' + cfg.okText + '</button>'
    +   '</div>'
    + '</div>';
  document.body.appendChild(ov);
  const close = () => { try{ ov.remove(); }catch(e){} document.removeEventListener('keydown', escHandler, true); };
  const escHandler = (e) => {
    if(e.key === 'Escape'){ e.preventDefault(); close(); }
    else if(e.key === 'Enter'){ e.preventDefault(); close(); if(typeof onOk === 'function') onOk(); }
  };
  ov.addEventListener('click', (e) => {
    const t = e.target;
    if(t === ov){ close(); return; }
    const act = t.getAttribute && t.getAttribute('data-act');
    if(act === 'cancel'){ close(); }
    else if(act === 'ok'){ close(); if(typeof onOk === 'function') onOk(); }
  });
  document.addEventListener('keydown', escHandler, true);
  // Foco no OK pra acessibilidade + Enter
  setTimeout(() => {
    const okBtn = ov.querySelector('.ana-confirm-btn-ok');
    if(okBtn) okBtn.focus();
  }, 50);
}
