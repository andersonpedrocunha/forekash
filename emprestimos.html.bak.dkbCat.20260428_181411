// Quantas sub-colunas cada mês ocupa (1 valor + AV? + AH?)
function _flxSubCols(){ return 1 + (flxShowAV?1:0) + (flxShowAH?1:0); }
// True se pelo menos uma análise está ligada
function _flxHasAna(){ return flxShowAV || flxShowAH; }

// Célula de percentual (AV ou AH). num=null → '—'.
function _flxPctCell(num, cls){
  if(num === null || num === undefined || !Number.isFinite(num)){
    return '<td class="mes pct '+(cls||'')+'"><span class="flx-zero">—</span></td>';
  }
  const abs = Math.abs(num);
  const sign = num > 0.05 ? ' pct-pos' : (num < -0.05 ? ' pct-neg' : '');
  // Formata: 1 casa se abs<100, 0 casas se maior (evita '1.234,5%')
  const dec = abs < 100 ? 1 : 0;
  const txt = fmtBR(num, dec) + '%';
  return '<td class="mes pct '+(cls||'')+sign+'">'+txt+'</td>';
}
function _flxAVCell(val, recBase){
  if(!flxShowAV) return '';
  if(!Number.isFinite(val) || !Number.isFinite(recBase) || Math.abs(recBase) < 0.01){
    return _flxPctCell(null, 'pct-av');
  }
  return _flxPctCell(val / recBase * 100, 'pct-av');
}
function _flxAHCell(val, prev){
  if(!flxShowAH) return '';
  if(!Number.isFinite(val) || !Number.isFinite(prev) || Math.abs(prev) < 0.01){
    return _flxPctCell(null, 'pct-ah');
  }
  return _flxPctCell((val - prev) / Math.abs(prev) * 100, 'pct-ah');
}
// Bloco de colunas extras (AV/AH) pra um mês específico de uma linha analisada.
function _flxExtraCells(val, arrRow, mIdx, arrReceita){
  if(!_flxHasAna()) return '';
  const av = _flxAVCell(val, arrReceita[mIdx]);
  const prev = mIdx > 0 ? arrRow[mIdx-1] : null;
  const ah = _flxAHCell(val, prev);
  return av + ah;
}
// Célula de percentual para colunas agregadas (tot/med). Mesma lógica de
// _flxPctCell mas prefixo de classe diferente (mantém o border-left forte
// da coluna Total).
function _flxAggPctCell(num, colCls, pctCls){
  if(num === null || num === undefined || !Number.isFinite(num)){
    return '<td class="'+colCls+' pct '+(pctCls||'')+'"><span class="flx-zero">—</span></td>';
  }
  const abs = Math.abs(num);
  const sign = num > 0.05 ? ' pct-pos' : (num < -0.05 ? ' pct-neg' : '');
  const dec = abs < 100 ? 1 : 0;
  return '<td class="'+colCls+' pct '+(pctCls||'')+sign+'">'+fmtBR(num, dec)+'%</td>';
}
// AV/AH para a coluna Total/Média (acumulado do ano):
//   AV = valor_total_linha / receita_total_ano × 100
//   AH = não aplicável (não existe "ano anterior" neste agregado) → sempre '—'
function _flxExtraAggCells(val, arrReceita, colCls){
  if(!_flxHasAna()) return '';
  const recTot = arrReceita.reduce((a,b)=>a+b,0);
  const av = flxShowAV
    ? (Math.abs(recTot) < 0.01 || !Number.isFinite(val)
        ? _flxAggPctCell(null, colCls, 'pct-av')
        : _flxAggPctCell(val/recTot*100, colCls, 'pct-av'))
    : '';
  const ah = flxShowAH
    ? _flxAggPctCell(null, colCls, 'pct-ah')  // AH em agregado anual: '—'
    : '';
  return av + ah;
}

// ═══════════════════════════════════════════════════════════════════════════
// DEMONSTRATIVO — Drill-down (expandir/recolher linhas com detalhamento)
//   flxExpanded: Set com as chaves de linha atualmente abertas
//     valores possíveis: 'receita','folha','despesas','emprestimos','impostos'
//   flxToggleExpand(key): alterna e re-renderiza
// ═══════════════════════════════════════════════════════════════════════════
let flxExpanded = new Set();

function flxToggleExpand(key){
  if(flxExpanded.has(key)) flxExpanded.delete(key);
  else flxExpanded.add(key);
  renderFlxSheet();
}

// Botão de expand para colocar no stk-1 das linhas pais
function _flxExpandBtn(key){
  const open = flxExpanded.has(key);
  return '<button class="flx-expand'+(open?' open':'')+'"'
       + ' type="button"'
       + ' title="'+(open?'Recolher detalhamento':'Expandir detalhamento')+'"'
       + ' onclick="event.stopPropagation();flxToggleExpand(\''+key+'\')">'
       + '<svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>';
}

// Linha-filha genérica (label + 12 meses + total + média).
//   arrVals: 12 valores mensais
//   ctx:     { showAV, showAH, arrReceita, subCols, totalCols }  (opcional)
function _flxChildRow(label, arrVals, ctx){
  const sum = arrVals.reduce((a,b)=>a+b,0);
  const med = sum/12;
  const showAV = ctx && ctx.showAV;
  const showAH = ctx && ctx.showAH;
  const hasAna = showAV || showAH;
  const subCols = (ctx && ctx.subCols) ? ctx.subCols : 1;
  const cells = arrVals.map((v, m) => {
    const disp = (!v || v===0) ? '<span class="flx-zero">—</span>' : fmtBRL(v);
    const valCell = '<td class="mes">'+disp+'</td>';
    if(!hasAna) return valCell;
    const avTd = showAV
      ? _flxAVCell(v, ctx.arrReceita ? ctx.arrReceita[m] : NaN)
      : '';
    const ahTd = showAH
      ? _flxAHCell(v, m > 0 ? arrVals[m-1] : null)
      : '';
    return valCell + avTd + ahTd;
  }).join('');
  const totDisp = (!sum || sum===0) ? '<span class="flx-zero">—</span>' : fmtBRL(sum);
  const medDisp = (!med || med===0) ? '<span class="flx-zero">—</span>' : fmtBRL(med);
  // Linhas filhas são analisadas (mostram AV da própria receita), mas o total/média anual
  // segue a mesma convenção: AV = contribuição p/ receita do ano, AH = '—'
  const arrRec = (ctx && ctx.arrReceita) ? ctx.arrReceita : null;
  let totCell, medCell;
  if(hasAna && arrRec){
    totCell = '<td class="tot">'+totDisp+'</td>'+_flxExtraAggCells(sum, arrRec, 'tot');
    medCell = '<td class="med">'+medDisp+'</td>'+_flxExtraAggCells(med, arrRec, 'med');
  } else if(hasAna){
    totCell = '<td class="tot" colspan="'+subCols+'">'+totDisp+'</td>';
    medCell = '<td class="med" colspan="'+subCols+'">'+medDisp+'</td>';
  } else {
    totCell = '<td class="tot">'+totDisp+'</td>';
    medCell = '<td class="med">'+medDisp+'</td>';
  }
  return '<tr class="flx-child flx-no-check">'
       + '<td class="stk-1"><span class="flx-child-dot"></span>'+esc(label)+'</td>'
       + cells
       + totCell
       + medCell
       + '</tr>';
}
function _flxChildEmpty(msg, ctx){
  const total = (ctx && ctx.totalCols) ? ctx.totalCols : 15;
  return '<tr class="flx-child empty flx-no-check"><td class="stk-1" colspan="'+total+'">'+esc(msg||'Sem itens para detalhar.')+'</td></tr>';
}

// ─── RECEITA por cliente ───
// Replica a iteração de _flxAutoReceita por cliente.
function flxChildRowsReceita(year, ctx){
  if(!receita || !receita.years || !receita.years[year]){
    return [_flxChildEmpty('Sem dados de receita para '+year+'.', ctx)];
  }
  const clients = receita.years[year].clients || [];
  if(clients.length === 0) return [_flxChildEmpty('Nenhum cliente cadastrado em '+year+'.', ctx)];
  const out = [];
  for(const r of clients){
    const arr = new Array(12).fill(0);
    for(let m=0; m<12; m++){
      const c = r.meses && r.meses[REC_MESES[m]];
      if(c && c.valor !== '' && c.valor != null) arr[m] = parseFloat(c.valor) || 0;
    }
    if(arr.reduce((a,b)=>a+b,0) === 0) continue;
    out.push(_flxChildRow(r.nome || '(sem nome)', arr, ctx));
  }
  if(out.length === 0) return [_flxChildEmpty('Nenhum cliente com receita lançada em '+year+'.', ctx)];
  return out;
}

// ─── FOLHA por pessoa ───
// Replica _flxAutoFolha: pula p.sim e lê p.salarios[pesMesKey]
function flxChildRowsFolha(year, ctx){
  if(!pessoas || !Array.isArray(pessoas.people)){
    return [_flxChildEmpty('Sem dados de folha.', ctx)];
  }
  const out = [];
  for(const p of pessoas.people){
    if(p.sim) continue;
    const arr = new Array(12).fill(0);
    for(let m=0; m<12; m++){
      const k = pesMesKey(year, m);
      const v = p.salarios && p.salarios[k];
      if(v !== undefined && v !== '' && v != null) arr[m] = parseFloat(v) || 0;
    }
    if(arr.reduce((a,b)=>a+b,0) === 0) continue;
    const nome = p.nome || p.name || '(sem nome)';
    out.push(_flxChildRow(nome, arr, ctx));
  }
  if(out.length === 0) return [_flxChildEmpty('Nenhuma pessoa com salário em '+year+'.', ctx)];
  return out;
}

// ─── DESPESAS RECORRENTES agrupadas por TAG ───
// Soma estrutura.itens[].valores[estMesKey] agrupando por tagId; itens sem tag vão para "Sem tag".
function flxChildRowsDespesas(year, ctx){
  if(!estrutura || !Array.isArray(estrutura.itens)){
    return [_flxChildEmpty('Sem dados de estrutura de custos.', ctx)];
  }
  const tagsList = Array.isArray(estrutura.tags) ? estrutura.tags : [];
  // tagId -> { label, arr[12] }
  const byTag = new Map();
  for(const t of tagsList){
    byTag.set(t.id, { label: t.nome || '(sem nome)', arr: new Array(12).fill(0) });
  }
  byTag.set('__no_tag__', { label: 'Sem tag', arr: new Array(12).fill(0) });
  for(const it of estrutura.itens){
    const key = (it.tagId && byTag.has(it.tagId)) ? it.tagId : '__no_tag__';
    const ent = byTag.get(key);
    for(let m=0; m<12; m++){
      const k = estMesKey(year, m);
      const v = it.valores && it.valores[k];
      if(v !== undefined && v !== '' && v != null) ent.arr[m] += parseFloat(v) || 0;
    }
  }
  const out = [];
  // preserva a ordem das tags
  for(const t of tagsList){
    const ent = byTag.get(t.id);
    if(!ent) continue;
    if(ent.arr.reduce((a,b)=>a+b,0) === 0) continue;
    out.push(_flxChildRow(ent.label, ent.arr, ctx));
  }
  const noTag = byTag.get('__no_tag__');
  if(noTag && noTag.arr.reduce((a,b)=>a+b,0) > 0){
    out.push(_flxChildRow(noTag.label, noTag.arr, ctx));
  }
  // Comissões: adiciona linhas filhas (uma por vendedor ativo com algum valor)
  if(vendedores && Array.isArray(vendedores.lista)){
    for(const v of vendedores.lista){
      if(v.ativo === false) continue;
      const arr = new Array(12).fill(0);
      for(let m=0; m<12; m++) arr[m] = comissaoVendedorMes(v, year, m) || 0;
      if(arr.reduce((a,b)=>a+b,0) === 0) continue;
      out.push(_flxChildRow('💰 Comissão · ' + (v.nome||'(sem nome)'), arr, ctx));
    }
  }
  if(out.length === 0) return [_flxChildEmpty('Nenhuma despesa recorrente com valor em '+year+'.', ctx)];
  return out;
}

// ─── EMPRÉSTIMOS por contrato ───
// Totais consolidados do registro de um empréstimo num mês — SÓ quando o mês
// está EFETIVADO (via isMesEfetivado). Retorna null caso contrário.
// Usado como "fonte da verdade" pra propagar registros p/ DRE/DRC/Evolução.
function _flxRegEfetivadoTotais(loan, mesStr){
  if(!loan || !mesStr) return null;
  if(typeof isMesEfetivado !== 'function' || !isMesEfetivado(mesStr)) return null;
  const reg = (loan.registros||[]).find(r => r.mes === mesStr);
  if(!reg) return null;
  let parcela = 0, juros = 0, amort = 0;
  let hasParcela = false, hasJuros = false, hasAmort = false;
  if(reg.parcelaEfetivada !== '' && reg.parcelaEfetivada != null){
    parcela += parseFloat(reg.parcelaEfetivada) || 0; hasParcela = true;
  }
  if(reg.jurosEfetivado !== '' && reg.jurosEfetivado != null){
    juros += parseFloat(reg.jurosEfetivado) || 0; hasJuros = true;
  }
  if(reg.amortEfetivada !== '' && reg.amortEfetivada != null){
    amort += parseFloat(reg.amortEfetivada) || 0; hasAmort = true;
  }
  for(const ex of (reg.extras || [])){
    if(ex.parcela !== '' && ex.parcela != null){
      parcela += parseFloat(ex.parcela) || 0; hasParcela = true;
    }
    if(ex.juros !== '' && ex.juros != null){
      juros += parseFloat(ex.juros) || 0; hasJuros = true;
    }
    if(ex.amort !== '' && ex.amort != null){
      amort += parseFloat(ex.amort) || 0; hasAmort = true;
    }
  }
  const saldo = (reg.saldoEfetivado !== '' && reg.saldoEfetivado != null)
    ? (parseFloat(reg.saldoEfetivado) || 0) : null;
  return { parcela, juros, amort, saldo, hasParcela, hasJuros, hasAmort, hasSaldo: saldo != null };
}

// Replica a lógica por-empréstimo de _flxAutoEmprestimos (4 branches).
function _flxLoanParcelaMes(loan, year, mIdx){
  const today = new Date(); today.setDate(1); today.setHours(0,0,0,0);
  const cur = new Date(parseInt(year), mIdx, 1);
  const mesStr = year + '-' + String(mIdx+1).padStart(2,'0');
  const mDiff = (cur.getFullYear()-today.getFullYear())*12 + (cur.getMonth()-today.getMonth());
  const saldo   = parseFloat(loan.saldo)     || 0;
  const parcela = parseFloat(loan.parcelaVal)|| 0;
  const taxa    = parseFloat(loan.taxa)      || 0;
  const termino = loan.termino ? new Date(loan.termino+'T00:00:00') : null;
  // 1) Mês EFETIVADO — usa valores registrados (main + extras). Mês desefetivado
  //    volta a ser projeção mesmo que tenha valores preenchidos no Registro.
  const tot = _flxRegEfetivadoTotais(loan, mesStr);
  if(tot && tot.hasParcela) return tot.parcela;
  if(parcela === 0) return 0;
  if(termino && cur > termino) return 0;
  // Carência: se o empréstimo tem "início" definido e o mês alvo é ANTES desse início, parcela = 0
  if(loan.inicio){
    try {
      const inicioDate = new Date(loan.inicio + 'T00:00:00');
      // curDate é o 1º dia do mês alvo; inicioDate pode ser qualquer dia.
      // Comparamos o 1º dia do mês do início vs curDate.
      const inicioMes = new Date(inicioDate.getFullYear(), inicioDate.getMonth(), 1);
      if(cur < inicioMes) return 0;
    } catch(e){}
  }
  // 2) Mês atual → parcela informada
  if(mDiff === 0) return parcela;
  // 3) SAC → projeção
  if(typeof isSACEngine === 'function' && isSACEngine(loan.tipo) && parcela > 0 && saldo > 0){
    let amortConst = 0;
    if(termino){
      const mRest = (termino.getFullYear()-today.getFullYear())*12 + (termino.getMonth()-today.getMonth());
      amortConst = mRest > 0 ? saldo/(mRest+1) : Math.max(0, parcela - saldo*(taxa/100));
    } else {
      amortConst = Math.max(0, parcela - saldo*(taxa/100));
    }
    if(amortConst > 0){
      const saldoFut = Math.max(0, saldo - amortConst*mDiff);
      return saldoFut > 0 ? (amortConst + saldoFut*(taxa/100)) : 0;
    }
  }
  // 4) Price/custom → parcela fixa
  return parcela;
}

// ─── Split parcela em Juros × Amortização (para visão DRE) ───────────────
// Projeta o saldo do empréstimo do mês atual até o mês-alvo usando método Price
// (mesmo padrão para SAC na projeção — aproximação aceitável; SAC é calibrado
// pelo _flxLoanParcelaMes). Invariante: juros + amort = parcela do mês.
function _flxLoanSplitMes(loan, year, mIdx){
  const mesStr = year + '-' + String(mIdx+1).padStart(2,'0');
  // 1) Mês EFETIVADO com juros e/ou amort registrados → usa direto.
  //    Preserva invariante juros+amort=parcela quando ambos estão preenchidos.
  const tot = _flxRegEfetivadoTotais(loan, mesStr);
  if(tot && (tot.hasJuros || tot.hasAmort)){
    const pEf = tot.hasParcela ? tot.parcela : (tot.juros + tot.amort);
    // Completa a parte que faltar, se só um dos dois estiver preenchido
    const juros = tot.hasJuros ? tot.juros : Math.max(0, pEf - tot.amort);
    const amort = tot.hasAmort ? tot.amort : Math.max(0, pEf - tot.juros);
    return { juros, amort, parcela: pEf };
  }
  const parcela = _flxLoanParcelaMes(loan, year, mIdx);
  if(parcela === 0) return { juros:0, amort:0, parcela:0 };
  const saldoAtual = parseFloat(loan.saldo) || 0;
  const i = (parseFloat(loan.taxa) || 0) / 100;
  if(saldoAtual <= 0 || i <= 0){
    // Sem saldo informado ou sem taxa — não há juros projetáveis. Tudo vira amortização.
    return { juros:0, amort:parcela, parcela };
  }
  const today = new Date(); today.setDate(1); today.setHours(0,0,0,0);
  const cur = new Date(parseInt(year), mIdx, 1);
  const mDiff = (cur.getFullYear()-today.getFullYear())*12 + (cur.getMonth()-today.getMonth());
  // Projeta o saldo até o início do mês alvo.
  // Para meses passados (mDiff<0), usa saldo atual como aproximação conservadora
  // — não temos histórico de saldo por mês. Impacta só meses já pagos, e pro DRE
  // o que importa é a projeção forward.
  let bal = saldoAtual;
  if(mDiff > 0){
    for(let k=0; k<mDiff; k++){
      const j = bal * i;
      const a = Math.max(0, parcela - j);
      bal = Math.max(0, bal - a);
      if(bal <= 0) break;
    }
  }
  const juros = Math.min(parcela, bal * i);
  const amort = Math.max(0, parcela - juros);
  return { juros, amort, parcela };
}
// Soma juros de todos os empréstimos num mês.
function flxEmprestimosJurosMes(year, mIdx){
  if(!Array.isArray(loans)) return 0;
  let tot = 0;
  for(const l of loans) tot += _flxLoanSplitMes(l, year, mIdx).juros;
  return tot;
}
// Amortização = total_da_linha − juros calculado. Assim override em "Empréstimos"
// é absorvido pela amortização (preserva invariante juros+amort = total da linha).
function flxEmprestimosAmortMes(year, mIdx){
  const tot = flxEmprestimosMes(year, mIdx);
  const j = flxEmprestimosJurosMes(year, mIdx);
  return Math.max(0, tot - j);
}

// Nome de exibição de um empréstimo (banco + descrição quando possível).
function _flxLoanLabel(loan){
  let banco = '';
  try{
    const b = (typeof loanBancoResolve === 'function') ? loanBancoResolve(loan) : null;
    banco = (b && b.nome) || loan.bancoManual || loan.banco || '';
  }catch(e){ banco = loan.banco || loan.bancoManual || ''; }
  banco = (banco || '').toString().trim();
  const descr = (loan.descricao || '').toString().trim();
  if(banco && descr) return banco + ' — ' + descr;
  if(banco) return banco;
  if(descr) return descr;
  return 'Empréstimo #' + (loan.id || '?');
}

// ─── Saldo devedor ao FIM do mês (projeção forward + rewind estimado pro passado) ───
// Usa o mesmo método Price iterativo do _flxLoanSplitMes.
function flxLoanSaldoMes(loan, year, mIdx){
  const mesStr = year + '-' + String(mIdx+1).padStart(2,'0');
  // 1) Mês EFETIVADO com saldoEfetivado registrado → usa direto.
  const totM = _flxRegEfetivadoTotais(loan, mesStr);
  if(totM && totM.hasSaldo) return totM.saldo;

  const saldoAtual = parseFloat(loan.saldo) || 0;
  const taxa = parseFloat(loan.taxa) || 0;
  const parcela = parseFloat(loan.parcelaVal) || 0;
  const i = taxa / 100;
  const termino = loan.termino ? new Date(loan.termino+'T00:00:00') : null;

  const today = new Date(); today.setDate(1); today.setHours(0,0,0,0);
  const cur = new Date(parseInt(year), mIdx, 1);

  // 2) Se há um mês efetivado ANTES do alvo (com saldoEfetivado), ancora
  //    a projeção forward a partir dele — ignora o rewind histórico.
  let baseSaldo = saldoAtual;
  let baseDate = new Date(today);
  const anchor = (loan.registros || [])
    .filter(r => r && r.mes
             && typeof isMesEfetivado === 'function' && isMesEfetivado(r.mes)
             && r.saldoEfetivado !== '' && r.saldoEfetivado != null
             && new Date(r.mes+'-01T00:00:00') < cur)
    .sort((a,b) => b.mes.localeCompare(a.mes))[0];
  if(anchor){
    baseSaldo = parseFloat(anchor.saldoEfetivado) || 0;
    // Ponto de partida: 1º dia do MÊS SEGUINTE ao ancorado (saldo fim-de-mês → início do próximo)
    const ad = new Date(anchor.mes+'-01T00:00:00');
    baseDate = new Date(ad.getFullYear(), ad.getMonth()+1, 1);
  }

  const mDiffBase = (cur.getFullYear()-baseDate.getFullYear())*12 + (cur.getMonth()-baseDate.getMonth());

  if(mDiffBase < 0){
    // Alvo antes da base (só acontece sem ancora e com alvo no passado):
    // rewind a partir de saldoAtual, como antes.
    if(saldoAtual <= 0) return 0;
    const inicio = loan.inicio ? new Date(loan.inicio+'T00:00:00') : null;
    const inicioMes = inicio ? new Date(inicio.getFullYear(), inicio.getMonth(), 1) : null;
    let bal = saldoAtual;
    const mDiffToday = (cur.getFullYear()-today.getFullYear())*12 + (cur.getMonth()-today.getMonth());
    for(let k=0; k > mDiffToday; k--){
      const d = new Date(today.getFullYear(), today.getMonth() + k, 1);
      if(inicioMes && d < inicioMes){ continue; }
      const j = bal * i;
      const a = Math.max(0, parcela - j);
      bal += a;
    }
    return bal;
  }
  // Projeção forward a partir do ponto base (ancora efetivada ou hoje)
  if(baseSaldo <= 0) return 0;
  let bal = baseSaldo;
  const inicio = loan.inicio ? new Date(loan.inicio+'T00:00:00') : null;
  const inicioMes = inicio ? new Date(inicio.getFullYear(), inicio.getMonth(), 1) : null;
  for(let k=0; k <= mDiffBase; k++){
    const d = new Date(baseDate.getFullYear(), baseDate.getMonth() + k, 1);
    if(termino && d > termino) return 0;
    if(inicioMes && d < inicioMes){ continue; }
    if(parcela === 0) break;
    const j = bal * i;
    const a = Math.max(0, parcela - j);
    bal = Math.max(0, bal - a);
    if(bal === 0) return 0;
  }
  return bal;
}

// ═══════════════════════════════════════════════════════════════════════════
// EMPRÉSTIMOS — Aba Evolução (tabela loan × mês)
// ═══════════════════════════════════════════════════════════════════════════
let evoYear = String(new Date().getFullYear());
let evoMode = 'parcela';   // 'parcela' | 'saldo' | 'split'
const EVO_MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];

function setEvoYear(y){
  evoYear = String(y || new Date().getFullYear());
  renderEvoTable();
}
function setEvoMode(mode){
  if(!['parcela','saldo','split'].includes(mode)) return;
  evoMode = mode;
  document.querySelectorAll('.evo-mode-btn').forEach(b => b.classList.remove('is-on'));
  const el = document.getElementById('evo-mode-' + mode);
  if(el) el.classList.add('is-on');
  renderEvoTable();
}

// True se esse mês-alvo está no passado (antes do mês atual).
function _evoIsPast(year, mIdx){
  const today = new Date(); today.setDate(1); today.setHours(0,0,0,0);
  const cur = new Date(parseInt(year), mIdx, 1);
  return cur.getTime() < today.getTime();
}
// True se o mês está EFETIVADO E tem parcelaEfetivada (main ou extra) registrada.
// Usado pra diferenciar visualmente células "efetivadas" das projeções na aba Evolução.
function _evoHasRegistro(loan, year, mIdx){
  const mesStr = year + '-' + String(mIdx+1).padStart(2,'0');
  const tot = _flxRegEfetivadoTotais(loan, mesStr);
  return !!(tot && tot.hasParcela);
}

// Popula o <select> de ano com anos encontrados nos loans (termino, criação) + ano atual ± 2.
function _evoPopulateYearSelect(){
  const sel = document.getElementById('evo-year');
  if(!sel) return;
  const anoAtual = new Date().getFullYear();
  const anos = new Set();
  for(let y = anoAtual - 2; y <= anoAtual + 4; y++) anos.add(String(y));
  for(const l of (loans || [])){
    if(l.termino){
      const y = String(new Date(l.termino+'T00:00:00').getFullYear());
      anos.add(y);
    }
    for(const r of (l.registros || [])){
      if(r.mes) anos.add(r.mes.slice(0,4));
    }
  }
  const lista = Array.from(anos).sort();
  sel.innerHTML = lista.map(y => '<option value="'+y+'">'+y+'</option>').join('');
  if(!lista.includes(evoYear)) evoYear = String(anoAtual);
  sel.value = evoYear;
}

function renderEvoTable(){
  const thead = document.getElementById('evo-thead');
  const tbody = document.getElementById('evo-tbody');
  if(!thead || !tbody) return;
  _evoPopulateYearSelect();

  const year = evoYear;
  const lista = Array.isArray(loans) ? loans : [];
  const isSplit = (evoMode === 'split');

  // Head — split usa 2 linhas (mês com colspan + sub-headers J/A).
  if(isSplit){
    const topCols = EVO_MESES.map(m =>
      '<th class="mes mes-top" colspan="2">'+m.toUpperCase()+'/'+year.slice(2)+'</th>'
    ).join('');
    const botCols = EVO_MESES.map(() =>
      '<th class="mes-sub evo-j-hdr">Juros</th>'+
      '<th class="mes-sub evo-a-hdr">Amort.</th>'
    ).join('');
    thead.innerHTML = `<tr>
      <th class="stk-1" rowspan="2">Contrato</th>
      ${topCols}
      <th class="tot mes-top" colspan="2">Total Anual</th>
    </tr><tr>${botCols}<th class="tot mes-sub evo-j-hdr">Juros</th><th class="tot mes-sub evo-a-hdr">Amort.</th></tr>`;
  } else {
    const mesCols = EVO_MESES.map(m => '<th class="mes">'+m.toUpperCase()+'/'+year.slice(2)+'</th>').join('');
    thead.innerHTML = `<tr>
      <th class="stk-1">Descrição</th>
      ${mesCols}
      <th class="tot">Total ${evoMode === 'saldo' ? '(fim ano)' : 'anual'}</th>
    </tr>`;
  }

  if(lista.length === 0){
    const cols = isSplit ? (1 + 12*2 + 2) : 14;
    tbody.innerHTML = '<tr><td colspan="'+cols+'" class="evo-empty">Nenhum empréstimo cadastrado ainda. Adicione um na aba Empréstimos pra ver a evolução aqui.</td></tr>';
    return;
  }

  // Pré-calcula matriz (linha = loan, coluna = mês)
  const rows = []; // {loan, arr[12], total} (arr pode ser número ou {juros,amort,parcela} no split)
  const totPorMes = new Array(12).fill(0);
  const totJurosPorMes = new Array(12).fill(0);
  const totAmortPorMes = new Array(12).fill(0);
  let totAnual = 0;
  for(const l of lista){
    const arr = new Array(12).fill(0);
    if(evoMode === 'parcela'){
      for(let m=0; m<12; m++){
        arr[m] = _flxLoanParcelaMes(l, year, m);
        totPorMes[m] += arr[m];
      }
      const sum = arr.reduce((a,b)=>a+b,0);
      totAnual += sum;
      rows.push({ loan:l, arr, total:sum });
    } else if(evoMode === 'saldo'){
      for(let m=0; m<12; m++){
        arr[m] = flxLoanSaldoMes(l, year, m);
        totPorMes[m] += arr[m];
      }
      rows.push({ loan:l, arr, total: arr[11] });
    } else if(isSplit){
      for(let m=0; m<12; m++){
        const s = _flxLoanSplitMes(l, year, m);
        arr[m] = { juros: s.juros, amort: s.amort, parcela: s.parcela };
        totJurosPorMes[m] += s.juros;
        totAmortPorMes[m] += s.amort;
      }
      const sumJ = arr.reduce((a,b)=>a+b.juros,0);
      const sumA = arr.reduce((a,b)=>a+b.amort,0);
      rows.push({ loan:l, arr, totalJ:sumJ, totalA:sumA });
    }
  }
  if(evoMode === 'saldo') totAnual = totPorMes[11]; // saldo consolidado dez

  // Body
  let html = '';
  for(const r of rows){
    const label = _flxLoanLabel(r.loan);
    const cells = EVO_MESES.map((_, m) => {
      const pastHighlight = (_evoIsPast(year, m) && _evoHasRegistro(r.loan, year, m)) ? ' evo-past' : '';
      if(isSplit){
        const v = r.arr[m];
        if(!v || v.parcela === 0){
          return '<td class="mes evo-zero evo-j-cell'+pastHighlight+'">—</td>'+
                 '<td class="mes evo-zero evo-a-cell'+pastHighlight+'">—</td>';
        }
        return '<td class="mes evo-j-cell'+pastHighlight+'">'+fmtBRL(v.juros)+'</td>'+
               '<td class="mes evo-a-cell'+pastHighlight+'">'+fmtBRL(v.amort)+'</td>';
      }
      const v = r.arr[m];
      if(!v || v === 0) return '<td class="mes evo-zero'+pastHighlight+'">—</td>';
      return '<td class="mes'+pastHighlight+'">'+fmtBRL(v)+'</td>';
    }).join('');
    if(isSplit){
      html += '<tr class="evo-loan">'+
                '<td class="stk-1">'+esc(label)+'</td>'+
                cells+
                '<td class="tot evo-j-cell">'+fmtBRL(r.totalJ)+'</td>'+
                '<td class="tot evo-a-cell">'+fmtBRL(r.totalA)+'</td>'+
              '</tr>';
    } else {
      html += '<tr class="evo-loan">'+
                '<td class="stk-1">'+esc(label)+'</td>'+
                cells+
                '<td class="tot">'+fmtBRL(r.total)+'</td>'+
              '</tr>';
    }
  }
  // Linha total
  if(isSplit){
    const totCells = EVO_MESES.map((_, m) =>
      '<td class="mes evo-j-cell">'+fmtBRL(totJurosPorMes[m])+'</td>'+
      '<td class="mes evo-a-cell">'+fmtBRL(totAmortPorMes[m])+'</td>'
    ).join('');
    const totJ = totJurosPorMes.reduce((a,b)=>a+b,0);
    const totA = totAmortPorMes.reduce((a,b)=>a+b,0);
    html += '<tr class="evo-total">'+
              '<td class="stk-1">Total</td>'+
              totCells+
              '<td class="tot evo-j-cell">'+fmtBRL(totJ)+'</td>'+
              '<td class="tot evo-a-cell">'+fmtBRL(totA)+'</td>'+
            '</tr>';
  } else {
    const totCells = EVO_MESES.map((_, m) => '<td class="mes">'+fmtBRL(totPorMes[m])+'</td>').join('');
    html += '<tr class="evo-total">'+
              '<td class="stk-1">Total</td>'+
              totCells+
              '<td class="tot">'+fmtBRL(totAnual)+'</td>'+
            '</tr>';
  }
  tbody.innerHTML = html;
}

function flxChildRowsEmprestimos(year, ctx){
  if(!Array.isArray(loans) || loans.length === 0){
    return [_flxChildEmpty('Nenhum empréstimo cadastrado.', ctx)];
  }
  const out = [];
  for(const l of loans){
    const arr = new Array(12).fill(0);
    for(let m=0; m<12; m++) arr[m] = _flxLoanParcelaMes(l, year, m);
    if(arr.reduce((a,b)=>a+b,0) === 0) continue;
    out.push(_flxChildRow(_flxLoanLabel(l), arr, ctx));
  }
  if(out.length === 0) return [_flxChildEmpty('Nenhum empréstimo com parcela em '+year+'.', ctx)];
  return out;
}

// ─── IMPOSTOS por rubrica ───
// Replica _flxAutoImpostos: itera impostos.correntes e lê valores[YYYY-MM].
//   natFilter: 'deducao' | 'despesa' | null (null = todas)
//   → filtra rubricas pela classificação automática de _flxImpostoNatureza
function flxChildRowsImpostos(year, ctx, natFilter){
  if(typeof impostos === 'undefined' || !impostos || !Array.isArray(impostos.correntes)){
    return [_flxChildEmpty('Sem dados de impostos.', ctx)];
  }
  const out = [];
  for(const c of impostos.correntes){
    if(!c) continue;
    const rub = (typeof impRubrica === 'function') ? impRubrica(c.rubricaId) : null;
    if(natFilter){
      const nat = _flxImpostoNatureza(rub || { id: c.rubricaId });
      if(nat !== natFilter) continue;
    }
    const arr = new Array(12).fill(0);
    for(let m=0; m<12; m++){
      const k = year + '-' + String(m+1).padStart(2,'0');
      const v = c.valores && c.valores[k];
      if(v !== undefined && v !== '' && v != null) arr[m] = parseFloat(v) || 0;
    }
    if(arr.reduce((a,b)=>a+b,0) === 0) continue;
    const label = (rub && rub.nome) || c.rubricaId || '(sem rubrica)';
    out.push(_flxChildRow(label, arr, ctx));
  }
  if(out.length === 0){
    const msg = natFilter === 'despesa' ? 'Nenhuma Despesa Tributária (IRPJ/CSLL) em '+year+'.'
              : natFilter === 'deducao' ? 'Nenhuma dedução de receita (ISS, PIS, COFINS…) em '+year+'.'
              : 'Nenhum imposto com valor em '+year+'.';
    return [_flxChildEmpty(msg, ctx)];
  }
  return out;
}

// ─── PARCELAMENTO DE IMPOSTOS por parcelamento ───
// Cada parcelamento ativo vira uma linha filha com a parcela mensal do ano.
function flxChildRowsImpParcelamentos(year, ctx){
  if(typeof impostos === 'undefined' || !impostos || !Array.isArray(impostos.parcelamentos)){
    return [_flxChildEmpty('Nenhum parcelamento cadastrado.', ctx)];
  }
  const out = [];
  for(const p of impostos.parcelamentos){
    if(!p || p.ativo === false) continue;
    const arr = new Array(12).fill(0);
    for(let m=0; m<12; m++){
      const ym = year + '-' + String(m+1).padStart(2,'0');
      try { arr[m] = impParcelaDoMes(p, ym) || 0; } catch(e){}
    }
    if(arr.reduce((a,b)=>a+b,0) === 0) continue;
    const label = p.nome || '(sem nome)';
    out.push(_flxChildRow(label, arr, ctx));
  }
  if(out.length === 0) return [_flxChildEmpty('Nenhum parcelamento com parcela em '+year+'.', ctx)];
  return out;
}

function renderFlxSheet(){
  const thead = document.getElementById('flx-thead');
  const tbody = document.getElementById('flx-tbody');
  if(!thead || !tbody) return;
  // Garante que o catmap está populado antes de o Fluxo consultar (boot once).
  // Se o user nunca abriu Customizações → Categorias, catmapData fica vazio e
  // os helpers _flxCatmap* retornam null pra tudo, anulando o efeito.
  try {
    if(typeof catmapData !== 'undefined' && Array.isArray(catmapData.categorias)
       && catmapData.categorias.length === 0
       && typeof _catmapMergeDiscovered === 'function'){
      _catmapMergeDiscovered();
    }
  } catch(e){ console.warn('flx/catmap-autoinit:', e); }
  const year = flxActiveYear;

  // Modo de análise (AV/AH) — altera thead e largura das células mensais
  const hasAna  = _flxHasAna();
  const subCols = _flxSubCols();              // 1, 2 ou 3
  const totalCols = 1 + 12*subCols + 2*subCols;  // Total/Média também ganham subCols quando hasAna

  // HEAD
  if(hasAna){
    // 2 linhas: nomes dos meses + Total + Média (todos com colspan) → sub-rótulos R$/AV/AH
    const subHeader = () => {
      const parts = ['<th class="mes-sub val">R$</th>'];
      if(flxShowAV) parts.push('<th class="mes-sub pct-av">AV</th>');
      if(flxShowAH) parts.push('<th class="mes-sub pct-ah">AH</th>');
      return parts.join('');
    };
    const top = FLX_MESES.map(m =>
      `<th class="mes mes-top" colspan="${subCols}">${m.toUpperCase()}</th>`
    ).join('');
    const bot = FLX_MESES.map(subHeader).join('');
    thead.innerHTML = `<tr>
      <th class="stk-1" rowspan="2">Descrição</th>
      ${top}
      <th class="tot mes-top" colspan="${subCols}">Total</th>
      <th class="med mes-top" colspan="${subCols}">Média</th>
    </tr><tr>${bot}${subHeader()}${subHeader()}</tr>`;
  } else {
    const mesCols = FLX_MESES.map(m => `<th class="mes">${m.toUpperCase()}</th>`).join('');
    thead.innerHTML = `<tr>
      <th class="stk-1">Descrição</th>
      ${mesCols}
      <th class="tot">Total</th>
      <th class="med">Média</th>
    </tr>`;
  }

  // Pré-calcula arrays mensais (bases)
  const arrReceita = [], arrFolha = [], arrDesp = [], arrEmp = [], arrImp = [],
        arrCred = [], arrOutras = [], arrOutrasDesp = [];
  for(let m=0;m<12;m++){
    arrReceita.push(flxReceitaMes(year,m));
    arrFolha.push(flxFolhaMes(year,m));
    arrDesp.push(flxDespesasMes(year,m));
    arrEmp.push(flxEmprestimosMes(year,m));
    arrImp.push(flxImpostoMes(year,m));
    arrCred.push(flxCreditoMes(year,m));
    arrOutras.push(flxOutrasMes(year,m));
    arrOutrasDesp.push(flxOutrasDespMes(year,m));
  }
  // Catmap → DRC: items de estrutura mapeados pra outras linhas migram.
  // Atua antes do hide pra que o usuário consiga ocultar 'despesas' sem perder
  // os items que já foram realocados via catmap pra outras linhas.
  if(typeof _flxCatmapEstruturaPara === 'function' && flxView !== 'dre'){
    for(let m=0;m<12;m++){
      const catFolha = _flxCatmapEstruturaPara('folha', year, m);
      const catEmp   = _flxCatmapEstruturaPara('emprestimos', year, m);
      const catImp   = _flxCatmapEstruturaPara('impostos', year, m);
      if(catFolha) arrFolha[m] = (arrFolha[m] || 0) + catFolha;
      if(catEmp)   arrEmp[m]   = (arrEmp[m]   || 0) + catEmp;
      if(catImp)   arrImp[m]   = (arrImp[m]   || 0) + catImp;
    }
  }
  // Aplica "hide = excluir dos totais" para a vista atual:
  //   se o usuário escondeu a linha X, o array X vira zero pra esta render.
  //   A receita NÃO pode ser escondida (é a base).
  // Parcelamento de impostos — total pago, juros pagos e principal amortizado por mês
  const arrImpParc = [], arrImpParcJuros = [], arrImpParcPrincipalMes = [];
  for(let m=0;m<12;m++){
    arrImpParc.push(flxImpParcelamentoMes(year, m));
    arrImpParcJuros.push(flxImpParcelamentoJurosMes(year, m));
    arrImpParcPrincipalMes.push(flxImpParcelamentoPrincipalMes(year, m));
  }
  const _hideZero = (arr, id) => { if(flxIsHidden(flxView, id)){ for(let m=0;m<12;m++) arr[m] = 0; } };
  _hideZero(arrFolha,       'folha');
  _hideZero(arrDesp,        'despesas');
  _hideZero(arrEmp,         'emprestimos');
  _hideZero(arrImp,         flxView === 'dre' ? 'deducoes' : 'impostos');  // em DRE, id do imposto s/ vendas é 'deducoes'
  _hideZero(arrCred,        'creditoAlv');
  _hideZero(arrOutras,      'outrasRec');
  _hideZero(arrOutrasDesp,  'outrasDesp');
  // Esconder parcImpostos zera o total, juros e principal (pra não inflar arrJuros/Ajustes)
  if(flxIsHidden(flxView, 'parcImpostos')){
    for(let m=0;m<12;m++){ arrImpParc[m] = 0; arrImpParcJuros[m] = 0; arrImpParcPrincipalMes[m] = 0; }
  }
  // Contribuições de linhas custom por seção (sinal já aplicado):
  //   '+' adiciona ao caixa, '-' subtrai.
  // Em "Custos Operacionais" e "Resultado Financeiro", sinal '-' reduz resultado
  // (vira mais despesa); sinal '+' aumenta (receita extra na seção).
  const arrCustCustosOp = [], arrCustFinan = [], arrCustAjustes = [];
  for(let m=0;m<12;m++){
    arrCustCustosOp.push(flxCustomSecaoMes('custos_op',     year, m));
    arrCustFinan.push   (flxCustomSecaoMes('financeiro',    year, m));
    arrCustAjustes.push (flxCustomSecaoMes('ajustes_caixa', year, m));
  }

  // Derivadas (considerando todas as contribuições custom)
  const arrCusto = [], arrResult = [], arrSaldoMes = [];
  for(let m=0;m<12;m++){
    // Sinal '-' em custo → custom é -v → subtrair -v adiciona v ao custo.
    // Parcelamentos de impostos entram no caixa (principal + juros) — reduzem Resultado.
    arrCusto.push(arrFolha[m]+arrDesp[m]+arrEmp[m]+arrImp[m]+arrImpParc[m]
                  - arrCustCustosOp[m] - arrCustFinan[m]);
    arrResult.push(arrReceita[m]-arrCusto[m]);
    arrSaldoMes.push(arrResult[m] + arrCred[m] + arrOutras[m] - arrOutrasDesp[m]
                     + arrCustAjustes[m]);
  }
  // Saldo Final (running) respeita o mês de ancoragem do saldo inicial.
  // Meses anteriores ao mês de ancoragem ficam vazios (null) — antes disso
  // o saldo ainda não é declarado. A partir do mês âncora, roda como:
  //   acc_âncora = saldoInicial + saldoMes[âncora]
  //   acc_m      = acc_{m-1}    + saldoMes[m]    (m > âncora)
  const saldoIni = flxSaldoInicialVal(year);
  const siMes    = flxSaldoInicialMesVal(year);
  const arrSaldoFinal = [], arrSaldoAcum = [];
  let acc = saldoIni;
  let resAcc = 0;
  for(let m=0;m<12;m++){
    if(m < siMes){
      arrSaldoFinal.push(null); // antes da âncora: sem saldo projetado
    } else {
      acc += arrSaldoMes[m];
      arrSaldoFinal.push(acc);
    }
    resAcc += arrResult[m];
    arrSaldoAcum.push(resAcc);
  }

  // Helpers de linha.
  // rowKey: ativa check de confirmação por célula (✓ sutil).
  // pullable: true = cada célula é editável (input com placeholder = valor auto puxado).
  //           false = célula read-only (só mostra o valor agregado/derivado).
  // rowDerived
  //   analyze=true  → se hasAna, adiciona sub-células AV/AH pro mês (base=arrReceita)
  //   analyze=false → se hasAna, a célula do mês recebe colspan=subCols
  const rowDerived = (label, arr, rowClass, dot, opts, rowKey, pullable, expandKey, analyze) => {
    const sum = arr.reduce((a,b)=>a+b,0);
    const med = sum/12;
    const cells = arr.map((v, m) => {
      const conf = rowKey && flxIsConfirmed(year, rowKey, m);
      const inner = (rowKey && pullable)
        ? _flxManualCell(year, rowKey, m)
        : _flxCell(v, opts);
      const checkBtn = rowKey ? _flxCheckBtn(year, rowKey, m) : '';
      const tdCls = 'mes' + (conf ? ' flx-confirmed' : '');
      if(hasAna && analyze){
        const extra = _flxExtraCells(v, arr, m, arrReceita);
        return `<td class="${tdCls}">${inner}${checkBtn}</td>${extra}`;
      } else if(hasAna){
        return `<td class="${tdCls}" colspan="${subCols}">${inner}${checkBtn}</td>`;
      } else {
        return `<td class="${tdCls}">${inner}${checkBtn}</td>`;
      }
    }).join('');
    // Total e Média — quando hasAna, seguem a mesma regra das mensais:
    // linhas analisadas recebem AV (= % da receita anual) e AH (sempre '—' em agregado);
    // linhas não analisadas usam colspan.
    let totCell, medCell;
    if(hasAna && analyze){
      totCell = `<td class="tot">${_flxCell(sum, opts)}</td>${_flxExtraAggCells(sum, arrReceita, 'tot')}`;
      medCell = `<td class="med">${_flxCell(med, opts)}</td>${_flxExtraAggCells(med, arrReceita, 'med')}`;
    } else if(hasAna){
      totCell = `<td class="tot" colspan="${subCols}">${_flxCell(sum, opts)}</td>`;
      medCell = `<td class="med" colspan="${subCols}">${_flxCell(med, opts)}</td>`;
    } else {
      totCell = `<td class="tot">${_flxCell(sum, opts)}</td>`;
      medCell = `<td class="med">${_flxCell(med, opts)}</td>`;
    }
    const dotSpan = dot ? `<span class="flx-dot ${dot}"></span>` : '';
    const expBtn = expandKey ? _flxExpandBtn(expandKey) : '';
    const expCls = (expandKey && flxExpanded.has(expandKey)) ? 'flx-expanded' : '';
    const trCls = [rowClass||'', (rowKey && pullable)?'editable':'', rowKey?'':'flx-no-check', expCls].filter(Boolean).join(' ');
    return `<tr class="${trCls}">
      <td class="stk-1">${expBtn}${dotSpan}${label}</td>
      ${cells}
      ${totCell}
      ${medCell}
    </tr>`;
  };
  // Editáveis sem auto-pull (Crédito, Outras) — valor único, sem fonte de puxar.
  //   Quando hasAna, cada célula de mês usa colspan=subCols (linhas não analisadas).
  const rowEditable = (label, field, arr, rowClass, dot, rowKey) => {
    const sum = arr.reduce((a,b)=>a+b,0);
    const med = sum/12;
    const span = hasAna ? ` colspan="${subCols}"` : '';
    const cells = FLX_MESES.map((_,m)=>{
      const raw = (((fluxo.inputs||{})[year]||{})[field]||{})[m];
      const inp = _flxInpCell(year, m, field==='impostos'?'Imposto':(field==='creditoAlv'?'Credito':(field==='outrasDesp'?'OutrasDesp':'Outras')), raw);
      const conf = rowKey && flxIsConfirmed(year, rowKey, m);
      const checkBtn = rowKey ? _flxCheckBtn(year, rowKey, m) : '';
      const tdCls = 'mes' + (conf ? ' flx-confirmed' : '');
      return `<td class="${tdCls}"${span}>${inp}${checkBtn}</td>`;
    }).join('');
    const dotSpan = dot ? `<span class="flx-dot ${dot}"></span>` : '';
    const trCls = ['editable', rowClass||'', rowKey?'':'flx-no-check'].filter(Boolean).join(' ');
    // Total/Média: linhas editáveis não são analisadas → usam colspan quando hasAna
    const totCell = hasAna ? `<td class="tot" colspan="${subCols}">${_flxCell(sum)}</td>`
                           : `<td class="tot">${_flxCell(sum)}</td>`;
    const medCell = hasAna ? `<td class="med" colspan="${subCols}">${_flxCell(med)}</td>`
                           : `<td class="med">${_flxCell(med)}</td>`;
    return `<tr class="${trCls}">
      <td class="stk-1">${dotSpan}${label}</td>
      ${cells}
      ${totCell}
      ${medCell}
    </tr>`;
  };

  // Monta corpo da planilha — a estrutura depende de flxView ('drc' | 'dre')
  let html = '';

  // Contexto passado pras filhas: permite renderizar AV/AH também no detalhamento.
  const childCtx = { showAV: flxShowAV, showAH: flxShowAH, arrReceita, subCols, totalCols };

  // Helpers: OP = prefixo (+/−/=); L = label com override; H = hidden pra vista atual
  const OP = (sym, txt) => '<span class="flx-op">'+sym+'</span>'+txt;
  const L = (id, def) => flxLabel(flxView, id, def);
  const H = (id) => flxIsHidden(flxView, id);

  // Render genérico de linha custom editável mês a mês.
  //   isSub=true  → estilo sub (indentada, ex: dentro de Gasto Total)
  //   isSub=false → estilo flat (ex: Ajustes de Caixa)
  const _flxRenderCustomRow = (c, opts) => {
    const isSub = !!(opts && opts.isSub);
    const arr = [];
    for(let m=0;m<12;m++) arr.push(flxCustomValMes(c.id, year, m));
    const sum = arr.reduce((a,b)=>a+b,0);
    const med = sum/12;
    const sinalCls = (c.sinal === '-') ? 'flx-outras-desp' : 'flx-outras-rec';
    const dot      = (c.sinal === '-') ? 'saida' : 'entrada';
    const span = hasAna ? ` colspan="${subCols}"` : '';
    const cells = FLX_MESES.map((_, m) => {
      const v = arr[m];
      const valStr = (!v || v===0) ? '' : fmtBR(v);
      const inp = '<input class="flx-inp" type="text" value="'+esc(valStr)+'"'+
                  ' placeholder="0,00"'+
                  ' onblur="flxSetCustomVal(\''+esc(c.id)+'\',\''+year+'\','+m+',this.value)"'+
                  ' onkeydown="if(event.key===\'Enter\'){event.preventDefault();this.blur();}">';
      return '<td class="mes"'+span+'>'+inp+'</td>';
    }).join('');
    // sub rows dentro de Gasto Total: usa classe 'sub'; ajustes flat: usa sinalCls
    const baseCls = isSub ? 'sub' : sinalCls;
    const trCls = ['editable', baseCls, 'flx-no-check', 'flx-custom'].filter(Boolean).join(' ');
    const totCell = hasAna ? '<td class="tot" colspan="'+subCols+'">'+_flxCell(sum)+'</td>'
                           : '<td class="tot">'+_flxCell(sum)+'</td>';
    const medCell = hasAna ? '<td class="med" colspan="'+subCols+'">'+_flxCell(med)+'</td>'
                           : '<td class="med">'+_flxCell(med)+'</td>';
    const dotSpan = '<span class="flx-dot '+dot+'"></span>';
    const prefix = (c.sinal === '-') ? '(−)' : '(+)';
    // DRE usa prefixo (+)/(−) pra reforçar sinal; DRC em ajustes fica flat com só nome
    const labelHtml = (flxView === 'dre' || isSub)
      ? OP(prefix, esc(c.nome))
      : esc(c.nome);
    return '<tr class="'+trCls+'" data-custom-id="'+esc(c.id)+'">'+
             '<td class="stk-1">'+labelHtml+dotSpan+'</td>'+
             cells+
             totCell+
             medCell+
           '</tr>';
  };
  // Helper: emite todas as linhas custom de uma seção
  const _emitCustomSec = (secao, isSub) => {
    let out = '';
    for(const c of flxCustomLines(secao)) out += _flxRenderCustomRow(c, { isSub: !!isSub });
    return out;
  };

  if(flxView === 'dre'){
    // ═══════════════════ DRE gerencial ═══════════════════
    // Impostos: split automático por natureza (rubricas IRPJ/CSLL → Despesa
    // Tributária, sobem depois do LAIR; demais → Dedução da Receita).
    // Empréstimos: juros separados da amortização (amort cai em Ajustes de Caixa).
    // Juros Financeiros = juros de empréstimos + juros pagos dos parcelamentos.
    // Split dos parcelamentos já calculado em arrays: arrImpParcJuros (= jurosPago)
    // e arrImpParcPrincipalMes (= amortização real). Invariante: juros+principal=parcela.
    const arrJuros = [], arrJurosEmp = [], arrJurosImpParc = [], arrAmort = [];
    const arrImpDed = [], arrImpDes = [];
    const arrImpParcPrincipal = [];  // principal dos parcelamentos (cash — Ajustes de Caixa)
    for(let m=0;m<12;m++){
      const jEmp = flxEmprestimosJurosMes(year, m);
      arrJurosEmp.push(jEmp);
      arrJurosImpParc.push(arrImpParcJuros[m]);
      // Catmap pode rotear estrutura.itens pra 'juros' (ex: tag "Juros bancários")
      const catJuros = (typeof _flxCatmapEstruturaPara === 'function') ? _flxCatmapEstruturaPara('juros', year, m) : 0;
      arrJuros.push(jEmp + arrImpParcJuros[m] + catJuros);
      arrAmort.push(Math.max(0, arrEmp[m] - jEmp));
      arrImpParcPrincipal.push(arrImpParcPrincipalMes[m]);
      const s = flxImpostoSplitMes(year, m);
      // Catmap pode rotear estrutura.itens pra 'deducoes' ou 'despesasTrib'
      const catDed = (typeof _flxCatmapEstruturaPara === 'function') ? _flxCatmapEstruturaPara('deducoes', year, m) : 0;
      const catDes = (typeof _flxCatmapEstruturaPara === 'function') ? _flxCatmapEstruturaPara('despesasTrib', year, m) : 0;
      arrImpDed.push(s.deducao + catDed);
      arrImpDes.push(s.despesa + catDes);
    }
    // Catmap pode rotear estrutura.itens pra 'folha' — soma em arrFolha (DRE)
    if(typeof _flxCatmapEstruturaPara === 'function'){
      for(let m=0;m<12;m++){
        const catFolha = _flxCatmapEstruturaPara('folha', year, m);
        if(catFolha) arrFolha[m] = (arrFolha[m] || 0) + catFolha;
      }
    }
    // "Deduções" (rowId='deducoes' no DRE) pode estar hidden → zera pra não afetar Receita Líquida
    if(H('deducoes')){ for(let m=0;m<12;m++) arrImpDed[m] = 0; }
    if(H('despesasTrib')){ for(let m=0;m<12;m++) arrImpDes[m] = 0; }
    if(H('juros')){ for(let m=0;m<12;m++){ arrJuros[m] = 0; arrJurosEmp[m] = 0; arrJurosImpParc[m] = 0; } }
    if(H('amortizacao')){ for(let m=0;m<12;m++) arrAmort[m] = 0; }
    const arrRecLiq   = arrReceita.map((v,m) => v - arrImpDed[m]);
    const arrEbitda   = arrRecLiq.map((v,m) => v - arrFolha[m] - arrDesp[m]);
    const arrLAIR     = arrEbitda.map((v,m) => v - arrJuros[m]);
    const arrLucroLiq = arrLAIR.map((v,m) => v - arrImpDes[m]);

    // (+) RECEITA BRUTA
    html += rowDerived(OP('(+)', L('receita','Receita Bruta')), arrReceita, 'hd-receita', 'receita', null, 'receita', true, 'receita', true);
    if(flxExpanded.has('receita')) html += flxChildRowsReceita(year, childCtx).join('');

    // (−) DEDUÇÕES DA RECEITA
    if(!H('deducoes')){
      html += rowDerived(OP('(−)', L('deducoes','Deduções da Receita')), arrImpDed, 'sub', 'imp', null, 'impostos', false, 'impostos-ded', true);
      if(flxExpanded.has('impostos-ded')) html += flxChildRowsImpostos(year, childCtx, 'deducao').join('');
    }

    // (=) RECEITA LÍQUIDA
    if(!H('receitaLiquida')) html += rowDerived(OP('(=)', L('receitaLiquida','Receita Líquida')), arrRecLiq, 'hd-rec-liq', null, null, null, false, null, true);

    // Recalcula EBITDA e LAIR com contribuições de linhas custom (custos_op + financeiro)
    for(let m=0;m<12;m++){
      arrEbitda[m] = arrRecLiq[m] - arrFolha[m] - arrDesp[m] + arrCustCustosOp[m];
      arrLAIR[m]   = arrEbitda[m] - arrJuros[m] + arrCustFinan[m];
      arrLucroLiq[m] = arrLAIR[m] - arrImpDes[m];
    }

    // (−) CUSTOS OPERACIONAIS
    if(!H('folha')){
      html += rowDerived(OP('(−)', L('folha','Custos com Pessoal (Folha)')), arrFolha, 'sub', 'folha', null, 'folha', true, 'folha', true);
      if(flxExpanded.has('folha')) html += flxChildRowsFolha(year, childCtx).join('');
    }
    if(!H('despesas')){
      html += rowDerived(OP('(−)', L('despesas','Despesas Recorrentes')), arrDesp, 'sub', 'desp', null, 'despesas', true, 'despesas', true);
      if(flxExpanded.has('despesas')) html += flxChildRowsDespesas(year, childCtx).join('');
    }
    // Linhas custom de Custos Operacionais (sub-rows com OP prefix)
    html += _emitCustomSec('custos_op', true);

    // (=) EBITDA
    if(!H('ebitda')) html += rowDerived(OP('(=)', L('ebitda','EBITDA')), arrEbitda, 'hd-ebitda', null, {colorize:true}, null, false, null, true);

    // (−) JUROS FINANCEIROS (expansível — abre em Empréstimos + Parcelamento de Impostos)
    if(!H('juros')){
      html += rowDerived(OP('(−)', L('juros','Juros Financeiros')), arrJuros, 'sub', 'emp', null, null, false, 'juros', true);
      if(flxExpanded.has('juros')){
        html += _flxChildRow('Juros de Empréstimos', arrJurosEmp, childCtx);
        html += _flxChildRow('Juros de Parcelamento de Impostos', arrJurosImpParc, childCtx);
      }
    }
    // Linhas custom de Resultado Financeiro (sub-rows entre Juros e LAIR)
    html += _emitCustomSec('financeiro', true);

    // (=) LAIR
    if(!H('lair')) html += rowDerived(OP('(=)', L('lair','Lucro Antes do IR (LAIR)')), arrLAIR, 'hd-result', null, {colorize:true}, null, false, null, true);

    // (−) DESPESAS TRIBUTÁRIAS
    if(!H('despesasTrib')){
      html += rowDerived(OP('(−)', L('despesasTrib','Despesas Tributárias (IRPJ, CSLL)')), arrImpDes, 'sub', 'imp', null, 'impostos', false, 'impostos-des', true);
      if(flxExpanded.has('impostos-des')) html += flxChildRowsImpostos(year, childCtx, 'despesa').join('');
    }

    // (=) LUCRO LÍQUIDO
    if(!H('lucroLiquido')) html += rowDerived(OP('(=)', L('lucroLiquido','Lucro Líquido do Exercício')), arrLucroLiq, 'hd-result', null, {colorize:true}, null, false, null, true);

    // Grupo Ajustes de Caixa
    html += '<tr class="flx-group flx-no-check"><td class="stk-1" colspan="'+totalCols+'">Ajustes de Caixa (não operacionais)</td></tr>';

    if(!H('creditoAlv')) html += rowEditable(OP('(+)', L('creditoAlv','Crédito / Alavancagem')), 'creditoAlv', arrCred,       'flx-credito',    'entrada', 'creditoAlv');
    if(!H('outrasRec'))  html += rowEditable(OP('(+)', L('outrasRec','Outras Receitas')),       'outrasRec',  arrOutras,     'flx-outras-rec', 'entrada', 'outrasRec');
    if(!H('amortizacao')) html += rowDerived(OP('(−)', L('amortizacao','Amortização de Empréstimos')), arrAmort, 'flx-outras-desp', 'saida', null, null, false, null, true);
    if(!H('parcImpostos')){
      html += rowDerived(OP('(−)', L('parcImpostos','Principal de Parcelamentos')), arrImpParcPrincipal, 'flx-outras-desp', 'saida', null, null, false, 'parcImpostos', true);
      if(flxExpanded.has('parcImpostos')) html += flxChildRowsImpParcelamentos(year, childCtx).join('');
    }
    if(!H('outrasDesp')) html += rowEditable(OP('(−)', L('outrasDesp','Outras Despesas')),     'outrasDesp', arrOutrasDesp, 'flx-outras-desp','saida',   'outrasDesp');
    // Linhas custom de Ajustes de Caixa (flat)
    html += _emitCustomSec('ajustes_caixa', false);

    // (=) RESULTADO LÍQUIDO
    if(!H('resultadoLiquido')) html += rowDerived(OP('(=)', L('resultadoLiquido','Saldo do Mês')), arrSaldoMes, 'hd-saldo', null, {colorize:true}, null, false, null, true);
  } else {
    // ═══════════════════ DRC (Caixa — estrutura atual) ═══════════════════
    html += rowDerived(L('receita','Receita'), arrReceita, 'hd-receita', 'receita', null, 'receita', true, 'receita', true);
    if(flxExpanded.has('receita')) html += flxChildRowsReceita(year, childCtx).join('');

    if(!H('gastoTotal')) html += rowDerived(L('gastoTotal','Gasto Total'), arrCusto, 'hd-custo', null, null, null, false, null, true);

    if(!H('folha')){
      html += rowDerived(L('folha','Folha'), arrFolha, 'sub', 'folha', null, 'folha', true, 'folha', true);
      if(flxExpanded.has('folha')) html += flxChildRowsFolha(year, childCtx).join('');
    }
    if(!H('despesas')){
      html += rowDerived(L('despesas','Despesas Recorrentes'), arrDesp, 'sub', 'desp', null, 'despesas', true, 'despesas', true);
      if(flxExpanded.has('despesas')) html += flxChildRowsDespesas(year, childCtx).join('');
    }
    if(!H('emprestimos')){
      html += rowDerived(L('emprestimos','Empréstimos'), arrEmp, 'sub', 'emp', null, 'emprestimos', true, 'emprestimos', true);
      if(flxExpanded.has('emprestimos')) html += flxChildRowsEmprestimos(year, childCtx).join('');
    }
    if(!H('impostos')){
      html += rowDerived(L('impostos','Impostos'), arrImp, 'sub', 'imp', null, 'impostos', true, 'impostos', true);
      if(flxExpanded.has('impostos')) html += flxChildRowsImpostos(year, childCtx).join('');
    }
    if(!H('parcImpostos')){
      html += rowDerived(L('parcImpostos','Parcelamento de Impostos'), arrImpParc, 'sub', 'imp', null, 'parcImpostos', true, 'parcImpostos', true);
      if(flxExpanded.has('parcImpostos')) html += flxChildRowsImpParcelamentos(year, childCtx).join('');
    }
    // Linhas custom de Custos Operacionais e Resultado Financeiro
    // (sub-rows dentro de Gasto Total — afetam arrCusto/arrResult)
    html += _emitCustomSec('custos_op', true);
    html += _emitCustomSec('financeiro', true);

    if(!H('resultado')) html += rowDerived(L('resultado','Resultado'), arrResult, 'hd-result', null, {colorize:true}, null, false, null, true);

    if(!H('creditoAlv')) html += rowEditable(L('creditoAlv','Crédito / Alavancagem'), 'creditoAlv', arrCred,       'flx-credito',    'entrada', 'creditoAlv');
    if(!H('outrasRec'))  html += rowEditable(L('outrasRec','Outras Receitas'),       'outrasRec',  arrOutras,     'flx-outras-rec', 'entrada', 'outrasRec');
    if(!H('outrasDesp')) html += rowEditable(L('outrasDesp','Outras Despesas'),       'outrasDesp', arrOutrasDesp, 'flx-outras-desp','saida',   'outrasDesp');
    // Linhas custom de Ajustes de Caixa (flat)
    html += _emitCustomSec('ajustes_caixa', false);

    if(!H('saldoMes')) html += rowDerived(L('saldoMes','Saldo do Mês'), arrSaldoMes, 'hd-saldo', null, {colorize:true});
  }

  // SALDO FINAL (running — saldo inicial + soma saldo do mês) — mês a mês visível
  // Meses antes do mês âncora do saldo inicial aparecem como "—" (ainda não há saldo declarado).
  {
    const lastIdx = 11;
    const lastVal = arrSaldoFinal[lastIdx];
    const sf = (lastVal == null) ? 0 : lastVal;
    // Total = projeção final (dez). Média = média aritmética dos meses ativos (após âncora, inclusive).
    const tracked = arrSaldoFinal.filter(v => v != null && Number.isFinite(v));
    const medSF = tracked.length ? (tracked.reduce((a,b)=>a+b,0) / tracked.length) : 0;
    const spanAttr = hasAna ? ` colspan="${subCols}"` : '';
    const cells = arrSaldoFinal.map((v, m) => {
      if(v == null){
        return `<td class="mes flx-sf-empty"${spanAttr}><span class="flx-zero">—</span></td>`;
      }
      const n = parseFloat(v)||0;
      let cls = '';
      if(n < 0) cls = 'flx-neg';
      else if(n > 0) cls = 'flx-pos';
      else cls = 'flx-zero';
      const anchor = (m === siMes) ? ' flx-sf-anchor' : '';
      const tip = (m === siMes) ? ` title="Saldo inicial ancorado em ${FLX_MESES[siMes]}/${year}"` : '';
      return `<td class="mes${anchor}"${tip}${spanAttr}><span class="${cls}">${fmtBRL(n)}</span></td>`;
    }).join('');
    const sfCls = sf > 0 ? 'flx-pos' : (sf < 0 ? 'flx-neg' : 'flx-zero');
    const medCls = medSF > 0 ? 'flx-pos' : (medSF < 0 ? 'flx-neg' : 'flx-zero');
    // Fluxo de Caixa não é analisado — usa colspan em Total/Média quando hasAna
    const fcTot = hasAna ? `<td class="tot" colspan="${subCols}"><span class="${sfCls}">${fmtBRL(sf)}</span></td>`
                         : `<td class="tot"><span class="${sfCls}">${fmtBRL(sf)}</span></td>`;
    const fcMed = hasAna ? `<td class="med" colspan="${subCols}"><span class="${medCls}">${fmtBRL(medSF)}</span></td>`
                         : `<td class="med"><span class="${medCls}">${fmtBRL(medSF)}</span></td>`;
    if(!flxIsHidden(flxView, 'fluxoCaixa'))
    html += `<tr class="hd-saldofinal flx-no-check">
      <td class="stk-1">${flxLabel(flxView, 'fluxoCaixa', 'Fluxo de Caixa')}</td>
      ${cells}
      ${fcTot}
      ${fcMed}
    </tr>`;
  }

  tbody.innerHTML = html;
  // Cashbox destaque (Saldo Inicial editável + Saldo Final de dez) — fora da planilha
  try{ renderFlxCashbox(); }catch(e){}
  // Sincroniza estado visual dos botões AV/AH e DRC/DRE
  try{ _flxUpdateAnaBtns(); }catch(e){}
  try{ _flxUpdateViewBtns(); }catch(e){}
}

