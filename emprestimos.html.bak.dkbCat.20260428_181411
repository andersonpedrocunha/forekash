// Reorganiza a barra lateral conforme settings.featuredModules:
// items destacados saem do grupo, vão pro wrap. Não-destacados voltam pro grupo.
function applyFeaturedModules(){
  const wrap = document.getElementById('sb-featured-wrap');
  if(!wrap) return;
  const sidebar = wrap.parentElement;
  if(!sidebar) return;

  // 1) Devolve botões do wrap pro grupo de origem (ou pra raiz, se não tiver grupo)
  const featuredBtns = Array.from(wrap.querySelectorAll(':scope > .sb-item'));
  featuredBtns.forEach(btn => {
    btn.classList.remove('featured');
    const star = btn.querySelector('.sb-featured-star');
    if(star) star.remove();
    const key = btn.getAttribute('data-module');
    const groupKey = SB_GROUP_OF[key];
    if(groupKey){
      const groupItems = sidebar.querySelector('.sb-group[data-group="' + groupKey + '"] .sb-group-items');
      if(groupItems){ groupItems.appendChild(btn); }
      else { sidebar.insertBefore(btn, wrap); }
    } else {
      sidebar.insertBefore(btn, wrap);
    }
  });

  // 2) Reordena dentro de cada grupo conforme SB_GROUP_ORDER (canônico)
  Object.keys(SB_GROUP_ORDER).forEach(gk => {
    const container = sidebar.querySelector('.sb-group[data-group="' + gk + '"] .sb-group-items');
    if(!container) return;
    SB_GROUP_ORDER[gk].forEach(key => {
      const btn = container.querySelector('.sb-item[data-module="' + key + '"]');
      if(btn) container.appendChild(btn);
    });
  });

  // 3) Esvazia o wrap
  wrap.innerHTML = '';

  // 4) Move os módulos escolhidos pro wrap (com decoração featured)
  const picks = (settings && Array.isArray(settings.featuredModules)) ? settings.featuredModules : [];
  picks.slice(0, FEATURED_MAX).forEach(key => {
    if(key === 'dashboard') return;
    const btn = sidebar.querySelector('.sb-item[data-module="' + key + '"]');
    if(!btn) return;
    btn.classList.add('featured');
    if(!btn.querySelector('.sb-featured-star')){
      const star = document.createElement('span');
      star.className = 'sb-featured-star';
      star.setAttribute('aria-hidden','true');
      star.textContent = '★';
      btn.appendChild(star);
    }
    wrap.appendChild(btn);
  });

  // 5) Recalcula contadores e estado has-active dos grupos
  if(typeof sbGroupRefresh === 'function') sbGroupRefresh();
}

// ─── Foto de perfil (settings.userPhotoDataUrl) ───
function cfgPhotoChange(inp){
  const f = inp && inp.files && inp.files[0];
  if(!f) return;
  if(!/^image\/(png|jpe?g|webp|gif)$/i.test(f.type)){
    if(typeof toast === 'function') toast('Formato não suportado. Use PNG, JPG ou WebP.');
    return;
  }
  if(f.size > 1024 * 1024 * 1.2){
    if(typeof toast === 'function') toast('Foto muito grande (máx 1 MB).');
    return;
  }
  const reader = new FileReader();
  reader.onload = (e) => {
    const dataUrl = e.target.result || '';
    if(!settings) settingsLoad();
    settings.userPhotoDataUrl = dataUrl;
    try { settingsSave(); } catch(err){}
    cfgPhotoApply();
    if(typeof fkRenderUserMenu === 'function'){
      try { fkRenderUserMenu(); } catch(_){}
    }
    if(typeof homeRenderHero === 'function'){
      try { homeRenderHero(); } catch(_){}
    }
    if(typeof toast === 'function') toast('✓ Foto de perfil atualizada');
  };
  reader.readAsDataURL(f);
  // Limpa pra permitir reescolher mesmo arquivo
  inp.value = '';
}
function cfgPhotoRemove(){
  if(!settings) settingsLoad();
  settings.userPhotoDataUrl = '';
  try { settingsSave(); } catch(e){}
  cfgPhotoApply();
  if(typeof fkRenderUserMenu === 'function'){
    try { fkRenderUserMenu(); } catch(_){}
  }
  if(typeof homeRenderHero === 'function'){
    try { homeRenderHero(); } catch(_){}
  }
  if(typeof toast === 'function') toast('Foto removida');
}
function cfgPhotoApply(){
  const av = document.getElementById('cfg-photo-avatar');
  const initialsEl = document.getElementById('cfg-photo-initials');
  const removeBtn = document.getElementById('cfg-photo-remove');
  if(!settings) return;
  const url = settings.userPhotoDataUrl || '';
  // Avatar visual no Perfil
  if(av){
    // Limpa imgs anteriores
    av.querySelectorAll('img').forEach(i => i.remove());
    if(url){
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      av.insertBefore(img, av.firstChild);
      if(initialsEl) initialsEl.style.display = 'none';
    } else {
      if(initialsEl){
        initialsEl.style.display = '';
        const name = (settings.userName || 'A').trim();
        initialsEl.textContent = (name[0] || 'A').toUpperCase();
      }
    }
  }
  if(removeBtn) removeBtn.style.display = url ? '' : 'none';
}
