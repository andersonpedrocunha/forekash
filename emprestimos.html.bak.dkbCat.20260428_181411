  const old = document.getElementById('ana-confirm-overlay');
  if(old) old.remove();
  const ov = document.createElement('div');
  ov.id = 'ana-confirm-overlay';
  ov.className = 'ana-confirm-overlay';
  ov.innerHTML =
      '<div class="ana-confirm-card' + (cfg.danger ? ' is-danger' : '') + '" role="dialog" aria-modal="true">'
    +   '<div class="ana-confirm-head">'
    +     '<div class="ana-confirm-eyebrow">' + (cfg.eyebrow||'').toString().replace(/[<>&]/g,'') + '</div>'
    +     '<h3 class="ana-confirm-title">' + (cfg.title||'').toString().replace(/[<>&]/g,'') + '</h3>'
    +   '</div>'
