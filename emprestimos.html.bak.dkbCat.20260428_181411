const ANA_USER_GAL_LIMIT = 5;
function _anaInitSavedStores(){
  if(!Array.isArray(_anaState.userPresets)) _anaState.userPresets = [];
  if(!Array.isArray(_anaState.archive))     _anaState.archive = [];
}
function _anaCloneSlides(){
  try { return JSON.parse(JSON.stringify(_anaState.presentation.slides || [])); }
  catch(e){ return []; }
}
function _anaPreviewText(slides){
  return (slides || []).slice(0, 3).map(s => {
    const t = (s.title || '').replace(/<[^>]+>/g, '').trim();
    return t || '(sem título)';
  }).join(' · ');
}
function _anaFmtSavedAt(ts){
  if(!ts) return '';
  try {
    const d = new Date(ts);
    return d.toLocaleDateString('pt-BR', { day:'2-digit', month:'short', year:'numeric' })
         + ' ' + d.toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit' });
  } catch(e){ return ''; }
}

