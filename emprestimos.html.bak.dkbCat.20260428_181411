// ── Mousedown: captura antes do focus nativo, inicia arrasto potencial ──────
// Usa stopImmediatePropagation para bloquear o listener do sistema de seleção
// (fill-handle, registrado depois no document na mesma fase de captura).
document.addEventListener('mousedown', function(e){
  if(e.button !== 0) return;
  if(!__formulaActiveInput) return;
  if(!document.body.contains(__formulaActiveInput)){ __formulaActiveInput = null; return; }
  if(!__isFormulaMode(__formulaActiveInput)){ __formulaActiveInput = null; return; }
  const cell = e.target && e.target.closest ? e.target.closest('[data-cellref]') : null;
  if(!cell) return;
  if(cell === __formulaActiveInput) return;
  e.preventDefault();
  e.stopPropagation();
  if(typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();

  const inp = __formulaActiveInput;
  let start = inp.selectionStart, end = inp.selectionEnd;
  if(start == null){ start = inp.value.length; end = inp.value.length; }
  const before = inp.value.slice(0, start);
  const after  = inp.value.slice(end);

  __formulaDragState = {
    inp, before, after, startCaret: start,
    cellsOrdered: [cell],
    cellsSet: new Set([cell]),
    downX: e.clientX, downY: e.clientY,
    committed: false,
  };
  __formulaEditingActive = true;   // drag conta como edição — habilita preview
  document.body.classList.add('formula-dragging');
  document.querySelectorAll('.formula-drag-ref')
    .forEach(el => el.classList.remove('formula-drag-ref'));
  cell.classList.add('formula-drag-ref');
  __renderFormulaDragToken();
}, true);

// ── Mousemove: estende o arrasto por células adicionais ─────────────────────
document.addEventListener('mousemove', function(e){
  const ds = __formulaDragState; if(!ds) return;
  const under = document.elementFromPoint(e.clientX, e.clientY);
  if(!under) return;
  const cell = under.closest && under.closest('[data-cellref]');
  if(!cell) return;
  if(cell === ds.inp) return;              // não inclui a célula em edição
  if(ds.cellsSet.has(cell)) return;        // já está na lista
  ds.cellsSet.add(cell);
  ds.cellsOrdered.push(cell);
  cell.classList.add('formula-drag-ref');
  __renderFormulaDragToken();
}, true);

// ── Mouseup: finaliza o arrasto em qualquer lugar da página ─────────────────
document.addEventListener('mouseup', function(e){
  if(!__formulaDragState) return;
  e.stopPropagation();
  __endFormulaDrag();
}, true);
// Se o cursor sair da janela com botão solto, encerra também
document.addEventListener('mouseleave', function(){
  if(__formulaDragState) __endFormulaDrag();
}, true);

// focusin NÃO mostra preview — preview só aparece na primeira digitação/drag.
document.addEventListener('focusin', function(e){
  const cell = e.target && e.target.closest ? e.target.closest('[data-cellref]') : null;
  if(!cell) return;
  if(__isFormulaMode(cell)){
    __formulaActiveInput = cell;
    // NÃO liga __formulaEditingActive aqui — espera o usuário digitar/arrastar.
  }
}, true);

// Primeiro `input` já conta como digitação → habilita preview.
document.addEventListener('input', function(e){
  const cell = e.target && e.target.closest ? e.target.closest('[data-cellref]') : null;
  if(!cell) return;
  if(__isFormulaMode(cell)){
    __formulaActiveInput = cell;
    __formulaEditingActive = true;
    __updateFormulaPreview();
  } else if(__formulaActiveInput === cell){
    __formulaActiveInput = null;
    __formulaEditingActive = false;
    __hideFormulaPreview();
  }
}, true);

// Ao sair de qualquer célula, PARA a edição e esconde o preview IMEDIATAMENTE.
// Se o usuário for para outra célula em modo fórmula, o `input`/drag dela reativa.
// O setTimeout de limpeza de estado roda depois só para consolidar __formulaActiveInput.
document.addEventListener('focusout', function(e){
  const cell = e.target && e.target.closest ? e.target.closest('[data-cellref]') : null;
  if(!cell) return;
  // Não esconde durante um drag ativo (ex: refocus do input entre mousedown/mouseup)
  if(__formulaDragState) return;
  __formulaEditingActive = false;
  __hideFormulaPreview();
  setTimeout(function(){
    const active = document.activeElement;
    const activeCell = (active && active.closest) ? active.closest('[data-cellref]') : null;
    if(!activeCell || !__isFormulaMode(activeCell)){
      if(__formulaActiveInput && !document.body.contains(__formulaActiveInput)) __formulaActiveInput = null;
      else if(__formulaActiveInput && !__isFormulaMode(__formulaActiveInput)) __formulaActiveInput = null;
    }
  }, 20);
  setTimeout(__recomputeAllFormulas, 30);
}, true);

