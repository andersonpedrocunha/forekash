  const fmtNeg = (n) => {
    const s = (n < 0 ? '-' : (n > 0 ? '+' : '')) + 'R$ ' +
              fmtBR(Math.abs(n), 2);
    return '<span class="' + (n<0?'neg':n>0?'pos':'') + '">' + s + '</span>';
  };
  const ajustesHtml = ajustesArr.length === 0
    ? '<div class="empty">Nenhum ajuste manual no período.</div>'
    : '<table><thead><tr><th>Mês</th><th>Regra</th><th>Descrição</th><th class="r">Valor</th></tr></thead><tbody>'
      + ajustesArr.map(a =>
          '<tr><td class="ym">' + esc(a.ymLbl) + '</td>'
        + '<td>' + esc(a.regraLbl) + '</td>'
        + '<td>' + esc(a.nota || '—') + '</td>'
        + '<td class="r">' + fmtNeg(a.valor) + '</td></tr>'
        ).join('')
      + (ajustesArr.length > 1
          ? '<tr class="totalrow"><td colspan="3">Subtotal ajustes</td><td class="r">' + fmtNeg(totAjuste) + '</td></tr>'
          : '')
      + '</tbody></table>';
  const overridesHtml = overridesArr.length === 0
    ? '<div class="empty">Nenhum override de célula no período.</div>'
    : '<table><thead><tr><th>Mês</th><th class="r">Calculado</th><th class="r">Override</th><th class="r">Diferença</th></tr></thead><tbody>'
      + overridesArr.map(o =>
          '<tr><td class="ym">' + esc(o.ymLbl) + '</td>'
        + '<td class="r">R$ ' + fmtBR(o.calc, 2) + '</td>'
        + '<td class="r">R$ ' + fmtBR(o.override, 2) + '</td>'
        + '<td class="r">' + fmtNeg(o.diff) + '</td></tr>'
        ).join('')
      + (overridesArr.length > 1
          ? '<tr class="totalrow"><td colspan="3">Subtotal overrides</td><td class="r">' + fmtNeg(totOver) + '</td></tr>'
          : '')
      + '</tbody></table>';
  ov.innerHTML = '<div class="vend-rel-origem-modal" onclick="event.stopPropagation()">'
    + '<h3>🔍 Origem dos Ajustes / Overrides'
    + '<button class="close" onclick="document.getElementById(\'ov-vend-origem\').remove()" title="Fechar">✕</button>'
    + '</h3>'
    + '<div style="font-size:.78rem;color:#6B7280;margin-bottom:6px">'
    + 'Vendedor <b>' + esc(v.nome||'(sem nome)') + '</b> · período <b>'
    + esc(MESES_LBL[st.mesDe]+'/'+String(st.anoDe).slice(2)) + ' → '
    + esc(MESES_LBL[st.mesAte]+'/'+String(st.anoAte).slice(2)) + '</b></div>'
    + '<h4>Ajustes manuais</h4>' + ajustesHtml
    + '<h4>Overrides de célula</h4>' + overridesHtml
    + '<div style="margin-top:14px;padding:10px 12px;background:#FFFBEB;border:1px solid #FCD34D;border-radius:8px;display:flex;justify-content:space-between;align-items:center">'
    +   '<b style="color:#92400E">Total na linha "Ajustes / Overrides"</b>'
