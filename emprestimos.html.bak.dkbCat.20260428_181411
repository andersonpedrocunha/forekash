// ═══════════════════════════════════════════════════
//  MÓDULO ORÇAMENTO (previsto × realizado)
//    DRE: Receita − (Folha + Despesas + Empréstimos + Impostos) = Resultado
//    Versionamento: múltiplas versões por ano (ex.: original, revisão Q2)
//    Realizado: calculado on-the-fly via flx*Mes
// ═══════════════════════════════════════════════════
const ORC_KEY = 'taller_orcamento_v1';
const ORC_MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];

// Categorias (linhas da DRE) — ícones e cores espelham a barra lateral
const ORC_CATS = [
  {id:'receita',     nome:'Receita',        grupo:'receita', color:'#10B981',
   svg:'<path d="M12 4v16"/><path d="M16 8a3 3 0 00-3-2h-2a3 3 0 000 6h2a3 3 0 010 6h-2a3 3 0 01-3-2"/>'},
  {id:'folha',       nome:'Folha',          grupo:'custo',   color:'#8B5CF6',
   svg:'<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3 2.8-5 6-5s6 2 6 5"/><circle cx="17" cy="9" r="2.6"/><path d="M15 20c0-2.6 2.3-4.5 5-4.5"/>'},
  {id:'despesas',    nome:'Despesas Recorrentes', grupo:'custo',   color:'#EC4899',
   svg:'<rect x="3" y="10" width="18" height="11" rx="1"/><path d="M7 10V7a5 5 0 0110 0v3"/>'},
  {id:'emprestimos', nome:'Empréstimos',    grupo:'custo',   color:'#EF4444',
   svg:'<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4v3h6V4"/><path d="M9 11h6"/><path d="M9 15h6"/><path d="M9 19h4"/>'},
  {id:'impostos',    nome:'Impostos',       grupo:'custo',   color:'#E11D48',
   svg:'<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/><path d="M7 15h4"/><path d="M7 18h6"/>'}
];
const ORC_CAT_BY_ID = Object.fromEntries(ORC_CATS.map(c => [c.id, c]));
const ORC_CUSTO_IDS = ORC_CATS.filter(c => c.grupo === 'custo').map(c => c.id);

let orcamento     = null;
let orcActiveYear = null;
let orcActiveVerId= null;
let orcMode       = 'comparativo'; // 'comparativo' | 'previsto'

function orcamentoLoad(){
  let raw = null;
  try{ raw = localStorage.getItem(ORC_KEY); }catch(e){}
  if(raw){
    try{ orcamento = JSON.parse(raw); }catch(e){ orcamento = null; }
  }
  if(!orcamento || typeof orcamento !== 'object'){
    orcamento = { activeYear: String(new Date().getFullYear()), years: {} };
  }
  if(!orcamento.years || typeof orcamento.years !== 'object') orcamento.years = {};
  if(!Array.isArray(orcamento.anosExcluidos)) orcamento.anosExcluidos = [];
  const excluidos = new Set(orcamento.anosExcluidos.map(String));

  // Une com anos dos outros módulos (respeitando exclusões explícitas)
  const allYears = new Set(Object.keys(orcamento.years));
  try{
    if(receita && receita.years)   Object.keys(receita.years).forEach(y => allYears.add(String(y)));
    if(estrutura && estrutura.years) estrutura.years.forEach(y => allYears.add(String(y)));
    if(pessoas && pessoas.years)   pessoas.years.forEach(y => allYears.add(String(y)));
    if(fluxo && fluxo.years)       fluxo.years.forEach(y => allYears.add(String(y)));
  }catch(e){}
  // Remove anos que o usuário excluiu explicitamente
  for(const y of Array.from(allYears)){ if(excluidos.has(y)) allYears.delete(y); }
  // Ao menos o ano corrente (ou, se tudo excluído, força que pelo menos 1 ano fique)
  if(allYears.size === 0){
    const atual = String(new Date().getFullYear());
    allYears.add(atual);
    excluidos.delete(atual);
    orcamento.anosExcluidos = Array.from(excluidos);
  }
  for(const y of allYears){ orcEnsureYear(y); }

  const sorted = Array.from(allYears).sort();
  orcActiveYear = (orcamento.activeYear && allYears.has(orcamento.activeYear))
                  ? orcamento.activeYear : sorted[sorted.length-1];
  const yBlk = orcamento.years[orcActiveYear];
  orcActiveVerId = (yBlk && yBlk.ativa && (yBlk.versions||[]).find(v => v.id === yBlk.ativa))
                   ? yBlk.ativa : (yBlk.versions[0] && yBlk.versions[0].id);
}

function orcamentoSave(){
  orcamento.activeYear = orcActiveYear;
  const yBlk = orcamento.years[orcActiveYear];
  if(yBlk) yBlk.ativa = orcActiveVerId;
  try{ localStorage.setItem(ORC_KEY, JSON.stringify(orcamento)); }catch(e){}
}

function orcEnsureYear(y){
  y = String(y);
  if(!orcamento.years[y]){
    orcamento.years[y] = {
      versions: [ orcMakeEmptyVersion('Orçamento original') ],
      ativa: null
    };
    orcamento.years[y].ativa = orcamento.years[y].versions[0].id;
  }
  const blk = orcamento.years[y];
  if(!Array.isArray(blk.versions) || blk.versions.length === 0){
    blk.versions = [ orcMakeEmptyVersion('Orçamento original') ];
    blk.ativa = blk.versions[0].id;
  }
  for(const v of blk.versions){
    v.linhas = v.linhas || {};
    for(const c of ORC_CATS){
      v.linhas[c.id] = v.linhas[c.id] || { previsto: {} };
      v.linhas[c.id].previsto = v.linhas[c.id].previsto || {};
    }
  }
  if(!blk.ativa || !blk.versions.find(v => v.id === blk.ativa)){
    blk.ativa = blk.versions[0].id;
  }
}

function orcMakeEmptyVersion(nome){
  const id = 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2,6);
  const linhas = {};
  for(const c of ORC_CATS) linhas[c.id] = { previsto: {} };
  return {
    id,
    nome: nome || 'Nova versão',
    criadoEm: new Date().toISOString(),
    congelado: null,
    linhas
  };
}

function orcGetYearBlock(y){
  y = String(y || orcActiveYear);
  orcEnsureYear(y);
  return orcamento.years[y];
}

function orcGetVersion(y, vid){
  const blk = orcGetYearBlock(y);
  const id = vid || orcActiveVerId;
  return (blk.versions||[]).find(v => v.id === id) || blk.versions[0];
}

// ───── Realizado (reusa helpers do fluxo) ─────
function orcRealMes(catId, year, mIdx){
  try{
    if(catId === 'receita')     return flxReceitaMes(year, mIdx);
    if(catId === 'folha')       return flxFolhaMes(year, mIdx);
    if(catId === 'despesas')    return flxDespesasMes(year, mIdx);
    if(catId === 'emprestimos') return flxEmprestimosMes(year, mIdx);
    if(catId === 'impostos')    return flxImpostoMes(year, mIdx);
  }catch(e){ return 0; }
  return 0;
}
function orcRealAno(catId, year){
  let s = 0; for(let m=0;m<12;m++) s += orcRealMes(catId, year, m); return s;
}

// ───── Previsto ─────
function orcPrevMes(catId, year, mIdx, vid){
  const v = orcGetVersion(year, vid);
  if(!v) return 0;
  const raw = (((v.linhas||{})[catId]||{}).previsto||{})[mIdx];
  if(raw === undefined || raw === null || raw === '') return 0;
  const n = parseFloat(raw);
  return isFinite(n) ? n : 0;
}
function orcPrevMesRaw(catId, year, mIdx, vid){
  const v = orcGetVersion(year, vid);
  if(!v) return '';
  const raw = (((v.linhas||{})[catId]||{}).previsto||{})[mIdx];
  return (raw === undefined || raw === null) ? '' : raw;
}
function orcPrevAno(catId, year, vid){
  let s = 0; for(let m=0;m<12;m++) s += orcPrevMes(catId, year, m, vid); return s;
}
function orcSetPrev(catId, year, mIdx, val){
  const v = orcGetVersion(year);
  if(!v) return;
  v.linhas = v.linhas || {};
  v.linhas[catId] = v.linhas[catId] || { previsto:{} };
  v.linhas[catId].previsto = v.linhas[catId].previsto || {};
  if(val === '' || val === null || val === undefined){
    delete v.linhas[catId].previsto[mIdx];
  } else {
    v.linhas[catId].previsto[mIdx] = val;
  }
  orcamentoSave();
}

// ───── Mês realizado? (só computa desvio para meses já "fechados") ─────
function orcMesFechado(year, mIdx){
  const today = new Date();
  const y = parseInt(year);
  const ty = today.getFullYear();
  if(y < ty) return true;
  if(y > ty) return false;
  return mIdx <= today.getMonth(); // inclui o corrente (em andamento)
}

// ───── Agregados DRE (prev/real) ─────
function orcCustoPrevMes(year, mIdx, vid){
  let s = 0; for(const c of ORC_CUSTO_IDS) s += orcPrevMes(c, year, mIdx, vid); return s;
}
function orcCustoRealMes(year, mIdx){
  let s = 0; for(const c of ORC_CUSTO_IDS) s += orcRealMes(c, year, mIdx); return s;
}
function orcResultPrevMes(year, mIdx, vid){
  return orcPrevMes('receita', year, mIdx, vid) - orcCustoPrevMes(year, mIdx, vid);
}
function orcResultRealMes(year, mIdx){
  return orcRealMes('receita', year, mIdx) - orcCustoRealMes(year, mIdx);
}

// ═══════════ Render ═══════════
function renderOrcamento(){
  if(!orcamento){ orcamentoLoad(); }
  // Re-sincroniza anos
  const allYears = new Set(Object.keys(orcamento.years));
  try{
    if(receita && receita.years)   Object.keys(receita.years).forEach(y => allYears.add(String(y)));
    if(estrutura && estrutura.years) estrutura.years.forEach(y => allYears.add(String(y)));
    if(pessoas && pessoas.years)   pessoas.years.forEach(y => allYears.add(String(y)));
    if(fluxo && fluxo.years)       fluxo.years.forEach(y => allYears.add(String(y)));
  }catch(e){}
  allYears.add(String(new Date().getFullYear()));
  for(const y of allYears){ orcEnsureYear(y); }
  if(!orcActiveYear || !orcamento.years[orcActiveYear]){
    const sorted = Array.from(allYears).sort();
    orcActiveYear = sorted[sorted.length-1];
  }
  const yBlk = orcamento.years[orcActiveYear];
  if(!orcActiveVerId || !yBlk.versions.find(v => v.id === orcActiveVerId)){
    orcActiveVerId = yBlk.ativa || yBlk.versions[0].id;
  }
  renderOrcYearTabs();
  renderOrcVersionSelect();
  renderOrcModeButtons();
  renderOrcSheet();
  updateOrcKpis();
}

function renderOrcYearTabs(){
  const host = document.getElementById('orc-year-tabs');
  if(!host) return;
  const anos = Object.keys(orcamento.years).sort();
  const multi = (anos.length > 1);
  const frag = [];
  for(const y of anos){
    const active = (y === orcActiveYear) ? ' active' : '';
    const del = multi
      ? '<span class="pes-year-del" onclick="event.stopPropagation();delOrcYear(\''+esc(y)+'\')" title="Excluir ano">✕</span>'
      : '';
    frag.push(
      '<button class="pes-year-tab'+active+'" onclick="orcPickYear(\''+esc(y)+'\')">'+
        esc(y) + del +
      '</button>'
    );
  }
  frag.push('<button class="pes-year-add" onclick="orcAddYear()" title="Adicionar ano">+ ano</button>');
  host.innerHTML = frag.join('');
}

async function delOrcYear(y){
  y = String(y);
  const anos = Object.keys(orcamento.years);
  if(!anos.includes(y)) return;
  if(anos.length <= 1){
    if(typeof showInfo === 'function'){
      await showInfo({title:'Ação não permitida', message:'Não é possível excluir o único ano.', warning:true});
    } else {
      toast('Não é possível excluir o único ano');
    }
    return;
  }
  const blk = orcamento.years[y];
  const nVers = (blk && Array.isArray(blk.versions)) ? blk.versions.length : 0;
  const msg = 'Todas as <strong>'+nVers+' versão(ões)</strong> de orçamento de <strong>'+esc(y)+'</strong> serão removidas. '+
              'Essa ação não pode ser desfeita.';
  let ok = false;
  if(typeof showConfirm === 'function'){
    ok = await showConfirm({
      title: 'Excluir ano '+y,
      message: msg,
      confirmLabel: 'Excluir ano',
      destructive: true
    });
  } else {
    ok = confirm('Excluir ano '+y+'? Todas as versões serão removidas.');
  }
  if(!ok) return;
  delete orcamento.years[y];
  // Marca como excluído para não ser re-adicionado no próximo load
  if(!Array.isArray(orcamento.anosExcluidos)) orcamento.anosExcluidos = [];
  if(!orcamento.anosExcluidos.includes(y)) orcamento.anosExcluidos.push(y);
  if(orcActiveYear === y){
    const sorted = Object.keys(orcamento.years).sort();
    orcActiveYear = sorted[sorted.length-1];
    const nb = orcamento.years[orcActiveYear];
    orcActiveVerId = nb && nb.ativa ? nb.ativa : (nb && nb.versions[0] && nb.versions[0].id);
  }
  orcamentoSave();
  renderOrcamento();
  toast('Ano '+y+' excluído');
}

function orcPickYear(y){
  if(y === orcActiveYear) return;
  orcActiveYear = String(y);
  const blk = orcGetYearBlock(y);
  orcActiveVerId = blk.ativa || blk.versions[0].id;
  orcamentoSave();
  renderOrcamento();
}

function orcAddYear(){
  const anos = Object.keys(orcamento.years).map(Number).filter(n=>!isNaN(n));
  const novo = (anos.length ? Math.max(...anos) : (new Date().getFullYear())) + 1;
  const y = String(novo);
  if(orcamento.years[y]){ toast('Ano já existe'); return; }
  orcEnsureYear(y);
  // Se estava na lista de excluídos, remove
  if(Array.isArray(orcamento.anosExcluidos)){
    orcamento.anosExcluidos = orcamento.anosExcluidos.filter(x => String(x) !== y);
  }
  orcActiveYear = y;
  orcActiveVerId = orcamento.years[y].ativa;
  orcamentoSave();
  renderOrcamento();
  toast('✅ Ano '+y+' criado (orçamento vazio)');
}

function renderOrcVersionSelect(){
