let _supFaqWired = false;
let _supFormWired = false;
let _supAttachments = []; // { name, size, type, dataUrl }
const SUP_ATT_MAX = 3;
const SUP_ATT_MAX_BYTES = 2 * 1024 * 1024; // 2 MB por arquivo

function renderSupport(){
  // Render FAQ list
  const list = document.getElementById('sup-faq-list');
  if(list){
    list.innerHTML = SUP_FAQ_DATA.map((it,i) => `
      <div class="sup-faq" data-sup-idx="${i}" data-sup-q="${(it.cat+' '+it.q+' '+it.a).replace(/"/g,'&quot;').replace(/<[^>]+>/g,'').toLowerCase()}">
        <button type="button" class="sup-faq-q" aria-expanded="false">
          <span><span class="sup-faq-cat">${it.cat}</span>${it.q}</span>
          <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="sup-faq-a">${it.a}</div>
      </div>
    `).join('');
  }

  // Wire FAQ (once) — accordion + search
  if(list && !_supFaqWired){
    list.addEventListener('click', (ev) => {
      const btn = ev.target.closest('.sup-faq-q');
      if(!btn) return;
      const card = btn.closest('.sup-faq');
      if(!card) return;
      const wasOpen = card.classList.contains('open');
      // Fechar todas antes de abrir a clicada (comportamento accordion)
      list.querySelectorAll('.sup-faq.open').forEach(c => {
        c.classList.remove('open');
        const b = c.querySelector('.sup-faq-q');
        if(b) b.setAttribute('aria-expanded','false');
      });
      if(!wasOpen){
        card.classList.add('open');
        btn.setAttribute('aria-expanded','true');
      }
    });
    const search = document.getElementById('sup-faq-q');
    if(search){
      search.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        let visible = 0;
        list.querySelectorAll('.sup-faq').forEach(card => {
          const hay = card.getAttribute('data-sup-q') || '';
          const show = !q || hay.indexOf(q) !== -1;
          card.style.display = show ? '' : 'none';
          if(show) visible++;
        });
        // Empty-state
        let empty = list.querySelector('.sup-faq-empty');
        if(visible === 0){
          if(!empty){
            empty = document.createElement('div');
            empty.className = 'sup-faq-empty';
            empty.textContent = 'Nenhuma pergunta encontrada. Tente outra palavra ou abra um chamado ao lado.';
            list.appendChild(empty);
          }
        } else if(empty){
          empty.remove();
        }
      });
    }
    _supFaqWired = true;
  }

  // Preenche contato com e-mail da sessão
  try{
    const u = (typeof fkCurrentUser === 'function') ? fkCurrentUser() : null;
    const contato = document.getElementById('sup-contato');
    if(contato && u && u.email && !contato.value){ contato.value = u.email; }
  }catch(_){ }

  // Wire form (once)
  if(!_supFormWired){
    const form = document.getElementById('sup-form');
    const desc = document.getElementById('sup-descricao');
    const count = document.getElementById('sup-descricao-count');
    if(desc && count){
      desc.addEventListener('input', () => { count.textContent = String(desc.value.length); });
    }
    if(form){
      form.addEventListener('submit', supHandleSubmit);
    }
    // Dropzone + file input
    const drop = document.getElementById('sup-drop');
    const inp  = document.getElementById('sup-file');
    if(drop && inp){
      drop.addEventListener('click', (ev) => {
        // Evita re-disparar quando o clique veio do próprio <input>
        if(ev.target && ev.target.tagName === 'INPUT') return;
        inp.click();
      });
      drop.addEventListener('keydown', (ev) => {
        if(ev.key === 'Enter' || ev.key === ' '){ ev.preventDefault(); inp.click(); }
      });
      inp.addEventListener('change', (ev) => {
        supAddFiles(ev.target.files);
        inp.value = ''; // permite selecionar o mesmo arquivo novamente
      });
      // Drag & drop
      ['dragenter','dragover'].forEach(evt => drop.addEventListener(evt, (e) => {
        e.preventDefault(); e.stopPropagation(); drop.classList.add('dragging');
      }));
      ['dragleave','drop'].forEach(evt => drop.addEventListener(evt, (e) => {
        e.preventDefault(); e.stopPropagation(); drop.classList.remove('dragging');
      }));
      drop.addEventListener('drop', (e) => {
        if(e.dataTransfer && e.dataTransfer.files){ supAddFiles(e.dataTransfer.files); }
      });
    }
    _supFormWired = true;
  }

  // Atualiza histórico de chamados
  supRenderTickets();
}

function supBytes(n){
  if(n == null) return '';
  if(n < 1024) return n + ' B';
  if(n < 1024*1024) return (n/1024).toFixed(0) + ' KB';
  return (n/(1024*1024)).toFixed(1) + ' MB';
}

function supAddFiles(fileList){
  if(!fileList || !fileList.length) return;
  const allowed = /^image\/(png|jpe?g|gif|webp)$/i;
  let rejected = [];
  const incoming = Array.from(fileList);
  for(const f of incoming){
    if(_supAttachments.length >= SUP_ATT_MAX){
      rejected.push(f.name + ' (limite de ' + SUP_ATT_MAX + ' arquivos)');
      continue;
    }
    if(!allowed.test(f.type)){
      rejected.push(f.name + ' (formato não suportado)');
      continue;
    }
    if(f.size > SUP_ATT_MAX_BYTES){
      rejected.push(f.name + ' (acima de ' + supBytes(SUP_ATT_MAX_BYTES) + ')');
      continue;
    }
    // Leitura assíncrona; adiciona ao array no onload
    const reader = new FileReader();
    reader.onload = (ev) => {
      _supAttachments.push({
        name: f.name,
        size: f.size,
        type: f.type,
        dataUrl: String(ev.target.result || '')
      });
      supRenderThumbs();
    };
    reader.onerror = () => {
      supAlert('Não foi possível ler <b>' + f.name + '</b>.', 'err');
    };
    reader.readAsDataURL(f);
  }
  if(rejected.length){
    supAlert('Ignorado(s): ' + rejected.join(', '), 'err');
  }
}

function supRemoveAttachment(idx){
  if(idx < 0 || idx >= _supAttachments.length) return;
  _supAttachments.splice(idx, 1);
  supRenderThumbs();
}

function supRenderThumbs(){
  const wrap = document.getElementById('sup-thumbs');
  if(!wrap) return;
  if(_supAttachments.length === 0){ wrap.style.display = 'none'; wrap.innerHTML = ''; return; }
  wrap.style.display = '';
  const esc = (s) => String(s||'').replace(/[<>&"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c]));
  wrap.innerHTML = _supAttachments.map((a, i) => `
    <div class="sup-thumb">
      <img src="${a.dataUrl}" alt="${esc(a.name)}" />
      <button type="button" class="sup-thumb-rm" data-sup-rm="${i}" aria-label="Remover ${esc(a.name)}" title="Remover">
        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="sup-thumb-meta">
        <span title="${esc(a.name)}">${esc(a.name)}</span>
        <span>${supBytes(a.size)}</span>
