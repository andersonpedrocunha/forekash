                        box-shadow:0 6px 20px rgba(99,102,241,.45),0 1px 3px rgba(99,102,241,.25)}
    .diag-run-btn:active{transform:translateY(0)}
    .diag-run-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}
    .diag-run-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.3;
                      stroke-linecap:round;stroke-linejoin:round}

    .diag-disclaimer{display:flex;gap:12px;align-items:flex-start;
                     background:#FFFBEB;border:1px solid #FDE68A;border-radius:12px;
