  'presumido': { label: 'Lucro Presumido',       desc: 'PIS 0,65%, COFINS 3%, IRPJ e CSLL sobre presunção (mensal ou trimestral) + ISS municipal. INSS RB (CPRB) opcional.' },
  'real':      { label: 'Lucro Real',            desc: 'PIS 1,65%, COFINS 7,6% sobre receita. IRPJ 15% + 10% e CSLL 9% sobre o lucro apurado (DRC), mensal ou trimestral. INSS RB (CPRB) opcional.' },
  'mei':       { label: 'MEI',                   desc: 'DAS-MEI fixo mensal, independente da receita (dentro do limite).' },
