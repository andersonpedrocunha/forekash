// Permite editar o nº de parcelas (coluna "Parcelas") e recalcula
// automaticamente o valor da parcela inicial a partir de:
//   base = saldoInicial × (1 + SELIC_mês) / N
// Essa é a condição exata para que, com juros sobre juros (chain),
// o parcelamento se quite em exatamente N meses.
function setImpParNumParcelas(id, val){
  const p = impostos.parcelamentos.find(x=>x.id===id);
  if(!p) return;
  const raw = (val == null ? '' : String(val)).trim();
  // Vazio ou inválido → descarta edição, apenas re-renderiza para restaurar valor
  if(raw === ''){
    renderImpParSheet();
    return;
  }
  const n = parseInt(raw, 10);
  if(!isFinite(n) || n <= 0){
    renderImpParSheet();
    return;
  }
  if(!p.saldoInicial || p.saldoInicial <= 0){
    // Sem saldo, não há como calcular base — apenas re-renderiza
    renderImpParSheet();
    return;
  }
  const r = 1 + impSelicMensal();
  const base = p.saldoInicial * r / n;
  // arredonda para cima em centavos — garante que o plano quite em EXATAMENTE
  // N parcelas (arredondar para baixo sobra centavos e produz N+1 rows)
  p.parcelaMensal = Math.ceil(base * 100) / 100;
  // Guarda o nº de parcelas que o usuário digitou — o plano pode quitar em N−1
  // meses por conta do arredondamento pra cima, mas o display respeita o input.
  p.numParcelasAlvo = n;
  // invalida cache do plano (o math muda)
  p._planKey = null; p._plan = null;
  impSave();
  renderImpParSheet();
  updateImpParKpis();
}

function setImpParMesInicio(id, val){
  const p = impostos.parcelamentos.find(x=>x.id===id);
