function renderDispoDadosManager(){
  const body = document.getElementById('dispo-dados-body'); if(!body) return;
  if(!dispo.contas || !dispo.contas.length){
    body.innerHTML = `
      <p class="dispo-mgr-intro">Você ainda não tem contas cadastradas. Feche este modal e clique em <strong>+ Nova conta</strong> para começar.</p>`;
    return;
  }
  // Ordena: ativas primeiro, depois pelo nome do banco
  const contas = dispo.contas.slice().sort((a,b)=>{
    if(!!b.ativo - !!a.ativo) return (!!b.ativo) - (!!a.ativo);
    const na = (dispoBanco(a.bancoId)?.nome || '');
    const nb = (dispoBanco(b.bancoId)?.nome || '');
    return na.localeCompare(nb,'pt-BR');
  });
  // Lista-resumo compacta (visão rápida): Banco, Nº do banco, Agência, Conta-Dígito, PIX.
  // Um banco aparece só uma vez; se houver várias contas no mesmo banco, prefere-se
  // a Conta Corrente (tipoId 't-cc' ou tipo cuja abrev/nome seja "conta corrente");
  // contas sem banco (bancoId vazio) são exibidas individualmente.
  const isContaCorrente = (c) => {
    if(c.tipoId === 't-cc') return true;
    const t = dispoTipo(c.tipoId);
    if(!t) return false;
    const abrev = (t.abrev || '').toLowerCase();
    const nome  = (t.nome  || '').toLowerCase();
    if(abrev === 'cc') return true;
    if(nome.includes('conta corrente')) return true;
    return false;
  };
  const listContas = (() => {
    const byBanco = new Map(); // bancoId -> conta escolhida
    const semBanco = [];
    for(const c of contas){
      if(!c.bancoId){ semBanco.push(c); continue; }
      const prev = byBanco.get(c.bancoId);
      if(!prev){ byBanco.set(c.bancoId, c); continue; }
      // Escolha: 1) prefere Conta Corrente, 2) prefere ativa, 3) mantém a primeira
      const prevCC = isContaCorrente(prev), curCC = isContaCorrente(c);
      if(curCC && !prevCC){ byBanco.set(c.bancoId, c); continue; }
      if(prevCC && !curCC) continue;
      if(c.ativo && !prev.ativo){ byBanco.set(c.bancoId, c); continue; }
    }
    return [...byBanco.values(), ...semBanco];
  })();
  const listRows = listContas.map(c => {
    const banco = dispoBanco(c.bancoId);
    const d = dispoEnsureDados(c);
    const logo = banco ? dispoLogoUrl(banco) : '';
    const fb   = banco ? dispoLogoFallback(banco) : '';
    const ini  = banco ? dispoBancoInitials(banco) : '?';
    const logoHtml = logo
      ? `<img class="dispo-banco-logo" src="${logo}" data-fb="${fb||''}" data-ini="${esc(ini)}" data-bc="${esc((banco&&banco.color)||'#E5E7EB')}" onerror="dispoLogoImgFallback(this)">`
      : `<span class="dispo-banco-initials" style="background:${(banco&&banco.color)||'#E5E7EB'}">${esc(ini)}</span>`;
    const nomeBanco = banco ? esc(banco.nome) : '<em style="color:#9CA3AF">Sem banco</em>';
    const codigo = banco ? (banco.codigo || '') : '';
    const contaDig = (d.conta || '') + ((d.conta && d.digito) ? '-' + d.digito : (d.digito ? '-' + d.digito : ''));
    const pixLabel = d.pix
      ? (d.pixTipo ? `<span class="dispo-dados-list-pixtipo">${esc(d.pixTipo.toUpperCase())}</span> ${esc(d.pix)}`
                   : esc(d.pix))
      : '<span class="dispo-dados-list-empty">—</span>';
    // dblclick no nome → abre detalhe só dessa conta/banco.
    // Também exibimos um botão "Editar" flutuante que aparece no hover.
    const openCall = `openDispoContaDetail(${c.id})`;
    return `
    <div class="dispo-dados-list-row clickable${c.ativo?'':' inat'}" data-bnc="${esc(c.bancoId||'')}"
         ondblclick="${openCall}">
      <div class="dispo-dados-list-banco">
        <div class="dispo-dados-logo">${logoHtml}</div>
        <div class="dispo-dados-list-name">${nomeBanco}${c.ativo?'':'<span class="dispo-dados-inat" style="margin-left:6px">inativa</span>'}</div>
        <span class="dispo-dados-list-edit" aria-hidden="true" title="Duplo-clique para editar os dados detalhados">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 113 3L7 19l-4 1 1-4 12.5-12.5z"/>
          </svg>
        </span>
      </div>
      <div class="dispo-dados-list-cod">
        ${banco
          ? `<input value="${esc(codigo)}" placeholder="000" maxlength="4"
                    onchange="setDispoBancoCodigo('${esc(banco.id)}', this.value)"
                    ondblclick="event.stopPropagation()" onclick="event.stopPropagation()"
                    title="Código Compe do banco (editável)">`
          : '<span class="dispo-dados-list-empty">—</span>'}
      </div>
      <div class="dispo-dados-list-ag">${d.agencia ? esc(d.agencia) : '<span class="dispo-dados-list-empty">—</span>'}</div>
      <div class="dispo-dados-list-cc">${contaDig ? esc(contaDig) : '<span class="dispo-dados-list-empty">—</span>'}</div>
      <div class="dispo-dados-list-pix">${pixLabel}</div>
    </div>`;
  }).join('');
  body.innerHTML = `
    <p class="dispo-mgr-intro">
      Preencha os dados bancários (agência, conta, PIX, titular, etc.) de cada conta. <strong>Duplo-clique</strong> no nome do banco para editar os dados detalhados.
    </p>
    <div class="dispo-dados-listview">
      <div class="dispo-dados-list-head">
        <div>Banco</div><div>Nº do banco</div><div>Agência</div><div>Conta + Dígito</div><div>PIX</div>
      </div>
      ${listRows}
    </div>`;
}

