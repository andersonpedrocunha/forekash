    for(let idx = atIdxDe; idx <= atIdxAte; idx++){
      const y = String(Math.floor(idx/12));
      const m = idx % 12;
      const g = comissaoVendedorMes(v, y, m) || 0;
      const p = vendedorComissaoPagaMes(v, y, m) || 0;
      const naoPago = Math.max(0, g - p);
      if(idx < cutoffIdx) atrasoVend += naoPago;
      else                previsaoVend += naoPago;
    }
    totalVendaMes   += vendaMes;
    totalGeradaMes  += comMes;
    totalPagaMes    += pagaMes;
    totalAtraso     += atrasoVend;
    totalPrevisao   += previsaoVend;
    if(v.ativo !== false) nAtivos++;
    if(vendaMes > 0){
      allVends.push({ nome: v.nome || '(sem nome)', valor: vendaMes, com: comMes });
    }
    const regraTxt = regrasAtivas.length > 0
      ? regrasAtivas.map(regra => (
          (regra.modo === 'escalonado'
              ? 'Escalonado'
