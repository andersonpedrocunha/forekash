// Helper: gera lista de YMs no período do filtro
function _anaPeriodYms(){
  const out = [];
  _anaIterPeriodo((y, m, ym) => out.push(ym));
  return out;
}
function _anaPeriodLabels(){
  return _anaPeriodYms().map(_anaPeriodoLabel);
}
// Helper: identifica o índice do "mês atual" no array de yms (corte real/projeção).
// Se nenhum mês do filtro está no presente/passado, retorna -1 (tudo é projeção).
// Se todos estão no passado, retorna o último índice (nada é projeção).
function _anaCurMonthIdx(yms){
  const today = new Date();
  const curYm = today.getFullYear() + '-' + String(today.getMonth()+1).padStart(2,'0');
  let lastReal = -1;
  for(let i = 0; i < yms.length; i++){
    if(yms[i] <= curYm) lastReal = i;
  }
  return lastReal;
}
// Splitta um array em [realArr, projArr] pra renderizar como duas séries Chart.js.
// real: valor em meses ≤ atual, null nos demais.
// proj: null em meses < atual; no mês atual, repete o valor real (ponte); depois, valores reais.
function _anaSplitRealProj(serie, yms){
  const cut = _anaCurMonthIdx(yms);
  const real = serie.map((v, i) => i <= cut ? v : null);
  const proj = serie.map((v, i) => {
    if(cut < 0)        return v;        // tudo projeção
    if(i < cut)        return null;
    if(i === cut)      return v;        // ponte
    return v;
  });
  // Se não há nenhum projeção (cut === serie.length-1), retorna proj=null array
  const allReal = (cut === serie.length - 1);
  return { real, proj: allReal ? serie.map(()=>null) : proj, cut };
}

function _anaSeriesPorMes(facts, modulo){
  const yms = _anaPeriodYms();
  const map = new Map(yms.map(ym => [ym, 0]));
  for(const f of facts){
    if(modulo && f.modulo !== modulo) continue;
    if(map.has(f.ym)) map.set(f.ym, map.get(f.ym) + (parseFloat(f.valor)||0));
  }
  return yms.map(ym => map.get(ym) || 0);
}

