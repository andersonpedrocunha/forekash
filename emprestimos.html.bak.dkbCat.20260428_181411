// DRAG & DROP — Reordenar linhas de empréstimos
// ═══════════════════════════════════════════════════
let _loanDragId = null;
function loanRowDragStart(ev, id){
  _loanDragId = id;
  try { ev.dataTransfer.effectAllowed = 'move'; } catch(e){}
  try { ev.dataTransfer.setData('text/plain', String(id)); } catch(e){}
  const tr = ev.currentTarget;
  tr.classList.add('loan-dragging');
}
function loanRowDragEnd(ev){
  const tr = ev.currentTarget;
  if(tr) tr.classList.remove('loan-dragging');
  tr.removeAttribute('draggable');
  // Limpa indicadores visuais em todas as linhas
  document.querySelectorAll('#loan-body tr.loan-drop-before, #loan-body tr.loan-drop-after')
    .forEach(r => r.classList.remove('loan-drop-before','loan-drop-after'));
  _loanDragId = null;
}
function loanRowDragOver(ev){
  if(_loanDragId == null) return;
  ev.preventDefault();
  try { ev.dataTransfer.dropEffect = 'move'; } catch(e){}
  const tr = ev.currentTarget;
  // Decide se a drop seria ANTES ou DEPOIS baseado na posição do mouse
  const rect = tr.getBoundingClientRect();
  const mid = rect.top + rect.height/2;
  const isBefore = ev.clientY < mid;
  // Limpa indicadores de outras linhas
  document.querySelectorAll('#loan-body tr.loan-drop-before, #loan-body tr.loan-drop-after')
    .forEach(r => { if(r !== tr) r.classList.remove('loan-drop-before','loan-drop-after'); });
  tr.classList.toggle('loan-drop-before', isBefore);
  tr.classList.toggle('loan-drop-after',  !isBefore);
}
function loanRowDragLeave(ev){
  // Só remove se saiu da própria tr (e não entrou em child)
  const tr = ev.currentTarget;
  if(!tr.contains(ev.relatedTarget)){
    tr.classList.remove('loan-drop-before','loan-drop-after');
  }
}
function loanRowDrop(ev, targetId){
  ev.preventDefault();
  const tr = ev.currentTarget;
  const isBefore = tr.classList.contains('loan-drop-before');
  tr.classList.remove('loan-drop-before','loan-drop-after');
  if(_loanDragId == null || _loanDragId === targetId) return;
  const fromIdx = loans.findIndex(l => l.id === _loanDragId);
  const toIdxOrig = loans.findIndex(l => l.id === targetId);
  if(fromIdx < 0 || toIdxOrig < 0) return;
  // Remove o elemento origem e insere antes/depois do alvo
  const [moved] = loans.splice(fromIdx, 1);
  let toIdx = loans.findIndex(l => l.id === targetId);
  if(!isBefore) toIdx += 1;
  loans.splice(toIdx, 0, moved);
  try { saveData(); } catch(e){}
  try { histCommit('reordenar empréstimos'); } catch(e){}
  render();
  try { if(typeof toast === 'function') toast('✅ Ordem atualizada'); } catch(e){}
}

