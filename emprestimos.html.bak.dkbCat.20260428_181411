// Infere uma explicação útil pra um número com base no contexto (texto que vem antes).
// Retorna string ou null (se não houver explicação útil — nesse caso, não mostra tooltip).
function diagExplainNumber(match, preCtx){
  const pre = (preCtx||'').toLowerCase();
  const m = match;
  // R² — sempre explica
  if(/R²/.test(m)) return 'R² (coef. de determinação). >0,7 é forte, 0,4–0,7 moderado, <0,4 fraco. Mede o quanto o modelo explica a variação real.';
  // σ (sigmas) — sempre explica
  if(/σ/.test(m))  return 'Desvios padrão em relação à média histórica. Acima de 2σ é estatisticamente atípico (menos de 5% de chance de ser ruído).';
  // BRL
  if(/^R\$/i.test(m)){
    if(/runway/.test(pre))                          return 'Saldo em caixa disponível no momento da análise — alimenta o cálculo do runway.';
    if(/ticket\s+m[eé]dio|ticket\s+medio/.test(pre)) return 'Ticket médio = Receita total do período ÷ número de clientes ativos.';
    if(/burn|queima/.test(pre))                      return 'Queima de caixa mensal = média de saída líquida dos últimos 3 meses.';
    if(/folha|sal[aá]rio|remunera|pessoas/.test(pre))return 'Folha = salários + encargos (INSS/FGTS) + benefícios do período.';
    if(/estrutura\s+fixa|custos?\s+fix|opex/.test(pre))return 'Custos fixos mensais (aluguel, software, terceiros, etc.).';
    if(/imposto|tribut|carga/.test(pre))             return 'Impostos calculados pelo regime tributário atual.';
    if(/concentra|top\s+cliente|maior\s+cliente/.test(pre))return 'Receita vinda desse cliente no período — base do cálculo de concentração de carteira.';
    if(/receita\s+(anual|total|do|no|dos)|faturam/.test(pre))return 'Soma de todos os lançamentos de receita no período analisado.';
    if(/proje[çc]|pr[oó]xim/.test(pre))              return 'Projeção mensal do ensemble (Regressão Linear + Holt) sobre a série histórica.';
    if(/intervalo|confian[çc]a|±|\+\/-/.test(pre))   return 'Margem de erro a ~80% de confiança (1,5× o RMSE do modelo).';
    if(/dispon|saldo\s+banc/.test(pre))              return 'Saldo agregado das contas bancárias ativas.';
    if(/ltv/.test(pre))                              return 'LTV (Lifetime Value) simplificado = receita acumulada do cliente desde o início do contrato.';
    return null;
  }
  // Percentuais
  if(/%/.test(m) || /p\.p\./.test(m)){
    if(/churn/.test(pre))                            return 'Churn = clientes que deixaram o contrato no período ÷ base ativa no início do período.';
    if(/margem\s+l[iI][qQ]|margem\s+l/.test(pre))    return 'Margem líquida = (Receita − Custos totais) ÷ Receita × 100.';
    if(/margem\s+(ebit|operac)/.test(pre))           return 'Margem operacional = (Receita − Custos operacionais) ÷ Receita × 100.';
    if(/margem\s+contrib/.test(pre))                 return 'Margem de contribuição = (Receita − Custos variáveis) ÷ Receita.';
    if(/concentra|top\s+cliente/.test(pre))          return 'Participação desse cliente na receita total do período.';
    if(/carga\s+tribut|imposto/.test(pre))           return 'Impostos totais ÷ Receita bruta × 100.';
    if(/folha\s+s?\/?r|folha\s+sobre|folha\s+vs|folha.*receita/.test(pre))return 'Folha total ÷ Receita do período × 100.';
    if(/delta|varia[çc]|cresc|alta|subiu|aument/.test(pre))return 'Variação vs. período anterior (trimestre ou mês, conforme a seção).';
    if(/queda|redu[çc]|cai|baixa|diminui/.test(pre)) return 'Redução vs. período anterior.';
    if(/aliqu|alíquo/.test(pre))                     return 'Alíquota efetiva do tributo no regime atual.';
    if(/cresc.*mes|ao\s+mes|a\.m\./.test(pre))       return 'Taxa mensal composta.';
    if(/r\u00b2|ajust/.test(pre))                    return 'Qualidade do ajuste do modelo expressa como %.';
    return null;
  }
  // Meses
  if(/meses?\b/.test(m)){
    if(/runway|caixa\s+durar|durar.*caixa|reserv/.test(pre))return 'Meses de caixa restante no ritmo atual de burn — quanto maior, mais folga operacional.';
    if(/pr[oó]x|seguin|frente|proje[çc]/.test(pre))  return 'Horizonte da projeção do modelo — ensemble extrapola os próximos meses a partir da série histórica.';
    if(/dso|cobran|receb/.test(pre))                 return 'Tempo médio entre faturamento e recebimento.';
    if(/tempo|relacion|contrato|cliente/.test(pre))  return 'Tempo de relacionamento do cliente com a empresa.';
    return null;
  }
  return null;
}

// Envolve números-chave em <span class="diag-num">; só adiciona data-calc quando
// consegue inferir uma explicação útil pelo contexto (caso contrário, fica só o destaque visual).
function diagWrapNumbers(html){
  if(!html) return html;
  const tokens = diagTokenizeHtml(html);
  const out = [];
  let textBuf = '';
  let skipDepth = 0;
  // Regex única: R² | R$ valor | % ou p.p. | σ | meses. Ordem no alternador importa.
  const NUM_RE = /(R²\s*=\s*\d+(?:[.,]\d+)?|R\$\s*-?[\d.,]+(?:\s*(?:mil|mi|M|k|bi))?|-?\d+(?:[.,]\d+)?\s*(?:%|p\.p\.)|\d+(?:[.,]\d+)?\s*σ|\b\d+(?:[.,]\d+)?\s*meses?\b)/g;
  const wrapText = (t) => {
    return t.replace(NUM_RE, (match, _p1, offset, full) => {
      const pre = full.slice(Math.max(0, offset-80), offset);
      const explain = diagExplainNumber(match, pre);
      const attr = explain ? ` data-calc="${explain.replace(/"/g,'&quot;')}"` : '';
      return `<span class="diag-num"${attr}>${match}</span>`;
    });
  };
  const flush = () => {
    if(!textBuf){ return; }
    out.push(wrapText(textBuf));
    textBuf = '';
  };
  for(const tok of tokens){
    if(tok[0] === '<'){
      // Detecta entrada/saída em um <span class="diag-num"> já existente → pula
      if(/^<span[^>]*class="[^"]*diag-num[^"]*"/i.test(tok)) skipDepth++;
      else if(/^<\/span>/i.test(tok) && skipDepth>0) skipDepth--;
      if(skipDepth > 0){
        if(textBuf){ out.push(textBuf); textBuf=''; }
        out.push(tok);
        continue;
      }
      flush();
      out.push(tok);
    } else {
      textBuf += tok;
    }
  }
  flush();
  return out.join('');
}

// Aciona animação "pulse" em cada .diag-num recém-inserido no `root`, em cascata.
function diagAnimateNumsIn(root){
  if(!root) return;
  const nums = root.querySelectorAll('.diag-num:not(.pulsed)');
  nums.forEach((el, i) => {
    el.classList.add('pulsed');
    setTimeout(()=>{
      el.classList.add('pulse');
      setTimeout(()=>el.classList.remove('pulse'), 1300);
    }, i*45);
  });
}

// Atualiza a barra de progresso no topo do relatório (0..1)
function diagProgressUpdate(pct){
  const bar = document.getElementById('diag-progress');
  const fill= document.getElementById('diag-progress-fill');
  const lbl = document.getElementById('diag-progress-lbl');
  if(!bar || !fill) return;
  if(pct >= 1){
    fill.style.width = '100%';
    if(lbl) lbl.textContent = 'concluído';
    setTimeout(()=>{ bar.classList.remove('on'); }, 600);
    return;
  }
  bar.classList.add('on');
  fill.style.width = Math.round(pct*100)+'%';
  if(lbl) lbl.textContent = Math.round(pct*100)+'%';
}

// Copia análise completa como texto pro clipboard
function diagCopyAnalysis(){
  if(!diagLastResult) return;
  const { snap, ind, alerts, nar, passos } = diagLastResult;
  const h = diagHealthLabel(ind.score);
  const dt = new Date(snap.ts).toLocaleString('pt-BR',{dateStyle:'long',timeStyle:'short'});
  const stripHtml = s => (s||'').replace(/<[^>]+>/g,'').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&#39;/g,"'");
  const section = (title, arr) => title + '\n' + (arr||[]).map(p=>'- '+stripHtml(p)).join('\n') + '\n';
  const txt =
`DIAGNÓSTICO FINANCEIRO
Gerado em: ${dt}

SAÚDE: ${h.label} — Score ${ind.score}/100
${h.desc}

ALERTAS (${alerts.length}):
${alerts.map(a=>`- [${a.sev.replace('sev-','').toUpperCase()}] ${a.title}: ${stripHtml(a.msg)}`).join('\n')}

${section('RECEITA E PRECIFICAÇÃO', nar.precif)}
${section('CUSTOS E ESTRUTURA', nar.custos)}
${section('PESSOAS E CONTRATAÇÃO', nar.pes)}
${section('FLUXO DE CAIXA', nar.fluxo)}
${section('PRINCIPAIS RISCOS', nar.riscos)}

PRÓXIMOS PASSOS:
${passos.map((p,i)=>`${i+1}. ${stripHtml(p)}`).join('\n')}
`;
  const btn = document.getElementById('diag-copy-btn');
  try{
    navigator.clipboard.writeText(txt).then(()=>{
      if(btn){ btn.classList.add('ok'); btn.querySelector('span').textContent='Copiado!'; setTimeout(()=>{ btn.classList.remove('ok'); btn.querySelector('span').textContent='Copiar'; }, 1800); }
    });
  }catch(e){
    // fallback textarea
    const ta = document.createElement('textarea');
    ta.value = txt; document.body.appendChild(ta); ta.select();
    try{ document.execCommand('copy'); }catch(_){}
    document.body.removeChild(ta);
    if(btn){ btn.classList.add('ok'); btn.querySelector('span').textContent='Copiado!'; setTimeout(()=>{ btn.classList.remove('ok'); btn.querySelector('span').textContent='Copiar'; }, 1800); }
