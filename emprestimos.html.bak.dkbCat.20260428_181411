const KEY_MODULE = 'taller_active_module';

// ════════════════════════════════════════════════
// Configurador CAC v2 — granular por ITEM + % absorção
// Inclui despesas (estrutura) E pessoas (folha)
// Chaves: forekash_cac_v2_v1 (nova) — migra de cac_tags_v1 (antiga)
// ════════════════════════════════════════════════
const CAC_KEY = 'forekash_cac_v2_v1';
const CAC_KEY_OLD = 'forekash_cac_tags_v1';
let _cacConfig = {
  itens: {},      // { "<itemId>": { default: %, overrides: {YYYY-MM: %} } }
  pessoas: {},    // { "<personId>": { default: %, overrides: {YYYY-MM: %} } }
  periodOffset: 0,
  expandedTags: {},  // { tagId: bool } — UI state
  expandedRows: {}   // { 'item:<id>' | 'pessoa:<id>': bool }
};
function _cacLoad(){
  try {
    const raw = localStorage.getItem(CAC_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && typeof obj === 'object'){
        _cacConfig.itens   = (obj.itens && typeof obj.itens === 'object') ? obj.itens : {};
        _cacConfig.pessoas = (obj.pessoas && typeof obj.pessoas === 'object') ? obj.pessoas : {};
        _cacConfig.periodOffset = (typeof obj.periodOffset === 'number') ? obj.periodOffset : 0;
        _cacConfig.expandedTags = (obj.expandedTags && typeof obj.expandedTags === 'object') ? obj.expandedTags : {};
        _cacConfig.expandedRows = (obj.expandedRows && typeof obj.expandedRows === 'object') ? obj.expandedRows : {};
        return;
      }
    }
    // Migração v1 → v2: se existe a chave antiga, converte
    const oldRaw = localStorage.getItem(CAC_KEY_OLD);
    if(oldRaw){
      const oldObj = JSON.parse(oldRaw);
      if(oldObj && Array.isArray(oldObj.tags) && typeof estrutura !== 'undefined' && estrutura.itens){
        // Pra cada tag marcada antes, marca todos os itens da tag em 100%
        for(const it of estrutura.itens){
          if(oldObj.tags.includes(it.tagId)) _cacConfig.itens[it.id] = 100;
        }
        if(typeof oldObj.periodOffset === 'number') _cacConfig.periodOffset = oldObj.periodOffset;
        _cacSave();
      }
    }
  } catch(e){ console.warn('cac load:', e); }
}
function _cacSave(){
  try { localStorage.setItem(CAC_KEY, JSON.stringify(_cacConfig)); }
  catch(e){ console.error('cac save:', e); }
}
function _cacMesKey(){
  const offset = _cacConfig.periodOffset || 0;
  const d = new Date();
  d.setMonth(d.getMonth() + offset);
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
}
function _cacPeriodOpts(){
  const opts = [];
  const now = new Date();
  for(let i = 0; i >= -12; i--){
    const d = new Date(now.getFullYear(), now.getMonth() + i, 1);
    const lbl = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'][d.getMonth()] + '/' + String(d.getFullYear()).slice(2);
    opts.push({ value: i, label: lbl });
  }
  return opts;
}
// Migração on-the-fly: número → { default, closed:{} } | overrides → closed
function _cacEnsureObj(map, id){
  let v = map[id];
  if(typeof v === 'number'){
    v = { default: Math.max(0, Math.min(100, v)), closed: {} };
    map[id] = v;
  } else if(!v || typeof v !== 'object'){
    return null;
  }
  if(typeof v.default !== 'number') v.default = 0;
  // Migra 'overrides' antigo → 'closed'
  if(v.overrides && typeof v.overrides === 'object' && !v.closed){
    v.closed = v.overrides;
    delete v.overrides;
  }
  if(!v.closed || typeof v.closed !== 'object') v.closed = {};
  return v;
}
function _cacItemPctDefault(itemId){
  const v = _cacEnsureObj(_cacConfig.itens, itemId);
  return v ? Math.max(0, Math.min(100, v.default || 0)) : 0;
}
// Retorna o snapshot fechado pra aquele mês, ou null se aberto
function _cacItemPctClosed(itemId, mesKey){
  const v = _cacEnsureObj(_cacConfig.itens, itemId);
  if(!v) return null;
  const c = v.closed[mesKey];
  return (typeof c === 'number' && isFinite(c)) ? Math.max(0, Math.min(100, c)) : null;
}
// % efetiva: se mês fechado usa snapshot, senão usa default
function _cacItemPctEff(itemId, mesKey){
  const c = _cacItemPctClosed(itemId, mesKey);
  return (c !== null) ? c : _cacItemPctDefault(itemId);
}
function _cacItemClosedCount(itemId){
  const v = _cacConfig.itens[itemId];
  if(!v || typeof v !== 'object' || !v.closed) return 0;
  return Object.keys(v.closed).length;
}
function _cacPessoaPctDefault(personId){
  const v = _cacEnsureObj(_cacConfig.pessoas, personId);
  return v ? Math.max(0, Math.min(100, v.default || 0)) : 0;
}
function _cacPessoaPctClosed(personId, mesKey){
  const v = _cacEnsureObj(_cacConfig.pessoas, personId);
  if(!v) return null;
  const c = v.closed[mesKey];
  return (typeof c === 'number' && isFinite(c)) ? Math.max(0, Math.min(100, c)) : null;
}
function _cacPessoaPctEff(personId, mesKey){
  const c = _cacPessoaPctClosed(personId, mesKey);
  return (c !== null) ? c : _cacPessoaPctDefault(personId);
}
function _cacPessoaClosedCount(personId){
  const v = _cacConfig.pessoas[personId];
  if(!v || typeof v !== 'object' || !v.closed) return 0;
  return Object.keys(v.closed).length;
}
// Aliases retrocompatíveis
function _cacItemPct(itemId){ return _cacItemPctDefault(itemId); }
function _cacPessoaPct(personId){ return _cacPessoaPctDefault(personId); }
// Aliases pra código antigo que usava Override/HasOverrides
function _cacItemPctOverride(itemId, mesKey){ return _cacItemPctClosed(itemId, mesKey); }
function _cacItemHasOverrides(itemId){ return _cacItemClosedCount(itemId); }
function _cacPessoaPctOverride(personId, mesKey){ return _cacPessoaPctClosed(personId, mesKey); }
function _cacPessoaHasOverrides(personId){ return _cacPessoaClosedCount(personId); }
function _cacTotalEstrutura(mesKey){
  if(typeof estrutura === 'undefined' || !estrutura.itens) return 0;
  let total = 0;
  for(const it of estrutura.itens){
    const pct = _cacItemPctEff(it.id, mesKey);
    if(pct === 0) continue;
    const v = (it.valores && it.valores[mesKey]) || 0;
    total += (parseFloat(v) || 0) * pct / 100;
  }
  return total;
}
function _cacTotalPessoas(mesKey){
  if(typeof pessoas === 'undefined' || !pessoas || !pessoas.people) return 0;
  let total = 0;
  for(const p of pessoas.people){
    const pct = _cacPessoaPctEff(p.id, mesKey);
    if(pct === 0) continue;
    const v = (typeof pesEffVal === 'function') ? pesEffVal(p, mesKey) : ((p.salarios && p.salarios[mesKey]) || 0);
    total += (parseFloat(v) || 0) * pct / 100;
  }
  return total;
}
function _cacNovosClientes(mesKey){
  if(typeof receita === 'undefined' || !receita.itens) return 0;
  const [ano, mes] = mesKey.split('-').map(n => parseInt(n, 10));
  const atuais = new Set(), anteriores = new Set();
  for(const it of receita.itens){
    const ent = (it.cliente || it.entidade || '').trim();
    if(!ent || !it.valores) continue;
    for(const k of Object.keys(it.valores)){
      const v = parseFloat(it.valores[k]) || 0;
      if(v <= 0) continue;
      const [a, m] = k.split('-').map(n => parseInt(n, 10));
      if(a === ano && m === mes) atuais.add(ent);
      else if(a < ano || (a === ano && m < mes)) anteriores.add(ent);
    }
  }
  let novos = 0;
  atuais.forEach(c => { if(!anteriores.has(c)) novos++; });
  return novos;
}

function renderCacConfig(){
  _cacLoad();
