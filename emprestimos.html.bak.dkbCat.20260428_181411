function recRenderKanban(){
  _recRenderKbToolbar();
  const board = document.getElementById('rec-kb-board');
  if(!board) return;
  board.classList.toggle('is-compact3', !!_recKbSettings.compact3);
  const cards = _recKbCells();
  const buckets = {};
  for(const col of REC_KB_COLS) buckets[col.id] = [];
  for(const c of cards){
    let cls = _recKbClassify(c);
    if(_recKbSettings.compact3 && (cls === 'mes' || cls === 'semana')) cls = 'vencer';
    if(buckets[cls]) buckets[cls].push(c);
  }
  for(const id of Object.keys(buckets)){
    buckets[id].sort((a,b) => {
      if(id === 'recebido'){
        if(a.year !== b.year) return b.year - a.year;
        return b.m - a.m;
      }
      if(a.year !== b.year) return a.year - b.year;
      return a.m - b.m;
    });
  }
  const colsToRender = _recKbSettings.compact3
    ? REC_KB_COLS.filter(c => c.id !== 'mes' && c.id !== 'semana')
    : REC_KB_COLS;
  let html = '';
  for(const col of colsToRender){
    const list = buckets[col.id];
    const total = list.reduce((s,c) => s + c.valor, 0);
    const nameLbl = _recKbColName(col.id);
    html += '<div class="rec-kb-col" data-st="' + col.id + '"'
      + ' ondragover="_recKbDragOver(event)"'
      + ' ondragleave="_recKbDragLeave(event)"'
      + ' ondrop="_recKbDrop(event,\''+ col.id + '\')">'
      + '<div class="rec-kb-col-hd">'
      +   '<span class="name">' + col.icon + ' ' + _recKbEsc(nameLbl) + '</span>'
      +   '<span class="count" title="' + list.length + ' card(s) · total ' + (typeof fmtBRL === 'function' ? fmtBRL(total) : total.toFixed(2)) + '">'
      +     list.length + ' · ' + (typeof fmtBRL === 'function' ? fmtBRL(total) : total.toFixed(2))
      +   '</span>'
      + '</div>'
      + '<div class="rec-kb-col-bd">';
    if(list.length === 0){
      html += '<div class="rec-kb-empty">Vazio</div>';
    } else {
      const S = _recKbSettings;
      const _fmtDate = (s) => {
        if(!s || s.length < 10) return s || '';
        return s.slice(8,10) + '/' + s.slice(5,7) + '/' + s.slice(2,4);
      };
      for(const c of list){
        const ym = _recKbFmtMes(c.year, c.m);
        const fmtVal = typeof fmtBRL === 'function' ? fmtBRL(c.valor) : ('R$ ' + c.valor.toFixed(2));
        const paisInfo = c.pais && typeof lookupPaisByName === 'function' ? lookupPaisByName(c.pais) : null;
        const flag = paisInfo ? paisInfo.flag : '';
        let paisPill = '';
        if(S.showPais !== false && c.pais){
          paisPill = '<span class="pill">' + (flag ? '<span class="flag">' + flag + '</span>' : '🌎 ') + _recKbEsc(c.pais) + '</span>';
        }
        let notasCount = 0, notasPreview = '';
        if(Array.isArray(c.notas)){
          notasCount = c.notas.length;
          if(notasCount > 0){
            const lastN = c.notas[c.notas.length - 1] || {};
            notasPreview = lastN.text || (lastN.anexo ? ('📎 ' + (lastN.anexo.name||'')) : '');
          }
        } else if(typeof c.notas === 'string' && c.notas.trim()){
          notasCount = 1;
          notasPreview = c.notas;
        }
        const notasPill = (S.showNotas !== false && notasCount > 0) ? '<span class="pill notas" title="' + _recKbEsc(notasPreview) + '">📝 ' + notasCount + '</span>' : '';
        const docPill = (S.showDoc !== false && c.numeroDocumento) ? '<span class="pill doc" title="Nº do Documento: ' + _recKbEsc(c.numeroDocumento) + '">🧾 ' + _recKbEsc(c.numeroDocumento) + '</span>' : '';
        const refPill = (S.showRefMes !== false) ? '<span class="pill">📅 ' + ym + '</span>' : '';
        const vencPill = (S.showVencimento && c.dataVencimento) ? '<span class="pill" title="Vencimento: ' + _recKbEsc(_fmtDate(c.dataVencimento)) + '">📆 ' + _recKbEsc(_fmtDate(c.dataVencimento)) + '</span>' : '';
        const descHtml = (S.showDescricao !== false && c.desc) ? '<div class="rec-kb-card-desc">' + _recKbEsc(c.desc) + '</div>' : '';
        const valHtml = (S.showValor !== false) ? '<div class="rec-kb-card-val">' + fmtVal + '</div>' : '';
        const metaHtml = (refPill || vencPill || paisPill || docPill || notasPill)
          ? '<div class="rec-kb-card-meta">' + refPill + vencPill + paisPill + docPill + notasPill + '</div>'
          : '';
        html += '<div class="rec-kb-card" data-st="' + col.id + '" draggable="true"'
          + ' onclick="recKbCardOpen(' + c.year + ',\''+ c.mesAbbr + '\',' + c.rowId + ')"'
          + ' ondragstart="_recKbCardDragStart(event,' + c.year + ',\''+ c.mesAbbr + '\',' + c.rowId + ')"'
          + ' ondragend="_recKbCardDragEnd(event)">'
          + '<div class="rec-kb-card-name"><span class="dot" style="background:' + c.color + '"></span>' + _recKbEsc(c.nome) + '</div>'
          + descHtml
          + metaHtml
          + valHtml
          + '</div>';
      }
    }
    html += '</div></div>';
  }
  board.innerHTML = html;
}
