    if(m0 && repCount >= 1){
      const y0 = parseInt(m0[1],10), mo0 = parseInt(m0[2],10)-1, d0 = parseInt(m0[3],10);
      for(let i=0;i<repCount;i++){
        const ymo = mo0 + i*fObj.mes;
        const yi = y0 + Math.floor(ymo/12);
        const mi = ((ymo % 12) + 12) % 12;
        const lastD = new Date(yi, mi+1, 0).getDate();
        const di = Math.min(d0, lastD);
        datasGeradas.push(yi + '-' + String(mi+1).padStart(2,'0') + '-' + String(di).padStart(2,'0'));
      }
    } else {
      datasGeradas.push(data);
    }
    // Cria grupoId compartilhado se houver mais de 1 item OU mais de 1 data
    const isGrouped = (itensList.length > 1) || (datasGeradas.length > 1);
    const grupoId = isGrouped ? ('g:' + Date.now() + ':' + Math.floor(Math.random()*9999)) : null;
    let okCount = 0;
    let lastTarget = null;
    let lastRef = null;
    // Para cada (data × item):
    //  - Se categoria tem catmap entry com moduloId='extrato', cria SÓ manual em extratoData
    //  - Senão, dispara auto-propagação (estrutura/receita)
    for(const di of datasGeradas){
      for(const it of itensList){
        const itemCatNome = it.categoria || catFinal;
        const cmEntry = (typeof catmapFindByNome === 'function') ? catmapFindByNome(itemCatNome) : null;
        const isExtratoOnly = !!(cmEntry && cmEntry.moduloId === 'extrato');
        if(isExtratoOnly){
          // Cria manual em extratoData.lancamentos
          const id = extratoData.nextId++;
          extratoData.lancamentos.push({
            id,
            data: di,
            valor: it.valor,
            descricao: it.descricao || desc,
            categoria: itemCatNome,
            contraparte: it.contraparte || counter,
            conta,
            status: (di === data ? status : 'pendente'),
            notas,
            tipo,
            centroCustoId,
            grupoId: grupoId,
            dataPagamento: (di === data ? dataPag : ''),
            criadoEm: new Date().toISOString()
          });
          okCount++;
          lastTarget = 'extrato';
          continue;
        }
        const propResult = _extAutoPropagate({
          tipo,
          data: di,
          valor: it.valor,
          descricao: it.descricao || desc,
          categoria: itemCatNome,
          contraparte: it.contraparte || counter,
          conta,
          status: (di === data ? status : 'pendente'),
          notas, tipo, centroCustoId,
          dataPagamento: (di === data ? dataPag : ''),
          grupoId: grupoId
        });
        if(propResult && propResult.propagated){
          okCount++; lastTarget = propResult.target; lastRef = propResult.ref;
        }
      }
    }
    if(okCount > 0){
      _extSave();
      extCloseModal();
      renderExtrato();
      if(typeof toast === 'function'){
        const lblMod = lastTarget === 'estrutura' ? 'Estrutura de Custos'
                     : lastTarget === 'extrato' ? 'Extrato Financeiro'
                     : 'Receita';
        if(okCount === 1){
          const detalhe = lastRef && lastRef.tagNome ? (' (tag: ' + lastRef.tagNome + ')')
                       : (lastRef && lastRef.cliNome ? (' (cliente: ' + lastRef.cliNome + ')') : '');
          toast('✓ Lançado em ' + lblMod + detalhe);
        } else if(itensList.length > 1 && datasGeradas.length === 1){
          toast('✓ ' + itensList.length + ' itens criados em ' + lblMod);
        } else {
          toast('✓ ' + okCount + ' lançamentos criados em ' + lblMod);
        }
      }
      return;
    }
  }

  if(_extEditingId){
    const realId = parseInt(_extEditingId.replace(/^m:/, ''), 10);
    const l = extratoData.lancamentos.find(x => x.id === realId);
    if(l){
      Object.assign(l, { data, valor, descricao:desc, categoria:catFinal, contraparte:counter, conta, status, notas, tipo, centroCustoId });
      if(status === 'pago' && !l.dataPagamento) l.dataPagamento = data;
      if(status !== 'pago') l.dataPagamento = '';
    }
  } else {
    const id = extratoData.nextId++;
    extratoData.lancamentos.push({
      id, data, valor, descricao:desc, categoria:catFinal, contraparte:counter, conta, status, notas, tipo, centroCustoId,
      grupoId: (typeof grupoId !== 'undefined' && grupoId) ? grupoId : null,
      dataPagamento: dataPag,
      criadoEm: new Date().toISOString()
    });
  }
  _extSave();
  extCloseModal();
  renderExtrato();
  if(typeof toast === 'function') toast('✓ Lançamento salvo');
}
