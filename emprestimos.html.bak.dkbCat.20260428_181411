// Calcula arrSaldoFinal[12] pra um ano — replica EXATAMENTE a fórmula do Demonstrativo
// (renderFlxSheet → arrSaldoFinal): saldoIni a partir do mês âncora, acumulando
// arrSaldoMes que inclui Receita − (Folha+Despesas+Emp+Imp+ImpParc−CustomOp−CustomFin)
// + Crédito + Outras − OutrasDesp + AjustesCustom.
function _anaFlxSaldoFinalAno(year){
  const arrSaldoMes = new Array(12).fill(0);
  for(let m = 0; m < 12; m++){
    let receita = 0, folha = 0, desp = 0, emp = 0, imp = 0, impParc = 0;
    let custOp = 0, custFin = 0, custAjustes = 0;
    let cred = 0, outras = 0, outrasDesp = 0;
    try {
      if(typeof flxReceitaMes === 'function')      receita = flxReceitaMes(year, m) || 0;
      if(typeof flxFolhaMes === 'function')        folha   = flxFolhaMes(year, m) || 0;
      if(typeof flxDespesasMes === 'function')     desp    = flxDespesasMes(year, m) || 0;
      if(typeof flxEmprestimosMes === 'function')  emp     = flxEmprestimosMes(year, m) || 0;
      if(typeof flxImpostoMes === 'function')      imp     = flxImpostoMes(year, m) || 0;
      // parcelamentos de impostos
      try { if(typeof flxImpParcelamentoMes === 'function') impParc = flxImpParcelamentoMes(year, m) || 0; } catch(e){}
      // custom rows (operacional, financeiro, ajustes de caixa)
      if(typeof flxCustomSecaoMes === 'function'){
        try { custOp     = flxCustomSecaoMes('custos_op',     year, m) || 0; } catch(e){}
        try { custFin    = flxCustomSecaoMes('financeiro',    year, m) || 0; } catch(e){}
        try { custAjustes= flxCustomSecaoMes('ajustes_caixa', year, m) || 0; } catch(e){}
      }
      if(typeof flxCreditoMes === 'function')     cred       = flxCreditoMes(year, m) || 0;
      if(typeof flxOutrasMes === 'function')      outras     = flxOutrasMes(year, m) || 0;
      if(typeof flxOutrasDespMes === 'function')  outrasDesp = flxOutrasDespMes(year, m) || 0;
    } catch(e){}
    const custoTotal = folha + desp + emp + imp + impParc - custOp - custFin;
    const result = receita - custoTotal;
    arrSaldoMes[m] = result + cred + outras - outrasDesp + custAjustes;
  }
  let saldoIni = 0, siMes = 0;
  try {
    if(typeof flxSaldoInicialVal === 'function') saldoIni = flxSaldoInicialVal(year) || 0;
    if(typeof flxSaldoInicialMesVal === 'function') siMes  = flxSaldoInicialMesVal(year) || 0;
  } catch(e){}
  const arrSaldoFinal = new Array(12).fill(null);
  let acc = saldoIni;
  for(let m = 0; m < 12; m++){
    if(m < siMes) continue; // antes da âncora: sem saldo
    acc += arrSaldoMes[m];
    arrSaldoFinal[m] = acc;
  }
  return { arrSaldoFinal, arrSaldoMes, saldoIni, siMes };
}

function _anaChRender_saldo(facts, _canvas){
  const ctx = _canvas || document.getElementById('ana-chart-saldo');
  if(!ctx) return;
  const _key = (ctx.id || 'saldo');
  _anaDestroyChart(_key);
  const yms = _anaPeriodYms();
  const labels = _anaPeriodLabels();
  // Saldo REAL: snapshot das contas em cada mês (de Disponibilidades)
  const realData = yms.map(ym => {
    let s = 0;
    if(typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.contas)){
      for(const c of dispo.contas) s += parseFloat((c.saldos||{})[ym]) || 0;
    }
    return s;
  });
  // Identifica corte: último mês com saldo real (>0 ou registrado)
  // Estratégia: usa _anaCurMonthIdx pra cortar no mês atual
  const cut = _anaCurMonthIdx(yms);
  // SOURCE-OF-TRUTH: a linha "Fluxo de Caixa" (arrSaldoFinal) do Demonstrativo,
  // tanto pra realizado quanto pra projeção. Assim os valores BATEM exatamente
  // com o que aparece no módulo Demonstrativo.
  const yearCache = {};
  const getSaldoFinal = (yStr, mIdx) => {
    if(!yearCache[yStr]) yearCache[yStr] = _anaFlxSaldoFinalAno(yStr);
    return yearCache[yStr].arrSaldoFinal[mIdx];
  };
  // Substitui realData pelos valores do Demonstrativo (não usa mais snapshot do dispo)
  const flxData = yms.map(ym => {
    const [yStr, mStr] = ym.split('-');
    return getSaldoFinal(yStr, parseInt(mStr,10) - 1);
  });
  // Split visual: real até o cut, projeção depois
  const realFinal = flxData.map((v, i) => i <= cut ? v : null);
  const projData = flxData.map((v, i) => {
    if(cut < 0) return v;          // tudo projeção
    if(i < cut)  return null;
    if(i === cut) return v;        // ponte com a linha real
    return v;
  });
  _anaChartInstances[_key] = new Chart(ctx, {
    type:'line', data:{ labels, datasets:[
      { label:'Realizado', data:realFinal, borderColor:ANA_CH_COLOR.dispo,
        backgroundColor:'rgba(245,158,11,.15)', fill:true, tension:.3, borderWidth:2.5,
        pointRadius:3, pointBackgroundColor:ANA_CH_COLOR.dispo, spanGaps:false },
      { label:'Projeção (Demonstrativo)', data:projData, borderColor:ANA_CH_COLOR.dispo,
        backgroundColor:'rgba(245,158,11,.06)', fill:true, tension:.3, borderWidth:2,
        borderDash:[6,4], pointRadius:3, pointBackgroundColor:'#fff',
        pointBorderColor:ANA_CH_COLOR.dispo, pointBorderWidth:1.5, spanGaps:false }
    ]},
    options:{ ...ANA_CH_DEFAULTS,
      plugins:{ ...ANA_CH_DEFAULTS.plugins,
        tooltip:{ callbacks:{ label:c => ' ' + c.dataset.label + ': ' + fmtBRL(c.raw) } },
        legend:{ display:true, position:'top', align:'end', labels:{ font:{size:10}, padding:6, usePointStyle:true, boxWidth:10 } } },
      scales:{ y:{ ticks:{ callback:v => fmtShort(v), font:{size:10} }, grid:{ color:'#F3F4F6' } },
               x:{ ticks:{ font:{size:10}, maxRotation:0 }, grid:{ display:false } } } }
  });
}
