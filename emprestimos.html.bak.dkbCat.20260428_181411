function ativoHintTxt(c, ativo){
  if(ativo){
    const n = clienteCiclos(c).length;
    return n > 1
      ? `Aparece com destaque nas planilhas. Cliente voltou em ${n-1} ${n-1===1?'oportunidade':'oportunidades'}.`
      : 'Aparece com destaque nas planilhas.';
  }
  // Inativo: procura o último ciclo encerrado
  const lst = clienteCiclos(c);
  let ultFim = '';
  for(const p of lst){
    if(p.fim && p.fim > ultFim) ultFim = p.fim;
  }
  return ultFim
    ? `Último ciclo encerrado em ${fmtDateBR(ultFim)}.`
    : 'Permanece no histórico, visualmente amortecido nas planilhas.';
}

