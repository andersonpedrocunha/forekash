      +   '</div>'
      + '</div></div>';
    return;
  }
  // mode === 'review'
  _viagOCRExtracted = extracted;
  const cat = (extracted && extracted.categoria) ? _viagCat(extracted.categoria) : null;
  const fmt = (typeof fmtBRL === 'function') ? fmtBRL : (n) => 'R$ ' + (n||0).toFixed(2);
  const fmtData = (s) => { if(!s) return ''; try{ const [y,m,dd]=s.split('-'); return dd+'/'+m+'/'+String(y).slice(2); }catch(e){return s;} };
  const row = (key, label, valHtml, hasVal) =>
    '<label class="viag-ocr-row' + (hasVal ? ' is-checked' : ' is-empty') + '">'
    + '<input type="checkbox" data-ocr-field="' + key + '"' + (hasVal ? ' checked' : ' disabled') + ' onchange="this.parentElement.classList.toggle(\'is-checked\', this.checked)">'
    + '<span class="viag-ocr-row-lbl">' + label + '</span>'
    + (hasVal ? '<span class="viag-ocr-row-val">' + valHtml + '</span>' : '<span class="viag-ocr-row-val empty">não detectado</span>')
    + '</label>';
  const anyFound = !!(extracted.valor || extracted.data || extracted.categoria || extracted.descricao);
  ov.innerHTML = '<div class="viag-ocr-card">'
    + '<div class="viag-ocr-hd"><span style="font-size:1.6rem">🪄</span>'
    +   '<div><h2>Resultado da leitura</h2><p>Revise o que foi detectado e marque o que aplicar</p></div>'
    +   '<button class="viag-ocr-x" onclick="document.getElementById(\'viag-ocr-modal\').remove()">✕</button>'
    + '</div>'
    + '<div class="viag-ocr-bd">'
    +   (anyFound ? '' : '<div style="padding:14px;background:#FEF3C7;border-left:3px solid #F59E0B;border-radius:6px;font-size:.82rem;color:#92400E;margin-bottom:14px">⚠ Não consegui extrair dados estruturados desta imagem. Veja o texto bruto abaixo e preencha manualmente se necessário.</div>')
    +   row('valor', 'Valor', extracted.valor != null ? fmt(extracted.valor) : '', extracted.valor != null)
    +   row('data', 'Data', extracted.data ? fmtData(extracted.data) : '', !!extracted.data)
    +   row('categoria', 'Categoria', cat ? (cat.icon + ' ' + cat.nome) : '', !!extracted.categoria)
    +   row('descricao', 'Descrição', extracted.descricao ? esc(extracted.descricao) : '', !!extracted.descricao)
    +   '<details class="viag-ocr-raw"><summary>Ver texto bruto reconhecido</summary><pre>' + esc(rawText || '(vazio)') + '</pre></details>'
    + '</div>'
    + '<div class="viag-ocr-foot">'
    +   '<button class="btn-cancel" onclick="document.getElementById(\'viag-ocr-modal\').remove()">Cancelar</button>'
    +   '<button class="btn-apply" onclick="viagAplicarOCR(' + d.id + ')"' + (anyFound ? '' : ' disabled') + '>✓ Aplicar selecionados</button>'
    + '</div>'
    + '</div>';
}
function viagAplicarOCR(despId){
  const v = _viagCurrent();
  if(!v || !v.despesas || !_viagOCRExtracted) return;
  if(_viagIsLocked(v)){ _viagToastLocked(); return; }
  const d = v.despesas.find(x => x.id === despId);
  if(!d) return;
  const checks = document.querySelectorAll('.viag-ocr-modal input[type="checkbox"][data-ocr-field]');
  let aplicados = 0;
  checks.forEach(c => {
    if(c.checked){
      const f = c.getAttribute('data-ocr-field');
      const val = _viagOCRExtracted[f];
      if(val != null && val !== ''){
        d[f] = val;
        aplicados++;
      }
    }
  });
  viagSave();
  _viagRenderEditor();
  const ov = document.getElementById('viag-ocr-modal');
  if(ov) ov.remove();
  _viagOCRExtracted = null;
  if(typeof toast === 'function') toast('🪄 ' + aplicados + ' campo(s) aplicado(s)');
}
