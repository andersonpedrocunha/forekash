    +   '<div class="cfg-cac-kpi"><div class="cfg-cac-kpi-lbl">Total no CAC</div><div class="cfg-cac-kpi-val">' + fmt(totalDesp) + '</div><div class="cfg-cac-kpi-sub">despesas + folha (com %)</div></div>'
