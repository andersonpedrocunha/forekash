function bdRender(){
  bdLoad();
  // KPIs do topo — esconde no Dashboard (a aba já tem KPIs próprios)
  const kpiRow = document.getElementById('bd-kpi-row');
  if(kpiRow) kpiRow.style.display = (_bdView === 'dash') ? 'none' : '';
