  renderDispoContaDetail();
  ov.classList.add('open');
}
function closeDispoContaDetail(){
  const ov = document.getElementById('ov-dispo-conta-detail');
  if(ov) ov.classList.remove('open');
  __dispoDetailBancoId = null;
  __dispoDetailCidFallback = null;
  // Re-renderiza a lista-resumo para refletir as mudanças feitas no detalhe
  const ovList = document.getElementById('ov-dispo-dados');
  if(ovList && ovList.classList.contains('open')){
    renderDispoDadosManager();
  }
  // Também re-renderiza a planilha principal (nomes/dados podem ter mudado)
  if(typeof renderDispo === 'function') renderDispo();
