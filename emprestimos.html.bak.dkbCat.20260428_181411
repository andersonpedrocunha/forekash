          borderRadius:{topRight:4,bottomRight:4,topLeft:0,bottomLeft:0} }
      ]
    },
    options:{ ...ANA_CH_DEFAULTS, indexAxis:'y',
      plugins:{ ...ANA_CH_DEFAULTS.plugins,
        tooltip:{ callbacks:{
          label:c => {
            const pctTotal = totalReceitaPeriodo > 0 ? (c.raw / totalReceitaPeriodo * 100) : 0;
            return ' ' + c.dataset.label + ': ' + fmtBRL(c.raw)
                 + ' (' + pctTotal.toFixed(1).replace('.',',') + '% da receita total)';
          },
          afterLabel:c => {
            if(c.datasetIndex === 1){
              const totalCli = (rec[c.dataIndex]||0) + (abe[c.dataIndex]||0);
              const pctCliTotal = totalReceitaPeriodo > 0 ? (totalCli / totalReceitaPeriodo * 100) : 0;
              const pctRecebido = totalCli > 0 ? (rec[c.dataIndex]/totalCli*100) : 0;
              return totalCli > 0
                ? '  ─────'
                + '\n  Total cliente: ' + fmtBRL(totalCli) + ' (' + pctCliTotal.toFixed(1).replace('.',',') + '% da receita total)'
                + '\n  ' + pctRecebido.toFixed(0) + '% já recebido'
                : '';
            }
            return '';
          }
        } },
        legend:{ display:true, position:'top', align:'end',
                  labels:{ font:{size:10}, padding:6, usePointStyle:true, boxWidth:10 } } },
      scales:{
        x:{ stacked:true, ticks:{ callback:v => fmtShort(v), font:{size:10} }, grid:{ color:'#F3F4F6' } },
        y:{ stacked:true, ticks:{ font:{size:10} }, grid:{ display:false } } } }
  });
}
function _anaChRender_ltv(facts, _canvas){
  const ctx = _canvas || document.getElementById('ana-chart-ltv');
  if(!ctx) return;
  const _key = (ctx.id || 'ltv');
  _anaDestroyChart(_key);
  // LTV proxy: SOMENTE receitas FECHADAS (status='recebido')
  // (receita média mensal por cliente, considerando só meses com recebimento) × 12
  const map = new Map();
  const monthsSeen = new Map();
  for(const f of facts){
    if(f.modulo !== 'receita') continue;
    if(f.categoria !== 'recebido') continue;  // só fechado
    const cur = map.get(f.entidade) || 0;
    map.set(f.entidade, cur + (parseFloat(f.valor)||0));
    if(!monthsSeen.has(f.entidade)) monthsSeen.set(f.entidade, new Set());
    monthsSeen.get(f.entidade).add(f.ym);
  }
  const ltvs = Array.from(map.entries()).map(([nome,total]) => {
    const mc = monthsSeen.get(nome).size || 1;
    const avgMes = total / mc;
    return { nome, ltv: avgMes * 12, total, mc };
  }).sort((a,b) => b.ltv - a.ltv).slice(0, 10);
  if(ltvs.length === 0){
    ctx.parentElement.innerHTML = '<div class="ana-chart-empty">Sem receitas <b>fechadas</b> (status recebido) pra calcular LTV.</div>';
    return;
  }
  // Atualiza subtitle pra deixar claro
  const card = ctx.closest('.ana-chart-card');
  const sub = card && card.querySelector('.ana-chart-sub');
  if(sub) sub.textContent = 'só receitas fechadas · média mensal × 12';
  _anaChartInstances[_key] = new Chart(ctx, {
    type:'bar', data:{
      labels: ltvs.map(l => l.nome),
      datasets:[{ label:'LTV (proxy)', data: ltvs.map(l => l.ltv),
                  backgroundColor:ANA_CH_COLOR.accent+'cc', borderColor:ANA_CH_COLOR.accent,
                  borderWidth:1, borderRadius:4 }]
    },
    options:{ ...ANA_CH_DEFAULTS, indexAxis:'y',
      plugins:{ ...ANA_CH_DEFAULTS.plugins,
        tooltip:{ callbacks:{ label:c => ' LTV: ' + fmtBRL(c.raw) + ' (' + ltvs[c.dataIndex].mc + ' meses fechados · total recebido ' + fmtBRL(ltvs[c.dataIndex].total) + ')' } },
        legend:{ display:false } },
      scales:{ x:{ ticks:{ callback:v => fmtShort(v), font:{size:10} }, grid:{ color:'#F3F4F6' } },
               y:{ ticks:{ font:{size:10} }, grid:{ display:false } } } }
  });
}
