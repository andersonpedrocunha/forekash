function _renderExtrModalReview(loanId, result){
  const bd = document.getElementById('extr-modal-bd');
  if(!bd) return;
  const md = document.querySelector('#extr-modal-ov .taxa-modal');
  const fmtPct = n => n.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:4}) + '%';
  const rows = [];
  const fieldRow = (key, label, icon, cands, formatCand) => {
    if(!cands || cands.length === 0) return '';
    const opts = cands.map((c, idx) =>
      '<option value="'+idx+'"'+(idx===0?' selected':'')+'>'+esc(formatCand(c))+'</option>'
    ).join('');
    const ctx0 = cands[0].context ? '<div class="extr-row-ctx">'+esc(cands[0].context)+'</div>' : '';
    const selHtml = cands.length > 1
      ? '<select class="extr-row-sel" data-field="'+key+'" onchange="_extrUpdateCtx(this)">'+opts+'</select>'
      : '<div class="extr-row-val">'+esc(formatCand(cands[0]))+'</div>';
    return (
      '<div class="extr-row" data-field="'+key+'">'+
        '<label class="extr-row-chk"><input type="checkbox" checked data-field-check="'+key+'"></label>'+
        '<div class="extr-row-lbl"><span class="extr-row-icon">'+icon+'</span>'+esc(label)+
        (cands.length>1?'<span class="extr-row-multi">'+cands.length+' candidatos</span>':'')+'</div>'+
        '<div class="extr-row-main">'+selHtml+ctx0+'</div>'+
      '</div>'
    );
  };
  rows.push(fieldRow('banco',      'Banco',            '🏦', result.banco,      c => c.label));
  rows.push(fieldRow('descricao',  'Descrição (linha)','📋', result.descricao,  c => c.label));
  rows.push(fieldRow('modalidade', 'Modalidade',       '⚙️',  result.modalidade, c => c.label));
  rows.push(fieldRow('valor',      'Valor Tomado',     '💰', result.valor,      c => 'R$ ' + c.label));
  rows.push(fieldRow('parcelaVal', 'Valor da Parcela', '💸', result.parcelaVal, c => 'R$ ' + c.label));
  rows.push(fieldRow('parcelas',   'Nº de Parcelas',   '🔢', result.parcelas,   c => c.label));
  rows.push(fieldRow('inicio',     'Data de Início',   '📅', result.inicio,     c => c.label));
  rows.push(fieldRow('termino',    'Data de Término',  '📆', result.termino,    c => c.label));
  rows.push(fieldRow('taxa',       'Juros (taxa mensal)', '📊', result.taxa,    c => {
    if(c.source === 'selic+spread' && c.selicUsada){
      return 'Selic ('+fmtPct(c.selicUsada.selicAnual)+' a.a.) + '+fmtPct(c.spread)+' = '+fmtPct(c.rate)+' a.a. ≈ '+fmtPct(c.rateMensalEquiv)+' a.m.';
    }
    if(c.source === 'selic+spread' && c.selicError){
      return 'Selic + '+fmtPct(c.spread)+' a.a. ⚠ '+c.selicError;
    }
    return (c.unit === 'a.a.')
      ? fmtPct(c.rate) + ' a.a. ≈ ' + fmtPct(c.rateMensalEquiv) + ' a.m.'
      : fmtPct(c.rate) + ' a.m.';
  }));
  const detected = rows.filter(r => r).length;
  if(detected === 0){
    _renderExtrModalError(loanId, 'Nenhum campo detectado no contrato.');
    return;
  }
  bd.innerHTML =
    '<p style="font-size:.72rem;color:var(--txl);margin:0 0 12px">Detectei '+detected+' campo'+(detected>1?'s':'')+'. '+
    'Desmarque o que não quiser aplicar. Em campos com múltiplos candidatos, escolha na lista.</p>'+
    rows.filter(r => r).join('');
  if(!md.querySelector('.taxa-modal-ft')){
    const ft = document.createElement('div'); ft.className = 'taxa-modal-ft';
    ft.innerHTML =
      '<span class="hint">Confirme antes de aplicar — extração automática pode errar.</span>'+
      '<div style="display:flex;gap:8px">'+
        '<button class="taxa-modal-cancel" onclick="closeExtrModal()">Cancelar</button>'+
        '<button class="taxa-modal-cancel" style="background:#6366F1;color:#fff;border-color:#6366F1;font-weight:800" onclick="_extrApply('+loanId+')">Aplicar selecionados</button>'+
      '</div>';
    md.appendChild(ft);
  }
  // Store result on window for access in click handlers
  window.__extrResult = result;
}
function _extrUpdateCtx(selEl){
  const idx = parseInt(selEl.value, 10);
  const field = selEl.getAttribute('data-field');
  const res = window.__extrResult && window.__extrResult[field];
  if(!res || !res[idx]) return;
  const row = selEl.closest('.extr-row');
  const ctx = row && row.querySelector('.extr-row-ctx');
  if(ctx) ctx.textContent = res[idx].context || '';
}
function _extrApply(loanId){
  const loan = loans.find(l => l.id === loanId);
  if(!loan) return;
  const res = window.__extrResult || {};
  const applied = [];
  const getSel = (field) => {
    const chk = document.querySelector('[data-field-check="'+field+'"]');
    if(!chk || !chk.checked) return null;
    const sel = document.querySelector('select[data-field="'+field+'"]');
    const idx = sel ? parseInt(sel.value, 10) : 0;
    const arr = res[field] || [];
    return arr[idx] || null;
  };
  // Aplicações
  const m_mod = getSel('modalidade'); if(m_mod){ loan.tipo = m_mod.value; applied.push('Modalidade'); }
  const m_par = getSel('parcelas');   if(m_par){ loan.parcelas = String(m_par.value); applied.push('Parcelas'); }
  const m_val = getSel('valor');      if(m_val){ loan.valor = m_val.value; applied.push('Valor'); }
  const m_pv  = getSel('parcelaVal'); if(m_pv){  loan.parcelaVal = m_pv.value; applied.push('Parcela'); }
  const m_ini = getSel('inicio');     if(m_ini){ loan.inicio = m_ini.value; applied.push('Início'); }
  const m_ter = getSel('termino');    if(m_ter){ loan.termino = m_ter.value; applied.push('Término'); }
  const m_des = getSel('descricao');  if(m_des){ loan.descricao = m_des.value; applied.push('Descrição'); }
  const m_bco = getSel('banco');      if(m_bco){ loan.bancoId = m_bco.value; applied.push('Banco'); }
  const m_tax = getSel('taxa');
  if(m_tax && m_tax.rateMensalEquiv){
    loan.taxa = Math.round(m_tax.rateMensalEquiv * 10000) / 10000;
    applied.push('Juros');
  }
  if(applied.length === 0){
    try { toast('Nenhum campo selecionado'); } catch(e){}
    return;
  }
  saveData();
  render();
  closeExtrModal();
  try { toast('✓ Aplicado: ' + applied.join(', ')); } catch(e){}
}

function saveField(id,field,rawVal){
  const loan=loans.find(l=>l.id===id); if(!loan)return;
  const parsed=parseBR(rawVal);
  if(field==='saldo'&&parsed!==''&&parsed!==parseBR(loan.saldo)){
    loan.saldoHist.push({val:parsed,prev:parseBR(loan.saldo)||0,ts:new Date().toISOString()});
    const meta=document.querySelector(`tr[data-id="${id}"] .saldo-meta`);
    if(meta)meta.innerHTML=buildMeta(loan.saldoHist,id,'saldo');
  }
  if(field==='parcelaVal'&&parsed!==''&&parsed!==parseBR(loan.parcelaVal)){
    loan.parcelaHist.push({val:parsed,prev:parseBR(loan.parcelaVal)||0,ts:new Date().toISOString()});
    const meta=document.querySelector(`tr[data-id="${id}"] .parcela-meta`);
    if(meta)meta.innerHTML=buildMeta(loan.parcelaHist,id,'parcela');
  }
  loan[field]=parsed!==''?parsed:'';
  saveData(); updateSummary();
}

function saveInt(id,field,val){
  const loan=loans.find(l=>l.id===id); if(!loan)return;
  const n=parseInt(val); loan[field]=isNaN(n)?'':n;
  saveData(); updateSummary();
  const total=parseInt(loan.parcelas)||0,pagas=parseInt(loan.parcelasPagas)||0;
  const pct=total>0?Math.min(100,(pagas/total)*100):0;
  const pb=document.querySelector(`tr[data-id="${id}"] .prog-fill`);
  const pl=document.querySelector(`tr[data-id="${id}"] .parc-lbl`);
  if(pb)pb.style.width=pct+'%';
  if(pl)pl.textContent=total>0?`${pagas} de ${total} pagas`:'';
}

