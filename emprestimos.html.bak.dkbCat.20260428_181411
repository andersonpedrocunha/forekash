    .ana-pres-table tr.is-neg td{color:#991B1B}
    .ana-pres-table tr.is-bold th, .ana-pres-table tr.is-bold td{font-weight:800;background:#F0FDFA;border-top:1px solid #99F6E4}
    .ana-pres-table tr.is-margem th, .ana-pres-table tr.is-margem td{background:#FAF5FF;color:#5B21B6;font-weight:700}
