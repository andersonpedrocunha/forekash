/* Fallback de logo: Clearbit → Google favicon → iniciais */
function dispoLogoImgFallback(img){
  const fb  = img.getAttribute('data-fb');
  const ini = img.getAttribute('data-ini') || '??';
  const bc  = img.getAttribute('data-bc')  || '#E5E7EB';
  // Segunda tentativa: favicon
  if(fb && img.src !== fb){
    img.src = fb;
    img.setAttribute('data-fb','');
    return;
  }
  // Última alternativa: círculo com iniciais
  const span = document.createElement('span');
  span.className = 'dispo-banco-initials';
  span.style.background = bc;
  span.textContent = ini;
  img.replaceWith(span);
}

function renderDispoAggRow(kind, label, contas, year, isFooter){
  const cells = DISPO_MESES.map((_,m) => {
    const key = dispoMesKey(year, m);
    let sum = 0, any = false;
    for(const c of contas){
      const v = c.saldos[key];
      if(v != null && v !== '' && !isNaN(+v)){ sum += +v; any = true; }
    }
    return `<td class="mes">${any ? fmtBRL(sum) : '<span style="color:#D1D5DB">—</span>'}</td>`;
  }).join('');
  return `<tr class="dispo-agg ${kind}">
    <td class="stk stk-1">${esc(label)}</td>
    <td class="stk stk-2"></td>
    <td class="stk stk-3"></td>
    ${cells}
    <td class="del"></td>
  </tr>`;
}

function renderDispoVarRow(contas, year){
  const totals = [];
  for(let m=0;m<12;m++){
    const key = dispoMesKey(year, m);
    let sum = 0, any = false;
    for(const c of contas){
      const v = c.saldos[key];
      if(v != null && v !== '' && !isNaN(+v)){ sum += +v; any = true; }
    }
    totals.push(any ? sum : null);
  }
  // % de variação vs mês anterior (ou dezembro do ano anterior)
  const prevYear = String(+year - 1);
  const decPrev = dispo.years.includes(prevYear)
    ? contas.reduce((s,c)=>{ const v=c.saldos[dispoMesKey(prevYear,11)]; return s + (v!=null&&!isNaN(+v)?+v:0); }, 0)
    : null;
  const cells = totals.map((t, m) => {
    const prev = m === 0 ? decPrev : totals[m-1];
    if(t == null || prev == null || prev === 0){
      return `<td class="mes zr">—</td>`;
    }
    const pct = ((t - prev) / Math.abs(prev)) * 100;
    const cls = pct > 0 ? 'up' : (pct < 0 ? 'dn' : 'zr');
    return `<td class="mes ${cls}">${(pct>0?'+':'') + fmtBR(pct,2) + '%'}</td>`;
  }).join('');
  return `<tr class="dispo-var">
    <td class="stk stk-1">% variação</td>
    <td class="stk stk-2"></td>
    <td class="stk stk-3"></td>
    ${cells}
    <td class="del"></td>
  </tr>`;
}

function updateDispoKpis(){
  const year = dispoCurYear();
  // Regra: se o ano selecionado é o ano corrente, a referência padrão é o MÊS ANTERIOR
  // ao atual — só usamos o mês atual quando ele já possui algum valor relevante (≠ 0).
  // Para outros anos, mantém o comportamento original (último mês com dados).
  const __now       = new Date();
  const __todayYear = String(__now.getFullYear());
  const __todayMon  = __now.getMonth();
  const __hasData = (y, m, requireNonZero) => {
    const key = dispoMesKey(y, m);
    return dispo.contas.some(c => {
      const v = c.saldos[key];
      if(v == null || v === '' || isNaN(+v)) return false;
      return requireNonZero ? (+v !== 0) : true;
    });
  };
  let lastIdx = -1;
  if(String(year) === __todayYear){
    if(__hasData(year, __todayMon, true)){
      lastIdx = __todayMon;
    } else {
      for(let m = __todayMon - 1; m >= 0; m--){
        if(__hasData(year, m, false)){ lastIdx = m; break; }
      }
    }
  } else {
    for(let m = 11; m >= 0; m--){
      if(__hasData(year, m, false)){ lastIdx = m; break; }
    }
  }
  let total = 0, caixa = 0, reserva = 0;
  if(lastIdx >= 0){
    const key = dispoMesKey(year, lastIdx);
    for(const c of dispo.contas){
      const v = c.saldos[key];
      if(v != null && v !== '' && !isNaN(+v)){
        const tp = dispoTipo(c.tipoId);
        total += +v;
        if(tp && tp.liquidez === 'reserva') reserva += +v; else caixa += +v;
      }
    }
  }
  // Variação mês atual vs anterior
  let varPct = null, varAbs = null, varLabel = '—';
  if(lastIdx >= 0){
    const key  = dispoMesKey(year, lastIdx);
    const pkey = lastIdx === 0
      ? (dispo.years.includes(String(+year-1)) ? dispoMesKey(String(+year-1), 11) : null)
      : dispoMesKey(year, lastIdx-1);
    if(pkey){
      let prev = 0, any = false;
      for(const c of dispo.contas){
        const v = c.saldos[pkey];
        if(v != null && v !== '' && !isNaN(+v)){ prev += +v; any = true; }
      }
      if(any && prev !== 0){
        varAbs = total - prev;
        varPct = ((total - prev) / Math.abs(prev)) * 100;
        varLabel = (varPct>0?'+':'') + fmtBR(varPct,2) + '%';
      }
    }
  }
  // Valores principais
  const elT = document.getElementById('dispo-kpi-total'); if(elT) elT.textContent = total ? fmtBRL(total) : 'R$ —';
  const elTs = document.getElementById('dispo-kpi-total-sub');
  if(elTs){
    // O mês já aparece no chip no canto superior direito do card, então o
    // subtítulo fica só pra mensagem de "sem dados" quando for o caso.
    elTs.textContent = lastIdx >= 0 ? '' : 'Sem dados lançados ainda';
  }
  // Chips de "mês de referência" DENTRO de cada card — compactos p/ caber no canto
  const refEls = document.querySelectorAll('.dispo-kpi-ref-val');
  if(refEls && refEls.length){
    let label = 'sem lançamentos';
    if(lastIdx >= 0){
      // Formato curto: "mar/2026" — cabe bem no chip do card
      let mesShort = '';
      try{
        mesShort = new Date(+year, lastIdx, 1)
          .toLocaleString('pt-BR', {month:'short'})
          .replace(/\./g,'').replace(/\s+de\s+/i,' ').trim();
      }catch(_){ mesShort = (DISPO_MESES[lastIdx] || '').toLowerCase(); }
      label = mesShort + '/' + year;
    }
    refEls.forEach(el => el.textContent = label);
  }
  const elC = document.getElementById('dispo-kpi-caixa');   if(elC) elC.textContent = caixa ? fmtBRL(caixa) : 'R$ —';
  const elR = document.getElementById('dispo-kpi-reserva'); if(elR) elR.textContent = reserva ? fmtBRL(reserva) : 'R$ —';

  // Barra de composição (caixa/reserva) no card total
  const base = (caixa || 0) + (reserva || 0);
  const pctC = base > 0 ? (caixa   / base) * 100 : 50;
  const pctR = base > 0 ? (reserva / base) * 100 : 50;
  const elBC = document.getElementById('dispo-kpi-bar-caixa');
  const elBR = document.getElementById('dispo-kpi-bar-reserva');
  if(elBC) elBC.style.flexBasis = pctC.toFixed(2) + '%';
  if(elBR) elBR.style.flexBasis = pctR.toFixed(2) + '%';
  const elPC = document.getElementById('dispo-kpi-pct-caixa');
  const elPR = document.getElementById('dispo-kpi-pct-reserva');
  if(elPC) elPC.textContent = base > 0 ? fmtBR(pctC, 0) + '%' : '—';
  if(elPR) elPR.textContent = base > 0 ? fmtBR(pctR, 0) + '%' : '—';

  // Card de variação — ajusta classe + ícone conforme sinal
  const card = document.getElementById('dispo-kpi-var-card');
  const iconBox = document.getElementById('dispo-kpi-var-icon');
  const elV  = document.getElementById('dispo-kpi-var');
  const elVs = document.getElementById('dispo-kpi-var-sub');
  const sign = (varPct == null) ? 'neu' : (varPct > 0.05 ? 'pos' : (varPct < -0.05 ? 'neg' : 'neu'));
  if(card){
    card.classList.remove('neg','neu','pos');
    if(sign !== 'pos') card.classList.add(sign);
  }
  if(iconBox){
    iconBox.innerHTML = sign === 'neg'
      ? '<svg viewBox="0 0 24 24"><path d="M23 18l-9.5-9.5-5 5L1 6"/><path d="M17 18h6v-6"/></svg>'
      : sign === 'neu'
        ? '<svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg>'
        : '<svg viewBox="0 0 24 24"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg>';
  }
  if(elV) elV.textContent = varLabel;
  if(elVs){
    if(varAbs != null){
      const pref = varAbs>=0 ? '+' : '';
      elVs.innerHTML = `<strong style="color:${sign==='pos'?'#059669':sign==='neg'?'#DC2626':'#6B7280'}">${pref}${fmtBRL(varAbs)}</strong> vs mês anterior`;
    } else {
      elVs.textContent = 'sem referência anterior';
    }
  }
}

/* ─── Edição de contas ──────────────────────────────────── */
function addDispoConta(){
  const nextId = dispo.contas.reduce((m,c)=>Math.max(m,c.id),0) + 1;
  dispo.contas.push({ id:nextId, bancoId:'', tipoId:'', ativo:true, saldos:{},
                      dados:{ agencia:'', conta:'', digito:'', titular:'', documento:'',
                              pix:'', pixTipo:'', gerente:'', gerenteEmail:'', gerenteTel:'', obs:'' } });
  dispoSave();
  renderDispo();
  // abre o picker de banco automaticamente
  setTimeout(()=>{
    const cell = document.querySelector(`[data-dispo-row="${nextId}"] .dispo-banco-cell`);
    if(cell) cell.click();
  }, 40);
}
async function delDispoConta(id){
  const c = dispo.contas.find(x=>x.id===id); if(!c) return;
  const banco = dispoBanco(c.bancoId);
  const tipo  = dispoTipo(c.tipoId);
  const nome = banco ? `${banco.nome}${tipo ? ' ('+tipo.abrev+')' : ''}` : '';
  const msg = nome
    ? `Remover a conta <strong>${esc(nome)}</strong> e todos os saldos mensais associados a ela?`
    : 'Remover esta conta?';
  const ok = await showConfirm({
    title: 'Excluir conta',
    message: msg,
    confirmLabel: 'Excluir conta', destructive: true
  });
  if(!ok) return;
  dispo.contas = dispo.contas.filter(x=>x.id!==id);
  dispoSave(); renderDispo();
}
function setDispoBanco(id, bancoId){
  const c = dispo.contas.find(x=>x.id===id); if(!c) return;
  c.bancoId = bancoId || '';
  dispoSave(); renderDispo();
}
function setDispoTipo(id, tipoId){
  const c = dispo.contas.find(x=>x.id===id); if(!c) return;
  c.tipoId = tipoId || '';
  dispoSave(); renderDispo();
}
function setDispoAtivo(id, val){
  const c = dispo.contas.find(x=>x.id===id); if(!c) return;
  c.ativo = !!val;
  dispoSave();
  renderDispo();
}

// Reorder Disponibilidades: só permite reordenar dentro da mesma liquidez (caixa/reserva)
// e do mesmo status ativo/inativo. Inativos ficam no fim de cada bloco.
function reorderDispoConta(srcId, dstId, placeAbove){
  const src = dispo.contas.find(c => String(c.id) === String(srcId));
  const dst = dispo.contas.find(c => String(c.id) === String(dstId));
  if(!src || !dst) return;
  const liq = c => { const tp = dispoTipo(c.tipoId); return (tp && tp.liquidez === 'reserva') ? 'reserva' : 'caixa'; };
  if(liq(src) !== liq(dst)) return;
  if((src.ativo !== false) !== (dst.ativo !== false)) return;
  if(arrayReorder(dispo.contas, src, dst, placeAbove)){
    dispoSave();
    renderDispo();
  }
}
ROW_REORDERERS.dispo = reorderDispoConta;
function setDispoSaldo(id, key, val){
  const c = dispo.contas.find(x=>x.id===id); if(!c) return;
  const num = parseBR(val);
  if(val === '' || val == null || isNaN(num)){
    delete c.saldos[key];
  } else {
    c.saldos[key] = num;
  }
  dispoSave();
  updateDispoKpis();
  // re-render para atualizar linhas agregadas
  renderDispoSheet();
}

/* ═══════════════════════════════════════════════════
   PICKERS (banco + tipo) — popups contextuais
   ═══════════════════════════════════════════════════ */
function closeDispoPickers(){
  document.querySelectorAll('.dispo-pick-pop').forEach(p => p.remove());
  document.removeEventListener('click', _dispoPickOutside, true);
}
function _dispoPickOutside(e){
  if(e.target.closest('.dispo-pick-pop')) return;
  if(e.target.closest('.dispo-banco-cell') || e.target.closest('.dispo-tipo-cell')) return;
  closeDispoPickers();
}
function _dispoMountPicker(anchorCell, pop){
  closeDispoPickers();
  document.body.appendChild(pop);
  const r = anchorCell.getBoundingClientRect();
  // posicionar relativo ao viewport (fixed)
  pop.style.position = 'fixed';
  pop.style.left = Math.max(8, r.left) + 'px';
  pop.style.top  = (r.bottom + 4) + 'px';
  // ajuste se ultrapassar a direita
  const pr = pop.getBoundingClientRect();
  if(pr.right > window.innerWidth - 8){
    pop.style.left = Math.max(8, window.innerWidth - pr.width - 8) + 'px';
  }
  setTimeout(()=> document.addEventListener('click', _dispoPickOutside, true), 0);
}

