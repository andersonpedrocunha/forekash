      +   '<button onclick="event.stopPropagation();anaSlideMoveDown(' + s.id + ')" ' + (isLast?'disabled':'') + ' title="Descer">↓</button>'
      +   '<button class="del" onclick="event.stopPropagation();anaSlideDelete(' + s.id + ')" title="Excluir">✕</button>'
      + '</div>'
      + '</div>';
  }).join('');
