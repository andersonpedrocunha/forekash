function renderPesSheet(){
  const thead = document.getElementById('pes-thead');
  const tbody = document.getElementById('pes-tbody');
  const tfoot = document.getElementById('pes-tfoot');
  if(!thead || !tbody || !tfoot) return;

  const year = pesActiveYear;

  // ─── HEAD (2 linhas: ano / mês) ───
  // Linha 1 (ano)
  const yrRow1 = `<tr class="yr">
    <th class="stk stk-1 l">Pessoa</th>
    <th class="stk stk-2">Ativo</th>
    <th class="stk stk-3 l">Tipo</th>
    <th class="stk stk-4 l">Último reajuste</th>
    <th colspan="12" style="text-align:center">${year}</th>
    <th class="yr-tot">Total</th>
    <th class="del"></th>
  </tr>`;
  // Linha 2 (meses)
  const mesCols = PES_MESES.map((m,i)=>{
    return `<th class="mes">${m.toUpperCase()}</th>`;
  }).join('');
  const yrRow2 = `<tr class="mo">
    <th class="stk stk-1"></th>
    <th class="stk stk-2"></th>
    <th class="stk stk-3"></th>
    <th class="stk stk-4"></th>
    ${mesCols}
    <th class="yr-tot">R$</th>
    <th class="del"></th>
  </tr>`;
  thead.innerHTML = yrRow1 + yrRow2;

  // ─── BODY ───
  // Ordena pessoas: primeiro por tipo (na ordem de pessoas.tipos), depois pelas sim no final
  const tipoOrder = new Map(pessoas.tipos.map((t,i)=>[t.id, i]));
  const includeSimInTotals = !!pessoas.includeSimInTotals;
  const realPeople = pessoas.people.filter(p => !p.sim && pesStatusMatch(p));
  const simPeople  = pessoas.people.filter(p =>  p.sim);
  // Pessoas consideradas nos totais do rodapé (Folha/Headcount/Δ)
  const totalsPeople = includeSimInTotals
    ? pessoas.people.filter(p => pesStatusMatch(p) || p.sim)
    : realPeople;
  realPeople.sort((a,b)=>{
    const ta = tipoOrder.has(a.tipoId) ? tipoOrder.get(a.tipoId) : 999;
    const tb = tipoOrder.has(b.tipoId) ? tipoOrder.get(b.tipoId) : 999;
    if(ta !== tb) return ta - tb;
    // ativos sempre acima dos inativos dentro do mesmo tipo
    const aa = a.ativo ? 0 : 1;
    const bb = b.ativo ? 0 : 1;
    if(aa !== bb) return aa - bb;
    return 0; // mantém ordem inserção dentro do subgrupo
  });

  // Agrupa por tipoId (consecutivos)
  const rowsHtml = [];
  if(realPeople.length === 0 && simPeople.length === 0){
    const f = pessoas.statusFilter || 'all';
    const totalReal = pessoas.people.filter(p=>!p.sim).length;
    let msg;
    if(totalReal === 0){
      msg = `Nenhuma pessoa cadastrada. Clique em <b>+ Nova pessoa</b> para começar.`;
    } else if(f === 'ativos'){
      msg = `Nenhuma pessoa ativa. <a href="#" onclick="event.preventDefault();setPesStatusFilter('all')" style="color:var(--blue-d);text-decoration:underline">Ver todas</a>.`;
    } else if(f === 'inativos'){
      msg = `Nenhuma pessoa inativa. <a href="#" onclick="event.preventDefault();setPesStatusFilter('all')" style="color:var(--blue-d);text-decoration:underline">Ver todas</a>.`;
    } else {
      msg = `Nenhuma pessoa cadastrada. Clique em <b>+ Nova pessoa</b> para começar.`;
    }
    rowsHtml.push(`<tr class="pes-empty-row"><td colspan="${4+12+2}">${msg}</td></tr>`);
  }
  // Itera por tipos na ordem definida. Cada pessoa aparece em APENAS UM grupo:
  // o do tipo principal (maior % OU preferido definido pelo usuário em caso de empate).
  // O salário mostrado é o TOTAL (não proporcional). A divisão fica documentada nas pills.
  for(const tipo of pessoas.tipos){
    // Lista: pessoas cujo tipo PRINCIPAL é este (aparecem como linhas aqui)
    const grp = realPeople.filter(p => pesTipoPrincipal(p) === tipo.id);
    // Contribuintes: qualquer um com pct > 0 nesse tipo (pra entrar no total com rateio)
    const hasContributor = realPeople.some(p => p.ativo && pesTiposDaPessoa(p).has(tipo.id));
    if(grp.length === 0 && !hasContributor) continue;
    rowsHtml.push(renderPesGroupHeader(tipo, grp, year, tipo.id, realPeople));
    for(const p of grp){
      rowsHtml.push(renderPesPersonRow(p, year, false, tipo.id));
    }
  }
  // Pessoas sem tipo principal válido (órfãs)
  const orphans = realPeople.filter(p => {
    const tp = pesTipoPrincipal(p);
    return !tipoOrder.has(tp);
  });
  if(orphans.length){
    rowsHtml.push(renderPesGroupHeader({id:'',nome:'Sem tipo',color:'#F3F4F6'}, orphans, year, ''));
    for(const p of orphans) rowsHtml.push(renderPesPersonRow(p, year, false, ''));
  }

  // Simulações
  if(simPeople.length){
    const incChecked = includeSimInTotals ? 'checked' : '';
    rowsHtml.push(`<tr class="pes-sep-row"><td colspan="${4+12+2}" style="background:#F3F4F6">
      <div class="pes-sim-sep-wrap">
        <span class="pes-sim-sep-title">✨ Simular Contratação</span>
        <span class="pes-sim-sep-hint">cenários hipotéticos (roxo)</span>
        <span class="pes-sim-sep-sp"></span>
        <label class="pes-sim-inc-toggle" title="Somar os salários simulados à Folha e ao Headcount">
          <input type="checkbox" ${incChecked} onchange="togglePesIncludeSim(this.checked)">
          <span class="pes-sim-toggle-track"><span class="pes-sim-toggle-thumb"></span></span>
          <span class="pes-sim-inc-lbl">Incluir nos totais</span>
        </label>
      </div>
    </td></tr>`);
    for(const p of simPeople) rowsHtml.push(renderPesPersonRow(p, year, true));
  }

  tbody.innerHTML = rowsHtml.join('');

  // ─── TFOOT: linha Headcount + linha Folha ───
  // Headcount por mês (pessoas ativas com salário > 0 OR apenas ativas? → ativas com qualquer salário marcado ou todas ativas)
  // Usaremos: pessoas ativas (independente de salário) no mês — considera "ativa" aquela com flag ativo=true
  // e que tenha salário > 0 no mês (permite representar admissão/saída via salário)
  const perMonth = PES_MESES.map((_,i)=>{
    const key = pesMesKey(year, i);
    let count = 0, tot = 0;
    for(const p of totalsPeople){
      if(!p.ativo) continue;
      const v = pesEffVal(p, key);
      if(v > 0){ count++; tot += v; }
    }
    return { count, tot };
  });
  const headcountCells = perMonth.map(x => `<td>${x.count||''}</td>`).join('');
  const folhaCells     = perMonth.map(x => `<td>${x.tot ? fmtShortBR(x.tot) : '—'}</td>`).join('');
  const totalFolha = perMonth.reduce((s,x)=>s+x.tot,0);
  const totalHeadAvg = perMonth.reduce((s,x)=>s+x.count,0) / 12;

  // Variação mês a mês (compara com mês anterior; para janeiro, com dez do ano anterior)
  const prevYear = String(parseInt(year, 10) - 1);
  let decPrev = 0;
  let totalFolhaPrev = 0;
  for(const p of totalsPeople){
    if(!p.ativo) continue;
    decPrev += pesEffVal(p, pesMesKey(prevYear, 11));
    for(let i=0; i<12; i++){
      totalFolhaPrev += pesEffVal(p, pesMesKey(prevYear, i));
    }
  }
  const varAbsCells = [];
  const varPctCells = [];
  let sumAbs = 0, sumPct = 0, validCount = 0;
  for(let i=0; i<12; i++){
    const cur = perMonth[i].tot;
    const prev = (i === 0) ? decPrev : perMonth[i-1].tot;
    if(!cur && !prev){
      varAbsCells.push(`<td class="zr">—</td>`);
      varPctCells.push(`<td class="zr">—</td>`);
      continue;
    }
    if(!prev){
      // Sem base de comparação (primeiro mês com valor)
      varAbsCells.push(`<td class="zr">—</td>`);
      varPctCells.push(`<td class="zr">—</td>`);
      continue;
    }
    const delta = cur - prev;
    const cls = delta > 0 ? 'up' : (delta < 0 ? 'dn' : 'zr');
    varAbsCells.push(`<td class="${cls}">${fmtDeltaAbs(delta)}</td>`);
    const pct = (delta / prev) * 100;
    varPctCells.push(`<td class="${cls}">${fmtDeltaPct(pct)}</td>`);
    sumAbs += delta;
    sumPct += pct;
    validCount++;
  }

  // Coluna do ano: soma das variações absolutas e média das variações percentuais
  let yrAbsCell = `<td class="yr-tot zr">—</td>`;
  let yrPctCell = `<td class="yr-tot zr">—</td>`;
  if(validCount > 0){
    const clsA = sumAbs > 0 ? 'up' : (sumAbs < 0 ? 'dn' : 'zr');
    yrAbsCell = `<td class="yr-tot ${clsA}" title="Soma das variações mensais em ${year}">${fmtDeltaAbs(sumAbs)}</td>`;
    const avgPct = sumPct / validCount;
    const clsP = avgPct > 0 ? 'up' : (avgPct < 0 ? 'dn' : 'zr');
    yrPctCell = `<td class="yr-tot ${clsP}" title="Média das variações mensais em ${year} (${validCount} ${validCount===1?'mês':'meses'})">${fmtDeltaPct(avgPct)}</td>`;
  }

  tfoot.innerHTML = `
    <tr class="head">
      <td class="stk stk-1 l">Headcount</td>
      <td class="stk stk-2"></td>
      <td class="stk stk-3"></td>
      <td class="stk stk-4"></td>
      ${headcountCells}
      <td class="yr-tot">méd ${totalHeadAvg.toFixed(1).replace('.',',')}</td>
      <td></td>
    </tr>
    <tr>
      <td class="stk stk-1 l">Folha</td>
      <td class="stk stk-2"></td>
      <td class="stk stk-3"></td>
      <td class="stk stk-4"></td>
      ${folhaCells}
      <td class="yr-tot" id="pes-ft-total">${fmtBRL(totalFolha)}</td>
      <td></td>
    </tr>
    <tr class="var">
      <td class="stk stk-1 l" title="Variação absoluta em relação ao mês anterior (coluna do ano: soma das 12 variações)">Δ Folha (R$)</td>
      <td class="stk stk-2"></td>
      <td class="stk stk-3"></td>
      <td class="stk stk-4"></td>
      ${varAbsCells.join('')}
      ${yrAbsCell}
      <td></td>
    </tr>
    <tr class="var">
      <td class="stk stk-1 l" title="Variação percentual em relação ao mês anterior (coluna do ano: média das 12 variações)">Δ Folha (%)</td>
      <td class="stk stk-2"></td>
      <td class="stk stk-3"></td>
      <td class="stk stk-4"></td>
      ${varPctCells.join('')}
      ${yrPctCell}
      <td></td>
    </tr>
  `;
}

function fmtDeltaAbs(n){
  if(!n) return '—';
  const s = Math.round(Math.abs(n)).toLocaleString('pt-BR');
  return (n > 0 ? '+' : '−') + s;
}
function fmtDeltaPct(pct){
  if(!pct || !isFinite(pct)) return '—';
  const s = Math.abs(pct).toFixed(1).replace('.',',');
  return (pct > 0 ? '+' : '−') + s + '%';
}

// Formatador mais curto para células (sem R$, sem casas decimais quando inteiro)
function fmtShortBR(n){
  if(!n || n === 0) return '—';
  // Se inteiro, formata sem decimais; caso contrário, com 0 casas (arredonda)
  return Math.round(n).toLocaleString('pt-BR');
}

function renderPesGroupHeader(tipo, grp, year, tipoId, allPeople){
  const color = tipo.color || '#F3F4F6';
  const count = grp.filter(p=>p.ativo).length;
  const _gTipoId = tipoId || tipo.id || '';
  // Contribuintes = todos que têm pct > 0 neste tipo (inclui quem está em outro grupo como principal).
  const contributors = (allPeople || grp).filter(p => {
    if(!p.ativo) return false;
    return pesTiposDaPessoa(p).has(_gTipoId);
  });
  // Total do grupo = soma de (salário × pct_no_tipo) — reflete o custo real rateado.
  const totalGrp = contributors.reduce((s,p)=>{
    let x = 0;
    for(let i=0;i<12;i++){
      const ym = pesMesKey(year, i);
      const pct = pesIsAlocacaoSimples(p) ? (pesTipoPrincipal(p) === _gTipoId ? 100 : 0)
                                          : pesPctMesTipo(p, ym, _gTipoId);
      x += pesEffVal(p, ym) * (pct/100);
    }
    return s + x;
  }, 0);
  const grpCells = PES_MESES.map((_,i)=>{
    const key = pesMesKey(year, i);
    const v = contributors.reduce((s,p)=>{
      const pct = pesIsAlocacaoSimples(p) ? (pesTipoPrincipal(p) === _gTipoId ? 100 : 0)
                                          : pesPctMesTipo(p, key, _gTipoId);
      return s + pesEffVal(p, key) * (pct/100);
    }, 0);
    return `<td>${v ? fmtShortBR(v) : '—'}</td>`;
  }).join('');
  // Indicador visual: soma de rateios vindos de OUTROS grupos (não-principais neste tipo)
  const hasRateio = contributors.some(p => !pesIsAlocacaoSimples(p) && pesTipoPrincipal(p) !== _gTipoId);
  const rateioHint = hasRateio
    ? ` <span title="Inclui rateio de pessoas listadas em outros grupos" style="font-size:.62rem;color:#92400E;font-weight:700">⇄ rateio</span>`
    : '';
  return `<tr class="grp" style="--grpBg:${color}">
    <td class="stk stk-1 l">${esc(tipo.nome||'Grupo')}</td>
    <td class="stk stk-2">${count}</td>
    <td class="stk stk-3">Total do grupo${rateioHint}</td>
    <td class="stk stk-4"></td>
    ${grpCells}
    <td class="yr-tot">${fmtBRL(totalGrp)}</td>
    <td></td>
  </tr>`;
}

function renderPesPersonRow(p, year, isSim, forTipoId){
  pesEnsureAlocacao(p);
  const isSimplesAloc = pesIsAlocacaoSimples(p);
  // `forTipoId` = contexto da linha quando a mesma pessoa aparece em múltiplos grupos.
  // Se não for passado, usa o tipo principal da pessoa (tipoId legacy).
  const rowTipoId = forTipoId || p.tipoId;
  const tipoOpts = pessoas.tipos.map(t=>
    `<option value="${esc(t.id)}"${p.tipoId===t.id?' selected':''}>${esc(t.nome)}</option>`
  ).join('');
  const t = pesTipo(rowTipoId);
  const tipoStyle = t ? `style="--tc:${t.color};--ttxt:${PES_TIPO_TXT}"` : '';
  const tipoCls = t ? 'filled' : 'empty';
  const indicatorColor = t ? t.color : '#E5E7EB';
  const nMesesCustom = pesMesesCustomizados(p);

  // Último reajuste (mesma lógica do card)
  const histR = computePesReajustes(p);
  const lastR = histR.length ? histR[histR.length-1] : null;
  let reajCellHtml;
  if(lastR){
    const [ry, rm] = lastR.key.split('-');
    const mesAbrev = PES_MESES[parseInt(rm,10)-1] || rm;
    const mesLabel = mesAbrev.charAt(0).toUpperCase() + mesAbrev.slice(1) + '/' + ry.slice(2);
    const titleLabel = pesKeyToLabel(lastR.key);
    const pctCls = lastR.pct > 0 ? 'up' : (lastR.pct < 0 ? 'dn' : 'zr');
    const pctStr = (lastR.pct > 0 ? '+' : (lastR.pct < 0 ? '−' : '')) +
                   Math.abs(lastR.pct).toFixed(1).replace('.',',') + '%';
    reajCellHtml = `<td class="stk stk-4 pes-reaj-cell" title="${esc(titleLabel)} — de ${fmtBRL(lastR.from)} para ${fmtBRL(lastR.to)}">
      <div class="pes-reaj-mes">${esc(mesLabel)}</div>
      <div class="pes-reaj-pct ${pctCls}">${pctStr}</div>
    </td>`;
  } else {
    reajCellHtml = `<td class="stk stk-4 pes-reaj-cell empty" title="Sem reajustes registrados">—</td>`;
  }

  // Salários por mês
  const simActive = pesReajSimActive();
  // Meses que são ponto de partida de alguma regra de reajuste desse tipo
  const simStartKeys = simActive
    ? new Set(pesReajSimAllRules().filter(r => r.tipoId === p.tipoId).map(r => r.key))
    : null;
  const pagosMap = p.pagos || {};
  const salCells = PES_MESES.map((_,i)=>{
    const key = pesMesKey(year, i);
    const base = p.salarios[key];
    const eff  = pesEffVal(p, key);
    const show = (base !== undefined && base !== null && base !== 0);
    const isReaj = !!pessoas.reajustes[key];
    const factor = simActive ? pesReajSimFactor(p, key) : 1;
    const isSimStart = !!(simActive && show && simStartKeys && simStartKeys.has(key));
    const displayVal = show ? fmtBR(eff, 2) : '';
    // Pago só aplicável a células com valor real, fora do modo simulação
    const pago = show && !simActive && !!pagosMap[key];
    const empty = !show;
    // Linhas simples sempre editáveis. (Split visual removido: pessoa aparece só
    // no tipo principal com salário cheio — o split fica documentado nas pills.)
    const isSplit = false;
    // Apenas o mês de virada recebe o fundo destacado.
    const tdCls = 'pes-cell'
                + (isReaj?' reaj':'')
                + (isSimStart?' sim':'')
                + (pago?' pago':'')
                + (empty?' empty':'');
    if(simActive){
      const pctTot = (factor - 1) * 100;
      const tip = factor !== 1
        ? `${isSimStart ? 'Mês do reajuste' : 'Valor pós-reajuste'} (+${pctTot.toFixed(2).replace('.',',')}%) — base ${show ? fmtBRL(base) : '—'}`
        : (show ? `Base ${fmtBRL(base)} — sem reajuste previsto até aqui` : 'Sem valor base');
      return `<td class="${tdCls}" title="${esc(tip)}">
        <input type="text" class="pes-sal-input sim-ro"
               value="${displayVal}"
               placeholder="—"
               data-pes-sal="${p.id}" data-pes-key="${key}"
               readonly tabindex="-1">
      </td>`;
    }
    const btnPagar = show && p.ativo && !isSplit
      ? `<button type="button" class="pes-pagar-btn" tabindex="-1"
              onmousedown="event.preventDefault()"
              onclick="event.stopPropagation(); togglePesPago(${p.id},'${key}')"
              title="${pago ? 'Marcar como não pago' : 'Marcar como pago'}">✓</button>`
      : '';
    // Linhas split (pct < 100) ficam readonly — salário base é editado na linha onde tipo=100%
    // ou via editor de alocação. Evita ambiguidade de qual valor atualizar.
    const ro = (pago || isSplit) ? ' readonly' : '';
    const roTitle = isSplit ? ' title="Split: ' + pctMes.toFixed(0) + '% do salário base · edite na aba principal ou pelo editor de alocação"'
                  : (pago ? ' title="Remova o ✓ para editar"' : '');
    const roClick = pago ? ' onmousedown="notifyLocked()"' : '';
    const splitCls = isSplit ? ' pes-split' : '';
    return `<td class="${tdCls}${splitCls}">
      <input type="text" class="pes-sal-input${isSplit?' is-split':''}"
             value="${displayVal}"
             placeholder="—"
             data-pes-sal="${p.id}" data-pes-key="${key}"
             data-cellref="pes:${p.id}:${key}"${ro}${roTitle}${roClick}
             onblur="setPesSalario(${p.id}, '${key}', this.value); this.value = (this.value && !isNaN(parseBR(this.value))) ? fmtBR(parseBR(this.value),2) : ''"
             onfocus="this.value = this.value.replace(/\\./g,''); this.select()"
             onkeydown="if(event.key==='Enter') this.blur()">
      ${btnPagar}
    </td>`;
  }).join('');

  // Total do ano — salário cheio (pessoa aparece só uma vez no grupo principal)
  let totalAno = 0;
  for(let i=0;i<12;i++){ totalAno += pesEffVal(p, pesMesKey(year,i)); }

  const cls = [];
  if(!p.ativo) cls.push('inat');
  if(isSim) cls.push('is-sim');

  const view = pesRegView(p);
  const nomeShow = view.nome || '';
  const btnCls   = nomeShow ? '' : ' empty';
  const btnLabel = nomeShow ? esc(nomeShow) : (isSim ? 'Selecionar candidato…' : 'Selecionar pessoa…');
  // Simulações não participam do reorder.
  const reorderAttrs = isSim ? '' : rowDragAttrs('pes', p.id, p.ativo, p.tipoId || '');
  return `<tr class="${cls.join(' ')}" data-pes-id="${p.id}" ${reorderAttrs}>
    <td class="stk stk-1">
      <div class="pes-first-wrap">
        ${isSim ? '' : rowHandleHtml()}
        <span class="pes-row-indicator" style="--rc:${indicatorColor}"></span>
        <button type="button" class="pes-info-btn"
                ondblclick="openPesCard(${p.id})"
                onclick="event.stopPropagation()"
                title="Duplo clique para ver detalhes">
          ${pesAvatarHtml(p, {tipoColor: indicatorColor, tipoTxt: PES_TIPO_TXT})}
        </button>
        <button type="button" class="rec-cli-btn${btnCls}"
                data-pes-picker="${p.id}"
                onclick="openPessoaPicker(${p.id}, this, event)">
          <span class="rec-cli-txt">${btnLabel}</span>
          <span class="rec-cli-caret">▾</span>
        </button>
      </div>
    </td>
    <td class="stk stk-2">
      <input type="checkbox" class="pes-sw" ${p.ativo?'checked':''}
             onchange="setPesAtivo(${p.id}, this.checked)"
             title="${p.ativo?'Pessoa ativa':'Pessoa inativa'}">
    </td>
    <td class="stk stk-3">
      ${(()=>{
        if(isSimplesAloc){
          return `<div class="pes-tipo-simples-wrap">
            <select class="pes-tipo-select ${tipoCls}" ${tipoStyle}
                    onchange="setPesTipo(${p.id}, this.value)">
              ${tipoOpts}
            </select>
            <button type="button" class="pes-tipo-split-btn"
                    onclick="event.stopPropagation();openPesAlocacaoEditor(${p.id})"
                    title="Dividir salário entre múltiplos tipos / customizar por mês">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.21 15.89A10 10 0 118 2.83"/>
                <path d="M22 12A10 10 0 0012 2v10z"/>
              </svg>
            </button>
          </div>`;
        }
        // Multi-tipo → mostra pills + botão de editar
        const pills = (p.alocacao.padrao || []).map(a => {
          const tp = pesTipo(a.tipoId);
          const color = tp ? tp.color : '#64748B';
          const nm = tp ? tp.nome : '(sem)';
          const isHighlighted = a.tipoId === rowTipoId;
          // Fundo em cor tingida (22%) + texto escurecido 78% pra contraste forte
          const bg = `color-mix(in srgb, ${color} 22%, white)`;
          const fg = `color-mix(in srgb, ${color} 78%, black)`;
          const bd = `color-mix(in srgb, ${color} 55%, transparent)`;
          return `<span class="pes-tipo-pill${isHighlighted?' is-current':''}" style="background:${bg};color:${fg};border-color:${bd}">
            ${esc(nm)} <b>${Math.round(a.pct)}%</b>
          </span>`;
        }).join('');
        const badgeMes = nMesesCustom > 0
          ? `<span class="pes-tipo-badge-mes" title="${nMesesCustom} mês(es) com alocação customizada">📅 ${nMesesCustom}</span>`
          : '';
        return `<div class="pes-tipo-multi" onclick="openPesAlocacaoEditor(${p.id})" title="Clique pra editar a alocação">
          <div class="pes-tipo-pills">${pills}</div>
          ${badgeMes}
        </div>`;
      })()}
    </td>
    ${reajCellHtml}
    ${salCells}
    <td class="pes-cell yr-tot">${fmtBRL(totalAno)}</td>
    <td>
      <div class="pes-row-actions">
        <button class="pes-row-btn dup" onclick="duplicatePesPessoa(${p.id})" title="Duplicar">
          <svg viewBox="0 0 24 24"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>
        </button>
        <button class="pes-row-btn delete" onclick="delPesPessoa(${p.id})" title="Remover">
          <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14z"/></svg>
        </button>
      </div>
    </td>
  </tr>`;
}

function updatePesTotals(){
  if(!pessoas) return;
  const year = pesActiveYear;
  const includeSim = !!pessoas.includeSimInTotals;
  const real = pessoas.people.filter(p => includeSim ? true : !p.sim);
  let folha = 0;
  let headSet = new Set();
  const perMonthActive = new Array(12).fill(0);
  for(const p of real){
    if(!p.ativo) continue;
    let hadAny = false;
    for(let i=0;i<12;i++){
      const v = pesEffVal(p, pesMesKey(year,i));
      if(v > 0){ folha += v; perMonthActive[i]++; hadAny = true; }
    }
    if(hadAny) headSet.add(p.id);
  }
  const mediaMensal = folha/12;
  const head = headSet.size;

  // Folha do mês atual (mês real de hoje, independente do ano ativo)
  const now = new Date();
  const curYear = String(now.getFullYear());
  const curMIdx = now.getMonth();
  const curKey  = pesMesKey(curYear, curMIdx);
  let folhaMes = 0;
  let folhaMesFatur = 0;
  let headMes  = 0;
  // Identifica tipos considerados "Força Faturável": id 'fatur' ou nome contendo "fatur"
  const faturTipoIds = new Set((pessoas.tipos||[])
    .filter(t => {
      if(t.id === 'fatur') return true;
      const nm = (t.nome||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
      return nm.includes('fatur');
    })
    .map(t => t.id));
  for(const p of real){
    if(!p.ativo) continue;
    const v = pesEffVal(p, curKey);
    if(v > 0){
      folhaMes += v;
      headMes++;
      if(faturTipoIds.has(p.tipoId)) folhaMesFatur += v;
    }
  }
  const pctFF = (folhaMes > 0) ? Math.round((folhaMesFatur / folhaMes) * 100) : 0;
  const mesNome = PES_MESES_LONG ? PES_MESES_LONG[curMIdx] : PES_MESES[curMIdx];

  const q = id => document.getElementById(id);
  if(q('pes-kpi-folha-mes')) q('pes-kpi-folha-mes').textContent = fmtBRL(folhaMes);
  if(q('pes-kpi-folha-mes-sub')){
    if(folhaMes > 0){
      const ffTip = `Força Faturável: ${fmtBRL(folhaMesFatur)} de ${fmtBRL(folhaMes)} (${pctFF}% da folha do mês)`;
      const ffChip = faturTipoIds.size > 0
        ? ` <span class="kpi-ff-chip" title="${ffTip.replace(/"/g,'&quot;')}">%FF ${pctFF}%</span>`
        : '';
      q('pes-kpi-folha-mes-sub').innerHTML =
        `${mesNome}/${curYear} • ${headMes} pessoa${headMes===1?'':'s'}${ffChip}`;
    } else {
      q('pes-kpi-folha-mes-sub').textContent =
        `sem salários lançados em ${mesNome}/${curYear}`;
    }
  }
  if(q('pes-kpi-folha')) q('pes-kpi-folha').textContent = fmtBRL(folha);

  // Variação vs ano anterior (Folha do Ano)
  const prevYear = String((+year) - 1);
  let folhaPrev = 0;
  for(const p of real){
    if(!p.ativo) continue;
    for(let i = 0; i < 12; i++){
      const vp = pesEffVal(p, pesMesKey(prevYear, i));
      if(vp > 0) folhaPrev += vp;
    }
  }
  const chip = q('pes-kpi-folha-var');
  const sub  = q('pes-kpi-folha-sub');
  if(chip){
    chip.classList.remove('up','down');
    if(folhaPrev > 0){
      const delta = folha - folhaPrev;
      const pct   = (delta / folhaPrev) * 100;
      const arrow = delta > 0 ? '▲' : (delta < 0 ? '▼' : '■');
      const sign  = delta > 0 ? '+' : (delta < 0 ? '−' : '');
      const pctAbs = Math.abs(pct);
      const pctStr = (pctAbs >= 100 ? pctAbs.toFixed(0) : pctAbs.toFixed(1)).replace('.',',');
      chip.textContent = `${arrow} ${sign}${pctStr}%`;
      chip.title = `${sign}${fmtBRL(Math.abs(delta))} vs ${prevYear} (${fmtBRL(folhaPrev)})`;
      if(delta > 0) chip.classList.add('up');
      else if(delta < 0) chip.classList.add('down');
    } else {
      chip.textContent = '';
      chip.title = '';
    }
  }
  if(sub){
    if(folhaPrev > 0){
      const delta = folha - folhaPrev;
      const sign  = delta >= 0 ? '+' : '−';
      sub.textContent = `vs ${prevYear}: ${sign}${fmtBRL(Math.abs(delta))}`;
    } else {
      sub.textContent = 'soma dos salários ativos';
    }
  }

  if(q('pes-kpi-media')) q('pes-kpi-media').textContent = fmtBRL(mediaMensal);
  if(q('pes-kpi-head'))  q('pes-kpi-head').textContent  = String(head);
  if(q('pes-kpi-head-sub')) q('pes-kpi-head-sub').textContent = head ? `pessoas ativas em ${year}` : 'sem headcount no ano';
  if(q('pes-ft-total')) q('pes-ft-total').textContent = fmtBRL(folha);

  // Card split Pago × Projetado
  // Usa p.salarios (valor base) como referência — ignora simulação/reajuste no card de pagamento
  let totalPago = 0;
  let totalProjetado = 0;
  for(const p of real){
    if(!p.ativo) continue;
    const pagos = p.pagos || {};
    for(let i = 0; i < 12; i++){
      const key = pesMesKey(year, i);
      const raw = p.salarios[key];
      const v = +raw || 0;
      if(!v) continue;
      if(pagos[key]) totalPago += v;
      else           totalProjetado += v;
    }
  }
  if(q('pes-kpi-pago'))       q('pes-kpi-pago').textContent       = fmtBRL(totalPago);
  if(q('pes-kpi-projetado'))  q('pes-kpi-projetado').textContent  = fmtBRL(totalProjetado);
}

