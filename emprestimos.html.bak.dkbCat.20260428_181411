// ═══ OCR — Extração de dados do recibo via Tesseract.js (rodando local no browser) ═══
let _viagOCRExtracted = null;
function viagExtrairDados(despId){
  const v = _viagCurrent();
  if(!v || !v.despesas) return;
  if(_viagIsLocked(v)){ _viagToastLocked(); return; }
  const d = v.despesas.find(x => x.id === despId);
  if(!d || !d.comprovante || !d.comprovante.data){
    if(typeof toast === 'function') toast('Anexe uma imagem primeiro');
    return;
  }
  if(!d.comprovante.type || !d.comprovante.type.startsWith('image/')){
    if(typeof toast === 'function') toast('OCR funciona só com imagens (PNG/JPG)');
    return;
  }
  _viagShowOCRModal(d, null, null, 'loading');
  // Carrega Tesseract.js sob demanda
  const loadScript = (typeof _anaLoadScript === 'function') ? _anaLoadScript : function(url, glob){
    return new Promise((res, rej) => {
      if(glob && window[glob]) return res();
      const s = document.createElement('script'); s.src = url; s.async = true;
      s.onload = () => res(); s.onerror = () => rej(new Error('Falhou: '+url));
      document.head.appendChild(s);
    });
  };
  loadScript('https://cdn.jsdelivr.net/npm/tesseract.js@5.0.4/dist/tesseract.min.js', 'Tesseract')
    .then(() => Tesseract.recognize(d.comprovante.data, 'por', {
        logger: (m) => {
          if(m.status === 'recognizing text'){
            const fill = document.getElementById('viag-ocr-fill');
            const pct = document.getElementById('viag-ocr-pct');
            if(fill) fill.style.width = Math.round(m.progress * 100) + '%';
            if(pct) pct.textContent = Math.round(m.progress * 100) + '%';
          }
        }
    }))
    .then(result => {
      const text = (result && result.data && result.data.text) || '';
      const extracted = _viagParseRecibo(text);
      _viagShowOCRModal(d, extracted, text, 'review');
    })
    .catch(err => {
      console.error('OCR falhou:', err);
      if(typeof toast === 'function') toast('❌ Falha no OCR — tente outra imagem');
      const ov = document.getElementById('viag-ocr-modal');
      if(ov) ov.remove();
    });
}
function _viagParseRecibo(text){
  const out = { valor: null, data: null, categoria: null, descricao: null };
  if(!text) return out;
  // VALOR — pega o maior valor R$ encontrado (geralmente o total)
  const valorMatches = text.match(/R\$?\s*(\d{1,3}(?:\.\d{3})*,\d{2})/g) || [];
  if(valorMatches.length > 0){
    const valores = valorMatches.map(m => {
      const n = m.replace(/R\$|\s/g, '').replace(/\./g, '').replace(',', '.');
      return parseFloat(n);
    }).filter(v => isFinite(v) && v > 0);
    if(valores.length > 0) out.valor = Math.max.apply(null, valores);
  }
  // Fallback: tenta padrão NN,NN sem R$
  if(out.valor == null){
    const semR = text.match(/\b(\d{1,4},\d{2})\b/g) || [];
    const valores = semR.map(m => parseFloat(m.replace(',', '.'))).filter(v => v > 0);
    if(valores.length > 0) out.valor = Math.max.apply(null, valores);
  }
  // DATA — DD/MM/YYYY ou DD/MM/YY ou DD-MM-YYYY
  const dataMatch = text.match(/\b(\d{2})[\/\-\.](\d{2})[\/\-\.](\d{2,4})\b/);
  if(dataMatch){
    let dd = dataMatch[1], mm = dataMatch[2], yy = dataMatch[3];
    if(yy.length === 2) yy = '20' + yy;
    if(parseInt(dd,10) >= 1 && parseInt(dd,10) <= 31 && parseInt(mm,10) >= 1 && parseInt(mm,10) <= 12){
      out.data = yy + '-' + mm + '-' + dd;
    }
  }
  // CATEGORIA — heurística por palavras-chave
  const lower = text.toLowerCase();
  if(/uber|taxi|táxi|99|cabify|metr[oôó]|trem|[oô]nibus|busao|bus|brt/.test(lower)) out.categoria = 'transporte';
  else if(/hotel|pousada|hostel|airbnb|hospedagem|resort|inn|booking/.test(lower)) out.categoria = 'hospedagem';
  else if(/restaurante|lanchonete|pizzaria|caf[eé]|bar|padaria|mcdon|burger|bk|pizza|sushi|self|comida/.test(lower)) out.categoria = 'alimentacao';
  else if(/posto|combust[ií]vel|gasolina|álcool|alcool|diesel|etanol|shell|petrobr|ipiranga|raiz/.test(lower)) out.categoria = 'combustivel';
  else if(/voo|a[eé]reo|a[eé]rea|passagem|gol|latam|azul|tap|delta|emirates|airlines|airways/.test(lower)) out.categoria = 'voo';
  else if(/ped[aá]gio|estacionamento|valet|park|estac\./.test(lower)) out.categoria = 'pedagio';
  else if(/ingresso|bilhete|entrada|ticket|evento|feira|congresso|show|cinema|teatro|museu/.test(lower)) out.categoria = 'ingressos';
  // DESCRIÇÃO — primeira linha com letras (geralmente é o nome do estabelecimento)
  const lines = text.split(/\n+/).map(l => l.trim()).filter(l => l.length > 3 && l.length < 80);
  const descCandidate = lines.find(l => /[a-zA-Záéíóúâêôãõç]/i.test(l) && !/^r\$|^total|^subtotal|^sub-total|^cnpj/i.test(l));
  if(descCandidate){
    out.descricao = descCandidate.replace(/\s+/g, ' ').trim().slice(0, 60);
  }
  return out;
}
function _viagShowOCRModal(d, extracted, rawText, mode){
  let ov = document.getElementById('viag-ocr-modal');
