    <button class="hp12-key" data-k="2"><span class="hp12-key-f">R/S</span><span class="hp12-key-lbl">2</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key" data-k="3"><span class="hp12-key-f">GTO</span><span class="hp12-key-lbl">3</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key op" data-k="sub"><span class="hp12-key-f"></span><span class="hp12-key-lbl">−</span><span class="hp12-key-g"></span></button>

    <!-- Linha 4: ON f g STO RCL 0(2col) . Σ+ + -->
    <button class="hp12-key on-key" data-k="ON"><span class="hp12-key-f"></span><span class="hp12-key-lbl">ON</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key f-key" data-k="f"><span class="hp12-key-f"></span><span class="hp12-key-lbl">f</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key g-key" data-k="g"><span class="hp12-key-f"></span><span class="hp12-key-lbl">g</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key" data-k="STO"><span class="hp12-key-f"></span><span class="hp12-key-lbl">STO</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key" data-k="RCL"><span class="hp12-key-f"></span><span class="hp12-key-lbl">RCL</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key wide-zero" data-k="0"><span class="hp12-key-f"></span><span class="hp12-key-lbl">0</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key" data-k="dot"><span class="hp12-key-f"></span><span class="hp12-key-lbl">.</span><span class="hp12-key-g"></span></button>
    <button class="hp12-key" data-k="SIG"><span class="hp12-key-f"></span><span class="hp12-key-lbl">Σ+</span><span class="hp12-key-g">Σ−</span></button>
    <button class="hp12-key op" data-k="add"><span class="hp12-key-f"></span><span class="hp12-key-lbl">+</span><span class="hp12-key-g"></span></button>
  </div>

