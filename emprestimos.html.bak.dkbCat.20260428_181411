// ─── Combobox custom para cart-l-estab e cart-l-cat ───
// Engine simples: input + popover filtrado + opção "+ Cadastrar 'X'" no rodapé.
let _cartCbxActiveIdx = { estab: -1, cat: -1 };

function _cartCbxSource(name){
  if(name === 'estab'){
    const seen = new Map();
    try {
      if(typeof pessoas !== 'undefined' && Array.isArray(pessoas.registry)){
        for(const r of pessoas.registry){
          if(!r || r.kind === 'colaborador') continue;
          const n = (r.nome || '').trim();
          if(!n) continue;
          const k = n.toLowerCase();
          if(!seen.has(k)) seen.set(k, n);
        }
      }
    } catch(_){}
    return Array.from(seen.values()).sort((a,b)=>a.localeCompare(b,'pt',{sensitivity:'base'}));
  }
  if(name === 'cat'){
    try {
      if(typeof _cartCollectCategorias === 'function') return _cartCollectCategorias();
    } catch(_){}
    return [];
  }
  return [];
}

function _cartCbxRender(name){
  const inp = document.getElementById('cart-l-' + name);
  const pop = document.getElementById('cart-cbx-pop-' + name);
  if(!inp || !pop) return;
  const q = (inp.value || '').trim();
  const qLow = q.toLowerCase();
  const all = _cartCbxSource(name);
  const filtered = q ? all.filter(x => x.toLowerCase().includes(qLow)) : all.slice();
  // Quem é match exato?
  const exact = q && all.some(x => x.toLowerCase() === qLow);
  let html = '';
  if(filtered.length === 0 && !q){
    html += '<div class="cart-cbx-item empty">Nenhum cadastro ainda — digite para criar</div>';
  } else {
    for(let i=0; i<filtered.length; i++){
      const v = filtered[i];
      html += '<div class="cart-cbx-item" data-idx="' + i + '" onmousedown="event.preventDefault();_cartCbxPick(\'' + name + '\',' + i + ')">' + cartEsc(v) + '</div>';
    }
  }
  // Opção "+ Cadastrar" quando ha texto e nao bate exato
  if(q && !exact){
    const addIdx = filtered.length;
    const lbl = name === 'estab' ? ('Cadastrar fornecedor "' + cartEsc(q) + '"') : ('Cadastrar categoria "' + cartEsc(q) + '"');
    html += '<div class="cart-cbx-add" data-idx="' + addIdx + '" onmousedown="event.preventDefault();_cartCbxCreate(\'' + name + '\')">' + lbl + '</div>';
  }
  pop.innerHTML = html;
  _cartCbxActiveIdx[name] = -1;
}

function _cartCbxOpen(name){
  const pop = document.getElementById('cart-cbx-pop-' + name);
  if(!pop) return;
  _cartCbxRender(name);
  pop.classList.add('open');
  // Fecha ao clicar fora
  setTimeout(()=>{
    const handler = (e) => {
      if(!pop.contains(e.target)){
        const inp = document.getElementById('cart-l-' + name);
        if(inp && e.target === inp) return;
        pop.classList.remove('open');
        document.removeEventListener('mousedown', handler, true);
      }
    };
    document.addEventListener('mousedown', handler, true);
  }, 0);
}
function _cartCbxClose(name){
  const pop = document.getElementById('cart-cbx-pop-' + name);
  if(pop) pop.classList.remove('open');
}
function _cartCbxToggle(name){
  const pop = document.getElementById('cart-cbx-pop-' + name);
  if(!pop) return;
  if(pop.classList.contains('open')){ _cartCbxClose(name); }
  else { _cartCbxOpen(name); }
}
function _cartCbxFilter(name){
  _cartCbxRender(name);
  const pop = document.getElementById('cart-cbx-pop-' + name);
  if(pop) pop.classList.add('open');
}
function _cartCbxPick(name, idx){
  const inp = document.getElementById('cart-l-' + name);
  if(!inp) return;
  const all = _cartCbxSource(name);
  const q = (inp.value || '').trim().toLowerCase();
  const filtered = q ? all.filter(x => x.toLowerCase().includes(q)) : all.slice();
  const v = filtered[idx];
  if(v){ inp.value = v; }
  _cartCbxClose(name);
}
function _cartCbxCreate(name){
  const inp = document.getElementById('cart-l-' + name);
  if(!inp) return;
  const v = (inp.value || '').trim();
  if(!v) return;
  if(name === 'estab'){
    try {
      if(typeof pessoas !== 'undefined' && pessoas){
        if(!Array.isArray(pessoas.registry)) pessoas.registry = [];
        const found = pessoas.registry.find(r => r && r.kind !== 'colaborador' && (r.nome||'').trim().toLowerCase() === v.toLowerCase());
        if(!found){
          if(!pessoas.nextRegId) pessoas.nextRegId = 1;
          const novo = { id: pessoas.nextRegId++, nome: v, foto:'', anexos:[], tags:[], kind:'fornecedor', tipoPessoa:'pj', ativo:true };
          pessoas.registry.push(novo);
          if(typeof pessoasSave === 'function') pessoasSave();
          if(typeof toast === 'function') toast('✓ Fornecedor "' + v + '" cadastrado');
        }
      }
    } catch(_){}
  } else if(name === 'cat'){
    try {
      if(typeof estrutura !== 'undefined' && estrutura){
        if(!Array.isArray(estrutura.tags)) estrutura.tags = [];
        const exists = estrutura.tags.find(t => (t.nome||'').trim().toLowerCase() === v.toLowerCase());
        if(!exists){
          let color = '#94A3B8';
          try {
            if(typeof EST_COLOR_PALETTE !== 'undefined' && Array.isArray(EST_COLOR_PALETTE)){
              color = EST_COLOR_PALETTE[estrutura.tags.length % EST_COLOR_PALETTE.length];
            }
          } catch(_){}
          const id = (typeof estNextTagId === 'function') ? estNextTagId() : (Date.now() % 1000000);
          estrutura.tags.push({ id, nome: v, color });
          if(typeof estSave === 'function') estSave();
          if(typeof toast === 'function') toast('✓ Categoria "' + v + '" cadastrada como tag');
        }
      }
    } catch(_){}
  }
  _cartCbxClose(name);
}
function _cartCbxKey(e, name){
  const pop = document.getElementById('cart-cbx-pop-' + name);
  if(!pop || !pop.classList.contains('open')) {
    if(e.key === 'ArrowDown'){ _cartCbxOpen(name); e.preventDefault(); }
    return;
  }
  const items = Array.from(pop.querySelectorAll('.cart-cbx-item, .cart-cbx-add'));
  if(e.key === 'ArrowDown'){
    e.preventDefault();
    _cartCbxActiveIdx[name] = Math.min(items.length-1, _cartCbxActiveIdx[name] + 1);
    items.forEach(it => it.classList.remove('active'));
    if(items[_cartCbxActiveIdx[name]]) items[_cartCbxActiveIdx[name]].classList.add('active');
  } else if(e.key === 'ArrowUp'){
    e.preventDefault();
    _cartCbxActiveIdx[name] = Math.max(0, _cartCbxActiveIdx[name] - 1);
    items.forEach(it => it.classList.remove('active'));
    if(items[_cartCbxActiveIdx[name]]) items[_cartCbxActiveIdx[name]].classList.add('active');
  } else if(e.key === 'Enter'){
    if(_cartCbxActiveIdx[name] >= 0 && items[_cartCbxActiveIdx[name]]){
      e.preventDefault();
      items[_cartCbxActiveIdx[name]].dispatchEvent(new MouseEvent('mousedown', {bubbles:true}));
    }
  } else if(e.key === 'Escape'){
    _cartCbxClose(name);
  }
}
try {
  window._cartCbxOpen = _cartCbxOpen;
  window._cartCbxClose = _cartCbxClose;
  window._cartCbxToggle = _cartCbxToggle;
  window._cartCbxFilter = _cartCbxFilter;
  window._cartCbxPick = _cartCbxPick;
  window._cartCbxCreate = _cartCbxCreate;
  window._cartCbxKey = _cartCbxKey;
} catch(e){}

