function diagCloseScope(){
  const ov = document.getElementById('diag-scope-ov');
  if(ov) ov.remove();
}
function diagScopeAll(){
  document.querySelectorAll('#diag-scope-ov input[data-mod]').forEach(cb => cb.checked = true);
}
function diagScopeNone(){
  document.querySelectorAll('#diag-scope-ov input[data-mod]').forEach(cb => cb.checked = false);
}
function diagRunWithScope(){
  const sel = new Set();
  document.querySelectorAll('#diag-scope-ov input[data-mod]:checked').forEach(cb => sel.add(cb.getAttribute('data-mod')));
  _diagScope = sel.size > 0 ? sel : null;
  diagCloseScope();
  diagRun();
  // Após render, esconde seções fora do escopo
  setTimeout(() => { try { _diagApplyScope(); } catch(e){} }, 100);
}
function _diagApplyScope(){
  if(!_diagScope) return;
  const sections = ['precif','custos','pessoas','fluxo','riscos'];
  for(const sec of sections){
    const el = document.querySelector('.diag-section.' + sec);
    if(el) el.style.display = _diagScope.has(sec) ? '' : 'none';
  }
}
try {
  window.diagAskScope = diagAskScope;
  window.diagCloseScope = diagCloseScope;
  window.diagScopeAll = diagScopeAll;
  window.diagScopeNone = diagScopeNone;
  window.diagRunWithScope = diagRunWithScope;
} catch(e){}

function diagRun(){
  const btn = document.getElementById('diag-run-btn');
  const body= document.getElementById('diag-body');
  if(!body) return;
  if(btn){ btn.disabled = true; btn.querySelector('span').textContent = 'Analisando…'; }
  // Auto-aplica o escopo após renderização (com retry pra cobrir streaming)
  setTimeout(() => { try { _diagApplyScope(); } catch(e){} }, 500);
  setTimeout(() => { try { _diagApplyScope(); } catch(e){} }, 1500);
  setTimeout(() => { try { _diagApplyScope(); } catch(e){} }, 3500);

  // Pré-coleta rápida só pra ter contagens reais nos passos do loading
  let snapPre = null;
  try{ snapPre = diagSnapshot(); }catch(e){}
  const nLanc     = snapPre ? ((snapPre.receita.anual>0?1:0) + (snapPre.receita.receitaMes||[]).filter(v=>v>0).length + (snapPre.estrutura.itens||[]).length) : 0;
  const nPessoas  = snapPre ? (snapPre.pessoas.headcount || 0) : 0;
  const nClientes = snapPre ? (snapPre.receita.clientes||[]).filter(c=>c.ativo!==false).length : 0;
  const nContas   = snapPre && snapPre.dispo && Array.isArray(snapPre.dispo.contas) ? snapPre.dispo.contas.length : 0;
  const nMesesRec = snapPre ? (snapPre.receita.serieMensal||[]).length : 0;

  // Etapas realistas com mini-descrições técnicas
  const steps = [
    { t:'Lendo dados de receita, pessoas e estrutura',
      sub:`Coletando ${nMesesRec} meses · ${nPessoas} pessoa${nPessoas===1?'':'s'} · ${nClientes} cliente${nClientes===1?'':'s'} · ${nContas} conta${nContas===1?'':'s'}`  },
    { t:'Calculando indicadores operacionais',
      sub:'ticket médio, margem, DSO, runway, concentração de carteira' },
    { t:'Treinando modelo de tendência',
      sub:'Regressão Linear + suavização Holt (ensemble 50/50)' },
    { t:'Detectando anomalias e sazonalidade',
      sub:'Z-score ±2σ em séries mensais · padrão anual' },
    { t:'Agrupando clientes por LTV',
      sub:'K-Means (k=3) em receita × tempo de relacionamento' },
    { t:'Projetando próximos 6 meses',
      sub:'intervalo de confiança 80% via desvio do ensemble' },
    { t:'Calculando score de saúde (0–100)',
      sub:'pondera caixa, margem, churn, concentração, variação' },
    { t:'Redigindo recomendações personalizadas',
      sub:'motor de regras + priorização por severidade' }
  ];

  body.innerHTML = `
    <div class="diag-loading">
      <div class="diag-loading-orb"></div>
      <h3>Analisando seu negócio…</h3>
      <ul class="diag-loading-steps" id="diag-steps-ul">
        ${steps.map((s,i)=>`
          <li class="diag-loading-step" data-i="${i}">
            <span class="diag-ls-bullet"></span>
            <div style="flex:1">
              <div>${esc(s.t)}</div>
              <div class="diag-loading-sub">${esc(s.sub)}</div>
            </div>
          </li>`).join('')}
      </ul>
    </div>`;

  const lis = body.querySelectorAll('.diag-loading-step');
  // Timings: começa rápido e acelera no fim
  const base = 260;
  const timings = steps.map((_,i) => Math.round(base + i*220 + (i>=5?180:0)));
  timings.push(timings[timings.length-1] + 500); // última "done"

  steps.forEach((_,i)=>{
    setTimeout(()=>{
      lis.forEach((li,j)=>{
        li.classList.toggle('active', j===i);
        li.classList.toggle('done',   j<i);
      });
    }, timings[i]);
  });

  const tStart = performance.now();
  setTimeout(()=>{
    try{
      const snap = snapPre || diagSnapshot();
      const ml   = diagComputeML(snap);
      try { window.__diagML = ml; } catch(_){}
      const ind  = diagIndicators(snap);
      const alerts = diagAlertas(snap, ind, ml);
      const nar    = diagNarrativa(snap, ind, ml);
      const passos = diagPassos(snap, ind, ml);
      const result = { snap, ind, ml, alerts, nar, passos };
      const meta = { elapsedMs: Math.round(performance.now() - tStart) + (timings[timings.length-1]||0) };
      // Histórico
      // Nome do diagnóstico baseado no PERÍODO da análise:
      // Realizado (meses fechados) + Projeção (meses restantes do ano).
      const _MES_ABR = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
      const _ano    = snap.curYear;
      const _anoSh  = String(_ano).slice(2);
      const _nC     = snap.nClosed || 0;
      const _closeI = snap.closedMIdx != null ? snap.closedMIdx : -1;
      const _curI   = snap.curMIdx;
      let _defName  = '';
      if(_nC === 0){
        // Nenhum mês fechado: ano todo é projeção
        _defName = `Projeção ${_MES_ABR[_curI]}-Dez/${_anoSh}`;
      } else if(_nC >= 12){
        // Ano completo realizado
        _defName = `Realizado Jan-Dez ${_ano}`;
      } else {
        // Caso típico: parte realizada + parte projetada
        const _realIni = _MES_ABR[0];
        const _realFim = _MES_ABR[_closeI];
        const _projIni = _MES_ABR[_curI];
        const _projFim = _MES_ABR[11];
        const _realRange = (_realIni === _realFim) ? _realIni : `${_realIni}-${_realFim}`;
        const _projRange = (_projIni === _projFim) ? _projIni : `${_projIni}-${_projFim}`;
        _defName = `${_realRange}/${_anoSh} (real) + ${_projRange}/${_anoSh} (proj)`;
      }
      diagHistory.unshift({ ts: snap.ts, name: _defName, score: ind.score, summary: diagHealthLabel(ind.score), result });
      diagHistory = diagHistory.slice(0,20);
      diagSave();
      // Marca todos os passos como done antes de renderizar
      lis.forEach(li => { li.classList.remove('active'); li.classList.add('done'); });
      diagRenderResult(result, meta);
      diagRenderHistory();
    } catch(e){
      console.error('diagRun erro:',e);
      body.innerHTML = `<div class="diag-empty"><h3>Não foi possível gerar o diagnóstico</h3><p>Erro: ${esc(e.message||String(e))}</p></div>`;
    } finally {
      if(btn){ btn.disabled = false; btn.querySelector('span').textContent = 'Gerar novamente'; }
    }
  }, timings[steps.length]);
}

function diagHealthLabel(score){
  if(score >= 80) return { label:'Saudável', cls:'good', desc:'Indicadores gerais fortes. Momento favorável para investir e crescer.' };
  if(score >= 60) return { label:'Estável',  cls:'good', desc:'Situação controlada com pontos de atenção específicos — acompanhar mês a mês.' };
  if(score >= 40) return { label:'Atenção',  cls:'warn', desc:'Indicadores mistos. Há sinais que merecem ação tática no curto prazo.' };
  if(score >= 20) return { label:'Fragilizado', cls:'bad', desc:'Múltiplos sinais preocupantes. Revise prioridades e reduza riscos.' };
  return { label:'Crítico', cls:'bad', desc:'Operação sob forte pressão financeira. Ação imediata é necessária.' };
}

