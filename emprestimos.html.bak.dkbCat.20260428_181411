function dispoTipo(id){  return (dispo && dispo.tipos ||[]).find(t=>t.id===id) || null; }
function dispoCurYear(){ return dispoActiveYear || (dispo && dispo.years[0]); }
function dispoNextId(kind){
  const arr = dispo[kind] || [];
  const prefix = kind === 'bancos' ? 'b-' : (kind === 'tipos' ? 't-' : 'x-');
  let n = 1; while(arr.some(x => x.id === prefix + 'u' + n)) n++;
  return prefix + 'u' + n;
}
function dispoLogoUrl(banco){
  if(!banco) return null;
  if(banco.domain) return `https://logo.clearbit.com/${banco.domain}`;
