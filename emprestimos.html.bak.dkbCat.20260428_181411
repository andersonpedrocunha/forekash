                    background:linear-gradient(135deg,#EDE9FE,#DBEAFE);
                    display:flex;align-items:center;justify-content:center;color:#6366F1}
    .diag-empty-ico svg{width:26px;height:26px;stroke:currentColor;fill:none;stroke-width:1.8;
                        stroke-linecap:round;stroke-linejoin:round}
    .diag-empty h3{font-size:1rem;font-weight:700;color:var(--tx);margin:0 0 6px}
    .diag-empty p{font-size:.76rem;color:var(--txm);margin:0;line-height:1.55;max-width:440px;
                  margin-left:auto;margin-right:auto}

    .diag-loading{background:var(--card);border:1px solid var(--bdr);border-radius:14px;
                  padding:32px 28px;text-align:center}
    .diag-loading-orb{width:64px;height:64px;margin:0 auto 18px;border-radius:50%;
                      background:conic-gradient(from 0deg,#8B5CF6,#6366F1,#3B82F6,#8B5CF6);
                      animation:diagSpin 1.4s linear infinite;position:relative}
