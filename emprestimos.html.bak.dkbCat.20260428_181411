// Lista oficial de contrapartes: clientes (Receita) ou fornecedores (Cadastro)
function _extOfficialCounters(tipo){
  const list = [];
  if(tipo === 'ganho'){
    try {
      if(typeof receita !== 'undefined' && receita && Array.isArray(receita.clientes)){
        for(const c of receita.clientes){
          const nm = (c.nome||'').trim();
          if(nm) list.push(nm);
        }
      }
    } catch(_){}
  } else {
    try {
      if(typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.registry)){
        for(const r of pessoas.registry){
          if(!r || r.kind === 'colaborador' || r.ativo === false) continue;
          const nm = (r.nome||'').trim();
          if(nm) list.push(nm);
        }
      }
    } catch(_){}
  }
  // Dedup case-insensitive
  const seen = new Map();
  for(const nm of list){
    const k = nm.toLowerCase();
    if(!seen.has(k)) seen.set(k, nm);
  }
  return Array.from(seen.values()).sort((a,b) => a.localeCompare(b, 'pt', { sensitivity:'base' }));
}

