let __dispoDetailBancoId = null;
let __dispoDetailCidFallback = null;
function openDispoContaDetail(contaId){
  const c = dispo.contas.find(x => x.id === contaId);
  if(!c){ toast('⚠️ Conta não encontrada'); return; }
  __dispoDetailBancoId     = c.bancoId || '';
  __dispoDetailCidFallback = c.id;
