// Normaliza string: remove acentos + lowercase + trim.
function _normStr(s){
  return (s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
}

// Gera a bandeira emoji a partir de um ISO-2 (ex.: 'BR' → 🇧🇷).
function flagFromCode(code){
  if(!code || code.length !== 2) return '🌍';
  const up = code.toUpperCase();
  const c1 = up.charCodeAt(0) - 65;
  const c2 = up.charCodeAt(1) - 65;
  if(c1 < 0 || c1 > 25 || c2 < 0 || c2 > 25) return '🌍';
  return String.fromCodePoint(0x1F1E6 + c1, 0x1F1E6 + c2);
}

// Procura um país no dicionário pelo nome digitado (case/acento-insensitive).
// Retorna {code, flag, nome} ou null se não achou.
function lookupPaisByName(nome){
  const q = _normStr(nome);
  if(!q) return null;
  const entries = Object.entries(REC_PAIS_DB);
  // 1) match exato
  for(const [n, code] of entries){
    if(_normStr(n) === q) return {code, flag: flagFromCode(code), nome: n};
  }
  // 2) começa com
  for(const [n, code] of entries){
    if(_normStr(n).startsWith(q)) return {code, flag: flagFromCode(code), nome: n};
  }
  // 3) contém
  for(const [n, code] of entries){
    if(_normStr(n).includes(q)) return {code, flag: flagFromCode(code), nome: n};
  }
  return null;
}

// Lista completa: países preferidos + customizados (persistidos pelo usuário).
// Deduplica por code preservando a ordem (preferidos primeiro).
function recAllPaises(){
  if(!receita) return REC_PAISES.slice();
  const custom = Array.isArray(receita.paisesCustom) ? receita.paisesCustom : [];
  const seen = new Set();
  const out = [];
  for(const p of [...REC_PAISES, ...custom]){
    if(!p || !p.code) continue;
    const k = p.code.toUpperCase();
    if(seen.has(k)) continue;
    seen.add(k);
    out.push(p);
  }
  return out;
}

function recPaisByCode(code){
  if(!code) return null;
  return recAllPaises().find(p => p.code === code) || null;
}

// Adiciona um país customizado (persiste em receita.paisesCustom).
// Tenta primeiro o dicionário (pelo nome). Se não achar, aceita código de 2 letras
// e gera bandeira automaticamente. Retorna o país adicionado ou null.
function addPaisCustom(nomeDigitado){
  if(!receita) return null;
  if(!Array.isArray(receita.paisesCustom)) receita.paisesCustom = [];
  const entrada = (nomeDigitado || '').trim();
  if(!entrada) return null;

  // Se for ISO-2 direto (ex.: "DK")
  let code = '', nome = '', flag = '';
  if(/^[A-Za-z]{2}$/.test(entrada)){
    code = entrada.toUpperCase();
    // procura nome no dicionário pra exibição mais bonita
    const fromDb = Object.entries(REC_PAIS_DB).find(([,c]) => c === code);
    nome = fromDb ? fromDb[0] : entrada.toUpperCase();
    flag = flagFromCode(code);
  } else {
    const found = lookupPaisByName(entrada);
    if(found){
      code = found.code; nome = found.nome; flag = found.flag;
    } else {
      // Fallback: aceita o nome digitado e usa emoji genérico
      code = 'X' + Math.random().toString(36).slice(2,4).toUpperCase();
      nome = entrada;
      flag = '🌍';
    }
  }

  // Se o país já existe em qualquer lista, só retorna-o (não duplica)
  const existente = recAllPaises().find(p => p.code === code);
  if(existente) return existente;

  const novo = {code, flag, nome};
  receita.paisesCustom.push(novo);
  receitaSave();
  return novo;
}
