function openPesTipoManager(){
  renderPesTipoList();
  const ov = document.getElementById('ov-pes-tipos');
  if(ov) ov.classList.add('open');
}
function closePesTipoManager(){
  const ov = document.getElementById('ov-pes-tipos');
  if(ov) ov.classList.remove('open');
  renderPessoas();
}
function renderPesTipoList(){
  const list = document.getElementById('pes-tipo-list');
  if(!list) return;
  if(!pessoas.tipos.length){
    list.innerHTML = `<div class="tipo-empty">Nenhum tipo cadastrado. Adicione abaixo.</div>`;
    return;
  }
  list.innerHTML = pessoas.tipos.map(t=>`
    <div class="tipo-item" data-tid="${esc(t.id)}">
      <span class="tipo-item-swatch" style="background:${t.color}"
            onclick="cyclePesTipoColor('${esc(t.id)}')" title="Trocar cor"></span>
      <input type="text" value="${esc(t.nome)}"
             onchange="renamePesTipo('${esc(t.id)}', this.value)">
      <button class="tipo-item-del" onclick="deletePesTipo('${esc(t.id)}')" title="Remover">
        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14z"/></svg>
      </button>
    </div>
  `).join('');
}
function addPesTipo(){
  const input = document.getElementById('pes-tipo-new');
  if(!input) return;
  const nome = input.value.trim();
  if(!nome) return;
  if(pessoas.tipos.some(t => t.nome.toLowerCase() === nome.toLowerCase())){
    alert('Já existe um tipo com esse nome.'); return;
  }
  const id = pesTipoNewId();
  const usadas = new Set(pessoas.tipos.map(t=>t.color));
  const color = PES_TIPO_PALETTE.find(c=>!usadas.has(c)) ||
                PES_TIPO_PALETTE[pessoas.tipos.length % PES_TIPO_PALETTE.length];
  pessoas.tipos.push({ id, nome, color });
  input.value = '';
  pessoasSave();
  renderPesTipoList();
}
function renamePesTipo(id, novoNome){
  const t = pesTipo(id); if(!t) return;
  const nome = (novoNome||'').trim();
  if(!nome){ alert('Nome não pode estar vazio.'); renderPesTipoList(); return; }
  if(pessoas.tipos.some(x=>x.id!==id && x.nome.toLowerCase()===nome.toLowerCase())){
    alert('Já existe um tipo com esse nome.'); renderPesTipoList(); return;
  }
  t.nome = nome;
  pessoasSave();
}
function cyclePesTipoColor(id){
  const t = pesTipo(id); if(!t) return;
  const i = PES_TIPO_PALETTE.indexOf(t.color);
  t.color = PES_TIPO_PALETTE[(i+1) % PES_TIPO_PALETTE.length];
  pessoasSave();
  renderPesTipoList();
}
function deletePesTipo(id){
  const t = pesTipo(id); if(!t) return;
  const n = pessoas.people.filter(p=>p.tipoId===id).length;
  const msg = n > 0
    ? `Remover o tipo "${t.nome}"? ${n} pessoa${n>1?'s':''} ficar${n>1?'ão':'á'} sem tipo.`
    : `Remover o tipo "${t.nome}"?`;
  if(!confirm(msg)) return;
  pessoas.tipos = pessoas.tipos.filter(x=>x.id!==id);
  // pessoas do tipo removido ficam com tipoId vazio (orphan group)
  for(const p of pessoas.people){ if(p.tipoId === id) p.tipoId = ''; }
  pessoasSave();
  renderPesTipoList();
}

