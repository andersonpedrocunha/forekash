const CC_KEY = 'forekash:cc:v1';
let centrosCusto = []; // [{ id, nome, cor }]
let _ccNextId = 1;
let _ccEditingId = null;
function _ccLoad(){
  try {
    const raw = localStorage.getItem(CC_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && typeof obj === 'object'){
        if(Array.isArray(obj.centros)) centrosCusto = obj.centros;
        if(typeof obj.nextId === 'number') _ccNextId = obj.nextId;
      }
    }
  } catch(e){}
}
function _ccSave(){
  try {
    localStorage.setItem(CC_KEY, JSON.stringify({ centros: centrosCusto, nextId: _ccNextId }));
  } catch(e){}
}
_ccLoad();

function ccById(id){
  return centrosCusto.find(c => c.id === id) || null;
}
function ccRender(){
  const wrap = document.getElementById('cc-list');
  if(!wrap) return;
  if(centrosCusto.length === 0){
    wrap.innerHTML = '<div class="cc-empty">Nenhum centro de custo cadastrado ainda.</div>';
    return;
  }
  const sorted = centrosCusto.slice().sort((a,b) => (a.nome||'').localeCompare(b.nome||'','pt'));
  let html = '';
  for(const c of sorted){
    if(_ccEditingId === c.id){
      html += '<div class="cc-row editing">'
        + '<input type="color" id="cc-edit-cor-' + c.id + '" value="' + (c.cor || '#7C3AED') + '" style="width:32px;height:30px;border:1px solid #CBD5E1;border-radius:5px;cursor:pointer;padding:1px;flex-shrink:0">'
        + '<div class="nm"><input type="text" id="cc-edit-nome-' + c.id + '" value="' + _extEsc(c.nome || '') + '" maxlength="40" onkeydown="if(event.key===\'Enter\') ccSaveEdit(' + c.id + '); if(event.key===\'Escape\') ccCancelEdit();"></div>'
        + '<div class="actions">'
        +   '<button class="save" onclick="ccSaveEdit(' + c.id + ')">Salvar</button>'
        +   '<button class="cancel" onclick="ccCancelEdit()">Cancelar</button>'
        + '</div>'
        + '</div>';
    } else {
      html += '<div class="cc-row">'
        + '<span class="dot" style="background:' + (c.cor || '#7C3AED') + '"></span>'
        + '<div class="nm">' + _extEsc(c.nome) + '</div>'
        + '<div class="actions">'
        +   '<button class="edit" onclick="ccStartEdit(' + c.id + ')" title="Editar">✎ Editar</button>'
        +   '<button class="del" onclick="ccDelete(' + c.id + ')" title="Excluir">🗑</button>'
        + '</div>'
        + '</div>';
    }
  }
  wrap.innerHTML = html;
}
function ccAdd(){
  const inpN = document.getElementById('cc-input-nome');
  const inpC = document.getElementById('cc-input-cor');
  if(!inpN) return;
  const nome = (inpN.value || '').trim();
  if(!nome){ if(typeof toast === 'function') toast('⚠ Digite um nome'); inpN.focus(); return; }
  const dup = centrosCusto.find(c => (c.nome||'').trim().toLowerCase() === nome.toLowerCase());
  if(dup){ if(typeof toast === 'function') toast('⚠ Já existe um centro de custo com esse nome'); return; }
  centrosCusto.push({ id: _ccNextId++, nome: nome, cor: (inpC && inpC.value) || '#7C3AED' });
  _ccSave();
  inpN.value = '';
  ccRender();
  if(typeof toast === 'function') toast('✓ Centro de custo adicionado');
}
function ccStartEdit(id){
  _ccEditingId = id;
  ccRender();
  setTimeout(() => { const f = document.getElementById('cc-edit-nome-' + id); if(f){ f.focus(); f.select(); } }, 0);
}
function ccCancelEdit(){
  _ccEditingId = null;
  ccRender();
}
function ccSaveEdit(id){
  const nomeEl = document.getElementById('cc-edit-nome-' + id);
  const corEl  = document.getElementById('cc-edit-cor-' + id);
  if(!nomeEl) return;
  const nome = (nomeEl.value || '').trim();
  if(!nome){ if(typeof toast === 'function') toast('⚠ Nome obrigatório'); return; }
  const dup = centrosCusto.find(c => c.id !== id && (c.nome||'').trim().toLowerCase() === nome.toLowerCase());
  if(dup){ if(typeof toast === 'function') toast('⚠ Já existe outro CC com esse nome'); return; }
  const c = ccById(id); if(!c) return;
  c.nome = nome;
  c.cor = (corEl && corEl.value) || c.cor || '#7C3AED';
  _ccSave();
  _ccEditingId = null;
  ccRender();
  if(typeof toast === 'function') toast('✓ Centro de custo atualizado');
}
async function ccDelete(id){
  const c = ccById(id); if(!c) return;
  // Conta uso: quantos lançamentos manuais usam esse CC
  let usos = 0;
  try {
    if(typeof extratoData !== 'undefined' && Array.isArray(extratoData.lancamentos)){
      usos = extratoData.lancamentos.filter(l => l.centroCustoId === id).length;
    }
  } catch(e){}
  const useFn = (typeof _dkbConfirm === 'function') ? _dkbConfirm : null;
  if(useFn){
    const ok = await useFn({
      icon: '🗑',
      title: 'Excluir centro de custo?',
      html: 'Excluir <b>"' + _extEsc(c.nome) + '"</b>?'
        + (usos > 0 ? '<div class="dkb-confirm-meta">⚠ <b>' + usos + '</b> lançamento(s) usam este CC e ficarão sem vínculo.</div>' : ''),
      okText: 'Sim, excluir',
      cancelText: 'Cancelar'
    });
    if(!ok) return;
  } else {
    if(!confirm('Excluir centro de custo "' + c.nome + '"?')) return;
  }
  centrosCusto = centrosCusto.filter(x => x.id !== id);
  // Limpa referências em lançamentos manuais
  if(typeof extratoData !== 'undefined' && Array.isArray(extratoData.lancamentos)){
    for(const l of extratoData.lancamentos){
      if(l.centroCustoId === id) delete l.centroCustoId;
    }
    _extSave();
  }
  _ccSave();
  ccRender();
  if(typeof renderExtrato === 'function') renderExtrato();
  if(typeof toast === 'function') toast('Centro de custo excluído');
}
function ccOptionsHtml(currentId){
  let html = '<option value="">— sem CC —</option>';
  const sorted = centrosCusto.slice().sort((a,b) => (a.nome||'').localeCompare(b.nome||'','pt'));
  for(const c of sorted){
    html += '<option value="' + c.id + '"' + (c.id === currentId ? ' selected' : '') + '>' + _extEsc(c.nome) + '</option>';
  }
  return html;
}

// HTML do dropdown custom de Centro de Custo (mais bonito que o select nativo)
function ccDdHtml(currentId, wrapId){
