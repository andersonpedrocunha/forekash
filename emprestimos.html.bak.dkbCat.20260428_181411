function pesMesKey(y, mIdx){ return y + '-' + String(mIdx+1).padStart(2,'0'); }
function pesTipoNewId(){
  let n = 1;
  const ids = new Set((pessoas.tipos||[]).map(t=>t.id));
  while(ids.has('t'+n)) n++;
  return 't'+n;
}
function pesTipo(tid){ return (pessoas.tipos||[]).find(t=>t.id===tid) || null; }
function pesCurYear(){ return pesActiveYear || (pessoas && pessoas.years[0]); }

// ─── Simulação de reajuste (por ano × tipo) ───
// Mapa de regras de um ano (tipoId → {key, pct}).
function pesReajSimRulesForYear(year){
  const rby = (pessoas && pessoas.reajSim && pessoas.reajSim.rulesByYear) || {};
  return rby[String(year)] || {};
}
// Regra específica para um tipo em um ano (ou null).
function pesReajSimRuleForTipoYear(tipoId, year){
  const map = pesReajSimRulesForYear(year);
  const r = map[tipoId];
  if(!r || !r.key || !r.pct) return null;
  return r;
}
// Lista achatada de todas as regras: [{year, tipoId, key, pct}, ...]
function pesReajSimAllRules(){
  const rby = (pessoas && pessoas.reajSim && pessoas.reajSim.rulesByYear) || {};
  const out = [];
  for(const y of Object.keys(rby)){
    const yr = rby[y] || {};
    for(const tipoId of Object.keys(yr)){
      const r = yr[tipoId];
      if(!r || !r.key || !r.pct) continue;
      out.push({ year:String(y), tipoId, key:r.key, pct: parseFloat(r.pct) || 0 });
    }
  }
  return out;
}
// Fator cumulativo: multiplica (1+pct/100) de todas as regras aplicáveis
// (mesmo tipo, e key já ocorrida em relação ao mês consultado).
function pesReajSimFactor(p, key){
  const sim = pessoas && pessoas.reajSim;
  if(!sim || !sim.enabled) return 1;
  let factor = 1;
  for(const r of pesReajSimAllRules()){
    if(r.tipoId !== p.tipoId) continue;
    if(key < r.key) continue;
    factor *= (1 + (r.pct / 100));
  }
  return factor;
}
// Valor efetivo (base × fator de simulação) para render e totais.
function pesEffVal(p, key){
  const base = p.salarios[key];
  if(base === undefined || base === null || base === 0) return 0;
  return base * pesReajSimFactor(p, key);
}

// ═══════════════════════════════════════════════════════════════════════════
// ALOCAÇÃO MULTI-TIPO
// Uma pessoa pode ter seu salário dividido entre vários tipos (ex.: 30%
// Força Faturável + 70% Gestão). Além disso, a alocação pode variar mês a mês.
// Estrutura: p.alocacao = { padrao: [{tipoId, pct}], meses: {"YYYY-MM": [...]} }
// Se a pessoa não tem `alocacao`, migra automaticamente de p.tipoId pra
// padrao = [{tipoId: p.tipoId, pct: 100}].
// ═══════════════════════════════════════════════════════════════════════════
function pesEnsureAlocacao(p){
  if(!p) return;
  if(!p.alocacao || typeof p.alocacao !== 'object'){
    p.alocacao = {
      padrao: p.tipoId ? [{ tipoId: p.tipoId, pct: 100 }] : [],
      meses: {}
    };
  }
  if(!Array.isArray(p.alocacao.padrao)) p.alocacao.padrao = [];
  if(!p.alocacao.meses || typeof p.alocacao.meses !== 'object') p.alocacao.meses = {};
}
// Retorna a alocação (array de {tipoId, pct}) ativa para um mês (YYYY-MM).
function pesAlocacaoMes(p, ym){
  pesEnsureAlocacao(p);
  if(ym && p.alocacao.meses[ym] && Array.isArray(p.alocacao.meses[ym])){
    return p.alocacao.meses[ym];
  }
  return p.alocacao.padrao || [];
}
// Conjunto (Set) de tipoIds que a pessoa já teve em qualquer momento.
function pesTiposDaPessoa(p){
  pesEnsureAlocacao(p);
  const set = new Set();
  for(const a of (p.alocacao.padrao || [])){
    if(a.tipoId && (parseFloat(a.pct)||0) > 0) set.add(a.tipoId);
  }
  for(const ym of Object.keys(p.alocacao.meses || {})){
    for(const a of (p.alocacao.meses[ym] || [])){
      if(a.tipoId && (parseFloat(a.pct)||0) > 0) set.add(a.tipoId);
    }
  }
  if(set.size === 0 && p.tipoId) set.add(p.tipoId);
  return set;
}
// Percentual de um tipo específico em um mês específico (0 se não está alocado).
function pesPctMesTipo(p, ym, tipoId){
  const alocs = pesAlocacaoMes(p, ym);
  for(const a of alocs) if(a.tipoId === tipoId) return parseFloat(a.pct) || 0;
  return 0;
}
// Salário proporcional a um tipo específico em um mês específico.
function pesSalarioMesTipo(p, ym, tipoId){
  const pct = pesPctMesTipo(p, ym, tipoId);
  if(pct === 0) return 0;
  return pesEffVal(p, ym) * (pct / 100);
}
// True se alocação é "simples" (1 tipo no padrão, 100%, sem meses customizados).
function pesIsAlocacaoSimples(p){
  pesEnsureAlocacao(p);
  const pad = p.alocacao.padrao || [];
  if(pad.length !== 1) return false;
  if((parseFloat(pad[0].pct) || 0) !== 100) return false;
  if(Object.keys(p.alocacao.meses || {}).length > 0) return false;
  return true;
}
// Número de meses com override customizado (≠ padrão).
function pesMesesCustomizados(p){
  pesEnsureAlocacao(p);
  return Object.keys(p.alocacao.meses || {}).length;
}
// Tipo "principal" — o grupo onde a pessoa aparece na tabela.
// Prioridade: 1) alocacao.preferido (escolhido pelo usuário em caso de empate),
//             2) maior % no padrão, 3) p.tipoId (legacy), 4) vazio.
function pesTipoPrincipal(p){
  pesEnsureAlocacao(p);
  if(p.alocacao.preferido){
    // Valida que ainda existe no padrão
    if((p.alocacao.padrao || []).some(a => a.tipoId === p.alocacao.preferido && (parseFloat(a.pct)||0) > 0)){
      return p.alocacao.preferido;
    }
  }
  const pad = p.alocacao.padrao || [];
  if(pad.length === 0) return p.tipoId || '';
  let best = null;
  for(const a of pad){
    if(!a.tipoId) continue;
    const pct = parseFloat(a.pct) || 0;
    if(pct <= 0) continue;
    if(!best || pct > best.pct) best = { tipoId: a.tipoId, pct };
  }
  return best ? best.tipoId : (p.tipoId || '');
}
// Detecta se há empate no maior % (2+ tipos com mesmo valor máximo).
function pesTiposEmpatados(p){
  pesEnsureAlocacao(p);
  const pad = p.alocacao.padrao || [];
  const valid = pad.filter(a => a.tipoId && (parseFloat(a.pct)||0) > 0);
  if(valid.length < 2) return [];
  let max = 0;
  for(const a of valid) if((parseFloat(a.pct)||0) > max) max = parseFloat(a.pct)||0;
  const ties = valid.filter(a => Math.abs((parseFloat(a.pct)||0) - max) < 0.01);
  return ties.length > 1 ? ties.map(a => a.tipoId) : [];
}
function pesReajSimActive(){
  return !!(pessoas && pessoas.reajSim && pessoas.reajSim.enabled);
}
// Retorna a primeira regra (mais antiga) que já afeta este key pra este tipo,
// apenas para exibir tooltip/marcação visual — null se nenhuma.
function pesReajSimFirstRuleFor(p, key){
  let best = null;
  for(const r of pesReajSimAllRules()){
    if(r.tipoId !== p.tipoId) continue;
    if(key < r.key) continue;
    if(!best || r.key < best.key) best = r;
  }
  return best;
}

// ─── Registro global de pessoas (nome único) ───
function pesRegistry(){ return (pessoas && Array.isArray(pessoas.registry)) ? pessoas.registry : []; }
function pesRegOf(rowOrId){
  const rid = (typeof rowOrId === 'object' && rowOrId !== null) ? rowOrId.pessoaId : rowOrId;
  if(!rid) return null;
  return pesRegistry().find(r => r.id === rid) || null;
}
function pesRegView(row){
  const r = pesRegOf(row);
  if(r) return { id:r.id, nome: r.nome || '', foto: r.foto || '' };
  return { id:0, nome: row.nome || '', foto: '' };
}

// Extrai até 2 iniciais do nome (ex.: "Ana Maria" → "AM").
function pesIniciais(nome){
  return (nome || '?').trim().split(/\s+/).slice(0,2)
          .map(s => s[0] || '').join('').toUpperCase() || '?';
}

// Retorna o HTML do avatar (foto OU iniciais OU ícone genérico)
// usado na planilha e no card de detalhe.
// opts: {size: 'row'|'card', tipoColor, tipoTxt}
