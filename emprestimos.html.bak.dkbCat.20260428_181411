  if(!nameEl || !frasesEl) return;
  const nome = (nameEl.value || '').trim();
  const frases = (frasesEl.value || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);
  const bio  = bioEl ? (bioEl.value || '').trim().slice(0, 280) : '';
  if(!nome){ nameEl.focus(); return; }
  if(!frases.length){ frasesEl.focus(); return; }
  const base = 'custom-' + (homeQuoteSlug(nome) || 'pensador');
  const existing = new Set(homeQuoteAllThinkers().map(t => t.id));
  let id = base, i = 1;
  while(existing.has(id)){ id = base + '-' + (++i); }
  const customs = homeQuoteCustomLoad();
  customs.push({ id, nome, grupo:'Personalizados', bio, frases });
  homeQuoteCustomSave(customs);
  nameEl.value = '';
  frasesEl.value = '';
  if(bioEl) bioEl.value = '';
  homeQuoteRenderSettings();
  homeRenderQuote();
  // Foco de volta no nome para adicionar outro
  setTimeout(() => { try{ nameEl.focus(); }catch(e){} }, 50);
}
function homeQuoteDeletePensador(id){
  const customs = homeQuoteCustomLoad().filter(t => t.id !== id);
  homeQuoteCustomSave(customs);
  // Limpa do set de desabilitados caso esteja
  const dis = homeQuoteDisabledSet();
  if(dis.has(id)){ dis.delete(id); homeQuoteDisabledSave(dis); }
  homeQuoteRenderSettings();
  homeRenderQuote();
}

// Frase do dia: determinística por data (mesmo dia, mesma frase)
function homeQuoteOfTheDay(){
  const pool = homeQuotePool();
  if(!pool.length) return null;
  // days-since-epoch, ajustado para local time (não UTC)
  const now = new Date();
  const local = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  const day = Math.floor(local / 86400000);
  return pool[((day % pool.length) + pool.length) % pool.length];
}

function homeRenderQuote(){
  const tx = document.getElementById('home-quote-text');
  const au = document.getElementById('home-quote-author');
  const box = document.getElementById('home-quote-box');
  if(!tx || !au || !box) return;
  const q = homeQuoteOfTheDay();
  if(!q){
    box.innerHTML = `<div class="home-quote-empty">
      Nenhum pensador selecionado.<br>
      <a onclick="homeQuoteOpenSettings()">Escolher pensadores →</a>
    </div>`;
    return;
  }
  // Garante estrutura (caso empty-state tenha sobrescrito)
  if(!document.getElementById('home-quote-text')){
    box.innerHTML = '<p class="home-quote-text" id="home-quote-text"></p>'
                  + '<p class="home-quote-author" id="home-quote-author"></p>'
                  + '<p class="home-quote-bio" id="home-quote-bio"></p>';
  }
  document.getElementById('home-quote-text').textContent   = q.frase;
  document.getElementById('home-quote-author').textContent = q.nome;
  const bioEl = document.getElementById('home-quote-bio');
  if(bioEl) bioEl.textContent = q.bio || '';
}

