// DEMONSTRATIVO — Voltar com a projeção
//   Apaga fluxo.manualOverrides[year][rowKey][mIdx] para as 5 linhas que têm
//   auto-pull (receita, folha, despesas, emprestimos, impostos), EXCETO células
//   com ✓ (fluxo.confirmed), que preservam o valor "baixado".
// ═══════════════════════════════════════════════════════════════════════════
const FLX_RESTORE_ROWS = ['receita','folha','despesas','emprestimos','impostos','parcImpostos'];

// Conta quantas células de override seriam apagadas (ignora ✓).
function _flxCountManualEdits(year){
  let total = 0, kept = 0;
  if(!fluxo || !fluxo.manualOverrides) return { total, kept };
  const ovs = fluxo.manualOverrides[year] || {};
  for(const rk of FLX_RESTORE_ROWS){
    const row = ovs[rk] || {};
    for(const mStr of Object.keys(row)){
      const v = row[mStr];
      if(v === undefined || v === '' || v === null) continue;
      if(flxIsConfirmed(year, rk, parseInt(mStr,10))) { kept++; continue; }
      total++;
    }
  }
  return { total, kept };
}

// Apaga overrides (exceto ✓) e re-renderiza. Retorna nº de células limpas.
function flxRestoreProjections(year){
  if(!fluxo || !fluxo.manualOverrides) return 0;
  const ovs = fluxo.manualOverrides[year];
  if(!ovs) return 0;
  let cleared = 0;
  for(const rk of FLX_RESTORE_ROWS){
    const row = ovs[rk];
    if(!row) continue;
    for(const mStr of Object.keys(row)){
      const mIdx = parseInt(mStr,10);
      if(flxIsConfirmed(year, rk, mIdx)) continue; // preserva ✓ baixadas
      delete row[mStr];
      cleared++;
    }
    // Remove o container da linha se ficou vazio
    if(Object.keys(row).length === 0) delete ovs[rk];
  }
  if(Object.keys(ovs).length === 0) delete fluxo.manualOverrides[year];
  fluxoSave();            // dispara histórico (Ctrl+Z volta os overrides)
  renderFlxSheet();
  try { if(typeof updateFlxKpis === 'function') updateFlxKpis(); } catch(e){}
  return cleared;
}

// Abre modal de confirmação e, se confirmado, executa o reset do ano ativo.
async function flxAskRestoreProjections(){
  const year = flxActiveYear;
  if(!year){
    try { if(typeof toast === 'function') toast('Selecione um ano antes'); } catch(e){}
    return;
  }
  const stats = _flxCountManualEdits(year);
  if(stats.total === 0){
    try { if(typeof toast === 'function') toast(stats.kept > 0
      ? 'Nenhuma edição manual além das baixadas (✓)'
      : 'Nenhuma edição manual para desfazer');
    } catch(e){}
    return;
  }
  const msg =
    'Todos os valores digitados manualmente em ' + year + ' vão ser apagados — ' +
    'as linhas Receita, Folha, Despesas Recorrentes, Empréstimos e Impostos voltam a puxar a ' +
    'projeção automática dos outros módulos.\n\n' +
    'Células marcadas com ✓ (baixadas) NÃO serão alteradas.\n\n' +
    'Edições a desfazer: ' + stats.total +
    (stats.kept > 0 ? '  ·  preservadas (✓): ' + stats.kept : '') +
    '\n\nEssa ação pode ser desfeita com Ctrl+Z.';
  const ok = await showConfirm({
    title: 'Voltar com a projeção?',
    message: msg,
    confirmLabel: 'Sim, voltar à projeção',
    cancelLabel: 'Cancelar',
    destructive: true
  });
  if(!ok) return;
  const n = flxRestoreProjections(year);
  try { if(typeof toast === 'function') toast('Projeção restaurada em ' + year + ' · ' + n + ' edições apagadas'); } catch(e){}
}

