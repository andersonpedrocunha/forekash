    tbody.innerHTML = '';
    if(empty) empty.style.display = 'block';
    const tfoot = document.getElementById('ext-tfoot');
    if(tfoot) tfoot.innerHTML = '';
    return;
  }
  if(empty) empty.style.display = 'none';

  let saldoAcc = 0;
  let html = '';
  for(const it of filtered){
    const dEff = _extDateOf(it);
    const dataLbl = dEff ? (dEff.slice(8,10) + '/' + dEff.slice(5,7)) : '—';
    const sign = (it.tipo === 'ganho') ? 1 : (it.tipo === 'transferencia' ? 0 : -1);
