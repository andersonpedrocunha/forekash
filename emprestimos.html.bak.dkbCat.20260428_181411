    + '<div class="cart-hd-actions">'
      + '<button type="button" class="cart-btn cart-btn-primary" onclick="cartOpenModal()">+ Novo cartão</button>'
    + '</div>'
  + '</div>';
  // KPIs
  let totLimite = 0, totUsado = 0, faturasAbertas = 0, valorAbertasFechadas = 0;
  let proxVenc = null;
  for(const c of cartoes.list){
    if(!c.ativo) continue;
    totLimite += c.limite || 0;
    totUsado  += cartLimiteUsado(c.id);
  }
  for(const f of cartoes.faturas){
    if(f.status === 'paga') continue;
    faturasAbertas++;
    valorAbertasFechadas += cartFaturaTotal(f.id);
    if(!proxVenc || f.vencimento < proxVenc) proxVenc = f.vencimento;
  }
  const usoPct = totLimite > 0 ? (totUsado / totLimite * 100) : 0;
  html += '<div class="cart-kpis">'
    + '<div class="cart-kpi"><div class="cart-kpi-lbl">Limite total</div><div class="cart-kpi-val">R$ ' + cartFmtBR(totLimite) + '</div><div class="cart-kpi-sub">' + cartoes.list.filter(c => c.ativo).length + ' cartão(ões) ativo(s)</div></div>'
    + '<div class="cart-kpi"><div class="cart-kpi-lbl">Usado</div><div class="cart-kpi-val" style="color:' + (usoPct > 80 ? '#DC2626' : (usoPct > 50 ? '#D97706' : '#16A34A')) + '">R$ ' + cartFmtBR(totUsado) + '</div><div class="cart-kpi-sub">' + usoPct.toFixed(0) + '% do limite</div></div>'
    + '<div class="cart-kpi"><div class="cart-kpi-lbl">Próximo vencimento</div><div class="cart-kpi-val">' + (proxVenc ? cartFmtDateBR(proxVenc) : '—') + '</div><div class="cart-kpi-sub">' + faturasAbertas + ' fatura(s) em aberto · R$ ' + cartFmtBR(valorAbertasFechadas) + '</div></div>'
  + '</div>';
  // Grid de cartões
  if(cartoes.list.length === 0){
    html += '<div class="cart-empty">'
      + '<span class="ico">💳</span>'
      + '<div class="title">Nenhum cartão cadastrado</div>'
      + '<div class="sub">Adicione seu primeiro cartão pra começar a controlar suas faturas e gastos.</div>'
      + '<button type="button" class="cart-btn cart-btn-primary" onclick="cartOpenModal()">+ Novo cartão</button>'
    + '</div>';
  } else {
    html += '<div class="cart-grid">';
    for(const c of cartoes.list){
      const usado = cartLimiteUsado(c.id);
      const pct = c.limite > 0 ? Math.min(100, usado / c.limite * 100) : 0;
      const barCls = pct > 80 ? 'is-danger' : (pct > 50 ? 'is-warn' : '');
      // Próximo vencimento desse cartão
      let pv = null;
      for(const f of cartoes.faturas){
        if(f.cartaoId !== c.id || f.status === 'paga') continue;
        if(!pv || f.vencimento < pv) pv = f.vencimento;
      }
      html += '<div class="cart-card ' + (c.ativo ? '' : 'is-inactive') + '" style="background:' + cartEsc(c.cor) + '" onclick="cartOpenDetail(' + c.id + ')">'
        + '<div class="cart-card-top">'
          + '<div><div class="cart-card-apelido">' + cartEsc(c.apelido) + '</div><div class="cart-card-banco">' + cartEsc(c.bancoEmissor || '') + '</div></div>'
          + '<div class="cart-card-bandeira">' + cartEsc(c.bandeira || '') + '</div>'
        + '</div>'
        + '<div class="cart-card-meio">'
          + '<div class="cart-card-num">•••• •••• •••• ' + cartEsc(c.ultimosDigitos || '0000') + '</div>'
        + '</div>'
        + '<div class="cart-card-bot">'
          + '<div class="cart-card-limite">'
            + '<div class="cart-card-limite-lbl">Limite usado</div>'
            + '<div class="cart-card-limite-val">R$ ' + cartFmtBR(usado) + ' / R$ ' + cartFmtBR(c.limite) + '</div>'
            + '<div class="cart-card-bar"><div class="cart-card-bar-fill ' + barCls + '" style="width:' + pct.toFixed(1) + '%"></div></div>'
          + '</div>'
          + '<div class="cart-card-venc">' + (pv ? '<b>' + cartFmtDateBR(pv) + '</b>vence' : '—') + '</div>'
        + '</div>'
      + '</div>';
    }
    html += '</div>';
  }
  wrap.innerHTML = html;
}

// ─── Detalhe do cartão ───
function cartOpenDetail(cartaoId){
  _cartView.mode = 'detail';
  _cartView.cartaoId = cartaoId;
  _cartView.tab = 'faturas';
  _cartView.faturaId = null;
  // Garante que a fatura corrente exista
  const today = new Date();
  cartGetOrCreateFatura(cartaoId, today.getFullYear(), today.getMonth() + 1);
  cartSave();
  renderCartoes();
}
function cartBackToList(){
  _cartView.mode = 'list';
  _cartView.cartaoId = null;
  _cartView.faturaId = null;
  renderCartoes();
}

function _cartRenderDetail(){
  const c = cartoes.list.find(x => x.id === _cartView.cartaoId);
  if(!c) return '<div class="cart-empty">Cartão não encontrado</div>';
  let html = '<div class="cart-det">'
    + '<div class="cart-det-hd">'
      + '<button class="cart-det-back" onclick="cartBackToList()">← Voltar</button>'
      + '<div class="cart-det-title">' + cartEsc(c.apelido) + ' <span style="font-size:.74rem;color:#94A3B8;font-weight:500">· ' + cartEsc(c.bandeira) + '</span></div>'
      + '<button class="cart-btn cart-btn-secondary" onclick="cartOpenModal(' + c.id + ')">⚙ Editar cartão</button>'
    + '</div>';
  // Lista de faturas — toolbar com year filter + status filter + tabela compacta
  const allFats = cartoes.faturas
    .filter(f => f.cartaoId === c.id)
    .slice()
    .sort((a, b) => (b.refY * 100 + b.refM) - (a.refY * 100 + a.refM));
  html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:10px">'
    + '<h3 style="margin:0;font-size:1rem;font-weight:800;color:#0F172A">📅 Faturas</h3>'
    + '<button class="cart-btn cart-btn-secondary" onclick="cartGerarFaturasAteMes(' + c.id + ')" title="Gera as próximas 12 faturas em branco">+ Gerar próximas</button>'
  + '</div>';
  if(allFats.length === 0){
    html += '<div class="cart-empty"><span class="ico">📄</span><div class="title">Sem faturas ainda</div><div class="sub">Adicione um lançamento ou importe um OFX pra criar faturas.</div></div>';
  } else {
    // Anos disponíveis
    const yearsSet = new Set(allFats.map(f => f.refY));
    const yearsArr = Array.from(yearsSet).sort((a,b) => b - a);
    const today = new Date();
    if(_cartView.fatYear == null || !yearsSet.has(_cartView.fatYear)){
      _cartView.fatYear = yearsSet.has(today.getFullYear()) ? today.getFullYear() : yearsArr[0];
    }
    // Toolbar: years + status
    let yearsBtns = '';
    for(const y of yearsArr){
      yearsBtns += '<button class="' + (_cartView.fatYear === y ? 'active' : '') + '" onclick="_cartSetFatYear(' + y + ')">' + y + '</button>';
    }
    // Conta cada status no ano selecionado
    const fatsYear = allFats.filter(f => f.refY === _cartView.fatYear);
    let cAbertas = 0, cFechadas = 0, cPagas = 0;
    let totAbertas = 0, totFechadas = 0, totPagas = 0;
    for(const f of fatsYear){
      const st = cartFaturaStatus(f);
      const v = cartFaturaTotal(f.id);
      if(st === 'aberta'){ cAbertas++; totAbertas += v; }
      else if(st === 'fechada'){ cFechadas++; totFechadas += v; }
      else if(st === 'paga'){ cPagas++; totPagas += (f.pagamento ? (f.pagamento.valorPago||0) + (f.pagamento.juros||0) + (f.pagamento.multa||0) - (f.pagamento.desconto||0) : v); }
    }
    const stTabs = [
      { k:'todas',    lbl:'Todas',    cnt: fatsYear.length },
      { k:'aberto',   lbl:'A pagar',  cnt: cAbertas + cFechadas },
      { k:'pagas',    lbl:'Pagas',    cnt: cPagas }
    ];
    let stHtml = '';
    for(const t of stTabs){
      stHtml += '<button class="' + (_cartView.fatStatus === t.k ? 'active' : '') + '" onclick="_cartSetFatStatus(\'' + t.k + '\')">'
        + cartEsc(t.lbl) + '<span class="cnt">' + t.cnt + '</span></button>';
    }
    // Density toggle
