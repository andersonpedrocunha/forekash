      text-align:center;outline:none;border-radius:4px;
      font-variant-numeric:tabular-nums;-moz-appearance:textfield
    }
    .imp-par-sheet tbody td.stk-3 input.imp-npar-input::-webkit-outer-spin-button,
    .imp-par-sheet tbody td.stk-3 input.imp-npar-input::-webkit-inner-spin-button{
      -webkit-appearance:none;margin:0
    }
    .imp-par-sheet tbody td.stk-3 input.imp-npar-input::placeholder{color:#D1D5DB;font-weight:400}
    .imp-par-sheet tbody td.stk-3 input.imp-npar-input:hover{background:#F5F3FF}
    .imp-par-sheet tbody td.stk-3 input.imp-npar-input:focus{background:#fff;
                                                              box-shadow:inset 0 0 0 2px #C4B5FD}
    .imp-par-sheet tbody td.stk-3 input.imp-npar-input.growing{color:#B91C1C}
    .imp-par-sheet tbody td.stk-4{left:476px;min-width:116px;max-width:116px;width:116px;box-sizing:border-box;overflow:hidden;text-align:right;padding:6px 10px;
                                  color:#DC2626;font-weight:600}
    .imp-par-sheet tbody td.stk-5{left:592px;min-width:106px;max-width:106px;width:106px;box-sizing:border-box;text-align:center;padding:6px 8px;
                                  border-right:2px solid var(--bdr);color:var(--txm);font-weight:600}
    .imp-par-row{--trc:#BE185D}
    .imp-par-row td.stk-1{border-left:4px solid var(--trc)}
    .imp-par-row.quitado{opacity:.55;filter:grayscale(.4)}
    .imp-par-row.quitado td.stk-1::after{content:"✓ quitado";margin-left:8px;font-size:.6rem;
                                          color:#059669;font-weight:700;letter-spacing:.05em;
                                          text-transform:uppercase}
    .imp-par-nome{display:flex;align-items:center;gap:10px}
    .imp-par-nome input.nm{flex:1;border:none;background:transparent;padding:4px 6px;
                           font:inherit;font-weight:600;outline:none;color:var(--tx);
                           border-radius:4px;min-width:80px}
    .imp-par-nome input.nm:hover{background:#F3F4F6}
    .imp-par-nome input.nm:focus{background:#fff;box-shadow:inset 0 0 0 2px #F9A8D4}

    .imp-par-field{width:100%;border:none;background:transparent;padding:4px 6px;
                   font:inherit;font-variant-numeric:tabular-nums;text-align:right;
                   outline:none;color:inherit;border-radius:4px;font-weight:600}
    .imp-par-field:hover{background:#F9FAFB}
    .imp-par-field:focus{background:#fff;box-shadow:inset 0 0 0 2px #F9A8D4;color:var(--tx)}
    .imp-par-field.mesinicio{text-align:center}
    /* Botão/trigger do mês de início (abre picker custom) */
    .imp-par-mes-btn{width:100%;background:#fff;border:1.5px solid #E5E7EB;
                     border-radius:6px;padding:5px 8px;font-size:.82rem;font-weight:700;
                     color:#4C1D95;cursor:pointer;font-family:inherit;line-height:1.2;
                     font-variant-numeric:tabular-nums;text-align:center;
                     transition:all .12s;letter-spacing:.01em}
    .imp-par-mes-btn:hover{border-color:#C4B5FD;background:#F5F3FF}
    .imp-par-mes-btn:focus{outline:none;border-color:#8B5CF6;box-shadow:0 0 0 3px rgba(139,92,246,.15)}

    /* Picker custom de mês (popup) */
    .imp-mes-picker{position:fixed;z-index:9999;background:#fff;border-radius:10px;
                    box-shadow:0 12px 32px rgba(0,0,0,.18),0 0 0 1px rgba(15,23,42,.08);
                    padding:12px;width:260px;font-family:inherit;animation:imp-mes-fade .12s ease}
    @keyframes imp-mes-fade{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
    .imp-mes-picker .imp-mes-head{display:flex;align-items:center;justify-content:space-between;
                                   margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid #F3F4F6}
    .imp-mes-picker .imp-mes-nav{background:#F5F3FF;border:1px solid #DDD6FE;color:#4C1D95;
                                  width:28px;height:28px;border-radius:6px;font-size:1rem;font-weight:700;
                                  cursor:pointer;display:flex;align-items:center;justify-content:center;
                                  font-family:inherit;transition:all .1s;line-height:1}
    .imp-mes-picker .imp-mes-nav:hover{background:#EDE9FE;border-color:#C4B5FD}
    .imp-mes-picker .imp-mes-nav:active{transform:scale(.95)}
    .imp-mes-picker .imp-mes-year{font-size:1.05rem;font-weight:800;color:#1E1B4B;
                                   letter-spacing:.02em;font-variant-numeric:tabular-nums}
    .imp-mes-picker .imp-mes-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
    .imp-mes-picker .imp-mes-cell{background:#F9FAFB;border:1px solid transparent;
                                   border-radius:6px;padding:8px 0;font-size:.74rem;font-weight:700;
                                   color:#334155;cursor:pointer;text-transform:uppercase;
                                   letter-spacing:.03em;transition:all .1s;font-family:inherit}
    .imp-mes-picker .imp-mes-cell:hover{background:#EDE9FE;color:#4C1D95}
    .imp-mes-picker .imp-mes-cell.selected{background:#4C1D95;color:#fff;border-color:#4C1D95}
    .imp-mes-picker .imp-mes-cell.selected:hover{background:#5B21B6}
    .imp-mes-picker .imp-mes-footer{display:flex;justify-content:space-between;align-items:center;
                                     margin-top:10px;padding-top:8px;border-top:1px solid #F3F4F6}
    .imp-mes-picker .imp-mes-clear,.imp-mes-picker .imp-mes-today{
      background:transparent;border:none;font-size:.72rem;font-weight:700;cursor:pointer;
      padding:4px 8px;border-radius:4px;font-family:inherit;transition:all .1s}
    .imp-mes-picker .imp-mes-today{color:#4C1D95}
    .imp-mes-picker .imp-mes-today:hover{background:#F5F3FF}
    .imp-mes-picker .imp-mes-clear{color:#9CA3AF}
    .imp-mes-picker .imp-mes-clear:hover{background:#F9FAFB;color:#DC2626}

    .imp-par-sheet tbody td.mes{font-weight:600;color:#BE185D;padding:6px 8px;
                                 position:relative;cursor:pointer;transition:background .12s}
    .imp-par-sheet tbody td.mes:hover{background:#FDF2F8}
    .imp-par-sheet tbody td.mes.zero{color:#D1D5DB;font-weight:400;cursor:default}
    .imp-par-sheet tbody td.mes.zero:hover{background:transparent}
    .imp-par-sheet tbody td.mes.before{color:#E5E7EB;font-weight:400;cursor:default}
    .imp-par-sheet tbody td.mes.before:hover{background:transparent}

    /* Estados de pagamento real — TODAS as parcelas pagas em azul.
       O diagnóstico (igual/acima/abaixo) fica no tooltip da célula.  */
    .imp-par-sheet tbody td.mes.pago-igual,
    .imp-par-sheet tbody td.mes.pago-mais,
    .imp-par-sheet tbody td.mes.pago-menos{
      background:#EFF6FF;color:#1E40AF;
      box-shadow:inset 3px 0 0 #3B82F6
    }
    .imp-par-sheet tbody td.mes.pago-igual:hover,
    .imp-par-sheet tbody td.mes.pago-mais:hover,
    .imp-par-sheet tbody td.mes.pago-menos:hover{background:#DBEAFE}
    /* Pulou (pagamento = 0) — mês em atraso, âmbar */
    .imp-par-sheet tbody td.mes.pago-zero{
      background:#FEF3C7;color:#92400E;font-weight:600;text-decoration:line-through;
      box-shadow:inset 3px 0 0 #F59E0B
    }
    .imp-par-sheet tbody td.mes.pago-zero:hover{background:#FDE68A}

    /* Badge "✓" discreto na célula paga */
    .imp-par-sheet tbody td.mes.pago-igual::before,
    .imp-par-sheet tbody td.mes.pago-mais::before,
    .imp-par-sheet tbody td.mes.pago-menos::before{
      content:"✓";position:absolute;top:2px;left:5px;
      font-size:.55rem;font-weight:700;opacity:.7;line-height:1
    }
    /* Célula em atraso (pagamento = 0) — sem badge, só o estilo âmbar + tachado */
    /* Badge "acumulado" em cima da célula quando mês anterior foi pulado */
    .imp-par-sheet tbody td.mes .imp-acum-badge{
      position:absolute;top:1px;right:3px;
      font-size:.56rem;font-weight:800;
      background:#FEF3C7;color:#92400E;
      padding:1px 4px;border-radius:8px;
      border:1px solid #F59E0B;line-height:1.2;
      pointer-events:none;letter-spacing:.02em
    }

    /* Botão compacto de pagamento (check) — mesmo padrão da aba Receita.
       Invisível por padrão, aparece no hover da própria célula. */
    .imp-par-sheet tbody td.mes .imp-pagar-btn{
      position:absolute;top:3px;right:3px;width:13px;height:13px;padding:0;
      background:transparent;border:1px solid transparent;border-radius:3px;
      color:transparent;font-size:9px;line-height:1;font-weight:900;
      cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:1;
      opacity:0;pointer-events:none;font-family:inherit;
      transition:opacity .12s,transform .1s
    }
    .imp-par-sheet tbody td.mes:hover .imp-pagar-btn{
      opacity:.85;pointer-events:auto;
      background:rgba(255,255,255,.95);border-color:#CBD5E1;color:#64748B
    }
    .imp-par-sheet tbody td.mes.pago-igual:hover .imp-pagar-btn,
    .imp-par-sheet tbody td.mes.pago-mais:hover  .imp-pagar-btn,
    .imp-par-sheet tbody td.mes.pago-menos:hover .imp-pagar-btn,
    .imp-par-sheet tbody td.mes.pago-zero:hover  .imp-pagar-btn{
      background:#3B82F6;border-color:#2563EB;color:#fff
    }
    .imp-par-sheet tbody td.mes .imp-pagar-btn:hover{opacity:1 !important;transform:scale(1.12)}
    .imp-par-sheet tbody td.mes.zero .imp-pagar-btn,
    .imp-par-sheet tbody td.mes.before .imp-pagar-btn{display:none}

    /* Modal "Pagar" */
    .imp-pagar-modal .imp-pagar-head{display:flex;gap:12px;align-items:center;
                                     margin-bottom:16px;padding-bottom:14px;
                                     border-bottom:1px solid var(--bdr)}
    .imp-pagar-modal .imp-pagar-ico{flex:0 0 auto;width:44px;height:44px;border-radius:10px;
                                    background:linear-gradient(135deg,#FDF2F8 0%,#FCE7F3 100%);
                                    color:#BE185D;display:flex;align-items:center;justify-content:center;
                                    box-shadow:inset 0 0 0 1px #F9A8D4}
    .imp-pagar-modal .imp-pagar-title-wrap{flex:1;min-width:0;text-align:left}
    .imp-pagar-modal .imp-pagar-title{font-size:1.02rem;font-weight:700;color:var(--tx);line-height:1.2}
    .imp-pagar-modal .imp-pagar-sub{font-size:.72rem;color:var(--txm);margin-top:2px}
    .imp-pagar-modal .imp-pagar-info{display:grid;grid-template-columns:1fr 1fr;gap:10px;
                                      padding:12px;border-radius:8px;background:#F9FAFB;
                                      margin-bottom:14px}
    .imp-pagar-modal .imp-pagar-kv{display:flex;flex-direction:column;gap:2px}
    .imp-pagar-modal .imp-pagar-kv span{font-size:.64rem;color:var(--txm);
                                         text-transform:uppercase;letter-spacing:.05em;font-weight:600}
    .imp-pagar-modal .imp-pagar-kv b{font-size:.9rem;color:var(--tx);
                                      font-variant-numeric:tabular-nums;font-weight:700}
    .imp-pagar-modal .imp-pagar-juros b{color:#DC2626}
    .imp-pagar-modal .imp-pagar-amort b{color:#059669}
    .imp-pagar-modal .imp-pagar-saldo b{color:#4C1D95}
    .imp-pagar-modal .imp-pagar-field{margin-bottom:14px;text-align:left}
    .imp-pagar-modal .imp-pagar-field label{display:block;font-size:.72rem;
                                             font-weight:700;color:var(--tx);margin-bottom:6px}
    .imp-pagar-modal .imp-pagar-field input{width:100%;padding:10px 12px;font-size:1rem;
                                             border:1.5px solid var(--bdr);border-radius:8px;
                                             font-variant-numeric:tabular-nums;text-align:right;
                                             font-weight:700;color:var(--tx);outline:none;
                                             transition:border-color .15s, box-shadow .15s;
                                             font-family:inherit}
    .imp-pagar-modal .imp-pagar-field input:focus{border-color:#BE185D;
                                                   box-shadow:0 0 0 3px rgba(190,24,93,.12)}
    .imp-pagar-modal .imp-pagar-field input.err{border-color:#DC2626;
                                                 box-shadow:0 0 0 3px rgba(220,38,38,.12)}
    .imp-pagar-modal .imp-pagar-hint{font-size:.68rem;color:var(--txm);margin-top:6px}
    /* Barra de ações do modal de pagamento — secundárias esquerda, primárias direita */
    .imp-pagar-modal .imp-pagar-actions{display:flex;align-items:center;
                                         justify-content:space-between;gap:10px;
                                         padding-top:12px;margin-top:4px;
                                         border-top:1px solid #F3F4F6;flex-wrap:wrap}
    .imp-pagar-modal .imp-pagar-actions-l{display:flex;gap:6px;flex-wrap:wrap}
    .imp-pagar-modal .imp-pagar-actions-r{display:flex;gap:8px;margin-left:auto}
    .imp-pagar-modal .imp-pagar-actions .confirm-btn{min-width:unset;padding:8px 14px;
                                                     font-size:.82rem;border-radius:7px}
    .imp-pagar-modal .imp-pagar-actions .confirm-btn.sec{padding:7px 11px;font-size:.78rem;
                                                          font-weight:600;min-width:unset}
    .imp-pagar-modal .imp-pagar-clear{background:#fff;color:#DC2626;
                                       border:1px solid #FECACA}
    .imp-pagar-modal .imp-pagar-clear:hover:not(:disabled){background:#FEF2F2;border-color:#FCA5A5;color:#B91C1C}
    .imp-pagar-modal .imp-pagar-clear:disabled{opacity:.4;cursor:not-allowed}
    .imp-pagar-modal .imp-pagar-skip{background:#FFFBEB;color:#B45309;
                                      border:1px solid #FCD34D;display:inline-flex;
                                      align-items:center;gap:5px}
    .imp-pagar-modal .imp-pagar-skip:hover{background:#FEF3C7;border-color:#F59E0B;color:#92400E}
    .imp-pagar-modal .imp-pagar-skip svg{width:13px;height:13px}

    /* Lista de parcelas em atraso no modal */
    .imp-atraso-box{background:#FFFBEB;border:1px solid #FCD34D;border-radius:10px;
                    padding:10px 12px;margin-bottom:14px}
    .imp-atraso-hd{font-size:.75rem;font-weight:700;color:#92400E;margin-bottom:6px;
                   letter-spacing:-.01em}
    .imp-atraso-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:3px}
    .imp-atraso-item{display:flex;align-items:center;justify-content:space-between;
                     gap:10px;padding:7px 8px;border-radius:7px;background:#fff;
                     border:1px solid #FCD34D;transition:background .1s}
    .imp-atraso-item:hover{background:#FEF9E7}
    .imp-atraso-item label{display:flex;align-items:center;gap:8px;flex:1;min-width:0;
                           cursor:pointer;margin:0}
    .imp-atraso-item input[type=checkbox]{margin:0;cursor:pointer;accent-color:#B45309;
                                          width:15px;height:15px}
    .imp-atraso-mes{font-size:.8rem;font-weight:700;color:#92400E;
                    font-variant-numeric:tabular-nums}
    .imp-atraso-mes small{font-size:.62rem;font-weight:500;color:#9CA3AF;margin-left:2px}
    .imp-atraso-ori{font-size:.64rem;color:#9CA3AF;font-weight:500;
                    font-variant-numeric:tabular-nums}
    .imp-atraso-val{font-size:.85rem;font-weight:700;color:#DC2626;
                    font-variant-numeric:tabular-nums;white-space:nowrap}
    .imp-atraso-val-inp{width:110px;padding:4px 8px;font-size:.85rem;font-weight:700;
                        color:#DC2626;background:#fff;border:1.5px solid #FCA5A5;
                        border-radius:6px;text-align:right;outline:none;
                        font-variant-numeric:tabular-nums;font-family:inherit;
                        transition:border-color .15s, box-shadow .15s}
    .imp-atraso-val-inp:hover{border-color:#F87171}
    .imp-atraso-val-inp:focus{border-color:#DC2626;box-shadow:0 0 0 3px rgba(220,38,38,.12)}
    .imp-atraso-val-inp.imp-atraso-val-cur{color:#1E40AF;border-color:#BFDBFE}
    .imp-atraso-val-inp.imp-atraso-val-cur:hover{border-color:#93C5FD}
    .imp-atraso-val-inp.imp-atraso-val-cur:focus{border-color:#1E40AF;
                                                  box-shadow:0 0 0 3px rgba(30,64,175,.12)}
    .imp-atraso-item.imp-atraso-current{background:#EFF6FF;border-color:#BFDBFE}
    .imp-atraso-item.imp-atraso-current .imp-atraso-mes{color:#1E40AF}
    .imp-atraso-item.imp-atraso-current .imp-atraso-val{color:#1E40AF}
    .imp-atraso-item input[type=checkbox]:not(:checked) ~ * ,
    .imp-atraso-item:has(input[type=checkbox]:not(:checked)) .imp-atraso-val{
      opacity:.4;text-decoration:line-through
    }
    .imp-atraso-total{display:flex;align-items:center;justify-content:space-between;
                      padding:8px 8px 2px;margin-top:4px;border-top:1px dashed #F59E0B}
    .imp-atraso-total span{font-size:.74rem;font-weight:600;color:#92400E;
                           text-transform:uppercase;letter-spacing:.02em}
    .imp-atraso-total b{font-size:1.05rem;font-weight:800;color:#991B1B;
                        font-variant-numeric:tabular-nums}

    /* Toggle de status (ativo/inativo) do parcelamento */
    .imp-par-status-btn{background:#DCFCE7;color:#15803D;border:1px solid #86EFAC;
                        border-radius:10px;padding:2px 8px;font-size:.58rem;
                        font-weight:800;letter-spacing:.04em;text-transform:uppercase;
                        cursor:pointer;flex:0 0 auto;margin-left:6px;
                        font-family:inherit;transition:all .12s}
    .imp-par-status-btn:hover{background:#BBF7D0;border-color:#4ADE80}
    .imp-par-status-btn.off{background:#FEF3C7;color:#B45309;border-color:#FCD34D}
    .imp-par-status-btn.off:hover{background:#FDE68A;border-color:#F59E0B}
    .imp-par-row.inativo{opacity:.55;background:#F9FAFB}
    .imp-par-row.inativo input,.imp-par-row.inativo select{color:#9CA3AF !important;background:transparent !important}
    .imp-par-row.inativo td.mes{opacity:.55}

    /* Modal de motivo da inativação */
    .imp-inat-modal .imp-inat-options{display:flex;flex-direction:column;gap:4px;
                                       margin-bottom:14px;text-align:left}
    .imp-inat-modal .imp-inat-opt{display:flex;align-items:center;gap:8px;padding:8px 10px;
                                   border:1.5px solid var(--bdr);border-radius:8px;
                                   cursor:pointer;transition:all .1s}
    .imp-inat-modal .imp-inat-opt:hover{background:#F9FAFB;border-color:#D1D5DB}
    .imp-inat-modal .imp-inat-opt input[type=radio]{margin:0;accent-color:#DC2626}
    .imp-inat-modal .imp-inat-opt input[type=radio]:checked ~ span{color:#991B1B;font-weight:700}
    .imp-inat-modal .imp-inat-opt:has(input:checked){background:#FEF2F2;border-color:#FCA5A5}
    .imp-inat-modal .imp-inat-opt span{font-size:.83rem;color:var(--tx)}
    .imp-inat-modal textarea.imp-inat-detail{width:100%;padding:10px 12px;font-size:.88rem;
                                              border:1.5px solid var(--bdr);border-radius:8px;
                                              font-family:inherit;resize:vertical;min-height:64px;
                                              outline:none;transition:border-color .15s}
    .imp-inat-modal textarea.imp-inat-detail:focus{border-color:#DC2626;
                                                    box-shadow:0 0 0 3px rgba(220,38,38,.12)}

    /* Tfoot (totais mensais) */
    .imp-sheet tfoot td{background:#0F172A;color:#CBD5E1;padding:10px 8px;
                        font-size:.72rem;font-weight:700;border-bottom:none;
                        position:sticky;bottom:0;z-index:3;text-align:right;
                        font-variant-numeric:tabular-nums}
    .imp-sheet tfoot td.stk-1{text-align:left;padding-left:14px;color:#F9A8D4}
    .imp-sheet tfoot td.stk{background:#0F172A}
    .imp-sheet tfoot td.yr-tot{background:#1E1B4B;color:#fff}

    .imp-sheet .empty-row td{text-align:center;padding:32px 20px;color:var(--txl);
                             font-size:.78rem;background:#FAFAFA}

    /* Botão excluir imposto corrente (só custom) */
    .imp-row-actions{display:inline-flex;justify-content:center;gap:2px;padding:0 4px}

    /* ── Barra compacta da taxa SELIC (referência do parcelamento) ── */
    .imp-selic-card{display:flex;align-items:center;gap:10px;padding:6px 12px;
                    border-radius:8px;margin-bottom:10px;
                    background:linear-gradient(135deg,#1E1B4B 0%,#4C1D95 50%,#831843 100%);
                    color:#fff;box-shadow:0 2px 8px rgba(76,29,149,.18);
                    position:relative;overflow:hidden}
    .imp-selic-card::before{content:"";position:absolute;inset:0;
                            background:radial-gradient(circle at 85% 50%,rgba(251,207,232,.15) 0%,transparent 55%);
                            pointer-events:none}
    .imp-selic-ico{flex:0 0 auto;width:24px;height:24px;border-radius:6px;
                   background:rgba(255,255,255,.14);color:#FBCFE8;
                   display:flex;align-items:center;justify-content:center;
                   box-shadow:inset 0 0 0 1px rgba(255,255,255,.18)}
    .imp-selic-ico svg{width:14px;height:14px}
    .imp-selic-main{flex:1;min-width:0;display:flex;align-items:baseline;gap:10px;
                    flex-wrap:wrap;z-index:1}
    .imp-selic-lbl{font-size:.62rem;font-weight:700;letter-spacing:.08em;
                   text-transform:uppercase;color:#FBCFE8;opacity:.85}
    .imp-selic-vals{display:inline-flex;align-items:baseline;gap:8px}
    .imp-selic-a{font-size:1rem;font-weight:800;letter-spacing:-.01em;
                 color:#fff;font-variant-numeric:tabular-nums;line-height:1.1}
    .imp-selic-a .u{font-size:.6rem;font-weight:600;margin-left:3px;color:#F9A8D4;
                    letter-spacing:.02em}
    .imp-selic-sep{font-size:.85rem;color:#F9A8D4;opacity:.55}
    .imp-selic-m{font-size:.85rem;font-weight:700;color:#FBCFE8;
                 font-variant-numeric:tabular-nums;line-height:1.1}
    .imp-selic-m .u{font-size:.56rem;font-weight:600;margin-left:3px;color:#F9A8D4;
                    opacity:.75;letter-spacing:.02em}
    .imp-selic-edit{flex:0 0 auto;display:inline-flex;align-items:center;gap:5px;z-index:1;
                    padding:4px 9px;border-radius:6px;font-size:.65rem;font-weight:700;
                    background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.2);
                    cursor:pointer;font-family:inherit;transition:all .15s}
    .imp-selic-edit:hover{background:rgba(255,255,255,.22);border-color:rgba(255,255,255,.35)}
    .imp-selic-edit svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2.2}

    /* Alerta: parcela insuficiente p/ cobrir juros (growing) */
    .imp-par-row.growing{background:#FEF2F2 !important}
    .imp-par-row.growing td.stk-1::after{content:"⚠ parcela insuficiente";margin-left:8px;
                                          font-size:.58rem;color:#B91C1C;font-weight:700;
                                          letter-spacing:.05em;text-transform:uppercase}
    .imp-par-row.growing td.yr-tot{color:#B91C1C !important}

    /* ═══════ MÓDULO ORÇAMENTO ═══════ */
    .orc-toolbar{display:flex;align-items:flex-end;gap:14px;border-bottom:2px solid var(--bdr);
                 margin-bottom:18px;flex-wrap:wrap}
    .orc-toolbar .pes-year-tabs{border-bottom:0;margin-bottom:0}
    .orc-right{display:flex;align-items:center;gap:10px;margin:0 0 8px auto;flex-wrap:wrap}
    .orc-mode-group{display:inline-flex;background:#F1F5F9;border-radius:8px;padding:3px;gap:2px}
    .orc-mode-btn{border:0;background:none;padding:6px 12px;font-size:.72rem;font-weight:700;
                  color:var(--txm);border-radius:6px;cursor:pointer;font-family:inherit;
                  letter-spacing:-0.01em;transition:all .15s}
    .orc-mode-btn:hover{color:var(--blue-d)}
    .orc-mode-btn.active{background:#fff;color:var(--blue-d);box-shadow:0 1px 2px rgba(15,23,42,.08)}
    .orc-ver-wrap{display:inline-flex;align-items:center;gap:6px;padding:3px 4px 3px 10px;
                  background:#F8FAFC;border:1px solid var(--bdr);border-radius:8px}
    .orc-ver-lbl{font-size:.64rem;font-weight:700;color:var(--txm);text-transform:uppercase;
                 letter-spacing:.04em}
    .orc-ver-sel{background:none;border:0;font-family:inherit;font-size:.76rem;font-weight:700;
                 color:var(--tx);padding:4px 4px;cursor:pointer;outline:none;max-width:180px}
    .orc-ver-menu{background:none;border:0;width:26px;height:26px;border-radius:6px;
                  color:var(--txm);cursor:pointer;display:inline-flex;align-items:center;
                  justify-content:center}
    .orc-ver-menu:hover{background:#E2E8F0;color:var(--tx)}
    .orc-ver-menu svg{width:14px;height:14px;stroke-width:2}

    /* Sheet — cabeçalho com sub-linha prev/real/desvio */
    .orc-sheet thead th.mes{min-width:210px;padding:0}
    .orc-sheet thead th.mes .orc-mes-hdr{display:flex;flex-direction:column;align-items:stretch}
    .orc-sheet thead th.mes .orc-mes-nome{padding:7px 0 3px;font-size:.64rem;font-weight:700;
                                           letter-spacing:.05em;text-transform:uppercase;
                                           color:#CBD5E1;text-align:center}
    .orc-sheet thead th.mes .orc-mes-cols{display:grid;grid-template-columns:1fr 1fr 52px;
                                           gap:0;font-size:.55rem;font-weight:700;
                                           text-transform:uppercase;letter-spacing:.04em;
                                           color:#64748B;padding:0 4px 5px}
    .orc-sheet thead th.mes .orc-mes-cols span{text-align:right;padding:0 4px}
    .orc-sheet thead th.mes .orc-mes-cols span.c-des{text-align:center}
    .orc-sheet thead th.yr-tot{min-width:200px}
    .orc-sheet thead th.yr-tot .orc-mes-cols{color:#CBD5E1}
    /* Sheet só tem uma linha de cabeçalho (.mo) — então ela fica colada no topo */
    .orc-sheet thead tr.mo th{top:0}

    /* Grupos / categorias */
    .orc-sheet tbody tr.orc-grp td{background:#F8FAFC !important;font-weight:800;
                                    color:#0F172A;font-size:.76rem}
    .orc-sheet tbody tr.orc-grp td.stk-1{padding:10px 14px}
    /* Linha de Receita — fundo verde claro para destacar (entrada vs. saídas abaixo) */
    .orc-sheet tbody tr.orc-rec td{background:#ECFDF5 !important}
    .orc-sheet tbody tr.orc-rec td.stk-1{color:#047857;font-weight:700;
                                          border-left:3px solid #10B981}
    .orc-sheet tbody tr.orc-rec .orc-cell .c-real{background:#D1FAE5}
    .orc-sheet tbody tr.orc-res td{background:#1E293B !important;color:#F1F5F9 !important;
                                    font-weight:800;font-size:.78rem}
    .orc-sheet tbody tr.orc-res td.stk-1{padding:11px 14px;letter-spacing:-0.01em}
    .orc-sheet tbody td.stk-1{padding:8px 14px;font-weight:600;color:#0F172A}
    .orc-sheet tbody td.stk-1 .orc-cat-ico{display:inline-flex;align-items:center;
                                             justify-content:center;width:18px;height:18px;
                                             border-radius:5px;margin-right:8px;flex-shrink:0;
                                             vertical-align:middle}
    .orc-sheet tbody td.stk-1 .orc-cat-ico svg{width:11px;height:11px;stroke:#fff;stroke-width:2.4;
                                                 fill:none;stroke-linecap:round;stroke-linejoin:round}

    /* Célula tripla (prev | real | desvio) */
    .orc-cell{display:grid;grid-template-columns:1fr 1fr 52px;align-items:stretch;height:100%;
              font-variant-numeric:tabular-nums;font-size:.76rem}
    .orc-cell > *{padding:8px 6px;display:flex;align-items:center;justify-content:flex-end;
                  border-right:1px solid #F1F5F9}
    .orc-cell > *:last-child{border-right:0}
    .orc-cell .c-prev{color:#0F172A;cursor:text}
    .orc-cell .c-prev.edit{background:#EFF6FF;outline:2px solid var(--blue);outline-offset:-2px;
                            border-radius:3px}
    .orc-cell .c-prev input{width:100%;border:0;background:none;text-align:right;
                             font-family:inherit;font-size:inherit;font-weight:inherit;
                             color:inherit;outline:none;padding:0;font-variant-numeric:tabular-nums}
    .orc-cell .c-real{color:#475569;background:#F8FAFC}
    .orc-cell .c-real.empty{color:#94A3B8}
    .orc-cell .c-des{justify-content:center;font-size:.66rem;font-weight:800;letter-spacing:-0.01em;
                     padding:0 3px;color:#475569}

    /* Heatmap por desvio (%) — intensidade relativa */
    .orc-des-h.good5 {background:#ECFDF5;color:#059669}
    .orc-des-h.good10{background:#D1FAE5;color:#047857}
    .orc-des-h.good20{background:#A7F3D0;color:#065F46}
    .orc-des-h.good30{background:#6EE7B7;color:#064E3B}
    .orc-des-h.bad5 {background:#FEF2F2;color:#DC2626}
    .orc-des-h.bad10{background:#FEE2E2;color:#B91C1C}
    .orc-des-h.bad20{background:#FECACA;color:#991B1B}
    .orc-des-h.bad30{background:#FCA5A5;color:#7F1D1D}
    .orc-des-h.neutral{color:#94A3B8}

    /* Modo "previsto" — esconde colunas real e desvio (compacto) */
    .orc-sheet.mode-previsto thead th.mes{min-width:110px}
    .orc-sheet.mode-previsto thead th.mes .orc-mes-cols{grid-template-columns:1fr}
    .orc-sheet.mode-previsto thead th.mes .orc-mes-cols span.c-real,
    .orc-sheet.mode-previsto thead th.mes .orc-mes-cols span.c-des{display:none}
    .orc-sheet.mode-previsto thead th.yr-tot{min-width:110px}
    .orc-sheet.mode-previsto thead th.yr-tot .orc-mes-cols{grid-template-columns:1fr}
    .orc-sheet.mode-previsto thead th.yr-tot .orc-mes-cols span.c-real,
    .orc-sheet.mode-previsto thead th.yr-tot .orc-mes-cols span.c-des{display:none}
    .orc-sheet.mode-previsto .orc-cell{grid-template-columns:1fr}
    .orc-sheet.mode-previsto .orc-cell .c-real,
    .orc-sheet.mode-previsto .orc-cell .c-des{display:none}

    /* Ano-total col */
    .orc-sheet .yr-tot .orc-cell{background:#F1F5F9}
    .orc-sheet .orc-res .yr-tot .orc-cell{background:#0F172A}
    .orc-sheet .orc-res .orc-cell .c-real{background:#1E293B}
    .orc-sheet .orc-res .orc-cell > *{color:#F1F5F9;border-right-color:#334155}

    .orc-foot{font-size:.7rem;color:var(--txl);margin-top:10px;line-height:1.55}
    .orc-foot b{color:var(--txm)}
    .orc-foot i{font-style:italic;color:var(--txm)}

    /* Dica universal de fórmulas (aparece no rodapé de tabelas editáveis) */
    .formula-hint{font-size:.68rem;color:var(--txl);margin:8px 0 0;padding:6px 10px;
                  background:#F8FAFC;border:1px dashed #CBD5E1;border-radius:8px;
                  line-height:1.55;display:flex;align-items:flex-start;gap:6px;flex-wrap:wrap}
    .formula-hint::before{content:'\1F4A1';font-size:.85rem;line-height:1.4;flex:0 0 auto}
    .formula-hint b{color:var(--txm)}
    .formula-hint code{background:#fff;border:1px solid var(--bdr);border-radius:4px;
                       padding:1px 5px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
                       font-size:.65rem;color:#475569}
    .formula-hint::after{
      content:'Dica: dentro de uma f\00F3rmula, clique numa c\00E9lula para inseri-la \2014 ou arraste por v\00E1rias para somar automaticamente em SOMA(\2026). Funciona entre abas. Um balanc\00E3o flutuante mostra o resultado em tempo real.';
      flex:1 0 100%; font-style:italic; color:#64748B;
      margin:2px 0 0 22px; line-height:1.45; font-size:.65rem;
    }
    /* Flash quando o usuário clica numa célula para inseri-la numa fórmula */
    @keyframes formulaRefFlash{
      0%   { box-shadow: 0 0 0 2px #4F46E5, 0 0 0 4px rgba(79,70,229,.25); }
      70%  { box-shadow: 0 0 0 2px #4F46E5, 0 0 0 10px rgba(79,70,229,0); }
      100% { box-shadow: 0 0 0 2px transparent, 0 0 0 0 transparent; }
    }
    .formula-ref-flash, .formula-ref-flash input, input.formula-ref-flash{
      animation: formulaRefFlash .7s ease-out;
      background:#EEF2FF !important;
    }

    /* Célula REFERENCIADA na fórmula atual (enquanto o input fica em edição) */
    .formula-ref-highlight, input.formula-ref-highlight{
      background:#FEF3C7 !important;
      box-shadow: inset 0 0 0 2px #F59E0B !important;
      transition: background .12s, box-shadow .12s;
    }
    /* Célula sendo arrastada AGORA para ser adicionada à fórmula */
    .formula-drag-ref, input.formula-drag-ref{
      background:#DBEAFE !important;
      box-shadow: inset 0 0 0 2px #2563EB !important;
    }
    /* Enquanto há drag ativo, evita seleção de texto e cursor "I-beam" no resto da página */
    body.formula-dragging{ user-select:none; cursor:cell !important; }
    body.formula-dragging *{ user-select:none !important; }

    /* Tooltip flutuante de pré-visualização do cálculo (ao lado/abaixo do input) */
    #formula-preview-tip{
      position:fixed; z-index:99999; display:none;
      background:#0F172A; color:#F8FAFC;
      font-size:.72rem; font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
      padding:7px 10px; border-radius:7px;
      box-shadow:0 8px 24px rgba(15,23,42,.28);
      pointer-events:none; line-height:1.45; max-width:520px;
      border:1px solid rgba(255,255,255,.08);
    }
    #formula-preview-tip .pv-row-formula{display:flex; align-items:baseline; gap:6px;
      color:#E2E8F0; white-space:normal; word-break:break-all; max-width:500px}
    #formula-preview-tip .pv-row-result{display:flex; align-items:baseline; gap:6px;
      margin-top:3px; padding-top:4px; border-top:1px solid rgba(255,255,255,.08);
      white-space:nowrap}
    #formula-preview-tip .pv-expr{flex:1; color:#CBD5E1; font-weight:500}
    #formula-preview-tip .pv-eq{opacity:.55; font-weight:700; flex:0 0 auto}
    #formula-preview-tip b{color:#67E8F9; font-weight:700}

    /* Menu de versão (popover) */
    .orc-ver-pop{position:fixed;z-index:9500;background:#fff;border:1px solid var(--bdr);
                 border-radius:10px;box-shadow:0 12px 32px rgba(15,23,42,.14);
                 min-width:240px;padding:6px}
    .orc-ver-pop button{display:flex;align-items:center;gap:10px;width:100%;padding:9px 12px;
                        border:0;background:none;font-family:inherit;font-size:.78rem;
                        font-weight:600;color:var(--tx);cursor:pointer;border-radius:7px;
                        text-align:left}
    .orc-ver-pop button:hover{background:#F1F5F9}
    .orc-ver-pop button.danger{color:#DC2626}
    .orc-ver-pop button.danger:hover{background:#FEF2F2}
    .orc-ver-pop button svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;
                             stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
    .orc-ver-pop .orc-ver-divider{height:1px;background:var(--bdr);margin:4px 2px}

    /* Modal "Gerar com índice" */
    .orc-gen-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:10px 0 14px}
    .orc-gen-field{display:flex;flex-direction:column;gap:5px}
    .orc-gen-field label{font-size:.68rem;font-weight:700;color:var(--txm);
                         text-transform:uppercase;letter-spacing:.04em}
    .orc-gen-field input,.orc-gen-field select{padding:8px 10px;border:1px solid var(--bdr);
                                                 border-radius:7px;font-family:inherit;
                                                 font-size:.85rem;outline:none;background:#fff}
    .orc-gen-field input:focus,.orc-gen-field select:focus{border-color:var(--blue)}
    .orc-gen-hint{font-size:.72rem;color:var(--txm);background:#F8FAFC;border:1px solid var(--bdr);
                  border-radius:8px;padding:10px 12px;line-height:1.55}
    .orc-gen-hint b{color:var(--tx)}

    /* ── Run-rate (linha auxiliar dentro dos KPIs) ── */
    .orc-rr-line{margin-top:6px;font-size:.68rem;color:var(--txm);line-height:1.4;
                 border-top:1px dashed #E2E8F0;padding-top:6px}
    .orc-rr-line:empty{display:none}
    .orc-rr-line b{color:var(--tx);font-weight:700}

    /* ── Banner de alertas ── */
    .orc-alerts-banner{display:flex;flex-direction:column;gap:8px;margin:0 0 14px}
    .orc-alert{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;
               background:#FFFBEB;border:1px solid #FCD34D;font-size:.78rem;color:#78350F}
    .orc-alert.danger{background:#FEF2F2;border-color:#FCA5A5;color:#7F1D1D}
    .orc-alert .orc-alert-msg{flex:1;line-height:1.5}
    .orc-alert .orc-alert-msg b{color:inherit;font-weight:800}
    .orc-alert .orc-alert-pill{padding:4px 10px;border-radius:999px;background:#fff;
                                border:1px solid currentColor;font-weight:800;font-size:.72rem;
                                font-variant-numeric:tabular-nums;flex-shrink:0}

    /* ── Painel Top 5 desvios ── */
    .orc-top5-panel{background:#fff;border:1px solid var(--bdr);border-radius:12px;
                     margin:0 0 14px;overflow:hidden}
    .orc-top5-hdr{display:flex;align-items:center;justify-content:space-between;
                   padding:11px 16px;border-bottom:1px solid var(--bdr);background:#F8FAFC}
    .orc-top5-hdr b{font-size:.82rem;font-weight:800;color:#0F172A;letter-spacing:-0.01em}
    .orc-top5-toggle{background:none;border:1px solid var(--bdr);border-radius:6px;
                      font-family:inherit;font-size:.68rem;font-weight:700;color:var(--txm);
                      padding:4px 10px;cursor:pointer;text-transform:uppercase;letter-spacing:.04em}
    .orc-top5-toggle:hover{background:#fff;color:var(--tx);border-color:#94A3B8}
    .orc-top5-body{display:grid;grid-template-columns:1fr 1fr;gap:0;padding:4px}
    .orc-top5-col{padding:10px 14px}
    .orc-top5-col + .orc-top5-col{border-left:1px solid var(--bdr)}
    .orc-top5-col-hdr{font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;
                       margin-bottom:6px;padding-bottom:6px;border-bottom:1px dashed #E2E8F0}
    .orc-top5-item{display:flex;align-items:center;gap:10px;padding:7px 0;font-size:.78rem}
    .orc-top5-item + .orc-top5-item{border-top:1px dashed #F1F5F9}
    .orc-top5-item .ico{width:22px;height:22px;border-radius:6px;display:inline-flex;
                         align-items:center;justify-content:center;flex-shrink:0}
    .orc-top5-item .ico svg{width:11px;height:11px;stroke:#fff;stroke-width:2.4;fill:none;
                             stroke-linecap:round;stroke-linejoin:round}
    .orc-top5-item .txt{flex:1;line-height:1.35}
    .orc-top5-item .txt b{font-weight:700;color:#0F172A}
    .orc-top5-item .pct{font-weight:800;font-size:.76rem;font-variant-numeric:tabular-nums;
                         padding:3px 8px;border-radius:6px;flex-shrink:0}
    .orc-top5-item .pct.bom{background:#D1FAE5;color:#047857}
    .orc-top5-item .pct.ruim{background:#FEE2E2;color:#B91C1C}
    @media (max-width:720px){
      .orc-top5-body{grid-template-columns:1fr}
      .orc-top5-col + .orc-top5-col{border-left:0;border-top:1px solid var(--bdr)}
    }

    /* ── Drill-down: botão de expansão ── */
    .orc-expand{background:none;border:0;width:18px;height:18px;border-radius:4px;
                 color:var(--txm);cursor:pointer;display:inline-flex;align-items:center;
                 justify-content:center;margin-right:6px;vertical-align:middle;padding:0;
                 transition:transform .15s, background .15s}
    .orc-expand:hover{background:#E2E8F0;color:var(--tx)}
    .orc-expand svg{width:11px;height:11px;stroke:currentColor;stroke-width:2.4;fill:none;
                     stroke-linecap:round;stroke-linejoin:round}
    .orc-expand.open svg{transform:rotate(90deg)}
    .orc-expand.placeholder{cursor:default;opacity:0;pointer-events:none}

    /* ── Drill-down: linhas-filhas ── */
    .orc-sheet tbody tr.orc-child td{background:#FAFAFB !important;font-size:.74rem;
                                       color:#334155;font-weight:500}
    .orc-sheet tbody tr.orc-child td.stk-1{padding:6px 14px 6px 48px;color:#475569;
                                             font-weight:500;font-style:normal}
    .orc-sheet tbody tr.orc-child .orc-cell{font-size:.72rem}
    .orc-sheet tbody tr.orc-child .orc-cell .c-prev{color:#94A3B8;background:#F8FAFC}
    .orc-sheet tbody tr.orc-child .orc-cell .c-real{background:#fff}
    .orc-sheet tbody tr.orc-child.empty td{text-align:center;font-style:italic;color:var(--txl);
                                            padding:14px}

    /* ── Cenários A × B modal ── */
    .orc-cen-pickers{display:flex;align-items:flex-end;gap:10px;margin:0 0 14px}
    .orc-cen-pickers .orc-cen-pick{flex:1;display:flex;flex-direction:column;gap:5px}
    .orc-cen-pickers .orc-cen-pick label{font-size:.68rem;font-weight:700;color:var(--txm);
                                          text-transform:uppercase;letter-spacing:.04em}
    .orc-cen-pickers .orc-cen-pick select{padding:8px 10px;border:1px solid var(--bdr);
                                           border-radius:7px;font-family:inherit;font-size:.85rem;
                                           background:#fff;outline:none;width:100%}
    .orc-cen-pickers .orc-cen-pick select:focus{border-color:var(--blue)}
    .orc-cen-pickers .orc-cen-vs{font-size:1rem;font-weight:800;color:var(--txm);padding:0 4px 10px}
    .orc-cen-tbl{width:100%;border-collapse:collapse;font-size:.8rem;
                  font-variant-numeric:tabular-nums}
    .orc-cen-tbl th{background:#F8FAFC;color:var(--txm);font-weight:700;font-size:.66rem;
                     text-transform:uppercase;letter-spacing:.04em;padding:8px 10px;
                     text-align:right;border-bottom:1px solid var(--bdr)}
    .orc-cen-tbl th:first-child{text-align:left}
    .orc-cen-tbl td{padding:9px 10px;text-align:right;border-bottom:1px solid #F1F5F9;
                     color:#0F172A}
    .orc-cen-tbl td:first-child{text-align:left;font-weight:600;color:#0F172A}
    .orc-cen-tbl tr.res td{background:#1E293B;color:#F1F5F9;font-weight:800;font-size:.86rem}
    .orc-cen-tbl tr.rec td{background:#ECFDF5}
    .orc-cen-tbl td.bom{color:#047857;font-weight:700}
    .orc-cen-tbl td.ruim{color:#B91C1C;font-weight:700}
    .orc-cen-tbl td.neutro{color:var(--txm)}
    .orc-cen-tbl .orc-cen-dot{display:inline-block;width:9px;height:9px;border-radius:50%;
                               margin-right:8px;vertical-align:middle}

    /* ── Alertas config modal ── */
    .orc-alcfg-tbl{width:100%;border-collapse:collapse;font-size:.82rem;margin:8px 0 4px}
    .orc-alcfg-tbl th{background:#F8FAFC;color:var(--txm);font-weight:700;font-size:.66rem;
                       text-transform:uppercase;letter-spacing:.04em;padding:8px 10px;
                       text-align:left;border-bottom:1px solid var(--bdr)}
    .orc-alcfg-tbl td{padding:9px 10px;border-bottom:1px solid #F1F5F9;vertical-align:middle}
    .orc-alcfg-tbl td.cat{display:flex;align-items:center;gap:8px;font-weight:600}
    .orc-alcfg-tbl td.cat .ico{width:20px;height:20px;border-radius:5px;display:inline-flex;
                                align-items:center;justify-content:center;flex-shrink:0}
    .orc-alcfg-tbl td.cat .ico svg{width:11px;height:11px;stroke:#fff;stroke-width:2.4;fill:none;
                                     stroke-linecap:round;stroke-linejoin:round}
    .orc-alcfg-tbl select,.orc-alcfg-tbl input{padding:6px 8px;border:1px solid var(--bdr);
                                                 border-radius:6px;font-family:inherit;
                                                 font-size:.82rem;outline:none;background:#fff;
                                                 width:100%}
    .orc-alcfg-tbl select:focus,.orc-alcfg-tbl input:focus{border-color:var(--blue)}
    .orc-alcfg-tbl input[type="number"]{text-align:right;max-width:90px}

    /* ════════════════════════════════════════════════════════════════
       GUIA DE PREENCHIMENTO — Árvore radial (overlay tela cheia)
       ════════════════════════════════════════════════════════════════ */
    /* CTA no Início */
    .home-guia-cta{display:flex;align-items:center;gap:18px;
                   background:linear-gradient(135deg,#EEF2FF 0%,#F0FDF4 100%);
                   border:1px solid #DBEAFE;border-radius:14px;
                   padding:16px 22px;margin:16px 0 20px;
                   position:relative;overflow:hidden}
    .home-guia-cta::before{content:'';position:absolute;inset:0 auto 0 0;width:4px;
                           background:linear-gradient(180deg,#6366F1,#3B82F6)}
    .home-guia-cta-icon{width:44px;height:44px;border-radius:11px;flex:0 0 auto;
                        background:linear-gradient(135deg,#6366F1,#3B82F6);color:#fff;
                        display:inline-flex;align-items:center;justify-content:center;
                        box-shadow:0 6px 18px rgba(99,102,241,.35)}
    .home-guia-cta-icon svg{width:22px;height:22px;stroke:currentColor;fill:none;
                            stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .home-guia-cta-txt{flex:1;min-width:0;line-height:1.3}
    .home-guia-cta-txt strong{display:block;font-size:.92rem;font-weight:800;
                              color:#1E293B;letter-spacing:-.015em;margin-bottom:2px}
    .home-guia-cta-txt span{font-size:.78rem;color:#475569;font-weight:500}
    .home-guia-cta-btn{background:#1E293B;color:#fff;border:none;border-radius:10px;
                       padding:10px 18px;font-weight:700;font-size:.82rem;cursor:pointer;
                       transition:all .14s;font-family:inherit;white-space:nowrap;
                       display:inline-flex;align-items:center;gap:6px;flex:0 0 auto}
    .home-guia-cta-btn:hover{background:#0F172A;transform:translateY(-1px);
                             box-shadow:0 8px 20px rgba(15,23,42,.25)}
    .home-guia-cta-btn svg{width:13px;height:13px;stroke:currentColor;fill:none;
                            stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

    /* Overlay fullscreen */
    .overlay.ov-guia-fs{background:rgba(10,15,30,.88);backdrop-filter:blur(6px);
                        z-index:500;padding:0}
    .guia-modal{background:#0B1020;width:100vw;height:100vh;max-width:100vw;
                max-height:100vh;border-radius:0;display:flex;flex-direction:column;
                overflow:hidden;color:#E2E8F0}
    .guia-hd{display:flex;align-items:center;justify-content:space-between;
             padding:14px 22px;border-bottom:1px solid rgba(255,255,255,.08);
             background:linear-gradient(180deg,rgba(15,23,42,.9),rgba(11,16,32,.9));
             flex:0 0 auto}
    .guia-hd-title{display:flex;align-items:center;gap:12px}
    .guia-hd-title h3{font-size:1rem;font-weight:800;color:#fff;letter-spacing:-.015em;
                      margin:0;font-family:inherit}
    .guia-hd-title .eyebrow{font-size:.66rem;font-weight:700;color:#A5B4FC;
                            text-transform:uppercase;letter-spacing:.12em;
                            background:rgba(99,102,241,.18);padding:3px 8px;
                            border-radius:999px;border:1px solid rgba(99,102,241,.35)}
    .guia-hd-stats{display:flex;align-items:center;gap:16px}
    .guia-hd-prog{display:flex;align-items:center;gap:8px;font-size:.76rem;color:#CBD5E1}
    .guia-hd-prog-bar{width:120px;height:6px;border-radius:3px;background:rgba(255,255,255,.08);
                      overflow:hidden;position:relative}
    .guia-hd-prog-bar i{display:block;height:100%;background:linear-gradient(90deg,#10B981,#059669);
                        transition:width .25s ease;border-radius:3px}
    .guia-hd-prog strong{color:#fff;font-weight:800}
    .guia-close{background:none;border:none;color:#94A3B8;cursor:pointer;
                width:34px;height:34px;border-radius:8px;font-size:1.1rem;
                display:inline-flex;align-items:center;justify-content:center;
                transition:all .12s;font-family:inherit}
    .guia-close:hover{color:#fff;background:rgba(255,255,255,.08)}
    .guia-bd{flex:1;display:flex;min-height:0;overflow:hidden}

    /* Área do mapa radial */
    .guia-map-wrap{flex:1;position:relative;overflow:auto;
                   background:
                     radial-gradient(circle at 30% 20%,rgba(99,102,241,.12),transparent 55%),
                     radial-gradient(circle at 75% 75%,rgba(16,185,129,.10),transparent 55%),
                     #0B1020;
                   display:flex;align-items:center;justify-content:center;padding:20px}
    .guia-map{position:relative;width:760px;height:620px;flex:0 0 auto}
    .guia-map svg.guia-links{position:absolute;inset:0;width:100%;height:100%;
                             pointer-events:none;overflow:visible}
    .guia-links line{stroke:rgba(148,163,184,.25);stroke-width:1.5;
                     stroke-dasharray:4 4;transition:stroke .2s, stroke-width .2s}
    .guia-links line.hl{stroke:rgba(99,102,241,.75);stroke-width:2;stroke-dasharray:none}
    .guia-links line.done{stroke:rgba(16,185,129,.55);stroke-dasharray:none}

    /* Nó central */
    .guia-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
                 width:130px;height:130px;border-radius:50%;
                 background:radial-gradient(circle at 30% 30%,#6366F1 0%,#3B82F6 50%,#1E40AF 100%);
                 box-shadow:0 0 0 8px rgba(99,102,241,.15),
                            0 20px 50px rgba(59,130,246,.4),
                            inset 0 2px 10px rgba(255,255,255,.2);
                 display:flex;flex-direction:column;align-items:center;justify-content:center;
                 color:#fff;text-align:center;padding:10px;z-index:2}
    .guia-center-ico{width:34px;height:34px;margin-bottom:4px}
    .guia-center-ico svg{width:100%;height:100%;stroke:#fff;fill:none;stroke-width:2;
                         stroke-linecap:round;stroke-linejoin:round}
    .guia-center strong{font-size:.72rem;font-weight:800;letter-spacing:-.01em;line-height:1.15}
    .guia-center small{font-size:.58rem;color:#C7D2FE;font-weight:600;margin-top:3px;
                       text-transform:uppercase;letter-spacing:.08em}

    /* Nós orbitais */
    .guia-node{position:absolute;width:124px;padding:10px 12px 11px;
               background:#fff;border-radius:14px;cursor:pointer;
               display:flex;flex-direction:column;align-items:center;gap:6px;
               transform:translate(-50%,-50%);
               box-shadow:0 2px 6px rgba(0,0,0,.25),0 10px 30px rgba(0,0,0,.35);
               transition:transform .18s cubic-bezier(.17,.84,.44,1),
                          box-shadow .18s,
                          background .15s;
               z-index:3;border:2px solid transparent}
    .guia-node:hover{transform:translate(-50%,-50%) scale(1.06);
                     box-shadow:0 4px 12px rgba(0,0,0,.3),0 14px 40px rgba(99,102,241,.4);
                     z-index:4}
    .guia-node.active{border-color:#A5B4FC;
                      box-shadow:0 0 0 4px rgba(99,102,241,.25),
                                 0 14px 40px rgba(99,102,241,.55);
                      transform:translate(-50%,-50%) scale(1.06);z-index:5}
    .guia-node.done{background:#F0FDF4;border-color:#86EFAC}
    .guia-node-head{display:flex;align-items:center;gap:6px;width:100%;
                    justify-content:space-between}
    .guia-node-ord{font-size:.58rem;font-weight:800;color:#fff;
                   background:#6366F1;border-radius:999px;padding:2px 7px;line-height:1;
                   letter-spacing:.02em}
    .guia-node.done .guia-node-ord{background:#10B981}
    .guia-node-ring{width:22px;height:22px;flex:0 0 auto;position:relative}
    .guia-node-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
    .guia-node-ring circle{fill:none;stroke-width:3}
    .guia-node-ring .bg{stroke:#E5E7EB}
    .guia-node-ring .fg{stroke:#6366F1;stroke-linecap:round;
                        transition:stroke-dashoffset .3s ease}
    .guia-node.done .guia-node-ring .fg{stroke:#10B981}
    .guia-node-ico{width:32px;height:32px;border-radius:9px;
                   display:inline-flex;align-items:center;justify-content:center;
                   color:#fff;flex:0 0 auto;margin-top:1px}
    .guia-node-ico svg{width:17px;height:17px;stroke:currentColor;fill:none;
                       stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .guia-node-lbl{font-size:.72rem;font-weight:800;color:#0F172A;letter-spacing:-.015em;
                   text-align:center;line-height:1.15;word-break:break-word}
    .guia-node.done .guia-node-lbl{color:#065F46}
    .guia-node-done-badge{position:absolute;top:-6px;right:-6px;width:20px;height:20px;
                          border-radius:50%;background:#10B981;color:#fff;
                          display:inline-flex;align-items:center;justify-content:center;
                          box-shadow:0 2px 6px rgba(16,185,129,.5);opacity:0;
                          transition:opacity .2s, transform .2s;transform:scale(.6)}
    .guia-node.done .guia-node-done-badge{opacity:1;transform:scale(1)}
    .guia-node-done-badge svg{width:11px;height:11px;stroke:currentColor;fill:none;
                               stroke-width:3;stroke-linecap:round;stroke-linejoin:round}

    /* Drawer lateral */
    .guia-drawer{width:420px;flex:0 0 auto;background:#0F172A;
                 border-left:1px solid rgba(255,255,255,.08);
                 display:flex;flex-direction:column;overflow:hidden}
    .guia-drawer-empty{flex:1;display:flex;flex-direction:column;align-items:center;
                       justify-content:center;padding:40px 30px;text-align:center;color:#94A3B8}
    .guia-drawer-empty svg{width:48px;height:48px;stroke:#475569;fill:none;stroke-width:1.6;
                           stroke-linecap:round;stroke-linejoin:round;margin-bottom:14px}
    .guia-drawer-empty strong{color:#CBD5E1;font-size:.92rem;font-weight:700;
                              margin-bottom:5px;letter-spacing:-.01em}
    .guia-drawer-empty span{font-size:.78rem;line-height:1.5}
    .guia-drawer-hd{padding:20px 22px 16px;border-bottom:1px solid rgba(255,255,255,.08)}
    .guia-drawer-ord{display:inline-block;font-size:.6rem;font-weight:800;
                     padding:3px 9px;border-radius:999px;margin-bottom:10px;
                     letter-spacing:.08em;text-transform:uppercase}
    .guia-drawer-title{display:flex;align-items:center;gap:12px;margin-bottom:8px}
    .guia-drawer-ico{width:44px;height:44px;border-radius:11px;
                     display:inline-flex;align-items:center;justify-content:center;
                     color:#fff;flex:0 0 auto}
    .guia-drawer-ico svg{width:22px;height:22px;stroke:currentColor;fill:none;
                         stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .guia-drawer-title h4{font-size:1.1rem;font-weight:800;color:#fff;
                          letter-spacing:-.02em;margin:0;font-family:inherit}
    .guia-drawer-intro{font-size:.82rem;color:#CBD5E1;line-height:1.55;margin-top:6px}
    .guia-drawer-bd{flex:1;overflow-y:auto;padding:18px 22px}
    .guia-drawer-bd::-webkit-scrollbar{width:8px}
    .guia-drawer-bd::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:4px}
    .guia-section-lbl{font-size:.64rem;font-weight:800;color:#94A3B8;
                      text-transform:uppercase;letter-spacing:.1em;
                      margin:0 0 10px;display:flex;align-items:center;
                      justify-content:space-between}
    .guia-section-lbl em{font-style:normal;color:#A5B4FC;font-weight:700}
    .guia-steps{list-style:none;padding:0;margin:0 0 22px;display:flex;
                flex-direction:column;gap:6px}
    .guia-step{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;
               background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);
               border-radius:10px;cursor:pointer;transition:all .14s;
               font-size:.82rem;color:#E2E8F0;line-height:1.45;
               user-select:none}
    .guia-step:hover{background:rgba(99,102,241,.08);border-color:rgba(99,102,241,.25)}
    .guia-step.done{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.28);
                    color:#A7F3D0}
    .guia-step.done .guia-step-txt{text-decoration:line-through;opacity:.72}
    .guia-step-box{width:20px;height:20px;border-radius:6px;flex:0 0 auto;
                   border:2px solid #475569;background:transparent;margin-top:1px;
                   display:inline-flex;align-items:center;justify-content:center;
                   transition:all .12s}
    .guia-step:hover .guia-step-box{border-color:#A5B4FC}
    .guia-step.done .guia-step-box{background:#10B981;border-color:#10B981}
    .guia-step-box svg{width:11px;height:11px;stroke:#fff;fill:none;stroke-width:3;
                        stroke-linecap:round;stroke-linejoin:round;
                        opacity:0;transition:opacity .15s}
    .guia-step.done .guia-step-box svg{opacity:1}
    .guia-step-txt{flex:1}
    .guia-tip{background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.25);
              border-radius:10px;padding:10px 12px 11px;margin-bottom:18px;
              font-size:.76rem;color:#C7D2FE;line-height:1.5}
    .guia-tip strong{color:#E0E7FF;font-weight:700}
    .guia-drawer-ft{padding:14px 22px 18px;border-top:1px solid rgba(255,255,255,.08);
                    display:flex;gap:10px;flex:0 0 auto}
    .guia-btn-open{flex:1;background:#6366F1;color:#fff;border:none;border-radius:10px;
                    padding:11px 16px;font-size:.85rem;font-weight:800;cursor:pointer;
                    transition:all .14s;font-family:inherit;letter-spacing:-.01em;
                    display:inline-flex;align-items:center;justify-content:center;gap:6px}
    .guia-btn-open:hover{background:#4F46E5;transform:translateY(-1px);
                         box-shadow:0 8px 20px rgba(99,102,241,.4)}
    .guia-btn-open svg{width:14px;height:14px;stroke:currentColor;fill:none;
                       stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
    .guia-btn-reset{background:transparent;color:#94A3B8;border:1px solid rgba(255,255,255,.1);
                    border-radius:10px;padding:11px 16px;font-size:.78rem;font-weight:600;
                    cursor:pointer;transition:all .14s;font-family:inherit}
    .guia-btn-reset:hover{color:#FCA5A5;border-color:rgba(252,165,165,.3);
                          background:rgba(252,165,165,.06)}

    /* Responsividade: em telas pequenas empilha mapa em cima e drawer embaixo */
    @media (max-width:980px){
      .guia-bd{flex-direction:column}
      .guia-drawer{width:100%;border-left:none;border-top:1px solid rgba(255,255,255,.08);
                   max-height:50vh}
      .guia-map{width:100%;height:420px;transform:scale(.75);transform-origin:center}
    }

    /* ══════════════════════════════════════════════════════════════
       FOREKASH — landing + gate de autenticação
       Estética: Taller (dark, geométrico) × Airtable (limpo, marketing-ready)
       ══════════════════════════════════════════════════════════════ */
    body.fk-locked{overflow:hidden}
    body.fk-locked > *:not(.fk-gate):not(.fk-auth-backdrop){visibility:hidden}
    .fk-gate{position:fixed;inset:0;z-index:9999;background:#FAFAFA;overflow-y:auto;
             font-family:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',Roboto,sans-serif;
             color:#111827;animation:fkFadeIn .4s ease-out}
    @keyframes fkFadeIn{from{opacity:0}to{opacity:1}}
    @keyframes fkDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.7)}}
    @keyframes fkAurora{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(30px,-20px) scale(1.1)}}
    @keyframes fkSlide{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
    @keyframes fkShake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}

    /* ── Nav top (sticky) ── */
    .fk-nav{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:32px;
            padding:14px 44px;background:rgba(255,255,255,.88);backdrop-filter:blur(12px);
            border-bottom:1px solid rgba(15,23,42,.06)}
    .fk-nav-brand{display:flex;align-items:center;gap:10px;cursor:pointer}
    .fk-nav-brand .fk-logo-icon{width:30px;height:30px;flex-shrink:0}
    .fk-nav-brand .fk-logo-text{font-size:1.22rem;font-weight:900;letter-spacing:-.03em;color:#0F172A;line-height:1;display:inline-flex;align-items:baseline}
    .fk-nav-brand .fk-logo-text em{font-style:normal;color:#10B981;position:relative}
    .fk-nav-brand .fk-logo-text em::after{content:'';display:inline-block;width:5px;height:5px;
             background:#10B981;border-radius:50%;margin-left:4px;box-shadow:0 0 10px rgba(16,185,129,.8);
             animation:fkDot 2s ease-in-out infinite;vertical-align:1px}
    .fk-nav-tabs{display:flex;gap:4px;flex:1}
    .fk-nav-tabs a{display:inline-flex;align-items:center;gap:4px;padding:9px 14px;border-radius:8px;
                   font-size:.9rem;font-weight:600;color:#374151;text-decoration:none;cursor:pointer;
                   transition:background .12s,color .12s}
    .fk-nav-tabs a:hover{background:#F3F4F6;color:#0F172A}
    .fk-nav-tabs a .ar{font-size:.68rem;opacity:.55;transition:transform .18s}
    .fk-nav-tabs a:hover .ar{transform:translateY(1px)}
    .fk-nav-actions{display:flex;align-items:center;gap:8px}
    .fk-nav-btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:8px;
                font-size:.88rem;font-weight:700;font-family:inherit;cursor:pointer;border:1px solid transparent;
                background:transparent;color:#0F172A;transition:all .15s}
    .fk-nav-btn:hover{background:#F3F4F6}
    .fk-nav-btn.primary{background:#0F172A;color:#fff;border-color:#0F172A}
    .fk-nav-btn.primary:hover{background:#1E293B;box-shadow:0 4px 10px rgba(15,23,42,.2)}

    /* ── Hero ── */
    .fk-hero{position:relative;padding:92px 44px 100px;overflow:hidden;
             background:linear-gradient(180deg,#FAFAFA 0%,#F3F4F6 100%)}
    .fk-hero::before{content:'';position:absolute;top:-200px;right:-160px;width:650px;height:650px;
                     background:radial-gradient(circle,rgba(16,185,129,.1),transparent 65%);
                     pointer-events:none;animation:fkAurora 14s ease-in-out infinite}
    .fk-hero::after{content:'';position:absolute;bottom:-260px;left:-160px;width:650px;height:650px;
                    background:radial-gradient(circle,rgba(99,102,241,.08),transparent 70%);
                    pointer-events:none;animation:fkAurora 16s ease-in-out infinite reverse}
    .fk-hero-inner{position:relative;z-index:1;max-width:1180px;margin:0 auto;display:grid;
                   grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:64px;align-items:center}
    .fk-eyebrow{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;background:#ECFDF5;
                color:#047857;border:1px solid #A7F3D0;border-radius:999px;
                font-size:.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;margin-bottom:22px}
    .fk-eyebrow .dot{width:6px;height:6px;border-radius:50%;background:#10B981;
                     box-shadow:0 0 8px rgba(16,185,129,.7);animation:fkDot 2s ease-in-out infinite}
    .fk-hero h1{font-size:3.2rem;font-weight:900;letter-spacing:-.03em;line-height:1.05;color:#0F172A;margin:0}
    .fk-hero h1 em{font-style:normal;background:linear-gradient(135deg,#10B981 0%,#6366F1 100%);
                   -webkit-background-clip:text;background-clip:text;color:transparent}
    .fk-hero .fk-hero-sub{margin-top:20px;font-size:1.12rem;line-height:1.55;color:#4B5563;max-width:560px}
    .fk-hero .fk-hero-ctas{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
    .fk-hero-trust{display:flex;gap:18px;margin-top:34px;color:#6B7280;font-size:.82rem}
    .fk-hero-trust span{display:inline-flex;align-items:center;gap:6px}
    .fk-hero-trust svg{width:14px;height:14px;stroke:#10B981;fill:none;stroke-width:2.6;
                       stroke-linecap:round;stroke-linejoin:round}

    /* Mockup/card do lado direito do hero */
    .fk-hero-visual{position:relative}
    .fk-hero-card{background:#0F172A;border-radius:18px;padding:22px;color:#F8FAFC;
                  box-shadow:0 24px 60px -20px rgba(15,23,42,.5);
                  border:1px solid rgba(255,255,255,.06);position:relative;overflow:hidden}
    .fk-hero-card::before{content:'';position:absolute;inset:0;background:
      linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);
      background-size:28px 28px;pointer-events:none}
    .fk-hero-card-head{display:flex;align-items:center;gap:10px;position:relative}
    .fk-hero-card-head img{width:42px;height:42px;border-radius:10px;background:#FAFAF7}
    .fk-hero-card-head b{font-size:.82rem;letter-spacing:.02em;color:#F8FAFC;display:block}
    .fk-hero-card-head b::after{content:'●';color:#10B981;margin-left:6px;font-size:.6rem;animation:fkDot 2s infinite}
    .fk-hero-card-head span{font-size:.72rem;color:#64748B;display:block;margin-top:1px}
    .fk-hero-card-body{margin-top:14px;padding:14px 16px;background:rgba(255,255,255,.03);
                       border:1px solid rgba(255,255,255,.06);border-radius:12px;font-size:.9rem;
                       color:#CBD5E1;line-height:1.5;position:relative}
    .fk-hero-card-body em{font-style:normal;color:#10B981;font-weight:600}
    .fk-hero-card-metrics{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:14px;position:relative}
    .fk-hero-card-metric{padding:10px 12px;background:rgba(255,255,255,.04);border-radius:9px;
                         border:1px solid rgba(255,255,255,.06)}
    .fk-hero-card-metric .mlbl{font-size:.64rem;color:#64748B;letter-spacing:.05em;text-transform:uppercase;font-weight:700}
    .fk-hero-card-metric .mval{font-size:1.05rem;color:#F8FAFC;font-weight:800;margin-top:2px}
    .fk-hero-card-metric.g .mval{color:#10B981}
    .fk-hero-card-metric.a .mval{color:#F59E0B}

    /* ── Seções padronizadas ── */
    .fk-section{padding:88px 44px;border-top:1px solid rgba(15,23,42,.06)}
    .fk-section-inner{max-width:1180px;margin:0 auto}
    .fk-section-head{text-align:center;max-width:700px;margin:0 auto 52px}
    .fk-section-head .fk-kicker{font-size:.78rem;font-weight:800;color:#10B981;letter-spacing:.1em;
                                 text-transform:uppercase;margin-bottom:12px}
    .fk-section-head h2{font-size:2.2rem;font-weight:900;letter-spacing:-.02em;color:#0F172A;line-height:1.1;margin:0}
    .fk-section-head p{margin-top:14px;font-size:1.02rem;color:#4B5563;line-height:1.55}
    .fk-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
    .fk-card{padding:26px 24px;background:#fff;border:1px solid #E5E7EB;border-radius:14px;
