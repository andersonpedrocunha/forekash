    .pcard-tabs button.active{background:#fff;color:#5B21B6;box-shadow:0 1px 2px rgba(15,23,42,.08)}
    .pcard-pagto{display:flex;flex-direction:column;gap:14px}
    .pcard-pagto .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .pcard-pagto .row.full{grid-template-columns:1fr}
    .pcard-pagto .fld label{display:block;font-size:.7rem;font-weight:700;color:#475569;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em}
    .pcard-pagto .fld input, .pcard-pagto .fld select{width:100%;padding:7px 10px;border:1px solid #CBD5E1;border-radius:6px;font-family:inherit;font-size:.82rem;background:#fff}
    .pcard-pagto .fld input:focus, .pcard-pagto .fld select:focus{outline:none;border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.12)}
    .pcard-pagto h5{margin:0 0 6px;font-size:.66rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.1em}
    .pcard-pix-wrap{position:relative}
    .pcard-pix-wrap input{padding-right:36px !important}
    .pcard-pix-wrap .pix-ic{position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:1rem;line-height:1;pointer-events:none;font-weight:900}
    /* Validação PIX */
    .fcard-pix-wrap{position:relative}
    .fcard-pix-wrap input{padding-right:36px}
    .fcard-pix-wrap .pix-ic{position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:1rem;line-height:1;pointer-events:none}
    .fcard-pix-info{display:inline-flex;align-items:center;gap:6px;margin-top:6px;font-size:.7rem;font-weight:600;padding:3px 9px;border-radius:11px}
    .fcard-pix-info.ok{background:#DCFCE7;color:#166534}
    .fcard-pix-info.err{background:#FEE2E2;color:#991B1B}
    .fcard-pix-info.neutral{background:#F1F5F9;color:#64748B}
    /* ══ Módulo Cartões de Crédito ══ */
    .cart-wrap{display:flex;flex-direction:column;gap:18px;margin-top:6px}
    .cart-hd{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap}
    .cart-hd-tit h2{margin:0;font-size:1.4rem;font-weight:800;color:#0F172A;letter-spacing:-.02em}
    .cart-hd-tit p{margin:4px 0 0;font-size:.84rem;color:#64748B}
    .cart-hd-actions{display:flex;gap:8px;flex-wrap:wrap}
    .cart-btn{padding:8px 14px;border-radius:7px;border:1px solid;cursor:pointer;font-size:.78rem;font-weight:700;font-family:inherit;letter-spacing:.01em;transition:all .12s}
    .cart-btn-primary{background:#7C3AED;border-color:#6D28D9;color:#fff}
    .cart-btn-primary:hover{background:#6D28D9}
    .cart-btn-secondary{background:#fff;border-color:#E2E8F0;color:#475569}
    .cart-btn-secondary:hover{background:#F1F5F9;color:#0F172A;border-color:#CBD5E1}
    .cart-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
    .cart-kpi{background:#fff;border:1px solid #E2E8F0;border-radius:10px;padding:14px}
    .cart-kpi-lbl{font-size:.66rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}
    .cart-kpi-val{font-size:1.4rem;font-weight:800;color:#0F172A;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
    .cart-kpi-sub{font-size:.72rem;color:#64748B;margin-top:3px}
    .cart-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
    .cart-card{position:relative;color:#fff;border-radius:14px;padding:16px;cursor:pointer;
      box-shadow:0 6px 18px rgba(15,23,42,.18);transition:all .15s;overflow:hidden;
      min-height:170px;display:flex;flex-direction:column;justify-content:space-between}
    .cart-card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at top right, rgba(255,255,255,.18) 0%, transparent 60%);pointer-events:none}
    .cart-card:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(15,23,42,.25)}
    .cart-card.is-inactive{opacity:.55;filter:grayscale(.5)}
    .cart-card-top{display:flex;justify-content:space-between;align-items:flex-start;position:relative}
    .cart-card-apelido{font-size:.96rem;font-weight:800;letter-spacing:-.01em}
    .cart-card-bandeira{font-size:.7rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;opacity:.85}
    .cart-card-banco{font-size:.7rem;opacity:.75;margin-top:2px}
    .cart-card-meio{position:relative;margin:14px 0}
    .cart-card-num{font-family:Menlo,Consolas,monospace;font-size:1rem;letter-spacing:.18em;font-weight:600}
    .cart-card-bot{display:flex;justify-content:space-between;align-items:flex-end;position:relative;gap:12px}
    .cart-card-limite{flex:1}
    .cart-card-limite-lbl{font-size:.6rem;opacity:.75;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}
    .cart-card-limite-val{font-size:.86rem;font-weight:700}
    .cart-card-bar{height:4px;background:rgba(255,255,255,.25);border-radius:2px;overflow:hidden;margin-top:5px}
    .cart-card-bar-fill{height:100%;background:#fff;transition:width .3s}
    .cart-card-bar-fill.is-warn{background:#FCD34D}
    .cart-card-bar-fill.is-danger{background:#FCA5A5}
    .cart-card-venc{font-size:.66rem;text-align:right;opacity:.85}
    .cart-card-venc b{font-size:.84rem;font-weight:800;display:block;letter-spacing:-.01em}
    .cart-empty{padding:60px 20px;text-align:center;background:#fff;border:1px dashed #CBD5E1;border-radius:12px;color:#94A3B8}
    .cart-empty .ico{font-size:3rem;display:block;margin-bottom:12px;opacity:.5}
    .cart-empty .title{font-size:1rem;font-weight:700;color:#475569;margin-bottom:6px}
    .cart-empty .sub{font-size:.84rem;color:#94A3B8;margin-bottom:14px}
    /* Modal: cadastrar/editar cartão */
    .cart-modal-ov{position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:10000;display:flex;align-items:center;justify-content:center;padding:20px}
    .cart-modal{background:#fff;border-radius:14px;box-shadow:0 24px 64px rgba(15,23,42,.32);width:min(560px,100%);max-height:92vh;display:flex;flex-direction:column;overflow:hidden}
    .cart-modal-hd{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid #F1F5F9}
    .cart-modal-hd h3{flex:1;margin:0;font-size:1rem;font-weight:800;color:#0F172A}
    .cart-modal-hd .x{background:transparent;border:none;font-size:1.3rem;cursor:pointer;color:#64748B;line-height:1;padding:4px 8px;border-radius:4px}
    .cart-modal-hd .x:hover{background:#F1F5F9;color:#1E293B}
    .cart-modal-body{flex:1;overflow-y:auto;padding:18px}
    .cart-modal-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
    .cart-modal-row.full{grid-template-columns:1fr}
    .cart-modal-row.three{grid-template-columns:1fr 1fr 1fr}
    .cart-fld label{display:block;font-size:.7rem;font-weight:700;color:#475569;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em}
    .cart-fld input, .cart-fld select{width:100%;padding:8px 10px;border:1px solid #CBD5E1;border-radius:6px;font-family:inherit;font-size:.86rem;background:#fff;color:#0F172A}
    .cart-fld input:focus, .cart-fld select:focus{outline:none;border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.12)}
    /* Combobox custom (cart-cbx) — input + dropdown filtrável com opção "+ Cadastrar" */
    .cart-cbx{position:relative;width:100%}
    .cart-cbx input{width:100%;padding-right:30px}
    .cart-cbx-arr{position:absolute;right:10px;top:50%;transform:translateY(-50%);
                  pointer-events:auto;cursor:pointer;color:#64748B;font-size:.7rem;
                  user-select:none;line-height:1;padding:6px 4px}
    .cart-cbx-arr:hover{color:#0F172A}
    .cart-cbx-pop{position:absolute;top:calc(100% + 4px);left:0;right:0;z-index:50;
                  background:#fff;border:1px solid #CBD5E1;border-radius:8px;
                  box-shadow:0 8px 24px rgba(15,23,42,.12);max-height:240px;
                  overflow-y:auto;display:none}
    .cart-cbx-pop.open{display:block}
    .cart-cbx-item{padding:8px 12px;font-size:.84rem;color:#0F172A;cursor:pointer;
                   border-bottom:1px solid #F1F5F9;display:flex;align-items:center;gap:8px}
    .cart-cbx-item:last-child{border-bottom:none}
    .cart-cbx-item:hover, .cart-cbx-item.active{background:#EDE9FE;color:#5B21B6}
    .cart-cbx-item.empty{color:#94A3B8;cursor:default;font-style:italic;font-size:.78rem}
    .cart-cbx-item.empty:hover{background:transparent;color:#94A3B8}
    .cart-cbx-add{padding:9px 12px;font-size:.84rem;cursor:pointer;
                  background:#F0FDF4;color:#15803D;font-weight:700;
                  border-top:1px solid #BBF7D0;display:flex;align-items:center;gap:8px}
    .cart-cbx-add:hover, .cart-cbx-add.active{background:#DCFCE7}
    .cart-cbx-add::before{content:'+';display:inline-flex;width:18px;height:18px;
                  border-radius:50%;background:#15803D;color:#fff;
                  align-items:center;justify-content:center;font-size:.78rem;font-weight:700}
    .cart-color-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
    .cart-color-opt{width:28px;height:28px;border-radius:8px;cursor:pointer;border:2px solid transparent;transition:all .12s}
    .cart-color-opt:hover{transform:scale(1.1)}
    .cart-color-opt.selected{border-color:#0F172A;box-shadow:0 0 0 2px #fff inset}
    .cart-modal-foot{display:flex;gap:10px;align-items:center;padding:12px 18px;border-top:1px solid #F1F5F9;background:#FAFBFC}
    .cart-modal-foot .left{flex:1}
    .cart-modal-foot button{padding:8px 14px;border-radius:7px;border:1px solid;cursor:pointer;font-family:inherit;font-size:.82rem;font-weight:700;transition:all .12s}
    .cart-modal-foot .ok{background:#7C3AED;border-color:#6D28D9;color:#fff}
    .cart-modal-foot .ok:hover{background:#6D28D9}
    .cart-modal-foot .cancel{background:#fff;border-color:#E2E8F0;color:#475569}
    .cart-modal-foot .cancel:hover{background:#F1F5F9}
    .cart-modal-foot .danger{background:#fff;border-color:#FECACA;color:#B91C1C}
    .cart-modal-foot .danger:hover{background:#FEE2E2}
    /* Seção colapsável "Mais opções" */
    .cart-more-toggle{display:flex;align-items:center;gap:6px;padding:6px 10px;background:transparent;border:none;
      cursor:pointer;font-family:inherit;font-size:.74rem;font-weight:700;color:#64748B;margin-top:6px;border-radius:6px;transition:all .12s}
    .cart-more-toggle:hover{color:#0F172A;background:#F1F5F9}
    .cart-more-toggle .arr{font-size:.7rem;transition:transform .15s}
    .cart-more-toggle.is-open .arr{transform:rotate(90deg)}
    .cart-more-section{margin-top:6px;padding:12px;background:#FAFBFC;border:1px dashed #E2E8F0;border-radius:8px;display:none}
    .cart-more-section.is-open{display:block}
    .cart-more-section .cart-modal-row{margin-bottom:10px}
    .cart-more-section .cart-modal-row:last-child{margin-bottom:0}
    .cart-more-section .cart-fld label{font-size:.66rem;color:#64748B}
    .cart-more-section .cart-fld input, .cart-more-section .cart-fld select{font-size:.78rem;padding:6px 9px}
    /* Anexo */
    .cart-anexo-drop{border:1px dashed #CBD5E1;border-radius:6px;padding:10px;text-align:center;cursor:pointer;
      background:#fff;transition:all .12s;font-size:.76rem;color:#64748B}
    .cart-anexo-drop:hover{border-color:#7C3AED;background:#F5F3FF;color:#5B21B6}
    .cart-anexo-drop input{display:none}
    .cart-anexo-preview{display:flex;align-items:center;gap:8px;padding:6px 10px;background:#fff;border:1px solid #E2E8F0;border-radius:6px}
    .cart-anexo-preview img{width:40px;height:40px;object-fit:cover;border-radius:4px;flex-shrink:0;border:1px solid #E2E8F0}
    .cart-anexo-preview .ico{width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:#F1F5F9;border-radius:4px;font-size:1.4rem;flex-shrink:0}
    .cart-anexo-preview .info{flex:1;min-width:0;font-size:.74rem;color:#475569}
    .cart-anexo-preview .info b{color:#0F172A;font-weight:700;display:block;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}
    .cart-anexo-preview .info .sz{font-size:.66rem;color:#94A3B8}
    .cart-anexo-preview .x{background:transparent;border:none;cursor:pointer;color:#94A3B8;font-size:1rem;font-weight:700;padding:4px 8px;border-radius:4px}
    .cart-anexo-preview .x:hover{background:#FEE2E2;color:#DC2626}
    /* Detalhe do cartão */
    .cart-det{display:flex;flex-direction:column;gap:16px}
    .cart-det-hd{display:flex;align-items:center;gap:14px}
    .cart-det-back{padding:6px 10px;border:1px solid #E2E8F0;border-radius:6px;background:#fff;cursor:pointer;font-family:inherit;font-size:.78rem;color:#475569}
    .cart-det-back:hover{background:#F1F5F9}
    .cart-det-title{flex:1;font-size:1.2rem;font-weight:800;color:#0F172A}
    .cart-det-tabs{display:inline-flex;gap:0;background:#F1F5F9;border-radius:8px;padding:3px}
    .cart-det-tab{padding:6px 14px;background:transparent;border:none;border-radius:5px;cursor:pointer;font-family:inherit;font-size:.78rem;font-weight:700;color:#64748B;transition:all .12s}
    .cart-det-tab.active{background:#fff;color:#5B21B6;box-shadow:0 1px 2px rgba(15,23,42,.08)}
    /* Filtros + Year selector */
    .cart-fat-toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:8px}
    .cart-fat-years{display:inline-flex;gap:0;background:#F1F5F9;border-radius:7px;padding:3px}
    .cart-fat-years button{padding:5px 12px;background:transparent;border:none;border-radius:5px;cursor:pointer;font-family:inherit;font-size:.74rem;font-weight:700;color:#64748B;transition:all .12s}
    .cart-fat-years button.active{background:#fff;color:#5B21B6;box-shadow:0 1px 2px rgba(15,23,42,.08)}
    .cart-fat-years button:hover:not(.active){color:#1E293B}
    .cart-fat-status-tabs{display:inline-flex;gap:0;background:#F1F5F9;border-radius:7px;padding:3px;margin-left:auto}
    .cart-fat-status-tabs button{padding:5px 12px;background:transparent;border:none;border-radius:5px;cursor:pointer;font-family:inherit;font-size:.72rem;font-weight:700;color:#64748B;transition:all .12s;display:inline-flex;align-items:center;gap:4px}
    .cart-fat-status-tabs button.active{background:#fff;color:#0F172A;box-shadow:0 1px 2px rgba(15,23,42,.08)}
    .cart-fat-status-tabs .cnt{font-size:.62rem;background:#E2E8F0;color:#64748B;border-radius:9px;padding:0 6px;font-weight:700}
    .cart-fat-status-tabs button.active .cnt{background:#0F172A;color:#fff}
    /* Resumo do ano */
    .cart-fat-yr-summary{display:flex;gap:14px;padding:8px 14px;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:8px;margin-bottom:8px;font-size:.74rem;color:#475569;flex-wrap:wrap}
    .cart-fat-yr-summary b{color:#0F172A;font-weight:800;font-variant-numeric:tabular-nums}
    /* Tabela compacta */
    .cart-fat-table{width:100%;background:#fff;border:1px solid #E2E8F0;border-radius:10px;border-collapse:separate;border-spacing:0;overflow:hidden;font-size:.82rem}
    .cart-fat-table th{padding:8px 12px;background:#F8FAFC;color:#475569;font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;text-align:left;border-bottom:1px solid #E2E8F0}
    .cart-fat-table td{padding:8px 12px;border-bottom:1px solid #F1F5F9;color:#1E293B;vertical-align:middle}
    .cart-fat-table tr:last-child td{border-bottom:none}
    .cart-fat-table tr:hover td{background:#FAFBFC}
    .cart-fat-table tr.is-current td{background:#FAF5FF}
    .cart-fat-table tr.is-current td:first-child{box-shadow:inset 3px 0 0 #7C3AED}
    .cart-fat-table tr.is-empty td{color:#94A3B8;font-style:italic}
    .cart-fat-table .mes{font-weight:700;color:#0F172A}
    .cart-fat-table .ciclo{font-size:.68rem;color:#94A3B8;margin-top:1px;font-weight:500;display:block}
    /* Strip horizontal de faturas */
    .cart-fat-strip-wrap{position:relative;display:flex;align-items:center;gap:6px}
    .cart-fat-strip-nav{flex-shrink:0;width:32px;height:80px;border:1px solid #E2E8F0;background:#fff;
      border-radius:8px;cursor:pointer;font-size:1.1rem;color:#475569;font-weight:700;font-family:inherit;
      display:flex;align-items:center;justify-content:center;transition:all .12s}
    .cart-fat-strip-nav:hover{background:#F1F5F9;color:#0F172A;border-color:#CBD5E1}
    .cart-fat-strip-nav:disabled{opacity:.3;cursor:not-allowed}
    .cart-fat-strip{flex:1;display:flex;gap:8px;overflow-x:auto;overflow-y:hidden;scroll-behavior:smooth;
      padding:4px 2px 8px;scrollbar-width:thin;scrollbar-color:#CBD5E1 transparent}
    .cart-fat-strip::-webkit-scrollbar{height:6px}
    .cart-fat-strip::-webkit-scrollbar-thumb{background:#CBD5E1;border-radius:3px}
    .cart-fat-strip::-webkit-scrollbar-track{background:transparent}
    .cart-fat-card{flex:0 0 160px;background:#fff;border:1px solid #E2E8F0;border-radius:10px;padding:10px 12px;
      cursor:pointer;transition:all .15s;display:flex;flex-direction:column;gap:4px;position:relative}
    .cart-fat-card:hover{border-color:#F59E0B;box-shadow:0 4px 12px rgba(245,158,11,.18);transform:translateY(-1px)}
    .cart-fat-card.is-current{border-color:#F59E0B;background:#FFFBEB;box-shadow:0 0 0 2px rgba(245,158,11,.15) inset}
    .cart-fat-card.is-paga{background:#F0FDF4;border-color:#BBF7D0}
    .cart-fat-card.is-empty{opacity:.5}
    .cart-fat-card.is-active-view{outline:2px solid #DC2626;outline-offset:1px}
    .cart-fat-card .mes{font-size:.74rem;font-weight:800;color:#0F172A;letter-spacing:-.01em}
    .cart-fat-card .venc{font-size:.62rem;color:#94A3B8;font-weight:600;margin-top:0}
    .cart-fat-card .val{font-size:.95rem;font-weight:800;color:#DC2626;font-variant-numeric:tabular-nums;margin-top:auto;letter-spacing:-.01em}
    .cart-fat-card .val.zero{color:#CBD5E1;font-weight:600}
    .cart-fat-card .val.paga{color:#16A34A}
    .cart-fat-card .st{display:inline-block;padding:1px 6px;border-radius:9px;font-size:.56rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;width:fit-content}
    .cart-fat-card .st.aberta{background:#FEF3C7;color:#92400E}
    .cart-fat-card .st.fechada{background:#FEE2E2;color:#991B1B}
    .cart-fat-card .st.paga{background:#DCFCE7;color:#166534}
    .cart-fat-card .actions{display:flex;gap:4px;margin-top:6px}
    .cart-fat-card .actions button{flex:1;padding:4px 6px;border:1px solid #E2E8F0;background:#fff;
      border-radius:5px;cursor:pointer;font-family:inherit;font-size:.66rem;font-weight:700;color:#475569;transition:all .12s}
    .cart-fat-card .actions button.primary{background:#7C3AED;border-color:#6D28D9;color:#fff}
    .cart-fat-card .actions button.primary:hover{background:#6D28D9}
    .cart-fat-card .actions button:hover:not(.primary){background:#F1F5F9;color:#0F172A}
    /* Modo compacto */
    .cart-fat-table.is-compact th{padding:5px 10px;font-size:.6rem}
    .cart-fat-table.is-compact td{padding:4px 10px;font-size:.74rem}
    .cart-fat-table.is-compact .ciclo{display:none}
    .cart-fat-table.is-compact .mes{font-size:.78rem}
    .cart-fat-table.is-compact .cart-fat-status{font-size:.58rem;padding:1px 6px}
    .cart-fat-table.is-compact .cart-fat-actions button{padding:3px 8px;font-size:.66rem}
    .cart-fat-density-toggle{display:inline-flex;background:#F1F5F9;border-radius:7px;padding:3px;margin-right:4px}
    .cart-fat-density-toggle button{padding:5px 10px;background:transparent;border:none;border-radius:5px;cursor:pointer;font-family:inherit;font-size:.74rem;color:#64748B;transition:all .12s;line-height:1}
    .cart-fat-density-toggle button.active{background:#fff;color:#0F172A;box-shadow:0 1px 2px rgba(15,23,42,.08)}
    .cart-fat-density-toggle button:hover:not(.active){color:#1E293B}
    .cart-fat-table .total-val{font-weight:700;font-variant-numeric:tabular-nums;color:#DC2626}
    .cart-fat-table .total-val.zero{color:#94A3B8;font-weight:500}
    .cart-fat-table .total-val.paga{color:#16A34A}
    .cart-fat-table td.r{text-align:right}
    .cart-fat-status{padding:2px 8px;border-radius:99px;font-size:.62rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;display:inline-block}
    .cart-fat-status.aberta{background:#FEF3C7;color:#92400E}
    .cart-fat-status.fechada{background:#FEE2E2;color:#991B1B}
