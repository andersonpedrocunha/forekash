  estrutura.tipos = estrutura.tipos.filter(t => t.id !== id);
  estSave();
  renderEstTipoManager();
  renderEstrutura();
}

// ═══════════════════════════════════════════════════════════════
//  MÓDULO IMPOSTOS — 2 abas: Correntes + Parcelamento
//  • Correntes: rubricas BR pré-definidas + customizáveis, mês a mês
//  • Parcelamento: simplificado (saldo inicial + parcela + mês início)
//    → saldo mês a mês calculado automaticamente. Dívida ISOLADA.
// ═══════════════════════════════════════════════════════════════
const IMP_KEY   = 'taller_impostos_v1';
const IMP_MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];

// Rubricas padrão brasileiras — ordem reflete estrutura típica de uma PJ
const IMP_RUBRICAS_DEFAULT = [
  { id:'das',    nome:'DAS (Simples Nacional)', color:'#FCA5A5', builtin:true },
  { id:'irpj',   nome:'IRPJ',                   color:'#FDBA74', builtin:true },
  { id:'csll',   nome:'CSLL',                   color:'#FCD34D', builtin:true },
  { id:'pis',    nome:'PIS',                    color:'#86EFAC', builtin:true },
  { id:'cofins', nome:'COFINS',                 color:'#6EE7B7', builtin:true },
  { id:'icms',   nome:'ICMS',                   color:'#7DD3FC', builtin:true },
  { id:'iss',    nome:'ISS',                    color:'#93C5FD', builtin:true },
  { id:'inss',   nome:'INSS RB',                color:'#A5B4FC', builtin:true }
];

const IMP_PALETTE = ['#FCA5A5','#FDBA74','#FCD34D','#86EFAC','#6EE7B7','#7DD3FC',
                     '#93C5FD','#A5B4FC','#C4B5FD','#F9A8D4','#FB7185','#F472B6'];

let impostos = null;
// Ano ativo é INDEPENDENTE por aba: correntes tem sua própria lista de anos
// e parcelamento tem a sua. Adicionar/remover ano em uma aba não afeta a outra.
let impActiveYearCor = null;
let impActiveYearPar = null;
let impActiveTab     = 'correntes';  // 'correntes' | 'parcel'

function impMesKey(y, mIdx){ return y + '-' + String(mIdx+1).padStart(2,'0'); }
function impCurYear(){
  return (impActiveTab === 'parcel' ? impActiveYearPar : impActiveYearCor)
      || (impostos && (impActiveTab === 'parcel' ? impostos.yearsPar : impostos.yearsCor) || [])[0];
}

function impNextRubId(){
  const ids = new Set((impostos.rubricas||[]).map(r=>r.id));
  let n=1; while(ids.has('rub'+n)) n++; return 'rub'+n;
}
function impNextParcId(){
  return (impostos.nextParcId = Math.max(1, impostos.nextParcId||1)) && impostos.nextParcId++;
}

function impLoad(){
  let raw = null;
  try{ raw = localStorage.getItem(IMP_KEY); }catch(e){}
  if(raw){
    try{ impostos = JSON.parse(raw); }catch(e){ impostos = null; }
  }
  if(!impostos || typeof impostos !== 'object'){
    const y = String(new Date().getFullYear());
    impostos = {
      activeYearCor: y,
      activeYearPar: y,
      yearsCor:      [String(parseInt(y)-1), y],
      yearsPar:      [String(parseInt(y)-1), y],
      activeTab:     'correntes',
      selicAnual:    14.75,  // SELIC ao ano (meta Copom) — editável
      rubricas:      JSON.parse(JSON.stringify(IMP_RUBRICAS_DEFAULT)),
      correntes:     [],  // [{rubricaId, valores:{'YYYY-MM':number}}]
      parcelamentos: [],  // [{id,nome,saldoInicial,parcelaMensal,mesInicio:'YYYY-MM',ativo}]
      nextParcId:    1
    };
    // Cria uma linha por rubrica padrão
    for(const r of impostos.rubricas){
      impostos.correntes.push({ rubricaId: r.id, valores: {} });
    }
  }
  // Migração: se selicAnual não existe, usa padrão
  if(impostos.selicAnual === undefined || impostos.selicAnual === null){
    impostos.selicAnual = 14.75;
  }

  // Migração: regime tributário (para previsão automática baseada em Receita)
  if(typeof impostos.regimeTributario !== 'string') impostos.regimeTributario = '';
  // Se o regime ainda não foi escolhido aqui mas existe nas Configurações, usa como pré-seleção
  if(impostos.regimeTributario === ''){
    try {
      if(typeof settings !== 'undefined' && settings && typeof settings.regimeTributario === 'string' && settings.regimeTributario){
        impostos.regimeTributario = settings.regimeTributario;
      }
    } catch(e){}
  }
  if(typeof impostos.atividade        !== 'string') impostos.atividade        = 'servicos';
  if(typeof impostos.simplesAliquota  !== 'number') impostos.simplesAliquota  = 6;
  if(typeof impostos.issAliquota      !== 'number') impostos.issAliquota      = 5;
  if(typeof impostos.meiValor         !== 'number') impostos.meiValor         = 75.90;
  // Alíquota do INSS RB (CPRB — Contribuição Previdenciária sobre a Receita Bruta).
  // 0 = não paga CPRB. Aplicável a Presumido / Real / Personalizado (MEI e Simples não).
  if(typeof impostos.inssAliquota     !== 'number') impostos.inssAliquota     = 0;
  // Regime de apuração do IRPJ/CSLL (só usado em Lucro Presumido/Real): 'mensal' ou 'trimestral'
  if(impostos.apuracao !== 'mensal' && impostos.apuracao !== 'trimestral'){
    impostos.apuracao = 'mensal';
  }
  // Base da receita usada no cálculo dos impostos:
  //   'competencia' (padrão) → tudo o que foi faturado no mês (todas as células com valor)
  //   'caixa'               → apenas o que foi efetivamente recebido (status = 'recebido')
  if(impostos.baseReceita !== 'competencia' && impostos.baseReceita !== 'caixa'){
    impostos.baseReceita = 'competencia';
  }
  // Modo da base de cálculo:
  //   'auto'   (padrão) → puxa receita automaticamente da aba Receita
  //   'manual'          → o usuário preenche a base manualmente, mês a mês
  if(impostos.baseMode !== 'auto' && impostos.baseMode !== 'manual'){
    impostos.baseMode = 'auto';
  }
  // Valores manuais da base (quando baseMode === 'manual'). Chave: "YYYY-MM"
  if(!impostos.baseManual || typeof impostos.baseManual !== 'object' || Array.isArray(impostos.baseManual)){
    impostos.baseManual = {};
  }
  // "Alíquota Única" — percentual plano opcional aplicado sobre a base do mês anterior
  // (competência). Quando ativa e com % > 0, contribui para o Total de Impostos.
  if(typeof impostos.aliquotaUnica !== 'number' || isNaN(impostos.aliquotaUnica)){
    impostos.aliquotaUnica = 0;
  }
  if(typeof impostos.aliquotaUnicaAtiva !== 'boolean'){
    impostos.aliquotaUnicaAtiva = false;
  }
  // Alíquotas personalizadas (regime "custom") — uma por rubrica, em %
  if(!impostos.aliquotasCustom || typeof impostos.aliquotasCustom !== 'object'){
    impostos.aliquotasCustom = { das:6, pis:0.65, cofins:3, irpj:0, csll:0, iss:5, icms:0, inss:0 };
  } else {
    // Garante defaults para chaves faltantes
    const defaults = { das:6, pis:0.65, cofins:3, irpj:0, csll:0, iss:5, icms:0, inss:0 };
    for(const k of Object.keys(defaults)){
      if(typeof impostos.aliquotasCustom[k] !== 'number') impostos.aliquotasCustom[k] = defaults[k];
    }
  }

  // Sanitização / migração — anos por aba (separados entre Correntes e Parcelamento)
  // Legado: `years` era compartilhado. Se presente, copia para as duas abas e descarta.
  const legacyYears = Array.isArray(impostos.years) ? impostos.years.map(String) : null;
  if(!Array.isArray(impostos.yearsCor) || impostos.yearsCor.length === 0){
    impostos.yearsCor = legacyYears && legacyYears.length
                        ? legacyYears.slice()
                        : [String(new Date().getFullYear())];
  }
  if(!Array.isArray(impostos.yearsPar) || impostos.yearsPar.length === 0){
    impostos.yearsPar = legacyYears && legacyYears.length
                        ? legacyYears.slice()
                        : [String(new Date().getFullYear())];
  }
  impostos.yearsCor = impostos.yearsCor.map(String);
  impostos.yearsPar = impostos.yearsPar.map(String);
  delete impostos.years;
  if(!Array.isArray(impostos.rubricas)) impostos.rubricas = [];
  if(!Array.isArray(impostos.correntes)) impostos.correntes = [];
  if(!Array.isArray(impostos.parcelamentos)) impostos.parcelamentos = [];

  // Migração legada: FGTS foi removido como rubrica padrão — descartamos tanto a
  // rubrica quanto a linha correspondente na planilha de Correntes (se existirem).
  impostos.rubricas  = impostos.rubricas.filter(r => r && r.id !== 'fgts');
  impostos.correntes = impostos.correntes.filter(c => c && c.rubricaId !== 'fgts');
  if(!impostos.nextParcId){
    impostos.nextParcId = Math.max(1, impostos.parcelamentos.reduce((m,p)=>Math.max(m,p.id||0),0)+1);
  }

  // Garante que todas as rubricas builtin existem
  const byId = new Map(impostos.rubricas.map(r=>[r.id,r]));
  const resultR = [];
  for(const def of IMP_RUBRICAS_DEFAULT){
    const existing = byId.get(def.id);
    if(existing){
      existing.builtin = true;
      existing.nome = def.nome;  // nome fixo p/ builtin
      if(!existing.color) existing.color = def.color;
      resultR.push(existing); byId.delete(def.id);
    } else {
      resultR.push({...def});
    }
  }
  // Anexa customizadas
  for(const r of impostos.rubricas){
    if(!IMP_RUBRICAS_DEFAULT.some(b=>b.id===r.id)){
      r.builtin = false;
      if(!r.color) r.color = IMP_PALETTE[resultR.length % IMP_PALETTE.length];
      resultR.push(r);
    }
  }
  impostos.rubricas = resultR;

  // Garante uma linha de correntes por rubrica (builtin); mantém order
  const existingCor = new Map(impostos.correntes.map(c=>[c.rubricaId,c]));
  const resultC = [];
  for(const r of impostos.rubricas){
    if(existingCor.has(r.id)){
      const c = existingCor.get(r.id);
      if(!c.valores || typeof c.valores !== 'object') c.valores = {};
      resultC.push(c);
      existingCor.delete(r.id);
    } else {
      resultC.push({ rubricaId: r.id, valores: {} });
    }
  }
  // Órfãs (rubrica foi apagada) — descarta
  impostos.correntes = resultC;

  // Sanitiza parcelamentos
  for(const p of impostos.parcelamentos){
    p.nome           = (p.nome||'').toString();
    p.saldoInicial   = +p.saldoInicial   || 0;
    p.parcelaMensal  = +p.parcelaMensal  || 0;
    p.mesInicio      = p.mesInicio || '';
    if(p.ativo === undefined) p.ativo = true;
    if(!p.id) p.id = impostos.nextParcId++;
    // Pagamentos reais por mês: { 'YYYY-MM': valorPago }
    if(!p.pagamentos || typeof p.pagamentos !== 'object') p.pagamentos = {};
    // Sanitiza pagamentos (chave YYYY-MM, valor ≥ 0)
    const pClean = {};
    for(const k of Object.keys(p.pagamentos)){
      if(/^\d{4}-\d{2}$/.test(k)){
        const v = +p.pagamentos[k];
        if(isFinite(v) && v >= 0) pClean[k] = v;
      }
    }
    p.pagamentos = pClean;
    // Limpa cache derivado p/ garantir recomputação com a matemática atual
    delete p._plan;
    delete p._planKey;
  }

  // Ano ativo — por aba (fallback para valor legado `activeYear` se presente)
  const legacyActive = impostos.activeYear;
  const savedYCor    = impostos.activeYearCor || legacyActive;
  const savedYPar    = impostos.activeYearPar || legacyActive;
  impActiveYearCor = (savedYCor && impostos.yearsCor.includes(savedYCor))
                     ? savedYCor : impostos.yearsCor[impostos.yearsCor.length-1];
  impActiveYearPar = (savedYPar && impostos.yearsPar.includes(savedYPar))
                     ? savedYPar : impostos.yearsPar[impostos.yearsPar.length-1];
  delete impostos.activeYear;
  impActiveTab = (impostos.activeTab === 'parcel') ? 'parcel' : 'correntes';
}

function impSave(){
  impostos.activeYearCor = impActiveYearCor;
  impostos.activeYearPar = impActiveYearPar;
  impostos.activeTab     = impActiveTab;
  try{
    // Serializa sem as chaves derivadas (_plan, _planKey) para evitar vazar
    // caches antigos quando a matemática do plano mudar entre versões.
    localStorage.setItem(IMP_KEY, JSON.stringify(impostos, (k,v) =>
      (k === '_plan' || k === '_planKey') ? undefined : v
    ));
  }catch(e){}
}

function impRubrica(id){ return (impostos.rubricas||[]).find(r=>r.id===id) || null; }

// ─── Render principal ──────────────────────────────────────────
function renderImpostos(){
  if(!impostos) return;
  // Reflete tab ativa nos botões/panes (para caso o load tenha mudado)
  const elCor  = document.getElementById('imp-tab-correntes');
  const elPar  = document.getElementById('imp-tab-parcel');
  const btnCor = document.querySelector('.imp-tab-cor');
  const btnPar = document.querySelector('.imp-tab-par');
  if(elCor && elPar && btnCor && btnPar){
    const isPar = impActiveTab === 'parcel';
    elCor.classList.toggle('active', !isPar);
    elPar.classList.toggle('active',  isPar);
    btnCor.classList.toggle('active', !isPar);
    btnPar.classList.toggle('active',  isPar);
  }
  renderImpCorYearTabs();
  renderImpParYearTabs();
  renderImpSelicBadge();
  renderImpCorSheet();
  renderImpParSheet();
  updateImpCorKpis();
  updateImpParKpis();
}

function switchImpTab(name, btn){
  impActiveTab = (name === 'parcel') ? 'parcel' : 'correntes';
  impSave();
  renderImpostos();
}

// ─── Year tabs (INDEPENDENTES por aba) ─────────────────────────
// Cada aba (Correntes e Parcelamento) tem sua própria lista de anos:
// impostos.yearsCor / impostos.yearsPar. Adicionar ou remover ano
// em uma aba NÃO afeta a outra.
function _impYearsOf(tab){ return tab === 'par' ? impostos.yearsPar : impostos.yearsCor; }
function _impActiveYearOf(tab){ return tab === 'par' ? impActiveYearPar : impActiveYearCor; }

function renderImpCorYearTabs(){
  const el = document.getElementById('imp-cor-year-tabs'); if(!el) return;
  const years = impostos.yearsCor.slice().sort();
  el.innerHTML = years.map(y => {
    const act = y === impActiveYearCor;
    return `<button class="pes-year-tab${act?' active':''}" onclick="setImpActiveYear('cor','${y}')">
      ${y}
      <span class="rec-year-dup" onclick="event.stopPropagation();duplicateImpYear('cor','${y}')" title="Duplicar este ano">⧉</span>
      <span class="pes-year-del" onclick="event.stopPropagation();delImpYear('cor','${y}')" title="Excluir ano">✕</span>
    </button>`;
  }).join('') + `<button class="pes-year-add" onclick="addImpYear('cor')">+ Adicionar ano</button>`;
}
function renderImpParYearTabs(){
  const el = document.getElementById('imp-par-year-tabs'); if(!el) return;
  const years = impostos.yearsPar.slice().sort();
  el.innerHTML = years.map(y => {
    const act = y === impActiveYearPar;
    // Parcelamento não tem valores "do ano" — não faz sentido duplicar.
    return `<button class="pes-year-tab${act?' active':''}" onclick="setImpActiveYear('par','${y}')">
      ${y}
      <span class="pes-year-del" onclick="event.stopPropagation();delImpYear('par','${y}')" title="Excluir ano">✕</span>
    </button>`;
  }).join('') + `<button class="pes-year-add" onclick="addImpYear('par')">+ Adicionar ano</button>`;
}

function setImpActiveYear(tab, y){
  const arr = _impYearsOf(tab);
  if(!arr.includes(y)) return;
  if(tab === 'par') impActiveYearPar = y;
  else              impActiveYearCor = y;
  impSave();
  renderImpostos();
}

async function addImpYear(tab){
  const arr = _impYearsOf(tab);
  const current = arr.slice().sort();
  const suggested = String((parseInt(current[current.length-1])||new Date().getFullYear())+1);
  const ys = await askText({
    title: 'Adicionar ano',
    label: 'Ano',
    placeholder: 'YYYY',
    initialValue: suggested,
    confirmText: 'Adicionar',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!/^\d{4}$/.test(s)) return 'Informe um ano válido de 4 dígitos.';
      if(arr.includes(s)) return 'Esse ano já está cadastrado.';
      return null;
    }
  });
  if(!ys) return;
  arr.push(ys);
  if(tab === 'par') impActiveYearPar = ys;
  else              impActiveYearCor = ys;
  impSave();
  renderImpostos();
}

async function duplicateImpYear(tab, srcYear){
  // Duplicar só faz sentido em Correntes (valores mensais por rubrica).
  // Parcelamento não tem "valores do ano" — seus planos se projetam
  // automaticamente a partir do saldo/parcela/mesInicio.
  if(tab !== 'cor') return;
  const arr = impostos.yearsCor;
  if(!arr.includes(srcYear)) return;
  const suggested = String(parseInt(srcYear)+1);
  const ys = await askText({
    title: 'Duplicar ano',
    label: 'Duplicar valores de ' + srcYear + ' para:',
    placeholder: 'YYYY',
    initialValue: suggested,
    confirmText: 'Duplicar',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!/^\d{4}$/.test(s)) return 'Informe um ano válido de 4 dígitos.';
      if(s === srcYear) return 'Escolha um ano diferente.';
      return null;
    }
  });
  if(!ys) return;
  if(arr.includes(ys)){
    const ok = await showConfirm({
      title: 'Sobrescrever valores',
      message: `O ano <strong>${ys}</strong> já existe. Sobrescrever os impostos correntes atuais com os de ${srcYear}?`,
      confirmLabel: 'Sobrescrever', cancelLabel: 'Cancelar', destructive: true
    });
    if(!ok) return;
  } else {
    arr.push(ys);
  }
  for(const c of impostos.correntes){
    for(let m=0;m<12;m++){
      const srcK = impMesKey(srcYear, m);
      const dstK = impMesKey(ys, m);
      if(c.valores[srcK] !== undefined){
        c.valores[dstK] = c.valores[srcK];
      }
    }
  }
  impActiveYearCor = ys;
  impSave();
  renderImpostos();
}

async function delImpYear(tab, y){
  const arr = _impYearsOf(tab);
  if(!arr.includes(y)) return;
  if(arr.length <= 1){
    await showInfo({title:'Ação não permitida', message:'Não é possível excluir o único ano desta aba.', warning:true});
    return;
  }
  const tabLabel = tab === 'par' ? 'Parcelamento' : 'Impostos Correntes';
  const msg = tab === 'cor'
    ? `Todos os valores mensais de impostos correntes de <strong>${y}</strong> serão removidos. Parcelamentos não são afetados.`
    : `O ano <strong>${y}</strong> deixará de aparecer na aba Parcelamento. Os parcelamentos cadastrados permanecem inalterados (e continuam aparecendo nos outros anos que cobrem).`;
  const ok = await showConfirm({
    title: `Excluir ano ${y} · ${tabLabel}`,
    message: msg,
    confirmLabel: 'Excluir ano', destructive: true
  });
  if(!ok) return;
  if(tab === 'cor'){
    for(const c of impostos.correntes){
      for(let m=0;m<12;m++){ delete c.valores[impMesKey(y, m)]; }
    }
    impostos.yearsCor = arr.filter(x => x !== y);
    if(impActiveYearCor === y) impActiveYearCor = impostos.yearsCor[impostos.yearsCor.length-1];
  } else {
    impostos.yearsPar = arr.filter(x => x !== y);
    if(impActiveYearPar === y) impActiveYearPar = impostos.yearsPar[impostos.yearsPar.length-1];
  }
  impSave();
  renderImpostos();
}

// ═══════════════════════════════════════════════════════════════
//  ABA 1 — IMPOSTOS CORRENTES
// ═══════════════════════════════════════════════════════════════
function renderImpCorSheet(){
  // Sempre que re-renderiza a planilha, atualiza a barra do regime também
  try{ renderImpRegimeBar(); }catch(e){}

  const thead = document.getElementById('imp-cor-thead');
  const tbody = document.getElementById('imp-cor-tbody');
  const tfoot = document.getElementById('imp-cor-tfoot');
  if(!thead || !tbody || !tfoot) return;
  const year = impActiveYearCor;

  const yrRow1 = `<tr class="yr">
    <th class="stk stk-1 l">Imposto</th>
    <th colspan="12" style="text-align:center">${year}</th>
    <th class="yr-tot">Total Ano</th>
    <th class="del"></th>
  </tr>`;
  const mesCols = IMP_MESES.map(m => `<th class="mes">${m.toUpperCase()}/${year.slice(2)}</th>`).join('');
  const yrRow2 = `<tr class="mo">
    <th class="stk stk-1"></th>
    ${mesCols}
    <th class="yr-tot">R$</th>
    <th class="del"></th>
  </tr>`;
  thead.innerHTML = yrRow1 + yrRow2;

  const rows = [];

  // Linha "Base · Receita" — base de cálculo dos impostos, mês a mês.
  //  - Modo AUTO  : puxa a receita bruta da aba Receita (somente leitura).
  //  - Modo MANUAL: o usuário digita os valores (inputs editáveis).
  // A base fica no seu mês natural (jan na coluna jan, fev em fev, etc.).
  // O que desloca é só a PREVISÃO do imposto: o valor na coluna de fevereiro
  // é calculado em cima da base de janeiro (competência do mês anterior).
  const baseMode = (impostos.baseMode === 'manual') ? 'manual' : 'auto';
  const isManualBase = (baseMode === 'manual');
  const baseMeses = [];
  let baseAno = 0;
  for(let m = 0; m < 12; m++){
    const r = impReceitaMes(year, m);
    baseMeses.push(r);
    baseAno += r;
  }
  const baseCells = baseMeses.map((v, mIdx) => {
    if(isManualBase){
      const display = v > 0 ? fmtBR(v, 2) : '';
      return `<td class="mes base-cel base-cel-in">
        <input type="text"
               class="imp-base-input"
               value="${display}"
               placeholder="0,00"
               onblur="setImpBaseValor('${year}', ${mIdx}, this.value)"
               onkeydown="if(event.key==='Enter')this.blur()"
               onfocus="this.select()">
      </td>`;
    }
    return v > 0
      ? `<td class="mes base-cel">${fmtShortBR(v)}</td>`
      : `<td class="mes base-cel"><span class="base-dash">—</span></td>`;
  }).join('');
  const baseTitle = isManualBase
    ? 'Base de cálculo manual. Digite a receita de cada mês — os impostos são calculados a partir disso.'
    : 'Receita bruta mensal vinda automaticamente da aba Receita. Os impostos de cada mês têm como base a receita do mês anterior (competência).';
  // Pill toggle Auto ↔ Manual
  const toggleHtml = `
    <span class="base-mode-toggle" title="Alternar entre puxar da Receita automaticamente ou preencher manualmente">
      <button type="button" class="base-mode-opt${!isManualBase?' on':''}"
              onclick="setImpBaseMode('auto')">Auto</button>
      <button type="button" class="base-mode-opt${ isManualBase?' on':''}"
              onclick="setImpBaseMode('manual')">Manual</button>
    </span>`;
  rows.push(`<tr class="imp-base-row${isManualBase?' manual':''}" title="${esc(baseTitle)}">
    <td class="stk stk-1 base-lbl">
      <div class="imp-base-name">
        <span class="base-ico">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 17l4-4 4 4 5-5"/></svg>
        </span>
        <span class="base-txt">Base · Receita</span>
        ${toggleHtml}
      </div>
    </td>
    ${baseCells}
    <td class="yr-tot base-tot">${baseAno > 0 ? fmtShortBR(baseAno) : '—'}</td>
    <td class="del"></td>
  </tr>`);

  // ───── Linha "Alíquota Única" (OPCIONAL) ─────
  // Aplica um percentual plano sobre a base de cada mês. Contribui para o
  // Total de Impostos (mensal e anual).
  // Segue a MESMA lógica de competência: o imposto do mês M é calculado sobre
  // a base do mês M-1 (janeiro usa dezembro do ano anterior).
  const aliqUnica = +impostos.aliquotaUnica || 0;
  // Toggle estrito controlado pelo chip. Quando o usuário digita um % > 0,
  // o setter liga automaticamente (ver setImpAliquotaUnica) — clicar em
  // "Ocultar alíquota única" esconde a linha sem apagar o valor salvo.
  const aliqOn    = !!impostos.aliquotaUnicaAtiva;
  if(aliqOn){
    let aliqAno = 0;
    const aliqCells = [];
    for(let m = 0; m < 12; m++){
      const baseComp = impReceitaMesCompetencia(year, m);
      if(aliqUnica <= 0 || baseComp <= 0){
        aliqCells.push(`<td class="mes aliq-cel"><span class="aliq-dash">—</span></td>`);
      } else {
        const val = baseComp * (aliqUnica / 100);
        aliqAno += val;
        aliqCells.push(`<td class="mes aliq-cel">${fmtShortBR(val)}</td>`);
      }
    }
    const aliqTitle = 'Alíquota Única: percentual plano aplicado sobre a base do mês anterior (competência). Soma no Total de Impostos.';
    rows.push(`<tr class="imp-aliq-row${aliqUnica>0?' on':''}" title="${esc(aliqTitle)}">
      <td class="stk stk-1 aliq-lbl">
        <div class="imp-aliq-name">
          <span class="aliq-ico">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 16l8-8"/><circle cx="9" cy="9" r="1.5"/><circle cx="15" cy="15" r="1.5"/></svg>
          </span>
          <span class="aliq-txt">Alíquota Única</span>
          <span class="aliq-input-wrap">
            <input type="text"
                   class="aliq-input"
                   value="${aliqUnica > 0 ? fmtBR(aliqUnica, 2) : ''}"
                   placeholder="0,00"
                   onblur="setImpAliquotaUnica(this.value)"
                   onkeydown="if(event.key==='Enter')this.blur()"
                   onfocus="this.select()"
                   title="Percentual único aplicado sobre a base do mês anterior (competência)">
            <span class="aliq-pct">%</span>
          </span>
        </div>
      </td>
      ${aliqCells.join('')}
      <td class="yr-tot aliq-tot">${aliqUnica>0 && aliqAno>0 ? fmtShortBR(aliqAno) : '—'}</td>
      <td class="del"></td>
    </tr>`);
  }

  // Reflete o estado on/off do chip "Alíquota única" no header da tabela
  const chip = document.getElementById('imp-aliq-chip');
  if(chip) chip.classList.toggle('on', aliqOn);
  const chipLbl = document.getElementById('imp-aliq-chip-lbl');
  if(chipLbl) chipLbl.textContent = aliqOn ? 'Ocultar alíquota única' : 'Adicionar alíquota única';
  const chipIco = document.getElementById('imp-aliq-chip-ico');
  if(chipIco){
    // + quando oculto (adicionar) · olho riscado quando visível (ocultar)
    chipIco.innerHTML = aliqOn
      ? '<path d="M17.94 17.94A10.06 10.06 0 0 1 12 20c-7 0-10-8-10-8a19.8 19.8 0 0 1 4.22-5.94"/><path d="M9.88 5.08A10.74 10.74 0 0 1 12 4c7 0 10 8 10 8a19.77 19.77 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="M2 2l20 20"/>'
      : '<path d="M12 5v14M5 12h14"/>';
  }

  if(impostos.correntes.length === 0){
    rows.push(`<tr class="empty-row"><td colspan="${1+12+2}">
      Nenhum imposto cadastrado. Clique em <b>+ Nova rubrica</b> para adicionar.
    </td></tr>`);
  } else {
    for(const c of impostos.correntes){
      rows.push(renderImpCorRow(c, year));
    }
  }
  tbody.innerHTML = rows.join('');

  // Footer: totais por mês + total ano
  const monthTotals = new Array(12).fill(0);
  let grand = 0;
  const aliqExclusiva = aliqOn && aliqUnica > 0;
  // Quando Alíquota Única está ativa E com %, as demais rubricas são
  // desconsideradas (modo exclusivo).
  if(!aliqExclusiva){
    for(const c of impostos.correntes){
      for(let m=0;m<12;m++){
        const v = +c.valores[impMesKey(year, m)] || 0;
        monthTotals[m] += v;
        grand += v;
      }
    }
  }
  // Inclui Alíquota Única (se ativa e com %) no Total de Impostos
  if(aliqExclusiva){
    for(let m = 0; m < 12; m++){
      const baseComp = impReceitaMesCompetencia(year, m);
      if(baseComp > 0){
        const v = baseComp * (aliqUnica / 100);
        monthTotals[m] += v;
        grand += v;
      }
    }
  }
  const mesTot = monthTotals.map(v =>
    `<td>${v ? fmtShortBR(v) : '<span style="color:#64748B">—</span>'}</td>`
  ).join('');

  tfoot.innerHTML = `<tr>
    <td class="stk stk-1">Total de Impostos</td>
    ${mesTot}
    <td class="yr-tot">${fmtBRL(grand)}</td>
    <td></td>
  </tr>`;
}

function renderImpCorRow(c, year){
  const rub = impRubrica(c.rubricaId);
  const color = rub ? rub.color : '#E5E7EB';
  const rowStyle = `style="--trc:${color}"`;
  const isBuiltin = !!(rub && rub.builtin);
  // Modo "exclusivo" da Alíquota Única — rubricas ficam desconsideradas.
  const aliqExclusiva = !!(impostos && impostos.aliquotaUnicaAtiva &&
                           (+impostos.aliquotaUnica || 0) > 0);
  const rowClass = 'imp-cor-row' + (aliqExclusiva ? ' imp-cor-row--muted' : '');

  // Linha de nome (editável apenas se for custom)
  const nameHtml = isBuiltin
    ? `<span class="dot" style="--trc:${color}"></span>
       <span class="nm" style="flex:1;padding:4px 6px;font-weight:600">${esc(rub ? rub.nome : '?')}</span>
       <span class="badge">BR</span>`
    : `<span class="dot" style="--trc:${color}"></span>
       <input type="text" class="nm" value="${esc(rub ? rub.nome : '')}" placeholder="Nome do imposto"
              onblur="renameImpRubrica('${esc(c.rubricaId)}', this.value)"
              onkeydown="if(event.key==='Enter') this.blur()">
       <span class="badge custom">Custom</span>`;

  // Células mensais editáveis (com previsão ghost nas células vazias, se houver regime)
  const pagosMap = c.pagos || {};
  const valCells = IMP_MESES.map((_,m) => {
    const key = impMesKey(year, m);
    const v = c.valores[key];
    const hasReal = (v !== undefined && v !== null && v !== 0);
    const displayVal = hasReal ? fmtBR(v, 2) : '';

    // Previsão — só quando a célula está vazia (e NÃO estamos em modo
    // Alíquota Única exclusiva, já que nesse caso rubricas são desconsideradas).
    let phText = '—';
    let cellExtra = '';
    if(!hasReal && !aliqExclusiva){
      const prev = impForecastValor(c.rubricaId, year, m);
      if(prev != null && prev > 0.005){
        phText = fmtBR(prev, 2);
        cellExtra = ' forecast';
      }
    }

    // Paid state: só aplicável a células com valor real, fora do modo aliq exclusivo
    const pago = hasReal && !aliqExclusiva && !!pagosMap[key];
    if(pago) cellExtra += ' pago';
    if(!hasReal && !cellExtra.includes('forecast')) cellExtra += ' empty';

    // Botão de toggle só aparece em células com valor real e fora do modo exclusivo
    const btnPagar = (hasReal && !aliqExclusiva)
      ? `<button type="button" class="imp-cor-pagar-btn" tabindex="-1"
               onmousedown="event.preventDefault()"
               onclick="event.stopPropagation(); toggleImpCorPago('${esc(c.rubricaId)}','${key}')"
               title="${pago ? 'Marcar como não pago' : 'Marcar como pago'}">✓</button>`
      : '';

    const ro = pago ? ' readonly' : '';
    const roTitle = pago ? ' title="Remova o ✓ para editar"' : '';
    const roClick = pago ? ' onmousedown="notifyLocked()"' : '';
    return `<td class="mes${cellExtra}">
      <input type="text" class="imp-val-input${cellExtra.includes('forecast')?' forecast':''}" value="${displayVal}" placeholder="${phText}"
             data-cellref="impcor:${esc(c.rubricaId)}:${key}"${ro}${roTitle}${roClick}
             onblur="setImpCorValor('${esc(c.rubricaId)}', '${key}', this.value); this.value = (this.value && !isNaN(parseBR(this.value))) ? fmtBR(parseBR(this.value),2) : ''"
             onfocus="this.value = this.value.replace(/\\./g,''); this.select()"
             onkeydown="if(event.key==='Enter') this.blur()">
      ${btnPagar}
    </td>`;
  }).join('');

  // Total do ano
  let tot = 0;
  for(let m=0;m<12;m++) tot += (+c.valores[impMesKey(year, m)] || 0);

  const delBtn = isBuiltin
    ? `<span title="Rubrica padrão — não pode ser excluída" style="color:#D1D5DB;font-size:.8rem">🔒</span>`
    : `<button class="pes-row-btn delete" onclick="delImpRubrica('${esc(c.rubricaId)}')" title="Excluir rubrica">
         <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
           <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m2 0v14a2 2 0 01-2 2H8a2 2 0 01-2-2V6"/>
         </svg>
       </button>`;

  return `<tr class="${rowClass}" ${rowStyle} data-rub-id="${esc(c.rubricaId)}"${aliqExclusiva?' title="Rubrica desconsiderada enquanto a Alíquota Única estiver ativa."':''}>
    <td class="stk stk-1">
      <div class="imp-cor-name">${nameHtml}</div>
    </td>
    ${valCells}
    <td class="yr-tot">${(!aliqExclusiva && tot) ? fmtBRL(tot) : '<span style="color:#D1D5DB">—</span>'}</td>
    <td class="del"><div class="imp-row-actions">${delBtn}</div></td>
  </tr>`;
}

function updateImpCorKpis(){
  const year = impActiveYearCor;
  const aliqOn       = !!(impostos && impostos.aliquotaUnicaAtiva);
  const aliqUnica    = +(impostos && impostos.aliquotaUnica) || 0;
  const aliqExclusiva = aliqOn && aliqUnica > 0;

  let total = 0;
  let maiorNome = '—', maiorVal = 0;
  if(!aliqExclusiva){
    for(const c of impostos.correntes){
      let sub = 0;
      for(let m=0;m<12;m++) sub += (+c.valores[impMesKey(year, m)] || 0);
      total += sub;
      if(sub > maiorVal){ maiorVal = sub; maiorNome = (impRubrica(c.rubricaId)||{}).nome || '—'; }
    }
  }

  // Inclui a linha "Alíquota Única" (se ativa e com %) — modo exclusivo
  if(aliqExclusiva){
    let aliqSub = 0;
    for(let m = 0; m < 12; m++){
      const baseComp = impReceitaMesCompetencia(year, m);
      if(baseComp > 0) aliqSub += baseComp * (aliqUnica / 100);
    }
    total += aliqSub;
    if(aliqSub > maiorVal){ maiorVal = aliqSub; maiorNome = 'Alíquota Única'; }
  }

  const avg = total / 12;

  // Total pago x Em aberto (por célula com valor real, fora do modo Alíquota Única exclusiva)
  let totalPago = 0;
  let totalAberto = 0;
  let countPago = 0;
  let countComValor = 0;
  if(!aliqExclusiva){
    for(const c of impostos.correntes){
      const pagos = c.pagos || {};
      for(let m = 0; m < 12; m++){
        const key = impMesKey(year, m);
        const v = +c.valores[key] || 0;
        if(v <= 0) continue;
        countComValor++;
        if(pagos[key]){
          totalPago += v;
          countPago++;
        } else {
          totalAberto += v;
        }
      }
    }
  }

  const elT = document.getElementById('imp-cor-kpi-total');  if(elT) elT.textContent = fmtBRL(total);
  const elM = document.getElementById('imp-cor-kpi-media');  if(elM) elM.textContent = fmtBRL(avg);
  const elMa= document.getElementById('imp-cor-kpi-maior');  if(elMa) elMa.textContent = maiorNome;
  const elMs= document.getElementById('imp-cor-kpi-maior-sub');
  if(elMs) elMs.textContent = maiorVal > 0 ? fmtBRL(maiorVal) + ' no ano' : 'sem valores no ano';

  const elPago   = document.getElementById('imp-cor-kpi-pago');
  const elAberto = document.getElementById('imp-cor-kpi-aberto');
  if(elPago)   elPago.textContent   = fmtBRL(totalPago);
  if(elAberto) elAberto.textContent = fmtBRL(totalAberto);
}

function setImpCorValor(rubricaId, key, val){
  const c = impostos.correntes.find(x=>x.rubricaId===rubricaId);
  if(!c) return;
  // Regra: célula com ✓ (pago) trava edição até o ✓ ser removido
  if(c.pagos && c.pagos[key]){ notifyLocked(); return; }
  const n = parseBR(val);
  if(!n || isNaN(n)){
    delete c.valores[key];
    // Se a célula foi esvaziada, remove também a marcação de pago
    if(c.pagos && Object.prototype.hasOwnProperty.call(c.pagos, key)){
      delete c.pagos[key];
    }
  } else {
    c.valores[key] = n;
  }
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

// Alterna o estado "pago" de uma célula de Impostos Correntes.
// Só funciona quando a célula tem um valor real lançado.
function toggleImpCorPago(rubricaId, key){
  const c = impostos.correntes.find(x=>x.rubricaId===rubricaId);
  if(!c) return;
  const v = c.valores[key];
  if(v === undefined || v === null || v === 0) return; // sem valor real → nada a marcar
  if(!c.pagos) c.pagos = {};
  if(c.pagos[key]) delete c.pagos[key];
  else             c.pagos[key] = true;
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

// ══════════════════════════════════════════════════════════════════
// PREVISÃO DE IMPOSTOS — baseada no regime tributário + receita mensal
// ══════════════════════════════════════════════════════════════════
// Retorna a base de cálculo (receita bruta) do mês.
// Se o modo é 'manual', usa o valor informado pelo usuário.
// Caso contrário, puxa da aba Receita automaticamente.
function impReceitaMes(year, mIdx){
  if(impostos && impostos.baseMode === 'manual'){
    const key = impMesKey(year, mIdx);
    const v = impostos.baseManual && impostos.baseManual[key];
    return (typeof v === 'number' && !isNaN(v)) ? v : 0;
  }
  try{
    if(typeof flxReceitaMes === 'function') return +flxReceitaMes(year, mIdx) || 0;
  }catch(e){}
  return 0;
}

// Receita da competência do mês anterior (o pagamento em mIdx refere-se ao mês mIdx-1).
// Se mIdx = 0 (janeiro), busca dezembro do ano anterior.
function impReceitaMesCompetencia(year, mIdx){
  if(mIdx === 0){
    const yrAnt = String(+year - 1);
    return impReceitaMes(yrAnt, 11);
  }
  return impReceitaMes(year, mIdx - 1);
}

// Meses em que, no regime trimestral, IRPJ/CSLL são pagos (competência do trimestre anterior):
//  janeiro  → refere-se a Q4 do ano anterior
//  abril    → Q1 do ano corrente
//  julho    → Q2 do ano corrente
//  outubro  → Q3 do ano corrente
function impEhPagamentoTrimestre(mIdx){
  return mIdx === 0 || mIdx === 3 || mIdx === 6 || mIdx === 9;
}

// Soma a receita do trimestre-competência referente ao pagamento em mIdx.
// Deve ser chamado somente quando impEhPagamentoTrimestre(mIdx) === true.
function impReceitaTrimestreCompetencia(year, mIdx){
  if(mIdx === 0){
    // Pagamento em janeiro do ano Y → competência = Q4 de Y-1 (out/nov/dez)
    const yrAnt = String(+year - 1);
    return impReceitaMes(yrAnt, 9) + impReceitaMes(yrAnt, 10) + impReceitaMes(yrAnt, 11);
  }
  // Pagamento em mIdx (3, 6 ou 9) → competência = trimestre anterior (mIdx-3..mIdx-1)
  let soma = 0;
  for(let m = mIdx - 3; m < mIdx; m++){
    soma += impReceitaMes(year, m);
  }
  return soma;
}

// Soma o LUCRO do trimestre-competência para o Lucro Real trimestral (IRPJ/CSLL).
// Usa flxResultadoMes (DRC). Retorna 0 se prejuízo ou dados ausentes.
function impLucroTrimestreCompetencia(year, mIdx){
  const sum = (y, mStart, mEnd) => {
    let s = 0;
    for(let m = mStart; m <= mEnd; m++){
      try{
        if(typeof flxResultadoMes === 'function'){
          s += +flxResultadoMes(y, m) || 0;
        }
      }catch(e){}
    }
    return s;
  };
  if(mIdx === 0){
    // Pagamento em janeiro do ano Y → competência = Q4 de Y-1 (out/nov/dez)
    return sum(String(+year - 1), 9, 11);
  }
  // Pagamento em mIdx (3, 6 ou 9) → competência = trimestre anterior
  return sum(year, mIdx - 3, mIdx - 1);
}

