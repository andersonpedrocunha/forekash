// ═══════════════════════════════════════════════════
//  FOREKASH  —  gate de autenticação local (sem backend)
//  Dados ficam só no navegador. Hash SHA-256 via WebCrypto.
// ═══════════════════════════════════════════════════
const FK_KEY = 'forekash:auth:v1';
const FK_SESSION_DAYS = 30;

function fkLoad(){
  try{
    const raw = localStorage.getItem(FK_KEY);
    const d = raw ? JSON.parse(raw) : null;
    if(d && typeof d === 'object') return Object.assign({users:[], session:null}, d);
  }catch(_){}
  return {users:[], session:null};
}
function fkSave(d){
  try{ localStorage.setItem(FK_KEY, JSON.stringify(d)); }catch(_){}
}
function fkNormEmail(e){ return String(e||'').trim().toLowerCase(); }
async function fkHash(pass, salt){
  const buf = new TextEncoder().encode(String(salt||'') + '::' + String(pass||''));
  const h = await crypto.subtle.digest('SHA-256', buf);
  return Array.from(new Uint8Array(h)).map(b => b.toString(16).padStart(2,'0')).join('');
}
function fkRandomSalt(){
  const a = new Uint8Array(16);
  try{ crypto.getRandomValues(a); }
  catch(_){ for(let i=0;i<16;i++) a[i] = Math.floor(Math.random()*256); }
  return Array.from(a).map(b=>b.toString(16).padStart(2,'0')).join('');
}
function fkSessionValid(d){
  return !!(d && d.session && d.session.userId && d.session.expiresAt > Date.now());
}
function fkCurrentUser(){
  const d = fkLoad();
  if(!fkSessionValid(d)) return null;
  return (d.users || []).find(u => u.id === d.session.userId) || null;
}
function fkInitials(name, email){
  const src = (name || email || '').trim();
  if(!src) return '—';
  const parts = src.split(/[\s@._-]+/).filter(Boolean);
  const a = (parts[0] || '').charAt(0).toUpperCase();
  const b = (parts[1] || '').charAt(0).toUpperCase();
  return (a + b) || a || '—';
}

