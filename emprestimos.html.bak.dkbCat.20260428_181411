// ---------- diagML: biblioteca de machine learning in-browser ----------
const diagML = {
  // Regressão linear por mínimos quadrados: y = a + b*x
  // Retorna coeficientes, R², RMSE e funções predict/forecast
  linearRegression(series){
    const n = series.length;
    if(n < 2) return null;
    let sx=0, sy=0, sxy=0, sxx=0;
    for(let i=0;i<n;i++){ sx+=i; sy+=series[i]; sxy+=i*series[i]; sxx+=i*i; }
    const denom = n*sxx - sx*sx;
    if(denom === 0) return null;
    const b = (n*sxy - sx*sy)/denom;
    const a = (sy - b*sx)/n;
    const meanY = sy/n;
    let ssRes=0, ssTot=0;
    for(let i=0;i<n;i++){
      const pred = a + b*i;
      ssRes += (series[i]-pred)*(series[i]-pred);
      ssTot += (series[i]-meanY)*(series[i]-meanY);
    }
    const r2 = ssTot === 0 ? 1 : Math.max(0, 1 - ssRes/ssTot);
    const rmse = Math.sqrt(ssRes/Math.max(1, n-2));
    return { a, b, r2, rmse, n,
             predict: x => a + b*x,
             forecast: k => Array.from({length:k}, (_,i) => a + b*(n+i)) };
  },

  // Suavização exponencial dupla de Holt (nível + tendência)
  // α = suavização do nível, β = suavização da tendência
  holtSmoothing(series, alpha=0.5, beta=0.3){
    if(series.length < 2) return null;
    let level = series[0];
    let trend = series[1] - series[0];
    const fitted = [level];
    for(let i=1;i<series.length;i++){
      const prevLevel = level;
      level = alpha*series[i] + (1-alpha)*(level + trend);
      trend = beta*(level - prevLevel) + (1-beta)*trend;
      fitted.push(level);
    }
    // Erro médio absoluto relativo como métrica de ajuste
    let mape = 0, cnt = 0;
    for(let i=0;i<series.length;i++){
      if(series[i] !== 0){ mape += Math.abs((series[i]-fitted[i])/series[i]); cnt++; }
    }
    mape = cnt > 0 ? mape/cnt : null;
    return { level, trend, fitted, mape,
             forecast: k => Array.from({length:k}, (_,i) => Math.max(0, level + (i+1)*trend)) };
  },

  // Z-score para detecção de anomalias estatísticas
  zScores(series){
    const n = series.length;
    if(n < 3) return series.map(()=>0);
    const mean = series.reduce((s,v)=>s+v,0)/n;
    const variance = series.reduce((s,v)=>s+(v-mean)*(v-mean),0)/n;
    const std = Math.sqrt(variance);
    if(std === 0) return series.map(()=>0);
    return series.map(v => (v - mean)/std);
  },

  // Correlação de Pearson entre duas séries
  pearson(a, b){
    const n = Math.min(a.length, b.length);
    if(n < 3) return null;
    let sa=0, sb=0, saa=0, sbb=0, sab=0;
    for(let i=0;i<n;i++){
      sa+=a[i]; sb+=b[i];
      saa+=a[i]*a[i]; sbb+=b[i]*b[i]; sab+=a[i]*b[i];
    }
    const num = n*sab - sa*sb;
    const den = Math.sqrt((n*saa - sa*sa) * (n*sbb - sb*sb));
    return den === 0 ? 0 : num/den;
  },

  // Correlação com defasagem: detecta se série A antecede B em k meses
  // Retorna {lag, r} do melhor ajuste
  pearsonLag(a, b, maxLag=4){
    let best = null;
    for(let lag=-maxLag; lag<=maxLag; lag++){
      let aSlice, bSlice;
      if(lag >= 0){ aSlice = a.slice(0, a.length-lag); bSlice = b.slice(lag); }
      else        { aSlice = a.slice(-lag);            bSlice = b.slice(0, b.length+lag); }
      const r = this.pearson(aSlice, bSlice);
      if(r !== null && (!best || Math.abs(r) > Math.abs(best.r))){
        best = { lag, r, n: aSlice.length };
      }
    }
    return best;
  },

  // K-means 1D — segmenta valores em k clusters por proximidade
  // Retorna array com {point, cluster, centroid} e centros ordenados por valor
  kmeans1D(points, k, maxIter=60){
    if(points.length === 0) return { clusters: [], centers: [] };
    if(points.length < k) k = points.length;
    // Inicialização por quantis (mais estável que aleatório)
    const sorted = [...points].sort((a,b)=>a-b);
    let centers = Array.from({length:k}, (_,i) => sorted[Math.floor((i+0.5)*sorted.length/k)]);
    let assign = new Array(points.length).fill(0);
    for(let iter=0; iter<maxIter; iter++){
      let changed = false;
      for(let i=0;i<points.length;i++){
        let bestC = 0, bestD = Infinity;
        for(let c=0;c<k;c++){
          const d = Math.abs(points[i] - centers[c]);
          if(d < bestD){ bestD = d; bestC = c; }
        }
        if(assign[i] !== bestC){ assign[i] = bestC; changed = true; }
      }
      if(!changed) break;
      for(let c=0;c<k;c++){
        const pts = points.filter((_,i)=>assign[i]===c);
        if(pts.length) centers[c] = pts.reduce((s,v)=>s+v,0)/pts.length;
      }
    }
    // Reordena clusters por centro (cluster 0 = maior valor = âncoras)
    const order = centers.map((c,i)=>({c,i})).sort((a,b)=>b.c-a.c).map(x=>x.i);
    const remap = new Array(k);
    order.forEach((o,newIdx)=>{ remap[o] = newIdx; });
    const sortedCenters = order.map(i=>centers[i]);
    return {
      clusters: points.map((p,i)=>({ point:p, cluster: remap[assign[i]], centroid: sortedCenters[remap[assign[i]]] })),
      centers: sortedCenters
    };
  },

  // Decomposição sazonal multiplicativa
  // Retorna trend + fator sazonal por período (mês)
  seasonalDecompose(series, period=12){
    if(series.length < period) return null;
    // Tendência via média móvel centrada
    const half = Math.floor(period/2);
    const trend = [];
    for(let i=0;i<series.length;i++){
      const s = Math.max(0, i-half), e = Math.min(series.length, i+half+1);
      const win = series.slice(s,e);
      trend.push(win.reduce((sv,v)=>sv+v,0)/Math.max(1,win.length));
    }
    // Fator sazonal = média das razões série/tendência agrupadas por mês
    const sumByM = new Array(period).fill(0), cntByM = new Array(period).fill(0);
    for(let i=0;i<series.length;i++){
      if(trend[i] > 0){
        sumByM[i%period] += series[i]/trend[i];
        cntByM[i%period]++;
      }
    }
    const seasonal = sumByM.map((s,i)=> cntByM[i] > 0 ? s/cntByM[i] : 1);
    // Normaliza para média = 1
    const meanS = seasonal.reduce((s,v)=>s+v,0)/period;
    const seasonalNorm = meanS > 0 ? seasonal.map(v => v/meanS) : seasonal;
    return { trend, seasonal: seasonalNorm };
  },

  // Média e desvio padrão (para intervalo de confiança)
  stats(series){
    const n = series.length; if(n === 0) return {mean:0, std:0};
    const mean = series.reduce((s,v)=>s+v,0)/n;
    const varv = series.reduce((s,v)=>s+(v-mean)*(v-mean),0)/Math.max(1,n-1);
    return { mean, std: Math.sqrt(varv), n };
  }
};

