// Filtro de período customizado — de (mês/ano) até (mês/ano)
let vendFiltroAnoDe  = null;
let vendFiltroAnoAte = null;
let vendFiltroMesDe  = null;
let vendFiltroMesAte = null;
// Mantém compat com código antigo que lia vendFiltroAno
let vendFiltroAno    = null;
function _vendFiltroInit(){
  const today = new Date();
  const curY = today.getFullYear(), curM = today.getMonth();
  if(vendFiltroAnoDe  == null) vendFiltroAnoDe  = curY;
  if(vendFiltroAnoAte == null) vendFiltroAnoAte = curY;
  if(vendFiltroMesDe  == null) vendFiltroMesDe  = curM;
  if(vendFiltroMesAte == null) vendFiltroMesAte = curM;
  vendFiltroAno = vendFiltroAnoAte;  // ano "principal" pra labels
}
// Retorna índice absoluto (ano*12+mês) — útil pra comparar range
function _vendAbsIdx(ano, mes){ return (parseInt(ano,10)||0)*12 + (parseInt(mes,10)||0); }
function _vendNormalizeRange(){
  const ini = _vendAbsIdx(vendFiltroAnoDe, vendFiltroMesDe);
  const fim = _vendAbsIdx(vendFiltroAnoAte, vendFiltroMesAte);
  if(fim < ini){
    // Troca pra que "até" fique depois de "de"
    [vendFiltroAnoDe, vendFiltroAnoAte] = [vendFiltroAnoAte, vendFiltroAnoDe];
    [vendFiltroMesDe, vendFiltroMesAte] = [vendFiltroMesAte, vendFiltroMesDe];
  }
  vendFiltroAno = vendFiltroAnoAte;
}
function setVendFiltroMesDe(v){ vendFiltroMesDe = parseInt(v,10); _vendNormalizeRange(); renderVendSheet(); }
function setVendFiltroMesAte(v){ vendFiltroMesAte = parseInt(v,10); _vendNormalizeRange(); renderVendSheet(); }
function setVendFiltroAnoDe(v){ vendFiltroAnoDe = parseInt(v,10); _vendNormalizeRange(); renderVendSheet(); }
function setVendFiltroAnoAte(v){ vendFiltroAnoAte = parseInt(v,10); _vendNormalizeRange(); renderVendSheet(); }
// Compat: setVendFiltroAno seta AMBOS os anos (usado em lugares legados)
function setVendFiltroAno(v){ vendFiltroAnoDe = vendFiltroAnoAte = parseInt(v,10); renderVendSheet(); }
function setVendFiltroAnoInteiro(){
  // Usa o ano "Até" atual como referência (ou hoje, se nunca foi setado)
  const y = vendFiltroAnoAte || new Date().getFullYear();
  vendFiltroAnoDe = vendFiltroAnoAte = y;
  vendFiltroMesDe = 0; vendFiltroMesAte = 11;
  renderVendSheet();
}
function setVendFiltroMesAtual(){
  const today = new Date();
  vendFiltroAnoDe = vendFiltroAnoAte = today.getFullYear();
  vendFiltroMesDe = vendFiltroMesAte = today.getMonth();
  renderVendSheet();
}
try {
  window.setVendFiltroMesDe      = setVendFiltroMesDe;
  window.setVendFiltroMesAte     = setVendFiltroMesAte;
  window.setVendFiltroAno        = setVendFiltroAno;
  window.setVendFiltroAnoDe      = setVendFiltroAnoDe;
  window.setVendFiltroAnoAte     = setVendFiltroAnoAte;
  window.setVendFiltroAnoInteiro = setVendFiltroAnoInteiro;
  window.setVendFiltroMesAtual   = setVendFiltroMesAtual;
} catch(e){}
// Renderiza tabela de vendedores
function renderVendSheet(){
  if(!vendedores) { try { vendedoresLoad(); } catch(e){} }
  if(!vendedores) vendedores = { lista: [], nextId: 1 };
  _vendFiltroInit();
  const thead = document.getElementById('vend-thead');
  const tbody = document.getElementById('vend-tbody');
  const tfoot = document.getElementById('vend-tfoot');
  if(!thead || !tbody) return;
  // Preenche os selects: meses (de/ate) + anos (de/ate)
  const MESES_LBL = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
  const selDe  = document.getElementById('vend-filter-de');
  const selAte = document.getElementById('vend-filter-ate');
  const selAnoDe  = document.getElementById('vend-filter-ano-de');
  const selAnoAte = document.getElementById('vend-filter-ano-ate');
  // Coleta anos relevantes (atual ± 3 + anos com dados)
  const anos = new Set();
  const curY = new Date().getFullYear();
  for(let y = curY - 3; y <= curY + 3; y++) anos.add(y);
  anos.add(vendFiltroAnoDe); anos.add(vendFiltroAnoAte);
  for(const v of (vendedores.lista || [])){
    for(const r of (v.regras || [])){
      if(r.de){ const y = parseInt(r.de.split('-')[0],10); if(!isNaN(y)) anos.add(y); }
      if(r.ate){ const y = parseInt(r.ate.split('-')[0],10); if(!isNaN(y)) anos.add(y); }
    }
    if(Array.isArray(v.ajustes)){
      for(const a of v.ajustes){
        if(a && typeof a.ym === 'string'){
          const y = parseInt(a.ym.split('-')[0],10); if(!isNaN(y)) anos.add(y);
        }
      }
    } else if(v.ajustes && typeof v.ajustes === 'object'){
      // Backward-compat: ainda não migrado
      for(const k of Object.keys(v.ajustes)){
        const y = parseInt(k.split('-')[0],10); if(!isNaN(y)) anos.add(y);
      }
    }
  }
  const anosSorted = Array.from(anos).sort();
  if(selDe){
    selDe.innerHTML = MESES_LBL.map((m,i) =>
      `<option value="${i}"${i===vendFiltroMesDe?' selected':''}>${m}</option>`).join('');
  }
  if(selAte){
    selAte.innerHTML = MESES_LBL.map((m,i) =>
      `<option value="${i}"${i===vendFiltroMesAte?' selected':''}>${m}</option>`).join('');
  }
  if(selAnoDe){
    selAnoDe.innerHTML = anosSorted.map(y =>
      `<option value="${y}"${y===vendFiltroAnoDe?' selected':''}>${y}</option>`).join('');
  }
  if(selAnoAte){
    selAnoAte.innerHTML = anosSorted.map(y =>
      `<option value="${y}"${y===vendFiltroAnoAte?' selected':''}>${y}</option>`).join('');
  }
  const sameYear     = vendFiltroAnoDe === vendFiltroAnoAte;
  const isAnoInteiro = sameYear && vendFiltroMesDe === 0 && vendFiltroMesAte === 11;
  const isSingleMes  = sameYear && vendFiltroMesDe === vendFiltroMesAte;
  const yyDe  = String(vendFiltroAnoDe).slice(2);
  const yyAte = String(vendFiltroAnoAte).slice(2);
  const periodoLbl = isAnoInteiro
    ? String(vendFiltroAnoDe)
    : (isSingleMes
        ? (MESES_LBL[vendFiltroMesDe] + '/' + yyDe)
        : (sameYear
            ? (MESES_LBL[vendFiltroMesDe] + '–' + MESES_LBL[vendFiltroMesAte] + '/' + yyDe)
            : (MESES_LBL[vendFiltroMesDe] + '/' + yyDe + '–' + MESES_LBL[vendFiltroMesAte] + '/' + yyAte)));
  // Label para atraso/previsão — referente ao período do filtro
  const atrasoLblPeriodo = isSingleMes
    ? ('ano ' + vendFiltroAnoDe)
    : (isAnoInteiro
        ? ('ano ' + vendFiltroAnoDe)
        : ('período ' + periodoLbl));
  thead.innerHTML = `<tr>
    <th style="min-width:170px;text-align:left">Vendedor</th>
    <th style="min-width:70px">Ativo</th>
    <th style="min-width:180px">Regra ${isSingleMes ? esc(periodoLbl) : 'atual'}</th>
    <th style="min-width:120px;text-align:right">Venda ${esc(periodoLbl)}</th>
    <th style="min-width:120px;text-align:right">Comissão gerada</th>
    <th style="min-width:120px;text-align:right">Comissão paga</th>
    <th style="min-width:120px;text-align:right" title="Comissão gerada em meses passados ainda não paga — referente a ${esc(atrasoLblPeriodo)}">
      Em atraso
      <div style="font-size:.55rem;color:#94A3B8;font-weight:500;text-transform:none;letter-spacing:normal;margin-top:2px">${esc(atrasoLblPeriodo)}</div>
    </th>
    <th style="min-width:120px;text-align:right" title="Comissão a pagar a partir do mês corrente ainda não paga — referente a ${esc(atrasoLblPeriodo)}">
      Previsão
      <div style="font-size:.55rem;color:#94A3B8;font-weight:500;text-transform:none;letter-spacing:normal;margin-top:2px">${esc(atrasoLblPeriodo)}</div>
    </th>
    <th style="width:60px"></th>
  </tr>`;
  const list = (vendedores && vendedores.lista) || [];
  if(list.length === 0){
    tbody.innerHTML = `<tr class="empty-row"><td colspan="9" style="text-align:center;padding:28px;color:var(--txl)">
      Nenhum vendedor cadastrado. Clique em <b>Novo vendedor</b> para começar.
    </td></tr>`;
    if(tfoot) tfoot.innerHTML = '';
    _renderVendKpisEmpty();
    return;
  }
  // Índices absolutos (ano*12+mes) pra iterar através de fronteiras de ano
  const idxDe  = _vendAbsIdx(vendFiltroAnoDe,  vendFiltroMesDe);
  const idxAte = _vendAbsIdx(vendFiltroAnoAte, vendFiltroMesAte);
  const nowDt  = new Date();
  const idxNow = _vendAbsIdx(nowDt.getFullYear(), nowDt.getMonth());
  // Cutoff de atraso/previsão: se é mês único usa o próprio mês; senão usa "hoje"
  const cutoffIdx = isSingleMes ? _vendAbsIdx(vendFiltroAnoDe, vendFiltroMesDe) : idxNow;
  // Pra isAnoInteiro mantemos o comportamento antigo (iterar o ano todo para atraso/previsão)
  // Nos demais casos (range multi-mês ou multi-ano), atraso/previsão usa o range selecionado
  let totalVendaMes = 0, totalGeradaMes = 0, totalPagaMes = 0, totalAtraso = 0, totalPrevisao = 0;
  const allVends = []; // lista pra ranking top 3
  let nAtivos = 0;
  tbody.innerHTML = list.map(v => {
    // Mês de referência pra regra: mês único = o mês filtrado; range = mês corrente
    const regraYear = isSingleMes ? String(vendFiltroAnoDe) : String(nowDt.getFullYear());
    const regraMes  = isSingleMes ? vendFiltroMesDe : nowDt.getMonth();
    const regrasAtivas = vendedorRegrasDoMes(v, regraYear, regraMes);
    let vendaMes = 0, comMes = 0, pagaMes = 0;
    for(let idx = idxDe; idx <= idxAte; idx++){
      const y = String(Math.floor(idx/12));
      const m = idx % 12;
      vendaMes += vendedorVendaMes(v, y, m) || 0;
      comMes   += comissaoVendedorMes(v, y, m) || 0;
      pagaMes  += vendedorComissaoPagaMes(v, y, m) || 0;
    }
    // Atraso/previsão — soma por índice absoluto
    let atrasoVend = 0, previsaoVend = 0;
    // Se é ano inteiro (single year), iterar o ano todo (comportamento original);
    // caso contrário, iterar o range selecionado
    const atIdxDe  = isAnoInteiro ? _vendAbsIdx(vendFiltroAnoDe, 0)  : idxDe;
