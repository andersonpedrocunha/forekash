let _recCalState = { y: null, m: null, filter: 'all' };

function _recCalInit(){
  if(_recCalState.y == null || _recCalState.m == null){
    const t = new Date();
    _recCalState.y = t.getFullYear();
    _recCalState.m = t.getMonth();
  }
}

function _recCalEvents(){
  if(typeof receita === 'undefined' || !receita || !receita.years) return [];
  const meses_lower = (typeof REC_MESES !== 'undefined') ? REC_MESES : ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  const out = [];
  for(const yKey of Object.keys(receita.years)){
    const yNum = parseInt(yKey, 10);
    if(!isFinite(yNum)) continue;
    const d = receita.years[yKey] || {};
    for(const r of (d.clients || [])){
      const c = (receita.clientes || []).find(x => x.id === r.clienteId);
      const nome = c ? (c.nome || '(sem nome)') : '(cliente removido)';
      const color = c ? (c.color || '#94A3B8') : '#94A3B8';
      const meses = r.meses || {};
      for(const mAbbr of meses_lower){
        const cell = meses[mAbbr];
        if(!cell || cell.valor === '' || cell.valor == null) continue;
        const v = parseFloat(cell.valor); if(!isFinite(v) || v === 0) continue;
        const m = meses_lower.indexOf(mAbbr);
        const lastDay = new Date(yNum, m+1, 0).getDate();
        const dueDefault = yNum + '-' + String(m+1).padStart(2,'0') + '-' + String(lastDay).padStart(2,'0');
        const venc = cell.dataVencimento || dueDefault;
        out.push({
          year: yNum, mesAbbr: mAbbr, m: m,
          rowId: r.id, clienteId: r.clienteId,
          nome: nome, color: color,
          desc: r.descricao || r.tipo || '',
          valor: v,
          status: cell.status === 'recebido' ? 'recebido' : 'aberto',
          dataVencimento: venc,
          dataRecebimento: cell.dataRecebimento || ''
        });
      }
    }
  }
  return out;
}

function _recCalEventStatus(ev){
  if(ev.status === 'recebido') return 'recebido';
  const today = new Date();
  const t = new Date(today.getFullYear(), today.getMonth(), today.getDate());
  if(ev.dataVencimento){
    const d = new Date(ev.dataVencimento + 'T00:00:00');
    if(!isNaN(d.getTime()) && d < t) return 'atraso';
  }
  return 'pendente';
}

function renderRecCalendar(){
  _recCalInit();
  const grid = document.getElementById('rec-cal-grid');
  const lbl  = document.getElementById('rec-cal-lbl');
  const sumEl = document.getElementById('rec-cal-summary');
  if(!grid) return;
  const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  if(lbl) lbl.textContent = meses[_recCalState.m] + ' de ' + _recCalState.y;
  document.querySelectorAll('.rec-cal-filter button[data-f]').forEach(b => {
    b.classList.toggle('active', b.getAttribute('data-f') === _recCalState.filter);
  });
  const allEvents = _recCalEvents();
  const ymPrefix = _recCalState.y + '-' + String(_recCalState.m+1).padStart(2,'0');
  let monthEvents = allEvents.filter(ev => (ev.dataVencimento || '').startsWith(ymPrefix));
  if(_recCalState.filter !== 'all'){
    monthEvents = monthEvents.filter(ev => _recCalEventStatus(ev) === _recCalState.filter);
  }
  const byDay = {};
  for(const ev of monthEvents){
    const day = parseInt(ev.dataVencimento.slice(8,10), 10);
    if(!byDay[day]) byDay[day] = [];
    byDay[day].push(ev);
  }
  if(sumEl){
    let totVal = 0, nRec = 0, nPend = 0, nAtr = 0;
    for(const ev of monthEvents){
      totVal += ev.valor;
      const st = _recCalEventStatus(ev);
      if(st === 'recebido') nRec++;
      else if(st === 'atraso') nAtr++;
      else nPend++;
    }
    const fmt = (n) => (typeof fmtBRL === 'function' ? fmtBRL(n) : ('R$ ' + n.toFixed(2)));
    sumEl.innerHTML = '<span class="sum-tot">' + fmt(totVal) + '</span>'
      + '<span class="sum-it">' + monthEvents.length + ' itens</span>'
      + (nRec > 0 ? '<span class="sum-pill rec">✅ ' + nRec + '</span>' : '')
      + (nPend > 0 ? '<span class="sum-pill pend">⏰ ' + nPend + '</span>' : '')
      + (nAtr > 0 ? '<span class="sum-pill atr">⚠️ ' + nAtr + '</span>' : '');
  }
  const firstDay = new Date(_recCalState.y, _recCalState.m, 1);
  const startDow = firstDay.getDay();
  const lastDay = new Date(_recCalState.y, _recCalState.m+1, 0).getDate();
  const today = new Date();
  const isCurMonth = (today.getFullYear() === _recCalState.y && today.getMonth() === _recCalState.m);
  const todayDay = isCurMonth ? today.getDate() : 0;
  let html = '<div class="rec-cal-head">'
    + ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'].map(d => '<div>' + d + '</div>').join('')
    + '</div><div class="rec-cal-days">';
  for(let i = 0; i < startDow; i++){
    html += '<div class="rec-cal-day is-pad"></div>';
  }
  for(let d = 1; d <= lastDay; d++){
    const evs = byDay[d] || [];
    const isToday = d === todayDay;
    const dayCls = isToday ? ' is-today' : '';
    const hasEvs = evs.length > 0 ? ' has-events' : '';
    let totDay = 0;
    for(const e of evs) totDay += e.valor;
    let evsHtml = '';
    if(evs.length > 0){
      const stOrder = { atraso: 0, pendente: 1, recebido: 2 };
      evs.sort((a,b) => (stOrder[_recCalEventStatus(a)]||9) - (stOrder[_recCalEventStatus(b)]||9));
      const limit = 3;
      const visible = evs.slice(0, limit);
      for(const ev of visible){
        const st = _recCalEventStatus(ev);
        const fmtV = typeof fmtBRL === 'function' ? fmtBRL(ev.valor) : ('R$ ' + ev.valor.toFixed(2));
        evsHtml += '<button type="button" class="rec-cal-ev rec-cal-ev-' + st + '"'
          + ' onclick="event.stopPropagation();recKbCardOpen(' + ev.year + ',\''+ ev.mesAbbr + '\',' + ev.rowId + ')"'
          + ' title="' + _recKbEsc(ev.nome) + ' · ' + fmtV + (ev.desc ? ' · ' + _recKbEsc(ev.desc) : '') + '">'
          + '<span class="dot" style="background:' + ev.color + '"></span>'
          + '<span class="nm">' + _recKbEsc(ev.nome) + '</span>'
          + '<span class="vl">' + fmtV + '</span>'
          + '</button>';
      }
      if(evs.length > limit){
        const rest = evs.length - limit;
        evsHtml += '<button type="button" class="rec-cal-ev-more" onclick="event.stopPropagation();recCalDayOpen(' + d + ')" title="Ver todos os ' + evs.length + ' do dia">+ ' + rest + ' a mais</button>';
      }
    }
    const totDayHtml = (evs.length > 0)
      ? '<span class="rec-cal-day-tot" title="' + (typeof fmtBRL === 'function' ? fmtBRL(totDay) : totDay) + ' · ' + evs.length + ' item(s)">' + (typeof fmtBRL === 'function' ? fmtBRL(totDay) : totDay) + '</span>'
      : '';
    html += '<div class="rec-cal-day' + dayCls + hasEvs + '" data-day="' + d + '" onclick="recCalDayOpen(' + d + ')">'
      + '<div class="rec-cal-day-hd"><span class="rec-cal-day-num">' + d + '</span>' + totDayHtml + '</div>'
      + '<div class="rec-cal-day-bd">' + evsHtml + '</div>'
      + '</div>';
  }
  const totalCells = startDow + lastDay;
  const trailing = (7 - (totalCells % 7)) % 7;
  for(let i = 0; i < trailing; i++){
    html += '<div class="rec-cal-day is-pad"></div>';
  }
  html += '</div>';
  grid.innerHTML = html;
}
try { window.renderRecCalendar = renderRecCalendar; } catch(e){}

function recCalNav(delta){
  _recCalInit();
  let m = _recCalState.m + delta, y = _recCalState.y;
  while(m < 0){ m += 12; y -= 1; }
  while(m > 11){ m -= 12; y += 1; }
  _recCalState.m = m; _recCalState.y = y;
  renderRecCalendar();
}
