const DKB_COLS = [
  { id:'vencer',   label:'A Vencer',          icon:'📅' },
  { id:'mes',      label:'Vence Este Mês',    icon:'⚡' },
  { id:'semana',   label:'Vence Esta Semana', icon:'⏰' },
  { id:'atraso',   label:'Em Atraso',         icon:'⚠️' },
  { id:'recebido', label:'Pago',              icon:'✅' }  // reusa data-st="recebido" pra compartilhar CSS
];

const DKB_ADAPTERS = {
  'est-fixa': {
    targetSelector: '#est-tab-fixa',
    boardId: 'dkb-est-fixa-board',
    toolbarId: 'dkb-est-fixa-toolbar',
    items: () => (typeof estrutura !== 'undefined' && estrutura) ? (estrutura.itens || []) : [],
    nameOf: (it) => it.nome || '(sem nome)',
    descOf: (it) => {
      try {
        if(typeof estrutura !== 'undefined' && estrutura && Array.isArray(estrutura.tipos)){
          const t = estrutura.tipos.find(x => x.id === it.tipoId);
          if(t) return t.nome || '';
        }
      } catch(e){}
      return '';
    },
    colorOf: () => '#94A3B8',
    valoresOf: (it) => it.valores || {},
    pagoOf: (it, ym) => !!(it.pagos && it.pagos[ym]),
    setPago: (it, ym, isPago) => {
      if(!it.pagos) it.pagos = {};
      if(isPago) it.pagos[ym] = true; else delete it.pagos[ym];
    },
    save: () => { if(typeof estSave === 'function') try { estSave(); } catch(_){} },
    onSheetReturn: () => { if(typeof renderEstrutura === 'function') try { renderEstrutura(); } catch(_){} }
  },
  'pes': {
    targetSelector: '#mod-colaboradores',
    boardId: 'dkb-pes-board',
    toolbarId: 'dkb-pes-toolbar',
    items: () => {
      if(typeof pessoas === 'undefined' || !pessoas || !Array.isArray(pessoas.people)) return [];
      return pessoas.people.filter(p => !p.sim);
    },
    // Cada linha em pessoas.people aponta pra um registry — usa direto como fornecedor padrão
    autoFornecedorId: (it) => it.pessoaId || null,
    nameOf: (it) => it.nome || '(sem nome)',
    descOf: (it) => {
      try {
        if(typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.tipos)){
          const t = pessoas.tipos.find(x => x.id === it.tipoId);
          if(t) return t.nome || '';
        }
      } catch(e){}
      return '';
    },
    colorOf: () => '#A7F3D0',
    valoresOf: (it) => it.salarios || {},
    pagoOf: (it, ym) => !!(it.pagos && it.pagos[ym]),
    setPago: (it, ym, isPago) => {
      if(!it.pagos) it.pagos = {};
      if(isPago) it.pagos[ym] = true; else delete it.pagos[ym];
    },
    save: () => { if(typeof pessoasSave === 'function') try { pessoasSave(); } catch(_){} },
    onSheetReturn: () => { if(typeof renderPessoas === 'function') try { renderPessoas(); } catch(_){} }
  },
  'imp-cor': {
    targetSelector: '#imp-tab-correntes',
    boardId: 'dkb-imp-cor-board',
    toolbarId: 'dkb-imp-cor-toolbar',
    items: () => (typeof impostos !== 'undefined' && impostos) ? (impostos.correntes || []) : [],
    idOf: (it) => it.rubricaId || it.id,
    nameOf: (it) => {
      try {
        if(typeof impostos !== 'undefined' && impostos && Array.isArray(impostos.rubricas)){
          const r = impostos.rubricas.find(x => x.id === it.rubricaId);
          if(r) return r.nome || it.rubricaId;
        }
      } catch(e){}
      return it.nome || it.rubricaId || '(sem nome)';
    },
    descOf: () => 'Imposto',
    colorOf: () => '#FBCFE8',
    valoresOf: (it) => it.valores || {},
    pagoOf: (it, ym) => !!(it.pagos && it.pagos[ym]),
    setPago: (it, ym, isPago) => {
      if(!it.pagos) it.pagos = {};
      if(isPago) it.pagos[ym] = true; else delete it.pagos[ym];
    },
    save: () => { if(typeof impSave === 'function') try { impSave(); } catch(_){} },
    onSheetReturn: () => { if(typeof renderImpostos === 'function') try { renderImpostos(); } catch(_){} }
  },
  'imp-par': {
    targetSelector: '#imp-tab-parcel',
    boardId: 'dkb-imp-par-board',
    toolbarId: 'dkb-imp-par-toolbar',
    items: () => (typeof impostos !== 'undefined' && impostos) ? (impostos.parcelamentos || []) : [],
    nameOf: (it) => it.nome || '(sem nome)',
    descOf: (it) => 'Parcelamento · ' + (it.parcelaMensal ? ('R$ ' + (parseFloat(it.parcelaMensal)||0).toFixed(2)) : ''),
    colorOf: () => '#FED7AA',
    valoresOf: (it) => {
      // Gera schedule de parcelas: parcelaMensal × N parcelas a partir de mesInicio
      const out = {};
      const parcela = parseFloat(it.parcelaMensal) || 0;
      const saldoIni = parseFloat(it.saldoInicial) || 0;
      if(parcela <= 0 || !it.mesInicio) return out;
      const totalParcelas = saldoIni > 0 ? Math.ceil(saldoIni / parcela) : 60;
      const parts = String(it.mesInicio).split('-');
      let yI = parseInt(parts[0],10), mI = parseInt(parts[1],10) - 1;
      if(!isFinite(yI) || !isFinite(mI)) return out;
      for(let i = 0; i < totalParcelas; i++){
        let mm = mI + i, yy = yI;
        while(mm > 11){ mm -= 12; yy++; }
        const ym = yy + '-' + String(mm+1).padStart(2,'0');
        out[ym] = parcela;
      }
      return out;
    },
    pagoOf: (it, ym) => !!(it.pagamentos && parseFloat(it.pagamentos[ym]) > 0),
    setPago: (it, ym, isPago) => {
      if(!it.pagamentos) it.pagamentos = {};
      if(isPago){ it.pagamentos[ym] = parseFloat(it.parcelaMensal) || 0; }
      else { delete it.pagamentos[ym]; }
    },
    save: () => { if(typeof impSave === 'function') try { impSave(); } catch(_){} },
    onSheetReturn: () => { if(typeof renderImpostos === 'function') try { renderImpostos(); } catch(_){} }
  }
};

// Meta (vencimento/pagamento/doc/banco/notas/emissao) — vive em it.meta[ym]
function _dkbMeta(it, ym){
  if(!it.meta) it.meta = {};
  if(!it.meta[ym]) it.meta[ym] = {};
  return it.meta[ym];
}

// State por contexto
const _dkbState = {};
function _dkbInitState(ctxId){
  if(_dkbState[ctxId]) return _dkbState[ctxId];
  const t = new Date();
  const cy = t.getFullYear(), cm = t.getMonth();
  return _dkbState[ctxId] = {
    from: { y: cy, m: cm },
    to:   { y: cy, m: cm },
    search: '',
    quick: 'mes'
  };
}

function _dkbEsc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function _dkbFmtBRL(n){ return (typeof fmtBRL === 'function') ? fmtBRL(n||0) : ('R$ ' + (n||0).toFixed(2).replace('.',',')); }
function _dkbFmtMes(y, m){
  const meses = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  return (meses[m] || '?') + '/' + String(y).slice(2);
}
function _dkbCmpYM(a, b){ if(a.y !== b.y) return a.y - b.y; return a.m - b.m; }

function dkbSetView(ctxId, view){
  const ad = DKB_ADAPTERS[ctxId];
  if(!ad) return;
  const target = document.querySelector(ad.targetSelector);
  if(!target) return;
  const isKanban = (view === 'kanban');
  target.classList.toggle('dkb-mode-kanban', isKanban);
  const kbWrap = target.querySelector('.dkb-view-kanban[data-ctx="' + ctxId + '"]');
  if(kbWrap) kbWrap.style.display = isKanban ? '' : 'none';
  target.querySelectorAll('.dkb-view-toggle button').forEach(b => {
    b.classList.toggle('is-active', b.getAttribute('data-view') === view);
  });
  if(isKanban){
    dkbRender(ctxId);
  } else if(ad.onSheetReturn){
    try { ad.onSheetReturn(); } catch(_){}
  }
}
try { window.dkbSetView = dkbSetView; } catch(e){}

function _dkbCells(ctxId){
  const ad = DKB_ADAPTERS[ctxId];
  if(!ad) return [];
  const out = [];
  const items = ad.items() || [];
  const state = _dkbInitState(ctxId);
  const fromYM = state.from.y * 12 + state.from.m;
  const toYM   = state.to.y   * 12 + state.to.m;
  const q = (state.search || '').toLowerCase().trim();
  for(const it of items){
    const valores = ad.valoresOf(it) || {};
    const nome = ad.nameOf(it);
    const desc = ad.descOf ? ad.descOf(it) : '';
    const color = ad.colorOf ? ad.colorOf(it) : '#94A3B8';
    for(const ym of Object.keys(valores)){
      const v = parseFloat(valores[ym]);
      if(!isFinite(v) || v === 0) continue;
      const parts = String(ym).split('-');
      const y = parseInt(parts[0],10), m = parseInt(parts[1],10) - 1;
      if(!isFinite(y) || !isFinite(m)) continue;
      const ymNum = y * 12 + m;
      if(ymNum < fromYM || ymNum > toYM) continue;
      if(q){
        const pool = (nome + ' ' + desc).toLowerCase();
        if(!pool.includes(q)) continue;
      }
      const isPago = ad.pagoOf(it, ym);
      const meta = _dkbMeta(it, ym);
      // Fornecedor: meta sobrescreve auto; auto vem do adapter (ex: pes usa pessoaId)
      const autoForn = (ad.autoFornecedorId && !meta.fornecedorId) ? ad.autoFornecedorId(it) : null;
      out.push({
        ctxId, itemId: it.id, ym, y, m,
        nome, desc, color,
        valor: v,
        status: isPago ? 'recebido' : 'aberto',
        dataVencimento: meta.dataVencimento || '',
        dataPagamento: meta.dataPagamento || '',
        dataEmissao: meta.dataEmissao || '',
        banco: meta.banco || '',
        numeroDocumento: meta.numeroDocumento || '',
        fornecedorId: meta.fornecedorId || autoForn || null,
        notas: meta.notas || ''
      });
    }
  }
  return out;
}

function _dkbClassify(card){
  if(card.status === 'recebido') return 'recebido';
  const today = new Date();
  const t = new Date(today.getFullYear(), today.getMonth(), today.getDate());
  const semanaFim = new Date(t); semanaFim.setDate(t.getDate() + 7);
  if(card.dataVencimento){
    const d = new Date(card.dataVencimento + 'T00:00:00');
    if(!isNaN(d.getTime())){
      if(d < t) return 'atraso';
      if(d < semanaFim) return 'semana';
      if(d.getFullYear() === t.getFullYear() && d.getMonth() === t.getMonth()) return 'mes';
      return 'vencer';
    }
  }
  // Fallback: mês/ano de referência
  const cy = t.getFullYear(), cm = t.getMonth();
  if(card.y < cy) return 'atraso';
  if(card.y > cy) return 'vencer';
  if(card.m < cm) return 'atraso';
  if(card.m > cm) return 'vencer';
  return 'mes';
}

function _dkbRenderToolbar(ctxId){
  const ad = DKB_ADAPTERS[ctxId];
  const tb = document.getElementById(ad.toolbarId);
  if(!tb) return;
  const s = _dkbInitState(ctxId);
  const ys = (function(){
    const set = new Set();
    const items = ad.items() || [];
    for(const it of items){
      const v = ad.valoresOf(it) || {};
      for(const ym of Object.keys(v)){
        const y = parseInt(String(ym).split('-')[0],10);
        if(isFinite(y)) set.add(y);
      }
    }
    if(set.size === 0){ const cy = new Date().getFullYear(); set.add(cy-1); set.add(cy); set.add(cy+1); }
    return [...set].sort((a,b) => a-b);
  })();
  const minY = ys[0], maxY = ys[ys.length-1];
  const yearOpts = (sel) => {
    let str = '';
    const lo = Math.min(minY, sel) - 1;
    const hi = Math.max(maxY, sel) + 1;
    for(let y = lo; y <= hi; y++){
      str += '<option value="' + y + '"' + (y === sel ? ' selected' : '') + '>' + y + '</option>';
    }
    return str;
  };
  const mesNomes = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  const mesOpts = (sel) => mesNomes.map((n,i) => '<option value="' + i + '"' + (i === sel ? ' selected' : '') + '>' + n + '</option>').join('');
  const isQ = (q) => s.quick === q ? ' is-active' : '';
  tb.innerHTML =
      '<label>De</label>'
    + '<select onchange="dkbSetFilter(\''+ ctxId + '\',\'fromMes\',this.value)">' + mesOpts(s.from.m) + '</select>'
    + '<select onchange="dkbSetFilter(\''+ ctxId + '\',\'fromAno\',this.value)">' + yearOpts(s.from.y) + '</select>'
    + '<span class="sep">→</span>'
    + '<label>Até</label>'
    + '<select onchange="dkbSetFilter(\''+ ctxId + '\',\'toMes\',this.value)">' + mesOpts(s.to.m) + '</select>'
    + '<select onchange="dkbSetFilter(\''+ ctxId + '\',\'toAno\',this.value)">' + yearOpts(s.to.y) + '</select>'
    + '<span class="sep">·</span>'
    + '<button class="quick' + isQ('mes')  + '" onclick="dkbQuick(\''+ ctxId + '\',\'mes\')"  type="button">Mês atual</button>'
    + '<button class="quick' + isQ('3m')   + '" onclick="dkbQuick(\''+ ctxId + '\',\'3m\')"   type="button">Próx. 3m</button>'
    + '<button class="quick' + isQ('ano')  + '" onclick="dkbQuick(\''+ ctxId + '\',\'ano\')"  type="button">Ano</button>'
    + '<button class="quick' + isQ('tudo') + '" onclick="dkbQuick(\''+ ctxId + '\',\'tudo\')" type="button">Tudo</button>'
    + '<span class="sep">·</span>'
    + '<input type="text" placeholder="🔍 Buscar..." value="' + _dkbEsc(s.search || '') + '" oninput="dkbSetFilter(\''+ ctxId + '\',\'search\',this.value)">';
}

function dkbRender(ctxId){
  const ad = DKB_ADAPTERS[ctxId];
  if(!ad) return;
  _dkbRenderToolbar(ctxId);
  const board = document.getElementById(ad.boardId);
  if(!board) return;
  const cards = _dkbCells(ctxId);
  const buckets = {};
  for(const col of DKB_COLS) buckets[col.id] = [];
  for(const c of cards){
    const cls = _dkbClassify(c);
    if(buckets[cls]) buckets[cls].push(c);
  }
  for(const id of Object.keys(buckets)){
    buckets[id].sort((a,b) => {
      if(id === 'recebido'){ if(a.y !== b.y) return b.y - a.y; return b.m - a.m; }
      if(a.y !== b.y) return a.y - b.y; return a.m - b.m;
    });
  }
  let html = '';
  for(const col of DKB_COLS){
    const list = buckets[col.id];
    const total = list.reduce((s,c) => s + c.valor, 0);
    html += '<div class="rec-kb-col" data-st="' + col.id + '"'
      + ' ondragover="_dkbDragOver(event)"'
      + ' ondragleave="_dkbDragLeave(event)"'
      + ' ondrop="_dkbDrop(event,\''+ ctxId + '\',\''+ col.id + '\')">'
      + '<div class="rec-kb-col-hd">'
      +   '<span class="name">' + col.icon + ' ' + _dkbEsc(col.label) + '</span>'
      +   '<span class="count">' + list.length + ' · ' + _dkbFmtBRL(total) + '</span>'
      + '</div>'
      + '<div class="rec-kb-col-bd">';
    if(list.length === 0){
      html += '<div class="rec-kb-empty">Vazio</div>';
    } else {
      for(const c of list){
        const ym = _dkbFmtMes(c.y, c.m);
        const fmtVal = _dkbFmtBRL(c.valor);
        const docPill  = c.numeroDocumento ? '<span class="pill doc" title="Nº: ' + _dkbEsc(c.numeroDocumento) + '">🧾 ' + _dkbEsc(c.numeroDocumento) + '</span>' : '';
        const vencPill = c.dataVencimento ? '<span class="pill" title="Vencimento: ' + c.dataVencimento + '">📆 ' + c.dataVencimento.slice(8,10) + '/' + c.dataVencimento.slice(5,7) + '</span>' : '';
        const notasPill = (c.notas && c.notas.trim()) ? '<span class="pill notas" title="' + _dkbEsc(c.notas.slice(0,140)) + '">📝</span>' : '';
        const bancoPill = c.banco ? _kbBancoPillHtml(c.banco) : '';
        let fornPill = '';
        if(c.fornecedorId){
          const fr = _dkbFornById(c.fornecedorId);
          if(fr){
            const tipo = fr.tipoPessoa || (fr.cnpj ? 'pj' : (fr.cpf ? 'pf' : (fr.documento ? 'est' : '')));
            const ico = tipo === 'pf' ? '👤' : tipo === 'est' ? '🌎' : '🏢';
            let titleDoc = '';
            if(tipo === 'pj' && fr.cnpj) titleDoc = ' · CNPJ ' + _dkbFmtCNPJ(fr.cnpj);
            else if(tipo === 'pf' && fr.cpf) titleDoc = ' · CPF ' + _dkbFmtCPF(fr.cpf);
            else if(tipo === 'est' && fr.documento) titleDoc = ' · ' + fr.documento;
            // Avatar com foto se houver, senão ícone do tipo
            let avaHtml;
            if(fr.foto){
              avaHtml = '<span class="kb-pill-ava"><img src="' + fr.foto + '" alt="" onerror="this.parentNode.style.display=\'none\'"></span>';
            } else {
              avaHtml = '<span style="font-size:.85rem;line-height:1">' + ico + '</span>';
            }
            fornPill = '<span class="pill" title="Fornecedor' + titleDoc + '">' + avaHtml + ' ' + _dkbEsc(fr.nome || '') + '</span>';
          }
        }
        html += '<div class="rec-kb-card" data-st="' + col.id + '" draggable="true"'
          + ' onclick="dkbCardOpen(\''+ ctxId + '\','+ JSON.stringify(c.itemId) + ',\''+ c.ym + '\')"'
          + ' ondragstart="_dkbCardDragStart(event,\''+ ctxId + '\','+ JSON.stringify(c.itemId) + ',\''+ c.ym + '\')"'
          + ' ondragend="_dkbCardDragEnd(event)">'
          + '<div class="rec-kb-card-name"><span class="dot" style="background:' + c.color + '"></span>' + _dkbEsc(c.nome) + '</div>'
          + (c.desc ? '<div class="rec-kb-card-desc">' + _dkbEsc(c.desc) + '</div>' : '')
          + '<div class="rec-kb-card-meta"><span class="pill">📅 ' + ym + '</span>' + vencPill + fornPill + bancoPill + docPill + notasPill + '</div>'
          + '<div class="rec-kb-card-val">' + fmtVal + '</div>'
          + '</div>';
      }
    }
    html += '</div></div>';
  }
  board.innerHTML = html;
}
try { window.dkbRender = dkbRender; } catch(e){}

function dkbSetFilter(ctxId, field, value){
  const s = _dkbInitState(ctxId);
  s.quick = null;
  if(field === 'fromMes'){ s.from.m = parseInt(value,10) || 0; }
  else if(field === 'fromAno'){ s.from.y = parseInt(value,10) || new Date().getFullYear(); }
  else if(field === 'toMes'){ s.to.m = parseInt(value,10) || 0; }
  else if(field === 'toAno'){ s.to.y = parseInt(value,10) || new Date().getFullYear(); }
  else if(field === 'search'){ s.search = value || ''; }
  dkbRender(ctxId);
}
function dkbQuick(ctxId, preset){
  const s = _dkbInitState(ctxId);
  const t = new Date();
  const cy = t.getFullYear(), cm = t.getMonth();
  if(preset === 'mes'){ s.from = {y:cy,m:cm}; s.to = {y:cy,m:cm}; }
  else if(preset === '3m'){ s.from = {y:cy,m:cm}; let endY = cy, endM = cm + 2; while(endM > 11){ endM -= 12; endY++; } s.to = {y:endY,m:endM}; }
  else if(preset === 'ano'){ s.from = {y:cy,m:0}; s.to = {y:cy,m:11}; }
  else if(preset === 'tudo'){
    const ad = DKB_ADAPTERS[ctxId];
    let minY = cy, maxY = cy;
    const items = ad.items() || [];
    for(const it of items){
      const v = ad.valoresOf(it) || {};
      for(const ym of Object.keys(v)){
        const y = parseInt(String(ym).split('-')[0],10);
        if(isFinite(y)){
          if(y < minY) minY = y;
          if(y > maxY) maxY = y;
        }
      }
    }
    s.from = {y:minY,m:0}; s.to = {y:maxY,m:11};
  }
  s.quick = preset;
  dkbRender(ctxId);
}
try { window.dkbSetFilter = dkbSetFilter; window.dkbQuick = dkbQuick; } catch(e){}

// Drag & drop
let _dkbDrag = null;
function _dkbCardDragStart(e, ctxId, itemId, ym){
  _dkbDrag = { ctxId, itemId, ym };
  if(e.dataTransfer){ e.dataTransfer.effectAllowed = 'move'; }
  if(e.currentTarget) e.currentTarget.classList.add('is-dragging');
}
function _dkbCardDragEnd(e){
  _dkbDrag = null;
  document.querySelectorAll('.rec-kb-card.is-dragging').forEach(el => el.classList.remove('is-dragging'));
  document.querySelectorAll('.rec-kb-col.is-drop').forEach(el => el.classList.remove('is-drop'));
}
function _dkbDragOver(e){
  if(!_dkbDrag) return;
  e.preventDefault();
  if(e.dataTransfer) e.dataTransfer.dropEffect = 'move';
  e.currentTarget.classList.add('is-drop');
}
function _dkbDragLeave(e){ e.currentTarget.classList.remove('is-drop'); }
function _dkbDrop(e, ctxId, colId){
  e.preventDefault();
  e.currentTarget.classList.remove('is-drop');
  const drag = _dkbDrag;
  _dkbDrag = null;
  if(!drag || drag.ctxId !== ctxId) return;
  const ad = DKB_ADAPTERS[ctxId];
  const it = (ad.items() || []).find(x => x.id === drag.itemId);
  if(!it) return;
  const wasPago = ad.pagoOf(it, drag.ym);
  const wantsPago = (colId === 'recebido');
  if(wasPago === wantsPago){ dkbRender(ctxId); return; }
  if(wantsPago){
    // Pergunta a data via modal
    dkbCardOpen(ctxId, drag.itemId, drag.ym, { dragToPago: true });
    return;
  }
  // Voltando pra aberto: limpa pago e dataPagamento
  ad.setPago(it, drag.ym, false);
  const meta = _dkbMeta(it, drag.ym);
  if(meta.dataPagamento) delete meta.dataPagamento;
  if(ad.save) ad.save();
  dkbRender(ctxId);
  if(typeof toast === 'function') toast('Voltou pra Em Aberto');
}
try {
  window._dkbCardDragStart = _dkbCardDragStart;
  window._dkbCardDragEnd   = _dkbCardDragEnd;
  window._dkbDragOver      = _dkbDragOver;
  window._dkbDragLeave     = _dkbDragLeave;
  window._dkbDrop          = _dkbDrop;
} catch(e){}

