    }).join('');
    ov.innerHTML = `<div class="confirm-modal" role="dialog" style="max-width:440px">
      <h3 class="confirm-title" style="margin-top:0">Empate na alocação</h3>
      <p class="confirm-msg">
        ${esc(nome)} tem 2 ou mais tipos com o mesmo percentual máximo.
        Qual você quer que apareça como o grupo <b>principal</b> na tabela?
      </p>
      <div class="pes-aloc-tie-opts">${rows}</div>
      <div class="confirm-actions" style="margin-top:14px">
        <button class="confirm-btn confirm-cancel">Cancelar</button>
        <button class="confirm-btn confirm-ok">Confirmar</button>
      </div>
    </div>`;
    document.body.appendChild(ov);
    ov.querySelector('.confirm-cancel').onclick = () => { ov.remove(); resolve(null); };
    ov.querySelector('.confirm-ok').onclick = () => {
      const sel = ov.querySelector('input[name=tie]:checked');
      const v = sel ? sel.value : null;
      ov.remove();
      resolve(v);
    };
  });
}

async function setPesSalario(id, key, val){
  const p = pessoas.people.find(x=>x.id===id);
  if(!p) return;
  // Regra: célula com ✓ (pago) trava edição até o ✓ ser removido
  if(p.pagos && p.pagos[key]){ notifyLocked(); return; }
  const n = parseBR(val);
  const oldRaw = p.salarios[key];
  const newVal = (n === '' || n === 0) ? undefined : n;
  const wasEmpty = (oldRaw === undefined || oldRaw === null || oldRaw === 0);
  const isEmpty  = (newVal === undefined);
  const changed  = wasEmpty ? !isEmpty : (isEmpty || Math.abs(oldRaw - newVal) > 0.0049);

  // Aplica a alteração na célula atual
  let pagoLimpo = false;
  if(isEmpty){
    delete p.salarios[key];
    // Limpa também a marcação de pago quando o valor é apagado
    if(p.pagos && Object.prototype.hasOwnProperty.call(p.pagos, key)){
      delete p.pagos[key];
      pagoLimpo = true;
    }
  }
  else p.salarios[key] = newVal;
  pessoasSave();
  // Se tiramos o ✓ da célula, precisa re-render pra remover a classe visual
  if(pagoLimpo) renderPesSheet();
  updatePesTotals();

  if(!changed) return;

  // Monta lista dos próximos meses (dentro dos anos cadastrados)
  const [yStr, mStr] = key.split('-');
  const yNum = parseInt(yStr, 10);
  const mIdx = parseInt(mStr, 10) - 1;
  const yearsInt = (pessoas.years || []).map(y => parseInt(y, 10)).filter(n => !isNaN(n));
  if(!yearsInt.length) return;
  const maxYear = Math.max(...yearsInt);
  const yearSet = new Set(pessoas.years);
  const futureKeys = [];
  for(let y = yNum; y <= maxYear; y++){
    const yKey = String(y);
    if(!yearSet.has(yKey)) continue;
    const startM = (y === yNum) ? (mIdx + 1) : 0;
    for(let m = startM; m < 12; m++){
      futureKeys.push(pesMesKey(yKey, m));
    }
  }
  if(!futureKeys.length) return;

  const lastLabel = pesKeyToLabel(futureKeys[futureKeys.length - 1]);
  const valLabel  = isEmpty ? '<em>apagar</em>' : ('<strong>' + fmtBRL(newVal) + '</strong>');
  const message   = isEmpty
    ? `Deseja também limpar os próximos ${futureKeys.length} meses dessa pessoa (até ${lastLabel})?`
    : `Aplicar ${valLabel} também nos próximos ${futureKeys.length} meses dessa pessoa (até ${lastLabel})?`;

  const ok = await showConfirm({
    title: 'Replicar para os próximos meses?',
    message,
    confirmLabel: 'Replicar',
    cancelLabel: 'Somente este mês'
  });
  if(!ok) return;

  for(const k of futureKeys){
    // Regra: não sobrescrever células travadas (com ✓ pago)
    if(p.pagos && p.pagos[k]) continue;
    if(isEmpty) delete p.salarios[k];
    else p.salarios[k] = newVal;
  }
  pessoasSave();
  renderPesSheet();
  updatePesTotals();
}

function togglePesPago(id, key){
  const p = pessoas.people.find(x => x.id === id);
  if(!p) return;
  const v = p.salarios[key];
  if(v === undefined || v === null || v === 0) return; // sem valor real → nada a marcar
  if(!p.pagos) p.pagos = {};
