  const cls = (kind === 'resultado') ? 'res' : (kind === 'receita' ? 'rec' : 'cus');
  const deltaCls = diff === 0 ? 'neutro' : (bom ? 'bom' : 'ruim');
  const pctStr = a ? ((pct>=0?'+':'')+fmtBR(pct, 1)+'%') : '—';
  const ico = '<span class="orc-cen-dot" style="background:'+color+'"></span>';
  return '<tr class="'+cls+'"><td>'+ico+esc(label)+'</td>'+
         '<td>'+fmtBRL(a)+'</td>'+
         '<td>'+fmtBRL(b)+'</td>'+
         '<td class="'+deltaCls+'">'+(diff>=0?'+':'')+fmtBRL(diff)+'</td>'+
         '<td class="'+deltaCls+'">'+pctStr+'</td></tr>';
}

