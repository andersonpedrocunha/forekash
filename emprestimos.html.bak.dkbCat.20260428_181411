function openPesNewYearModal(preselectSource){
  const ov = document.getElementById('ov-pes-newyear');
  if(!ov) return;
  // título dinâmico
  const ttl = document.getElementById('pnyr-title');
  if(ttl) ttl.textContent = preselectSource ? `Duplicar ${preselectSource} em novo ano` : 'Novo ano de headcount';

  // sugere ano = último+1
  const lastYear = pessoas.years.length
    ? parseInt(pessoas.years[pessoas.years.length-1])
    : new Date().getFullYear();
  const inp = document.getElementById('pnyr-year');
  if(inp){ inp.value = String(lastYear + 1); }

  // monta choices dinamicamente
  const group = document.getElementById('pnyr-choices');
  if(group){
    // Preserva o radio "em branco"
    const existingYears = pessoas.years.slice().sort();
    const blankHtml = `
      <label class="nyr-choice">
        <input type="radio" name="pnyr-src" value="" ${preselectSource?'':'checked'} onchange="updatePnyrOptions()">
        <div class="nyr-choice-body">
          <div class="nyr-choice-title">📄 Em branco</div>
          <div class="nyr-choice-desc">Apenas cria o ano; sem salários nem reajustes.</div>
        </div>
      </label>
    `;
    const copyChoices = existingYears.map(y => {
      const n = pessoas.people.filter(p => p.ativo && Object.keys(p.salarios||{}).some(k=>k.startsWith(y+'-'))).length;
      const reajN = Object.keys(pessoas.reajustes||{}).filter(k=>k.startsWith(y+'-')).length;
      const isSrc = (preselectSource && preselectSource === y);
      return `
        <label class="nyr-choice">
          <input type="radio" name="pnyr-src" value="${y}" ${isSrc?'checked':''} onchange="updatePnyrOptions()">
          <div class="nyr-choice-body">
            <div class="nyr-choice-title">📋 Copiar de ${y}</div>
            <div class="nyr-choice-desc">${n} pessoa${n===1?'':'s'} com salário · ${reajN} mês${reajN===1?'':'es'} de reajuste</div>
          </div>
        </label>
      `;
    }).join('');
    group.innerHTML = blankHtml + copyChoices;
  }

  updatePnyrOptions();
  ov.classList.add('open');
  setTimeout(()=>{ if(inp) inp.focus(); }, 30);
}

