  const idxNow = now.getFullYear()*12 + now.getMonth();
  const linhas = [];
  for(let idx = idxDe; idx <= idxAte; idx++){
    const y = String(Math.floor(idx/12));
    const m = idx % 12;
    const ger = comissaoVendedorMes(v, y, m) || 0;
    const paga = vendedorComissaoPagaMes(v, y, m) || 0;
    const saldo = Math.max(0, ger - paga);
    let status, statusLbl;
    if(ger <= 0){ status = ''; statusLbl = '—'; }
    else if(paga >= ger){ status = 'paga'; statusLbl = 'Paga'; }
    else if(idx < idxNow){ status = 'atraso'; statusLbl = 'Em atraso'; }
    else { status = 'previsao'; statusLbl = 'Previsão'; }
    linhas.push({
      label: MESES_LBL[m] + '/' + String(y).slice(2),
      ger, paga, saldo, status, statusLbl
    });
  }
  let totGer = 0, totPaga = 0, totSaldo = 0;
  for(const l of linhas){ totGer += l.ger; totPaga += l.paga; totSaldo += l.saldo; }
  return { linhas, totGer, totPaga, totSaldo };
}
