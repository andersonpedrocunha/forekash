function anaSlideSetLayout(slideId, layoutId){
  const s = _anaState.presentation.slides.find(x => x.id === slideId);
  if(!s) return;
  s.layout = layoutId;
  _anaSaveState();
  _anaRenderPresent();
}
function anaSlideSetLayoutAll(){
  const cur = _anaSlideCurrent();
  if(!cur || !_anaState.presentation || !Array.isArray(_anaState.presentation.slides)) return;
  const layoutId = cur.layout || 'cream-exec';
  const total = _anaState.presentation.slides.length;
  if(total <= 1){
    if(typeof toast === 'function') toast('Apenas 1 slide na apresentação.');
    return;
  }
  const lay = SLIDE_LAYOUTS.find(l => l.id === layoutId);
  const layName = lay ? lay.name : layoutId;
  anaConfirm({
    eyebrow: 'Aplicar a todos os slides',
    title: 'Substituir o template de ' + total + ' slides?',
    message: 'O template <strong>' + layName + '</strong> será aplicado a <strong>todos os ' + total + ' slides</strong> da sua apresentação. Os widgets, títulos e narrativas permanecem intactos — só o visual de fundo muda.',
    okText: 'Aplicar a todos',
    cancelText: 'Manter como está'
  }, function(){
    for(const s of _anaState.presentation.slides){ s.layout = layoutId; }
    _anaSaveState();
    _anaRenderPresent();
    if(typeof toast === 'function') toast('Template "' + layName + '" aplicado a ' + total + ' slides');
  });
}
