function dkbFornFetchCNPJ(){
  const inp = document.getElementById('dkb-forn-new-doc');
  const btn = document.getElementById('dkb-forn-fetch-btn');
  const msg = document.getElementById('dkb-forn-fetch-msg');
  if(!inp) return;
  const digits = _dkbCleanCNPJ(inp.value);
  if(digits.length !== 14){
    if(msg){ msg.className = 'dkb-forn-fetch-msg err'; msg.textContent = '⚠ CNPJ deve ter 14 dígitos'; }
    return;
  }
  if(btn){ btn.disabled = true; btn.classList.add('is-loading'); btn.textContent = '⏳ Buscando...'; }
  if(msg){ msg.className = 'dkb-forn-fetch-msg'; msg.textContent = ''; }
  fetch('https://brasilapi.com.br/api/cnpj/v1/' + digits)
    .then(r => {
      if(!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(data => {
      const nome = data.razao_social || data.nome_fantasia || '';
      if(!nome) throw new Error('CNPJ sem razão social');
      const nomeFld = document.getElementById('dkb-forn-new-nome');
      if(nomeFld){ nomeFld.value = nome; nomeFld.focus(); nomeFld.select(); }
      if(msg){
        msg.className = 'dkb-forn-fetch-msg ok';
        const extra = data.nome_fantasia && data.nome_fantasia !== nome ? ' · ' + data.nome_fantasia : '';
        const uf = data.uf ? ' · ' + data.uf : '';
        msg.textContent = '✓ ' + (data.razao_social || nome) + extra + uf;
      }
    })
    .catch(err => {
      if(msg){
        msg.className = 'dkb-forn-fetch-msg err';
        msg.textContent = '✕ Não foi possível buscar (' + (err.message || 'erro') + ')';
      }
    })
    .finally(() => {
      if(btn){ btn.disabled = false; btn.classList.remove('is-loading'); btn.textContent = '🔍 Buscar nome'; }
    });
}
