<script>
// ═══════════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════════
const KEY_NOW  = 'taller_loans_v3';
const KEY_OLD  = ['taller_loans_v1','taller_loans_v2','taller_emprestimos_v1'];
const LOAN_MODALIDADES_KEY = 'taller_loan_modalidades_v1';
const LOAN_MODALIDADES_BUILTIN = [
  { id:'price', nome:'Price', engine:'price', builtin:true },
  { id:'sac',   nome:'SAC',   engine:'sac',   builtin:true }
];
let loans            = [];
let loanModalidades  = LOAN_MODALIDADES_BUILTIN.map(m => ({...m}));
let nextId           = 1;
let chartAtual   = null;
let chartDiv     = null;
let chartDonut   = null;
let filterMode   = 'saldo';   // 'valor' | 'parcela' | 'saldo'
let filterDivida = 'saldo';   // 'saldo' | 'parcela'
let sortOrder    = 'desc';    // 'asc' | 'desc'
let activeContratoId = null;
let filterProgress = 'emprestimo'; // 'emprestimo' | 'banco'

const BANCOS = ['','Banco do Brasil','Bradesco','Caixa Econômica Federal',
  'Itaú','Santander','Nubank','Inter','Sicredi','Banrisul',
  'BTG Pactual','XP Investimentos','C6 Bank','Safra',
  'Daycoval','Banco Votorantim','PicPay','Mercado Pago',
  '— Digitar manualmente —'];

// ═══════════════════════════════════════════════════
//  FORMAT HELPERS
// ═══════════════════════════════════════════════════
const fmtBR  = (v,d=2) => {
  if(v===''||v==null)return '';
  const n=parseFloat(v); return isNaN(n)?'':n.toLocaleString('pt-BR',{minimumFractionDigits:d,maximumFractionDigits:d});
};
// ─── Simple spreadsheet-like formula support ───────
// Aceita expressões começando com "=" (ex: =5+3, =SOMA(1;2;3), =MEDIA(10,20), =MAX(...)/MIN(...), =ABS(...), =ROUND(...)).
// Retorna { ok: bool, value: number|'' }. Usa whitelist estrita por segurança.
// Resolve o valor numérico atual de uma célula pelo seu cellId (data-cellref).
// Segue fórmulas aninhadas com guard anti-ciclo. Retorna 0 quando não encontra / inválido.
function __cellValueByRef(cellId, seen){
  try{
    cellId = (cellId||'').toString().trim();
    if(!cellId) return 0;
    seen = seen || new Set();
    if(seen.has(cellId)) return 0;          // ciclo → 0
    seen.add(cellId);
    const sel = '[data-cellref="'+cellId.replace(/"/g,'\\"')+'"]';
    const el = document.querySelector(sel);
    if(!el) return 0;
    const v = (el.value||'').toString().trim();
    if(!v) return 0;
    if(v.startsWith('=')){
      const r = evalSimpleFormula(v, seen);
      return r.ok ? (r.value||0) : 0;
    }
    const n = parseFloat(v.replace(/\./g,'').replace(',','.'));
    return isNaN(n) ? 0 : n;
  }catch(e){
    return 0;
  }
}
function evalSimpleFormula(raw, __seen){
  try{
    let s = (raw||'').toString().trim();
    if(!s.startsWith('=')) return {ok:false, value:''};
    s = s.slice(1).trim();
    if(!s) return {ok:false, value:''};
    // Passo 0: resolve tokens [ref:cellId] → valor numérico (antes da whitelist)
    if(s.indexOf('[ref:') >= 0){
      const refSeen = __seen instanceof Set ? __seen : new Set();
      s = s.replace(/\[ref:([^\]\[]+)\]/g, function(_, id){
        const n = __cellValueByRef(id, refSeen);
        // Usa parênteses + operador unário explícito pra números negativos
        return (n < 0) ? '(0-'+Math.abs(n)+')' : '('+n+')';
      });
    }
    // Whitelist inicial: dígitos, operadores, parênteses, ponto, vírgula/ponto-e-vírgula, espaço, letras (funções) e _
    if(!/^[0-9+\-*/().,;\s%A-Za-zÀ-ÿ_]+$/.test(s)) return {ok:false, value:''};
    // Passo 1: converte "," que são separadores de argumentos de função em ";"
    // Regra: se o conteúdo top-level da chamada de função contém ";" explícito,
    // o usuário já escolheu ";" como separador → "," são decimais (não mexer).
    // Senão, "," top-level são separadores → convertê-los para ";".
    {
      // Mapeia cada '(' de função para seu ')' e decide o separador
      const n = s.length;
      const convertAt = new Set(); // índices de ',' que devem virar ';'
      const openers = []; // pilha: {open, isFunc, innerDepth, topLevelCommas:[], hasSemi}
      for(let i = 0; i < n; i++){
        const ch = s[i];
        if(ch === '('){
          let j = i - 1;
          while(j >= 0 && /\s/.test(s[j])) j--;
          const isFunc = j >= 0 && /[A-Za-zÀ-ÿ_0-9]/.test(s[j]);
          openers.push({open:i, isFunc, topLevelCommas:[], hasSemi:false});
        } else if(ch === ')'){
          const top = openers.pop();
          if(top && top.isFunc && !top.hasSemi){
            // Usa "," como separador: marca os top-level commas dessa func
            for(const idx of top.topLevelCommas) convertAt.add(idx);
          }
        } else if(ch === ',' || ch === ';'){
          // Reporta para o paren mais próximo (innermost)
          if(openers.length){
            const top = openers[openers.length-1];
            if(ch === ';') top.hasSemi = true;
            else top.topLevelCommas.push(i);
          }
        }
      }
      if(convertAt.size){
        let out = '';
        for(let i = 0; i < n; i++){
          out += convertAt.has(i) ? ';' : s[i];
        }
        s = out;
      }
    }
    // Passo 2: normaliza números em formato BR
    // 1.234,56 -> 1234.56 (remove pontos de milhar quando há vírgula decimal)
    s = s.replace(/(\d)\.(?=\d{3}(\D|$))/g, '$1');
    // 1,5 -> 1.5 (vírgula decimal entre dígitos)
    s = s.replace(/(\d),(\d)/g, '$1.$2');
    // Passo 3: ";" separador de argumentos -> ","
    s = s.replace(/;/g, ',');
    // Walker: encontra a função "mais interna" (cujos args não contêm outra função não-Math.*)
    const findFunc = (str)=>{
      for(let i = 0; i < str.length; i++){
        const ch = str[i];
        if(!/[A-Za-zÀ-ÿ_]/.test(ch)) continue;
        // Tem que estar em fronteira de palavra (char anterior não pode ser letra/dígito/underscore/.)
        if(i > 0 && /[.A-Za-zÀ-ÿ_0-9]/.test(str[i-1])) continue;
        let e = i;
        while(e < str.length && /[A-Za-zÀ-ÿ_0-9]/.test(str[e])) e++;
        let p = e;
        while(p < str.length && /\s/.test(str[p])) p++;
        if(str[p] !== '('){ i = e - 1; continue; }
        // Busca ')' correspondente com balanceamento
        let depth = 1, j = p + 1;
        for(; j < str.length; j++){
          if(str[j] === '(') depth++;
          else if(str[j] === ')'){ depth--; if(depth === 0) break; }
        }
        if(j >= str.length) return null;
        const argsText = str.slice(p + 1, j);
        // Há função aninhada não-Math.*? Pula pra processar ela primeiro.
        let hasInnerFunc = false;
        for(let k = 0; k < argsText.length; k++){
          if(!/[A-Za-zÀ-ÿ_]/.test(argsText[k])) continue;
          if(k > 0 && /[.A-Za-zÀ-ÿ_0-9]/.test(argsText[k-1])) continue;
          let ee = k;
          while(ee < argsText.length && /[A-Za-zÀ-ÿ_0-9]/.test(argsText[ee])) ee++;
          let pp = ee;
          while(pp < argsText.length && /\s/.test(argsText[pp])) pp++;
          if(argsText[pp] === '('){ hasInnerFunc = true; break; }
          k = ee - 1;
        }
        if(hasInnerFunc){ i = e - 1; continue; }
        return {nameStart: i, nameEnd: e, open: p, close: j, name: str.slice(i, e), argsText};
      }
      return null;
    };
    // Divide args respeitando parênteses aninhados
    const splitArgs = (text)=>{
      const out = [];
      let d = 0, start = 0;
      for(let i = 0; i < text.length; i++){
        if(text[i] === '(') d++;
        else if(text[i] === ')') d--;
        else if(text[i] === ',' && d === 0){
          out.push(text.slice(start, i).trim());
          start = i + 1;
        }
      }
      out.push(text.slice(start).trim());
      return out.filter(x => x !== '');
    };
    let guard = 0;
    while(guard++ < 40){
      const hit = findFunc(s);
      if(!hit) break;
      const fn = hit.name.toUpperCase().replace(/É/g,'E');
      const parts = splitArgs(hit.argsText);
      let sub;
      if(!parts.length){ sub = '0'; }
      else if(fn === 'SOMA' || fn === 'SUM') sub = '('+parts.join('+')+')';
      else if(fn === 'MEDIA' || fn === 'AVG' || fn === 'MEAN')
        sub = '(('+parts.join('+')+')/'+parts.length+')';
      else if(fn === 'MAX') sub = 'Math.max('+parts.join(',')+')';
      else if(fn === 'MIN') sub = 'Math.min('+parts.join(',')+')';
      else if(fn === 'ABS') sub = 'Math.abs('+parts.join(',')+')';
      else if(fn === 'ROUND' || fn === 'ARRED'){
