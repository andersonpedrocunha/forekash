function rowDragOver(ev){
  const tr = ev.currentTarget;
  if(!rowIsValidTarget(tr)) return;
  ev.preventDefault();
  try{ ev.dataTransfer.dropEffect = 'move'; }catch(_){}
  const rect = tr.getBoundingClientRect();
  const isTop = (ev.clientY - rect.top) < rect.height / 2;
  rowClearDropHints();
  tr.classList.add(isTop ? 'row-drop-above' : 'row-drop-below');
}

function rowDragLeave(ev){
  const tr = ev.currentTarget;
  if(tr){ tr.classList.remove('row-drop-above'); tr.classList.remove('row-drop-below'); }
}

function rowDrop(ev){
  const tr = ev.currentTarget;
  if(!rowIsValidTarget(tr)){ rowClearDropHints(); return; }
  ev.preventDefault();
  const ctx  = _rowReorderCtx;
  const rect = tr.getBoundingClientRect();
  const placeAbove = (ev.clientY - rect.top) < rect.height / 2;
  const fn = ROW_REORDERERS[ctx.mod];
  rowClearDropHints();
  if(typeof fn === 'function'){
    try{ fn(ctx.id, tr.dataset.reorderId, placeAbove); }catch(e){ console.warn('reorder failed', e); }
  }
  _rowReorderCtx = null;
}

// Helper: monta os atributos a serem injetados no <tr> para habilitar reorder.
// Ex.: `${rowDragAttrs('pes', p.id, p.ativo, tipoGrp)}`
function rowDragAttrs(mod, id, ativo, grp){
  const a = ativo === false ? 'false' : 'true';
  const g = grp == null ? '' : String(grp);
  return `data-reorder-mod="${esc(mod)}" data-reorder-id="${esc(String(id))}"`
       + ` data-reorder-ativo="${a}" data-reorder-grp="${esc(g)}"`
       + ` ondragstart="rowDragStart(event)" ondragover="rowDragOver(event)"`
       + ` ondragleave="rowDragLeave(event)" ondrop="rowDrop(event)" ondragend="rowDragEnd(event)"`;
}

// Move `item` no array para imediatamente antes/depois de `target`.
// Retorna true se reordenou (posição diferente); false se é no-op.
function arrayReorder(arr, item, target, placeAbove){
  if(item === target) return false;
  const srcIdx = arr.indexOf(item);
  if(srcIdx < 0) return false;
  // Remove primeiro para que o índice de destino seja sempre consistente.
  arr.splice(srcIdx, 1);
  const tgtIdx = arr.indexOf(target);
  if(tgtIdx < 0){ arr.splice(srcIdx, 0, item); return false; }
  const insertAt = placeAbove ? tgtIdx : (tgtIdx + 1);
  arr.splice(insertAt, 0, item);
  return true;
}

// Safety net: se o usuário soltar o mouse fora do handle sem iniciar drag, limpa
// o estado draggable em qualquer <tr> que tenha ficado preso em true — assim o
// foco em inputs, seleção de texto e cliques em células continuam normais.
document.addEventListener('mouseup', () => {
  if(_rowReorderCtx) return; // drag ativo — deixa dragend finalizar
  document.querySelectorAll('tr.row-drag-hover, tr[draggable="true"]').forEach(tr => {
    if(!tr.classList.contains('row-dragging')){
      tr.draggable = false;
      tr.classList.remove('row-drag-hover');
    }
  });
}, true);

