let _homeMarketCache = null;
async function homeFetchMarket(){
  // Cache em sessionStorage por 15 minutos (evita hits repetidos)
  try{
    const cached = sessionStorage.getItem('home_market_v4');
    if(cached){
      const c = JSON.parse(cached);
      if(c && c.ts && (Date.now() - c.ts) < 15 * 60 * 1000){
        _homeMarketCache = c;
        homeRenderMarket(c);
        return;
      }
    }
  }catch(e){}

  const out = { ts: Date.now(), usd:null, selic:null, ipca:null, inpc:null };

  // Dólar: AwesomeAPI (BRL) — suporta CORS
  try{
    const r = await fetch('https://economia.awesomeapi.com.br/json/last/USD-BRL', { cache:'no-store' });
    if(r.ok){
      const j = await r.json();
      const u = j && j.USDBRL;
      if(u){
        out.usd = {
          bid: parseFloat(u.bid),
          pctChange: parseFloat(u.pctChange),
          varBid: parseFloat(u.varBid),
          high: parseFloat(u.high),
          low:  parseFloat(u.low),
          timestamp: parseInt(u.timestamp, 10)
        };
      }
    }
  }catch(e){ /* offline / cors — segue com fallback */ }

  // Helper genérico para séries do BCB (SGS)
  async function fetchBcbSerie(id){
    try{
      const r = await fetch(`https://api.bcb.gov.br/dados/serie/bcdata.sgs.${id}/dados/ultimos/1?formato=json`, { cache:'no-store' });
      if(!r.ok) return null;
      const arr = await r.json();
      if(!Array.isArray(arr) || !arr.length) return null;
      const last = arr[arr.length-1];
      const val = parseFloat(String(last.valor).replace(',', '.'));
      if(isNaN(val)) return null;
      // BCB retorna data como DD/MM/YYYY — converte p/ "mmm/yyyy"
      let lbl = last.data;
      const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(String(last.data||''));
      if(m){
        const meses=['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
        lbl = meses[parseInt(m[2],10)-1] + '/' + m[3];
      }
      return { valor: val, data: lbl };
    }catch(e){ return null; }
  }

  // IBGE (servicodados) — descobre o ID da variável "acumulada em 12 meses"
  // via metadados e busca o último valor. Robusto a mudanças de ID.
  async function fetchIbgeAcum12m(agregado){
    try{
      const m = await fetch(`https://servicodados.ibge.gov.br/api/v3/agregados/${agregado}/metadados`, { cache:'no-store' });
      if(!m.ok) return null;
      const meta = await m.json();
      const vars = (meta && meta.variaveis) || [];
      // Busca variável cujo nome contenha "acumulada ... 12 meses" e unidade "%"
      const target = vars.find(v => /acumulad[ao].*12\s*meses/i.test(String(v.nome||''))
                                 && /%|percentual/i.test(String(v.unidade||'')));
      if(!target || target.id == null) return null;
      const url = `https://servicodados.ibge.gov.br/api/v3/agregados/${agregado}/periodos/-1/variaveis/${target.id}?localidades=N1[all]`;
      const r = await fetch(url, { cache:'no-store' });
      if(!r.ok) return null;
      const arr = await r.json();
      if(!Array.isArray(arr) || !arr.length) return null;
      const res = arr[0] && arr[0].resultados && arr[0].resultados[0];
      const serie = res && res.series && res.series[0] && res.series[0].serie;
      if(!serie) return null;
      const keys = Object.keys(serie).sort(); // YYYYMM
      if(!keys.length) return null;
      const k = keys[keys.length-1];
      const raw = serie[k];
      const val = parseFloat(String(raw).replace(',', '.'));
      if(isNaN(val) || raw === '...' || raw === '-') return null;
      const meses=['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
      const yyyy = k.slice(0,4);
      const mi   = Math.max(1, Math.min(12, parseInt(k.slice(4,6),10))) - 1;
      return { valor: val, data: meses[mi] + '/' + yyyy };
    }catch(e){ return null; }
  }

  // Fallback: calcula acumulado 12m por composição das variações mensais do BCB SGS
  // IPCA mensal: 433 · INPC mensal: 188
  async function fetchBcb12mComposto(serieMensal){
    try{
      const r = await fetch(`https://api.bcb.gov.br/dados/serie/bcdata.sgs.${serieMensal}/dados/ultimos/12?formato=json`, { cache:'no-store' });
      if(!r.ok) return null;
      const arr = await r.json();
      if(!Array.isArray(arr) || arr.length < 12) return null;
      let prod = 1;
      for(const it of arr){
        const v = parseFloat(String(it.valor).replace(',', '.'));
        if(isNaN(v)) return null;
        prod *= (1 + v/100);
      }
      const pct = (prod - 1) * 100;
      const last = arr[arr.length-1];
      let lbl = last.data;
      const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(String(last.data||''));
      if(m){
        const meses=['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
        lbl = meses[parseInt(m[2],10)-1] + '/' + m[3];
      }
      return { valor: pct, data: lbl };
    }catch(e){ return null; }
  }

  // SELIC (meta anual Copom)  — BCB SGS série 432
  // IPCA/INPC acumulado 12 meses: IBGE (discovery) → fallback BCB composto
  const [selic, ipcaIbge, inpcIbge] = await Promise.all([
    fetchBcbSerie(432),
    fetchIbgeAcum12m(1737),
    fetchIbgeAcum12m(1736)
  ]);
  out.selic = selic;
  out.ipca  = ipcaIbge || await fetchBcbSerie(13522) || await fetchBcb12mComposto(433);
  out.inpc  = inpcIbge || await fetchBcb12mComposto(188);

  _homeMarketCache = out;
  try{ sessionStorage.setItem('home_market_v4', JSON.stringify(out)); }catch(e){}
  homeRenderMarket(out);
}

function homeRenderMarket(data){
  const uVal = document.getElementById('home-usd-val');
  const uDel = document.getElementById('home-usd-delta');
  const uSub = document.getElementById('home-usd-sub');
  if(uVal) uVal.classList.remove('home-loading');
  const sVal = document.getElementById('home-selic-val');
  const sDel = document.getElementById('home-selic-delta');
  const sSub = document.getElementById('home-selic-sub');
  if(sVal) sVal.classList.remove('home-loading');

  // Dólar
  if(data && data.usd && !isNaN(data.usd.bid)){
    if(uVal) uVal.textContent = 'R$ ' + fmtBR(data.usd.bid, 4);
    if(uDel){
      const p = data.usd.pctChange;
      const isUp = p > 0, isDown = p < 0;
      uDel.classList.remove('up','down');
      if(isUp) uDel.classList.add('up');
      if(isDown) uDel.classList.add('down');
      const arrow = isUp
        ? '<svg viewBox="0 0 24 24"><path d="M7 14l5-5 5 5"/></svg>'
        : isDown
          ? '<svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5"/></svg>'
          : '<svg viewBox="0 0 24 24"><path d="M5 12h14"/></svg>';
      const sign = isUp ? '+' : '';
      uDel.innerHTML = `${arrow} ${sign}${fmtBR(p, 2)}%`;
    }
    if(uSub && data.usd.timestamp){
      const dt = new Date(data.usd.timestamp * 1000);
      uSub.textContent = 'atualizado ' + dt.toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit' });
    }
  } else {
    if(uVal) uVal.textContent = 'indisponível';
    if(uDel) uDel.textContent = '';
    if(uSub) uSub.textContent = 'sem conexão';
  }

  // SELIC
  if(data && data.selic && !isNaN(data.selic.valor)){
    if(sVal) sVal.textContent = fmtBR(data.selic.valor, 2) + ' %';
    if(sDel){
      sDel.classList.remove('up','down');
      sDel.textContent = 'meta Copom';
    }
    if(sSub) sSub.textContent = data.selic.data ? ('vigente desde ' + data.selic.data) : 'taxa anual';
  } else {
    if(sVal) sVal.textContent = 'indisponível';
    if(sDel) sDel.textContent = '';
    if(sSub) sSub.textContent = 'sem conexão';
  }

  // IPCA / INPC (acumulado 12 meses, BCB SGS)
  function renderIndice(base, series, labelTxt){
    const val = document.getElementById(`home-${base}-val`);
    const del = document.getElementById(`home-${base}-delta`);
    const sub = document.getElementById(`home-${base}-sub`);
    if(val) val.classList.remove('home-loading');
    if(series && !isNaN(series.valor)){
      if(val) val.textContent = fmtBR(series.valor, 2) + ' %';
      if(del){
        del.classList.remove('up','down');
        del.textContent = labelTxt; // 'acum. 12M'
      }
      if(sub) sub.textContent = series.data ? ('ref. ' + series.data) : 'acumulado 12 meses';
    } else {
      if(val) val.textContent = 'indisponível';
      if(del) del.textContent = '';
      if(sub) sub.textContent = 'sem conexão';
    }
  }
  renderIndice('ipca', data && data.ipca, 'acum. 12M');
  renderIndice('inpc', data && data.inpc, 'acum. 12M');
}

