async function anaPresetApply(presetId){
  const preset = PRESENTATION_PRESETS.find(p => p.id === presetId);
  if(!preset) return;
  // Se já tem slides, pergunta se substitui ou adiciona
  let mode = 'replace';
  if((_anaState.presentation.slides || []).length > 0){
    let choice = '';
    try {
      choice = window.confirm('Você já tem ' + _anaState.presentation.slides.length + ' slides.\n\nOK = SUBSTITUIR todos pelos slides do template "' + preset.name + '"\nCancelar = ADICIONAR ao final')
        ? 'replace' : 'append';
    } catch(e){ choice = 'replace'; }
    mode = choice;
  }
  if(mode === 'replace'){
    _anaState.presentation.slides = [];
  }
  // Constrói cada slide do preset
  for(const item of preset.slides){
    const tpl = SLIDE_TEMPLATES.find(t => t.id === item.tpl);
    if(!tpl) continue;
    const slide = tpl.build();
    slide.id = _anaSlideNextId++;
    if(slide.widgets){
      for(const w of slide.widgets){ w.id = _anaSlideWidgetNextId++; }
    }
    // Override título/sub se especificados no preset
    if(item.title) slide.title = item.title;
    if(item.sub)   slide.subtitle = item.sub;
    // Auto-preenchimento se solicitado
    if(item.autoTitle){
      try { slide.title = _anaAutoTitleFromSlide(slide); } catch(e){}
    }
    if(item.autoNarr){
      try {
        const narr = _anaAutoNarrativaFromSlide(slide);
        // Acha primeiro widget de texto e preenche; se não tem, cria
        const tw = (slide.widgets||[]).find(w => w.widget === 'text');
        if(tw) tw.text = narr;
        else {
          slide.widgets = slide.widgets || [];
          slide.widgets.push({ id:_anaSlideWidgetNextId++, widget:'text', cols:4, rows:2, text:narr });
        }
      } catch(e){}
    }
    _anaState.presentation.slides.push(slide);
  }
  // Ativa o primeiro slide do preset
  if(_anaState.presentation.slides.length > 0){
    _anaState.presentation.currentId = _anaState.presentation.slides[mode === 'replace' ? 0 : -1].id;
  }
  _anaSaveState();
  anaPresetClose();
  _anaRenderPresent();
  if(typeof toast === 'function') toast('✅ "' + preset.name + '" carregada (' + preset.slides.length + ' slides)');
}
try {
  window.anaPresetOpen  = anaPresetOpen;
  window.anaPresetClose = anaPresetClose;
  window.anaPresetApply = anaPresetApply;
} catch(e){}

