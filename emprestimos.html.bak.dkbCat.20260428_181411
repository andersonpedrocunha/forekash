// Redistribui proporcionalmente os outros tipos pra soma sempre fechar 100.
// changedIdx = índice do tipo que o usuário acabou de editar; newPct = novo valor.
function _pesAlocRedistribute(arr, changedIdx, newPct){
  if(!Array.isArray(arr) || !arr[changedIdx]) return;
  newPct = Math.max(0, Math.min(100, newPct));
  arr[changedIdx].pct = newPct;
  if(arr.length < 2) return;
  const others = arr.map((a,i) => ({a, i})).filter(x => x.i !== changedIdx);
  const targetOtherSum = 100 - newPct;
  const currentOtherSum = others.reduce((s,x) => s + (parseFloat(x.a.pct)||0), 0);
  if(targetOtherSum <= 0){
    // Não sobrou — zera todos os outros
    others.forEach(x => x.a.pct = 0);
  } else if(currentOtherSum === 0){
    // Distribui igual entre os outros
    const each = targetOtherSum / others.length;
    others.forEach(x => x.a.pct = each);
  } else {
    // Redistribui proporcionalmente
    others.forEach(x => {
      const cur = parseFloat(x.a.pct) || 0;
      x.a.pct = (cur / currentOtherSum) * targetOtherSum;
    });
  }
  // Arredonda e ajusta o maior "outro" pra garantir soma exata 100
  arr.forEach(a => { a.pct = Math.round((parseFloat(a.pct)||0) * 10) / 10; });
  const total = arr.reduce((s,a) => s + (parseFloat(a.pct)||0), 0);
  const diff = Math.round((100 - total) * 10) / 10;
  if(Math.abs(diff) > 0.01){
    // Aplica ajuste no maior item diferente do changedIdx (pra não refazer o que o usuário acabou de tipar)
    let tgt = -1, max = -1;
    for(let k=0; k<arr.length; k++){
      if(k === changedIdx) continue;
      const v = parseFloat(arr[k].pct) || 0;
      if(v > max){ max = v; tgt = k; }
    }
    if(tgt < 0) tgt = changedIdx;
    arr[tgt].pct = Math.max(0, Math.min(100, (parseFloat(arr[tgt].pct)||0) + diff));
  }
}
