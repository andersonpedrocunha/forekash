// ─── Tabs do pesCard (Detalhes / Pagamento) ───
function _pcardSetTab(tab){
  // Antes de trocar de aba, salva o que está editado
  _pcardCommitBancoPag();
  _pcardTab = tab;
  if(_pesCardOpenId != null) renderPesCardBody();
}
function _pcardRenderPagto(p, reg){
  if(!reg){
    return '<div class="pcard-empty">Selecione uma pessoa pra cadastrar dados de pagamento.</div>';
  }
  if(!reg.bancoPag || typeof reg.bancoPag !== 'object'){
    reg.bancoPag = { banco:'', agencia:'', conta:'', tipo:'corrente', pix:'' };
  }
  const bp = reg.bancoPag;
  const esc = (s) => String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  return `
    <div class="pcard-pagto">
      <div>
        <h5>Dados bancários</h5>
        <div class="row">
          <div class="fld">
            <label>Banco</label>
            <input type="text" id="pcard-bp-banco" value="${esc(bp.banco||'')}" placeholder="Ex: Itaú" oninput="_pcardCommitBancoPag()">
          </div>
          <div class="fld">
            <label>Tipo de conta</label>
            <select id="pcard-bp-tipo" onchange="_pcardCommitBancoPag()">
              <option value="corrente"${bp.tipo==='corrente'?' selected':''}>Corrente</option>
              <option value="poupanca"${bp.tipo==='poupanca'?' selected':''}>Poupança</option>
              <option value="pagamento"${bp.tipo==='pagamento'?' selected':''}>Conta-pagamento</option>
              <option value="salario"${bp.tipo==='salario'?' selected':''}>Conta-salário</option>
            </select>
          </div>
        </div>
        <div class="row">
          <div class="fld">
            <label>Agência</label>
            <input type="text" id="pcard-bp-agencia" value="${esc(bp.agencia||'')}" placeholder="0000" oninput="_pcardCommitBancoPag()">
          </div>
          <div class="fld">
            <label>Conta</label>
            <input type="text" id="pcard-bp-conta" value="${esc(bp.conta||'')}" placeholder="00000-0" oninput="_pcardCommitBancoPag()">
          </div>
        </div>
      </div>
      <div>
        <h5>Chave PIX</h5>
        <div class="row full">
          <div class="fld">
            <label>Chave PIX</label>
            <div class="pcard-pix-wrap">
              <input type="text" id="pcard-bp-pix" value="${esc(bp.pix||'')}" placeholder="CPF/CNPJ, e-mail, telefone ou aleatória" oninput="_pcardValidatePix()" onblur="_pcardValidatePix(true)">
              <span class="pix-ic" id="pcard-pix-icon"></span>
            </div>
            <div id="pcard-pix-info" style="margin-top:6px"></div>
          </div>
        </div>
      </div>
    </div>
  `;
}
function _pcardCommitBancoPag(){
  if(_pesCardOpenId == null) return;
  const p = pessoas.people.find(x => x.id === _pesCardOpenId);
  if(!p) return;
  const reg = (typeof pesRegOf === 'function') ? pesRegOf(p) : null;
  if(!reg) return;
  if(!reg.bancoPag || typeof reg.bancoPag !== 'object') reg.bancoPag = {};
  const get = (id) => { const el = document.getElementById(id); return el ? el.value : null; };
  let v;
  v = get('pcard-bp-banco');    if(v != null) reg.bancoPag.banco    = v.trim();
  v = get('pcard-bp-tipo');     if(v != null) reg.bancoPag.tipo     = v;
  v = get('pcard-bp-agencia');  if(v != null) reg.bancoPag.agencia  = v.trim();
  v = get('pcard-bp-conta');    if(v != null) reg.bancoPag.conta    = v.trim();
  v = get('pcard-bp-pix');      if(v != null) reg.bancoPag.pix      = v.trim();
  if(typeof pessoasSave === 'function') pessoasSave();
}
function _pcardValidatePix(applyFormat){
  const inp = document.getElementById('pcard-bp-pix');
  const ico = document.getElementById('pcard-pix-icon');
  const info = document.getElementById('pcard-pix-info');
  if(!inp || typeof _fcardDetectPix !== 'function') return;
  const det = _fcardDetectPix(inp.value);
  if(ico){
    if(det.type === 'empty'){
      ico.textContent = '';
    } else if(det.valid){
      ico.textContent = '✓';
      ico.style.color = '#16A34A';
    } else {
      ico.textContent = '⚠';
      ico.style.color = '#DC2626';
    }
  }
  if(info){
    if(det.type === 'empty'){
      info.innerHTML = '';
    } else {
      const cls = det.valid ? 'ok' : 'err';
      const tipoLabel = ({
        cpf:'CPF', cnpj:'CNPJ', email:'E-mail', telefone:'Telefone', aleatoria:'Aleatória', unknown:'?'
      })[det.type] || '';
      const iconMap = { cpf:'🧑', cnpj:'🏢', email:'✉️', telefone:'📱', aleatoria:'🔑', unknown:'❓' };
      const escFn = (s) => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      info.innerHTML = '<span class="fcard-pix-info ' + cls + '">' + (iconMap[det.type] || '') + ' ' + tipoLabel + (tipoLabel ? ' · ' : '') + escFn(det.label) + '</span>';
    }
  }
  if(applyFormat && det.valid && det.formatted && inp.value !== det.formatted){
    inp.value = det.formatted;
    _pcardCommitBancoPag();
  }
}
try {
  window._pcardSetTab = _pcardSetTab;
  window._pcardCommitBancoPag = _pcardCommitBancoPag;
  window._pcardValidatePix = _pcardValidatePix;
} catch(e){}

function setPesDataEntrada(id, val){
  const p = pessoas.people.find(x=>x.id===id);
  if(!p) return;
  p.dataEntrada = (val || '').trim();
  pessoasSave();
  if(_pesCardOpenId === id) renderPesCardBody();
}

function setPesDataSaida(id, val){
  const p = pessoas.people.find(x=>x.id===id);
  if(!p) return;
  p.dataSaida = (val || '').trim();
  pessoasSave();
