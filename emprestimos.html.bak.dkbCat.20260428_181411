                 onkeydown="if(event.key==='Enter'){event.preventDefault();mrcashSend();}"/>
          <button class="diag-mrcash-send" onclick="mrcashSend()">
            <svg viewBox="0 0 24 24"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            Enviar
          </button>
        </div>
      </div>
    </div>`;

  // Score acompanha o streaming da analise: comeca em 0/cinza, vai progredindo
  // conforme as secoes sao renderizadas. Em modo cache (instant), faz countup curto.
  const scoreNumEl = document.getElementById('diag-score-num');
  const scoreArcEl = document.getElementById('diag-score-arc');
  const scoreBox   = body.querySelector('.diag-health-score');
  const scoreTitle = document.getElementById('diag-health-title');
  const scoreChips = document.getElementById('diag-health-chips');
  const _targetOffset = scoreBox ? parseFloat(scoreBox.getAttribute('data-target-offset')) : 0;
  const _targetColor  = scoreBox ? scoreBox.getAttribute('data-target-color') : '#10B981';
  const _targetScore  = ind.score;
  // Helper de easing
  const _scoreApply = (pct) => {
    const cur = Math.round(_targetScore * pct);
    if(scoreNumEl) scoreNumEl.textContent = cur;
    if(scoreArcEl){
      const startOff = parseFloat(scoreArcEl.getAttribute('stroke-dasharray'));
      const newOff = startOff - (startOff - _targetOffset) * pct;
      scoreArcEl.setAttribute('stroke-dashoffset', newOff.toFixed(2));
      // cor interpola pra final no ultimo terco
      if(pct >= 0.66) scoreArcEl.setAttribute('stroke', _targetColor);
    }
  };
  if(instant){
    // Cache: revela tudo imediatamente com countup curto
    if(scoreNumEl) diagCountUp(scoreNumEl, _targetScore, 900);
    if(scoreArcEl){ scoreArcEl.setAttribute('stroke-dashoffset', _targetOffset); scoreArcEl.setAttribute('stroke', _targetColor); }
    if(scoreTitle){ scoreTitle.textContent = scoreTitle.getAttribute('data-final'); scoreTitle.style.opacity = '1'; }
    if(scoreChips){ scoreChips.style.opacity = '1'; scoreChips.style.transform = 'translateY(0)'; }
  } else {
    // Streaming: progride conforme secoes renderizam (orquestrado abaixo)
    _scoreApply(0);
  }
  window.__diagScoreApply = _scoreApply;
  window.__diagScoreFinish = () => {
    _scoreApply(1);
    if(scoreTitle){ scoreTitle.textContent = scoreTitle.getAttribute('data-final'); scoreTitle.style.opacity = '1'; scoreTitle.style.transition = 'opacity .5s ease'; }
    if(scoreChips){ scoreChips.style.opacity = '1'; scoreChips.style.transform = 'translateY(0)'; }
  };

  // Anima valores em BRL com data-brl-animate
  body.querySelectorAll('[data-brl-animate]').forEach(el=>{
    const target = Number(el.getAttribute('data-brl-animate')) || 0;
    const t0 = performance.now(); const dur = instant ? 900 : 3500;
    (function step(now){
      const t = Math.min(1, (now - t0)/dur);
      const e = 1 - Math.pow(1-t, 3);
      el.textContent = fmtBRL(Math.round(target*e));
      if(t < 1) requestAnimationFrame(step);
      else el.textContent = fmtBRL(target);
    })(performance.now());
  });

  // Envolve BRL/%/σ/meses em .diag-num nos alertas e no rodapé do ML (já renderizados)
  body.querySelectorAll('.diag-alert-msg, .diag-ml-forecast-foot, .diag-ml-anom-exp, .diag-ml-anom-val')
      .forEach(el => { el.innerHTML = diagWrapNumbers(el.innerHTML); });
  diagAnimateNumsIn(body);

  // Streaming sequencial do texto das seções narrativas com progresso
  const streamMap = {
    precif:  precifHtml,
    custos:  custosHtml,
    pessoas: pessoasHtml,
    fluxo:   fluxoHtml,
    riscos:  riscosHtml
  };
  if(instant){
    // Modo cache: injeta o conteúdo direto, sem streaming
    const order = ['precif','custos','pessoas','fluxo','riscos'];
    for(const key of order){
      const el = body.querySelector(`.diag-txt[data-stream="${key}"]`);
      if(!el) continue;
      el.innerHTML = diagWrapNumbers(streamMap[key] || '');
    }
    diagProgressUpdate(1);
  } else {
    (async () => {
      const order = ['precif','custos','pessoas','fluxo','riscos'];
      const total = order.length;
      diagProgressUpdate(0.02);
      // Score acompanha: comeca em 5%, atualiza progressivamente, completa no fim
      try { window.__diagScoreApply && window.__diagScoreApply(0.05); } catch(_){}
      for(let i=0;i<order.length;i++){
        const key = order[i];
        const el = body.querySelector(`.diag-txt[data-stream="${key}"]`);
        if(!el) continue;
        // Skeleton rápido antes do stream dessa seção
        el.innerHTML = `
          <div class="diag-skeleton sk-long"></div>
          <div class="diag-skeleton sk-med"></div>
          <div class="diag-skeleton sk-short"></div>`;
        diagProgressUpdate((i + .15) / total);
        await new Promise(r => setTimeout(r, 180));
        el.innerHTML = '';
        await diagStreamInto(el, streamMap[key], 5);
        // Pós-stream: envolve números e anima
        el.innerHTML = diagWrapNumbers(el.innerHTML);
        diagAnimateNumsIn(el);
        diagProgressUpdate((i + 1) / total);
        // Score: progride junto com a analise
        try { window.__diagScoreApply && window.__diagScoreApply(Math.min(0.95, (i + 1) / total)); } catch(_){}
      }
      diagProgressUpdate(1);
      // Finalizacao: revela titulo + chips + cor final do score
      try { window.__diagScoreFinish && window.__diagScoreFinish(); } catch(_){}
    })();
  }

  mrcashRenderGreeting();
}

function diagRenderMLSection(ml, snap, icoML){
  if(!ml) return '';
  const recFC = ml.forecast && ml.forecast.receita;
  const folFC = ml.forecast && ml.forecast.folha;
  const estFC = ml.forecast && ml.forecast.estrutura;
  const q = ml.quality;
  const qLbl = q === 'alta' ? 'alta' : (q === 'média' ? 'média' : (q === 'baixa' ? 'baixa' : 'insuficiente'));
  const qClass = q === 'alta' ? 'good' : (q === 'média' ? 'warn' : 'bad');

  // Forecast card (Receita é o principal)
  let forecastHtml = '';
  if(recFC){
    const last3 = recFC.serie.slice(-3);
    const lastMes = last3.reduce((s,v)=>s+v,0)/last3.length;
    const next3 = recFC.forecast.slice(0,3);
    const next3Mes = next3.reduce((s,v)=>s+v,0)/next3.length;
    const delta = lastMes > 0 ? ((next3Mes - lastMes)/lastMes)*100 : 0;
    const deltaCls = delta > 3 ? 'diag-hi-pos' : (delta < -3 ? 'diag-hi-neg' : '');
    const trendWord = recFC.slope > 0 ? 'crescente' : (recFC.slope < 0 ? 'decrescente' : 'estável');
    const r2Pct = Math.round(recFC.r2*100);
    const r2Qual = r2Pct > 70 ? 'forte' : (r2Pct > 40 ? 'moderado' : 'fraco');
    const _nC = snap.nClosed || 0;
    const _nProj = 12 - _nC;
    forecastHtml = `
      <div class="diag-ml-forecast">
        <div class="diag-ml-forecast-hd">
          <div>
            <div class="diag-ml-forecast-title">Projeção de receita — Realizado vs. próximos meses</div>
            <div class="diag-ml-forecast-sub">Ensemble <b>Regressão Linear + Holt</b> treinado em <b>${recFC.serie.length} pontos fechados</b> · R²=${(recFC.r2).toFixed(2)} (ajuste ${r2Qual}) · tendência ${trendWord} de <b>${fmtBRL(Math.abs(recFC.slope))}</b>/mês</div>
          </div>
          <div class="diag-ml-forecast-delta ${deltaCls}">
            ${delta >= 0 ? '+' : ''}${delta.toFixed(1)}%
            <small>próx. trim. vs. últ. trim.</small>
          </div>
        </div>
        ${_nC > 0 ? `<div style="display:flex;gap:10px;margin:8px 0 6px;flex-wrap:wrap;font-size:12.5px">
          <span style="display:inline-flex;align-items:center;gap:6px;background:#DBEAFE;color:#1E40AF;border:1px solid #93C5FD;padding:4px 10px;border-radius:8px;font-weight:700"><span style="width:8px;height:8px;border-radius:50%;background:#2563EB"></span>${_nC} ${_nC===1?'mês fechado':'meses fechados'} apurados</span>
          <span style="display:inline-flex;align-items:center;gap:6px;background:#EDE9FE;color:#5B21B6;border:1px solid #C4B5FD;padding:4px 10px;border-radius:8px;font-weight:700"><span style="width:8px;height:8px;border-radius:50%;background:#8B5CF6"></span>${_nProj} ${_nProj===1?'mês de projeção':'meses de projeção'} pela frente</span>
          <span style="color:var(--txl);align-self:center;font-style:italic">a projeção é uma estimativa — pode melhorar com novos contratos, antecipação de recebíveis ou redução de custos</span>
        </div>` : ''}
        ${diagForecastSvg(recFC, recFC.labels)}
        <div class="diag-ml-forecast-foot">
          <span>Projeção média mensal: <b>${fmtBRL(next3Mes)}</b></span>
          <span>Intervalo de confiança: <b>±${fmtBRL(1.5*recFC.rmse)}</b> (1,5σ)</span>
          <span style="color:var(--txl);font-size:.7rem">Estamos em ${['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'][snap.curMIdx]}/${snap.curYear.slice(2)} — ainda há ${_nProj} ${_nProj===1?'mês':'meses'} de operação para influenciar o resultado anual.</span>
        </div>
      </div>`;
  }

  // Anomalias
  let anomHtml = '';
  if(ml.anomalies && ml.anomalies.length > 0){
    anomHtml = `
      <div class="diag-ml-block">
        <div class="diag-ml-block-hd">
          <span class="diag-ml-block-icon alt">⚡</span>
          <b>Anomalias detectadas</b>
          <span class="diag-ml-block-sub">· z-score ≥ 1,8 desvios padrão</span>
        </div>
        <div class="diag-ml-anoms">
          ${ml.anomalies.map(a => `
            <div class="diag-ml-anom ${a.tipo === 'alta' ? 'up' : 'down'}">
              <div class="diag-ml-anom-lbl">${esc(a.label)} · ${esc(a.mesLbl)}</div>
              <div class="diag-ml-anom-val">${fmtBRL(a.valor)}</div>
              <div class="diag-ml-anom-exp">
                ${a.tipo === 'alta' ? '▲' : '▼'} <b>${Math.abs(a.z).toFixed(1)}σ</b> ${a.tipo === 'alta' ? 'acima' : 'abaixo'} da média (${fmtBRL(a.esperado)})
              </div>
            </div>`).join('')}
        </div>
      </div>`;
  }

  // Clusters de clientes
  let clusterHtml = '';
  if(ml.clusters){
    const tot = ml.clusters.summary.reduce((s,c)=>s+c.total,0);
    clusterHtml = `
      <div class="diag-ml-block">
        <div class="diag-ml-block-hd">
          <span class="diag-ml-block-icon clu">◎</span>
          <b>Segmentação de clientes — K-Means</b>
          <span class="diag-ml-block-sub">· ${ml.clusters.k} clusters · ${ml.clusters.clients.length} clientes</span>
        </div>
        <div class="diag-ml-clusters">
          ${ml.clusters.summary.map((c,i) => {
            const pct = tot > 0 ? (c.total/tot)*100 : 0;
            const cls = i === 0 ? 'anc' : (i === 1 && ml.clusters.k === 3 ? 'rel' : 'pon');
            const topNames = c.clientes.map(x => esc(x.nome)).slice(0,3).join(', ');
            return `
              <div class="diag-ml-cluster ${cls}">
                <div class="diag-ml-cluster-hd">
                  <b>${c.label}</b>
                  <span class="diag-ml-cluster-qt">${c.qtd} cli.</span>
                </div>
                <div class="diag-ml-cluster-val">${fmtBRL(c.total)}</div>
                <div class="diag-ml-cluster-bar"><span style="width:${pct.toFixed(1)}%"></span></div>
                <div class="diag-ml-cluster-sub">
                  ${pct.toFixed(0)}% da receita · centróide ${fmtBRL(c.centroid)}
                  ${topNames ? `<div class="diag-ml-cluster-names">${topNames}${c.clientes.length > 3 ? ' +' + (c.clientes.length-3) : ''}</div>` : ''}
                </div>
              </div>`;
          }).join('')}
        </div>
      </div>`;
  }

  // Correlações
  let corrHtml = '';
  if(ml.correlations && ml.correlations.length > 0){
    corrHtml = `
      <div class="diag-ml-block">
        <div class="diag-ml-block-hd">
          <span class="diag-ml-block-icon cor">⟷</span>
          <b>Correlações descobertas</b>
          <span class="diag-ml-block-sub">· Pearson com defasagem</span>
        </div>
        <div class="diag-ml-corrs">
          ${ml.correlations.map(c => {
            const rAbs = Math.abs(c.r);
            const forca = rAbs > 0.7 ? 'forte' : (rAbs > 0.5 ? 'moderada' : 'fraca');
            const dir = c.r > 0 ? 'positiva' : 'negativa';
            const lagTxt = c.lag === 0 ? 'sem defasagem' :
                           (c.lag > 0 ? `<b>${c.labelA}</b> antecede <b>${c.labelB}</b> em ${c.lag} ${c.lag===1?'mês':'meses'}` :
                                        `<b>${c.labelB}</b> antecede <b>${c.labelA}</b> em ${Math.abs(c.lag)} ${Math.abs(c.lag)===1?'mês':'meses'}`);
            const barPct = rAbs * 100;
            const barCls = c.r > 0 ? 'up' : 'down';
            return `
              <div class="diag-ml-corr">
                <div class="diag-ml-corr-lbl"><b>${esc(c.labelA)}</b> ↔ <b>${esc(c.labelB)}</b></div>
                <div class="diag-ml-corr-val">r = ${c.r.toFixed(2)} <span class="diag-ml-corr-tag">${forca} ${dir}</span></div>
                <div class="diag-ml-corr-bar ${barCls}"><span style="width:${barPct.toFixed(0)}%"></span></div>
                <div class="diag-ml-corr-sub">${lagTxt}</div>
              </div>`;
          }).join('')}
        </div>
      </div>`;
  }

  // Sazonalidade
  let sazHtml = '';
  if(ml.seasonality){
    const fortes = ml.seasonality.fortes.map(s => `<b>${s.mes}</b> (+${s.desvio.toFixed(0)}%)`).join(', ');
    const fracos = ml.seasonality.fracos.map(s => `<b>${s.mes}</b> (${s.desvio.toFixed(0)}%)`).join(', ');
    const mensal = ml.seasonality.mensal;
    const maxDev = Math.max(...mensal.map(m => Math.abs(m.desvio)), 1);
    sazHtml = `
      <div class="diag-ml-block">
        <div class="diag-ml-block-hd">
          <span class="diag-ml-block-icon saz">◴</span>
          <b>Padrão sazonal</b>
          <span class="diag-ml-block-sub">· Decomposição multiplicativa ano cheio</span>
        </div>
        <div class="diag-ml-saz-bars">
          ${mensal.map(m => {
            const pct = Math.abs(m.desvio);
            const cls = m.desvio > 5 ? 'up' : (m.desvio < -5 ? 'down' : '');
            const h = (pct/maxDev)*60 + 10;
            return `<div class="diag-ml-saz-bar ${cls}" title="${m.mes}: ${m.desvio > 0 ? '+' : ''}${m.desvio.toFixed(0)}%">
              <span class="diag-ml-saz-fill" style="height:${h}%"></span>
              <small>${m.mes}</small>
            </div>`;
          }).join('')}
        </div>
        <div class="diag-ml-saz-txt">
          Meses fortes: ${fortes || '—'} · Meses fracos: ${fracos || '—'}
        </div>
      </div>`;
  }

  const anyContent = forecastHtml || anomHtml || clusterHtml || corrHtml || sazHtml;
  if(!anyContent){
    return `
      <div class="diag-section ml">
        <div class="diag-section-hd">
          <div class="diag-section-ico" style="background:linear-gradient(135deg,#8B5CF6,#6366F1)">${icoML}</div>
          <div class="diag-section-title">Previsões & Padrões <span class="diag-ml-quality ${qClass}">qualidade: ${qLbl}</span></div>
        </div>
        <div class="diag-txt"><p>Ainda não há dados históricos suficientes para treinar os modelos. Preencha pelo menos <b>6 meses de receita</b> para ativar previsões, e <b>12 meses</b> para detecção de sazonalidade e correlações.</p></div>
      </div>`;
  }

  return `
    <div class="diag-section ml">
      <div class="diag-section-hd">
        <div class="diag-section-ico" style="background:linear-gradient(135deg,#8B5CF6,#6366F1)">${icoML}</div>
        <div class="diag-section-title">
          Previsões & Padrões
          <span class="diag-ml-quality ${qClass}">qualidade: ${qLbl}</span>
          <span class="diag-ml-meta">${ml.trained.modelos} modelos · ${ml.trained.pontos} pontos</span>
        </div>
      </div>
      ${forecastHtml}
      <div class="diag-ml-grid">
        ${anomHtml}
        ${clusterHtml}
        ${corrHtml}
        ${sazHtml}
      </div>
    </div>`;
}

