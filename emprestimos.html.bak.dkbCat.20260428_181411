function saveRegistroField(id, mes, field, rawVal){
  const loan = loans.find(l => l.id === id); if(!loan) return;
  // Bloqueia qualquer save em mês efetivado
  if(typeof isMesEfetivado === 'function' && isMesEfetivado(mes)){
    try { if(typeof toast === 'function') toast('🔒 Mês ' + mes + ' está travado — destrave pra editar'); } catch(e){}
    try { renderRegistro(); } catch(e){}
    return;
  }
  const n = parseBR(rawVal);
  if(!loan.registros) loan.registros = [];
  let reg = loan.registros.find(r => r.mes === mes);
  if(!reg){
    reg = {mes, parcelaEfetivada:'', saldoEfetivado:'', jurosEfetivado:'', amortEfetivada:'', ts: new Date().toISOString()};
    loan.registros.push(reg);
  }
  // Campos numéricos válidos
  const validos = ['parcelaEfetivada','saldoEfetivado','jurosEfetivado','amortEfetivada'];
  // Campos de data/string válidos (gravados como string sem conversão numérica)
  const validosString = ['dataPagamento','bancoId','saldoData'];
  if(!validos.includes(field) && !validosString.includes(field)) return;

  if(validosString.includes(field)){
    reg[field] = (rawVal || '').trim();
  } else {
    reg[field] = n !== '' ? n : '';
  }
  reg.ts = new Date().toISOString();
  // Sync com Extrato (loan.pagamentos[idx]) pra campos que afetam o pagamento
  if(['parcelaEfetivada','dataPagamento','bancoId','jurosEfetivado','amortEfetivada'].includes(field)){
    try { _loanSyncRegToExt(loan, mes, reg); } catch(e){ console.warn('sync reg->ext:', e); }
  }

  let autoFilled = false;

  // Modo AUTO: quando parcela é gravada e juros+amort estão vazios, preenche estimativa.
  if(field === 'parcelaEfetivada' && n !== '' && n > 0
     && (typeof regFillMode === 'undefined' || regFillMode === 'auto')){
    const jurosVazio = reg.jurosEfetivado === '' || reg.jurosEfetivado == null;
    const amortVazio = reg.amortEfetivada === '' || reg.amortEfetivada == null;
    if(jurosVazio && amortVazio){
      const split = _regEstimarSplit(loan, n);
      reg.jurosEfetivado = split.juros;
      reg.amortEfetivada = split.amort;
      autoFilled = true;
    }
  }

  // Modo MANUAL: quando juros OU amort são gravados, Parcela Paga é recalculada
  // automaticamente como soma dos dois (= composição da parcela).
  if((field === 'jurosEfetivado' || field === 'amortEfetivada')
     && typeof regFillMode !== 'undefined' && regFillMode === 'manual'){
    const j = parseFloat(reg.jurosEfetivado) || 0;
    const a = parseFloat(reg.amortEfetivada) || 0;
    const soma = j + a;
    if(soma > 0){
      reg.parcelaEfetivada = soma;
      autoFilled = true;  // re-render pra atualizar o input de Parcela
    }
  }

  // Saldo Devedor em modo AUTO: recalcula sempre que parcela/juros/amort mudam.
  // Fórmula: saldo = saldo_mes_anterior_registrado (ou loan.saldo) − amort_efetivada_do_mes.
  if(typeof regSaldoMode !== 'undefined' && regSaldoMode === 'auto'
     && ['parcelaEfetivada','jurosEfetivado','amortEfetivada'].includes(field)){
    const novoSaldo = _regEstimarSaldo(loan, mes);
    if(reg.saldoEfetivado !== novoSaldo){
      reg.saldoEfetivado = novoSaldo;
      autoFilled = true;
    }
  }

  saveData();

  // Se auto-filled, re-renderiza pra mostrar os valores populados
  if(autoFilled){
    try { renderRegistro(); } catch(e){}
  } else {
    const mesEl = document.getElementById('reg-mes');
    if(mesEl && mesEl.value === mes) updateRegistroKPIs(mes);
  }
  if(document.getElementById('tab-divida').classList.contains('active')) drawDivida();
}

