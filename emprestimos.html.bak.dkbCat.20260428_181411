function _anaChRender_turnover(facts, _canvas){
  const ctx = _canvas || document.getElementById('ana-chart-turnover');
  if(!ctx) return;
  const _key = (ctx.id || 'turnover');
  _anaDestroyChart(_key);
  const yms = _anaPeriodYms();
  const labels = _anaPeriodLabels();
  // Coleta arrays absolutos de entradas, saídas e headcount por mês
  const entradas = new Array(yms.length).fill(0);
  const saidas   = new Array(yms.length).fill(0);
  const headcount= new Array(yms.length).fill(0);
  if(typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.people)){
    for(const p of pessoas.people){
      if(p.sim) continue;
      let prev = false;
      yms.forEach((ym, i) => {
        const has = !!((p.salarios||{})[ym] && parseFloat(p.salarios[ym]) > 0);
        if(has) headcount[i]++;
        if(has && !prev) entradas[i]++;
        if(!has && prev) saidas[i]++;
        prev = has;
      });
    }
  }
  // Turnover % = saídas / headcount × 100 (se headcount=0 mas houve saída, usa headcount anterior)
  const turnoverPct = yms.map((_, i) => {
    const base = headcount[i] || (i > 0 ? headcount[i-1] : 0);
    return base > 0 ? (saidas[i] / base * 100) : 0;
  });
  // Hire rate % = entradas / headcount × 100
  const hirePct = yms.map((_, i) => {
    const base = headcount[i] || 1;
    return base > 0 ? (entradas[i] / base * 100) : 0;
  });
  _anaChartInstances[_key] = new Chart(ctx, {
    type:'line', data:{ labels, datasets:[
      { label:'Turnover % (saídas)', data:turnoverPct,
        borderColor:ANA_CH_COLOR.warn, backgroundColor:'rgba(185,28,28,.12)',
        tension:.3, borderWidth:2, fill:true, pointRadius:3,
        pointBackgroundColor:ANA_CH_COLOR.warn },
      { label:'Hire % (entradas)', data:hirePct,
        borderColor:ANA_CH_COLOR.good, backgroundColor:'transparent',
        tension:.3, borderWidth:2, borderDash:[5,3], pointRadius:3,
        pointBackgroundColor:ANA_CH_COLOR.good }
    ]},
    options:{ ...ANA_CH_DEFAULTS,
      plugins:{ ...ANA_CH_DEFAULTS.plugins,
        tooltip:{ callbacks:{ label:c => {
          const i = c.dataIndex;
          const isSaida = c.dataset.label.startsWith('Turnover');
          const abs = isSaida ? saidas[i] : entradas[i];
          return ' ' + c.dataset.label + ': ' + c.raw.toFixed(1) + '% ('
               + abs + (isSaida ? ' saída' : ' contratação') + (abs===1?'':'s')
               + ' / ' + headcount[i] + ' HC)';
        } } } },
      scales:{ y:{ ticks:{ callback:v => v.toFixed(0)+'%', font:{size:10} },
                   grid:{ color:'#F3F4F6' }, beginAtZero:true },
               x:{ ticks:{ font:{size:10}, maxRotation:0 }, grid:{ display:false } } } }
  });
}
function _anaChRender_churn(facts, _canvas){
  const ctx = _canvas || document.getElementById('ana-chart-churn');
  if(!ctx) return;
  const _key = (ctx.id || 'churn');
  _anaDestroyChart(_key);
  const yms = _anaPeriodYms();
  const labels = _anaPeriodLabels();
  // Set de clientes ativos por mês
  const setByYm = yms.map(ym => new Set(facts.filter(f => f.modulo==='receita' && f.ym === ym).map(f => f.entidade)));
  const baseAnt  = setByYm.map((s, i) => i === 0 ? 0 : setByYm[i-1].size);
  const perdidos = setByYm.map((s, i) => i === 0 ? 0 : Array.from(setByYm[i-1]).filter(c => !s.has(c)).length);
  const novos    = setByYm.map((s, i) => i === 0 ? 0 : Array.from(s).filter(c => !setByYm[i-1].has(c)).length);
  // Churn % = perdidos / base do mês anterior × 100
  const churnPct = perdidos.map((p, i) => baseAnt[i] > 0 ? (p / baseAnt[i] * 100) : 0);
  // Growth % (novos clientes) = novos / base anterior × 100
  const growthPct = novos.map((n, i) => baseAnt[i] > 0 ? (n / baseAnt[i] * 100) : 0);
  _anaChartInstances[_key] = new Chart(ctx, {
    type:'line', data:{ labels, datasets:[
      { label:'Churn % (perdidos)', data:churnPct,
        borderColor:ANA_CH_COLOR.warn, backgroundColor:'rgba(185,28,28,.12)',
        tension:.3, borderWidth:2, fill:true, pointRadius:3,
        pointBackgroundColor:ANA_CH_COLOR.warn },
      { label:'Growth % (novos)', data:growthPct,
        borderColor:ANA_CH_COLOR.good, backgroundColor:'transparent',
        tension:.3, borderWidth:2, borderDash:[5,3], pointRadius:3,
        pointBackgroundColor:ANA_CH_COLOR.good }
    ]},
    options:{ ...ANA_CH_DEFAULTS,
      plugins:{ ...ANA_CH_DEFAULTS.plugins,
        tooltip:{ callbacks:{ label:c => {
          const i = c.dataIndex;
          const isChurn = c.dataset.label.startsWith('Churn');
          const abs = isChurn ? perdidos[i] : novos[i];
          return ' ' + c.dataset.label + ': ' + c.raw.toFixed(1) + '% ('
               + abs + (isChurn ? ' perdido' : ' novo') + (abs===1?'':'s')
               + ' / base ' + baseAnt[i] + ')';
        } } } },
      scales:{ y:{ ticks:{ callback:v => v.toFixed(0)+'%', font:{size:10} },
                   grid:{ color:'#F3F4F6' }, beginAtZero:true },
               x:{ ticks:{ font:{size:10}, maxRotation:0 }, grid:{ display:false } } } }
  });
}
