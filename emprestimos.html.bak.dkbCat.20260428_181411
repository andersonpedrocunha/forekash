function mrcashDetalharProjecao(ml, snap){
  const fc = ml && ml.forecast && ml.forecast.receita;
  if(!fc) return 'Ainda não tenho projeção suficiente — preciso de pelo menos 3 meses fechados de dados consistentes.';
  let msg = `<b>Projeção de receita — próximos 6 meses, mês a mês:</b>`;
  // Tabelinha visual com label, valor, IC
  const labels = fc.labels || [];
  const start  = fc.serie.length;
  msg += `<table style="margin:8px 0;border-collapse:collapse;font-size:13px;width:100%"><thead><tr style="background:rgba(139,92,246,.08);color:#5B21B6"><th style="text-align:left;padding:5px 8px">Mês</th><th style="text-align:right;padding:5px 8px">Projeção</th><th style="text-align:right;padding:5px 8px">Faixa (1,5σ)</th></tr></thead><tbody>`;
  for(let i=0; i<fc.forecast.length; i++){
    const lbl = labels[start + i] || `m+${i+1}`;
    const v   = fc.forecast[i];
    const ci  = fc.ci[i] || {low: v*0.85, high: v*1.15};
    msg += `<tr><td style="padding:4px 8px;border-top:1px solid rgba(0,0,0,.06)"><b>${esc(lbl)}</b></td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${fmtBRL(v)}</td><td style="padding:4px 8px;text-align:right;color:var(--txl);border-top:1px solid rgba(0,0,0,.06)">${fmtBRL(Math.max(0,ci.low))}–${fmtBRL(ci.high)}</td></tr>`;
  }
  msg += `</tbody></table>`;
  // Resumos
  const soma6 = fc.forecast.reduce((s,v)=>s+v,0);
  const media6 = soma6 / fc.forecast.length;
  const last3 = fc.serie.slice(-3).reduce((s,v)=>s+v,0)/Math.min(3, fc.serie.length);
  const next3 = fc.forecast.slice(0,3).reduce((s,v)=>s+v,0)/3;
  const delta = last3 > 0 ? ((next3-last3)/last3)*100 : 0;
  msg += `<b>Resumo:</b> próximos 6 meses somam <b>${fmtBRL(soma6)}</b> (média ${fmtBRL(media6)}/mês). `;
  msg += `Próximo trimestre (${fmtBRL(next3)}/mês) vs último realizado (${fmtBRL(last3)}/mês): <b>${delta>=0?'+':''}${delta.toFixed(1)}%</b>.`;
  msg += `<br><br><b>Confiabilidade:</b> R²=${fc.r2.toFixed(2)} (ajuste ${fc.r2>0.7?'forte':fc.r2>0.4?'moderado':'fraco'}), tendência ${fc.slope>0?'+':''}${fmtBRL(fc.slope)}/mês.`;
  msg += `<br><small style="color:var(--txl)">A faixa (low–high) cobre 1,5 desvios-padrão do erro histórico do modelo. Trate o número central como cenário base e a faixa como pessimista/otimista.</small>`;
  msg += `<br><br><small style="opacity:.75">Quer que eu compare a projeção com o realizado e o ano anterior? Responda <b>sim</b>.</small>`;
  mrcashContext.pending = {
    label: 'comparar projeção vs realizado vs ano anterior',
    onYes: () => mrcashReceita(snap, ind, ml)
  };
  return msg;
}

function mrcashWhatIf(qn, whatIfMatch, snap, ind){
  // Detecta o que cortar e quanto
  let pct = 10;
  if(whatIfMatch){ pct = parseFloat(whatIfMatch[1].replace(',','.')) || 10; }
  // Detecta a categoria
  const cat = /(estrutur|despes|custo\s+fix)/.test(qn) ? 'estrutura'
            : /(folha|pessoa|salari|equipe)/.test(qn) ? 'folha'
            : /(imposto|tributari)/.test(qn) ? 'impostos'
            : /(emprestim|divida|parcela)/.test(qn) ? 'emprestimos'
            : /(receita|faturament|venda)/.test(qn) ? 'receita'
            : 'estrutura';
  const aumentar = /(aumentar|subir)/.test(qn);
  const sinal = aumentar ? 1 : -1;
  // Valores base
  const base = {
    estrutura: snap.estrutura.totalAno || 0,
    folha: snap.pessoas.folhaAno || 0,
    impostos: snap.impostos.totalCorrente || 0,
    emprestimos: snap.emprestimos.totalAno || ((snap.emprestimos.parcelaMensal||0) * 12),
    receita: snap.receita.anual || 0
  };
  const baseVal = base[cat] || 0;
  if(baseVal <= 0) return `Não tenho valor cadastrado para <b>${cat}</b> — não consegui simular. Tente outro cenário.`;
  const delta = baseVal * (pct/100) * sinal;
  // Recalcula custos e margem
  const recAtual = snap.receita.anual || 0;
  const custosAtual = snap.pessoas.folhaAno + snap.estrutura.totalAno + snap.impostos.totalCorrente + (snap.emprestimos.totalAno || (snap.emprestimos.parcelaMensal||0)*12);
  let recNovo = recAtual, custosNovo = custosAtual;
  if(cat === 'receita'){ recNovo = recAtual + delta; }
  else                  { custosNovo = custosAtual + delta; }
  const burnAntes = (custosAtual - recAtual) / 12;
  const burnDepois = (custosNovo - recNovo) / 12;
  const ebitAntes = recAtual - custosAtual;
  const ebitDepois = recNovo - custosNovo;
  const mgAntes = recAtual > 0 ? (ebitAntes/recAtual)*100 : 0;
  const mgDepois = recNovo > 0 ? (ebitDepois/recNovo)*100 : 0;
  const saldo = snap.dispo.saldoAtual || 0;
  const runwayAntes = burnAntes > 0 && saldo > 0 ? saldo/burnAntes : null;
  const runwayDepois = burnDepois > 0 && saldo > 0 ? saldo/burnDepois : (burnDepois <= 0 ? Infinity : null);

  const acao = aumentar ? `aumentar ${pct.toFixed(0)}% em ${cat}` : `cortar ${pct.toFixed(0)}% de ${cat}`;
  let msg = `<b>Simulação:</b> e se você ${acao}?<br><br>`;
  msg += `<b>${cat.charAt(0).toUpperCase()+cat.slice(1)}</b> mudaria de <b>${fmtBRL(baseVal)}/ano</b> para <b>${fmtBRL(baseVal + delta)}/ano</b> (variação ${sinal>0?'+':''}${fmtBRL(delta)}/ano = ${sinal>0?'+':''}${fmtBRL(delta/12)}/mês).<br><br>`;
  msg += `<b>Impacto consolidado:</b><table style="margin:6px 0;border-collapse:collapse;font-size:13px;width:100%"><thead><tr style="background:rgba(0,0,0,.04)"><th style="text-align:left;padding:4px 8px">Métrica</th><th style="text-align:right;padding:4px 8px">Antes</th><th style="text-align:right;padding:4px 8px">Depois</th></tr></thead><tbody>`;
  msg += `<tr><td style="padding:3px 8px;border-top:1px solid rgba(0,0,0,.06)">EBIT anual</td><td style="padding:3px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${fmtBRL(ebitAntes)}</td><td style="padding:3px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)"><b>${fmtBRL(ebitDepois)}</b></td></tr>`;
  msg += `<tr><td style="padding:3px 8px;border-top:1px solid rgba(0,0,0,.06)">Margem operacional</td><td style="padding:3px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${mgAntes.toFixed(1)}%</td><td style="padding:3px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)"><b>${mgDepois.toFixed(1)}%</b></td></tr>`;
  msg += `<tr><td style="padding:3px 8px;border-top:1px solid rgba(0,0,0,.06)">Burn mensal</td><td style="padding:3px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${fmtBRL(burnAntes)}</td><td style="padding:3px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)"><b>${fmtBRL(burnDepois)}</b></td></tr>`;
  if(runwayAntes != null && isFinite(runwayAntes) && runwayDepois != null){
    const runDepStr = isFinite(runwayDepois) ? runwayDepois.toFixed(1)+' meses' : 'gera caixa ✓';
    msg += `<tr><td style="padding:3px 8px;border-top:1px solid rgba(0,0,0,.06)">Runway</td><td style="padding:3px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${runwayAntes.toFixed(1)} meses</td><td style="padding:3px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)"><b>${runDepStr}</b></td></tr>`;
  }
  msg += `</tbody></table>`;
  // Conselho contextual
  if(cat !== 'receita' && !aumentar){
    msg += `<br><b>Onde encontrar esse corte:</b> revise as 3 maiores linhas de ${cat} — costumam ter renegociação possível (assinaturas duplicadas, ferramentas pouco usadas, fornecedores com proposta vencida). Pequenos cortes acumulam.`;
  }
  if(burnDepois <= 0 && burnAntes > 0){
    msg += `<br><br>🎯 <b>Esse corte zera o burn</b> — operação passaria a se autossustentar. Vale prestar atenção em que dinâmicas operacionais isso compromete.`;
  }
  msg += `<br><br><small style="opacity:.75">Quer simular outro cenário? É só falar (ex.: <em>"e se eu cortar 5% da folha?"</em>) ou pedir <b>mais</b> que eu sugiro alguns.</small>`;
  mrcashContext.pending = {
    label: 'sugerir outras simulações',
    onContinue: () => `Sugestões de cenários para simular:<ul style="margin:6px 0 0 18px"><li>"E se eu cortar 5% da folha?" (impacto rápido)</li><li>"E se eu aumentar 10% a receita?" (validação otimista)</li><li>"E se eu reduzir 20% dos impostos?" (mudança de regime)</li><li>"E se eu cortar 15% da estrutura?" (cenário stress)</li></ul>É só copiar/colar a pergunta.`
  };
  return msg;
}

function mrcashDivida(snap, ind){
  const e = snap.emprestimos || {};
  if(!e.qtd || e.qtd === 0) return `Sem empréstimos ativos — você não tem alavancagem financeira no momento. A operação é financiada por capital próprio e geração de caixa.`;
  let msg = `<b>${e.qtd}</b> empréstimo${e.qtd===1?'':'s'} ativo${e.qtd===1?'':'s'}:<ul>`;
  msg += `<li>Saldo devedor consolidado: <b>${fmtBRL(e.saldo)}</b></li>`;
  msg += `<li>Parcela atual (mês corrente): <b>${fmtBRL(e.parcelaMensal)}/mês</b></li>`;
  if(ind.divParcelaProjMes != null && Math.abs(ind.divParcelaProjMes - e.parcelaMensal) > e.parcelaMensal * 0.03){
    const dir = ind.divParcelaProjMes < e.parcelaMensal ? 'cai' : 'sobe';
    msg += `<li>Parcela média dos próximos meses: <b>${fmtBRL(ind.divParcelaProjMes)}/mês</b> — ${dir} ao longo do ano${ind.divParcelaProjMes < e.parcelaMensal ? ' (típico do método SAC: amortização constante reduz juros progressivamente)' : ''}</li>`;
  }
  msg += `<li>Total ANUAL real (12 meses, considerando variação): <b>${fmtBRL(ind.divTotalAno||0)}</b> = ${(ind.divPctReceitaAno||0).toFixed(0)}% da receita anual</li>`;
  if(ind.divSaldoVsReceita != null) msg += `<li>Alavancagem: saldo equivale a <b>${ind.divSaldoVsReceita.toFixed(0)}%</b> da receita anual</li>`;
  if(ind.divMesesQuitar != null) msg += `<li>Meses para quitar (sem juros futuros, parcela média): ~${ind.divMesesQuitar.toFixed(0)}</li>`;
  msg += `</ul>`;
  if(ind.dscrReal != null && isFinite(ind.dscrReal)){
    const lbl = ind.dscrReal >= 2.5 ? '✅ forte' : (ind.dscrReal >= 1.5 ? '👍 adequada' : (ind.dscrReal >= 1 ? '⚠️ apertada' : '🚨 insuficiente'));
    msg += `<b>DSCR realizado</b> = EBITDA realizado ÷ parcela = <b>${ind.dscrReal.toFixed(2)}×</b> (${lbl}).`;
    if(ind.dscrProj != null && isFinite(ind.dscrProj)){
      const dir = ind.dscrProj >= ind.dscrReal ? 'mantém-se ou melhora' : 'piora';
      msg += `<br>DSCR projetado: <b>${ind.dscrProj.toFixed(2)}×</b> (cenário ${dir} vs realizado).`;
    }
    msg += `<br><br><small>Referências: DSCR ≥ 2× saudável · 1,5–2× ok · 1–1,5× atenção · <1× pagando dívida com caixa, não com geração.</small>`;
  }
  if(ind.dscrReal != null && ind.dscrReal < 1.5){
    msg += `<br><br><b>Recomendações:</b> renegociar prazo (alongar reduz parcela), buscar carência se previsto em contrato, e antes de contratar nova linha verificar se DSCR projetado fica ≥ 1,5×.`;
  }
  return msg;
}

function mrcashAlocacao(snap, ind, ml){
  const saldo = snap.dispo && snap.dispo.saldoAtual || 0;
  const e = snap.emprestimos || {};
  const burn = ind.burnMes || 0;
  const ebitMes = (snap.receita.anual - (snap.pessoas.folhaAno + snap.estrutura.totalAno + snap.impostos.totalCorrente))/12;
  // Reserva técnica: 6 meses de burn (ou 6× custo fixo médio se burn negativo)
  const custoMes = (snap.pessoas.folhaAno + snap.estrutura.totalAno + snap.impostos.totalCorrente)/12;
  const reservaIdeal = Math.max(0, custoMes * 6);
  const sobra = Math.max(0, saldo - reservaIdeal);

  let msg = `<b>Sugestão de alocação do caixa excedente</b><br><br>`;
  msg += `Saldo atual: <b>${fmtBRL(saldo)}</b>. Reserva técnica recomendada (6 meses de custo fixo, <b>${fmtBRL(custoMes)}/mês</b>): <b>${fmtBRL(reservaIdeal)}</b>. Sobra livre estimada: <b>${fmtBRL(sobra)}</b>.<br><br>`;

  msg += `<b>Prioridades, em ordem:</b><ol style="margin:8px 0 0 20px">`;

  // 1. Reserva técnica primeiro (se nao houver)
  if(saldo < reservaIdeal){
    const falta = reservaIdeal - saldo;
    msg += `<li><b>Completar reserva técnica</b> — faltam <b>${fmtBRL(falta)}</b> para 6 meses de cobertura. Antes de qualquer outra alocação, fortalecer caixa é prioridade. <em>Risco zero, retorno = paz de espírito.</em></li>`;
  } else {
    msg += `<li>✓ Reserva técnica de 6 meses já está coberta (<b>${fmtBRL(reservaIdeal)}</b>).</li>`;
  }

  // 2. Amortizar divida cara (DSCR baixo ou alavancagem alta)
  if(e.qtd > 0 && e.saldo > 0){
    if(ind.dscrReal != null && ind.dscrReal < 1.5){
      msg += `<li><b>Amortizar dívida prioritariamente</b> — DSCR realizado de <b>${ind.dscrReal.toFixed(2)}×</b> está apertado. Reduzir saldo libera fôlego operacional e diminui custo financeiro mensal. Consulte o banco sobre amortização extraordinária com redução de prazo (mantém parcela) ou de parcela (mantém prazo) — escolha conforme objetivo.</li>`;
    } else if(ind.divSaldoVsReceita != null && ind.divSaldoVsReceita > 60){
      msg += `<li><b>Amortizar parcialmente a dívida</b> — saldo (${fmtBRL(e.saldo)}) representa ${ind.divSaldoVsReceita.toFixed(0)}% da receita anual. Reduzir alavancagem é estrategicamente bom mesmo com DSCR ok.</li>`;
    } else {
      msg += `<li><b>Manter ou amortizar dívida moderadamente</b> — situação confortável (DSCR ${(ind.dscrReal||0).toFixed(2)}×, alavancagem ${(ind.divSaldoVsReceita||0).toFixed(0)}%). Avalie custo da dívida vs rentabilidade de aplicação financeira: se taxa do empréstimo > rentabilidade líquida do CDI, amortize.</li>`;
    }
  }

  // 3. Investimento financeiro (caixa que precisa render mas ficar liquido)
  if(sobra > 0){
    msg += `<li><b>Aplicação financeira líquida</b> para a parte que não vai amortizar — CDB com liquidez diária (≥100% CDI), Tesouro Selic, fundos DI taxa baixa. Mantenha pelo menos 30 dias de operação em conta sem render (cashout imediato).</li>`;
  }

  // 4. Reinvestimento operacional
  if(ind.recYoY != null && ind.recYoY > 5){
    msg += `<li><b>Reinvestir em crescimento</b> — receita crescendo ${ind.recYoY.toFixed(0)}% YoY justifica acelerar o que já funciona: marketing/vendas no canal de melhor ROAS, contratação chave (com hiring discipline), ou produtos novos. Aloque com tese e meta de retorno em 12m.</li>`;
  } else if(ind.recYoY != null && ind.recYoY < 0){
    msg += `<li><b>Não acelere com a empresa em queda</b> — receita ${ind.recYoY.toFixed(0)}% YoY. Investir em crescimento agora costuma queimar caixa sem retorno proporcional. Resolva o problema comercial antes de expandir.</li>`;
  } else {
    msg += `<li><b>Reinvestimento operacional consciente</b> — em ROAS comprovado, automação que reduz custo recorrente, ou capacitação. Evite gastos vaidosos (escritório, eventos não-comerciais).</li>`;
  }

  // 5. Distribuir lucro
  if(ebitMes > 0 && saldo > reservaIdeal*1.5){
    msg += `<li><b>Distribuição de lucros</b> aos sócios pode fazer sentido se a operação está consolidada e há sobra confortável. Avalie o custo tributário (lucros distribuídos são isentos de IRPF na PJ, mas saídas grandes podem chamar atenção fiscal) e formalize via contábil.</li>`;
  }
  msg += `</ol>`;

  msg += `<br><small style="color:var(--txl)">Quer que eu detalhe alguma dessas opções? Pergunte algo como "como amortizar a dívida?" ou "que tipo de aplicação?".</small>`;

  // Encadeia: oferece detalhar
  mrcashContext.pending = {
    label: 'detalhar uma das opções',
    onContinue: () => `Me diga qual: <b>amortizar dívida</b>, <b>aplicação financeira</b>, <b>reinvestir em crescimento</b> ou <b>distribuir lucros</b>?`
  };
  return msg;
}

function mrcashTaxa(snap, ind){
  // Le taxas direto de loans (mesma fonte que aba Empréstimos)
  let loanArr = [];
  try {
    loanArr = (typeof loans !== 'undefined' && Array.isArray(loans)) ? loans
      : (window.emprestimos && Array.isArray(window.emprestimos.loans)) ? window.emprestimos.loans
      : (window.loans && Array.isArray(window.loans)) ? window.loans : [];
  } catch(_){}
  const ativos = loanArr.filter(l => l && (parseFloat(l.saldo)||parseFloat(l.parcelaVal)||0) > 0);
  if(!ativos.length){
    return `Sem empréstimos ativos com saldo. <br><br>Sem dívida, sem taxa — situação confortável.`;
  }

  // Helper: converter taxa mensal para anual (juros compostos)
  const toAnual = (mes) => (Math.pow(1 + mes/100, 12) - 1) * 100;

  // Tabela por contrato + média ponderada por saldo
  let totalSaldo = 0, somaTaxaXSaldo = 0;
  let minTax = Infinity, maxTax = -Infinity;
  const linhas = [];
  for(const l of ativos){
    const tx = parseFloat(l.taxa) || 0;
    const saldo = parseFloat(l.saldo) || 0;
    const parc  = parseFloat(l.parcelaVal) || 0;
    const nome = (l.descricao || l.banco || ('Contrato #'+(l.id||'?'))).toString().slice(0,40);
    if(tx > 0){
      if(saldo > 0){ totalSaldo += saldo; somaTaxaXSaldo += saldo*tx; }
      if(tx < minTax) minTax = tx;
      if(tx > maxTax) maxTax = tx;
    }
    linhas.push({ nome, tx, saldo, parc, tipo: (l.tipo||'') });
  }
  const taxaMediaPond = totalSaldo > 0 ? (somaTaxaXSaldo / totalSaldo) : null;

  let msg = `<b>Taxas de juros dos empréstimos ativos:</b>`;
  msg += `<table style="margin:8px 0;border-collapse:collapse;font-size:13px;width:100%"><thead><tr style="background:rgba(0,0,0,.04)"><th style="text-align:left;padding:5px 8px">Contrato</th><th style="text-align:right;padding:5px 8px">Tipo</th><th style="text-align:right;padding:5px 8px">Saldo</th><th style="text-align:right;padding:5px 8px">a.m.</th><th style="text-align:right;padding:5px 8px">a.a.</th></tr></thead><tbody>`;
  for(const r of linhas){
    const am = r.tx;
    const aa = am > 0 ? toAnual(am) : 0;
    msg += `<tr><td style="padding:4px 8px;border-top:1px solid rgba(0,0,0,.06)"><b>${esc(r.nome)}</b></td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${esc(r.tipo||'—')}</td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${fmtBRL(r.saldo)}</td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06);color:${am>2?'#FCA5A5':am>1?'#FDE68A':'#86EFAC'}"><b>${am.toFixed(2)}%</b></td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)"><b>${aa.toFixed(1)}%</b></td></tr>`;
  }
  msg += `</tbody></table>`;

  if(taxaMediaPond != null){
    const aaPond = toAnual(taxaMediaPond);
    msg += `<b>Taxa média ponderada</b> (pelo saldo devedor): <b>${taxaMediaPond.toFixed(2)}% a.m.</b> ≈ <b>${aaPond.toFixed(1)}% a.a.</b>`;
    if(ativos.length > 1 && isFinite(minTax) && isFinite(maxTax) && maxTax > minTax){
      msg += `<br>Variação entre contratos: de <b>${minTax.toFixed(2)}%</b> a <b>${maxTax.toFixed(2)}%</b> ao mês.`;
    }
  }

  // Comparativo com referencia de mercado (estimativa SELIC/CDI ~ 11-12% a.a. em 2026)
  const SELIC_REF_AA = 11.0; // referencia aproximada
  const CDI_REF_AA   = 10.9;
  if(taxaMediaPond != null){
    const aaPond = toAnual(taxaMediaPond);
    msg += `<br><br><b>Comparativo com mercado:</b>`;
    if(aaPond > SELIC_REF_AA * 3){
      msg += ` Sua taxa média (${aaPond.toFixed(1)}% a.a.) está <b>muito acima</b> do CDI/SELIC de referência (~${CDI_REF_AA.toFixed(1)}% a.a.). Faz sentido buscar renegociação ou trocar por linha mais barata.`;
    } else if(aaPond > SELIC_REF_AA * 1.8){
      msg += ` Sua taxa média (${aaPond.toFixed(1)}% a.a.) está em <b>spread relevante</b> sobre o CDI/SELIC (~${CDI_REF_AA.toFixed(1)}% a.a.). Vale comparar com outras linhas e bancos.`;
    } else if(aaPond > SELIC_REF_AA * 1.2){
      msg += ` Taxa média (${aaPond.toFixed(1)}% a.a.) em spread <b>razoável</b> sobre o CDI (~${CDI_REF_AA.toFixed(1)}% a.a.) — dentro do esperado para crédito empresarial.`;
    } else {
      msg += ` Taxa média (${aaPond.toFixed(1)}% a.a.) está <b>próxima</b> do CDI/SELIC (~${CDI_REF_AA.toFixed(1)}% a.a.) — ótima condição.`;
    }
    msg += ` <small style="opacity:.7">(referências de mercado são aproximadas; cheque CDI/SELIC do dia para comparar com precisão)</small>`;
  }

  // Custo financeiro do ano
  if(snap.emprestimos.totalJurosAno > 0){
    msg += `<br><br><b>Custo financeiro estimado em ${snap.curYear}:</b> ${fmtBRL(snap.emprestimos.totalJurosAno)} em juros (separado da amortização).`;
  }

  // Follow-up: se taxa alta, oferece sugerir renegociacao
  if(taxaMediaPond != null && toAnual(taxaMediaPond) > SELIC_REF_AA * 1.8){
    msg += `<br><br><small style="opacity:.75">Quer dicas de como negociar a taxa com o banco? Responda <b>sim</b>.</small>`;
    mrcashContext.pending = {
      label: 'dicas para renegociar taxa',
      onYes: () => `<b>Como negociar redução de taxa com o banco:</b><ol style="margin:8px 0 0 20px"><li><b>Cota o mercado primeiro</b> — peça propostas formais a 2-3 outros bancos com sua relação. Use como referência na conversa.</li><li><b>Mostre o histórico de pagamento em dia</b> — bom pagador é o argumento mais forte. DSCR atual ≥ 1,5× ajuda.</li><li><b>Negocie o pacote</b>, não só a taxa — folha de pagamento, recebíveis, seguro: cada serviço adicional vira moeda de troca.</li><li><b>Ofereça garantias adicionais</b> se conseguir — recebíveis cedidos, FGTS, alienação fiduciária reduzem o risco percebido e a taxa.</li><li><b>Não tenha pressa</b> — se houver urgência, o banco pega vantagem. Negocie antes de precisar.</li><li><b>Considere portabilidade de crédito</b> — Lei 10.820 permite levar a dívida pra outro banco com taxa menor; o banco atual costuma cobrir pra não perder o cliente.</li></ol>`
    };
  }
  return msg;
}

function mrcashSaldo(snap, ind){
  // Le contas de dispo direto (mesma fonte que aba Disponibilidades)
  let dispoData = null;
  try {
    dispoData = (typeof dispo !== 'undefined' && dispo) ? dispo
              : (window.dispo) ? window.dispo : null;
  } catch(_){}
  const saldoTotal = snap.dispo && snap.dispo.saldoAtual || 0;
  const totalContas = snap.dispo && snap.dispo.contas || 0;
  const ativas = snap.dispo && snap.dispo.contasAtivas || 0;

  if(saldoTotal === 0 && totalContas === 0){
    return `Nenhuma conta cadastrada em <b>Disponibilidades</b>. <br><br>Pra eu mostrar saldo, é só você cadastrar suas contas e os saldos por mês — depois rodar o diagnóstico de novo.`;
  }

  let msg = `<b>Saldo atual em contas ativas:</b> <b>${fmtBRL(saldoTotal)}</b>`;
  if(ativas > 0) msg += ` em <b>${ativas} ${ativas===1?'conta ativa':'contas ativas'}</b>`;
  if(totalContas > ativas && totalContas > 0) msg += ` (${totalContas - ativas} inativa${totalContas-ativas===1?'':'s'})`;
  msg += '.';

  // Detalhamento por conta (se conseguir ler dispo direto)
  if(dispoData && Array.isArray(dispoData.contas) && dispoData.contas.length > 0){
    const linhas = [];
    const curMIdx = snap.curMIdx;
    const curYear = snap.curYear;
    for(const c of dispoData.contas){
      if(c.ativo === false) continue;
      const saldos = c.saldos || {};
      let lastV = 0, lastK = '';
      // Procura o ultimo saldo ate o mes atual
      for(let i=curMIdx;i>=0;i--){
        const k = curYear+'-'+String(i+1).padStart(2,'0');
        const v = parseFloat(saldos[k]);
        if(isFinite(v) && v !== 0){ lastV = v; lastK = k; break; }
      }
      if(lastV === 0){
        const keys = Object.keys(saldos).sort().reverse();
        for(const k of keys){
          const v = parseFloat(saldos[k]);
          if(isFinite(v) && v !== 0){ lastV = v; lastK = k; break; }
        }
      }
      if(lastV !== 0){
        const nome = (c.nome || c.banco || 'Conta').toString().slice(0,40);
        const tipo = (c.tipo || '').toString();
        linhas.push({ nome, tipo, saldo: lastV, ref: lastK });
      }
    }
    if(linhas.length > 0){
      linhas.sort((a,b) => b.saldo - a.saldo);
      msg += `<br><br><b>Detalhamento:</b>`;
      msg += `<table style="margin:6px 0;border-collapse:collapse;font-size:13px;width:100%"><thead><tr style="background:rgba(0,0,0,.04)"><th style="text-align:left;padding:5px 8px">Conta</th><th style="text-align:right;padding:5px 8px">Tipo</th><th style="text-align:right;padding:5px 8px">Saldo</th><th style="text-align:right;padding:5px 8px">Ref.</th></tr></thead><tbody>`;
      for(const l of linhas){
        const refLbl = l.ref ? l.ref.split('-').reverse().join('/') : '—';
        msg += `<tr><td style="padding:4px 8px;border-top:1px solid rgba(0,0,0,.06)"><b>${esc(l.nome)}</b></td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${esc(l.tipo||'—')}</td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)"><b>${fmtBRL(l.saldo)}</b></td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06);color:var(--txl);font-size:.7rem">${esc(refLbl)}</td></tr>`;
      }
      msg += `</tbody></table>`;
    }
  }

  // Contexto: runway e burn
  if(ind.runwayMeses != null && isFinite(ind.runwayMeses) && ind.burnMes > 0){
    msg += `<br><b>O que isso significa:</b> no ritmo de queima atual (<b>${fmtBRL(ind.burnMes)}/mês</b>), esse caixa cobre <b>${ind.runwayMeses.toFixed(1)} meses</b> de operação.`;
  } else if(ind.burnMes != null && ind.burnMes <= 0){
    msg += `<br><b>O que isso significa:</b> a operação está gerando caixa (burn negativo de ${fmtBRL(Math.abs(ind.burnMes))}/mês), então esse saldo cresce — não diminui.`;
  }

  // Recebiveis pendentes
  const recebiveis = (snap.receita.totalEmAberto || 0) + (snap.receita.totalAtrasado || 0);
  if(recebiveis > 0){
    msg += `<br><br><small style="color:var(--txl)">+ <b>${fmtBRL(recebiveis)}</b> em recebíveis pendentes (em aberto + atrasado) que reforçam a liquidez quando entrarem.</small>`;
  }

  return msg;
}

function mrcashFolhaAtual(snap, ind, ml){
  const folhaMes = snap.pessoas.folhaMes || 0;
  const folhaAno = snap.pessoas.folhaAno || 0;
  const headcount = snap.pessoas.headcount || 0;
  const custoMedio = snap.pessoas.custoMedio || 0;
  const _MES_ABR = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  const mesLbl = _MES_ABR[snap.curMIdx] + '/' + String(snap.curYear).slice(2);

  if(headcount === 0 && folhaAno === 0){
    return `Nenhum colaborador ativo em <b>Pessoas</b>. <br><br>Sem folha, sem dado pra mostrar — é só cadastrar a equipe lá.`;
  }

  let msg = `<b>Folha do mês corrente (${mesLbl}):</b> <b>${fmtBRL(folhaMes)}</b>`;
  if(headcount > 0) msg += ` para <b>${headcount} ${headcount===1?'pessoa ativa':'pessoas ativas'}</b>`;
  msg += '.';

  if(custoMedio > 0){
    msg += `<br>Custo médio por pessoa: <b>${fmtBRL(custoMedio)}/mês</b>.`;
  }

  // Contexto anual
  if(folhaAno > 0){
    msg += `<br><br><b>Folha anual prevista (12 meses):</b> ${fmtBRL(folhaAno)}.`;
    if(snap.pessoas.realizadoAno != null && (snap.nClosed||0) > 0){
      msg += ` Dos quais <b>${fmtBRL(snap.pessoas.realizadoAno)}</b> já realizado (${snap.nClosed} ${snap.nClosed===1?'mês fechado':'meses fechados'}).`;
    }
  }

  // % da receita
  if(ind.pctFolha != null){
    const cls = ind.pctFolha < 35 ? 'sob controle' : (ind.pctFolha < 50 ? 'dentro do padrão' : (ind.pctFolha < 65 ? 'acima do saudável' : 'muito pesado'));
    msg += `<br><br><b>Folha / Receita anual:</b> ${ind.pctFolha.toFixed(1)}% — ${cls}.`;
  }
  if(ind.pctFolhaReal != null){
    const dif = ind.pctFolhaReal - (ind.pctFolha||0);
    if(Math.abs(dif) > 3){
      msg += ` <small>(realizado: ${ind.pctFolhaReal.toFixed(1)}% — diferença reflete oscilações de receita ou ajustes recentes na folha)</small>`;
    }
  }

  // Tendencia ML
  if(ml && ml.forecast && ml.forecast.folha){
    const f = ml.forecast.folha;
    const last = f.serie[f.serie.length-1] || 0;
    const next = f.forecast[0] || last;
    if(last > 0){
      const delta = ((next-last)/last)*100;
      if(Math.abs(delta) > 2){
        const dir = delta > 0 ? 'sobe' : 'cai';
        msg += `<br><b>Projeção próximo mês:</b> ${fmtBRL(next)} — ${dir} ${Math.abs(delta).toFixed(1)}% vs último mês fechado.`;
      }
    }
  }

  return msg;
}

function mrcashHeadcount(snap, ind){
  const hc = snap.pessoas.headcount || 0;
  if(hc === 0){
    return `Nenhum colaborador ativo cadastrado.`;
  }
  let msg = `<b>${hc} ${hc===1?'pessoa ativa':'pessoas ativas'}</b> no time.`;
  if(snap.pessoas.custoMedio > 0){
    msg += ` Custo médio: <b>${fmtBRL(snap.pessoas.custoMedio)}/mês</b> por pessoa.`;
  }
  // Por tipo
  const porTipo = snap.pessoas.porTipo || {};
  const tiposComValor = Object.entries(porTipo).filter(([k,v]) => v > 0);
  if(tiposComValor.length > 0){
    msg += `<br><br><b>Distribuição (custo anual por tipo):</b><ul style="margin:6px 0 0 18px">`;
    for(const [k,v] of tiposComValor.sort((a,b)=>b[1]-a[1])){
      const pct = snap.pessoas.folhaAno > 0 ? (v/snap.pessoas.folhaAno)*100 : 0;
      msg += `<li><b>${esc(k||'sem tipo')}</b>: ${fmtBRL(v)}/ano (${pct.toFixed(0)}%)</li>`;
    }
    msg += `</ul>`;
  }
  return msg;
}

// ========= Cartoes =========
function mrcashCartoes(snap){
  let dados = null;
  try { dados = (typeof cartoes !== 'undefined' && cartoes) ? cartoes : (window.cartoes || null); } catch(_){}
  if(!dados || !Array.isArray(dados.list) || dados.list.length === 0){
    return `Nenhum cartão de crédito cadastrado no módulo <b>Cartões</b>. <br><br>Quando cadastrar, eu mostro limite, fatura em aberto, vencimentos e maiores gastos.`;
  }
  const ativos = dados.list.filter(c => c.ativo !== false);
  const inativos = dados.list.length - ativos.length;
  const totalLimite = ativos.reduce((s,c)=>s+(parseFloat(c.limite)||0), 0);
  const faturas = Array.isArray(dados.faturas) ? dados.faturas : [];
  const lancamentos = Array.isArray(dados.lancamentos) ? dados.lancamentos : [];

  // Faturas em aberto
  const abertas = faturas.filter(f => f.status !== 'pago' && f.status !== 'pagas');
  const totalAberto = abertas.reduce((s,f)=>{
    const total = (lancamentos||[]).filter(l => l.faturaId === f.id).reduce((a,b)=>a+(parseFloat(b.valor)||0), 0);
    return s + total;
  }, 0);

  let msg = `<b>${ativos.length} ${ativos.length===1?'cartão ativo':'cartões ativos'}</b>${inativos>0?` (${inativos} inativo${inativos===1?'':'s'})`:''}.`;
  msg += ` Limite total: <b>${fmtBRL(totalLimite)}</b>.`;
  if(totalAberto > 0){
    msg += `<br>Total em <b>faturas em aberto</b>: ${fmtBRL(totalAberto)} (${abertas.length} fatura${abertas.length===1?'':'s'}).`;
  }
  // Tabela por cartao
  if(ativos.length > 0){
    msg += `<br><br><b>Detalhamento por cartão:</b>`;
    msg += `<table style="margin:6px 0;border-collapse:collapse;font-size:13px;width:100%"><thead><tr style="background:rgba(0,0,0,.04)"><th style="text-align:left;padding:5px 8px">Cartão</th><th style="text-align:right;padding:5px 8px">Bandeira</th><th style="text-align:right;padding:5px 8px">Limite</th><th style="text-align:right;padding:5px 8px">Vence</th></tr></thead><tbody>`;
    for(const c of ativos){
      const nome = (c.nome || c.apelido || 'Cartão').toString().slice(0,30);
      const band = c.bandeira || '—';
      const lim = parseFloat(c.limite)||0;
      const venc = c.diaVencimento ? `dia ${c.diaVencimento}` : '—';
      msg += `<tr><td style="padding:4px 8px;border-top:1px solid rgba(0,0,0,.06)"><b>${esc(nome)}</b></td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${esc(band)}</td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${fmtBRL(lim)}</td><td style="padding:4px 8px;text-align:right;border-top:1px solid rgba(0,0,0,.06)">${esc(venc)}</td></tr>`;
    }
    msg += `</tbody></table>`;
  }
  return msg;
}

// ========= Bancos / contas / reservas =========
function mrcashBancos(snap){
  let dados = null;
  try { dados = (typeof dispo !== 'undefined' && dispo) ? dispo : (window.dispo || null); } catch(_){}
  if(!dados || !Array.isArray(dados.contas) || dados.contas.length === 0){
    return `Nenhuma conta cadastrada em <b>Disponibilidades</b>.`;
  }
  // Agrupa por tipo
  const grupos = {};
  for(const c of dados.contas){
    if(c.ativo === false) continue;
    const tipo = (c.tipo || 'Conta').toString();
    if(!grupos[tipo]) grupos[tipo] = [];
    // último saldo
    const saldos = c.saldos || {};
    let lastV = 0, lastK = '';
    const curMIdx = snap.curMIdx, curYear = snap.curYear;
    for(let i=curMIdx;i>=0;i--){
      const k = curYear+'-'+String(i+1).padStart(2,'0');
      const v = parseFloat(saldos[k]);
      if(isFinite(v) && v !== 0){ lastV = v; lastK = k; break; }
    }
    if(lastV === 0){
      const keys = Object.keys(saldos).sort().reverse();
      for(const k of keys){
        const v = parseFloat(saldos[k]);
        if(isFinite(v) && v !== 0){ lastV = v; lastK = k; break; }
      }
    }
    grupos[tipo].push({ nome: (c.nome||c.banco||'Conta').toString().slice(0,40), saldo: lastV, ref: lastK });
  }
  const tipos = Object.keys(grupos);
  if(tipos.length === 0) return `Sem contas ativas no momento.`;

  let total = 0;
  let msg = `<b>Suas contas e reservas (ativas):</b>`;
  for(const tipo of tipos){
    const lista = grupos[tipo].sort((a,b)=>b.saldo - a.saldo);
    const subtotal = lista.reduce((s,x)=>s+x.saldo, 0);
    total += subtotal;
    msg += `<br><br><b>${esc(tipo)}</b> (${lista.length}) — subtotal ${fmtBRL(subtotal)}<ul style="margin:4px 0 0 18px">`;
    for(const l of lista){
      const refLbl = l.ref ? l.ref.split('-').reverse().join('/') : '';
      msg += `<li><b>${esc(l.nome)}</b> — ${fmtBRL(l.saldo)}${refLbl?` <small style="color:var(--txl)">(ref. ${esc(refLbl)})</small>`:''}</li>`;
    }
    msg += `</ul>`;
  }
  msg += `<br><b>Total geral:</b> ${fmtBRL(total)}.`;
  return msg;
}

