function _anaCollectAvailableYears(){
  const yrs = new Set();
  const t = new Date();
  for(let y = t.getFullYear()-3; y <= t.getFullYear()+3; y++) yrs.add(y);
  // adiciona anos com dados
  if(typeof receita !== 'undefined' && receita && receita.years)
    for(const y of Object.keys(receita.years)) yrs.add(parseInt(y,10));
  if(typeof estrutura !== 'undefined' && estrutura && Array.isArray(estrutura.years))
    for(const y of estrutura.years) yrs.add(parseInt(y,10));
  return Array.from(yrs).sort();
}
