      ${mkItem('ativos',   'Ativos',   nAtivos)}
      ${mkItem('inativos', 'Inativos', nInativos)}
    </div>`;

  // ── Select compacto de TIPO ──
  const tipoOpts = tipos
    .map(t => `<option value="${esc(t.nome)}"${recFilterTipo===t.nome?' selected':''}>${esc(t.nome)}</option>`)
    .join('');
  const tipoSelected = recTipoByNome(recFilterTipo);
  const tipoDotStyle = tipoSelected ? `--tdot:${tipoSelected.color}` : '';
  const tipoSelect = `
    <span class="rec-filter-lbl">Tipo:</span>
    <select class="rec-tipo-filter-select${tipoSelected?' has-color':''}"
            style="${tipoDotStyle}"
            onchange="setRecFilterTipo(this.value)">
      <option value=""${recFilterTipo===''?' selected':''}>Todos os tipos</option>
      ${tipoOpts}
    </select>
    <button class="rec-tipo-filter-btn primary" onclick="quickAddTipo()" title="Adicionar novo tipo">
      <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo
    </button>
    <button class="rec-tipo-filter-btn" onclick="openTipoManager()" title="Editar, renomear, excluir ou mudar cor dos tipos">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33h0a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51h0a1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82v0a1.65 1.65 0 00 1.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
      Gerenciar
    </button>`;

  // ── Select de país (apenas países usados no ano + o filtrado) ──
  const paisesUsados = new Set();
  for(const r of todasLinhas){
    const p = clienteView(r).pais;
    if(p) paisesUsados.add(p);
  }
  if(recFilterPais) paisesUsados.add(recFilterPais);
  const paisOpts = recAllPaises()
    .filter(p => paisesUsados.size === 0 || paisesUsados.has(p.code))
    .map(p => `<option value="${p.code}"${recFilterPais===p.code?' selected':''}>${p.flag} ${esc(p.nome)}</option>`)
    .join('');
  const paisFilter = `
    <span class="rec-filter-lbl">País:</span>
    <select class="rec-pais-filter" onchange="setRecFilterPais(this.value)">
      <option value=""${recFilterPais===''?' selected':''}>Todos</option>
      ${paisOpts}
    </select>`;

  // ── Toggle de simulações no total ──
  const temSim = hasAnySimValue();
  const simTitle = !temSim && !recIncluirSim
    ? 'Nenhuma simulação cadastrada neste ano'
    : (recIncluirSim
        ? 'Simulações entram no total do ano. Clique para ignorar.'
        : 'Simulações não entram no total. Clique para incluir.');
  const simToggle = `
    <button class="rec-sim-toggle${recIncluirSim?' on':''}${!temSim?' vazio':''}"
            onclick="toggleRecIncluirSim()"
            title="${esc(simTitle)}">
      <span class="rec-sim-toggle-ico">🔮</span>
      <span class="rec-sim-toggle-lbl">${recIncluirSim?'Com simulações':'Sem simulações'}</span>
      <span class="rec-sim-toggle-sw"><span class="rec-sim-toggle-dot"></span></span>
    </button>`;

  const anyFiltro = recFilterTipo || recFilterPais || recFilterAtivo;
  const countLbl = anyFiltro
    ? `<span class="rec-filter-count">${visibleCount} linha${visibleCount===1?'':'s'} filtrada${visibleCount===1?'':'s'}</span>`
    : '';

  bar.innerHTML = statusPill + tipoSelect + paisFilter + simToggle + countLbl;
}

// Retorna true se existe pelo menos um valor > 0 em qualquer lead do ano ativo
function hasAnySimValue(){
  const d = receita && receita.years && receita.years[recActiveYear];
  if(!d || !Array.isArray(d.leads)) return false;
  for(const r of d.leads){
    if(!r || !r.meses) continue;
    for(const m of REC_MESES){
      const c = r.meses[m];
      if(!c) continue;
      const v = parseFloat(c.valor);
      if(!isNaN(v) && v > 0) return true;
    }
  }
  return false;
}

// Toggle para incluir ou não as leads simuladas no total do ano
async function toggleRecIncluirSim(){
  // Bloqueia ativar "Com simulações" quando não há nenhum valor simulado
  const vaiLigar = !recIncluirSim;
  if(vaiLigar && !hasAnySimValue()){
    await askConfirm({
      title: 'Sem simulações para incluir',
      message: 'Nenhum valor simulado foi cadastrado em ' + recActiveYear + '.',
      sub: 'Adicione uma linha em "🔮 Simular" e preencha pelo menos um mês para poder incluir simulações no total do ano.',
      variant: 'info',
      confirmLabel: 'Entendi',
      cancelLabel: ''
    });
    return; // não muda o estado
  }
  recIncluirSim = !recIncluirSim;
  renderReceita();
}

// Setter do filtro de status (ativos/inativos)
function setRecFilterAtivo(key){
  const k = (key === 'ativos' || key === 'inativos') ? key : '';
  if(recFilterAtivo === k) return;
  recFilterAtivo = k;
  renderReceita();
}

// Setter do filtro de tipo via select
function setRecFilterTipo(nome){
  recFilterTipo = nome || '';
  renderReceita();
