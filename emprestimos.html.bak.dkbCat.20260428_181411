    .ana-cw-hd .ctrl.del{flex-shrink:0;font-size:.78rem}
    .ana-cw-hd .ctrl.del:hover{background:#FEE2E2;color:#DC2626}
    .ana-cw-cols-pick{display:inline-flex;gap:0;background:#E5E7EB;border-radius:3px;padding:1px;margin-right:1px;flex-shrink:0}
    .ana-cw-cols-pick button{background:transparent;border:none;color:#6B7280;cursor:pointer;
                              padding:1px 4px;border-radius:2px;font-size:.58rem;font-weight:700;
                              font-family:inherit;line-height:1.2;min-width:14px}
    .ana-cw-cols-pick button.active{background:#7C3AED;color:#fff}
    .ana-cw-cols-pick button:hover:not(.active){background:#fff}
    .ana-cw-rows-pick{display:inline-flex;gap:0;background:#E5E7EB;border-radius:3px;padding:1px;margin-right:2px;flex-shrink:0}
    .ana-cw-rows-pick button{background:transparent;border:none;color:#6B7280;cursor:pointer;
                              padding:1px 4px;border-radius:2px;font-size:.58rem;font-weight:700;
                              font-family:inherit;line-height:1.2;min-width:16px}
    .ana-cw-rows-pick button.active{background:#0891B2;color:#fff}
    .ana-cw-rows-pick button:hover:not(.active){background:#fff}
    .ana-cw-drag{cursor:grab;color:#9CA3AF;padding:2px 3px !important;font-size:.85rem !important;
                  font-weight:800;line-height:1;user-select:none;flex-shrink:0}
    .ana-cw-body{padding:6px 8px;flex:1;min-height:0;overflow:hidden;position:relative;
                  display:block}
    .ana-custom-widget{height:100%;overflow:hidden;display:flex;flex-direction:column}
    .ana-cw-body.no-pad{padding:0}
