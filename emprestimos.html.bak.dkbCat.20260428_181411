const AN_COLORS = ['#2563EB','#DC2626','#059669','#D97706','#7C3AED',
                   '#EC4899','#0EA5E9','#F97316','#14B8A6','#6366F1'];

function enrichLoans(){
  const today = new Date(); today.setDate(1); today.setHours(0,0,0,0);
  return loans.map(l=>{
    const saldo   = parseFloat(l.saldo)   || 0;
    const parcela = parseFloat(l.parcelaVal) || 0;
    const taxa    = parseFloat(l.taxa)    || 0;
    const valor   = parseFloat(l.valor)   || 0;
    const termino = l.termino ? new Date(l.termino+'T00:00:00') : null;

    let mesesRestantes = 0;
    if(termino && saldo > 0){
      mesesRestantes = Math.max(0, (termino.getFullYear()-today.getFullYear())*12
                                 + (termino.getMonth()-today.getMonth()));
    } else if(parcela > 0 && saldo > 0){
      mesesRestantes = Math.ceil(saldo / parcela);
    }

    // Future interest estimate: total remaining payments − remaining principal
    const jurosEstimado = parcela > 0 && mesesRestantes > 0
      ? Math.max(0, parcela * mesesRestantes - saldo)
      : 0;

    // Monthly interest charge
    const jurosMensal = saldo * (taxa / 100);
    // % of parcela going to principal
    const eficiencia  = parcela > 0 ? Math.max(0, Math.min(100,(parcela-jurosMensal)/parcela*100)) : 0;

    const banco = l.banco==='— Digitar manualmente —'?(l.bancoManual||'Manual'):(l.banco||'—');
    const nome  = [banco, l.descricao||`#${l.id}`].filter(Boolean).join(' · ');

    return{...l, saldo, parcela, taxa, valor, termino, mesesRestantes,
           jurosEstimado, jurosMensal, eficiencia, nome};
  });
}

function drawAnalise(){
  const enriched = enrichLoans();

  if(enriched.length===0){
    document.getElementById('an-kpi-row').innerHTML=
      `<div class="an-kpi" style="grid-column:1/-1;text-align:center;color:var(--txm);font-size:.82rem;padding:32px">
         Nenhum empréstimo cadastrado ainda.
       </div>`;
    document.getElementById('an-strategy').innerHTML='';
    document.getElementById('an-detail-table').innerHTML='';
    document.getElementById('an-cashflow').innerHTML=
      '<p style="color:var(--txm);font-size:.8rem">Nenhum dado disponível.</p>';
    return;
  }

  const today       = new Date(); today.setDate(1); today.setHours(0,0,0,0);
  const totalSaldo  = enriched.reduce((s,l)=>s+l.saldo, 0);
  const totalValor  = enriched.reduce((s,l)=>s+l.valor, 0);
  const totalParc   = enriched.reduce((s,l)=>s+l.parcela, 0);
  const totalJuros  = enriched.reduce((s,l)=>s+l.jurosEstimado, 0);
  const amortizado  = Math.max(0, totalValor - totalSaldo);
  const pctAmort    = totalValor > 0 ? (amortizado/totalValor)*100 : 0;

  // Weighted avg rate (by saldo)
  const wAvgTaxa = totalSaldo > 0
    ? enriched.reduce((s,l)=>s+l.saldo*l.taxa,0) / totalSaldo : 0;

  // Average remaining months (weighted by saldo)
  const wAvgMeses = totalSaldo > 0
    ? enriched.reduce((s,l)=>s+l.mesesRestantes*(l.saldo||1),0) / totalSaldo : 0;

  // ── KPI Cards ──────────────────────────────────
  document.getElementById('an-kpi-row').innerHTML=`
    <div class="an-kpi">
      <div class="an-kpi-lbl">Juros Futuros Est.</div>
      <div class="an-kpi-val red">${fmtBRL(totalJuros)}</div>
      <div class="an-kpi-sub">custo total projetado</div>
    </div>
    <div class="an-kpi">
      <div class="an-kpi-lbl">Taxa Média Pond.</div>
      <div class="an-kpi-val amb">${fmtBR(wAvgTaxa,3)}% a.m.</div>
      <div class="an-kpi-sub">ponderada pelo saldo</div>
    </div>
    <div class="an-kpi">
      <div class="an-kpi-lbl">Parcela Mensal Total</div>
      <div class="an-kpi-val blue">${fmtBRL(totalParc)}</div>
      <div class="an-kpi-sub">comprometimento mensal</div>
    </div>
    <div class="an-kpi">
      <div class="an-kpi-lbl">Prazo Médio Rest.</div>
      <div class="an-kpi-val pur">${Math.round(wAvgMeses)} meses</div>
      <div class="an-kpi-sub">ponderado pelo saldo</div>
    </div>
    <div class="an-kpi">
      <div class="an-kpi-lbl">Já Amortizado</div>
      <div class="an-kpi-val grn">${pctAmort.toFixed(1).replace('.',',')}%</div>
      <div class="an-kpi-sub">${fmtBRL(amortizado)} de ${fmtBRL(totalValor)}</div>
    </div>
  `;

  drawProgress(enriched);
  drawStrategy(enriched, wAvgTaxa);
  drawDetailTable(enriched, totalSaldo);
  drawCashFlow(enriched);
}

