let _anaState = {
  anoDe: null, anoAte: null, mesDe: 0, mesAte: 11,
  modulos: ANA_MODULOS.map(m => m.id),
  statusFilter: 'all',  // 'all' | 'baixado' | 'aberto'
  pivot: {
    rows: ['periodo'],
    cols: ['modulo'],
    values: [{ field:'valor', agg:'sum' }]
  }
};
function _anaLoadState(){
