// ─── Calcular fatura pra uma data de compra ───
// Regra: data >= dia de fechamento → próxima fatura; senão → fatura corrente
// O "ciclo" da fatura corre de (mês-1, dia fechamento+1) até (mês, dia fechamento)
// O vencimento é (mês+1, dia vencimento)
function _cartFaturaCicloFor(cartao, dataStr){
  // dataStr formato YYYY-MM-DD
  const [y, m, d] = dataStr.split('-').map(n => parseInt(n,10));
  const fech = cartao.diaFechamento;
  // Define em qual fatura cai a compra
  // Ex: fechamento dia 25. Compra dia 20/abr → fatura abr (fechamento 25/abr); compra dia 26/abr → fatura mai
  let faturaY = y, faturaM = m;
  if(d > fech){
    faturaM++;
    if(faturaM > 12){ faturaM = 1; faturaY++; }
  }
  // Ciclo da fatura: (faturaM-1, fech+1) até (faturaM, fech)
  let cicloIniY = faturaY, cicloIniM = faturaM - 1;
  if(cicloIniM < 1){ cicloIniM = 12; cicloIniY--; }
  const lastDayCicloIni = new Date(cicloIniY, cicloIniM, 0).getDate();
  const fechCicloIni = Math.min(fech, lastDayCicloIni);
  const cicloDe = cicloIniY + '-' + String(cicloIniM).padStart(2,'0') + '-' + String(fechCicloIni + 1).padStart(2,'0');
  const lastDayFech = new Date(faturaY, faturaM, 0).getDate();
  const fechFat = Math.min(fech, lastDayFech);
  const cicloAte = faturaY + '-' + String(faturaM).padStart(2,'0') + '-' + String(fechFat).padStart(2,'0');
  // Vencimento: (faturaM+1, diaVencimento) ou (faturaM, diaVenc) se diaVenc > fech (mesmo mês)
  let vencY = faturaY, vencM = faturaM;
  if(cartao.diaVencimento <= fech){
    vencM++;
    if(vencM > 12){ vencM = 1; vencY++; }
  }
  const lastDayVenc = new Date(vencY, vencM, 0).getDate();
  const venc = vencY + '-' + String(vencM).padStart(2,'0') + '-' + String(Math.min(cartao.diaVencimento, lastDayVenc)).padStart(2,'0');
  return { cicloDe, cicloAte, vencimento: venc, refY: faturaY, refM: faturaM };
}

// Pega ou cria fatura pra (cartaoId, refY, refM)
function cartGetOrCreateFatura(cartaoId, refY, refM){
  let fat = cartoes.faturas.find(f => f.cartaoId === cartaoId && f.refY === refY && f.refM === refM);
  if(fat) return fat;
  const c = cartoes.list.find(x => x.id === cartaoId);
  if(!c) return null;
  // Calcula ciclos para esse mês
  const exemploData = refY + '-' + String(refM).padStart(2,'0') + '-15';
  const ciclo = _cartFaturaCicloFor(c, exemploData);
  fat = {
    id: cartoes.nextFaturaId++,
    cartaoId: cartaoId,
    refY: refY, refM: refM,
    ciclo: { de: ciclo.cicloDe, ate: ciclo.cicloAte },
    vencimento: ciclo.vencimento,
    status: 'aberta',
    pagamento: null
  };
  cartoes.faturas.push(fat);
  return fat;
}

// Calcula status atual da fatura (aberta vs fechada vs paga)
function cartFaturaStatus(fat){
  if(fat.status === 'paga') return 'paga';
  // Aberta enquanto hoje <= ciclo.ate; Fechada se hoje > ciclo.ate
  const today = (() => { const t = new Date(); return t.getFullYear() + '-' + String(t.getMonth()+1).padStart(2,'0') + '-' + String(t.getDate()).padStart(2,'0'); })();
  if(fat.ciclo && today > fat.ciclo.ate) return 'fechada';
  return 'aberta';
}
function cartFaturaTotal(fatId){
  let tot = 0;
  for(const l of cartoes.lancamentos){
    if(l.faturaId === fatId) tot += parseFloat(l.valor) || 0;
  }
  return tot;
}
function cartLimiteUsado(cartaoId){
  // Soma das faturas em aberto + fechadas (não pagas)
  let used = 0;
  for(const f of cartoes.faturas){
    if(f.cartaoId !== cartaoId) continue;
    if(f.status === 'paga') continue;
    used += cartFaturaTotal(f.id);
  }
  return used;
}
function cartFmtBR(n){
  return (parseFloat(n)||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
}
function cartEsc(s){
  return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function cartMesLabel(refY, refM){
  const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  return meses[refM-1] + ' ' + refY;
}
function cartFmtDateBR(s){
  if(!s) return '—';
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
  if(!m) return s;
  return m[3] + '/' + m[2] + '/' + m[1];
}

