  try{
    document.querySelectorAll('#fk-year').forEach(el => { el.textContent = new Date().getFullYear(); });
  }catch(_){}
}
function fkHideGate(){
  document.body.classList.remove('fk-locked');
  const g = document.getElementById('forekash-gate');
