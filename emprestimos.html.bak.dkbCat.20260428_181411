// Formata CNPJ/CPF do pessoa blur. Cada tipo grava em seu próprio campo
// (r.cnpj, r.cpf, r.taxId) — trocar de chip não clobberiza o outro.
function onPesCNPJBlur(rid, el){
  const r = pesRegistry().find(x => x.id === rid);
  if(!r) return;
  const v = el.value;
  const d = onlyDigits(v);
  const formatted = d.length === 14 ? fmtCNPJ(d) : v;
  if(r.cnpj !== formatted){
    r.cnpj = formatted;
    pessoasSave();
    if(_pesCardOpenId != null) renderPesCardBody();
  }
  if(r.tipoPessoa === 'pj' && d.length === 14){
    lookupPesCNPJ(rid, {manual:false});
  }
}

function onPesCPFBlur(rid, el){
  const r = pesRegistry().find(x => x.id === rid);
  if(!r) return;
  const v = el.value;
  const d = onlyDigits(v);
  const formatted = d.length === 11 ? fmtCPF(d) : v;
  if(r.cpf !== formatted){
    r.cpf = formatted;
    pessoasSave();
  }
  // Sempre re-renderiza — o estado (válido / inválido / duplicado) deriva
  // do próprio r.cpf em pesCpfStateOf, então basta o render acontecer.
  if(_pesCardOpenId != null) renderPesCardBody();
}

// Busca outro registro (qualquer tipo) com o mesmo CPF. Compara só por
// dígitos, ignorando formatação. Retorna {id, nome} do primeiro match ou null.
// Agora também pega PF guardado em r.cpf mesmo se o tipo ativo for outro —
// como os campos são independentes, um CPF preenchido em qualquer registro
// conta como "já cadastrado".
function findPesCPFDuplicate(rid, cpfDigits){
  if(!cpfDigits || cpfDigits.length !== 11) return null;
  for(const r of pesRegistry()){
    if(r.id === rid) continue;
    if(onlyDigits(r.cpf || '') === cpfDigits){
      return { id: r.id, nome: r.nomeCompleto || r.nome || ('Pessoa #' + r.id) };
    }
  }
  return null;
}

// Deriva o estado do CPF de um registro para exibição no card.
// Retorna null quando o campo está vazio (sem mensagem de erro).
// Caso contrário: {state: 'ok' | 'invalid' | 'duplicate', dupName?}
function pesCpfStateOf(rid){
  const r = pesRegistry().find(x => x.id === rid);
  if(!r) return null;
  const d = onlyDigits(r.cpf || '');
  if(!d) return null;
  if(!isValidCPF(d)) return { state: 'invalid' };
  const dup = findPesCPFDuplicate(rid, d);
  if(dup) return { state: 'duplicate', dupName: dup.nome };
  return { state: 'ok' };
}

// Lookup da razão social via BrasilAPI — espelho de lookupCNPJ para pessoas PJ.
async function lookupPesCNPJ(rid, opts){
  opts = opts || {};
  const r = pesRegistry().find(x => x.id === rid);
  if(!r) return;
  const cnpjDigits = onlyDigits(r.cnpj || '');
  if(cnpjDigits.length !== 14){
    if(opts.manual){
      await askConfirm({
        title: 'CNPJ inválido',
        message: 'Informe um CNPJ com 14 dígitos para buscar a razão social.',
        variant: 'warn', confirmLabel: 'Entendi', cancelLabel: ''
      });
    }
    return;
  }
  if(!opts.manual && (r.razaoSocial || '').trim()) return;

  _pesCnpjLookupState[rid] = 'loading';
  if(_pesCardOpenId != null) renderPesCardBody();

  try{
    let dados = _cnpjCache[cnpjDigits];
    if(!dados){
      const url = `https://brasilapi.com.br/api/cnpj/v1/${cnpjDigits}`;
      const resp = await fetch(url, {method:'GET'});
      if(!resp.ok){
        if(resp.status === 404) throw new Error('CNPJ não encontrado na Receita Federal.');
        throw new Error(`Falha ao consultar (HTTP ${resp.status}).`);
      }
      dados = await resp.json();
      _cnpjCache[cnpjDigits] = dados;
    }
    const razao = (dados && (dados.razao_social || dados.nome || '')).trim();
    if(!razao) throw new Error('Razão social não disponível para este CNPJ.');
    r.razaoSocial = razao;
    r.cnpj        = fmtCNPJ(cnpjDigits);
    // r.nome (descrição da planilha) é deliberadamente NÃO sincronizado —
    // a edição na célula é a única fonte de verdade pra essa coluna.
    _pesCnpjLookupState[rid] = 'ok';
    pessoasSave();
    if(_pesCardOpenId != null) renderPesCardBody();
    setTimeout(() => {
      if(_pesCnpjLookupState[rid] === 'ok'){
        _pesCnpjLookupState[rid] = null;
        if(_pesCardOpenId != null) renderPesCardBody();
      }
    }, 2000);
  }catch(e){
    _pesCnpjLookupState[rid] = 'err';
    if(_pesCardOpenId != null) renderPesCardBody();
    if(opts.manual){
      await askConfirm({
        title: 'Não foi possível buscar',
        message: e.message || 'Erro ao consultar a BrasilAPI.',
        variant: 'warn', confirmLabel: 'Fechar', cancelLabel: ''
      });
    }
  }
}

// ─── Ciclos anteriores da pessoa (sai e volta) ───
function pesRegCiclos(rid){
  const r = pesRegistry().find(x => x.id === rid);
  if(!r) return [];
  if(!Array.isArray(r.ciclos)) r.ciclos = [];
  return r.ciclos;
}

// Soma a duração de todos os ciclos (incluindo o vigente da row) — em meses.
function pesTempoTotalMeses(row){
  const rid = row ? (row.pessoaId || 0) : 0;
  const ciclos = rid ? pesRegCiclos(rid) : [];
  let meses = 0;
  // Ciclos anteriores (arquivados): sempre têm início + fim
  for(const p of ciclos){
    const ini = parsePesDate(p.inicio || '');
    const fim = parsePesDate(p.fim || '');
    if(!ini || !fim) continue;
    meses += (fim.getFullYear() - ini.getFullYear()) * 12 + (fim.getMonth() - ini.getMonth());
  }
  // Ciclo vigente (row.dataEntrada → hoje se ativo, senão dataSaida)
  if(row && row.dataEntrada){
    const ini = parsePesDate(row.dataEntrada);
    const fim = row.ativo ? new Date() : parsePesDate(row.dataSaida || '') || new Date();
    if(ini && fim >= ini){
      meses += (fim.getFullYear() - ini.getFullYear()) * 12 + (fim.getMonth() - ini.getMonth());
    }
  }
  return Math.max(0, meses);
}

// Converte meses em {anos, meses} para exibição
function pesMesesToTempo(totalMeses){
  const anos = Math.floor(totalMeses / 12);
  const meses = totalMeses - anos * 12;
  return {anos, meses, dias: 0};
}

