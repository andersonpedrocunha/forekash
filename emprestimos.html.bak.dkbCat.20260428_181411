function setEstNome(id, val){
  const it = estrutura.itens.find(x=>x.id===id);
  if(!it) return;
  // Detecta prefixo [Tag] e extrai a tag automaticamente
  const m = /^\s*\[([^\]]+)\]\s*(.*)$/.exec(val);
  if(m){
    const tagName = m[1].trim();
    const rest = m[2].trim();
    // Procura tag existente (case-insensitive)
    const existing = estrutura.tags.find(t =>
      (t.nome||'').trim().toLowerCase() === tagName.toLowerCase()
    );
    if(existing){
      it.tagId = existing.id;
    } else if(tagName){
      // Cria nova tag automaticamente com próxima cor
      const color = EST_COLOR_PALETTE[estrutura.tags.length % EST_COLOR_PALETTE.length];
      const newTag = { id: estNextTagId(), nome: tagName, color };
      estrutura.tags.push(newTag);
      it.tagId = newTag.id;
    }
    it.nome = rest;
  } else {
    it.nome = (val||'').trim();
  }
  estSave();
  renderEstrutura();
}

function setEstTipo(id, tipoId){
  const it = estrutura.itens.find(x=>x.id===id);
  if(!it) return;
  it.tipoId = tipoId || '';
  estSave();
  renderEstrutura();
}

function setEstTag(id, tagId){
  const it = estrutura.itens.find(x=>x.id===id);
  if(!it) return;
  it.tagId = tagId || '';
  estSave();
  renderEstrutura();
  closeEstTagPicker();
}

function setEstValor(id, key, val){
  const it = estrutura.itens.find(x=>x.id===id);
  if(!it) return;
  // Regra: célula com ✓ (pago) trava edição até o ✓ ser removido
  if(it.pagos && it.pagos[key]){ notifyLocked(); return; }
  const n = parseBR(val);
  if(!n || isNaN(n)){
    delete it.valores[key];
    // Limpa também a marcação de pago quando o valor é apagado (evita flag órfão)
    if(it.pagos && Object.prototype.hasOwnProperty.call(it.pagos, key)){
      delete it.pagos[key];
    }
  } else {
    it.valores[key] = n;
  }
  estSave();
  // Só atualiza totais e KPIs (evita re-render pesado durante edição)
  renderEstSheet();
  updateEstKpis();
}

function toggleEstPago(id, key){
  const it = estrutura.itens.find(x=>x.id===id);
  if(!it) return;
  const v = it.valores[key];
  if(v === undefined || v === null || v === 0) return; // sem valor real → nada a marcar
  if(!it.pagos) it.pagos = {};
  if(it.pagos[key]) delete it.pagos[key];
  else              it.pagos[key] = true;
  estSave();
  renderEstSheet();
  updateEstKpis();
}

