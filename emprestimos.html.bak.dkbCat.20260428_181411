  if(!name) name = 'Arquivo ' + new Date().toLocaleDateString('pt-BR') + ' ' + new Date().toLocaleTimeString('pt-BR', {hour:'2-digit',minute:'2-digit'});
  _anaState.archive.push({
    id: 'ar_' + Date.now(), name: name, savedAt: Date.now(),
