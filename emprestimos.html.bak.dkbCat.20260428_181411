function _viagSetupCanvas(canvasId){
  const cv = document.getElementById(canvasId || 'viag-appr-canvas');
  if(!cv) return;
  const rect = cv.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  cv.width  = rect.width  * dpr;
  cv.height = rect.height * dpr;
  const ctx = cv.getContext('2d');
  ctx.scale(dpr, dpr);
  ctx.lineWidth = 2.2;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.strokeStyle = '#0F172A';
  let drawing = false;
  let last = null;
  const pos = (e) => {
    const r = cv.getBoundingClientRect();
    const t = e.touches && e.touches[0];
    return {
      x: ((t ? t.clientX : e.clientX) - r.left),
      y: ((t ? t.clientY : e.clientY) - r.top)
    };
  };
  const start = (e) => { drawing = true; last = pos(e); e.preventDefault(); };
  const move  = (e) => {
    if(!drawing) return;
    const p = pos(e);
    ctx.beginPath();
    ctx.moveTo(last.x, last.y);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
    last = p;
    e.preventDefault();
  };
  const end = () => { drawing = false; last = null; };
  cv.addEventListener('mousedown', start);
  cv.addEventListener('mousemove', move);
  cv.addEventListener('mouseup', end);
  cv.addEventListener('mouseleave', end);
  cv.addEventListener('touchstart', start, {passive:false});
  cv.addEventListener('touchmove', move, {passive:false});
  cv.addEventListener('touchend', end);
}
function _viagClearSig(canvasId){
  const cv = document.getElementById(canvasId || 'viag-appr-canvas');
  if(!cv) return;
  const ctx = cv.getContext('2d');
  ctx.clearRect(0, 0, cv.width, cv.height);
}
function _viagConfirmApproval(){
  if(!_viagApprovalContext) return;
  const v = viagens.itens.find(x => x.id === _viagApprovalContext.viagemId);
  if(!v) return;
  const inpName = document.getElementById('viag-appr-nome');
  const sel = document.getElementById('viag-appr-pessoa');
  let nome = '';
  if(sel && sel.value && sel.value !== '__externo__'){
    nome = sel.value;
  } else if(inpName && inpName.value.trim()){
    nome = inpName.value.trim();
  }
  if(!nome){
    if(typeof toast === 'function') toast('⚠ Selecione/digite o nome do aprovador');
    return;
  }
  // Verifica se a assinatura tem traços (não é canvas em branco)
  const cv = document.getElementById('viag-appr-canvas');
  if(!cv){ if(typeof toast === 'function') toast('Canvas não encontrado'); return; }
  const ctx = cv.getContext('2d');
  const data = ctx.getImageData(0, 0, cv.width, cv.height).data;
  let hasInk = false;
  for(let i = 3; i < data.length; i += 4){ if(data[i] > 0){ hasInk = true; break; } }
  if(!hasInk){
    if(typeof toast === 'function') toast('⚠ Faça a assinatura no quadro abaixo');
    return;
  }
  const sigData = cv.toDataURL('image/png');
  const dataISO = new Date().toISOString();
  // Hash SHA-256 da combinação (assinatura | aprovador | data | viagemId | título)
  const payload = sigData + '|' + nome + '|' + dataISO + '|' + v.id + '|' + (v.titulo || '');
  _viagComputeHash(payload).then(hash => {
    const codigo = _viagShortCode(hash);
    v.aprovacao = {
      aprovador: nome,
      data: dataISO,
      assinatura: sigData,
      hash: hash,
      codigo: codigo,
      statusAprovado: _viagApprovalContext.targetStatus
    };
    v.status = _viagApprovalContext.targetStatus;
    if(_viagIsClosed(v) && !v.fechadoEm) v.fechadoEm = dataISO;
    viagSave();
    _viagApprovalContext = null;
    const ov = document.getElementById('viag-approval-modal');
    if(ov) ov.remove();
    renderViagens();
    if(_viagEditingId === v.id){ try { _viagRenderEditor(); } catch(e){} }
    if(typeof toast === 'function') toast('🔏 Aprovado por ' + nome + ' · código ' + codigo);
  }).catch(err => {
    console.error('hash failed:', err);
    if(typeof toast === 'function') toast('Erro ao gerar hash da assinatura');
  });
}
