}

/* ─── Inicialização do filtro de período ─── */
function _anaInitPeriodo(){
  const today = new Date();
  if(_anaState.anoDe == null)  _anaState.anoDe  = today.getFullYear();
  if(_anaState.anoAte == null) _anaState.anoAte = today.getFullYear();
  if(_anaState.mesDe == null)  _anaState.mesDe  = 0;
  if(_anaState.mesAte == null) _anaState.mesAte = today.getMonth();
}
function anaSetFilter(field, val){
  if(field === 'mesDe' || field === 'mesAte') _anaState[field] = parseInt(val,10);
  else if(field === 'anoDe' || field === 'anoAte') _anaState[field] = parseInt(val,10);
  _anaSaveState();
  renderAnaliseModule();
}
function anaQuickPeriod(kind){
  const t = new Date();
  if(kind === 'mes'){ _anaState.anoDe = _anaState.anoAte = t.getFullYear(); _anaState.mesDe = _anaState.mesAte = t.getMonth(); }
  else if(kind === 'ano'){ _anaState.anoDe = _anaState.anoAte = t.getFullYear(); _anaState.mesDe = 0; _anaState.mesAte = 11; }
  else if(kind === 'ytd'){ _anaState.anoDe = _anaState.anoAte = t.getFullYear(); _anaState.mesDe = 0; _anaState.mesAte = t.getMonth(); }
  else if(kind === '12m'){
    const dDe = new Date(t.getFullYear(), t.getMonth() - 11, 1);
    _anaState.anoDe = dDe.getFullYear(); _anaState.mesDe = dDe.getMonth();
    _anaState.anoAte = t.getFullYear(); _anaState.mesAte = t.getMonth();
  }
  _anaSaveState(); renderAnaliseModule();
}
function anaToggleAllMods(on){
  _anaState.modulos = on ? ANA_MODULOS.map(m => m.id) : [];
  _anaSaveState(); renderAnaliseModule();
}
function anaToggleMod(modId){
  const idx = _anaState.modulos.indexOf(modId);
  if(idx >= 0) _anaState.modulos.splice(idx, 1);
  else _anaState.modulos.push(modId);
  _anaSaveState(); renderAnaliseModule();
}
function anaSetStatusFilter(status){
  if(!['all','baixado','aberto'].includes(status)) return;
  _anaState.statusFilter = status;
  _anaSaveState();
  renderAnaliseModule();
}
try { window.anaSetStatusFilter = anaSetStatusFilter; } catch(e){}
