      else return {ok:false, value:''};
      s = s.slice(0, hit.nameStart) + sub + s.slice(hit.close + 1);
    }
    // Após substituições, só deve haver números, operadores, parênteses, ponto, "Math." e funções autorizadas
    const check = s.replace(/Math\.(max|min|abs|round|pow|sqrt)/g, '').replace(/\s/g,'');
