// Calcula a célula (col, row) do canvas onde o cursor está
function _anaCustomCellAt(e, canvas){
  const rect = canvas.getBoundingClientRect();
  const cs = getComputedStyle(canvas);
  const padL = parseFloat(cs.paddingLeft) || 0;
  const padT = parseFloat(cs.paddingTop) || 0;
  const padR = parseFloat(cs.paddingRight) || 0;
  const usableW = rect.width - padL - padR;
  const colW = usableW / 4;
  const gap = parseFloat(cs.gap) || parseFloat(cs.columnGap) || 12;
  const rowH = parseFloat(cs.gridAutoRows) || 120;
  const x = e.clientX - rect.left - padL;
  const y = e.clientY - rect.top - padT;
  let col = Math.floor(x / colW) + 1;
  let row = Math.floor(y / (rowH + gap)) + 1;
  if(col < 1) col = 1; if(col > 4) col = 4;
  if(row < 1) row = 1;
  return { col, row };
}

// Calcula índice de inserção baseado na posição do cursor relativa aos widgets.
// IMPORTANTE: exclui o widget que está sendo arrastado pra evitar "ficar parado" no
// próprio lugar quando o cursor passa perto da posição original.
function _anaCustomFindInsertIdx(e, canvas){
  let widgets = Array.from(canvas.querySelectorAll(':scope > .ana-custom-widget'));
  // Excluir o widget arrastado da contagem
  if(_anaCustomDraggingId != null){
    widgets = widgets.filter(w => parseInt(w.getAttribute('data-cw-id'),10) !== _anaCustomDraggingId);
  }
  if(widgets.length === 0) return 0;
  const x = e.clientX, y = e.clientY;
  let bestIdx = widgets.length;
  let bestDist = Infinity;
  widgets.forEach((w, i) => {
    const r = w.getBoundingClientRect();
    const cx = r.left + r.width/2;
    const cy = r.top + r.height/2;
    // Pondera Y mais que X (linha mais importante que coluna)
    const dx = x - cx, dy = (y - cy) * 1.5;
    const dist = Math.sqrt(dx*dx + dy*dy);
    if(dist < bestDist){
      bestDist = dist;
      bestIdx = (x < cx) ? i : (i + 1);
    }
  });
  // Converte índice "filtrado" pra índice real no array (compensa o widget excluído)
  if(_anaCustomDraggingId != null){
    const allArr = _anaState.custom;
    const draggingIdx = allArr.findIndex(w => w.id === _anaCustomDraggingId);
    if(draggingIdx >= 0 && bestIdx > draggingIdx) bestIdx++;
  }
  return bestIdx;
}
// Cria/atualiza um placeholder visual mostrando onde vai cair
function _anaCustomShowPlaceholder(canvas, idx){
  // Remove placeholders antigos
  document.querySelectorAll('.ana-cw-placeholder').forEach(p => p.remove());
  const widgets = Array.from(canvas.querySelectorAll(':scope > .ana-custom-widget'));
  const ph = document.createElement('div');
  ph.className = 'ana-cw-placeholder';
  if(idx >= widgets.length){
    canvas.appendChild(ph);
  } else {
    canvas.insertBefore(ph, widgets[idx]);
  }
}
function _anaCustomHidePlaceholder(){
  document.querySelectorAll('.ana-cw-placeholder').forEach(p => p.remove());
}

// Estado pra throttling do dragover via RAF
let _anaDragRAF = null;
let _anaDragLastEv = null;
function _anaCustomCanvasDragOver(e){
  if(!_anaCustomDraggingLib && _anaCustomDraggingId == null) return;
  // SEMPRE preventDefault (do contrário browser cancela drop)
  e.preventDefault();
  e.dataTransfer.dropEffect = _anaCustomDraggingLib ? 'copy' : 'move';
  // Captura dados do evento sincronamente (eventos podem ficar "stale" depois)
  _anaDragLastEv = {
    clientX: e.clientX, clientY: e.clientY,
    target: e.target, currentTarget: e.currentTarget
  };
  if(_anaDragRAF) return;  // já tem update pendente — pula
  _anaDragRAF = requestAnimationFrame(() => {
    _anaDragRAF = null;
    const ev = _anaDragLastEv;
    if(!ev) return;
    const canvas = ev.currentTarget;
    if(!canvas || !canvas.classList) return;
    // Marca canvas como "dragging" pra desligar transitions
    canvas.classList.add('dragging-active');
    // Em cima de widget? Deixa o handler do widget tratar
    const onWidget = ev.target.closest && ev.target.closest('.ana-custom-widget');
    if(onWidget){
      canvas.classList.remove('drop-active');
      _anaCustomHidePlaceholder();
      return;
    }
    canvas.classList.add('drop-active');
    const fakeEv = { clientX: ev.clientX, clientY: ev.clientY };
    const idx = _anaCustomFindInsertIdx(fakeEv, canvas);
    _anaCustomShowPlaceholder(canvas, idx);
  });
}
function _anaCustomCanvasDrop(e){
  if(!_anaCustomDraggingLib && _anaCustomDraggingId == null){
    _anaCustomHidePlaceholder(); return;
  }
  // Se caiu em cima de widget, deixa o handler do widget tratar
  const onWidget = e.target.closest && e.target.closest('.ana-custom-widget');
  if(onWidget){ _anaCustomHidePlaceholder(); return; }
  e.preventDefault();
  const canvas = e.currentTarget;
  const idx = _anaCustomFindInsertIdx(e, canvas);
  if(_anaCustomDraggingLib){
    // Drop de library — adiciona widget já posicionado na célula do cursor
    const w = ANA_WIDGETS[_anaCustomDraggingLib];
    if(w){
      const cell = _anaCustomCellAt(e, canvas);
      const cols = w.defaultCols;
      let col = cell.col;
      if(col + cols - 1 > 4) col = Math.max(1, 5 - cols);
      const defaultRows = w.category === 'chart' ? 2 : 1;
      _anaState.custom.push({
        id: _anaCustomNextId++,
        widget: _anaCustomDraggingLib,
        cols: cols,
        rows: defaultRows,
        colStart: col,
        rowStart: cell.row
      });
      _anaSaveState();
    }
  } else if(_anaCustomDraggingId != null){
    // Drop interno = posicionamento EXPLÍCITO via cell do cursor
    const arr = _anaState.custom;
    const widget = arr.find(w => w.id === _anaCustomDraggingId);
    if(widget){
      const cell = _anaCustomCellAt(e, canvas);
      // Ajusta col se widget for largo demais (não pode passar do col 4)
      const cols = widget.cols || 1;
      let col = cell.col;
      if(col + cols - 1 > 4) col = Math.max(1, 5 - cols);
      widget.colStart = col;
      widget.rowStart = cell.row;
      _anaSaveState();
    }
  }
  canvas.classList.remove('drop-active');
  _anaCustomHidePlaceholder();
  _anaCustomCleanupDrag();
  _anaRenderCustom();
}
