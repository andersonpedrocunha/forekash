function _dispoNewTpSetLiq(btn, liq){
  const group = btn.parentElement;
  group.querySelectorAll('button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  group.setAttribute('data-liq', liq);
}
function addDispoTipo(){
  const nome  = (document.getElementById('dispo-new-tp-nome').value || '').trim();
  const abrev = ((document.getElementById('dispo-new-tp-abrev').value || '').trim() || nome.slice(0,4)).toUpperCase();
  // Pega liquidez do segmented toggle
  const toggle = document.querySelector('.dispo-mgr-add-row .dispo-liq-toggle .active');
  const liq = (toggle && toggle.dataset.liq) || 'caixa';
  if(!nome){
    document.getElementById('dispo-new-tp-nome').focus();
    return;
  }
  const id = dispoNextId('tipos');
  dispo.tipos.push({ id, nome, abrev, liquidez: liq });
  dispoSave();
  renderDispoTipoManager();
  renderDispo();
}
function renameDispoTipo(id, nome){
  const t = dispoTipo(id); if(!t) return;
  t.nome = (nome||'').trim() || t.nome;
  dispoSave(); renderDispoTipoManager(); renderDispo();
}
function setDispoTipoAbrev(id, abrev){
  const t = dispoTipo(id); if(!t) return;
  t.abrev = ((abrev||'').trim()).toUpperCase() || t.abrev;
  dispoSave(); renderDispoTipoManager(); renderDispo();
}
function setDispoTipoLiq(id, liq){
  const t = dispoTipo(id); if(!t) return;
  t.liquidez = liq === 'reserva' ? 'reserva' : 'caixa';
  dispoSave(); renderDispoTipoManager(); renderDispo();
}
async function delDispoTipo(id){
  const used = dispo.contas.some(c => c.tipoId === id);
  if(used){ toast('⚠️ Tipo em uso — realoque as contas antes.'); return; }
  const t = dispoTipo(id); if(!t) return;
  const ok = await showConfirm({
    title: 'Excluir tipo',
    message: `Remover o tipo <strong>${esc(t.nome)}</strong>?`,
    confirmLabel: 'Excluir', destructive: true
  });
  if(!ok) return;
  dispo.tipos = dispo.tipos.filter(x => x.id !== id);
  dispoSave(); renderDispoTipoManager(); renderDispo();
}

