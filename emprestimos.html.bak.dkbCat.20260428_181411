async function delEstTipo(id){
  const used = estrutura.itens.some(it => it.tipoId === id);
  if(used){ toast('⚠️ Tipo em uso — altere as despesas antes.'); return; }
  const tp = estrutura.tipos.find(x=>x.id===id);
  const ok = await showConfirm({
    title: 'Excluir tipo',
    message: `Remover o tipo <strong>${tp?tp.nome:id}</strong>?`,
    confirmLabel: 'Excluir', destructive: true
  });
