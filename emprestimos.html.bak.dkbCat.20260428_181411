function viagAnexarFile(despId, input){
  const file = input.files && input.files[0];
  if(!file) return;
  if(file.size > 2 * 1024 * 1024){
    if(typeof toast === 'function') toast('⚠ Arquivo grande demais (máx 2 MB)');
    return;
  }
  const reader = new FileReader();
  reader.onload = (e) => {
    const v = _viagCurrent();
    if(!v || !v.despesas) return;
    if(_viagIsLocked(v)){ _viagToastLocked(); return; }
    const d = v.despesas.find(x => x.id === despId);
    if(!d) return;
    d.comprovante = { name: file.name, type: file.type, data: e.target.result };
    viagSave();
    _viagRenderEditor();
    if(typeof toast === 'function') toast('📎 Anexo salvo: ' + file.name);
  };
  reader.onerror = () => { if(typeof toast === 'function') toast('Erro ao ler arquivo'); };
  reader.readAsDataURL(file);
}
