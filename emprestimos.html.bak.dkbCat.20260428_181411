  if(!thead || !tbody || !tfoot) return;
  // Atualiza workspace de tag (se estiver aberto) — handlers como
  // setEstValor chamam só renderEstSheet, então hookar aqui garante sync.
  if(typeof _renderEstTagWorkspace === 'function'){
    setTimeout(_renderEstTagWorkspace, 0);
  }
  const year = estActiveYear;

  // HEAD (2 rows: ano / meses)
  const yrRow1 = `<tr class="yr">
    <th class="stk stk-1 l">Descrição</th>
    <th class="stk stk-2 l">Tag</th>
    <th class="stk stk-3 l">Tipo</th>
    <th colspan="12" style="text-align:center">${year}</th>
    <th class="yr-tot">Total</th>
    <th class="del"></th>
  </tr>`;
  const mesCols = EST_MESES.map(m => `<th class="mes">${m.toUpperCase()}/${year.slice(2)}</th>`).join('');
  const yrRow2 = `<tr class="mo">
    <th class="stk stk-1"></th>
    <th class="stk stk-2"></th>
    <th class="stk stk-3"></th>
    ${mesCols}
    <th class="yr-tot">R$</th>
    <th class="del"></th>
  </tr>`;
  thead.innerHTML = yrRow1 + yrRow2;

  // BODY
  const rows = [];
  if(estrutura.itens.length === 0){
    rows.push(`<tr class="est-empty-row"><td colspan="${3+12+2}">
      Nenhuma despesa cadastrada. Clique em <b>+ Nova despesa</b> para começar.
    </td></tr>`);
  } else {
    // Ordena: por tipo → tag → ordem de inserção
    const tipoOrder = new Map(estrutura.tipos.map((t,i)=>[t.id, i]));
    const tagOrder  = new Map(estrutura.tags.map((t,i)=>[t.id, i]));
    const sorted = estrutura.itens.slice().sort((a,b)=>{
      const ta = tipoOrder.has(a.tipoId)?tipoOrder.get(a.tipoId):999;
      const tb = tipoOrder.has(b.tipoId)?tipoOrder.get(b.tipoId):999;
      if(ta !== tb) return ta - tb;
      const ga = tagOrder.has(a.tagId)?tagOrder.get(a.tagId):999;
      const gb = tagOrder.has(b.tagId)?tagOrder.get(b.tagId):999;
      if(ga !== gb) return ga - gb;
      // Dentro do mesmo tipo+tag, mantém a ordem do array (sort estável) — isso
      // permite que o drag-reorder persista via reordenação de `estrutura.itens`.
      return 0;
    });
    for(const it of sorted){
      rows.push(renderEstRow(it, year));
    }
  }
  // Linhas VIRTUAIS de comissão — uma por vendedor ativo com valor no ano.
  // Somam nos totais mas não são editáveis (vêm do módulo Vendedores).
  const comissaoRows = _renderEstComissaoRows(year);
  for(const h of comissaoRows) rows.push(h);
  tbody.innerHTML = rows.join('');

  // FOOT: totais por mês + total ano (inclui comissões)
  const monthTotals = new Array(12).fill(0);
  let grand = 0;
  for(const it of estrutura.itens){
    for(let m=0;m<12;m++){
      const v = +it.valores[estMesKey(year, m)] || 0;
      monthTotals[m] += v;
      grand += v;
    }
  }
  // Soma comissões no total
  if(vendedores && Array.isArray(vendedores.lista)){
    for(const v of vendedores.lista){
      if(v.ativo === false) continue;
      for(let m=0;m<12;m++){
        const c = comissaoVendedorMes(v, year, m) || 0;
        if(c !== 0){ monthTotals[m] += c; grand += c; }
      }
    }
  }
  const mesTot = monthTotals.map(v =>
    `<td>${v ? fmtShortBR(v) : '<span style="color:#64748B">—</span>'}</td>`
  ).join('');

  tfoot.innerHTML = `
    <tr>
      <td class="stk stk-1 l">Gasto Fixo Total</td>
      <td class="stk stk-2"></td>
      <td class="stk stk-3"></td>
      ${mesTot}
      <td class="yr-tot">${fmtBRL(grand)}</td>
      <td></td>
    </tr>
  `;
}

function renderEstRow(it, year){
  const tipo = estTipo(it.tipoId);
  const tag  = estTag(it.tagId);

  const tipoOpts = estrutura.tipos.map(t =>
    `<option value="${esc(t.id)}"${it.tipoId===t.id?' selected':''}>${esc(t.nome)}</option>`
  ).join('');

  const tipoStyle = tipo
    ? `style="--tpc:${tipo.color};--tptx:${PES_TIPO_TXT}"`
    : '';
  const tipoCls = tipo ? 'filled' : 'empty';
  const rowStyle = tipo ? `style="--trc:${tipo.color}"` : '';
  const rowCls = 'est-row' + (tipo ? ' has-tipo' : '');

  // Tag pill:
  //   - Click esquerdo → picker (trocar tag) — comportamento original
  //   - Botão DIREITO → abre menu de contexto com opções (handler delegado)
  // Pill armazena tagId + itemId em data-attrs pro handler global usar.
  const tagPill = tag
    ? `<span class="est-tag-pill" data-est-tag-ws="${tag.id}" data-est-item="${it.id}"
             style="--tgc:${tag.color};--tgtx:${PES_TIPO_TXT}"
             onclick="openEstTagPicker(event, ${it.id})"
             title="${esc(tag.nome)} — clique p/ trocar · botão direito p/ mais opções">${esc(tag.nome)}</span>`
    : `<span class="est-tag-pill empty" onclick="openEstTagPicker(event, ${it.id})" title="Escolher tag">+ tag</span>`;

  // Valores mensais
  const pagosMap = it.pagos || {};
  const valCells = EST_MESES.map((_,m) => {
    const key = estMesKey(year, m);
    const v = it.valores[key];
    const hasReal = (v !== undefined && v !== null && v !== 0);
    const displayVal = hasReal ? fmtBR(v, 2) : '';
    const pago = hasReal && !!pagosMap[key];
    let cellExtra = '';
    if(pago) cellExtra += ' pago';
    if(!hasReal) cellExtra += ' empty';
    const btnPagar = hasReal
      ? `<button type="button" class="est-pagar-btn" tabindex="-1"
              onmousedown="event.preventDefault()"
              onclick="event.stopPropagation(); toggleEstPago(${it.id},'${key}')"
              title="${pago ? 'Marcar como não pago' : 'Marcar como pago'}">✓</button>`
      : '';
    const ro = pago ? ' readonly' : '';
    const roTitle = pago ? ' title="Remova o ✓ para editar"' : '';
    const roClick = pago ? ' onmousedown="notifyLocked()"' : '';
    return `<td class="pes-cell${cellExtra}">
      <input type="text" class="est-val-input" value="${displayVal}" placeholder="—"
             data-est-id="${it.id}" data-est-key="${key}"
             data-cellref="est:${it.id}:${key}"${ro}${roTitle}${roClick}
             onblur="setEstValor(${it.id}, '${key}', this.value); this.value = (this.value && !isNaN(parseBR(this.value))) ? fmtBR(parseBR(this.value),2) : ''"
             onfocus="this.value = this.value.replace(/\\./g,''); this.select()"
             onkeydown="if(event.key==='Enter') this.blur()">
      ${btnPagar}
    </td>`;
  }).join('');

  // Total do ano (só meses preenchidos)
  let tot = 0;
  for(let m=0;m<12;m++) tot += (+it.valores[estMesKey(year, m)] || 0);

  const estReorderAttrs = rowDragAttrs('est', it.id, true, `${it.tipoId||''}|${it.tagId||''}`);
  return `<tr class="${rowCls}" ${rowStyle} data-est-row="${it.id}" ${estReorderAttrs}>
    <td class="stk stk-1">
      <div class="est-name-wrap">
        ${rowHandleHtml()}
        <input type="text" class="est-name-input"
               value="${esc(it.nome)}" placeholder="Descrição da despesa"
               onblur="setEstNome(${it.id}, this.value)"
               onkeydown="if(event.key==='Enter') this.blur()">
      </div>
    </td>
    <td class="stk stk-2">
      <div class="est-tag-cell">
        ${tagPill}
      </div>
    </td>
    <td class="stk stk-3">
      <select class="est-tipo-sel ${tipoCls}" ${tipoStyle}
              onchange="setEstTipo(${it.id}, this.value)">
        <option value="">Sem tipo</option>
        ${tipoOpts}
      </select>
    </td>
    ${valCells}
    <td class="yr-tot" style="padding:0 12px;text-align:right;font-weight:700;background:#FFF5F7;color:#BE185D">
      ${tot ? fmtBRL(tot) : '<span style="color:#D1D5DB">—</span>'}
    </td>
    <td class="del" style="text-align:center">
      <button class="pes-row-btn" onclick="delEstItem(${it.id})" title="Excluir despesa">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m2 0v14a2 2 0 01-2 2H8a2 2 0 01-2-2V6"/>
        </svg>
      </button>
    </td>
  </tr>`;
}

function updateEstKpis(){
  const year = estActiveYear;
  let total = 0;
  // Pago × Projetado (por célula com valor real)
  let totalPago = 0;
  let totalProjetado = 0;
  let countPago = 0;
  let countComValor = 0;
  for(const it of estrutura.itens){
    const pagos = it.pagos || {};
    for(let m = 0; m < 12; m++){
      const key = estMesKey(year, m);
      const raw = it.valores[key];
      const v = +raw || 0;
      if(!v) continue; // 0 / null / undefined / NaN → nada a somar
      total += v;
      countComValor++;
      if(pagos[key]){
        totalPago += v;
        countPago++;
      } else {
        totalProjetado += v;
      }
    }
  }
  const avg = total / 12;
  const elT = document.getElementById('est-kpi-total');   if(elT) elT.textContent = fmtBRL(total);
  const elM = document.getElementById('est-kpi-media');   if(elM) elM.textContent = fmtBRL(avg);

  // Card split Pago × Projetado
  const elPago = document.getElementById('est-kpi-pago');
  const elProj = document.getElementById('est-kpi-projetado');
  if(elPago) elPago.textContent = fmtBRL(totalPago);
  if(elProj) elProj.textContent = fmtBRL(totalProjetado);

  // Variação vs ano anterior — card combinado (R$ + %).
  // Gasto SUBINDO (delta positivo) = ruim → vermelho. Gasto CAINDO = bom → verde.
  const prevYear = String(+year - 1);
  let prevTotal = 0;
  for(const it of estrutura.itens){
    for(let m=0;m<12;m++) prevTotal += (+it.valores[estMesKey(prevYear, m)] || 0);
  }
  const absEl   = document.getElementById('est-kpi-var-abs');
  const pctEl   = document.getElementById('est-kpi-var-pct');
  const subEl   = document.getElementById('est-kpi-var-sub');
  const card    = document.getElementById('est-kpi-var-card');
  const classesSinal = ['trend-up','trend-down','trend-neutral'];
  const setSinal = (el, cls) => {
    if(!el) return;
    for(const c of classesSinal) el.classList.remove(c);
    if(cls) el.classList.add(cls);
  };
  if(total === 0 && prevTotal === 0){
    if(absEl) absEl.textContent = '—';
    if(pctEl) pctEl.textContent = '—';
    if(subEl) subEl.textContent = 'sem dados em ' + prevYear;
    setSinal(card, 'trend-neutral');
  } else {
    const delta = total - prevTotal;
    const sinal = delta > 0 ? 'trend-up' : (delta < 0 ? 'trend-down' : 'trend-neutral');
    const prefix = delta > 0 ? '+' : (delta < 0 ? '−' : '');
    if(absEl) absEl.textContent = prefix + fmtBRL(Math.abs(delta));
    if(prevTotal > 0){
      const pct = (delta / prevTotal) * 100;
      const pctTxt = (pct > 0 ? '+' : (pct < 0 ? '−' : '')) +
                     Math.abs(pct).toLocaleString('pt-BR', {minimumFractionDigits:1, maximumFractionDigits:1}) + '%';
      if(pctEl) pctEl.textContent = pctTxt;
      if(subEl) subEl.textContent = 'vs ' + prevYear + ' (' + fmtBRL(prevTotal) + ')';
    } else {
      if(pctEl) pctEl.textContent = '—';
      if(subEl) subEl.textContent = 'sem gasto em ' + prevYear;
    }
    setSinal(card, sinal);
  }
}

// Reorder Estrutura de Custos: só permite reordenar dentro do mesmo tipo + mesma tag.
function reorderEstrutura(srcId, dstId, placeAbove){
  const src = estrutura.itens.find(it => String(it.id) === String(srcId));
  const dst = estrutura.itens.find(it => String(it.id) === String(dstId));
  if(!src || !dst) return;
  if((src.tipoId || '') !== (dst.tipoId || '')) return;
  if((src.tagId  || '') !== (dst.tagId  || '')) return;
  if(arrayReorder(estrutura.itens, src, dst, placeAbove)){
    estSave();
    renderEstSheet();
  }
}
ROW_REORDERERS.est = reorderEstrutura;

/* ─── Edit actions ─────────────────────────────────────── */
function addEstItem(){
  const item = {
    id: estrutura.nextId++,
    nome: '',
    tagId: '',
    tipoId: estrutura.tipos[0] ? estrutura.tipos[0].id : '',
    valores: {}
  };
  estrutura.itens.push(item);
  estSave();
  renderEstrutura();
  // Foca o input de nome da nova linha
  setTimeout(()=>{
    const row = document.querySelector(`tr[data-est-row="${item.id}"]`);
    const inp = row && row.querySelector('.est-name-input');
    if(inp) inp.focus();
  }, 30);
}

async function delEstItem(id){
  const it = estrutura.itens.find(x=>x.id===id);
  if(!it) return;
  const label = it.nome || '(sem nome)';
  const ok = await showConfirm({
    title: 'Excluir despesa',
    message: `Remover <strong>${label}</strong> e todos os seus valores mensais?`,
    confirmLabel: 'Excluir', destructive: true
  });
  if(!ok) return;
  estrutura.itens = estrutura.itens.filter(x => x.id !== id);
  estSave();
  renderEstrutura();
}

/* ─── Workspace por Tag (modal CRUD focado) ─────────────── */
let _estTagWsOpenId = null;
function openEstTagWorkspace(tagId){
  const tag = estTag(tagId);
  if(!tag){ try{ if(typeof toast==='function') toast('Tag não encontrada'); }catch(e){} return; }
  _estTagWsOpenId = tagId;
  let ov = document.getElementById('ov-est-tag-ws');
  if(!ov){
    ov = document.createElement('div');
    ov.className = 'confirm-overlay';
    ov.id = 'ov-est-tag-ws';
    ov.onclick = (e) => { if(e.target === ov) closeEstTagWorkspace(); };
    document.body.appendChild(ov);
  }
  // Esc fecha
  if(!_estTagWsOpenId._escHooked){
    document.addEventListener('keydown', _estTagWsOnKey);
    _estTagWsOpenId._escHooked = true;
  }
  _renderEstTagWorkspace();
}
function _estTagWsOnKey(e){
  if(e.key === 'Escape' && document.getElementById('ov-est-tag-ws')){
    closeEstTagWorkspace();
  }
}
function closeEstTagWorkspace(){
  _estTagWsOpenId = null;
  const ov = document.getElementById('ov-est-tag-ws');
  if(ov) ov.remove();
  document.removeEventListener('keydown', _estTagWsOnKey);
}
function _renderEstTagWorkspace(){
  if(_estTagWsOpenId == null) return;
  const ov = document.getElementById('ov-est-tag-ws');
  if(!ov) return;
  const tag = estTag(_estTagWsOpenId);
  if(!tag){ closeEstTagWorkspace(); return; }
  const year = estActiveYear;

  // Preserva scroll interno entre re-renders
  const _prevModal = ov.querySelector('.est-tag-ws-modal');
  const _prevScroll = _prevModal ? _prevModal.scrollTop : 0;

  const items = estrutura.itens.filter(it => it.tagId === tag.id);
  // KPIs
  let totalAno = 0, totalGeral = 0;
  const monthTot = new Array(12).fill(0);
  for(const it of estrutura.itens){
    for(let m=0;m<12;m++){
      const v = +it.valores[estMesKey(year, m)] || 0;
      totalGeral += v;
      if(it.tagId === tag.id){
        totalAno += v;
        monthTot[m] += v;
      }
    }
  }
  const mediaMes = totalAno / 12;
  const pctTotal = totalGeral > 0 ? (totalAno / totalGeral * 100) : 0;

  // Linhas
  const rowsHtml = items.length === 0
    ? `<tr><td colspan="${3+12+1}"><div class="est-tag-ws-empty">Nenhuma despesa nesta tag. Clique em <b>+ Nova despesa nesta tag</b> pra adicionar.</div></td></tr>`
    : items.map(it => _estTagWsRowHtml(it, year)).join('');

  const totMesCells = monthTot.map(v =>
    `<td>${v ? fmtShortBR(v) : '<span style="color:#94A3B8">—</span>'}</td>`
  ).join('');

  ov.innerHTML = `<div class="est-tag-ws-modal" onclick="event.stopPropagation()">
    <div class="est-tag-ws-hd" style="border-left:6px solid ${tag.color}">
      <div>
        <div class="est-tag-ws-eyebrow">DESPESAS RECORRENTES — TAG · ${esc(year)}</div>
        <h3>
          <span class="est-tag-ws-pill" style="background:${tag.color}">${esc(tag.nome)}</span>
          <span style="color:#6B7280;font-weight:600;font-size:.78rem">${items.length} ${items.length===1?'item':'itens'}</span>
        </h3>
      </div>
      <button class="est-tag-ws-close" onclick="closeEstTagWorkspace()" title="Fechar (Esc)">✕</button>
    </div>
    <div class="est-tag-ws-kpis">
      <div class="est-tag-ws-kpi" style="border-left-color:${tag.color}">
        <div class="lbl">Total no ano</div>
        <div class="val">${fmtBRL(totalAno)}</div>
      </div>
      <div class="est-tag-ws-kpi" style="border-left-color:${tag.color}">
        <div class="lbl">Média mensal</div>
        <div class="val">${fmtBRL(mediaMes)}</div>
      </div>
      <div class="est-tag-ws-kpi" style="border-left-color:${tag.color}">
        <div class="lbl">% do total geral</div>
        <div class="val">${pctTotal.toFixed(1).replace('.',',')}%</div>
      </div>
    </div>
    <div class="est-tag-ws-toolbar">
      <span>Edita valores na tabela. Hover na célula → ✓ pra dar/tirar baixa.</span>
      <button class="rec-tipo-filter-btn primary" onclick="addEstItemWithTag('${tag.id}')">
        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        Nova despesa nesta tag
      </button>
    </div>
    <div class="est-tag-ws-tbl-wrap">
      <table class="est-tag-ws-tbl">
        <thead><tr>
          <th class="lft">Descrição</th>
          <th class="c">Tipo</th>
          ${EST_MESES.map(m => `<th class="mes">${m.toUpperCase()}/${year.slice(2)}</th>`).join('')}
          <th class="r">Total</th>
          <th class="c"></th>
        </tr></thead>
        <tbody>${rowsHtml}</tbody>
        ${items.length > 0 ? `
        <tfoot><tr>
          <td class="lft">Total da tag</td>
          <td></td>
          ${totMesCells}
          <td class="r">${fmtBRL(totalAno)}</td>
          <td></td>
        </tr></tfoot>` : ''}
      </table>
    </div>
  </div>`;

  if(_prevScroll > 0){
    const newModal = ov.querySelector('.est-tag-ws-modal');
    if(newModal) newModal.scrollTop = _prevScroll;
  }
}
function _estTagWsRowHtml(it, year){
  const tipo = estTipo(it.tipoId);
  const tipoOpts = estrutura.tipos.map(t =>
    `<option value="${esc(t.id)}"${it.tipoId===t.id?' selected':''}>${esc(t.nome)}</option>`
  ).join('');
  const tipoStyle = tipo ? `style="--tpc:${tipo.color};--tptx:${PES_TIPO_TXT}"` : '';
  const tipoCls = tipo ? 'filled' : 'empty';
  const pagosMap = it.pagos || {};
  const valCells = EST_MESES.map((_,m) => {
    const key = estMesKey(year, m);
    const v = it.valores[key];
    const hasReal = (v !== undefined && v !== null && v !== 0);
    const displayVal = hasReal ? fmtBR(v, 2) : '';
    const pago = hasReal && !!pagosMap[key];
    let cellExtra = '';
    if(pago) cellExtra += ' pago';
    if(!hasReal) cellExtra += ' empty';
    const ro = pago ? ' readonly' : '';
    const btnPagar = hasReal
      ? `<button type="button" class="est-tag-ws-pagar" tabindex="-1"
              onmousedown="event.preventDefault()"
              onclick="event.stopPropagation(); _estTagWsTogglePago(${it.id},'${key}')"
              title="${pago ? 'Tirar baixa (pede confirmação)' : 'Dar baixa (marcar como pago)'}">✓</button>`
      : '';
    return `<td class="pes-cell est-tag-ws-cell${cellExtra}">
      <input type="text" value="${displayVal}" placeholder="—"${ro}
             onblur="setEstValor(${it.id}, '${key}', this.value); this.value = (this.value && !isNaN(parseBR(this.value))) ? fmtBR(parseBR(this.value),2) : ''"
             onfocus="this.value = this.value.replace(/\\./g,''); this.select()"
             onkeydown="if(event.key==='Enter') this.blur()">
      ${btnPagar}
    </td>`;
  }).join('');
  let tot = 0;
  for(let m=0;m<12;m++) tot += (+it.valores[estMesKey(year, m)] || 0);
  return `<tr>
    <td class="lft">
      <input type="text" class="est-tag-ws-name" value="${esc(it.nome)}" placeholder="Descrição"
             onblur="setEstNome(${it.id}, this.value)"
             onkeydown="if(event.key==='Enter') this.blur()">
    </td>
    <td class="c">
      <select class="est-tag-ws-tipo ${tipoCls}" ${tipoStyle}
              onchange="setEstTipo(${it.id}, this.value)">
        <option value="">— sem tipo —</option>
        ${tipoOpts}
      </select>
    </td>
    ${valCells}
    <td class="est-tag-ws-tot">${tot ? fmtBRL(tot) : '—'}</td>
    <td class="c">
      <button class="est-tag-ws-del" onclick="delEstItem(${it.id})" title="Excluir">✕</button>
    </td>
  </tr>`;
}
// Wrapper de toggle de baixa pro workspace — pede confirmação ao TIRAR a baixa.
async function _estTagWsTogglePago(id, key){
  const it = estrutura.itens.find(x => x.id === id);
  if(!it) return;
  const v = it.valores[key];
  if(v === undefined || v === null || v === 0) return;
  const isPago = !!(it.pagos && it.pagos[key]);
  if(isPago){
    // Tirando baixa → confirmação
    const MESES_LBL = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
    const [yy, mm] = key.split('-');
    const mesLbl = (MESES_LBL[parseInt(mm,10)-1] || mm) + '/' + String(yy).slice(2);
    const valFmt = (typeof fmtBRL === 'function') ? fmtBRL(v) : ('R$ ' + v);
    let ok = false;
    try {
      ok = await showConfirm({
        title: 'Tirar baixa?',
        message: 'Remover a baixa de <b>' + (it.nome || '(sem nome)') + '</b> em <b>' + mesLbl + '</b> (' + valFmt + ')? '
