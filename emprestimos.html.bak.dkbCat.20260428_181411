function _vendEditClose(){ _vendEditState = null; const o = document.getElementById('ov-vend-edit'); if(o) o.remove(); }
function _vendEditSave(){
  try {
    const st = _vendEditState;
    if(!st){ console.warn('[vend] _vendEditSave: sem state'); return; }
    // Fallback: se o handler inline falhou, lê direto do DOM
    const ov = document.getElementById('ov-vend-edit');
    if(ov){
      const nomeInp = ov.querySelector('.vend-top-row input[type=text]');
      if(nomeInp) st.nome = nomeInp.value;
      const ativoChk = ov.querySelector('.vend-ativo-tog input[type=checkbox]');
      if(ativoChk) st.ativo = ativoChk.checked;
      const pessoaSel = ov.querySelector('.vend-top-row select');
      if(pessoaSel){
        st.pessoaId = pessoaSel.value ? parseInt(pessoaSel.value, 10) : null;
      }
    } else {
      console.warn('[vend] _vendEditSave: modal #ov-vend-edit não encontrado');
    }
    // Se nome vazio mas tem pessoa vinculada → usa o nome da pessoa automaticamente
    if(!(st.nome||'').trim() && st.pessoaId && pessoas && Array.isArray(pessoas.people)){
      const p = pessoas.people.find(x => x.id === st.pessoaId);
      if(p && p.nome) st.nome = p.nome;
    }
    console.log('[vend] save — nome:', JSON.stringify(st.nome), 'state:', st);
    if(!(st.nome||'').trim()){
      try { if(typeof toast === 'function') toast('⚠️ Informe um nome ou vincule uma pessoa'); } catch(e){}
      return;
    }
    if(!vendedores) vendedoresLoad();
    if(!vendedores) vendedores = { lista: [], nextId: 1 };
    if(!Array.isArray(vendedores.lista)) vendedores.lista = [];
    const existing = vendedores.lista.findIndex(x => x.id === st.id);
    if(existing >= 0) vendedores.lista[existing] = st;
    else vendedores.lista.push(st);
    vendedoresSave();
    try { histCommit('salvar vendedor ' + st.nome); } catch(e){}
    try { renderVendSheet(); } catch(e){ console.error('renderVendSheet:',e); }
    try { if(typeof renderEstSheet === 'function') renderEstSheet(); } catch(e){}
    try { if(typeof renderFlxSheet === 'function') renderFlxSheet(); } catch(e){}
    try { if(typeof toast === 'function') toast('✅ Vendedor salvo'); } catch(e){}
    _vendEditClose();
  } catch(e){
    console.error('Erro ao salvar vendedor:', e);
    try { if(typeof toast === 'function') toast('⚠️ Erro: ' + (e.message||e), 5000); } catch(_){}
  }
}
