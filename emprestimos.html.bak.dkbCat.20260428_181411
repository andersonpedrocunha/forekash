function renderFeaturedPicker(){
  if(!settings) settingsLoad();
  const grid = document.getElementById('cfg-featured-grid');
  const counter = document.getElementById('cfg-featured-counter');
  if(!grid || !counter) return;

  const picked = Array.isArray(settings.featuredModules) ? settings.featuredModules.slice() : [];
  const atMax = picked.length >= FEATURED_MAX;

  grid.innerHTML = FEATURED_CANDIDATES.map(c => {
    const isChecked = picked.includes(c.key);
    const isDisabled = atMax && !isChecked;
    return `
      <label class="cfg-featured-opt${isChecked ? ' checked' : ''}${isDisabled ? ' disabled' : ''}">
        <input type="checkbox" ${isChecked ? 'checked' : ''} ${isDisabled ? 'disabled' : ''}
               onchange="toggleFeaturedModule('${c.key}', this.checked)" />
        <span class="cfg-featured-chk"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
        <span class="cfg-featured-lbl">${c.label}</span>
      </label>`;
  }).join('');

  counter.className = 'cfg-featured-counter' + (atMax ? ' full' : '');
  counter.innerHTML = `<strong>${picked.length}</strong> de ${FEATURED_MAX} selecionado${picked.length === 1 ? '' : 's'}`;
}

function toggleFeaturedModule(key, checked){
  if(!settings) settingsLoad();
  if(!Array.isArray(settings.featuredModules)) settings.featuredModules = [];
  // Bloqueia chaves inválidas (Início, configurações etc)
  if(!FEATURED_CANDIDATES.some(c => c.key === key)) return;
  const idx = settings.featuredModules.indexOf(key);
  if(checked){
    if(idx >= 0) return; // já tem
    if(settings.featuredModules.length >= FEATURED_MAX) return; // limite
    settings.featuredModules.push(key);
  } else {
    if(idx < 0) return;
    settings.featuredModules.splice(idx, 1);
  }
  settingsSave();
  applyFeaturedModules();
  renderFeaturedPicker();
  // Feedback visual
  const flag = document.getElementById('cfg-saved-flag');
  if(flag){ flag.classList.add('show'); setTimeout(() => flag.classList.remove('show'), 1400); }
}

