function viagDropCard(ev, newStatus){
  ev.preventDefault();
  ev.stopPropagation();
  document.querySelectorAll('.viag-kb-col.is-drop').forEach(el => el.classList.remove('is-drop'));
  if(_viagDraggedId == null) return;
  const v = viagens.itens.find(x => x.id === _viagDraggedId);
  _viagDraggedId = null;
  if(!v) return;
  if(v.status === newStatus) return;
  _viagChangeStatus(v, newStatus, /*context=*/'drag');
}
function _viagChangeStatus(v, newStatus, context){
  // Assinatura só pra Aprovado (Reembolsado/Finalizado é fase pós, não precisa)
  const needSig = _viagSettings.requireSignature && newStatus === 'aprovado';
  if(needSig){
    _viagOpenApprovalModal(v, newStatus);
    return;
  }
  // Rejeitado exige motivo sempre
  if(newStatus === 'rejeitado'){
    _viagOpenRejectModal(v);
    return;
  }
  v.status = newStatus;
  // Aging: marca fechamento se foi pra estado terminal, limpa se reabriu
  if(_viagIsClosed(v)){
    if(!v.fechadoEm) v.fechadoEm = new Date().toISOString();
  } else {
    if(v.fechadoEm) delete v.fechadoEm;
  }
  viagSave();
  renderViagens();
  if(_viagEditingId === v.id){ try { _viagRenderEditor(); } catch(e){} }
  if(typeof toast === 'function'){
    const stN = (_viagStatus(newStatus) || {}).nome;
    toast('→ ' + (v.titulo || 'Relatório') + ' movido para ' + stN);
  }
}
