// Estado de grupos colapsados (Set de moduloIds).
// Default: tudo colapsado no primeiro acesso. Após interação, persiste preferência.
const CATMAP_COLLAPSED_KEY = 'forekash:catmap:collapsed';
let _catmapCollapsedGroups = new Set();
try {
  const raw = localStorage.getItem(CATMAP_COLLAPSED_KEY);
  if(raw !== null){
    _catmapCollapsedGroups = new Set(JSON.parse(raw));
  } else {
    // Primeiro acesso: tudo colapsado
    _catmapCollapsedGroups = new Set(CATMAP_MODULOS.map(m => m.id));
    _catmapCollapsedGroups.add('__none__');
  }
} catch(_){}

function _catmapSaveCollapsed(){
  try { localStorage.setItem(CATMAP_COLLAPSED_KEY, JSON.stringify(Array.from(_catmapCollapsedGroups))); } catch(_){}
}

function catmapToggleGroup(moduloId){
  if(_catmapCollapsedGroups.has(moduloId)) _catmapCollapsedGroups.delete(moduloId);
  else _catmapCollapsedGroups.add(moduloId);
  _catmapSaveCollapsed();
  catmapRender();
}
function catmapExpandAll(){
  _catmapCollapsedGroups.clear();
  _catmapSaveCollapsed();
  catmapRender();
}
function catmapCollapseAll(){
  _catmapCollapsedGroups = new Set();
  // Pega todos os moduloIds existentes e marca como colapsados
  for(const c of (catmapData.categorias || [])){
    if(c.moduloId) _catmapCollapsedGroups.add(c.moduloId);
    else _catmapCollapsedGroups.add('__none__');
  }
  _catmapSaveCollapsed();
  catmapRender();
}
try {
  window.catmapToggleGroup = catmapToggleGroup;
  window.catmapExpandAll = catmapExpandAll;
  window.catmapCollapseAll = catmapCollapseAll;
} catch(e){}

// Helper: bloqueada = qualquer auto-descoberta que NÃO foi criada manualmente
// pelo usuário. userCreated=true é flag setada por catmapAdd.
function _catmapIsLocked(c){
  return !!(c && c.autoDiscovered && !c.userCreated);
}

function catmapRender(){
  _catmapPopulateForm();
  // Merge categorias descobertas dinamicamente (estrutura/receita/extrato/pessoas)
  try { _catmapMergeDiscovered(); } catch(e){ console.warn('catmap/merge:', e); }
  const wrap = document.getElementById('catmap-list');
  if(!wrap) return;
  const arr = catmapData.categorias || [];
  if(arr.length === 0){
    wrap.innerHTML = '<div class="catmap-empty">Nenhuma categoria cadastrada ainda.</div>';
    return;
  }
  // Cabeçalho de colunas (sticky, alinha com o grid das rows)
  const headerHtml = '<div class="catmap-row catmap-header" aria-hidden="true">'
    + '<span></span>'
    + '<div class="nm">Categoria</div>'
    + '<div class="meta">Módulo</div>'
    + '<div class="meta">DRC</div>'
    + '<div class="meta">DRE</div>'
    + '<div class="actions">Ações</div>'
    + '</div>';
  // Agrupa categorias por moduloId
  const moduloOrder = ['receita', 'estrutura', 'pessoas', 'emprestimos', 'impostos', 'comissoes', 'outrasRec', 'outrasDesp', 'extrato'];
  const groups = new Map(); // moduloId → array de categorias
  for(const c of arr){
    const k = c.moduloId || '__none__';
    if(!groups.has(k)) groups.set(k, []);
    groups.get(k).push(c);
  }
  // Sort dentro de cada grupo: nome alfabético
  for(const [k, cats] of groups){
    cats.sort((a,b) => (a.nome||'').localeCompare(b.nome||'','pt'));
  }
  // Build sorted list of (moduloId, label, cats) na ordem certa
  const groupedView = [];
  for(const mid of moduloOrder){
    if(groups.has(mid)){
      const lbl = (CATMAP_MODULOS.find(m => m.id === mid) || {}).nome || mid;
      groupedView.push({ moduloId: mid, label: lbl, cats: groups.get(mid) });
      groups.delete(mid);
    }
  }
  // Quaisquer outros (incluindo __none__) entram no fim
  for(const [k, cats] of groups){
    const lbl = (k === '__none__') ? '(sem módulo)' : ((CATMAP_MODULOS.find(m => m.id === k) || {}).nome || k);
    groupedView.push({ moduloId: k, label: lbl, cats });
  }
  let html = '';
  for(const grp of groupedView){
    const collapsed = _catmapCollapsedGroups.has(grp.moduloId);
    const caret = collapsed ? '▸' : '▾';
    html += '<div class="catmap-group-hd' + (collapsed ? ' is-collapsed' : '') + '" '
         +  'onclick="catmapToggleGroup(\'' + grp.moduloId + '\')">'
         +  '<span class="caret">' + caret + '</span>'
         +  '<span class="lbl">' + _extEsc(grp.label) + '</span>'
         +  '<span class="count">' + grp.cats.length + ' categoria' + (grp.cats.length === 1 ? '' : 's') + '</span>'
         +  '</div>';
    if(collapsed) continue;
    for(const c of grp.cats){
    if(_catmapEditingId === c.id){
      html += '<div class="catmap-row editing">'
        + '<input type="color" id="catmap-edit-cor-' + c.id + '" value="' + (c.cor || '#7C3AED') + '">'
        + '<input type="text" id="catmap-edit-nome-' + c.id + '" value="' + _extEsc(c.nome || '') + '" maxlength="60" onkeydown="if(event.key===\'Enter\') catmapSaveEdit(' + c.id + '); if(event.key===\'Escape\') catmapCancelEdit();">'
        + '<select id="catmap-edit-modulo-' + c.id + '" onchange="catmapApplySuggestion(' + c.id + ', true)">' + _catmapModuloOptions(c.moduloId || '') + '</select>'
        + '<select id="catmap-edit-drc-' + c.id + '">' + _catmapDRCOptions(c.drcLineId || '') + '</select>'
        + '<select id="catmap-edit-dre-' + c.id + '">' + _catmapDREOptions(c.dreLineId || '') + '</select>'
        + '<div class="actions">'
        +   '<button class="suggest" onclick="catmapApplySuggestion(' + c.id + ')" title="Aplicar sugestão de DRC/DRE">✨ Sugerir</button>'
        +   '<button class="save" onclick="catmapSaveEdit(' + c.id + ')">Salvar</button>'
        +   '<button class="cancel" onclick="catmapCancelEdit()">Cancelar</button>'
        + '</div>'
        + '</div>';
    } else {
      const modNm = catmapModuloNome(c.moduloId);
      const drcNm = catmapDRCNome(c.drcLineId);
      const dreNm = catmapDRENome(c.dreLineId);
      const isAuto = !!c.autoDiscovered;
      const isLocked = _catmapIsLocked(c);
      const origemBadge = isAuto && c.origem ? ('<span class="catmap-origem" title="' + _extEsc(c.origem) + '">' + _extEsc(c.origem) + '</span>') : '';
      const fullyMapped = !!(c.moduloId && c.drcLineId && c.dreLineId);
      html += '<div class="catmap-row' + (isAuto ? ' is-auto' : '') + (fullyMapped ? ' is-mapped' : '') + (isLocked ? ' is-locked' : '') + '">'
        + '<span class="dot" style="background:' + (c.cor || '#7C3AED') + '"></span>'
        + '<div class="nm" title="' + _extEsc(c.nome) + (isLocked ? ' (bloqueada)' : '') + '">' + _extEsc(c.nome) + origemBadge + '</div>'
        + '<div class="meta modulo"><span class="lbl">Módulo</span>' + (modNm ? _extEsc(modNm) : '<span class="none">— não definido —</span>') + '</div>'
        + '<div class="meta"><span class="lbl">DRC</span>' + (drcNm ? _extEsc(drcNm) : '<span class="none">— não definido —</span>') + '</div>'
        + '<div class="meta"><span class="lbl">DRE</span>' + (dreNm ? _extEsc(dreNm) : '<span class="none">— não definido —</span>') + '</div>'
        + '<div class="actions">'
        +   (isLocked ? '<span style="color:#94A3B8;font-size:.72rem;font-weight:600">Bloqueada</span>'
                     : ('<button class="edit" onclick="catmapStartEdit(' + c.id + ')" title="Definir vínculos">' + (fullyMapped ? '✎ Editar' : '+ Vincular') + '</button>'
                        + '<button class="del" onclick="catmapDelete(' + c.id + ')" title="Excluir">🗑</button>'))
        + '</div>'
        + '</div>';
    }
    }
  }
  wrap.innerHTML = headerHtml + html;
}

// Aplica sugestão de DRC/DRE nos selects do edit row de uma categoria.
// readModule=true: lê o moduloId atual do select de Módulo (pra reagir ao onchange).
function catmapApplySuggestion(id, readModule){
  const c = catmapById(id); if(!c) return;
  let moduloId = c.moduloId;
  if(readModule){
    const modEl = document.getElementById('catmap-edit-modulo-' + id);
    if(modEl) moduloId = modEl.value || '';
  }
  const sugg = _catmapSuggestVinculos({ nome: c.nome, moduloId: moduloId });
  const drcEl = document.getElementById('catmap-edit-drc-' + id);
  const dreEl = document.getElementById('catmap-edit-dre-' + id);
  if(drcEl) drcEl.value = sugg.drcLineId || '';
  if(dreEl) dreEl.value = sugg.dreLineId || '';
}
try { window.catmapApplySuggestion = catmapApplySuggestion; window._catmapSuggestVinculos = _catmapSuggestVinculos; } catch(e){}

// Cria categoria a partir do modal. Lê inputs do modal (catmap-modal-*),
// cria tag em estrutura.tags E cria entrada no catmap com userCreated=true.
// userCreated faz com que a categoria fique editable/deletable mesmo sendo
// auto-descoberta posteriormente.
function catmapAdd(){
  const inpN = document.getElementById('catmap-modal-nome');
  const inpC = document.getElementById('catmap-modal-cor');
  const tipoEl = document.getElementById('catmap-modal-tipo');
  if(!inpN) return;
  const nome = (inpN.value || '').trim();
  if(!nome){ if(typeof toast === 'function') toast('⚠ Digite um nome de categoria'); inpN.focus(); return; }
  const cor = (inpC && inpC.value) || '#7C3AED';
  const tipo = (tipoEl && tipoEl.value) || 'estrutura';
  // Dedup: nome único em catmapData (qualquer tipo)
  const dupCm = (catmapData.categorias || []).find(c => (c.nome||'').trim().toLowerCase() === nome.toLowerCase());
  if(dupCm){ if(typeof toast === 'function') toast('⚠ Já existe uma categoria com esse nome'); return; }
  // Lê DRC/DRE do modal (já pré-preenchidos pela sugestão)
  const drcEl = document.getElementById('catmap-modal-drc');
  const dreEl = document.getElementById('catmap-modal-dre');
  let drcVal = (drcEl && drcEl.value) || '';
  let dreVal = (dreEl && dreEl.value) || '';
  if(!drcVal || !dreVal){
    try {
      const sugg = _catmapSuggestVinculos({ nome: nome, moduloId: tipo });
      if(!drcVal) drcVal = sugg.drcLineId;
      if(!dreVal) dreVal = sugg.dreLineId;
    } catch(_){}
  }
  if(!Array.isArray(catmapData.categorias)) catmapData.categorias = [];

  if(tipo === 'estrutura'){
    // Cria tag em estrutura.tags + entry catmap (autoDiscovered=true + userCreated=true)
    if(typeof estrutura === 'undefined' || !estrutura){
      if(typeof toast === 'function') toast('⚠ Módulo Estrutura indisponível');
      return;
    }
    if(!Array.isArray(estrutura.tags)) estrutura.tags = [];
    const dupEst = estrutura.tags.find(t => (t.nome||'').trim().toLowerCase() === nome.toLowerCase());
    if(dupEst){ if(typeof toast === 'function') toast('⚠ Já existe uma tag em Estrutura com esse nome'); return; }
    const newTagId = (typeof estNextTagId === 'function') ? estNextTagId() : (Date.now() % 1000000);
    estrutura.tags.push({ id: newTagId, nome: nome, color: cor });
    if(typeof estSave === 'function') estSave();
    catmapData.categorias.push({
      id: catmapData.nextId++,
      nome: nome,
      moduloId: 'estrutura',
      drcLineId: drcVal,
      dreLineId: dreVal,
      cor: cor,
      autoDiscovered: true,
      userCreated: true,
      origem: 'Estrutura · tag',
      suggestionApplied: true
    });
    _catmapSave();
    catmapCloseModal();
    catmapRender();
    if(typeof toast === 'function') toast('✓ Categoria criada em Estrutura');
    return;
  }

  // outrasRec / outrasDesp: SÓ entry catmap (não cria tag em estrutura)
  if(tipo === 'outrasRec' || tipo === 'outrasDesp'){
    const origemLbl = (tipo === 'outrasRec') ? 'Outras Receitas · manual' : 'Outras Despesas · manual';
    catmapData.categorias.push({
      id: catmapData.nextId++,
      nome: nome,
      moduloId: tipo,
      drcLineId: drcVal,
      dreLineId: dreVal,
      cor: cor,
      autoDiscovered: false,
      userCreated: true,
      origem: origemLbl,
      suggestionApplied: true
    });
    _catmapSave();
    catmapCloseModal();
    catmapRender();
    if(typeof toast === 'function') toast('✓ Categoria criada em ' + (tipo === 'outrasRec' ? 'Outras Receitas' : 'Outras Despesas'));
    return;
  }

  // 'extrato': categoria livre só pro Extrato Financeiro (não propaga)
  if(tipo === 'extrato'){
    catmapData.categorias.push({
      id: catmapData.nextId++,
      nome: nome,
      moduloId: 'extrato',
      drcLineId: drcVal,
      dreLineId: dreVal,
      cor: cor,
      autoDiscovered: false,
      userCreated: true,
      origem: 'Apenas Extrato',
      suggestionApplied: true
    });
    _catmapSave();
    catmapCloseModal();
    catmapRender();
    if(typeof toast === 'function') toast('✓ Categoria criada (apenas Extrato)');
    return;
  }

  if(typeof toast === 'function') toast('⚠ Tipo de categoria desconhecido');
}

