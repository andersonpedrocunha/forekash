function dkbCardSave(propagateForward){
  const c = _dkbModalCtx; if(!c) return;
  const ad = DKB_ADAPTERS[c.ctxId];
  const it = (ad.items() || []).find(x => x.id === c.itemId);
  if(!it) return;
  const venc    = (document.getElementById('dkb-fld-venc')?.value    || '').trim();
  const pag     = (document.getElementById('dkb-fld-pag')?.value     || '').trim();
  const doc     = (document.getElementById('dkb-fld-doc')?.value     || '').trim();
  const emissao = (document.getElementById('dkb-fld-emissao')?.value || '').trim();
  const banco   = (document.getElementById('rec-kb-fld-banco-wrap')?.getAttribute('data-banco-id') || document.getElementById('rec-kb-fld-banco')?.value || '').trim();
  const fornecedorId = (function(){
    const w = document.getElementById('dkb-forn-wrap');
    const v = w ? w.getAttribute('data-forn-id') : '';
    return v ? parseInt(v, 10) : null;
  })();
  const ccRaw = (document.getElementById('dkb-fld-cc-wrap')?.getAttribute('data-cc-id') || document.getElementById('dkb-fld-cc')?.value || '').trim();
  const centroCustoId = ccRaw ? parseInt(ccRaw, 10) : null;
  const notas   = (document.getElementById('dkb-fld-notas')?.value   || '').trim();
  const formaPg = (document.getElementById('dkb-fld-forma')?.value || '').trim();
  const valorPagoRaw = (document.getElementById('dkb-fld-valpago')?.value || '').trim();
  const valorPagoNum = valorPagoRaw === '' ? null : _dkbParseNumBR(valorPagoRaw);
  const jurosNum = _dkbParseNumBR(document.getElementById('dkb-fld-juros')?.value);
  const multaNum = _dkbParseNumBR(document.getElementById('dkb-fld-multa')?.value);
  const descNum = _dkbParseNumBR(document.getElementById('dkb-fld-desc')?.value);
  if(venc && (venc < c.minDate || venc > c.maxDate)){
    if(typeof toast === 'function') toast('⚠ Vencimento deve estar dentro do mês de referência');
    return;
  }
  // Pra dar baixa (registrar pagamento), exige selecionar o banco
  if(pag && !banco){
    if(typeof toast === 'function') toast('⚠ Selecione o BANCO para dar baixa do pagamento');
    setTimeout(() => {
      const btn = document.getElementById('rec-kb-fld-banco-btn');
      if(btn){ btn.click(); btn.focus(); btn.scrollIntoView({block:'center', behavior:'smooth'}); }
    }, 50);
    return;
  }
  const meta = _dkbMeta(it, c.ym);
  if(venc) meta.dataVencimento = venc; else delete meta.dataVencimento;
  if(emissao) meta.dataEmissao = emissao; else delete meta.dataEmissao;
  if(doc) meta.numeroDocumento = doc; else delete meta.numeroDocumento;
  if(banco) meta.banco = banco; else delete meta.banco;
  if(fornecedorId) meta.fornecedorId = fornecedorId; else delete meta.fornecedorId;
  if(centroCustoId) meta.centroCustoId = centroCustoId; else delete meta.centroCustoId;
  if(notas) meta.notas = notas; else delete meta.notas;
  if(formaPg) meta.formaPagamento = formaPg; else delete meta.formaPagamento;
  if(valorPagoNum != null && isFinite(valorPagoNum) && valorPagoNum > 0) meta.valorPago = valorPagoNum; else delete meta.valorPago;
  if(jurosNum > 0) meta.juros = jurosNum; else delete meta.juros;
  if(multaNum > 0) meta.multa = multaNum; else delete meta.multa;
  if(descNum > 0) meta.desconto = descNum; else delete meta.desconto;
  // Anexos (sempre array): documento (Detalhes) e comprovante (Pagamento)
  if(Array.isArray(_dkbAnexoData) && _dkbAnexoData.length > 0) meta.anexo = _dkbAnexoData.slice(); else delete meta.anexo;
  if(Array.isArray(_dkbCompData)  && _dkbCompData.length > 0)  meta.comprovante = _dkbCompData.slice(); else delete meta.comprovante;
  if(pag){
    meta.dataPagamento = pag;
    ad.setPago(it, c.ym, true);
  } else {
    delete meta.dataPagamento;
    ad.setPago(it, c.ym, false);
  }
  if(ad.save) ad.save();

  // ─── Itens adicionais: cria entries em estrutura via auto-propagação ───
  try {
    const itensAdd = (Array.isArray(_dkbItems) ? _dkbItems : []).filter(x => (parseFloat(x.valor)||0) > 0);
    if(itensAdd.length > 0 && typeof _extAutoPropagate === 'function'){
      const ymStr = c.ym + '-' + (venc ? venc.slice(8,10) : '01');
      // Resolve nome do banco a partir do id
      let contaNome = '';
      try {
        if(banco && typeof dispo !== 'undefined' && Array.isArray(dispo.bancos)){
          const b = dispo.bancos.find(x => x.id === banco);
          if(b) contaNome = b.nome || '';
        }
      } catch(_){}
      // Resolve nome do fornecedor a partir do id (usado como fallback do contraparte)
      let fornNome = '';
      try {
        if(fornecedorId && typeof pessoas !== 'undefined' && Array.isArray(pessoas.registry)){
          const f = pessoas.registry.find(r => r.id === fornecedorId);
          if(f) fornNome = f.nome || '';
        }
      } catch(_){}
      // Gera grupoId compartilhado
      const grupoId = 'g:' + Date.now() + ':' + Math.floor(Math.random()*9999);
      // Marca a célula atual também com esse grupoId (para vinculação visual futura)
      meta.grupoId = grupoId;
      let countCriado = 0;
      for(const it of itensAdd){
        const propResult = _extAutoPropagate({
          tipo: 'gasto',
          data: ymStr,
          valor: it.valor,
          descricao: it.descricao || ('Item adicional - ' + ymStr),
          categoria: it.categoria || '',
          contraparte: it.contraparte || fornNome,
          conta: contaNome,
          status: pag ? 'pago' : 'pendente',
          notas: notas,
          tipo: 'gasto',
          centroCustoId: centroCustoId,
          dataPagamento: pag,
          grupoId: grupoId
        });
        if(propResult && propResult.propagated) countCriado++;
      }
      if(countCriado > 0){
        if(ad.save) ad.save();
        if(typeof toast === 'function') toast('✓ ' + countCriado + ' item' + (countCriado>1?'ns':'') + ' adicionado' + (countCriado>1?'s':'') + ' à Estrutura');
      }
    }
  } catch(e){ console.warn('dkb itens adicionais:', e); }

  // ─── Repetição: aplica o valor da célula atual nos próximos N meses ───
  try {
    const repCfg = _repReadCfg('dkb', venc || c.ym + '-01');
    if(repCfg && repCfg.mode !== 'once' && repCfg.count > 1){
      const f = _EXT_FREQ.find(x => x.id === repCfg.freq) || { mes:1 };
      const valoresAtual = ad.valoresOf(it) || {};
      const valNum = parseFloat(valoresAtual[c.ym]) || 0;
      const ymParts = c.ym.split('-');
      const y0 = parseInt(ymParts[0],10), mo0 = parseInt(ymParts[1],10) - 1;
      let countCriado = 0;
      // Começa em i=1 (i=0 é a célula atual, já salva)
      for(let i=1; i<repCfg.count; i++){
        const ymo = mo0 + i*f.mes;
        const yi = y0 + Math.floor(ymo/12);
        const mi = ((ymo % 12) + 12) % 12;
        const ymTarget = yi + '-' + String(mi+1).padStart(2,'0');
        // Define o valor (sempre, mesmo que já exista — sobrescreve)
        valoresAtual[ymTarget] = valNum;
        // Copia metadata relevante (banco, fornecedor, CC, doc, emissão, notas, anexo)
        const omTarget = _dkbMeta(it, ymTarget);
        if(banco) omTarget.banco = banco; else delete omTarget.banco;
        if(fornecedorId) omTarget.fornecedorId = fornecedorId; else delete omTarget.fornecedorId;
        if(centroCustoId) omTarget.centroCustoId = centroCustoId; else delete omTarget.centroCustoId;
        if(doc) omTarget.numeroDocumento = doc; else delete omTarget.numeroDocumento;
        if(emissao) omTarget.dataEmissao = emissao; else delete omTarget.dataEmissao;
        if(notas) omTarget.notas = notas; else delete omTarget.notas;
        // Vencimento ajustado
        if(venc){
          const day = venc.slice(8,10);
          const lastD = new Date(yi, mi+1, 0).getDate();
          const dd = Math.min(parseInt(day,10), lastD);
          omTarget.dataVencimento = ymTarget + '-' + String(dd).padStart(2,'0');
        }
        // As repetições NÃO ficam pagas — começa pendente
        ad.setPago(it, ymTarget, false);
        delete omTarget.dataPagamento;
        delete omTarget.valorPago;
        delete omTarget.juros;
        delete omTarget.multa;
        delete omTarget.desconto;
        delete omTarget.formaPagamento;
        delete omTarget.comprovante;
        countCriado++;
      }
      if(countCriado > 0){
        if(ad.save) ad.save();
        if(typeof toast === 'function') toast('✓ Repetido em ' + countCriado + ' meses seguintes');
      }
    }
  } catch(e){ console.warn('dkb repetição:', e); }

  // ─── "Salvar este e os próximos" — replica APENAS os campos alterados ───
  if(propagateForward){
    try {
      const diff = {};
      if((c.prevDataVencimento || '') !== (venc || '')) diff.dataVencimento = venc;
      if((c.prevBanco || '') !== (banco || '')) diff.banco = banco;
      if((c.prevFornecedorId || null) !== (fornecedorId || null)) diff.fornecedorId = fornecedorId;
      if((c.prevCentroCustoId || null) !== (centroCustoId || null)) diff.centroCustoId = centroCustoId;
      const valoresFwd = ad.valoresOf(it) || {};
      let countFwd = 0;
      const keysDiff = Object.keys(diff);
      if(keysDiff.length > 0){
        for(const ymO of Object.keys(valoresFwd)){
          if(ymO <= c.ym) continue; // só pra frente
          const v = parseFloat(valoresFwd[ymO]);
          if(!isFinite(v) || v === 0) continue;
          const om = _dkbMeta(it, ymO);
          for(const k of keysDiff){
            if(k === 'dataVencimento'){
              if(diff.dataVencimento){
                const day = diff.dataVencimento.slice(8,10);
                const parts = ymO.split('-');
                const yo = parseInt(parts[0],10), mo = parseInt(parts[1],10) - 1;
                const lastD = new Date(yo, mo+1, 0).getDate();
                const dd = Math.min(parseInt(day,10), lastD);
                om.dataVencimento = ymO + '-' + String(dd).padStart(2,'0');
              } else delete om.dataVencimento;
            } else {
              if(diff[k]) om[k] = diff[k]; else delete om[k];
            }
          }
          countFwd++;
        }
        if(countFwd > 0){ if(ad.save) ad.save(); }
      }
      dkbCardClose();
      dkbRender(c.ctxId);
      if(ad.onSheetReturn) try { ad.onSheetReturn(); } catch(_){}
      if(typeof toast === 'function'){
        if(keysDiff.length === 0) toast('✓ Salvo (nenhum campo alterado pra replicar)');
        else toast('✓ Salvo · ' + keysDiff.length + ' campo(s) replicado(s) em ' + countFwd + ' mês(es) seguintes');
      }
    } catch(e){ console.warn('propagate forward:', e); }
    return; // skip os prompts antigos
  }

  // ─── Detecção de updates pra prompts (vencimento + fornecedor) ───
  const prevForn = c.prevFornecedorId || null;
  const newForn  = fornecedorId || null;
  const fornChanged = (prevForn !== newForn);
  const prevVenc = c.prevDataVencimento || '';
  const newVenc  = venc || '';
  const vencChanged = (prevVenc !== newVenc);

  // Vencimento — propagar dia pra próximos meses do MESMO item
  let vencFutureUpdates = [];
  if(newVenc && vencChanged){
    try {
      const day = newVenc.slice(8,10);
      const valores = ad.valoresOf(it) || {};
      for(const ymO of Object.keys(valores)){
        if(ymO <= c.ym) continue; // só pra frente
        const v = parseFloat(valores[ymO]);
        if(!isFinite(v) || v === 0) continue;
        const om = (it.meta && it.meta[ymO]) || {};
        const curDay = om.dataVencimento ? om.dataVencimento.slice(8,10) : '';
        if(curDay === day) continue; // já está OK
        vencFutureUpdates.push(ymO);
      }
    } catch(e){ console.warn('compute venc updates:', e); }
  }

  // Fornecedor — propagar pra outros lançamentos com mesma descrição
  let fornUpdates = [];
  if(newForn && fornChanged){
    try {
      const itemName = ad.nameOf(it);
      for(const otherIt of (ad.items() || [])){
        if(ad.nameOf(otherIt) !== itemName) continue;
        const otherValores = ad.valoresOf(otherIt) || {};
        for(const otherYm of Object.keys(otherValores)){
          const v = parseFloat(otherValores[otherYm]);
          if(!isFinite(v) || v === 0) continue;
          if(otherIt === it && otherYm === c.ym) continue;
          const om = _dkbMeta(otherIt, otherYm);
          if(om.fornecedorId !== newForn) fornUpdates.push({ it: otherIt, ym: otherYm });
        }
      }
    } catch(e){ console.warn('compute forn updates:', e); }
  }

  dkbCardClose();
  dkbRender(c.ctxId);
  if(typeof toast === 'function') toast(pag ? '✓ Pagamento registrado' : '✓ Item atualizado');

  // ─── Encadeia os prompts: vencimento → fornecedor ───
  let chain = Promise.resolve();
  if(vencFutureUpdates.length > 0){
    const day = newVenc.slice(8,10);
    chain = chain.then(() => _dkbConfirm({
      icon: '📅',
      title: 'Aplicar vencimento aos próximos meses?',
      html: 'Replicar o <b>dia ' + day + '</b> como data de vencimento dos próximos <b>' + vencFutureUpdates.length + '</b> mês(es) de <b>"' + _dkbEsc(ad.nameOf(it)) + '"</b>?'
        + '<div class="dkb-confirm-meta">📅 dia <b>' + day + '</b> · ' + vencFutureUpdates.length + ' mês(es) à frente</div>',
      okText: 'Sim, replicar nos próximos',
      cancelText: 'Não, só este'
    }).then(ok => {
      if(!ok) return;
      for(const ymO of vencFutureUpdates){
        const om = _dkbMeta(it, ymO);
        const parts = ymO.split('-');
        const yo = parseInt(parts[0],10), mo = parseInt(parts[1],10) - 1;
        const lastD = new Date(yo, mo+1, 0).getDate();
        const dd = Math.min(parseInt(day,10), lastD);
        om.dataVencimento = ymO + '-' + String(dd).padStart(2,'0');
      }
      if(ad.save) ad.save();
      dkbRender(c.ctxId);
      if(typeof toast === 'function') toast('✓ Vencimento aplicado a ' + vencFutureUpdates.length + ' mês(es)');
    }));
  }
  if(fornUpdates.length > 0){
    const fr = _dkbFornById(newForn);
    const fornNome = fr ? (fr.nome || '') : '';
    const tipoLbl = fr && fr.tipoPessoa === 'pf' ? 'PF' : (fr && fr.tipoPessoa === 'est' ? 'Estrangeiro' : 'PJ');
    const docLbl = fr && fr.cnpj ? _dkbFmtCNPJ(fr.cnpj) : (fr && fr.cpf ? _dkbFmtCPF(fr.cpf) : (fr && fr.documento ? fr.documento : ''));
    chain = chain.then(() => _dkbConfirm({
      icon: '🔗',
      title: 'Vincular outros lançamentos?',
      html: 'Encontrei <b>' + fornUpdates.length + '</b> outro(s) lançamento(s) com a descrição <b>"' + _dkbEsc(ad.nameOf(it)) + '"</b>.<br><br>Deseja vincular todos ao fornecedor abaixo?'
        + '<div class="dkb-confirm-meta">'
        +   '🏢 <b>' + _dkbEsc(fornNome) + '</b> · ' + tipoLbl + (docLbl ? ' · ' + _dkbEsc(docLbl) : '')
        + '</div>',
      okText: 'Sim, vincular todos',
      cancelText: 'Não, só este'
    }).then(ok => {
      if(!ok) return;
      for(const { it: itx, ym: ymx } of fornUpdates){
        const m = _dkbMeta(itx, ymx);
        m.fornecedorId = newForn;
      }
      if(ad.save) ad.save();
      dkbRender(c.ctxId);
      if(typeof toast === 'function') toast('✓ ' + fornUpdates.length + ' lançamento(s) vinculados a ' + fornNome);
    }));
  }
}

// Modal de confirmação custom (substitui confirm() nativo do browser)
function _dkbConfirm(opts){
  opts = opts || {};
  return new Promise(resolve => {
    const old = document.getElementById('dkb-confirm-modal-ov');
    if(old) old.remove();
    const ov = document.createElement('div');
    ov.id = 'dkb-confirm-modal-ov';
    ov.className = 'dkb-confirm-modal-ov';
    let resolved = false;
    const close = (val) => {
      if(resolved) return; resolved = true;
      ov.remove();
      document.removeEventListener('keydown', escH);
      resolve(val);
    };
    ov.onclick = (e) => { if(e.target === ov) close(false); };
