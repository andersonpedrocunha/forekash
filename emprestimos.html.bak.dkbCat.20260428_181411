// DEMONSTRATIVO — Personalização de estrutura (labels, hidden, linhas custom)
//   flxStruct = {
//     drc: { labels:{[id]:str}, hidden:[ids] },
//     dre: { labels:{[id]:str}, hidden:[ids] },
//     custom: [{id, nome, secao, sinal:'+'|'-', values:{[year]:{[mIdx]:n}}}]
//   }
//   Labels e hidden são por VISTA (DRC e DRE independentes).
//   Linhas custom são compartilhadas (mesmo id aparece nas duas).
// ═══════════════════════════════════════════════════════════════════════════
const FLX_STRUCT_KEY = 'flx_struct_v1';
let flxStruct = {
  version: 1,
  drc:   { labels:{}, hidden:[] },
  dre:   { labels:{}, hidden:[] },
  custom:[]
};
(function _flxStructLoad(){
  try {
    const raw = localStorage.getItem(FLX_STRUCT_KEY);
    if(raw){
      const o = JSON.parse(raw);
      if(o && typeof o === 'object'){
        flxStruct = Object.assign({ version:1 }, flxStruct, o);
      }
    }
  } catch(e){}
  flxStruct.drc = flxStruct.drc || { labels:{}, hidden:[] };
  flxStruct.dre = flxStruct.dre || { labels:{}, hidden:[] };
  flxStruct.drc.labels = flxStruct.drc.labels || {};
  flxStruct.drc.hidden = Array.isArray(flxStruct.drc.hidden) ? flxStruct.drc.hidden : [];
  flxStruct.dre.labels = flxStruct.dre.labels || {};
  flxStruct.dre.hidden = Array.isArray(flxStruct.dre.hidden) ? flxStruct.dre.hidden : [];
  flxStruct.custom = Array.isArray(flxStruct.custom) ? flxStruct.custom : [];
})();
function flxStructSave(){
  try { localStorage.setItem(FLX_STRUCT_KEY, JSON.stringify(flxStruct)); } catch(e){}
  try { histCommit('estrutura DRC/DRE'); } catch(e){}
}

// Label: busca override da vista; senão usa default.
function flxLabel(view, lineId, def){
  const v = flxStruct[view];
  const ov = v && v.labels && v.labels[lineId];
  return (typeof ov === 'string' && ov.trim().length > 0) ? ov.trim() : def;
}
// Hidden para uma vista específica.
function flxIsHidden(view, lineId){
  const v = flxStruct[view];
  return !!(v && Array.isArray(v.hidden) && v.hidden.indexOf(lineId) >= 0);
}
// Linhas custom de uma seção.
function flxCustomLines(secao){
  return (flxStruct.custom || []).filter(c => c && c.secao === secao);
}
// Valor mensal de uma linha custom (0 se vazio).
function flxCustomValMes(id, year, mIdx){
  const c = (flxStruct.custom || []).find(x => x && x.id === id);
  if(!c || !c.values) return 0;
  const yr = c.values[year];
  if(!yr) return 0;
  const v = yr[mIdx];
  if(v === undefined || v === '' || v === null) return 0;
  return parseFloat(v) || 0;
}
// Setter — chamado pelo input da célula custom.
function flxSetCustomVal(id, year, mIdx, raw){
  const c = (flxStruct.custom || []).find(x => x && x.id === id);
  if(!c) return;
  c.values = c.values || {};
  c.values[year] = c.values[year] || {};
  const txt = (raw || '').toString().trim();
  if(txt === ''){
    delete c.values[year][mIdx];
  } else {
    const n = (typeof parseBR === 'function') ? parseBR(txt) : parseFloat(txt.replace(',', '.'));
    if(!Number.isFinite(n) || n === 0) delete c.values[year][mIdx];
    else c.values[year][mIdx] = n;
  }
  flxStructSave();
  renderFlxSheet();
}
// Contribuição líquida de linhas custom de uma seção num mês (respeita sinal).
//   sinal '+' → adiciona ao caixa desta seção
//   sinal '-' → subtrai
function flxCustomSecaoMes(secao, year, mIdx){
  let s = 0;
  for(const c of flxCustomLines(secao)){
    const v = flxCustomValMes(c.id, year, mIdx);
    s += (c.sinal === '-' ? -v : v);
  }
  return s;
}
// Wrapper legacy (ainda usado em updateFlxKpis etc).
function flxCustomAjusteMes(year, mIdx){ return flxCustomSecaoMes('ajustes_caixa', year, mIdx); }
// Metadados das seções customizáveis (catálogo exibido no modal)
const FLX_CUST_SECOES = [
  { id:'custos_op',     nome:'Custos Operacionais',  hint:'Dentro de Gasto Total (DRC) · antes do EBITDA (DRE)',
    ex:'ex: Consultoria, Marketing, Comissões' },
  { id:'financeiro',    nome:'Resultado Financeiro', hint:'Junto com Empréstimos (DRC) · depois de Juros (DRE)',
    ex:'ex: Juros bancários extras, Receita de aplicação' },
  { id:'ajustes_caixa', nome:'Ajustes de Caixa',     hint:'Grupo não operacional no fim da tabela',
    ex:'ex: Aporte de sócio, Dividendos, Investimento' }
];
function flxCustSecaoLabel(id){
  const s = FLX_CUST_SECOES.find(x => x.id === id);
  return s ? s.nome : id;
}
// ID novo para custom line
function _flxCustomId(){
  let n = 1;
  const used = new Set((flxStruct.custom || []).map(c => c.id));
  while(used.has('cust_' + n)) n++;
  return 'cust_' + n;
}
function flxAddCustomLine(nome, secao, sinal){
  const c = {
    id: _flxCustomId(),
    nome: (nome || '').trim() || 'Nova linha',
    secao: secao || 'ajustes_caixa',
    sinal: (sinal === '-') ? '-' : '+',
    values: {}
  };
  flxStruct.custom.push(c);
  flxStructSave();
  return c.id;
}
function flxRemoveCustomLine(id){
  const i = (flxStruct.custom || []).findIndex(c => c && c.id === id);
  if(i < 0) return false;
  flxStruct.custom.splice(i, 1);
  flxStructSave();
  return true;
}
function flxSetLabel(view, lineId, label){
  if(!flxStruct[view]) return;
  flxStruct[view].labels = flxStruct[view].labels || {};
  const t = (label || '').trim();
  if(t.length === 0) delete flxStruct[view].labels[lineId];
  else flxStruct[view].labels[lineId] = t;
  flxStructSave();
}
function flxToggleHidden(view, lineId, hidden){
  if(!flxStruct[view]) return;
  flxStruct[view].hidden = Array.isArray(flxStruct[view].hidden) ? flxStruct[view].hidden : [];
  const arr = flxStruct[view].hidden;
  const i = arr.indexOf(lineId);
  if(hidden && i < 0) arr.push(lineId);
  else if(!hidden && i >= 0) arr.splice(i, 1);
  flxStructSave();
}
function flxResetStruct(view){
  if(view === 'drc' || view === 'dre'){
    flxStruct[view] = { labels:{}, hidden:[] };
  } else if(view === 'custom'){
    flxStruct.custom = [];
  } else { // 'all'
    flxStruct.drc = { labels:{}, hidden:[] };
    flxStruct.dre = { labels:{}, hidden:[] };
    flxStruct.custom = [];
  }
  flxStructSave();
}
function _flxAnaSave(){
  try { localStorage.setItem(FLX_ANA_KEY, JSON.stringify({av:flxShowAV, ah:flxShowAH})); }
  catch(e) {}
}
function toggleFlxAnalise(which){
  if(which === 'av') flxShowAV = !flxShowAV;
  else if(which === 'ah') flxShowAH = !flxShowAH;
