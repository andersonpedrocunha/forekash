    /* Tooltip custom — funciona em qualquer elemento com [data-tooltip] */
    [data-tooltip]{position:relative}
    [data-tooltip]:hover::before{
      content:attr(data-tooltip);position:absolute;bottom:calc(100% + 8px);left:50%;
      transform:translateX(-50%);background:#1F2937;color:#fff;font-size:.7rem;
      font-weight:600;padding:7px 11px;border-radius:6px;
      white-space:normal;width:max-content;max-width:260px;
      line-height:1.4;letter-spacing:.01em;text-align:left;
      box-shadow:0 6px 20px rgba(0,0,0,.25);z-index:99999;
      pointer-events:none;font-family:inherit;text-transform:none}
    [data-tooltip]:hover::after{
      content:'';position:absolute;bottom:calc(100% + 2px);left:50%;
      transform:translateX(-50%);border:6px solid transparent;
      border-top-color:#1F2937;pointer-events:none;z-index:99999}
    /* Quando estiver na borda direita, alinhar tooltip à direita */
    .ana-hero-hd .help[data-tooltip]:hover::before{
      left:auto;right:0;transform:none}
