// Tempo de contrato do cliente em formato "X anos e Y meses" (ou "—" se não há data).
// ─── Ciclos de contrato ───────────────────────────────────────────
// Clientes de serviço podem sair e voltar. Modelamos isso como uma lista
// de ciclos {inicio, fim}. O último ciclo sem "fim" é o contrato vigente.

// Retorna os ciclos do cliente, garantindo que seja sempre um array.
function clienteCiclos(c){
  if(!c) return [];
  if(!Array.isArray(c.ciclos)) c.ciclos = [];
  return c.ciclos;
}

// Ciclo vigente = último ciclo sem "fim" preenchido.
function cicloVigente(c){
  const lst = clienteCiclos(c);
  for(let i = lst.length - 1; i >= 0; i--){
    if(lst[i] && !lst[i].fim) return lst[i];
  }
  return null;
}

// Parseia 'YYYY-MM-DD' como data local (sem surpresa de timezone). Retorna Date ou null.
function parseIsoDate(s){
  if(!s || typeof s !== 'string') return null;
  const [y, m, d] = s.split('-').map(Number);
  if(!y || !m || !d) return null;
  return new Date(y, m-1, d);
}

// Soma de meses (com dias residuais como aproximação) entre inicio e fim.
// Retorna {anos, meses, meses_total, start, end} ou null se inválido.
function diffAnosMesesEntre(iniIso, fimIso){
  const start = parseIsoDate(iniIso);
  const end   = fimIso ? parseIsoDate(fimIso) : new Date();
  if(!start) return null;
  if(!end) return null;
  if(end < start) return null;
  let anos  = end.getFullYear() - start.getFullYear();
  let meses = end.getMonth()    - start.getMonth();
  const dias = end.getDate() - start.getDate();
  if(dias < 0) meses -= 1;
  if(meses < 0){ anos -= 1; meses += 12; }
  const meses_total = anos * 12 + meses + Math.max(0, dias) / 30; // fracionário só p/ LTV
  return {anos, meses, meses_total, start, end};
}

// Tempo total contratado = soma das durações de todos os ciclos (inclusive o vigente
// medido até hoje). Retorna rótulos para UI e o span "agregado" em anos/meses.
function clienteTempoContrato(c){
  if(!c) return {label:'—', durLabel:'—', span:null};
  const ciclos = clienteCiclos(c).filter(p => p && p.inicio);
  if(ciclos.length === 0){
    return {label:'—', durLabel:'Sem ciclos de contrato', span:null};
  }

  let totalMeses = 0;
  let algumAtivo = false;
  for(const p of ciclos){
    const df = diffAnosMesesEntre(p.inicio, p.fim || '');
    if(!df) continue;
    totalMeses += df.anos * 12 + df.meses;
    if(!p.fim) algumAtivo = true;
  }
  if(totalMeses < 1){
    // Menos de um mês completo somados — tenta exibir em dias do ciclo mais recente
    const ult = ciclos[ciclos.length - 1];
    const df = diffAnosMesesEntre(ult.inicio, ult.fim || '');
    if(df){
      const msDia = 86400000;
      const nDias = Math.max(0, Math.round((df.end - df.start) / msDia));
      const dur = nDias + (nDias === 1 ? ' dia' : ' dias');
      return {
        label: dur,
        durLabel: algumAtivo ? `há ${dur}` : `durou ${dur}`,
        span: {anos:0, meses:0, start:df.start, end:df.end, atual:algumAtivo, totalMeses:0}
      };
    }
  }
  const anos  = Math.floor(totalMeses / 12);
  const meses = totalMeses - anos * 12;
  const parts = [];
  if(anos  > 0) parts.push(anos  + (anos  === 1 ? ' ano'  : ' anos'));
  if(meses > 0) parts.push(meses + (meses === 1 ? ' mês' : ' meses'));
  if(parts.length === 0) parts.push('< 1 mês');
  const dur = parts.join(' e ');
  // Usa o ciclo mais recente para o rótulo start/end exibido no card (contexto).
  const ult = ciclos[ciclos.length - 1];
  const dfUlt = diffAnosMesesEntre(ult.inicio, ult.fim || '') || {start:null, end:null};
  return {
    label: dur,
    durLabel: algumAtivo ? `há ${dur}` : `durou ${dur}`,
    span: {anos, meses, start:dfUlt.start, end:dfUlt.end, atual:algumAtivo, totalMeses}
  };
}

// Liga/desliga o status "ativo" de um cliente (entidade global).
// Modelo de ciclos: INATIVAR fecha o ciclo vigente com a data informada;
// REATIVAR abre um NOVO ciclo (preservando o histórico dos ciclos anteriores).
async function toggleClienteAtivo(cid){
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;

  const hoje = new Date();
  const pad  = n => String(n).padStart(2,'0');
  const todayIso = `${hoje.getFullYear()}-${pad(hoje.getMonth()+1)}-${pad(hoje.getDate())}`;

  if(c.ativo){
    // ── INATIVAR ── fecha o ciclo vigente
    const vig = cicloVigente(c);
    const def = todayIso;
    const minDate = vig ? (vig.inicio || '') : '';
    const val = await askText({
      title: `Inativar ${c.nome || 'cliente'}`,
      label: 'Data do fim do ciclo atual',
      inputType: 'date',
      initialValue: def,
      confirmText: 'Inativar cliente',
      hint: minDate
        ? `Ciclo vigente iniciado em ${fmtDateBR(minDate)}.`
        : 'Selecione a data em que o contrato foi encerrado.',
      validate: (v) => {
        if(!v) return 'Informe a data do fim do ciclo.';
        if(minDate && v < minDate) return 'A data de fim não pode ser anterior ao início do ciclo.';
        return null;
      }
    });
    if(val == null) return; // usuário cancelou
    if(vig){
      vig.fim = val;
    } else {
      // Não há ciclo aberto: cria um ciclo "fantasma" já fechado para registro
      clienteCiclos(c).push({inicio: val, fim: val});
    }
    c.dataFimContrato = val; // back-compat (outros trechos podem ler)
    c.ativo = false;
  } else {
    // ── REATIVAR ── abre um ciclo novo
    // Sugere o dia seguinte ao fim do último ciclo (se houver), senão hoje
    const ciclos = clienteCiclos(c);
    const ult = ciclos[ciclos.length - 1];
    let suggested = todayIso;
    if(ult && ult.fim){
      const d = parseIsoDate(ult.fim);
      if(d){
        d.setDate(d.getDate() + 1);
        suggested = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
        if(suggested > todayIso) suggested = todayIso;
      }
    }
    const minDate = (ult && ult.fim) ? ult.fim : '';
    const val = await askText({
      title: `Reativar ${c.nome || 'cliente'}`,
      label: 'Data de início do novo ciclo',
      inputType: 'date',
      initialValue: suggested,
      confirmText: 'Reativar cliente',
      hint: (ult && ult.fim)
        ? `Último ciclo encerrou em ${fmtDateBR(ult.fim)}. Um novo ciclo será aberto.`
        : 'Um novo ciclo de contrato será aberto a partir desta data.',
      validate: (v) => {
        if(!v) return 'Informe a data de início do novo ciclo.';
        if(minDate && v <= minDate) return 'A data de início deve ser posterior ao fim do ciclo anterior.';
        return null;
      }
    });
    if(val == null) return; // usuário cancelou
    ciclos.push({inicio: val, fim: ''});
    c.dataInicioContrato = val; // back-compat
    c.dataFimContrato    = '';
    c.ativo = true;
  }
  receitaSave();
  renderReceita();
  if(clidetCtx && clidetCtx.cid === cid) renderClidet();
}

// Persistência de campos do cliente (razão social, CNPJ, datas de contrato, tipo pessoa).
function setClienteField(cid, field, val){
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;
  const allowed = ['razaoSocial','cnpj','dataInicioContrato','dataFimContrato','tipoPessoa'];
  if(allowed.indexOf(field) === -1) return;
  c[field] = (val == null ? '' : String(val));
  receitaSave();
  if(clidetCtx && clidetCtx.cid === cid) renderClidet();
}

// ─── CRUD de ciclos de contrato ──────────────────────────────────
// Edita uma das datas de um ciclo específico. Campo ∈ {'inicio','fim'}.
function setCicloField(cid, idx, field, val){
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;
  const lst = clienteCiclos(c);
  if(idx < 0 || idx >= lst.length) return;
  if(field !== 'inicio' && field !== 'fim') return;
  const p = lst[idx];
  const novo = (val == null ? '' : String(val));
  // Validação leve: fim não pode ser antes do início do mesmo ciclo
  if(field === 'fim' && novo && p.inicio && novo < p.inicio){
    toast('A data de fim não pode ser anterior ao início do ciclo.', 3200);
    renderClidet();
    return;
  }
  if(field === 'inicio' && novo && p.fim && novo > p.fim){
    toast('A data de início não pode ser posterior ao fim do ciclo.', 3200);
    renderClidet();
    return;
  }
  p[field] = novo;
  // Ajusta flag "ativo" conforme a existência de ciclo vigente
  c.ativo = !!cicloVigente(c);
  // Mantém espelho nos campos antigos para retro-compat (primeiro início / último fim)
  const todosInicios = lst.map(x => x.inicio).filter(Boolean).sort();
  const todosFins    = lst.map(x => x.fim   ).filter(Boolean).sort();
  c.dataInicioContrato = todosInicios[0] || '';
  c.dataFimContrato    = c.ativo ? '' : (todosFins[todosFins.length-1] || '');
  receitaSave();
  renderReceita();
  if(clidetCtx && clidetCtx.cid === cid) renderClidet();
}

// Estado do modal "Adicionar ciclo de contrato"
let _ciclomodalCtx = null;

// Abre o modal para adicionar um ciclo (início + fim opcional) em um fluxo só.
function addCicloManual(cid){
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;
  const ov   = document.getElementById('ov-ciclo');
  const iniI = document.getElementById('ciclomodal-inicio');
  const fimI = document.getElementById('ciclomodal-fim');
  const hnt  = document.getElementById('ciclomodal-hint');
  const sub  = document.getElementById('ciclomodal-sub');
  if(!ov || !iniI || !fimI) return;

  const temVigente = !!cicloVigente(c);
  iniI.value = '';
  fimI.value = '';
  iniI.closest('.ciclomodal-field').classList.remove('err');
  fimI.closest('.ciclomodal-field').classList.remove('err');
  hnt.textContent = temVigente
    ? 'Há um ciclo ainda em andamento — este novo ciclo precisa ter uma data de fim.'
    : 'Deixe o Fim em branco se este ciclo é o contrato atual em andamento.';
  hnt.className = 'asktext-hint info';
  sub.textContent = 'Use para registrar um ciclo antigo que o cliente teve com você (ou para abrir um novo ciclo se não há nenhum ativo).';

  _ciclomodalCtx = { cid, temVigente };
  ov.classList.add('open');
  setTimeout(()=>{ try{ iniI.focus(); }catch(e){} }, 30);
}

function ciclomodalCancel(){
  const ov = document.getElementById('ov-ciclo');
  if(ov) ov.classList.remove('open');
  _ciclomodalCtx = null;
  _pesCicloModalCtx = null;
}

function ciclomodalKey(ev){
  if(ev.key === 'Escape'){ ev.preventDefault(); ciclomodalCancel(); }
  else if(ev.key === 'Enter'){ ev.preventDefault(); ciclomodalConfirm(); }
  else {
    // limpa estado de erro ao digitar
    const iniI = document.getElementById('ciclomodal-inicio');
    const fimI = document.getElementById('ciclomodal-fim');
    const hnt  = document.getElementById('ciclomodal-hint');
    iniI && iniI.closest('.ciclomodal-field').classList.remove('err');
    fimI && fimI.closest('.ciclomodal-field').classList.remove('err');
    if(hnt && hnt.classList.contains('err')){
      hnt.className = 'asktext-hint info';
      hnt.textContent = _ciclomodalCtx && _ciclomodalCtx.temVigente
        ? 'Há um ciclo ainda em andamento — este novo ciclo precisa ter uma data de fim.'
        : 'Deixe o Fim em branco se este ciclo é o contrato atual em andamento.';
    }
  }
}

function ciclomodalConfirm(){
  const iniI = document.getElementById('ciclomodal-inicio');
  const fimI = document.getElementById('ciclomodal-fim');
  const hnt  = document.getElementById('ciclomodal-hint');
  const inicio = (iniI.value || '').trim();
  const fim    = (fimI.value || '').trim();

  const markErr = (el, msg) => {
    el.closest('.ciclomodal-field').classList.add('err');
    hnt.className = 'asktext-hint err';
    hnt.textContent = msg;
    setTimeout(()=>{ try{ el.focus(); }catch(e){} }, 10);
  };

  // ── Modo pessoa (ciclos anteriores) ──
  if(_pesCicloModalCtx){
    const { rid } = _pesCicloModalCtx;
    if(!inicio){ markErr(iniI, 'Informe a data de início do ciclo.'); return; }
    if(!fim)   { markErr(fimI, 'Informe a data de fim do ciclo anterior.'); return; }
    if(fim < inicio){ markErr(fimI, 'A data de fim não pode ser anterior ao início.'); return; }
    // Verifica sobreposição com o ciclo vigente (qualquer row dessa pessoa)
    const rowsDaPessoa = pessoas.people.filter(p => p.pessoaId === rid);
    for(const row of rowsDaPessoa){
      if(!row.dataEntrada) continue;
      const vigFim = row.ativo ? '9999-12-31' : (row.dataSaida || '9999-12-31');
      if((inicio <= vigFim) && (fim >= row.dataEntrada)){
        markErr(iniI, 'Este ciclo sobrepõe o ciclo vigente (data de entrada atual).');
        fimI.closest('.ciclomodal-field').classList.add('err');
        return;
      }
    }
    // Verifica sobreposição com ciclos anteriores já cadastrados
    const ciclos = pesRegCiclos(rid);
    for(const p of ciclos){
      const pIni = p.inicio || '';
      const pFim = p.fim    || '9999-12-31';
      if(!pIni) continue;
      if((inicio <= pFim) && (fim >= pIni)){
        markErr(iniI, 'Este ciclo sobrepõe outro já cadastrado. Ajuste as datas.');
        fimI.closest('.ciclomodal-field').classList.add('err');
        return;
      }
    }
    ciclos.push({inicio, fim});
    ciclos.sort((a,b) => (a.inicio||'').localeCompare(b.inicio||''));
    pessoasSave();
    if(_pesCardOpenId != null) renderPesCardBody();
    renderPessoas();
    _pesCicloModalCtx = null;
    ciclomodalCancel();
    toast('Ciclo adicionado.', 2000);
    return;
  }

  // ── Modo cliente (original) ──
  if(!_ciclomodalCtx) return;
  const { cid, temVigente } = _ciclomodalCtx;

  if(!inicio){ markErr(iniI, 'Informe a data de início do ciclo.'); return; }
  if(fim && fim < inicio){ markErr(fimI, 'A data de fim não pode ser anterior ao início.'); return; }
  if(temVigente && !fim){ markErr(fimI, 'Já existe um ciclo em andamento. Informe a data de fim para este ciclo histórico.'); return; }

  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c){ ciclomodalCancel(); return; }
  const lst = clienteCiclos(c);

  // Garante que o novo ciclo não sobreponha um existente
  for(const p of lst){
    const pIni = p.inicio || '';
    const pFim = p.fim    || '';
    if(!pIni) continue;
    const meuFim = fim || '9999-12-31';
    const outroFim = pFim || '9999-12-31';
    const sobrepoe = (inicio <= outroFim) && (meuFim >= pIni);
    if(sobrepoe){
      markErr(iniI, 'Este ciclo sobrepõe outro já cadastrado. Ajuste as datas.');
      fimI.closest('.ciclomodal-field').classList.add('err');
      return;
    }
  }

  lst.push({inicio, fim: fim || ''});
  // Reordena cronologicamente pela data de início
  lst.sort((a,b) => (a.inicio||'').localeCompare(b.inicio||''));
  c.ativo = !!cicloVigente(c);
  const todosInicios = lst.map(x => x.inicio).filter(Boolean).sort();
  const todosFins    = lst.map(x => x.fim   ).filter(Boolean).sort();
  c.dataInicioContrato = todosInicios[0] || '';
  c.dataFimContrato    = c.ativo ? '' : (todosFins[todosFins.length-1] || '');
  receitaSave();
  renderReceita();
  if(clidetCtx && clidetCtx.cid === cid) renderClidet();
  ciclomodalCancel();
  toast('Ciclo adicionado.', 2000);
}

// Remove um ciclo (com confirmação).
async function removeCiclo(cid, idx){
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;
  const lst = clienteCiclos(c);
  if(idx < 0 || idx >= lst.length) return;
  const p = lst[idx];
  const label = p.inicio
    ? `${fmtDateBR(p.inicio)} → ${p.fim ? fmtDateBR(p.fim) : 'em andamento'}`
    : 'ciclo sem data';
  const ok = await askConfirm({
    title: 'Remover ciclo',
    message: `Tem certeza que deseja remover o ciclo ${label}?`,
    sub: 'Esta ação não pode ser desfeita.',
    variant: 'danger',
    confirmLabel: 'Remover ciclo'
  });
  if(!ok) return;
  lst.splice(idx, 1);
  c.ativo = !!cicloVigente(c);
  const todosInicios = lst.map(x => x.inicio).filter(Boolean).sort();
  const todosFins    = lst.map(x => x.fim   ).filter(Boolean).sort();
  c.dataInicioContrato = todosInicios[0] || '';
  c.dataFimContrato    = c.ativo ? '' : (todosFins[todosFins.length-1] || '');
  receitaSave();
  renderReceita();
  if(clidetCtx && clidetCtx.cid === cid) renderClidet();
}

