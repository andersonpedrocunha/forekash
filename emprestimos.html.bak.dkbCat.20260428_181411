async function _pesAlocSave(){
  const st = _pesAlocEditorState;
  if(!st) return;
  const p = pessoas.people.find(x => x.id === st.personId);
  if(!p){ _pesAlocClose(); return; }
  const pad = (st.padrao || []).filter(a => a.tipoId);
  const totalPad = pad.reduce((s,a) => s + (parseFloat(a.pct)||0), 0);
  if(pad.length > 0 && Math.abs(totalPad - 100) > 0.01){
    try { if(typeof toast === 'function') toast('⚠️ Soma do padrão deve ser 100% (atual: ' + totalPad.toFixed(1).replace('.',',') + '%)', 4000); } catch(e){}
    return;
  }
  // Detecta empate no maior % (2+ tipos) — se houver, pede ao usuário qual escolher
  let preferido = p.alocacao && p.alocacao.preferido;
  if(pad.length > 1){
    const padSorted = pad.slice().sort((a,b) => (parseFloat(b.pct)||0) - (parseFloat(a.pct)||0));
    const maxPct = parseFloat(padSorted[0].pct) || 0;
    const ties = padSorted.filter(a => Math.abs((parseFloat(a.pct)||0) - maxPct) < 0.01);
    if(ties.length > 1){
      // Empate — precisa escolher
      const valid = ties.some(t => t.tipoId === preferido);
      if(!valid){
        const chosen = await _pesAlocAskTieBreaker(ties, p);
        if(!chosen) return;  // cancelou
        preferido = chosen;
      }
    } else {
      // Sem empate — limpa preferido se estava setado num tipo não-máximo
      if(preferido && preferido !== padSorted[0].tipoId) preferido = null;
    }
  } else {
    preferido = null;
  }
  // Remove meses com alocação inválida
  const mesesLimpos = {};
  for(const ym of Object.keys(st.meses || {})){
    const arr = (st.meses[ym] || []).filter(a => a.tipoId);
    const t = arr.reduce((s,a) => s + (parseFloat(a.pct)||0), 0);
    if(arr.length > 0 && Math.abs(t - 100) < 0.01){
      mesesLimpos[ym] = arr.map(a => ({ tipoId: a.tipoId, pct: parseFloat(a.pct)||0 }));
    }
  }
  p.alocacao = {
    padrao: pad.map(a => ({ tipoId: a.tipoId, pct: parseFloat(a.pct)||0 })),
    meses: mesesLimpos,
    preferido: preferido || null
  };
  // p.tipoId = tipo principal (maior % ou preferido em caso de empate)
  p.tipoId = pesTipoPrincipal(p);
  pessoasSave();
  try { histCommit('editar alocação de ' + (p.nome || 'pessoa')); } catch(e){}
  renderPessoas();
  try { if(typeof toast === 'function') toast('✅ Alocação atualizada'); } catch(e){}
  _pesAlocClose();
}
