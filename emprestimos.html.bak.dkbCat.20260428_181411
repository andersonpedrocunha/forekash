/* ─── Modo Apresentar (fullscreen) ─── */
// Override do presenter — quando definido, usa estes slides em vez do _anaState
let _anaPresentOverride = null;
let _anaPresentSlidesGetter = () => _anaState.presentation.slides;
let _anaPresentIdxGetter    = () => _anaState.presentation.idx;
let _anaPresentIdxSetter    = (v) => { _anaState.presentation.idx = v; };
function _anaPresentResetGetters(){
  _anaPresentOverride = null;
  _anaPresentSlidesGetter = () => _anaState.presentation.slides;
  _anaPresentIdxGetter    = () => _anaState.presentation.idx;
  _anaPresentIdxSetter    = (v) => { _anaState.presentation.idx = v; };
}

function anaPresentStart(){
  _anaPresentResetGetters();
  const slides = _anaState.presentation.slides;
  if(slides.length === 0){
    if(typeof toast === 'function') toast('⚠️ Adicione pelo menos um slide primeiro');
    return;
  }
  _anaState.presentation.presenting = true;
  _anaState.presentation.idx = Math.max(0, slides.findIndex(s => s.id === _anaState.presentation.currentId));
  if(_anaState.presentation.idx < 0) _anaState.presentation.idx = 0;
  const fs = document.getElementById('ana-present-fs');
  if(fs) fs.style.display = 'flex';
  document.addEventListener('keydown', _anaPresentKeyHandler);
  // Tenta entrar em fullscreen real
  try { (fs.requestFullscreen || fs.webkitRequestFullscreen || (()=>{})).call(fs); } catch(e){}
  _anaPresentRenderSlide();
}
function anaPresentExit(){
  _anaState.presentation.presenting = false;
  _anaPresentResetGetters(); // limpa override (se houver)
  const fs = document.getElementById('ana-present-fs');
  if(fs) fs.style.display = 'none';
  document.removeEventListener('keydown', _anaPresentKeyHandler);
  try { (document.exitFullscreen || document.webkitExitFullscreen || (()=>{})).call(document); } catch(e){}
  // Re-renderiza editor pra restaurar estado normal
  _anaRenderPresent();
}
function anaPresentNav(dir){
  const slides = _anaPresentSlidesGetter();
  let i = _anaPresentIdxGetter() + dir;
  if(i < 0) i = 0;
  if(i >= slides.length) i = slides.length - 1;
  _anaPresentIdxSetter(i);
  _anaPresentRenderSlide();
}
function _anaPresentKeyHandler(e){
  if(e.key === 'Escape'){ anaPresentExit(); }
  else if(e.key === 'ArrowRight' || e.key === ' '){ anaPresentNav(1); e.preventDefault(); }
  else if(e.key === 'ArrowLeft'){ anaPresentNav(-1); e.preventDefault(); }
}
function _anaPresentRenderSlide(){
  const slides = _anaPresentSlidesGetter();
  const i = _anaPresentIdxGetter();
  const s = slides[i];
  const slide = document.getElementById('ana-present-fs-slide');
  const pos = document.getElementById('ana-present-fs-pos');
  if(pos) pos.textContent = (i+1) + ' / ' + slides.length;
  if(!slide || !s) return;
  // Aplica layout visual
  for(const lay of SLIDE_LAYOUTS) slide.classList.remove('ana-layout-' + lay.id);
  slide.classList.add('ana-layout-' + (s.layout || 'cream-exec'));
  // Destrói charts antigos da apresentação (canvas IDs slide-X)
  for(const k of Object.keys(_anaChartInstances)){
    if(k.indexOf('ana-cw-canvas-fs-') === 0){
      try { _anaChartInstances[k] && _anaChartInstances[k].destroy(); } catch(_){}
      _anaChartInstances[k] = null;
    }
  }
  if(s.isCover){
    slide.innerHTML = '<div style="margin:auto;text-align:center"><h1 style="font-size:3rem;margin-bottom:14px">' + (s.title||'') + '</h1><div class="sub" style="font-size:1.4rem">' + (s.subtitle||'') + '</div></div>'
                    + (typeof _anaLogoHTML === 'function' ? _anaLogoHTML(s, i, slides.length) : '');
    return;
  }
  let html = '<h1>' + (s.title||'') + '</h1>';
  if(s.subtitle) html += '<div class="sub">' + (s.subtitle) + '</div>';
  // Logo da empresa — append no final do innerHTML completo abaixo (após o canvas)
  const logoHTML = (typeof _anaLogoHTML === 'function') ? _anaLogoHTML(s, i, slides.length) : '';
  html += '<div class="canvas">';
  html += (s.widgets||[]).map(it => {
    const cols = it.cols || 1, rows = it.rows || 1;
    const styleParts = [];
    if(it.colStart) styleParts.push('grid-column:' + it.colStart + ' / span ' + cols);
    if(it.rowStart) styleParts.push('grid-row:' + it.rowStart + ' / span ' + rows);
    const styleAttr = styleParts.length ? ' style="' + styleParts.join(';') + '"' : '';
    return '<div class="ana-custom-widget ana-cw-cols-' + cols + ' ana-cw-rows-' + rows + '"' + styleAttr + '>'
      + '<div class="ana-cw-body" id="ana-cw-fs-body-' + it.id + '"></div></div>';
  }).join('');
  html += '</div>';
  slide.innerHTML = html + logoHTML;
  // Render widgets (modo presenting=true desativa edição em textos)
  const facts = _anaCollectFacts();
  const k = _anaCalcKPIs(facts);
  const x = _anaCalcIndicadoresExtra(k, facts);
  const series = _anaCalcSeries(facts);
  for(const it of (s.widgets||[])){
    const w = ANA_WIDGETS[it.widget];
    const body = document.getElementById('ana-cw-fs-body-' + it.id);
    if(!w || !body) continue;
    try {
      const fsUid = 'fs-' + it.id;
      w.render(body, { facts, k, x, s:series, uid: fsUid, item: it });
    } catch(e){}
  }
}
