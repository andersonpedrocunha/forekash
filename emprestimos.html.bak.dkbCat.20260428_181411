    const gp = (typeof _extParseGroupId === 'function') ? _extParseGroupId(_extEditingId) : null;
    if(gp && typeof _extDeleteGroup === 'function') _extDeleteGroup(gp.grupoId, gp.data);
    _extEditingId = null;
  }

  // Para gasto/ganho: lê lista de itens. Para transferência: campos legacy.
  let valor, desc, cat, counter;
  let itensList = [];
  if(tipo === 'transferencia'){
    valor   = parseFloat(document.getElementById('ext-fld-valor')?.value) || 0;
    desc    = (document.getElementById('ext-fld-desc')?.value || '').trim();
    cat     = (document.getElementById('ext-fld-cat')?.value || '').trim();
    counter = (document.getElementById('ext-fld-counter')?.value || '').trim();
  } else {
    // Compila lista de itens válidos (com valor > 0)
    itensList = (_extItems || []).filter(it => (parseFloat(it.valor) || 0) > 0).map(it => ({
      descricao: (it.descricao || '').trim(),
      valor: parseFloat(it.valor) || 0,
      categoria: (it.categoria || '').trim(),
      contraparte: (it.contraparte || '').trim()
    }));
    if(itensList.length === 0){
      if(typeof toast === 'function') toast('⚠ Preencha pelo menos um item com valor > 0');
      return;
    }
    // Para compat com fluxos legacy/save manual: usa o 1º item como "principal"
    valor   = itensList[0].valor;
    desc    = itensList[0].descricao;
    cat     = itensList[0].categoria;
    counter = itensList[0].contraparte;
  }

  if(!data){ if(typeof toast === 'function') toast('Defina uma data'); return; }
  if(valor <= 0){ if(typeof toast === 'function') toast('Valor deve ser maior que zero'); return; }
  if(tipo === 'transferencia'){
    if(!conta){ if(typeof toast === 'function') toast('⚠ Escolha a conta de ORIGEM'); return; }
    if(!counter){ if(typeof toast === 'function') toast('⚠ Escolha a conta de DESTINO'); return; }
    if(conta === counter){ if(typeof toast === 'function') toast('⚠ Conta origem e destino devem ser diferentes'); return; }
  }
  // Categoria sempre fixa em "Transferência" pra esse tipo
  const catFinal = (tipo === 'transferencia') ? 'Transferência' : cat;

  // ─── Tenta auto-propagar para módulo de origem (Estrutura/Receita) ───
  // Só vale para criação nova de gasto/ganho. Edição de manual fica como manual.
  const dataPag = (status === 'pago' ? data : '');
  // Lê configuração de Repetição
  const repMode = (document.getElementById('ext-fld-rep-mode')?.value || 'once');
  let repCount = 1;
  let repFreq = 'mensal';
  if(repMode === 'multi'){
    repCount = Math.max(1, Math.min(60, parseInt(document.getElementById('ext-fld-rep-count')?.value, 10) || 1));
    repFreq = (document.getElementById('ext-fld-rep-freq-multi')?.value || 'mensal');
  } else if(repMode === 'always'){
    // Calcula quantas vezes cabe entre data e dez do (ano da data + 4) — 5 anos de cobertura
    repFreq = (document.getElementById('ext-fld-rep-freq-always')?.value || 'mensal');
    const f = _EXT_FREQ.find(x => x.id === repFreq);
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(data);
    if(f && m){
      const yIni = parseInt(m[1],10);
      const inicio = new Date(yIni, parseInt(m[2],10)-1, 1);
      const fim = new Date(yIni + 4, 11, 1); // dez do ano + 4
      const diffMeses = (fim.getFullYear()-inicio.getFullYear())*12 + (fim.getMonth()-inicio.getMonth());
