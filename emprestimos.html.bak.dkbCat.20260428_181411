// ── Integração com o registro compartilhado de bancos (dispo.bancos) ──
// Resolve o banco de um empréstimo como objeto do registro dispo.bancos,
// fazendo lookup por id primeiro e por nome como fallback (para dados legados).
function loanBancoResolve(loan){
  if(!loan) return null;
  if(typeof dispo === 'undefined' || !dispo || !Array.isArray(dispo.bancos)) return null;
  if(loan.bancoId){
    const b = dispo.bancos.find(x => x.id === loan.bancoId);
    if(b) return b;
  }
  const nameCandidate = (loan.bancoManual || loan.banco || '').trim();
  if(!nameCandidate || nameCandidate === '— Digitar manualmente —') return null;
  const norm = s => (s||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
  const n = norm(nameCandidate);
  return dispo.bancos.find(x => norm(x.nome) === n) || null;
}

// Migra loans com banco em string para loan.bancoId (cria no registro se não existir)
function loansMigrateBancos(){
  if(typeof dispo === 'undefined' || !dispo || !Array.isArray(dispo.bancos)) return false;
  let dirtyLoans = false, dirtyDispo = false;
  for(const loan of loans){
    if(loan.bancoId && dispo.bancos.some(b => b.id === loan.bancoId)) continue;
    const nameRaw = (loan.bancoManual || loan.banco || '').trim();
    if(!nameRaw || nameRaw === '— Digitar manualmente —'){ loan.bancoId = ''; continue; }
    let match = loanBancoResolve({ banco:nameRaw });
    if(!match){
      // Cria novo banco no registro compartilhado
      const id = (typeof dispoNextId === 'function') ? dispoNextId('bancos') : ('b-u' + (dispo.bancos.length + 1));
      match = { id, nome:nameRaw, domain:null, color:'#E5E7EB' };
      dispo.bancos.push(match);
      dirtyDispo = true;
    }
    loan.bancoId = match.id;
    loan.banco   = match.nome;
    loan.bancoManual = '';
    dirtyLoans = true;
  }
  if(dirtyDispo && typeof dispoSave === 'function') dispoSave();
  if(dirtyLoans) saveData();
  return dirtyLoans || dirtyDispo;
}

// Setter chamado pelo picker — grava bancoId no loan e mantém loan.banco sincronizado
function setLoanBanco(loanId, bancoId){
  const loan = loans.find(l => l.id === loanId); if(!loan) return;
  loan.bancoId = bancoId || '';
  const b = (dispo && dispo.bancos || []).find(x => x.id === bancoId);
  loan.banco = b ? b.nome : '';
  loan.bancoManual = '';
  saveData();
  render();
}

// Abre o mesmo picker de banco usado em Disponibilidades, mas chamando setLoanBanco
function openLoanBancoPicker(evt, loanId){
  evt.stopPropagation();
  if(typeof dispo === 'undefined' || !dispo || !Array.isArray(dispo.bancos)) return;
  const cell = evt.currentTarget;
  const pop = document.createElement('div');
  pop.className = 'dispo-pick-pop';
  pop.setAttribute('data-kind','banco-loan');
  pop.setAttribute('data-loan', loanId);
  renderLoanBancoPickerBody(pop, loanId, '');
  _dispoMountPicker(cell, pop);
}
function renderLoanBancoPickerBody(pop, loanId, filter){
  const loan = loans.find(l => l.id === loanId);
  const f = (filter||'').trim().toLowerCase();
  const list = (dispo.bancos||[])
    .filter(b => !f || b.nome.toLowerCase().includes(f))
    .map(b => {
      const logo = dispoLogoUrl(b);
      const fb   = dispoLogoFallback(b);
      const ini  = dispoBancoInitials(b);
      const selCls = (loan && loan.bancoId === b.id) ? ' selected' : '';
      const logoHtml = logo
        ? `<img class="dispo-banco-logo" src="${logo}" data-fb="${fb||''}" data-ini="${esc(ini)}" data-bc="${esc(b.color||'#E5E7EB')}" onerror="dispoLogoImgFallback(this)">`
        : `<span class="dispo-banco-initials" style="background:${b.color||'#E5E7EB'}">${esc(ini)}</span>`;
      return `<div class="dispo-pick-item${selCls}" onclick="setLoanBanco(${loanId}, '${esc(b.id)}'); closeDispoPickers()">
        ${logoHtml}
        <span style="flex:1">${esc(b.nome)}</span>
      </div>`;
    }).join('');
  pop.innerHTML = `
    <div class="dispo-pick-search">
      <input type="text" placeholder="Buscar banco…" autofocus
             oninput="renderLoanBancoPickerBody(this.closest('.dispo-pick-pop'), ${loanId}, this.value)"
             value="${esc(filter||'')}">
    </div>
    <div class="dispo-pick-list">
      ${list || '<div style="padding:14px;text-align:center;color:var(--txl);font-size:.78rem">Nenhum banco encontrado.</div>'}
    </div>
    <div class="dispo-pick-add">
      <button onclick="showLoanNewBancoForm(${loanId}, '${esc(filter||'')}')">+ Novo banco</button>
    </div>`;
  const inp = pop.querySelector('.dispo-pick-search input');
  if(inp){ inp.focus(); inp.setSelectionRange(inp.value.length, inp.value.length); }
}
