// Produz os dados da aba Clientes (agregados por cliente no período).
// Usa _vendComissaoPorCliente pra calcular a comissão exata de cada cliente
// (inclui modo Por cliente com % específicos). Diferenças entre comissão-total
// e soma-por-cliente (overrides, ajustes, regras sem base) vão pra "outros".
function _vendRelDataClientes(v, st){
  const idxDe  = st.anoDe*12  + st.mesDe;
  const idxAte = st.anoAte*12 + st.mesAte;
  const agg = new Map();
  let outros = 0;
  const getOrInit = (cid, nome) => {
    if(!agg.has(cid)) agg.set(cid, {id:cid, nome:nome||'(sem cliente)', bruto:0, liq:0, com:0});
    return agg.get(cid);
  };
  for(let idx = idxDe; idx <= idxAte; idx++){
    const y = String(Math.floor(idx/12));
    const m = idx % 12;
    const perCli = _vendComissaoPorCliente(v, y, m);
    let comPerCliSum = 0;
    for(const [cid, pc] of perCli){
      const c = (typeof clienteOf === 'function' && clienteOf(cid)) || {nome:'(sem cliente)'};
      const acc = getOrInit(cid, c.nome);
      acc.bruto += pc.bruto;
      acc.liq   += pc.liq;
      acc.com   += pc.com;
      comPerCliSum += pc.com;
    }
    // Comissão "total" (com override/ajuste) — se diferir do somatório per-cliente, vai pra outros
    const comTot = comissaoVendedorMes(v, y, m) || 0;
    const delta = comTot - comPerCliSum;
    if(Math.abs(delta) > 0.005) outros += delta;
  }
  const lista = Array.from(agg.values()).sort((a,b) => b.liq - a.liq);
  let totBruto = 0, totLiq = 0, totCom = 0;
  for(const c of lista){
    totBruto += c.bruto; totLiq += c.liq; totCom += c.com;
    // % efetiva do cliente no período = com/liq (média ponderada se houver variação mês a mês)
    c.pct = c.liq > 0 ? (c.com / c.liq * 100) : 0;
  }
  const totPct = totLiq > 0 ? ((totCom + outros) / totLiq * 100) : 0;
  return { lista, outros, totBruto, totLiq, totPct, totCom: totCom + outros };
}
// Abre modal detalhando a origem do "Ajustes / Overrides (sem base)" —
// percorre o período e lista, mês a mês, ajustes manuais e overrides que
// estão fazendo o total diferir da soma per-cliente.
function _vendRelOutrosOpen(vendId){
  if(!_vendRelState) return;
  const v = vendedores && Array.isArray(vendedores.lista)
    ? vendedores.lista.find(x => x.id === vendId) : null;
  if(!v){ try{ if(typeof toast==='function') toast('Vendedor não encontrado'); }catch(e){} return; }
  const st = _vendRelState;
  const MESES_LBL = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
  const idxDe  = st.anoDe*12  + st.mesDe;
  const idxAte = st.anoAte*12 + st.mesAte;
  const ajustesArr = [];
  const overridesArr = [];
  for(let idx = idxDe; idx <= idxAte; idx++){
    const y = String(Math.floor(idx/12));
    const m = idx % 12;
    const ym = y + '-' + String(m+1).padStart(2,'0');
    const ymLbl = MESES_LBL[m] + '/' + String(y).slice(2);
    // Ajustes do mês (array de items)
    if(Array.isArray(v.ajustes)){
      for(const a of v.ajustes){
        if(!a || a.ym !== ym) continue;
        const valor = parseFloat(a.valor) || 0;
        if(valor === 0) continue;
        let regraLbl = 'Geral';
        if(a.regraId != null && Array.isArray(v.regras)){
          const ri = v.regras.findIndex(r => r.id === a.regraId);
          if(ri >= 0){
            const r = v.regras[ri];
            const de = r.de ? _vendYmLabel(r.de) : '—';
            const ate = r.ate ? _vendYmLabel(r.ate) : 'sem fim';
            regraLbl = 'Regra ' + (ri+1) + ' (' + de + '→' + ate + ')';
          } else {
            regraLbl = 'Regra removida';
          }
        }
        ajustesArr.push({ ym, ymLbl, valor, nota: a.nota || '', regraLbl });
      }
    }
    // Override do mês (substitui o cálculo base)
    if(v.overrides && v.overrides[ym] !== undefined && v.overrides[ym] !== ''){
      const overrideVal = parseFloat(v.overrides[ym]);
      if(!isNaN(overrideVal)){
        // Calcula o que SERIA sem override — soma per-cliente
        const perCli = _vendComissaoPorCliente(v, y, m);
        let calc = 0;
        for(const [, pc] of perCli) calc += pc.com;
        const diff = overrideVal - calc;
        if(Math.abs(diff) > 0.005){
          overridesArr.push({ ym, ymLbl, calc, override: overrideVal, diff });
        }
      }
    }
  }
  // Soma totais
  const totAjuste = ajustesArr.reduce((s,a) => s + a.valor, 0);
  const totOver   = overridesArr.reduce((s,o) => s + o.diff, 0);
  const totGeral  = totAjuste + totOver;
  // Renderiza
  const ov = document.createElement('div');
  ov.className = 'confirm-overlay';
