  // ─── CAIXA ───
  if(subjects.has('caixa')){
    const rwQual = k.runway >= 12 ? 'confortável' : k.runway >= 6 ? 'razoável' : k.runway >= 3 ? 'curto' : 'crítico';
    const rwTxt = isFinite(k.runway) && k.runway >= 0 ? k.runway.toFixed(1) + ' meses' : 'horizonte aberto';
