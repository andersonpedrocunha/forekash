// ── Busca automática de frases (Wikiquote + fallback Quotable) ─
async function homeQuoteAutoFetch(){
  const nameEl   = document.getElementById('home-quote-new-name');
  const frasesEl = document.getElementById('home-quote-new-frases');
  const btn      = document.getElementById('home-quote-fetch-btn');
  const hint     = document.getElementById('home-quote-fetch-hint');
  if(!nameEl || !frasesEl) return;

  const nome = (nameEl.value || '').trim();
  if(!nome){ nameEl.focus(); return; }

  if(btn){ btn.disabled = true; btn.classList.add('is-loading'); }
  if(hint){ hint.className = 'home-quote-add-hint'; hint.innerHTML = 'Buscando frases de <strong>' + nome.replace(/[<>]/g,'') + '</strong>…'; }

  // ── Wikiquote (pt/en) ────────────────────────────────────
  async function tryWikiquote(lang, title){
    const url = `https://${lang}.wikiquote.org/w/api.php?action=parse&page=${encodeURIComponent(title)}&prop=text&format=json&origin=*&redirects=1`;
    try{
      const r = await fetch(url, { cache:'no-store' });
      if(!r.ok) return [];
      const j = await r.json();
      if(!j || !j.parse || !j.parse.text || !j.parse.text['*']) return [];
      const doc  = new DOMParser().parseFromString(j.parse.text['*'], 'text/html');
      const root = doc.querySelector('.mw-parser-output') || doc.body;
      const seen = new Set();
      const out  = [];
      const lis  = root.querySelectorAll('ul > li, ol > li');
      for(const li of lis){
        // IMPORTANTE: se o <li> contém uma sublista, ele é um CABEÇALHO de seção
        // (tipicamente o título da fonte, ex.: "Nobel Prize Autobiographical
        // Information (2002)") — as frases reais estão nos <li> aninhados e
        // serão processadas na iteração normal. Pula.
        if(li.querySelector(':scope > ul, :scope > ol')) continue;

        // Ignora itens aninhados em submenus (notas/fontes)
        const clone = li.cloneNode(true);
        clone.querySelectorAll('ul, ol, sup, .reference, cite').forEach(el => el.remove());
        let text = (clone.textContent || '').replace(/\s+/g, ' ').trim();
        text = text.replace(/\[\d+\]/g, '').trim();
        // Remove aspas/traços de atribuição no fim: — Autor, Fonte
        text = text.replace(/\s+[—–-]\s+[A-ZÀ-ÿ][^"»]*$/, '').trim();
        // Remove aspas curvas/duplas no início e fim
        text = text.replace(/^[«""'"`]+/, '').replace(/[»""'"`]+$/, '').trim();
        if(text.length < 25 || text.length > 380) continue;
        if(!/[a-záéíóúâêîôûãõçñü]/i.test(text)) continue;
        // Filtra seções de navegação / fontes comuns
        if(/^(ver também|em inglês|sobre|fonte[s]?|referência[s]?|bibliografia|ligações externas|external links|see also|notes)/i.test(text)) continue;
        // Filtra linhas que parecem ser só referências/citações acadêmicas
        if(/^(p\.|pp\.|ISBN|vol\.|edição|cap\.|ch\.)/i.test(text)) continue;
        // Filtra títulos de fonte: "Alguma Coisa (YYYY)." — padrão Title Case,
        // sem vírgula nem pontuação interna, só ano entre parênteses no fim.
        // Ex.: "Nobel Prize Autobiographical Information (2002)." — ao contrário
        // de uma frase real, que teria vírgula ou ponto no meio do texto.
        if(/^[A-ZÀ-ÿ][^.!?,:;"«»""]*\(\d{4}\)\s*[.·]?\s*$/.test(text)) continue;
        if(seen.has(text)) continue;
        seen.add(text);
        out.push(text);
        if(out.length >= 12) break;
      }
      return out;
    }catch(e){ return []; }
  }

  // ── Wikipedia summary (bio) ──────────────────────────────
  async function tryWikipediaBio(lang, title){
    const url = `https://${lang}.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(title)}?redirect=true`;
    try{
      const r = await fetch(url, { cache:'no-store' });
      if(!r.ok) return '';
      const j = await r.json();
      // extract é texto simples limpo; description é rótulo curto (ex: "Roman philosopher")
      let ext = String(j.extract || '').trim();
      if(!ext) return '';
      // Pega as 1–2 primeiras frases (até ~220 chars), cortando em pontuação
      if(ext.length > 240){
        const m = ext.match(/^.*?[.!?](?=\s|$)/);
        if(m && m[0].length >= 40) ext = m[0];
        else ext = ext.slice(0, 220).replace(/\s+\S*$/, '') + '…';
      }
      return ext.replace(/\s+/g, ' ').trim();
    }catch(e){ return ''; }
  }

  // ── Quotable (en) ────────────────────────────────────────
  async function tryQuotable(name){
    const slug = homeQuoteSlug(name);
    const urls = [
      `https://api.quotable.io/quotes?author=${encodeURIComponent(slug)}&limit=10`,
      `https://api.quotable.io/search/quotes?query=${encodeURIComponent(name)}&limit=10`
    ];
    for(const url of urls){
      try{
        const r = await fetch(url, { cache:'no-store' });
        if(!r.ok) continue;
        const j = await r.json();
        const results = Array.isArray(j && j.results) ? j.results : [];
        if(!results.length) continue;
        const nomeLc = name.toLowerCase();
        const match = results.filter(q => {
          const a = String(q.author || '').toLowerCase();
          return a === nomeLc || a.includes(nomeLc) || nomeLc.includes(a);
        });
        const arr = (match.length ? match : results).slice(0, 10)
                    .map(q => String(q.content || '').trim()).filter(Boolean);
        if(arr.length) return arr;
      }catch(e){}
    }
    return [];
  }

  let frases = [];
  let fonte  = '';
  let bioWin = ''; // idioma que venceu as frases
  let bio    = '';

  // Tenta EN e PT em paralelo — frases + bio ao mesmo tempo.
  // Vence a língua com MAIS frases (preserva idioma original).
  const [ptFrases, enFrases, ptBio, enBio] = await Promise.all([
    tryWikiquote('pt', nome),
    tryWikiquote('en', nome),
    tryWikipediaBio('pt', nome),
    tryWikipediaBio('en', nome)
  ]);
  if(enFrases.length >= ptFrases.length && enFrases.length > 0){
    frases = enFrases; fonte = 'Wikiquote · EN'; bioWin = 'en';
  } else if(ptFrases.length > 0){
    frases = ptFrases; fonte = 'Wikiquote · PT'; bioWin = 'pt';
  }

  // Fallback final: Quotable.io (só EN)
  if(!frases.length){
    const qt = await tryQuotable(nome);
    if(qt.length){ frases = qt; fonte = 'Quotable · EN'; bioWin = 'en'; }
  }

  // Bio: prefere a mesma língua das frases; senão tenta o outro idioma
  if(bioWin === 'pt') bio = ptBio || enBio || '';
  else if(bioWin === 'en') bio = enBio || ptBio || '';
  else bio = ptBio || enBio || '';

  // Preenche campo de bio (não sobrescreve se o usuário já digitou algo)
  const bioEl = document.getElementById('home-quote-new-bio');
  if(bioEl && bio && !(bioEl.value || '').trim()) bioEl.value = bio;

  if(btn){ btn.disabled = false; btn.classList.remove('is-loading'); }

  if(frases.length){
    const existing = (frasesEl.value || '').trim();
    frasesEl.value = (existing ? existing + '\n' : '') + frases.join('\n');
    if(hint){
      hint.className = 'home-quote-add-hint ok';
      const n = frases.length;
      const bioMsg = bio ? ' · bio preenchida automaticamente' : '';
      hint.innerHTML = `<strong>${n}</strong> frase${n>1?'s':''} encontrada${n>1?'s':''} em <strong>${fonte}</strong>${bioMsg}. Revise e clique em <strong>Adicionar</strong>.`;
    }
  } else {
    if(hint){
      hint.className = 'home-quote-add-hint err';
      hint.innerHTML = 'Não encontramos frases automaticamente. Adicione manualmente (uma por linha) ou verifique a grafia do nome.';
    }
  }
}

// ── Dados agregados para os KPIs da home ───────────────────────
function homeDispoTotal(){
  // Soma do último mês lançado no ano ativo (como Disponibilidades calcula)
  if(typeof dispo === 'undefined' || !dispo || !Array.isArray(dispo.contas)) return { total:0, caixa:0, reserva:0, ref:null };
  const year = (typeof dispoCurYear === 'function') ? dispoCurYear()
               : (dispo.years && dispo.years[dispo.years.length-1]) || String(new Date().getFullYear());
  // Mesma regra do updateDispoKpis(): ano corrente → padrão é o mês anterior, só
  // usa o mês atual quando há dado ≠ 0 nele. Outros anos → último mês com dados.
  const __now       = new Date();
  const __todayYear = String(__now.getFullYear());
  const __todayMon  = __now.getMonth();
  const __hasData = (m, requireNonZero) => {
    const k = `${year}-${String(m+1).padStart(2,'0')}`;
    return dispo.contas.some(c => {
      const v = c.saldos[k];
      if(v == null || v === '' || isNaN(+v)) return false;
      return requireNonZero ? (+v !== 0) : true;
    });
  };
  let lastIdx = -1;
  if(String(year) === __todayYear){
    if(__hasData(__todayMon, true)){
      lastIdx = __todayMon;
    } else {
      for(let m = __todayMon - 1; m >= 0; m--){
        if(__hasData(m, false)){ lastIdx = m; break; }
      }
    }
  } else {
    for(let m = 11; m >= 0; m--){
      if(__hasData(m, false)){ lastIdx = m; break; }
    }
  }
  let total = 0, caixa = 0, reserva = 0;
  if(lastIdx >= 0){
    const key = `${year}-${String(lastIdx+1).padStart(2,'0')}`;
    for(const c of dispo.contas){
      const v = c.saldos[key];
      if(v != null && v !== '' && !isNaN(+v)){
        const tp = (typeof dispoTipo === 'function') ? dispoTipo(c.tipoId) : null;
        total += +v;
        if(tp && tp.liquidez === 'reserva') reserva += +v; else caixa += +v;
      }
    }
  }
  const mesesLbl = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  return { total, caixa, reserva, ref: lastIdx>=0 ? `${mesesLbl[lastIdx]}/${year}` : null, lastIdx, year };
}
function homeFluxoCurrent(){
  // Mês atual: tenta o mês vigente real; se não tiver dados, usa o último com receita/custo
  if(typeof fluxo === 'undefined' || !fluxo || !fluxo.years || !fluxo.years.length) return null;
  const nowY = String(new Date().getFullYear());
  const nowM = new Date().getMonth();
  let year = fluxo.years.includes(nowY) ? nowY : fluxo.years[fluxo.years.length-1];
  let mIdx = nowM;
  // Se o ano escolhido é diferente do atual, usa dezembro como referência
  if(year !== nowY) mIdx = 11;
  // Usa funções globais já definidas
  const receita = (typeof flxReceitaMes === 'function') ? flxReceitaMes(year, mIdx) : 0;
  const custo   = (typeof flxCustoTotalMes === 'function') ? flxCustoTotalMes(year, mIdx) : 0;
  const result  = (typeof flxResultadoMes === 'function') ? flxResultadoMes(year, mIdx) : (receita - custo);
  const mesesLbl = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  return { year, mIdx, receita, custo, result, ref: `${mesesLbl[mIdx]}/${year}` };
}
// Normaliza (year, mIdx) cruzando fronteiras de ano (mIdx=-1 → dez/ano-1)
function homeNormYM(year, mIdx){
  let y = parseInt(year, 10);
  let m = mIdx;
  while(m < 0){ m += 12; y -= 1; }
  while(m > 11){ m -= 12; y += 1; }
  return { y:String(y), mIdx:m, key: `${y}-${String(m+1).padStart(2,'0')}` };
}
// Soma Disponibilidades em (year, mIdx). Retorna null se não há lançamento.
function homeDispoTotalAt(year, mIdx){
  if(typeof dispo === 'undefined' || !dispo || !Array.isArray(dispo.contas)) return null;
  const { key } = homeNormYM(year, mIdx);
  const has = dispo.contas.some(c => c.saldos[key] != null && c.saldos[key] !== '' && !isNaN(+c.saldos[key]));
  if(!has) return null;
  let total = 0;
  for(const c of dispo.contas){
    const v = c.saldos[key];
    if(v != null && v !== '' && !isNaN(+v)) total += +v;
  }
  return total;
}
// Receita/Custo/Resultado em (year, mIdx). Retorna null se não há receita nem custo.
function homeFluxoAt(year, mIdx){
  if(typeof fluxo === 'undefined' || !fluxo || !fluxo.years) return null;
  const { y, mIdx:m } = homeNormYM(year, mIdx);
  if(!fluxo.years.includes(y)) return null;
  const receita = (typeof flxReceitaMes === 'function') ? (flxReceitaMes(y, m)||0) : 0;
  const custo   = (typeof flxCustoTotalMes === 'function') ? (flxCustoTotalMes(y, m)||0) : 0;
  const result  = (typeof flxResultadoMes === 'function') ? (flxResultadoMes(y, m)||(receita-custo)) : (receita - custo);
  if(receita === 0 && custo === 0) return null;
  return { receita, custo, result };
}
// Dívida total no mês (year, mIdx), usando saldoEfetivado dos registros.
function homeDividaAt(year, mIdx){
  if(typeof loans === 'undefined' || !Array.isArray(loans)) return null;
  const { key } = homeNormYM(year, mIdx);
  let total = 0, found = false;
  for(const l of loans){
    const regs = l.registros || [];
    const r = regs.find(x => x && x.mes === key);
    if(r && r.saldoEfetivado !== '' && r.saldoEfetivado != null){
      const v = parseFloat(r.saldoEfetivado);
      if(!isNaN(v)){ total += v; found = true; }
    }
  }
  return found ? total : null;
}
// Formata chip de variação %. invert=true → queda é boa (dívida).
function homeApplyDelta(elId, cur, prev, opts){
  const el = document.getElementById(elId);
  if(!el) return;
  opts = opts || {};
  const invert = !!opts.invert;
  el.classList.remove('up','down');
  if(prev == null || isNaN(prev) || prev === 0 || cur == null || isNaN(cur)){
    el.innerHTML = '';
    return;
  }
  const diff = cur - prev;
  const pct  = (diff / Math.abs(prev)) * 100;
  if(Math.abs(pct) < 0.005){
    el.innerHTML = '0,00% vs mês anterior';
    return;
  }
  const up = diff > 0;
  const arrow = up
    ? '<svg viewBox="0 0 24 24"><path d="M7 14l5-5 5 5"/></svg>'
    : '<svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5"/></svg>';
  const good = invert ? !up : up;
  el.classList.add(good ? 'up' : 'down');
  const sign = up ? '+' : '−';
  el.innerHTML = `${arrow} ${sign}${fmtBR(Math.abs(pct), 2)}%`;
  el.title = `vs mês anterior (${prev < 0 ? '−' : ''}${fmtBRL(Math.abs(prev))})`;
}
function homePessoasAtivas(){
  if(typeof pessoas === 'undefined' || !pessoas || !Array.isArray(pessoas.people)) return 0;
  // "Ativos" = pessoas com ativo=true, não-simulação, e com ao menos 1 mês
  // com salário > 0 no ano corrente (mesma definição do KPI "pessoas ativas no ano")
  const year = String(new Date().getFullYear());
  let n = 0;
  for(const p of pessoas.people){
    if(!p.ativo || p.sim) continue;
    let hadAny = false;
    for(let m=0;m<12;m++){
      if(typeof pesEffVal === 'function'){
        if(pesEffVal(p, pesMesKey(year, m)) > 0){ hadAny = true; break; }
      } else {
        const k = year + '-' + String(m+1).padStart(2,'0');
        const v = p.salarios && p.salarios[k];
        if(v !== undefined && v !== '' && v != null && parseFloat(v) > 0){ hadAny = true; break; }
      }
    }
    if(hadAny) n++;
  }
  return n;
}
function homeClientesAtivos(){
  if(typeof receita === 'undefined' || !receita) return 0;
  // "Ativos" = entidades de cliente (receita.clientes) com flag ativo=true
  if(Array.isArray(receita.clientes)){
    return receita.clientes.filter(c => c && c.ativo).length;
  }
  // Fallback (caso o registro global não exista): conta clientes ATIVOS e NÃO-leads
  // nas linhas do ano atual — nunca conta leads (prospects).
  const year = String(new Date().getFullYear());
  const d = (receita.years && receita.years[year]) || null;
  if(!d) return 0;
  const ids = new Set();
  for(const r of (d.clients||[])){
    if(r.ativo === false) continue;
    if(r.clienteId) ids.add(r.clienteId);
  }
  return ids.size;
}

// ── Mini-chart de saldo do ano (barras) ────────────────────────
function homeRenderChart(){
  const box = document.getElementById('home-chart');
  const yLbl = document.getElementById('home-flux-year');
  if(!box) return;
  if(typeof fluxo === 'undefined' || !fluxo || !fluxo.years || !fluxo.years.length){
    box.innerHTML = '<div style="flex:1;text-align:center;color:var(--txl);font-size:.75rem;padding:30px 0">Sem dados no Fluxo ainda</div>';
    if(yLbl) yLbl.textContent = '—';
    return;
  }
  const nowY = String(new Date().getFullYear());
  const year = fluxo.years.includes(nowY) ? nowY : fluxo.years[fluxo.years.length-1];
  if(yLbl) yLbl.textContent = year;
  const nowM = new Date().getMonth();
  const mesesLbl = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  // Calcula saldo do mês (receita - gasto total + crédito + outras receitas - outras despesas) — mesma lógica do Fluxo
  const vals = [];
  for(let m=0;m<12;m++){
    let saldo = 0;
    try{
      const rec = (typeof flxReceitaMes === 'function') ? flxReceitaMes(year, m) : 0;
      const cus = (typeof flxCustoTotalMes === 'function') ? flxCustoTotalMes(year, m) : 0;
      const cre = (typeof flxCreditoMes === 'function') ? flxCreditoMes(year, m) : 0;
      const out = (typeof flxOutrasMes === 'function') ? flxOutrasMes(year, m) : 0;
      const outD = (typeof flxOutrasDespMes === 'function') ? flxOutrasDespMes(year, m) : 0;
      saldo = rec - cus + cre + out - outD;
    }catch(e){}
    vals.push(saldo);
  }
  // Escala compartilhada: mesma unidade pra positivos e negativos
  const absMax = Math.max(1, ...vals.map(v => Math.abs(v)));
  const SLOT_H = 58; // precisa bater com a altura efetiva do .home-chart-slot (flex-basis:62px)
  box.innerHTML = vals.map((v,m) => {
    const posH = v > 0 ? Math.max(2, Math.round((v / absMax) * SLOT_H)) : 0;
    const negH = v < 0 ? Math.max(2, Math.round((-v / absMax) * SLOT_H)) : 0;
    const atual = (year === nowY && m === nowM) ? ' atual' : '';
    const tip = `${mesesLbl[m]}/${year}: ${fmtBRL(v)}`;
    const posBar = posH > 0 ? `<div class="home-chart-bar pos" style="height:${posH}px"></div>` : '';
    const negBar = negH > 0 ? `<div class="home-chart-bar neg" style="height:${negH}px"></div>` : '';
    return `<div class="home-chart-col${atual}" title="${tip}">
      <div class="home-chart-slot pos">${posBar}</div>
      <div class="home-chart-slot neg">${negBar}</div>
      <div class="home-chart-lbl">${mesesLbl[m]}</div>
    </div>`;
  }).join('');
}

// Detecta se todos os módulos estão vazios — para decidir mostrar o CTA
function homeIsEmpty(){
  const hasLoans   = (typeof loans !== 'undefined') && Array.isArray(loans) && loans.length > 0;
  const hasReceita = (typeof receita !== 'undefined') && !!(receita && receita.years && Object.keys(receita.years).some(y => receita.years[y] && (receita.years[y].clients||[]).length>0));
  const hasPessoas = (typeof pessoas !== 'undefined') && !!(pessoas && (pessoas.people||[]).length > 0);
  const hasEst     = (typeof estrutura !== 'undefined') && !!(estrutura && (estrutura.itens||[]).length > 0);
  let hasDispo = false;
  if((typeof dispo !== 'undefined') && dispo && Array.isArray(dispo.contas)){
    for(const c of dispo.contas){
      for(const k of Object.keys(c.saldos||{})){
        if(parseFloat(c.saldos[k]) > 0){ hasDispo = true; break; }
      }
      if(hasDispo) break;
    }
  }
  return !(hasLoans || hasReceita || hasPessoas || hasEst || hasDispo);
}

