function _anaChRender_top_clientes(facts, _canvas){
  const ctx = _canvas || document.getElementById('ana-chart-top-clientes');
  if(!ctx) return;
  const _key = (ctx.id || 'top-clientes');
  _anaDestroyChart(_key);
  // Acumula recebido + em aberto por cliente
  const mapRec = new Map(), mapAbe = new Map(), mapTot = new Map();
  for(const f of facts){
    if(f.modulo !== 'receita') continue;
    const v = parseFloat(f.valor) || 0;
    const isRec = f.categoria === 'recebido';
    mapTot.set(f.entidade, (mapTot.get(f.entidade) || 0) + v);
    if(isRec) mapRec.set(f.entidade, (mapRec.get(f.entidade) || 0) + v);
    else      mapAbe.set(f.entidade, (mapAbe.get(f.entidade) || 0) + v);
  }
  const top = Array.from(mapTot.entries()).sort((a,b) => b[1]-a[1]).slice(0, 10);
  if(top.length === 0){
    ctx.parentElement.innerHTML = '<div class="ana-chart-empty">Sem receita no período.</div>';
    return;
  }
  const labels = top.map(t => t[0]);
  const rec = top.map(t => mapRec.get(t[0]) || 0);
  const abe = top.map(t => mapAbe.get(t[0]) || 0);
  // Total da receita do período inteiro (todos clientes — pra calcular % representação)
  const totalReceitaPeriodo = facts
    .filter(f => f.modulo === 'receita')
    .reduce((s,f) => s + (parseFloat(f.valor)||0), 0);
  _anaChartInstances[_key] = new Chart(ctx, {
    type:'bar', data:{
      labels,
      datasets:[
        { label:'Recebido', data:rec,
          backgroundColor:ANA_CH_COLOR.good+'cc', borderColor:ANA_CH_COLOR.good,
          borderWidth:1, borderRadius:{topRight:0,bottomRight:0,topLeft:4,bottomLeft:4} },
        { label:'Em aberto', data:abe,
          backgroundColor:'rgba(245,158,11,.6)', borderColor:'#F59E0B',
