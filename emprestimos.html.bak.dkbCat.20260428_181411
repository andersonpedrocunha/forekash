    { kw: ['custo', 'despes', 'estrutura', 'gasto'], ex: '"quanto gasto com estrutura?"' },
    { kw: ['imposto', 'tribut'], ex: '"quanto pago de imposto?"' },
    { kw: ['caixa', 'fluxo', 'runway', 'disponibil'], ex: '"qual o saldo?" / "como melhorar o runway?"' },
    { kw: ['divida', 'emprestim', 'parcela', 'dscr', 'alavanc'], ex: '"como está minha dívida?"' },
    { kw: ['taxa', 'juros', 'cdi', 'selic', 'spread'], ex: '"qual a taxa de juros?"' },
    { kw: ['margem', 'ebit', 'lucr'], ex: '"como está minha margem?"' },
    { kw: ['risc', 'perig', 'preocup'], ex: '"qual é o maior risco?"' },
    { kw: ['score', 'saude', 'nota', 'estado'], ex: '"por que esse score?"' },
    { kw: ['projec', 'previs', 'forecast', 'futur'], ex: '"detalhar a projeção de receita"' },
    { kw: ['cortar', 'reduzir', 'simul', 'cenari'], ex: '"e se eu cortar 10% da estrutura?"' },
    { kw: ['anomal', 'estranh', 'pico'], ex: '"tem alguma anomalia?"' },
    { kw: ['sazonal', 'ciclic', 'mes\s+forte', 'mes\s+fraco'], ex: '"tem sazonalidade?"' },
    { kw: ['passo', 'priorid', 'plano', 'fazer\s+primeiro'], ex: '"o que eu faço primeiro?"' }
  ];
  for(const d of dicas){
    if(d.kw.some(k => q.includes(k.replace(/\\s\+/g,' ')))){
      sugestoes.push(d.ex);
    }
  }

  if(sugestoes.length > 0){
    let msg = `Não peguei sua pergunta exatamente, mas vi que você mencionou algo relacionado. <br><br>Tenta uma destas:`;
    msg += `<ul style="margin:8px 0 0 18px">`;
    for(const s of sugestoes.slice(0,4)) msg += `<li>${s}</li>`;
    msg += `</ul>`;
    return msg;
  }

  // Realmente sem ideia: oferece overview
  return `Hmm. <br><br>Não encontrei resposta direta pra isso. Mas eu sei várias coisas — me pergunta algo como:<ul style="margin:8px 0 0 18px"><li>"o que eu tenho cadastrado no sistema"</li><li>"qual o saldo das minhas contas?"</li><li>"como está minha margem?"</li><li>"quais meus maiores gastos?"</li><li>"qual é o maior risco?"</li></ul>Ou simplesmente <em>"me dá um panorama"</em> que eu te resumo tudo.`;
}

function diagRenderHistory(){
