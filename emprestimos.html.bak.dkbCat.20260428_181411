// Helpers de export comuns
function _vendRelSlug(s){
  return String(s||'relatorio').toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'') || 'vendedor';
}
function _vendRelPeriodoLbl(st){
  const MESES_LBL = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
  const labelDe  = MESES_LBL[st.mesDe]  + '/' + String(st.anoDe).slice(2);
  const labelAte = MESES_LBL[st.mesAte] + '/' + String(st.anoAte).slice(2);
  const same = st.anoDe === st.anoAte && st.mesDe === st.mesAte;
  return same ? labelDe : (labelDe + ' — ' + labelAte);
}
function _vendRelPeriodoSlug(st){
  const PM = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  const de  = PM[st.mesDe]  + String(st.anoDe).slice(2);
  const ate = PM[st.mesAte] + String(st.anoAte).slice(2);
  return (st.anoDe === st.anoAte && st.mesDe === st.mesAte) ? de : (de + '-' + ate);
}
// CSV: padrão brasileiro (separador ';', decimal ',', BOM utf-8 pro Excel)
function _vendCsvNum(n){ return (Math.round((parseFloat(n)||0)*100)/100).toString().replace('.', ','); }
function _vendCsvEsc(s){
  const t = String(s == null ? '' : s);
  return /[";\n\r]/.test(t) ? '"' + t.replace(/"/g, '""') + '"' : t;
}
// Exportar CSV da aba atual
function _vendRelExportCSV(){
  if(!_vendRelState) return;
  const st = _vendRelState;
  const v = vendedores.lista.find(x => x.id === st.vendId);
  if(!v) return;
  const periodoLbl = _vendRelPeriodoLbl(st);
  const linhas = [];
  // Cabeçalho informativo
  linhas.push(['Relatório', v.nome || '(sem nome)'].map(_vendCsvEsc).join(';'));
  linhas.push(['Período', periodoLbl].map(_vendCsvEsc).join(';'));
  linhas.push(['Aba', st.tab === 'clientes' ? 'Clientes' : 'Pagamentos'].map(_vendCsvEsc).join(';'));
  linhas.push(''); // separador
  if(st.tab === 'clientes'){
    const d = _vendRelDataClientes(v, st);
    linhas.push(['Cliente','Bruto (R$)','Líquido c/ impostos (R$)','% Comissão','Comissão (R$)'].map(_vendCsvEsc).join(';'));
    for(const c of d.lista){
      linhas.push([c.nome, _vendCsvNum(c.bruto), _vendCsvNum(c.liq), _vendCsvNum(c.pct), _vendCsvNum(c.com)].map(_vendCsvEsc).join(';'));
    }
    if(d.outros !== 0){
      linhas.push(['Ajustes / Overrides (sem base)','','','', _vendCsvNum(d.outros)].map(_vendCsvEsc).join(';'));
    }
    linhas.push(['Total', _vendCsvNum(d.totBruto), _vendCsvNum(d.totLiq), _vendCsvNum(d.totPct), _vendCsvNum(d.totCom)].map(_vendCsvEsc).join(';'));
  } else {
    const d = _vendRelDataPagamentos(v, st);
    linhas.push(['Mês','Comissão gerada (R$)','Paga (R$)','À pagar (R$)','Status'].map(_vendCsvEsc).join(';'));
    for(const l of d.linhas){
      linhas.push([l.label, _vendCsvNum(l.ger), _vendCsvNum(l.paga), _vendCsvNum(l.saldo), l.statusLbl].map(_vendCsvEsc).join(';'));
    }
    linhas.push(['Total', _vendCsvNum(d.totGer), _vendCsvNum(d.totPaga), _vendCsvNum(d.totSaldo), d.totSaldo>0?'pendente':'quitado'].map(_vendCsvEsc).join(';'));
  }
  const csv = '\uFEFF' + linhas.join('\r\n');
  const blob = new Blob([csv], {type: 'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'comissoes-' + _vendRelSlug(v.nome) + '-' + st.tab + '-' + _vendRelPeriodoSlug(st) + '.csv';
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 120);
  try { if(typeof toast === 'function') toast('⬇️ CSV gerado — ' + a.download); } catch(e){}
}
