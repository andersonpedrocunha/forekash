  if(kind === 'rec-comp') return { fnAdd:'_recKbCompChange', fnOpenAt:'_recKbCompOpenAt', fnRemoveAt:'_recKbCompRemoveAt' };
  if(kind === 'rec-doc')  return { fnAdd:'_recKbAnexoChange', fnOpenAt:'_recKbAnexoOpenAt', fnRemoveAt:'_recKbAnexoRemoveAt' };
  if(kind === 'bx-comp')  return { fnAdd:'_extBxCompChange', fnOpenAt:'_extBxCompOpenAt', fnRemoveAt:'_extBxCompRemoveAt' };
  return { fnAdd:'_dkbAnexoChange', fnOpenAt:'_dkbAnexoOpenAt', fnRemoveAt:'_dkbAnexoRemoveAt' };
}

// Helper genérico para processar arquivos selecionados (multi)
function _dkbAnexoIngest(inp, callback){
  const files = inp && inp.files ? Array.from(inp.files) : [];
  if(!files.length) return;
  let pending = files.length;
  const out = [];
  files.forEach((f, idx) => {
    if(f.size > 1024 * 1024 * 1.05){
      if(typeof toast === 'function') toast('"' + f.name + '" muito grande (máx 1 MB)');
      pending--;
      if(pending === 0 && out.length > 0) callback(out);
      return;
    }
    const reader = new FileReader();
    reader.onload = (e) => {
      out.push({ name: f.name, type: f.type, size: f.size, dataUrl: e.target.result });
      pending--;
      if(pending === 0) callback(out);
    };
    reader.readAsDataURL(f);
  });
  // limpa o input pra permitir re-selecionar o mesmo arquivo
  try { inp.value = ''; } catch(_){}
}

function _dkbAnexoChange(inp){
  _dkbAnexoIngest(inp, (newOnes) => {
    _dkbAnexoData = (_dkbAnexoData || []).concat(newOnes);
    const wrap = document.getElementById('dkb-anexo-wrap');
    if(wrap) wrap.innerHTML = _dkbRenderAnexoUI(_dkbAnexoData, 'doc');
    _dkbAnexoAutoPersist('anexo', _dkbAnexoData);
  });
}
function _dkbCompChange(inp){
