    __formulaRecomputing = false;
  }
}
const fmtBRL = v => (parseFloat(v)||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const fmtShort=v => v>=1e6?'R$'+(v/1e6).toFixed(1).replace('.',',')+' M':v>=1e3?'R$'+(v/1e3).toFixed(0)+'k':'R$'+v.toFixed(0);
const esc    = s => (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
// Escapa um valor pra ser injetado dentro de uma string JS entre aspas simples,
// que por sua vez está dentro de um atributo HTML entre aspas duplas (ex: onclick="fn('${jsStr(x)}')")
const jsStr  = s => (s||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'")
                          .replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
const fmtTs  = iso => { const d=new Date(iso); return d.toLocaleDateString('pt-BR')+' às '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}); };
const fmtTsF = iso => { const d=new Date(iso); return d.toLocaleDateString('pt-BR',{day:'2-digit',month:'short',year:'numeric'})+' · '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}); };

// ═══════════════════════════════════════════════════
//  ROW REORDER (drag-and-drop)
// ═══════════════════════════════════════════════════
// Cada módulo registra uma função de reorder em ROW_REORDERERS com a chave
// `mod` (ex: 'pes', 'rec-client', 'rec-lead', 'est', 'dispo'). A função recebe
// (srcId, dstId, placeAbove) e deve reordenar o array e re-renderizar.
const ROW_REORDERERS = {};
// Ícone "grip" reutilizado pelo handle de todas as tabelas.
const ROW_GRIP_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="6" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="6" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="18" r="1"/></svg>';

// Retorna o HTML do handle (um span que, via mousedown, ativa draggable no tr).
function rowHandleHtml(){
  return `<span class="row-drag-handle" title="Arraste para reordenar" aria-label="Reordenar"
