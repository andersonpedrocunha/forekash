  const fmt = (typeof fmtBRL === 'function') ? fmtBRL : (n) => 'R$ ' + (n||0).toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2});
  const periodOpts = _cacPeriodOpts();
  const mesKey = _cacMesKey();
  const totEstr = _cacTotalEstrutura(mesKey);
  const totPess = _cacTotalPessoas(mesKey);
  const totalDesp = totEstr + totPess;
  const novos = _cacNovosClientes(mesKey);
