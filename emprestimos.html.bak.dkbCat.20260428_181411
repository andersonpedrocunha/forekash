}

// ── Scroll suave pra seções da landing ──
function fkScrollTo(id){
  const el = document.getElementById(id);
  if(!el) return;
  const gate = document.getElementById('forekash-gate');
  const navH = 62; // altura aprox do nav
  if(gate){
    const top = el.getBoundingClientRect().top + gate.scrollTop - navH;
    gate.scrollTo({ top, behavior: 'smooth' });
  }else{
    el.scrollIntoView({ behavior:'smooth', block:'start' });
  }
}

