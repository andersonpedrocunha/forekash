// ═══════════════════════════════════════════════════════════════
//  Renderização segura de mensagem para modais: escapa todo o conteúdo
//  e então re-permite um whitelist pequeno de tags inline (<strong>, <b>,
//  <em>, <i>, <br>) + quebras de linha com \n. O esc() do projeto só
//  escapa "<" (não ">" nem "/") portanto o whitelist precisa casar
//  com a saída real — ex.: "&lt;strong>" (sem &gt;).
// ═══════════════════════════════════════════════════════════════
function _modalMsgHtml(message){
  return esc(message)
    .replace(/\n/g, '<br>')
    .replace(/&lt;strong>/g, '<strong>').replace(/&lt;\/strong>/g, '</strong>')
    .replace(/&lt;b>/g,      '<b>').replace(/&lt;\/b>/g,      '</b>')
    .replace(/&lt;em>/g,     '<em>').replace(/&lt;\/em>/g,     '</em>')
    .replace(/&lt;i>/g,      '<i>').replace(/&lt;\/i>/g,       '</i>')
    .replace(/&lt;br\s*\/?>/g, '<br>');
}

// ═══════════════════════════════════════════════════════════════
//  Confirm modal (substitui window.confirm por UI customizada)
// ═══════════════════════════════════════════════════════════════
function showConfirm(opts){
  const o = opts || {};
  const title       = o.title        || 'Confirmar';
  const message     = o.message      || '';
  const confirmText = o.confirmLabel || 'Confirmar';
  const cancelText  = o.cancelLabel  || 'Cancelar';
  const destructive = !!o.destructive;
  return new Promise(resolve => {
    const ov = document.createElement('div');
    ov.className = 'confirm-overlay';
    const iconSvg = destructive
      ? '<svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m2 0v14a2 2 0 01-2 2H8a2 2 0 01-2-2V6M10 11v6M14 11v6"/></svg>'
      : '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>';
    const msgHtml = _modalMsgHtml(message);
    ov.innerHTML = `
      <div class="confirm-modal" role="dialog" aria-modal="true">
        <div class="confirm-icon ${destructive?'danger':'info'}">${iconSvg}</div>
        <h3 class="confirm-title">${esc(title)}</h3>
        <p class="confirm-msg">${msgHtml}</p>
        <div class="confirm-actions">
          <button class="confirm-btn confirm-cancel" type="button">${esc(cancelText)}</button>
          <button class="confirm-btn confirm-ok ${destructive?'danger':''}" type="button">${esc(confirmText)}</button>
        </div>
      </div>`;
    let done = false;
    const finish = (val) => {
      if(done) return; done = true;
      document.removeEventListener('keydown', onKey, true);
      ov.remove();
      resolve(val);
    };
    const onKey = (e) => {
      if(e.key === 'Escape'){ e.stopPropagation(); finish(false); }
      else if(e.key === 'Enter'){ e.stopPropagation(); finish(true); }
    };
    document.addEventListener('keydown', onKey, true);
    ov.addEventListener('click', (e) => { if(e.target === ov) finish(false); });
    document.body.appendChild(ov);
    ov.querySelector('.confirm-cancel').onclick = () => finish(false);
    ov.querySelector('.confirm-ok').onclick = () => finish(true);
    setTimeout(() => { const ok = ov.querySelector('.confirm-ok'); if(ok) ok.focus(); }, 20);
  });
}

// ═══════════════════════════════════════════════════════════════
//  Info modal (substitui alert() nativo — só botão OK, estilo consistente)
// ═══════════════════════════════════════════════════════════════
function showInfo(arg){
  // Aceita string (mensagem simples) ou objeto { title, message, confirmLabel, warning }
  const o = (typeof arg === 'string') ? { message: arg } : (arg || {});
  const title       = o.title        || 'Aviso';
  const message     = o.message      || '';
  const confirmText = o.confirmLabel || 'OK';
  const warning     = !!o.warning;
  return new Promise(resolve => {
    const ov = document.createElement('div');
    ov.className = 'confirm-overlay';
    const iconSvg = warning
      ? '<svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>'
      : '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>';
    const msgHtml = _modalMsgHtml(message);
    ov.innerHTML = `
      <div class="confirm-modal" role="dialog" aria-modal="true">
        <div class="confirm-icon ${warning?'danger':'info'}">${iconSvg}</div>
        <h3 class="confirm-title">${esc(title)}</h3>
        <p class="confirm-msg">${msgHtml}</p>
        <div class="confirm-actions" style="justify-content:center">
          <button class="confirm-btn confirm-ok" type="button" style="min-width:120px">${esc(confirmText)}</button>
        </div>
      </div>`;
    let done = false;
    const finish = () => {
      if(done) return; done = true;
      document.removeEventListener('keydown', onKey, true);
      ov.remove();
      resolve();
    };
    const onKey = (e) => {
      if(e.key === 'Escape' || e.key === 'Enter'){ e.stopPropagation(); finish(); }
    };
    document.addEventListener('keydown', onKey, true);
    ov.addEventListener('click', (e) => { if(e.target === ov) finish(); });
    document.body.appendChild(ov);
    ov.querySelector('.confirm-ok').onclick = finish;
    setTimeout(() => { const ok = ov.querySelector('.confirm-ok'); if(ok) ok.focus(); }, 20);
  });
}

