// ════════════════════════════════════════════════════════════
let _recKbState = { from: null, to: null, search: '', quick: null };
let _recKbView  = 'sheet'; // 'sheet' | 'kanban'

const REC_KB_COLS = [
  { id:'vencer',   label:'A Vencer',          icon:'📅' },
  { id:'mes',      label:'Vence Este Mês',    icon:'⚡' },
  { id:'semana',   label:'Vence Esta Semana', icon:'⏰' },
  { id:'atraso',   label:'Em Atraso',         icon:'⚠️' },
  { id:'recebido', label:'Recebido',          icon:'✅' }
];

// ── Settings visuais do Kanban Financeiro (persistidos em localStorage) ──
const REC_KB_SETTINGS_KEY = 'forekash_rec_kb_settings_v1';
const _recKbSettingsDefaults = {
  showRefMes: true, showVencimento: false, showValor: true,
  showPais: true, showDescricao: true, showDoc: true, showNotas: true,
  compact3: false, colNames: {}
};
let _recKbSettings = Object.assign({}, _recKbSettingsDefaults);
function _recKbLoadSettings(){
  try {
    const raw = localStorage.getItem(REC_KB_SETTINGS_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && typeof obj === 'object') Object.assign(_recKbSettings, obj);
      if(!_recKbSettings.colNames || typeof _recKbSettings.colNames !== 'object') _recKbSettings.colNames = {};
    }
  } catch(e){}
}
function _recKbSaveSettings(){
  try { localStorage.setItem(REC_KB_SETTINGS_KEY, JSON.stringify(_recKbSettings)); }
  catch(e){}
}
