function _anaStyleString(st){
  st = st || {};
  const parts = [];
  if(st.fontFamily) parts.push('font-family:' + st.fontFamily);
  if(st.fontSize)   parts.push('font-size:' + st.fontSize + 'px');
  if(st.color)      parts.push('color:' + st.color + ' !important');
  if(st.align)      parts.push('text-align:' + st.align);
  if(st.bold)       parts.push('font-weight:bold');
  if(st.italic)     parts.push('font-style:italic');
  if(st.underline)  parts.push('text-decoration:underline');
  return parts.join(';').replace(/"/g, '&quot;');
