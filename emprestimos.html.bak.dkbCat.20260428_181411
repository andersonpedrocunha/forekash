// ─── Auto-sugestão de DRC/DRE pra uma categoria ───
// Regra: prioriza moduloId; ajusta DRE por nome quando rubrica de imposto / tag específica.
// IDs usados ficam alinhados com _FLX_LINES_DRC/_FLX_LINES_DRE pra futura integração com Fluxo.
function _catmapSuggestVinculos(c){
  const nome = (c && c.nome ? String(c.nome) : '').toLowerCase();
  const mod = (c && c.moduloId ? String(c.moduloId) : '');
  const out = { drcLineId: '', dreLineId: '' };

  switch(mod){
    case 'receita':
      out.drcLineId = 'receita';
      out.dreLineId = 'receita';
      break;
    case 'pessoas':
      out.drcLineId = 'folha';
      out.dreLineId = 'folha';
      break;
    case 'emprestimos':
      out.drcLineId = 'emprestimos';
      // No DRE, parcelas têm 2 componentes (juros vão pra resultado, principal pra amortização).
      // Como default, manda pra "juros" — usuário ajusta caso queira amortizacao.
      out.dreLineId = 'juros';
      break;
    case 'comissoes':
    case 'viagens':
      out.drcLineId = 'despesas';
      out.dreLineId = 'despesas';
      break;
    case 'outrasRec':
      out.drcLineId = 'outrasRec';
      out.dreLineId = 'outrasRec';
      break;
    case 'outrasDesp':
      out.drcLineId = 'outrasDesp';
      out.dreLineId = 'outrasDesp';
      break;
    case 'extrato':
      // Categoria livre só pro extrato — default em 'despesas' (user pode mudar)
      out.drcLineId = 'despesas';
      out.dreLineId = 'despesas';
      break;
    case 'estrutura': {
      // Tag de Estrutura: default em despesas; heurística por palavras-chave.
      out.drcLineId = 'despesas';
      out.dreLineId = 'despesas';
      if(/\bjuros\b|financeir/.test(nome)){
        out.dreLineId = 'juros';
      } else if(/banc[áa]ria|banco|cart[óo]rio/.test(nome)){
        // serviços bancários ficam em despesas mesmo
      }
      break;
    }
    case 'impostos': {
      // Rubrica de imposto: DRC sempre em "impostos". DRE depende da natureza:
      //  • Sobre receita (ICMS, ISS, PIS, COFINS, ISSQN) → Deduções da Receita
      //  • Sobre lucro (IRPJ, CSLL) → Despesas Tributárias
      //  • Sobre folha (INSS, FGTS) → Folha
      //  • Outros → Despesas Tributárias (default seguro)
      out.drcLineId = 'impostos';
      if(/^(icms|iss|issqn|pis|cofins|simples)/.test(nome)){
        out.dreLineId = 'deducoes';
      } else if(/^(irpj|csll)/.test(nome)){
        out.dreLineId = 'despesasTrib';
      } else if(/^(inss|fgts)/.test(nome)){
        out.dreLineId = 'folha';
      } else {
        out.dreLineId = 'despesasTrib';
      }
      break;
    }
    default: {
      // Sem módulo conhecido: heurística por nome
      if(/recei|venda|servic/.test(nome)){
        out.drcLineId = 'receita';
        out.dreLineId = 'receita';
      } else if(/folha|sal[áa]ri|colaborador|funcion[áa]ri/.test(nome)){
        out.drcLineId = 'folha';
        out.dreLineId = 'folha';
      } else if(/juros|financeir/.test(nome)){
        out.drcLineId = 'despesas';
        out.dreLineId = 'juros';
      } else if(/imposto|tribut/.test(nome)){
        out.drcLineId = 'impostos';
        out.dreLineId = 'despesasTrib';
      } else {
        out.drcLineId = 'despesas';
        out.dreLineId = 'despesas';
      }
    }
  }
  return out;
}

// Varre o sistema procurando categorias.
// Regra: cada Módulo vira 1 categoria. Exceções:
//   - Estrutura: 1 categoria por tag em estrutura.tags
//   - Impostos: 1 categoria por rubrica em impostos.rubricas (Impostos Correntes)
// Cada entrada já vem com moduloId pré-preenchido.
function _catmapDiscover(){
  const seen = new Map(); // key=lower(nome), value={nome, cor, origem, moduloId}
  const blacklist = (typeof CATMAP_NOME_BLACKLIST !== 'undefined' && Array.isArray(CATMAP_NOME_BLACKLIST))
    ? CATMAP_NOME_BLACKLIST.map(s => String(s).toLowerCase())
    : [];
  const add = (nome, cor, origem, moduloId) => {
    if(!nome) return;
    const trimmed = String(nome).trim();
    if(!trimmed) return;
    const key = trimmed.toLowerCase();
    if(blacklist.indexOf(key) !== -1) return; // filtra nomes da blacklist (ex: "abc")
    if(seen.has(key)) return;
    seen.set(key, { nome: trimmed, cor: cor || null, origem: origem || '', moduloId: moduloId || '' });
  };

  for(const mod of CATMAP_MODULOS){
    // Outras Receitas/Despesas e 'extrato' são manuais — não viram categoria automaticamente.
    if(mod.id === 'outrasRec' || mod.id === 'outrasDesp' || mod.id === 'extrato') continue;
    if(mod.id === 'estrutura'){
      // Decompõe em tags (cada tag = 1 categoria)
      try {
        if(typeof estrutura !== 'undefined' && estrutura && Array.isArray(estrutura.tags)){
          for(const t of estrutura.tags){
            if(t && t.nome) add(t.nome, t.color || t.cor, 'Estrutura · tag', 'estrutura');
          }
        }
      } catch(e){ console.warn('catmap/discover/estrutura:', e); }
    } else if(mod.id === 'impostos'){
      // Decompõe em rubricas (Impostos Correntes — cada imposto/rubrica = 1 categoria)
      try {
        if(typeof impostos !== 'undefined' && impostos && Array.isArray(impostos.rubricas)){
          for(const r of impostos.rubricas){
            if(r && r.nome) add(r.nome, r.color || r.cor, 'Impostos · rubrica', 'impostos');
          }
        }
      } catch(e){ console.warn('catmap/discover/impostos:', e); }
    } else {
      // Demais módulos: 1 categoria com nome do módulo
      add(mod.nome, null, 'Módulo', mod.id);
    }
  }
  return Array.from(seen.values());
}

// Mescla descobertas com catmapData. Sincroniza (não só adiciona):
//  - autoDiscovered ausente da fonte e SEM vínculos: descarta
//  - autoDiscovered ausente da fonte mas COM vínculos: promove a manual (preserva edits)
//  - autoDiscovered ainda presente: atualiza cor/origem/moduloId vindos da fonte
//  - novos: adiciona como autoDiscovered=true
function _catmapMergeDiscovered(){
  const found = _catmapDiscover();
  const foundByKey = new Map();
  for(const f of found) foundByKey.set(f.nome.toLowerCase(), f);
  if(!Array.isArray(catmapData.categorias)) catmapData.categorias = [];

  const kept = [];
  for(const c of catmapData.categorias){
    const key = (c.nome || '').toLowerCase();
    if(c.autoDiscovered){
      const f = foundByKey.get(key);
      if(f){
        // Atualiza informação derivada da fonte
        if(f.cor) c.cor = c.cor && c.cor !== '#94A3B8' ? c.cor : f.cor;
        c.origem = f.origem || c.origem;
        // Sobrescreve moduloId só se não foi mexido pelo user (heurística: atual igual ao antigo discovery)
        if(!c.moduloId || c.moduloId === f.moduloId) c.moduloId = f.moduloId || c.moduloId;
        // Backfill: se DRC e DRE ainda vazios E ninguém aplicou sugestão antes, aplica agora.
        if(!c.drcLineId && !c.dreLineId && !c.suggestionApplied){
          const sugg = _catmapSuggestVinculos(c);
          c.drcLineId = sugg.drcLineId;
          c.dreLineId = sugg.dreLineId;
          c.suggestionApplied = true;
        }
        kept.push(c);
      } else {
        // Sumiu da fonte: se tinha vínculos drc/dre, promove a manual; senão descarta
        if(c.drcLineId || c.dreLineId){
          c.autoDiscovered = false;
          c.origem = '(removida da fonte)';
          kept.push(c);
        }
        // else: skip (descarta)
      }
    } else {
      // Manual: sempre mantém
      kept.push(c);
    }
  }

  let added = 0;
  for(const f of found){
    const exists = kept.some(c => (c.nome||'').trim().toLowerCase() === f.nome.toLowerCase());
    if(exists) continue;
    const fresh = {
      id: catmapData.nextId++,
      nome: f.nome,
      moduloId: f.moduloId || '',
      drcLineId: '',
      dreLineId: '',
      cor: f.cor || '#94A3B8',
      autoDiscovered: true,
      origem: f.origem || ''
    };
    // Aplica sugestão de DRC/DRE pra entrada nova
    const sugg = _catmapSuggestVinculos(fresh);
    fresh.drcLineId = sugg.drcLineId;
    fresh.dreLineId = sugg.dreLineId;
    fresh.suggestionApplied = true;
    kept.push(fresh);
    added++;
  }

  catmapData.categorias = kept;
  _catmapSave();
  return added;
}

function _catmapLoad(){
  try {
    const raw = localStorage.getItem(CATMAP_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && typeof obj === 'object'){
        if(Array.isArray(obj.categorias)) catmapData.categorias = obj.categorias;
        if(typeof obj.nextId === 'number') catmapData.nextId = obj.nextId;
      }
    }
  } catch(e){ console.warn('catmap/load:', e); }
}
function _catmapSave(){
  try {
    localStorage.setItem(CATMAP_KEY, JSON.stringify({ categorias: catmapData.categorias, nextId: catmapData.nextId }));
  } catch(e){ console.warn('catmap/save:', e); }
}
_catmapLoad();

