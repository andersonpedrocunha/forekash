  const top3Pct = total > 0 ? (top3Sum/total)*100 : 0;
  let msg = `Você tem <b>${snap.receita.clientesAtivos}</b> cliente${snap.receita.clientesAtivos===1?'':'s'} ativo${snap.receita.clientesAtivos===1?'':'s'}`;
  if(snap.receita.clientesInativos) msg += ` (e ${snap.receita.clientesInativos} inativo${snap.receita.clientesInativos===1?'':'s'})`;
  msg += '.';
  if(top1){
    const top1Pct = total > 0 ? ((top1.valor||0)/total)*100 : 0;
    msg += ` Maior: <b>${esc(top1.nome)}</b> com ${fmtBRL(top1.valor||0)} (${top1Pct.toFixed(1)}% do total).`;
  }
  msg += `<br><br>Top 3 concentra <b>${top3Pct.toFixed(0)}%</b> da receita.`;
  if(top3Pct > 60) msg += ` ⚠️ Concentração alta — a saída de um desses clientes vira uma crise rápida. Priorize diversificar.`;
  else if(top3Pct > 40) msg += ` Concentração moderada — ok, mas fique de olho.`;
  else msg += ` Distribuição saudável.`;
  if(top3Pct > 40){
    msg += `<br><br><small style="opacity:.75">Quer um plano para reduzir concentração? Responda <b>sim</b>.</small>`;
