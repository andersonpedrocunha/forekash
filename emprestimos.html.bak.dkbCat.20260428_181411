const SB_GROUPS_KEY = 'forekash:sbGroups:v1';
function _sbGroupsLoadState(){
  try {
    const raw = localStorage.getItem(SB_GROUPS_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && typeof obj === 'object') return obj;
    }
  } catch(e){}
  // Default: todos abertos
  return { caixa: true, custos: true, analise: true };
}
function _sbGroupsSaveState(state){
  try { localStorage.setItem(SB_GROUPS_KEY, JSON.stringify(state)); } catch(e){}
}
function sbGroupApply(state){
  document.querySelectorAll('.sidebar .sb-group').forEach(g => {
    const k = g.getAttribute('data-group');
    const open = state[k] !== false; // default = aberto
    g.classList.toggle('is-open', open);
  });
}
function sbGroupToggle(key){
  const state = _sbGroupsLoadState();
  state[key] = !(state[key] !== false); // toggle (default open → fecha; fechado → abre)
  _sbGroupsSaveState(state);
  sbGroupApply(state);
}
// Atualiza contador (qtos itens no grupo) e marca has-active se algum item interno estiver ativo
function sbGroupRefresh(){
  document.querySelectorAll('.sidebar .sb-group').forEach(g => {
    const items = g.querySelectorAll('.sb-group-items > .sb-item');
    const cnt = g.querySelector('.sb-group-hd .count');
    if(cnt) cnt.textContent = String(items.length);
    const hasActive = !!g.querySelector('.sb-group-items > .sb-item.active');
    g.classList.toggle('has-active', hasActive);
  });
}
// Auto-expande o grupo do módulo ativo (chamado em switchModule)
function sbGroupAutoExpand(moduleKey){
  const groupKey = SB_GROUP_OF[moduleKey];
  if(!groupKey) return;
  const state = _sbGroupsLoadState();
  if(state[groupKey] === false){
    state[groupKey] = true;
    _sbGroupsSaveState(state);
    sbGroupApply(state);
  }
}
