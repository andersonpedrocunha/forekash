    if(parts.length < 2) return ym;
    const meses = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
    const idx = parseInt(parts[1],10) - 1;
    return (meses[idx] || parts[1]) + '/' + parts[0].slice(2);
  };
