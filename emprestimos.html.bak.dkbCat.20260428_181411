  _estTagPickerEditing = null;
  renderEstTagPicker();
  renderEstSheet();
}
async function deleteEstTagFromPicker(tagId){
  const usage = estrutura.itens.filter(i=>i.tagId===tagId).length;
  const t = estTag(tagId);
  if(!t) return;
  const msg = usage > 0
    ? `A tag <strong>${t.nome}</strong> está em uso em <strong>${usage}</strong> item(ns). Se excluir, esses itens ficarão sem tag.`
    : `Remover permanentemente a tag <strong>${t.nome}</strong>?`;
  const ok = await showConfirm({
    title: 'Excluir tag',
    message: msg,
    confirmLabel: 'Excluir', destructive: true
  });
  if(!ok) return;
  for(const it of estrutura.itens){
    if(it.tagId === tagId) it.tagId = null;
  }
  estrutura.tags = estrutura.tags.filter(x=>x.id !== tagId);
  estSave();
  renderEstTagPicker();
  renderEstSheet();
}
function _onEstTagPickerOutside(e){
  if(_estTagPickerEl && !_estTagPickerEl.contains(e.target)) closeEstTagPicker();
