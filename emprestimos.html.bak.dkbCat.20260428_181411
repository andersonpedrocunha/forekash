function _renderCredSugestoes(){
  const el = document.getElementById('cred-sugestoes');
  if(!el) return;
  const credList = ((dispo && dispo.creditoDisponivel) || [])
    .filter(c => c.possibilidade !== 'negada' && (parseFloat(c.valor)||0) > 0 && (parseFloat(c.taxa)||0) > 0);
  // loans é variável global do módulo Empréstimos
  const loanList = (typeof loans !== 'undefined' && Array.isArray(loans)) ? loans : [];
  // Para cada loan ativo (saldo > 0, taxa > 0), busca créditos com taxa MENOR
  // e valor disponível >= saldo do loan.
  const oportunidades = [];
  for(const ln of loanList){
    const saldo = parseFloat(ln.saldo) || 0;
    const taxaLn = parseFloat(ln.taxa) || 0;
    if(saldo <= 0 || taxaLn <= 0) continue;
    const nomeLn = (ln.banco||'Empr\u00e9stimo') + (ln.descricao ? ' \u2014 ' + ln.descricao : '');
    for(const cr of credList){
      const taxaCr = parseFloat(cr.taxa) || 0;
      const valCr = parseFloat(cr.valor) || 0;
      if(taxaCr >= taxaLn) continue; // só economia se taxa MENOR
      const cobreTotalmente = valCr >= saldo;
      const economiaMes = saldo * (taxaLn - taxaCr) / 100;
      if(economiaMes <= 0) continue;
      const banco = (dispo.bancos||[]).find(b => b.id === cr.bancoId);
      const nomeCr = (banco ? banco.nome : 'Cr\u00e9dito') + (cr.descricao ? ' \u2014 ' + cr.descricao : '');
      oportunidades.push({
        loan: ln, credito: cr,
        nomeLn, nomeCr,
        saldoLn: saldo, taxaLn, taxaCr, valCr,
        economiaMes, cobreTotalmente,
        possibilidade: cr.possibilidade
      });
    }
  }
  oportunidades.sort((a,b) => b.economiaMes - a.economiaMes);
  if(oportunidades.length === 0){
    if(credList.length === 0){
      el.innerHTML = '<div class="cred-sug-wrap"><div class="cred-sug-empty">'
                    + 'Cadastre cr\u00e9ditos dispon\u00edveis acima e o sistema vai sugerir oportunidades de quita\u00e7\u00e3o automaticamente.'
                    + '</div></div>';
    } else if(loanList.length === 0){
      el.innerHTML = '<div class="cred-sug-wrap"><div class="cred-sug-empty">'
                    + 'Nenhum empr\u00e9stimo cadastrado pra comparar. Vai em <b>Empr\u00e9stimos</b> e cadastra suas linhas ativas.'
                    + '</div></div>';
    } else {
      el.innerHTML = '<div class="cred-sug-wrap">'
                    + '<div class="cred-sug-hd"><h3>\ud83d\udd0d Sugest\u00f5es de quita\u00e7\u00e3o</h3></div>'
                    + '<div class="cred-sug-empty">Nenhuma oportunidade encontrada \u2014 todos seus cr\u00e9ditos t\u00eam taxa igual ou maior que os empr\u00e9stimos ativos.</div>'
                    + '</div>';
    }
    return;
  }
  el.innerHTML = '<div class="cred-sug-wrap">'
    + '<div class="cred-sug-hd">'
    +   '<h3>\ud83d\udca1 Sugest\u00f5es de quita\u00e7\u00e3o</h3>'
    +   '<small>' + oportunidades.length + ' oportunidade' + (oportunidades.length===1?'':'s') + ' \u00b7 ordenadas por economia</small>'
    + '</div>'
    + '<div class="cred-sug-list">'
    + oportunidades.map(o => {
        const cls = o.cobreTotalmente ? '' : ' warn';
        const possLbl = (CRED_POSS_OPTS.find(p => p.id === o.possibilidade) || {nome:'?'}).nome;
        const economiaAno = o.economiaMes * 12;
        const cobreInfo = o.cobreTotalmente
          ? 'Cobre o saldo total'
          : 'Cobre <b>' + Math.round((o.valCr / o.saldoLn) * 100) + '%</b> do saldo (R$ ' + fmtBR(o.valCr,2) + ' / ' + fmtBR(o.saldoLn,2) + ')';
        return '<div class="cred-sug-item' + cls + '">'
          + '<div class="arrow">\u2192</div>'
          + '<div class="swap">'
          +   'Quitar <b>' + esc(o.nomeLn) + '</b> (R$ ' + fmtBR(o.saldoLn,2) + ' a ' + o.taxaLn.toFixed(2).replace('.',',') + '% a.m.)<br>'
          +   'usando <b>' + esc(o.nomeCr) + '</b> a ' + o.taxaCr.toFixed(2).replace('.',',') + '% a.m. \u00b7 '
          +   '<span style="color:#6B7280">' + cobreInfo + ' \u00b7 Elegibilidade: <b>' + possLbl + '</b></span>'
          + '</div>'
          + '<div class="economia" title="Economia mensal estimada">'
          +   '\u2212 R$ ' + fmtBR(o.economiaMes, 2) + '/m\u00eas<br>'
          +   '<span style="font-size:.7rem;color:#6B7280;font-weight:600">R$ ' + fmtBR(economiaAno, 2) + '/ano</span>'
          + '</div>'
          + '</div>';
      }).join('')
    + '</div>'
    + '</div>';
}

function renderDispo(){
  if(!dispo) return;
  renderDispoYearTabs();
  renderDispoStatusFilter();
  renderDispoSheet();
  updateDispoKpis();
}

function renderDispoStatusFilter(){
  const el = document.getElementById('dispo-status-filter');
  if(!el) return;
  const contas = dispo.contas || [];
  const nAtivos   = contas.filter(c => c.ativo !== false).length;
  const nInativos = contas.filter(c => c.ativo === false).length;
  const nTodos    = contas.length;
  const cur = dispo.statusFilter || 'all';
  const item = (key, label, n) => `
    <button class="sf-btn${cur===key?' active':''}"
            onclick="setDispoStatusFilter('${key}')"
            title="Mostrar ${label.toLowerCase()}">
      ${label} <span class="sf-count">${n}</span>
    </button>`;
  el.innerHTML =
    `<span class="sf-lbl">Mostrar</span>` +
    item('all',      'Todos',    nTodos) +
    item('ativos',   'Ativos',   nAtivos) +
    item('inativos', 'Inativos', nInativos);
}

function setDispoStatusFilter(key){
  if(!['all','ativos','inativos'].includes(key)) key = 'all';
  if((dispo.statusFilter||'all') === key) return;
  dispo.statusFilter = key;
  dispoSave();
  renderDispo();
}

function dispoStatusMatch(c){
  const f = (dispo && dispo.statusFilter) || 'all';
  if(f === 'ativos')   return c.ativo !== false;
  if(f === 'inativos') return c.ativo === false;
  return true;
}

function renderDispoYearTabs(){
  const el = document.getElementById('dispo-year-tabs'); if(!el) return;
  const tabs = dispo.years.map(y => `
    <button class="pes-year-tab${y===dispoActiveYear?' active':''}" onclick="setDispoActiveYear('${y}')">
      <span>${y}</span>
      <span class="rec-year-dup" onclick="event.stopPropagation();duplicateDispoYear('${y}')" title="Duplicar este ano">⧉</span>
      <span class="pes-year-del" onclick="event.stopPropagation();delDispoYear('${y}')" title="Excluir este ano">✕</span>
    </button>`).join('');
  el.innerHTML = tabs + `<button class="pes-year-add" onclick="addDispoYear()">+ Ano</button>`;
}

function setDispoActiveYear(y){
  if(!dispo.years.includes(y)) return;
  dispoActiveYear = y; dispoSave(); renderDispo();
}
async function addDispoYear(){
  const sorted = [...dispo.years].sort();
  const suggested = sorted.length ? String(+sorted[sorted.length-1]+1) : String(new Date().getFullYear());
  const y = await askText({
    title: 'Adicionar ano',
    label: 'Ano',
    placeholder: 'YYYY',
    initialValue: suggested,
    confirmText: 'Adicionar',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!/^\d{4}$/.test(s)) return 'Informe um ano válido de 4 dígitos.';
      if(dispo.years.includes(s)) return 'Esse ano já está cadastrado.';
      return null;
    }
  });
  if(!y) return;
  dispo.years.push(y); dispo.years.sort();
  dispoActiveYear = y; dispoSave(); renderDispo();
}
async function duplicateDispoYear(srcYear){
  const sorted = [...dispo.years].sort();
  const suggested = sorted.length ? String(+sorted[sorted.length-1]+1) : String(+srcYear+1);
  const y = await askText({
    title: 'Duplicar ano',
    label: `Duplicar ${srcYear} como:`,
    placeholder: 'YYYY',
    initialValue: suggested,
    confirmText: 'Duplicar',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!/^\d{4}$/.test(s)) return 'Informe um ano válido de 4 dígitos.';
      if(s === srcYear) return 'Escolha um ano diferente.';
      if(dispo.years.includes(s)) return 'Esse ano já está cadastrado.';
      return null;
    }
  });
  if(!y) return;
  // Copiar valores do srcYear → y
  for(const c of dispo.contas){
    for(let m=0;m<12;m++){
      const src = dispoMesKey(srcYear,m), dst = dispoMesKey(y,m);
      if(c.saldos[src] != null) c.saldos[dst] = c.saldos[src];
    }
  }
  dispo.years.push(y); dispo.years.sort();
  dispoActiveYear = y; dispoSave(); renderDispo();
}
async function delDispoYear(y){
  if(dispo.years.length === 1){ await showInfo({title:'Ação não permitida', message:'Não é possível excluir o único ano.', warning:true}); return; }
  const ok = await showConfirm({
    title: `Excluir ano ${y}`,
    message: `Todos os saldos mensais de <strong>${y}</strong> serão removidos. Essa ação não pode ser desfeita.`,
    confirmLabel: 'Excluir ano', destructive: true
  });
  if(!ok) return;
  for(const c of dispo.contas){
    for(let m=0;m<12;m++){ delete c.saldos[dispoMesKey(y,m)]; }
  }
  dispo.years = dispo.years.filter(x => x !== y);
  if(dispoActiveYear === y) dispoActiveYear = dispo.years[dispo.years.length-1];
  dispoSave(); renderDispo();
}

function renderDispoSheet(){
  const thead = document.getElementById('dispo-thead');
  const tbody = document.getElementById('dispo-tbody');
  const tfoot = document.getElementById('dispo-tfoot');
  if(!thead || !tbody || !tfoot) return;
  const year = dispoCurYear();
  // Header
  const mesThs = DISPO_MESES.map((_,m) =>
    `<th class="mes" title="${DISPO_MESES[m]}/${year}">${dispoMesLabel(year,m)}</th>`
  ).join('');
  thead.innerHTML = `<tr>
    <th class="stk stk-1">Banco</th>
    <th class="stk stk-2">Tipo</th>
    <th class="stk stk-3" title="Ativo / Inativo">Ativo</th>
    ${mesThs}
    <th class="del"></th>
  </tr>`;

  if(!dispo.contas.length){
    tbody.innerHTML = `<tr class="dispo-empty-row"><td colspan="${15+1}">
      Nenhuma conta cadastrada. Clique em <strong>+ Nova conta</strong> para começar.
    </td></tr>`;
    tfoot.innerHTML = '';
    return;
  }

  // Liquidez agora vem do TIPO, não do grupo
  const liq = c => { const tp = dispoTipo(c.tipoId); return tp ? tp.liquidez : 'caixa'; };
  // Aplica filtro de status (Todos / Ativos / Inativos)
  const visibles = dispo.contas.filter(dispoStatusMatch);
  const contasCaixa    = visibles.filter(c => liq(c) === 'caixa');
  const contasReservas = visibles.filter(c => liq(c) === 'reserva');

  // Ordena cada bloco: ativos primeiro, inativos embaixo. Dentro de cada
  // partição, mantém a ordem do array `dispo.contas` (sort estável) —
  // assim o drag-reorder reflete diretamente na posição visível.
  const sortFn = (a,b) => {
    const aa = (a.ativo !== false) ? 0 : 1;
    const bb = (b.ativo !== false) ? 0 : 1;
    return aa - bb;
  };
  contasCaixa.sort(sortFn);
  contasReservas.sort(sortFn);

  // Estado vazio quando o filtro exclui tudo
  if(!visibles.length){
    const f = dispo.statusFilter || 'all';
    const msg = f === 'ativos'
      ? `Nenhuma conta ativa. <a href="#" onclick="event.preventDefault();setDispoStatusFilter('all')" style="color:var(--blue-d);text-decoration:underline">Ver todas</a>.`
      : f === 'inativos'
        ? `Nenhuma conta inativa. <a href="#" onclick="event.preventDefault();setDispoStatusFilter('all')" style="color:var(--blue-d);text-decoration:underline">Ver todas</a>.`
        : `Nenhuma conta visível com o filtro atual.`;
    tbody.innerHTML = `<tr class="dispo-empty-row"><td colspan="${15+1}">${msg}</td></tr>`;
    // Footer ainda mostra o total global (de todas as contas)
    const totalLine = renderDispoAggRow('saldo-total', 'Saldo total', dispo.contas, year, true);
    const varLine   = renderDispoVarRow(dispo.contas, year);
    tfoot.innerHTML = totalLine + varLine;
    return;
  }

  // Montar tbody com seções
  let html = '';
  html += `<tr class="dispo-sec-hd"><td class="stk stk-1" colspan="3">Saldos em conta corrente e investimentos temporários</td>
           <td colspan="12"></td><td></td></tr>`;
  html += `<tr class="dispo-sub-hd"><td class="stk stk-1" colspan="3">Liquidez alta</td>
           <td colspan="12"></td><td></td></tr>`;
  html += contasCaixa.map(c => renderDispoRow(c, year)).join('');
  // SALDO EM CAIXA
  html += renderDispoAggRow('saldo-caixa', 'Saldo em caixa', contasCaixa, year);

  // Só mostra o bloco de reserva se tiver contas de liquidez baixa
  if(contasReservas.length){
    html += `<tr class="dispo-sec-hd"><td class="stk stk-1" colspan="3">Reserva e investimentos de longo prazo</td>
             <td colspan="12"></td><td></td></tr>`;
    html += `<tr class="dispo-sub-hd"><td class="stk stk-1" colspan="3">Liquidez baixa</td>
             <td colspan="12"></td><td></td></tr>`;
    html += contasReservas.map(c => renderDispoRow(c, year)).join('');
    html += renderDispoAggRow('saldo-reserva', 'Saldo das reservas', contasReservas, year);
  }

  tbody.innerHTML = html;

  // Footer: SALDO TOTAL + % variação — reflete as contas visíveis no filtro atual
  const totalLine = renderDispoAggRow('saldo-total', 'Saldo total', visibles, year, true);
  const varLine   = renderDispoVarRow(visibles, year);
  tfoot.innerHTML = totalLine + varLine;
}

