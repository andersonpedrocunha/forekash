      for(const l of (Array.isArray(loans) ? loans : [])){
        if(!Array.isArray(l.registros)) l.registros = [];
        let reg = l.registros.find(r => r.mes === mes);
        // Valor da parcela projetada pra esse mês (sem considerar o registro)
        const saldoAtual = parseFloat(l.saldo) || 0;
        const parcelaLoan = parseFloat(l.parcelaVal) || 0;
        const taxa = (parseFloat(l.taxa) || 0) / 100;
        if(parcelaLoan <= 0) continue;
        const juros = Math.max(0, Math.min(parcelaLoan, saldoAtual * taxa));
        const amort = Math.max(0, parcelaLoan - juros);
        const saldoFim = Math.max(0, saldoAtual - amort);
        if(!reg){
          reg = { mes, parcelaEfetivada:'', saldoEfetivado:'', jurosEfetivado:'', amortEfetivada:'', extras:[], ts:new Date().toISOString() };
          l.registros.push(reg);
