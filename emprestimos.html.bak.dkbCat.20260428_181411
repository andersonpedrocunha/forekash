    .catmap-row.is-auto{border-style:dashed;background:#FEFEFC}
    .catmap-row.is-auto:hover{border-style:solid}
    .catmap-row.is-mapped{background:#F0FDF4;border-color:#86EFAC}
    .catmap-row.is-mapped:hover{border-color:#22C55E}
    .catmap-origem{display:inline-block;font-size:.62rem;font-weight:700;color:#7C3AED;background:#F3E8FF;padding:1px 7px;border-radius:9px;margin-left:7px;text-transform:uppercase;letter-spacing:.04em;vertical-align:middle}
    /* Tabs dentro do modal DKB (Detalhes / Pagamento) */
    .dkb-tabs{display:inline-flex;gap:0;background:#F1F5F9;border-radius:7px;padding:3px;margin-bottom:14px;width:fit-content}
    .dkb-tabs button{padding:7px 14px;background:transparent;border:none;border-radius:5px;cursor:pointer;
      font-size:.78rem;font-weight:600;color:#64748B;font-family:inherit;display:inline-flex;align-items:center;gap:5px;transition:all .12s}
    .dkb-tabs button:hover{color:#1E293B}
    .dkb-tabs button.active{background:#fff;color:#5B21B6;box-shadow:0 1px 2px rgba(15,23,42,.08)}
    .dkb-tab-pane[hidden]{display:none !important}
    /* Tab de Pagamento — mesmo estilo do ext-baixa */
    .dkb-pag-section{border:1px solid #E5E7EB;border-radius:10px;padding:14px 16px;background:#FAFAF9;margin-bottom:14px}
    .dkb-pag-section h4{display:flex;align-items:center;gap:8px;margin:0 0 12px;font-size:.74rem;font-weight:700;
      color:#475569;text-transform:uppercase;letter-spacing:.06em;line-height:1}
    .dkb-pag-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .dkb-pag-row.cols-4{grid-template-columns:repeat(2,minmax(0,1fr))}
    @media (min-width:760px){
      .dkb-pag-row.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}
    }
    .dkb-pag-row .field{display:flex;flex-direction:column;gap:5px;min-width:0}
    .dkb-pag-row label{font-size:.7rem;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.04em;
      display:flex;align-items:center;gap:5px;line-height:1.25}
    .dkb-pag-row label .req{color:#DC2626;text-transform:none}
    .dkb-pag-money{display:flex;align-items:stretch;border:1px solid #CBD5E1;border-radius:6px;background:#fff;
      transition:all .12s;min-width:0}
    .dkb-pag-money .prefix{padding:6px 8px;background:#F1F5F9;color:#64748B;font-size:.72rem;font-weight:700;
      border-right:1px solid #E2E8F0;flex-shrink:0;display:flex;align-items:center}
    .dkb-pag-money input{flex:1;min-width:0;border:none;outline:none;padding:6px 8px;font-size:.82rem;
      font-family:Consolas,Menlo,monospace;background:transparent;font-variant-numeric:tabular-nums;text-align:right;width:100%}
    .dkb-pag-money.is-readonly{background:#F1F5F9}
    .dkb-pag-money.is-readonly input{color:#475569;font-weight:700}
    .dkb-pag-money:focus-within{border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.12)}
    .dkb-pag-row input[type=date],.dkb-pag-row select{padding:8px 10px;border:1px solid #CBD5E1;border-radius:6px;
      font-size:.84rem;font-family:inherit;background:#fff;width:100%;box-sizing:border-box}
    .dkb-pag-row input[type=date]:focus,.dkb-pag-row select:focus{outline:none;border-color:#7C3AED;
      box-shadow:0 0 0 3px rgba(124,58,237,.12)}
    .dkb-pag-resumo{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:14px 16px;border-radius:10px;
      background:#0F172A;color:#fff;margin-top:6px}
    .dkb-pag-resumo > div{display:flex;flex-direction:column;gap:3px;min-width:0}
    .dkb-pag-resumo .lbl{font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94A3B8}
    .dkb-pag-resumo .saldo .val{font-size:1.05rem;font-weight:700;font-family:Consolas,Menlo,monospace;color:#FCD34D}
    .dkb-pag-resumo .saldo .val.zero{color:#86EFAC}
    .dkb-pag-resumo .saldo .hint{font-size:.66rem;color:#94A3B8;font-style:italic;line-height:1.4}
    .dkb-pag-resumo .total{text-align:right}
    .dkb-pag-resumo .total .val{font-size:1.55rem;font-weight:800;font-family:Consolas,Menlo,monospace;
      letter-spacing:-.01em;color:#FCA5A5;display:inline-flex;align-items:baseline;gap:4px}
    .dkb-pag-resumo .total .val .pre{font-size:.78rem;font-weight:700;color:#94A3B8}
    @media (max-width:700px){
      .dkb-pag-row,.dkb-pag-row.cols-4{grid-template-columns:repeat(2,minmax(0,1fr))}
      .dkb-pag-resumo{grid-template-columns:1fr}
      .dkb-pag-resumo .total{text-align:left}
    }
    /* Custom dropdown de Centro de Custo (usado nos modais Receita/DKB/Manual) */
    .cc-dd{position:relative;width:100%}
    .cc-dd-btn{display:flex;align-items:center;gap:8px;width:100%;padding:7px 10px;border:1px solid #CBD5E1;
      border-radius:6px;background:#fff;cursor:pointer;font-family:inherit;font-size:.85rem;color:#1E293B;text-align:left;
      transition:border-color .12s}
    .cc-dd-btn:hover{border-color:#7C3AED}
    .cc-dd-btn.is-open{border-color:#7C3AED;box-shadow:0 0 0 3px rgba(124,58,237,.12)}
    .cc-dd-btn .cc-dot{width:14px;height:14px;border-radius:4px;flex-shrink:0;border:1px solid rgba(15,23,42,.1)}
    .cc-dd-btn .cc-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .cc-dd-btn .cc-name.placeholder{color:#94A3B8;font-style:italic}
    .cc-dd-btn .cc-caret{color:#94A3B8;font-size:.8rem;transition:transform .15s}
    .cc-dd-btn.is-open .cc-caret{transform:rotate(180deg)}
    .cc-dd-list{position:absolute;top:calc(100% + 4px);left:0;right:0;z-index:1000;background:#fff;
      border:1px solid #E2E8F0;border-radius:7px;box-shadow:0 8px 24px rgba(15,23,42,.12);max-height:280px;overflow-y:auto;padding:4px}
    .cc-dd-list[hidden]{display:none}
    .cc-dd-opt{display:flex;align-items:center;gap:8px;width:100%;padding:6px 10px;border:none;background:transparent;
      border-radius:5px;cursor:pointer;font-family:inherit;font-size:.85rem;color:#1E293B;text-align:left;transition:background .1s}
    .cc-dd-opt:hover{background:#F1F5F9}
    .cc-dd-opt.is-sel{background:#F5F3FF;color:#5B21B6;font-weight:600}
    .cc-dd-opt .dot{width:14px;height:14px;border-radius:4px;flex-shrink:0;border:1px solid rgba(15,23,42,.1)}
    .cc-dd-opt .dot.empty{background:repeating-linear-gradient(45deg,#E5E7EB 0,#E5E7EB 3px,#fff 3px,#fff 6px)}
    .cc-dd-opt .nm{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .cc-dd-opt .nm.placeholder{color:#94A3B8;font-style:italic}
    /* Botão extra de Salvar (próximos) no dkb-modal-ft */
    .dkb-modal-ft .btn-save-fwd{background:#5B21B6;border-color:#5B21B6;color:#fff;padding:8px 16px;border-radius:6px;
      cursor:pointer;font-size:.82rem;font-weight:600;font-family:inherit;border:1px solid;display:inline-flex;align-items:center;gap:5px}
    .dkb-modal-ft .btn-save-fwd:hover{background:#4C1D95;border-color:#4C1D95}
    .dkb-modal-ft .btn-save-fwd .badge{background:rgba(255,255,255,.2);padding:1px 6px;border-radius:10px;font-size:.7rem;font-weight:700}
    /* Banner de travamento (viagens — aprovado/reembolsado/rejeitado) */
    .viag-locked-box{display:flex;gap:10px;align-items:center;padding:10px 14px;background:#FEF3C7;
      border-left:3px solid #D97706;border-radius:6px;font-size:.82rem;color:#78350F;margin-bottom:12px}
    .viag-locked-ico{font-size:1.15rem;flex-shrink:0}
    .viag-locked-txt{line-height:1.4}
    .viag-locked-txt em{font-style:normal;font-weight:600}
    /* Modal */
    .wf-cad-modal-ov{position:fixed !important;top:0 !important;left:0 !important;right:0 !important;bottom:0 !important;
      background:rgba(15,23,42,.5);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px}
    .wf-cad-modal{background:#fff;border-radius:12px;width:min(440px,96vw);max-height:92vh;
      display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3)}
    .wf-cad-modal-hd{padding:14px 18px;display:flex;align-items:center;gap:10px;border-bottom:1px solid #E5E7EB}
    .wf-cad-modal-hd h2{margin:0;font-size:15px;font-weight:600;color:#0F172A;flex:1}
    .wf-cad-modal-x{background:transparent;border:none;color:#94A3B8;font-size:18px;cursor:pointer;padding:0 4px}
    .wf-cad-modal-x:hover{color:#0F172A}
    .wf-cad-modal-bd{padding:16px 20px;overflow:auto;flex:1;display:flex;flex-direction:column;gap:14px}
    .wf-cad-field{display:flex;flex-direction:column;gap:6px}
    .wf-cad-field label{font-size:11px;color:#475569;font-weight:600;letter-spacing:0.2px}
    .wf-cad-field input,.wf-cad-field select{padding:8px 11px;border:1px solid #E5E7EB;border-radius:6px;
      font-size:13px;font-family:inherit;background:#FAFAFA;color:#0F172A;outline:none;width:100%;box-sizing:border-box;
      transition:border-color .12s,background .12s}
    .wf-cad-field input:focus,.wf-cad-field select:focus{border-color:#0F172A;background:#fff}
    .wf-cad-field-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .wf-cad-toggle{display:inline-flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;font-weight:500;color:#0F172A}
    .wf-cad-toggle input{width:16px;height:16px;cursor:pointer;accent-color:#0F766E}
    .wf-cad-note{font-size:11px;color:#94A3B8;background:#F8FAFC;padding:8px 10px;border-radius:6px;line-height:1.4}
    .wf-cad-note b{color:#0F172A;font-weight:700}
    .wf-cad-modal-foot{padding:11px 18px;border-top:1px solid #E5E7EB;display:flex;gap:8px;align-items:center;background:#fafafa}
    .wf-cad-modal-del{background:transparent;color:#A32D2D;border:1px solid #E5C6C6;padding:6px 12px;border-radius:6px;
      font-size:12px;font-weight:500;cursor:pointer;font-family:inherit}
    .wf-cad-modal-del:hover{background:#FCEBEB}
    .wf-cad-modal-cancel{background:transparent;color:#475569;border:1px solid #D1D5DB;padding:7px 14px;border-radius:6px;
      font-size:13px;font-weight:500;cursor:pointer;font-family:inherit}
    .wf-cad-modal-cancel:hover{background:#F8FAFC;color:#0F172A}
    .wf-cad-modal-save{background:#0F172A;color:#fff;border:none;padding:7px 18px;border-radius:6px;
      font-size:13px;font-weight:500;cursor:pointer;font-family:inherit}
    .wf-cad-modal-save:hover{background:#000}
    /* Tags em Fornecedores */
    .wf-forn-tags-cell{display:flex;flex-wrap:wrap;gap:4px;align-items:center;max-width:280px}
    .wf-forn-tag{display:inline-flex;align-items:center;gap:2px;padding:2px 4px 2px 8px;border-radius:999px;
      font-size:.7rem;font-weight:600;letter-spacing:0.1px}
    .wf-forn-tag-txt{cursor:pointer;padding-right:2px}
    .wf-forn-tag-txt:hover{text-decoration:underline}
    .wf-forn-tag-rm{background:transparent;border:none;color:inherit;cursor:pointer;font-size:13px;
      line-height:1;padding:0 4px;border-radius:50%;opacity:.55;font-family:inherit}
    .wf-forn-tag-rm:hover{opacity:1;background:rgba(0,0,0,.08)}
    .wf-forn-tag-add{background:#fff;border:1px dashed #CBD5E1;color:#64748B;cursor:pointer;
      width:22px;height:22px;border-radius:50%;font-size:13px;line-height:1;padding:0;
      font-family:inherit;display:inline-flex;align-items:center;justify-content:center;transition:all .12s}
    .wf-forn-tag-add:hover{background:#0F172A;color:#fff;border-style:solid;border-color:#0F172A}
    /* Tag picker modal */
    .wf-tp-ov{position:fixed !important;top:0 !important;left:0 !important;right:0 !important;bottom:0 !important;
      background:rgba(15,23,42,.5);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px}
    .wf-tp{background:#fff;border-radius:14px;width:min(520px,96vw);max-height:88vh;
      display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3)}
    .wf-tp-hd{padding:16px 20px;border-bottom:1px solid #E5E7EB;position:relative}
    .wf-tp-hd h2{margin:0;font-size:16px;font-weight:700;color:#0F172A;letter-spacing:-0.01em}
    .wf-tp-hd p{margin:3px 0 0;font-size:12px;color:#94A3B8;font-weight:500}
    .wf-tp-x{position:absolute;top:14px;right:14px;background:transparent;border:none;color:#94A3B8;
      font-size:18px;cursor:pointer;padding:0 6px;border-radius:6px}
    .wf-tp-x:hover{background:#F1F5F9;color:#0F172A}
    .wf-tp-bd{padding:18px 20px;overflow:auto;flex:1;display:flex;flex-direction:column;gap:14px}
    #wf-tp-input{padding:10px 14px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;
      font-family:inherit;background:#FAFAFA;color:#0F172A;outline:none;width:100%;box-sizing:border-box;
      transition:border-color .12s,background .12s,box-shadow .12s}
    #wf-tp-input:focus{border-color:#0F172A;background:#fff;box-shadow:0 0 0 3px rgba(17,17,17,.05)}
    .wf-tp-section-lbl{font-size:11px;color:#94A3B8;font-weight:700;text-transform:uppercase;letter-spacing:0.08em}
    .wf-tp-list{display:flex;flex-wrap:wrap;gap:6px;max-height:280px;overflow-y:auto;padding:2px}
    .wf-tp-chip{display:inline-flex;align-items:center;gap:6px;padding:5px 8px 5px 12px;border-radius:999px;
      border:none;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;letter-spacing:0.1px;
      transition:transform .12s,box-shadow .12s}
    .wf-tp-chip:hover{transform:translateY(-1px);box-shadow:0 3px 10px rgba(15,23,42,.12)}
    .wf-tp-chip-cnt{display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;
      background:rgba(0,0,0,.12);border-radius:999px;font-size:10px;font-weight:700;padding:0 5px}
    .wf-tp-empty{padding:20px;text-align:center;color:#94A3B8;font-size:13px;font-style:italic;
      background:#F8FAFC;border:1px dashed #E5E7EB;border-radius:8px}
    .wf-tp-foot{padding:12px 20px;border-top:1px solid #E5E7EB;display:flex;gap:8px;align-items:center;background:#FAFBFC}
    .wf-tp-cancel{background:transparent;color:#475569;border:1px solid #D1D5DB;padding:8px 14px;border-radius:6px;
      font-size:13px;font-weight:500;cursor:pointer;font-family:inherit}
    .wf-tp-cancel:hover{background:#F1F5F9;color:#0F172A}
    .wf-tp-create{background:#0F172A;color:#fff;border:none;padding:8px 18px;border-radius:6px;
      font-size:13px;font-weight:600;cursor:pointer;font-family:inherit}
    .wf-tp-create:hover{background:#000}
    .wf-tp-create:disabled{background:#CBD5E1;cursor:not-allowed}

    /* Dashboard */
    /* ── Dashboard refinado ── */
    .bd-dash{display:flex;flex-direction:column;gap:14px}
    .bd-dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .bd-dash-grid-3{grid-template-columns:1fr 1fr 1fr}
    @media (max-width:900px){ .bd-dash-grid,.bd-dash-grid-3{grid-template-columns:1fr} }
    .bd-dash-card{background:var(--bd-bg-1);border:1px solid #E5E7EB;border-radius:var(--bd-radius-lg);padding:16px}
    .bd-dash-card h3{margin:0 0 12px;font-size:13px;font-weight:600;color:var(--bd-text-1);letter-spacing:0.2px}
    .bd-dash-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:0.5px solid var(--bd-bdr-1);font-size:13px;color:var(--bd-text-2);align-items:center}
    .bd-dash-row:last-child{border-bottom:none}
    .bd-dash-row .v{font-weight:600;color:var(--bd-text-1)}
    /* KPIs Hero */
    .bd-kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
    @media (max-width:1100px){ .bd-kpis{grid-template-columns:repeat(3,1fr)} }
    @media (max-width:560px){ .bd-kpis{grid-template-columns:repeat(2,1fr)} }
    .bd-kpi{background:#fff;border:1px solid #E5E7EB;border-radius:var(--bd-radius-lg);padding:14px 14px 12px;
       display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden}
    .bd-kpi::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:#9CA3AF}
    .bd-kpi-danger{background:#FEF2F2}
    .bd-kpi-danger::before{background:#DC2626}
    .bd-kpi-warn{background:#FFFBEB}
    .bd-kpi-warn::before{background:#D97706}
    .bd-kpi-success{background:#F0FDF4}
    .bd-kpi-success::before{background:#16A34A}
    .bd-kpi-info{background:#EFF6FF}
    .bd-kpi-info::before{background:#2563EB}
    .bd-kpi-ico{font-size:14px;opacity:.8}
    .bd-kpi-val{font-size:28px;font-weight:700;color:#111;line-height:1.1}
    .bd-kpi-lbl{font-size:11px;color:#555;font-weight:600;letter-spacing:0.2px;display:flex;flex-direction:column;gap:1px}
    .bd-kpi-lbl small{font-size:10px;color:#999;font-weight:500;letter-spacing:0;text-transform:none}
    /* Barras de distribuição */
    .bd-bar-row{display:grid;grid-template-columns:120px 1fr 32px;gap:10px;align-items:center;padding:5px 0;font-size:12px}
    .bd-bar-lbl{color:#555;font-weight:500;display:inline-flex;align-items:center;gap:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .bd-bar-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;display:inline-block}
    .bd-bar-track{height:8px;background:#F3F4F6;border-radius:4px;overflow:hidden}
    .bd-bar-fill{height:100%;border-radius:4px;background:#9CA3AF;transition:width .3s}
    .bd-bar-col-backlog{background:#9CA3AF}
    .bd-bar-col-todo{background:#3B82F6}
    .bd-bar-col-doing{background:#A855F7}
    .bd-bar-col-blocked{background:#EF4444}
    .bd-bar-col-done{background:#10B981}
    .bd-bar-val{font-weight:700;color:#111;text-align:right;font-size:13px}
    /* Listas (atrasadas / próximos) */
    .bd-list-row{padding:8px 0;border-bottom:0.5px solid #F3F4F6;display:flex;justify-content:space-between;
       align-items:center;gap:8px;cursor:pointer;transition:background .12s}
    .bd-list-row:hover{background:#FAFAFA;margin:0 -8px;padding-left:8px;padding-right:8px;border-radius:4px}
    .bd-list-row:last-child{border-bottom:none}
    .bd-list-name{font-size:12px;color:#111;font-weight:500;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .bd-list-meta{flex-shrink:0}
    .bd-list-tag{display:inline-block;padding:2px 7px;border-radius:999px;font-size:10px;font-weight:600;letter-spacing:0.2px}
    .bd-list-danger{background:#FEE2E2;color:#991B1B}
    .bd-list-warn{background:#FEF3C7;color:#92400E}
    .bd-list-info{background:#DBEAFE;color:#1E40AF}
    .bd-list-empty{color:#999;font-size:12px;font-style:italic;text-align:center;padding:14px 0}
    /* Carga por responsável */
    .bd-resp-row{display:grid;grid-template-columns:140px 1fr 32px;gap:10px;align-items:center;padding:5px 0;font-size:12px}
    .bd-resp-info{display:inline-flex;align-items:center;gap:6px;overflow:hidden}
    .bd-resp-name{font-size:12px;color:#111;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    /* Insights */
    .bd-insight{display:flex;align-items:flex-start;gap:8px;padding:10px 12px;border-radius:8px;
       margin-bottom:6px;font-size:12px;line-height:1.45}
    .bd-insight:last-child{margin-bottom:0}
    .bd-insight-ico{font-size:14px;flex-shrink:0;line-height:1.4}
    .bd-insight-txt{color:#374151}
    .bd-insight-txt b{font-weight:700;color:#111}
    .bd-insight-danger{background:#FEF2F2;border-left:3px solid #DC2626}
    .bd-insight-warn{background:#FFFBEB;border-left:3px solid #D97706}
    .bd-insight-info{background:#EFF6FF;border-left:3px solid #2563EB}
    .bd-insight-success{background:#F0FDF4;border-left:3px solid #16A34A}

    /* Empty */
    .bd-empty{text-align:center;padding:60px 20px;color:var(--bd-text-3)}
    .bd-empty-icon{font-size:3rem;display:block;margin-bottom:12px;opacity:.4}

    /* Aging badge no card */
    .viag-kb-age{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:3px;
      font-size:.62rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;font-family:Consolas,Menlo,monospace;
      align-self:flex-start;border:1px solid;margin-top:2px}
    /* Aberta — gradiente do verde pro vermelho conforme idade */
    .viag-kb-age.age-fresh{background:#F0FDF4;color:#047857;border-color:#86EFAC}
    .viag-kb-age.age-aging{background:#FEF3C7;color:#92400E;border-color:#FCD34D}
    .viag-kb-age.age-stale{background:#FEE2E2;color:#991B1B;border-color:#FCA5A5;animation:viagPulse 2s ease-in-out infinite}
    @keyframes viagPulse{ 0%,100%{opacity:1} 50%{opacity:.7} }
    /* Fechada — verde se rápido, amber se médio, vermelho se demorou */
    .viag-kb-age.age-good{background:#F0FDF4;color:#047857;border-color:#86EFAC;border-style:dashed}
    .viag-kb-age.age-warn{background:#FEF3C7;color:#92400E;border-color:#FCD34D;border-style:dashed}
    .viag-kb-age.age-bad {background:#FEE2E2;color:#991B1B;border-color:#FCA5A5;border-style:dashed}

    /* Filtro de data no toolbar */
    .viag-date-filter{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;background:#fff;flex-shrink:0;white-space:nowrap;
      border:1px solid var(--bdr);border-radius:6px;font-size:.74rem;color:var(--txm)}
    .viag-date-filter .lbl{font-weight:700;color:var(--txm);font-size:.7rem}
    .viag-date-filter input[type="date"]{padding:3px 6px;border:1px solid var(--bdr);border-radius:4px;
      font-size:.74rem;font-family:inherit;background:#fff;outline:none;color:var(--txd);cursor:pointer}
    .viag-date-filter input[type="date"]:focus{border-color:#0F766E;box-shadow:0 0 0 2px rgba(15,118,110,.1)}
    .viag-date-clear{padding:2px 8px;background:transparent;border:none;cursor:pointer;color:#94A3B8;
      font-size:.85rem;line-height:1;border-radius:3px;transition:all .12s}
    .viag-date-clear:hover{background:#FEE2E2;color:#DC2626}

    /* Botão Rejeitar do modal */
    .viag-approval-foot .btn-reject{background:#DC2626;color:#fff;border:none;padding:9px 22px;border-radius:6px;
      font-size:.86rem;font-weight:700;cursor:pointer;font-family:inherit}
    .viag-approval-foot .btn-reject:hover{background:#B91C1C}
    .viag-card-hd{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
    .viag-card-name{font-weight:800;color:var(--txd);font-size:1rem;letter-spacing:-.01em;line-height:1.3;flex:1;min-width:0}
    .viag-card-dest{font-size:.78rem;color:var(--txm);margin-top:3px;display:flex;align-items:center;gap:4px}
    .viag-status{padding:3px 9px;border-radius:4px;font-size:.62rem;font-weight:800;letter-spacing:.06em;
      text-transform:uppercase;font-family:Consolas,Menlo,monospace;flex-shrink:0;white-space:nowrap}
    .viag-status.rascunho   {background:#F1F5F9;color:#64748B}
    .viag-status.enviado    {background:#DBEAFE;color:#1E40AF}
    .viag-status.aprovado   {background:#D1FAE5;color:#047857}
    .viag-status.reembolsado{background:#E9D5FF;color:#6B21A8}
    .viag-status.rejeitado  {background:#FEE2E2;color:#B91C1C}
    .viag-card-meta{display:flex;gap:10px;font-size:.72rem;color:var(--txl);font-family:Consolas,Menlo,monospace;letter-spacing:.04em}
    .viag-card-totals{display:flex;justify-content:space-between;padding-top:10px;border-top:1px solid #F1F5F9}
    .viag-card-tot{display:flex;flex-direction:column;gap:1px}
    .viag-card-tot-lbl{font-size:.62rem;font-weight:700;color:var(--txl);text-transform:uppercase;letter-spacing:.08em;font-family:Consolas,Menlo,monospace}
    .viag-card-tot-val{font-weight:800;color:var(--txd);font-size:.92rem}
    .viag-card-tot-val.bal-pos{color:#047857}
    .viag-card-tot-val.bal-neg{color:#DC2626}

    .viag-empty{padding:64px 20px;text-align:center;color:var(--txl);background:#FAFBFC;
      border:2px dashed var(--bdr);border-radius:12px}
    .viag-empty-icon{font-size:3.5rem;opacity:.4;display:block;margin-bottom:14px}
    .viag-empty-title{font-size:1.05rem;font-weight:800;color:#475569;margin-bottom:6px}
    .viag-empty-sub{font-size:.84rem;line-height:1.5}

    /* Editor (modal) */
    .viag-editor-overlay{position:fixed;inset:0;background:rgba(15,23,42,.55);backdrop-filter:blur(4px);
      display:flex;align-items:center;justify-content:center;z-index:99998;padding:20px}
    .viag-editor{background:#fff;border-radius:14px;width:min(960px,96vw);max-height:92vh;
      display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(15,23,42,.32)}
    .viag-editor-hd{padding:18px 22px;background:linear-gradient(180deg,#0F766E 0%,#0D9488 100%);
      color:#fff;display:flex;align-items:center;gap:14px}
    .viag-editor-hd h2{margin:0;font-size:1.1rem;font-weight:800;letter-spacing:-.01em}
    .viag-editor-x{margin-left:auto;background:transparent;border:none;color:#fff;font-size:1.4rem;
      cursor:pointer;padding:0 8px;opacity:.8;transition:opacity .12s}
    .viag-editor-x:hover{opacity:1}
    .viag-editor-bd{padding:20px 22px;overflow:auto;flex:1}
    .viag-editor-foot{padding:14px 22px;background:#FAFBFC;border-top:1px solid #E5E7EB;
      display:flex;gap:8px;justify-content:flex-end;align-items:center}
    .viag-editor-foot .btn-del{margin-right:auto;background:#fff;color:#DC2626;border:1px solid #FCA5A5;
      padding:8px 14px;border-radius:6px;font-size:.82rem;font-weight:700;cursor:pointer;font-family:inherit}
    .viag-editor-foot .btn-del:hover{background:#FEF2F2}
    .viag-editor-foot .btn-save{padding:9px 22px;background:#0F172A;color:#fff;border:none;border-radius:6px;
      font-size:.86rem;font-weight:700;cursor:pointer;font-family:inherit;transition:all .12s}
    .viag-editor-foot .btn-save:hover{background:#1E293B}

    /* Form fields */
    .viag-form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:18px}
    .viag-field{display:flex;flex-direction:column;gap:4px}
    .viag-field-full{grid-column:1 / -1}
    .viag-field label{font-size:.66rem;font-weight:800;color:var(--txm);text-transform:uppercase;
      letter-spacing:.08em;font-family:Consolas,Menlo,monospace}
    .viag-field input, .viag-field select, .viag-field textarea{padding:8px 10px;border:1px solid var(--bdr);
      border-radius:6px;font-size:.86rem;font-family:inherit;background:#fff;outline:none;color:var(--txd)}
    .viag-field input:focus, .viag-field select:focus, .viag-field textarea:focus{border-color:#0F766E;box-shadow:0 0 0 3px rgba(15,118,110,.1)}
    .viag-field textarea{resize:vertical;min-height:60px;font-family:inherit}

    /* Lista de despesas */
    .viag-desp-section{margin-top:18px}
    .viag-desp-section-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
    .viag-desp-section-hd h3{margin:0;font-size:.94rem;font-weight:800;color:var(--txd);letter-spacing:-.005em}
    .viag-desp-add{padding:6px 14px;background:#0F766E;color:#fff;border:none;border-radius:6px;
      font-size:.78rem;font-weight:700;cursor:pointer;font-family:inherit;transition:all .12s}
    .viag-desp-add:hover{background:#0E6B65}
    .viag-desp-table{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--bdr);border-radius:8px;overflow:hidden}
    .viag-desp-table th{padding:8px 10px;background:#FAFBFC;border-bottom:1px solid var(--bdr);
      font-size:.66rem;font-weight:800;color:var(--txm);text-transform:uppercase;letter-spacing:.08em;
      font-family:Consolas,Menlo,monospace;text-align:left}
    .viag-desp-table th.right{text-align:right}
    .viag-desp-table td{padding:8px 10px;border-bottom:1px solid #F1F5F9;font-size:.84rem}
    .viag-desp-table tr:last-child td{border-bottom:none}
    .viag-desp-table input, .viag-desp-table select{width:100%;padding:5px 7px;border:1px solid transparent;
      background:transparent;font-size:.84rem;font-family:inherit;outline:none;color:var(--txd);border-radius:4px;box-sizing:border-box}
    .viag-desp-table input:focus, .viag-desp-table select:focus{border-color:#0F766E;background:#fff;box-shadow:0 0 0 2px rgba(15,118,110,.1)}
    .viag-desp-table input[type="number"]{text-align:right;font-family:Consolas,Menlo,monospace;font-weight:700}
    .viag-desp-table .col-data{width:120px}
    .viag-desp-table .col-cat{width:150px}
    .viag-desp-table .col-val{width:100px;text-align:right}
    .viag-desp-table .col-pag{width:90px}
    .viag-desp-table .col-anexo{width:80px;text-align:center}
    .viag-pag-seg{display:inline-flex;border:1px solid #E2E8F0;border-radius:6px;overflow:hidden;width:100%}
    .viag-pag-seg .seg{flex:1;padding:5px 0;background:#fff;border:none;border-left:1px solid #E2E8F0;
      cursor:pointer;font-size:.95rem;line-height:1;color:#94A3B8;transition:all .1s;font-family:inherit}
    .viag-pag-seg .seg:first-child{border-left:none}
    .viag-pag-seg .seg:hover{background:#F1F5F9;color:#1F2937}
    .viag-pag-seg .seg.active.pag-funcionario{background:#F5F3FF;color:#5B21B6;font-weight:800;box-shadow:inset 0 -2px 0 #7C3AED}
    .viag-pag-seg .seg.active.pag-empresa{background:#F0FDFA;color:#0F766E;font-weight:800;box-shadow:inset 0 -2px 0 #0F766E}
    .viag-desp-table .col-act{width:42px;text-align:center}
    .viag-desp-anexo-empty{padding:5px 10px;background:#fff;border:1px dashed #CBD5E1;border-radius:5px;
      font-size:.72rem;color:#64748B;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:4px;
      transition:all .12s}
    .viag-desp-anexo-empty:hover{border-color:#0F766E;background:#F0FDFA;color:#0F766E;border-style:solid}
    .viag-desp-anexo-has{display:inline-flex;align-items:center;gap:0;background:#D1FAE5;border:1px solid #6EE7B7;
      border-radius:5px;overflow:hidden;font-family:inherit}
    .viag-desp-anexo-has .ax-view{padding:5px 9px;background:transparent;border:none;cursor:pointer;
      font-size:.74rem;font-weight:700;color:#065F46;display:inline-flex;align-items:center;gap:4px;font-family:inherit}
    .viag-desp-anexo-has .ax-view:hover{background:#A7F3D0}
    .viag-desp-anexo-has .ax-name{display:none}
    .viag-desp-anexo-has .ax-view{padding:5px 6px}
    .viag-desp-anexo-has .ax-rm{padding:4px 7px;background:transparent;border:none;color:#DC2626;cursor:pointer;
      border-left:1px solid #6EE7B7;font-size:.85rem;line-height:1}
    .viag-desp-anexo-has .ax-rm:hover{background:#FEE2E2}
    .viag-anexo-modal{position:fixed;inset:0;background:rgba(15,23,42,.85);backdrop-filter:blur(8px);
      display:flex;align-items:center;justify-content:center;z-index:99999;padding:20px;flex-direction:column;gap:14px}
    .viag-anexo-modal-content{max-width:90vw;max-height:80vh;overflow:auto;background:#fff;border-radius:12px;padding:20px;
      box-shadow:0 24px 60px rgba(0,0,0,.5);display:flex;flex-direction:column;align-items:center;gap:14px}
    .viag-anexo-modal img{max-width:100%;max-height:70vh;object-fit:contain;border-radius:6px}
    .viag-anexo-modal embed, .viag-anexo-modal iframe{width:80vw;height:70vh;border:none;border-radius:6px}
    .viag-anexo-modal-bar{display:flex;gap:10px;align-items:center}
    .viag-anexo-modal-bar button, .viag-anexo-modal-bar a{padding:8px 18px;border-radius:6px;border:none;font-size:.84rem;
      font-weight:700;cursor:pointer;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
    .viag-anexo-modal-bar .btn-close{background:#fff;color:#0F172A;border:1px solid #CBD5E1}
    .viag-anexo-modal-bar .btn-close:hover{background:#F1F5F9}
    .viag-anexo-modal-bar .btn-dl{background:#0F766E;color:#fff}
    .viag-anexo-modal-bar .btn-dl:hover{background:#0E6B65}
    .viag-anexo-modal-name{color:#fff;font-size:.86rem;font-weight:700;text-align:center}

    /* Botão 🪄 dentro do chip de anexo */
    .viag-desp-anexo-has .ax-ocr{padding:4px 7px;background:transparent;border:none;color:#7C3AED;cursor:pointer;
      border-left:1px solid #6EE7B7;font-size:.85rem;line-height:1}
    .viag-desp-anexo-has .ax-ocr:hover{background:#F5F3FF}

    /* Modal de OCR — review do que foi extraído */
    .viag-ocr-modal{position:fixed;inset:0;background:rgba(15,23,42,.55);backdrop-filter:blur(4px);
      display:flex;align-items:center;justify-content:center;z-index:99999;padding:20px}
    .viag-ocr-card{background:#fff;border-radius:14px;width:min(640px,96vw);max-height:90vh;
      display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(15,23,42,.32)}
    .viag-ocr-hd{padding:18px 22px;background:linear-gradient(135deg,#7C3AED 0%,#A855F7 100%);
      color:#fff;display:flex;align-items:center;gap:14px}
    .viag-ocr-hd h2{margin:0;font-size:1.1rem;font-weight:800;letter-spacing:-.01em}
    .viag-ocr-hd p{margin:2px 0 0;font-size:.74rem;opacity:.85}
    .viag-ocr-x{margin-left:auto;background:transparent;border:none;color:#fff;font-size:1.4rem;
      cursor:pointer;padding:0 8px;opacity:.8}
    .viag-ocr-bd{padding:18px 22px;overflow:auto;flex:1}
    .viag-ocr-row{display:grid;grid-template-columns:30px 100px 1fr;gap:10px;align-items:center;
      padding:12px 14px;border:1px solid #E5E7EB;border-radius:8px;margin-bottom:8px;background:#FAFBFC}
    .viag-ocr-row.is-checked{border-color:#7C3AED;background:#F5F3FF}
    .viag-ocr-row.is-empty{opacity:.55;background:#F1F5F9}
    .viag-ocr-row input[type="checkbox"]{margin:0;width:18px;height:18px;accent-color:#7C3AED;cursor:pointer}
    .viag-ocr-row-lbl{font-size:.66rem;font-weight:800;color:#6B7280;text-transform:uppercase;
      letter-spacing:.08em;font-family:Consolas,Menlo,monospace}
    .viag-ocr-row-val{font-size:.92rem;font-weight:700;color:#0F172A}
    .viag-ocr-row-val.empty{color:#94A3B8;font-style:italic;font-weight:500;font-size:.78rem}
    .viag-ocr-progress{padding:40px 20px;text-align:center;color:#7C3AED}
    .viag-ocr-progress-bar{width:100%;height:6px;background:#F1F5F9;border-radius:3px;overflow:hidden;margin:14px 0 6px}
    .viag-ocr-progress-fill{height:100%;background:linear-gradient(90deg,#7C3AED,#A855F7);transition:width .2s}
    .viag-ocr-progress-pct{font-size:.74rem;color:#94A3B8;font-family:Consolas,Menlo,monospace;font-weight:700}
    .viag-ocr-raw{margin-top:14px;border:1px solid #E5E7EB;border-radius:6px;background:#FAFBFC}
    .viag-ocr-raw summary{padding:8px 12px;cursor:pointer;font-size:.74rem;font-weight:700;color:#6B7280;font-family:Consolas,Menlo,monospace;text-transform:uppercase;letter-spacing:.08em;outline:none}
    .viag-ocr-raw[open] summary{border-bottom:1px solid #E5E7EB}
    .viag-ocr-raw pre{padding:12px;margin:0;font-size:.7rem;color:#475569;font-family:Consolas,Menlo,monospace;white-space:pre-wrap;max-height:200px;overflow:auto}
    .viag-ocr-foot{padding:14px 22px;background:#FAFBFC;border-top:1px solid #E5E7EB;display:flex;gap:8px;justify-content:flex-end}
    .viag-ocr-foot button{padding:9px 22px;border-radius:6px;font-size:.86rem;font-weight:700;cursor:pointer;font-family:inherit}
    .viag-ocr-foot .btn-cancel{background:#fff;color:#475569;border:1px solid #CBD5E1}
    .viag-ocr-foot .btn-cancel:hover{background:#F1F5F9}
    .viag-ocr-foot .btn-apply{background:#7C3AED;color:#fff;border:none}
    .viag-ocr-foot .btn-apply:hover{background:#6D28D9}
    .viag-ocr-foot .btn-apply:disabled{background:#9CA3AF;cursor:not-allowed}
    .viag-desp-empty{padding:32px 20px;text-align:center;color:var(--txl);font-style:italic;font-size:.84rem}
    .viag-desp-del{background:transparent;border:none;color:#DC2626;cursor:pointer;font-size:.9rem;padding:4px 6px;border-radius:4px}
    .viag-desp-del:hover{background:#FEF2F2}
    .viag-desp-anexo-btn{padding:3px 7px;background:#F1F5F9;border:1px solid var(--bdr);border-radius:4px;
      font-size:.7rem;color:var(--txm);cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:3px}
    .viag-desp-anexo-btn.has-file{background:#D1FAE5;color:#065F46;border-color:#6EE7B7}
    .viag-desp-anexo-btn:hover{background:#E5E7EB}

    /* Resumo no rodapé do editor */
    .viag-resumo{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px;padding:14px 16px;
      background:linear-gradient(180deg,#FAFBFC 0%,#F1F5F9 100%);border:1px solid var(--bdr);border-radius:8px}
    .viag-resumo-cell{display:flex;flex-direction:column;gap:2px;text-align:center}
    .viag-resumo-cell-lbl{font-size:.62rem;font-weight:800;color:var(--txm);text-transform:uppercase;letter-spacing:.08em;font-family:Consolas,Menlo,monospace}
    .viag-resumo-cell-val{font-size:1.05rem;font-weight:800;color:var(--txd);letter-spacing:-.01em;font-family:Consolas,Menlo,monospace}
    .viag-resumo-cell-val.bal-pos{color:#047857}
    .viag-resumo-cell-val.bal-neg{color:#DC2626}

    /* Toggle switch reutilizável (Configurações) */
    .cfg-switch{position:relative;display:inline-block;width:44px;height:24px;
                flex-shrink:0;cursor:pointer}
    .cfg-switch input{position:absolute;opacity:0;width:0;height:0;pointer-events:none}
    .cfg-switch-track{position:absolute;inset:0;background:#E2E8F0;border-radius:999px;
                      transition:background .18s ease;
                      box-shadow:inset 0 1px 2px rgba(0,0,0,.08)}
    .cfg-switch-thumb{position:absolute;top:2px;left:2px;width:20px;height:20px;
                      background:#fff;border-radius:50%;
                      box-shadow:0 1px 3px rgba(0,0,0,.2),0 1px 1px rgba(0,0,0,.1);
                      transition:transform .18s ease}
    .cfg-switch input:checked + .cfg-switch-track{background:#F59E0B}
    .cfg-switch input:checked + .cfg-switch-track .cfg-switch-thumb{transform:translateX(20px)}
    .cfg-switch input:focus-visible + .cfg-switch-track{box-shadow:0 0 0 3px rgba(245,158,11,.25),inset 0 1px 2px rgba(0,0,0,.08)}

    /* Módulos em destaque — grid de seleção */
    .cfg-featured-counter{display:inline-flex;align-items:center;gap:8px;
                          font-size:.75rem;color:var(--txm);margin:4px 0 14px;
                          background:#F1F5F9;border-radius:999px;padding:4px 12px;
                          font-weight:600;letter-spacing:.01em}
    .cfg-featured-counter strong{color:#0F766E;font-weight:800}
    .cfg-featured-counter.full strong{color:#B45309}
    .cfg-featured-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px}
    .cfg-featured-opt{display:flex;align-items:center;gap:10px;padding:10px 12px;
                      border:1px solid var(--bdr);border-radius:10px;cursor:pointer;
                      background:#fff;transition:background .12s,border-color .12s,box-shadow .12s;
                      user-select:none}
    .cfg-featured-opt:hover{background:#F8FAFC;border-color:#CBD5E1}
    .cfg-featured-opt.checked{border-color:#0D9488;
                              background:linear-gradient(135deg,#F0FDFA 0%,#EFF6FF 100%);
                              box-shadow:0 0 0 1px #0D9488,0 2px 6px -2px rgba(13,148,136,.25)}
    .cfg-featured-opt.disabled{opacity:.45;cursor:not-allowed}
    .cfg-featured-opt.disabled:hover{background:#fff;border-color:var(--bdr)}
    .cfg-featured-opt input{position:absolute;opacity:0;pointer-events:none}
    .cfg-featured-chk{width:18px;height:18px;border-radius:5px;border:1.5px solid #CBD5E1;
                      display:flex;align-items:center;justify-content:center;flex-shrink:0;
                      background:#fff;transition:background .12s,border-color .12s;color:transparent}
    .cfg-featured-chk svg{width:11px;height:11px;stroke-width:3;fill:none;stroke:currentColor}
    .cfg-featured-opt.checked .cfg-featured-chk{background:#0D9488;border-color:#0D9488;color:#fff}
    .cfg-featured-ico{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;
                      justify-content:center;color:#fff;flex-shrink:0}
    .cfg-featured-ico svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2.2}
    .cfg-featured-lbl{font-size:.85rem;font-weight:600;color:var(--tx);flex:1;letter-spacing:-0.005em}

    /* Logo picker */
    .cfg-logo-wrap{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
    .cfg-logo-preview{width:220px;height:84px;border:1px dashed var(--bdr);border-radius:12px;
                      background:linear-gradient(135deg,#0F172A,#1E293B);
                      display:flex;align-items:center;justify-content:center;padding:10px;
                      overflow:hidden;flex-shrink:0}
    .cfg-logo-preview svg,
    .cfg-logo-preview img{max-width:100%;max-height:100%;height:auto;width:auto;object-fit:contain;display:block}
    .cfg-logo-actions{display:flex;flex-direction:column;gap:8px;flex:1;min-width:220px}
    .cfg-logo-btn{display:inline-flex;align-items:center;gap:8px;padding:9px 14px;
                  font-family:inherit;font-size:.8rem;font-weight:600;
                  background:#fff;color:var(--tx);border:1px solid var(--bdr);
                  border-radius:9px;cursor:pointer;transition:border-color .15s,background .15s;
                  justify-content:center}
    .cfg-logo-btn:hover{border-color:#94A3B8;background:#F8FAFC}
    .cfg-logo-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;
                      stroke-linecap:round;stroke-linejoin:round}
    .cfg-logo-btn.ghost{background:transparent;color:var(--txm)}
    .cfg-logo-hint{font-size:.72rem;color:var(--txl);line-height:1.5;margin-top:4px}
    .cfg-section h3{margin:0;font-size:1rem;font-weight:700;color:var(--tx);letter-spacing:-0.01em}
    .cfg-section-sub{font-size:.76rem;color:var(--txm);margin:0 0 18px 48px;line-height:1.5}
    .cfg-section-body{padding-left:48px}
    @media (max-width:680px){
      .cfg-section-sub{margin-left:0}
      .cfg-section-body{padding-left:0}
    }

    .cfg-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-bottom:14px}
    .cfg-field label{display:block;font-size:.68rem;font-weight:700;color:var(--txm);
                     text-transform:uppercase;letter-spacing:.07em;margin-bottom:6px}
    .cfg-field input[type=text],
    .cfg-field input[type=email],
    .cfg-field input[type=password],
    .cfg-field select{
      width:100%;padding:10px 13px;border:1px solid var(--bdr);border-radius:9px;
      font-family:inherit;font-size:.86rem;background:#fff;color:var(--tx);outline:none;
      transition:border-color .15s,box-shadow .15s}
    .cfg-field select{
      appearance:none;-webkit-appearance:none;cursor:pointer;
      background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748B' stroke-width='2.4'><path d='M6 9l6 6 6-6'/></svg>");
      background-repeat:no-repeat;background-position:right 10px center;background-size:14px;
      padding-right:30px}
    .cfg-field input:focus,
    .cfg-field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(59,130,246,.12)}
    .cfg-field .cfg-hint,
    .cfg-field .cfg-field-hint{font-size:.7rem;color:var(--txl);margin-top:5px;line-height:1.4;display:block}
    .cfg-save-row{display:flex;align-items:center;gap:10px;margin-top:12px}
    .cfg-saved-flag{font-size:.72rem;color:#059669;font-weight:600;display:inline-flex;align-items:center;gap:4px;opacity:0;transition:opacity .3s}
    .cfg-saved-flag.show{opacity:1}
    .cfg-saved-flag svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2.5}

    /* ── Segurança (change email/password) ── */
    .cfg-sec-block{padding:16px;border:1px solid var(--bdr);border-radius:12px;background:#FAFBFC;
                   margin-bottom:14px}
    .cfg-sec-block + .cfg-sec-block{margin-top:14px}
    .cfg-sec-hd{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
    .cfg-sec-hd h4{margin:0;font-size:.88rem;font-weight:700;color:var(--tx);letter-spacing:-.01em}
    .cfg-sec-hd .cfg-sec-desc{font-size:.72rem;color:var(--txm);margin-top:3px;line-height:1.4}
    .cfg-sec-current{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;
                     background:#EEF2FF;color:#4338CA;border-radius:999px;
                     font-size:.68rem;font-weight:700;letter-spacing:.02em;white-space:nowrap}
    .cfg-sec-current svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.4}
    .cfg-pass-wrap{position:relative}
    .cfg-pass-wrap input{padding-right:38px}
    .cfg-pass-toggle{position:absolute;right:6px;top:50%;transform:translateY(-50%);
                     width:30px;height:30px;border:none;background:transparent;cursor:pointer;
                     color:var(--txl);border-radius:6px;display:flex;align-items:center;justify-content:center;
                     padding:0;transition:background .12s,color .12s}
    .cfg-pass-toggle:hover{background:#F1F5F9;color:var(--tx)}
    .cfg-pass-toggle svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;
                         stroke-linecap:round;stroke-linejoin:round}
    .cfg-sec-actions{display:flex;align-items:center;gap:10px;margin-top:14px;flex-wrap:wrap}
    .cfg-sec-submit{display:inline-flex;align-items:center;gap:8px;padding:9px 16px;
                    background:#0F172A;color:#fff;border:none;border-radius:9px;
                    font-size:.82rem;font-weight:700;font-family:inherit;cursor:pointer;
                    letter-spacing:.01em;transition:all .15s}
    .cfg-sec-submit:hover{background:#1E293B;box-shadow:0 4px 10px rgba(15,23,42,.2)}
    .cfg-sec-submit:disabled{opacity:.6;cursor:wait}
    .cfg-sec-submit svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2.4;
                        stroke-linecap:round;stroke-linejoin:round}
    .cfg-sec-alert{font-size:.76rem;font-weight:600;padding:6px 12px;border-radius:7px;
                   display:none;align-items:center;gap:6px;line-height:1.3}
    .cfg-sec-alert.show{display:inline-flex;animation:fkSlide .2s}
    .cfg-sec-alert.err{background:#FEF2F2;color:#991B1B;border:1px solid #FECACA}
    .cfg-sec-alert.ok{background:#F0FDF4;color:#065F46;border:1px solid #BBF7D0}
    .cfg-sec-warn{margin-top:10px;padding:9px 12px;border-radius:8px;background:#FFFBEB;
                  border:1px solid #FDE68A;color:#92400E;font-size:.72rem;line-height:1.45;
                  display:flex;align-items:flex-start;gap:8px}
    .cfg-sec-warn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.2;
                      flex-shrink:0;margin-top:1px}

    /* Actions (cards clicáveis) */
    .cfg-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
    .cfg-action{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;
                border:1px solid var(--bdr);border-radius:11px;background:#fff;
                cursor:pointer;text-align:left;font-family:inherit;width:100%;
                transition:border-color .15s,transform .15s,box-shadow .15s}
    .cfg-action:hover{border-color:#94A3B8;transform:translateY(-1px);
                      box-shadow:0 4px 14px rgba(15,23,42,.06)}
    .cfg-action-ico{width:32px;height:32px;border-radius:9px;display:flex;
                    align-items:center;justify-content:center;flex-shrink:0}
    .cfg-action-ico svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;
                        stroke-linecap:round;stroke-linejoin:round}
    .cfg-action.export  .cfg-action-ico{background:#DBEAFE;color:#1D4ED8}
    .cfg-action.import  .cfg-action-ico{background:#EDE9FE;color:#6D28D9}
    .cfg-action.seed    .cfg-action-ico{background:#D1FAE5;color:#047857}
    .cfg-action.reseed  .cfg-action-ico{background:#FEF3C7;color:#B45309}
    .cfg-action.reset   .cfg-action-ico{background:#FEE2E2;color:#B91C1C}
    .cfg-action-body{flex:1;min-width:0}
    .cfg-action-ttl{font-size:.86rem;font-weight:700;color:var(--tx);margin-bottom:3px}
    .cfg-action-desc{font-size:.72rem;color:var(--txm);line-height:1.45}

    /* Storage table */
    .cfg-storage{width:100%;border-collapse:collapse;font-size:.8rem}
    .cfg-storage th{text-align:left;font-size:.66rem;font-weight:700;
                    text-transform:uppercase;letter-spacing:.07em;color:var(--txl);
                    padding:8px 10px;border-bottom:1px solid var(--bdr)}
    .cfg-storage td{padding:10px;border-bottom:1px solid var(--bdr);color:var(--tx)}
    .cfg-storage tr:last-child td{border-bottom:none}
    .cfg-storage .cfg-mod-nome{font-weight:600}
    .cfg-storage .cfg-mod-desc{font-size:.7rem;color:var(--txl);margin-top:1px}
    .cfg-storage .cfg-bar-cell{width:38%}
    .cfg-storage-bar{height:7px;background:#F1F5F9;border-radius:4px;overflow:hidden}
    .cfg-storage-bar>i{display:block;height:100%;background:linear-gradient(90deg,#60A5FA,#2563EB);border-radius:4px}
    .cfg-storage .cfg-mod-size{font-variant-numeric:tabular-nums;color:var(--txm);text-align:right}
    .cfg-storage tfoot td{font-weight:700;color:var(--tx);border-top:2px solid var(--bdr)}

    /* Sobre */
    .cfg-about{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-top:2px}
    .cfg-about-item{background:#F8FAFC;border:1px solid var(--bdr);border-radius:10px;padding:13px 15px}
    .cfg-about-lbl{font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--txl);margin-bottom:5px}
    .cfg-about-val{font-size:.95rem;font-weight:700;color:var(--tx);letter-spacing:-.01em}
    .cfg-about-sub{font-size:.7rem;color:var(--txm);margin-top:2px}

    /* ══ INÍCIO / HOME ═════════════════════════════════ */
    .home-empty{display:flex;align-items:center;gap:18px;padding:18px 22px;
                margin-bottom:18px;border-radius:14px;
                background:linear-gradient(135deg,#FEF3C7 0%,#FDE68A 100%);
                border:1px solid #F59E0B40}
    .home-empty-ico{width:44px;height:44px;border-radius:12px;background:#F59E0B;
                    color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .home-empty-ico svg{width:22px;height:22px}
    .home-empty-txt{flex:1;min-width:0}
    .home-empty-txt h3{margin:0 0 4px;font-size:.95rem;font-weight:800;color:#78350F;letter-spacing:-.01em}
    .home-empty-txt p{margin:0;font-size:.78rem;color:#92400E;line-height:1.45}
    .home-empty-btn{flex-shrink:0;display:inline-flex;align-items:center;gap:6px;
                    padding:10px 16px;font-size:.78rem;font-weight:700;
                    background:#78350F;color:#fff;border:none;border-radius:10px;cursor:pointer;
                    transition:background .15s,transform .15s}
    .home-empty-btn:hover{background:#451A03;transform:translateY(-1px)}
    @media (max-width:720px){
      .home-empty{flex-wrap:wrap}
      .home-empty-btn{width:100%;justify-content:center}
    }

    .home-hero{position:relative;border-radius:18px;overflow:hidden;margin-bottom:22px;
               background:linear-gradient(135deg,#0F172A 0%,#1E293B 55%,#312E81 100%);
               color:#fff;padding:28px 32px 26px;
               box-shadow:0 4px 28px rgba(15,23,42,.18)}
    .home-hero::before{content:'';position:absolute;inset:0;pointer-events:none;
                       background:
                         radial-gradient(circle at 85% 10%, rgba(168,85,247,.22), transparent 45%),
                         radial-gradient(circle at 10% 90%, rgba(59,130,246,.20), transparent 40%)}
    .home-hero-inner{position:relative;display:flex;align-items:flex-start;justify-content:space-between;
                     gap:22px;flex-wrap:wrap}
    .home-hero-greet{flex:1;min-width:240px}
    .home-hero-eyebrow{display:inline-flex;align-items:center;gap:6px;font-size:.66rem;font-weight:700;
                       letter-spacing:.12em;text-transform:uppercase;color:#A5B4FC;margin-bottom:10px;
                       background:rgba(99,102,241,.12);padding:4px 10px;border-radius:999px;
                       border:1px solid rgba(165,180,252,.2)}
    .home-hero-eyebrow i{width:6px;height:6px;background:#34D399;border-radius:50%;box-shadow:0 0 0 3px rgba(52,211,153,.2)}
    .home-hero h1{font-size:1.75rem;font-weight:800;letter-spacing:-0.025em;margin:0 0 6px;
                  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
                  background:linear-gradient(90deg,#fff,#CBD5E1);-webkit-background-clip:text;background-clip:text;color:transparent}
    .home-greet-ico{display:inline-flex;align-items:center;justify-content:center;
                    width:52px;height:52px;border-radius:14px;flex-shrink:0;
                    background:linear-gradient(135deg,rgba(255,255,255,.12),rgba(255,255,255,.04));
                    border:1px solid rgba(255,255,255,.12);
                    box-shadow:0 4px 14px rgba(0,0,0,.18);
                    font-size:1.7rem;line-height:1;-webkit-text-fill-color:initial;color:initial}
    .home-greet-ico svg{width:28px;height:28px;stroke:#FDE68A;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .home-greet-ico.morning{background:linear-gradient(135deg,#78350F,#B45309);border-color:#F59E0B55}
    .home-greet-ico.morning svg{stroke:#FEF3C7}
    .home-greet-ico.afternoon{background:linear-gradient(135deg,#C2410C,#F59E0B);border-color:#FCD34D55}
    .home-greet-ico.afternoon svg{stroke:#FEF9C3}
    .home-greet-ico.evening{background:linear-gradient(135deg,#4C1D95,#6D28D9);border-color:#A78BFA55}
    .home-greet-ico.evening svg{stroke:#DDD6FE}
    .home-greet-ico.night{background:linear-gradient(135deg,#1E3A8A,#312E81);border-color:#6366F155}
    .home-greet-ico.night svg{stroke:#C7D2FE}
    .home-hero p{color:#CBD5E1;font-size:.88rem;margin:0;max-width:580px;line-height:1.5}
    .home-hero .home-date{display:inline-flex;align-items:center;gap:7px;font-size:.72rem;color:#94A3B8;
                          margin-top:14px}
    .home-hero .home-date svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2}

    /* Market strip (dólar + selic) */
    .home-market{display:flex;gap:8px;flex-wrap:wrap;align-items:stretch;position:relative;
                 background:rgba(15,23,42,.35);border:1px solid rgba(255,255,255,.08);
                 border-radius:12px;padding:10px 12px;backdrop-filter:blur(8px)}
    .home-market-item{display:flex;flex-direction:column;justify-content:center;padding:4px 14px;
                      min-width:128px;position:relative}
    .home-market-item + .home-market-item{border-left:1px solid rgba(255,255,255,.08)}
    .home-market-lbl{font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.11em;
                     color:#94A3B8;display:inline-flex;align-items:center;gap:5px}
    .home-market-lbl svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2}
    .home-market-val{font-size:1.02rem;font-weight:800;letter-spacing:-0.015em;color:#fff;
                     font-variant-numeric:tabular-nums;line-height:1.2;margin-top:3px}
    .home-market-delta{font-size:.66rem;font-weight:700;color:#94A3B8;display:inline-flex;align-items:center;
                       gap:3px;margin-top:2px}
    .home-market-delta.up  {color:#34D399}
    .home-market-delta.down{color:#F87171}
    .home-market-delta svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2.5}
    .home-market-sub{font-size:.6rem;color:#64748B;margin-top:1px;font-variant-numeric:tabular-nums}

    /* KPI row */
    .home-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:22px}
    .home-kpi{position:relative;background:var(--card);border-radius:14px;padding:16px 18px;
              border:1px solid var(--bdr);
              box-shadow:0 1px 3px rgba(15,23,42,.04),0 4px 18px rgba(15,23,42,.05);
              transition:transform .18s, box-shadow .18s}
    .home-kpi:hover{transform:translateY(-1px);
                    box-shadow:0 2px 6px rgba(15,23,42,.06),0 10px 26px rgba(15,23,42,.08)}
    .home-kpi-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    .home-kpi-ico{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .home-kpi-ico svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .home-kpi.saldo   .home-kpi-ico{background:#DBEAFE;color:#1D4ED8}
    .home-kpi.receita .home-kpi-ico{background:#D1FAE5;color:#047857}
    .home-kpi.result  .home-kpi-ico{background:#FEF3C7;color:#B45309}
    .home-kpi.divida  .home-kpi-ico{background:#FEE2E2;color:#B91C1C}
    .home-kpi-lbl{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--txl);line-height:1.1}
    .home-kpi-val{font-size:1.45rem;font-weight:800;letter-spacing:-0.025em;color:var(--tx);
                  font-variant-numeric:tabular-nums;line-height:1.15}
    .home-kpi.saldo   .home-kpi-val{color:#1D4ED8}
    .home-kpi.receita .home-kpi-val{color:#047857}
    .home-kpi.divida  .home-kpi-val{color:#B91C1C}
    .home-kpi-sub{font-size:.68rem;color:var(--txm);margin-top:5px;line-height:1.4}
    .home-kpi-valrow{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
    .home-kpi-delta{display:inline-flex;align-items:center;gap:3px;font-size:.66rem;font-weight:700;
                    padding:2px 7px;border-radius:10px;background:#F3F4F6;color:#6B7280;
                    font-variant-numeric:tabular-nums;white-space:nowrap}
    .home-kpi-delta svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
    .home-kpi-delta.up  {background:#D1FAE5;color:#059669}
    .home-kpi-delta.down{background:#FEE2E2;color:#DC2626}
    .home-kpi-delta:empty{display:none}

    /* Layout principal: mês em resumo + módulos */
    .home-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:18px;margin-bottom:22px}
    @media(max-width:1000px){ .home-grid{grid-template-columns:1fr} }
    .home-card{background:var(--card);border-radius:14px;padding:20px 22px;
               border:1px solid var(--bdr);
               box-shadow:0 1px 3px rgba(15,23,42,.04),0 4px 18px rgba(15,23,42,.05)}
    .home-card-hd{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
    .home-card-title{font-size:.9rem;font-weight:700;letter-spacing:-0.005em;color:var(--tx)}
    .home-card-sub {font-size:.7rem;color:var(--txm);margin-top:2px}

    /* Mini barras (fluxo do ano) — eixo zero central */
    .home-chart{display:flex;align-items:stretch;gap:6px;height:160px;padding:4px 0 0;position:relative}
    .home-chart-col{flex:1;display:flex;flex-direction:column;min-width:0;position:relative}
    .home-chart-slot{flex:0 0 62px;display:flex;min-width:0}
    .home-chart-slot.pos{align-items:flex-end;justify-content:center;border-bottom:1px solid rgba(15,23,42,.12)}
    .home-chart-slot.neg{align-items:flex-start;justify-content:center}
    .home-chart-bar{width:100%;min-height:2px;transition:height .25s ease}
    .home-chart-bar.pos{background:linear-gradient(180deg,#10B981,#047857);border-radius:3px 3px 0 0}
    .home-chart-bar.neg{background:linear-gradient(180deg,#DC2626,#F87171);border-radius:0 0 3px 3px}
    .home-chart-lbl{font-size:.58rem;color:var(--txl);text-align:center;margin-top:6px;
                    text-transform:uppercase;letter-spacing:.05em;font-weight:700}
    .home-chart-col.atual .home-chart-lbl{color:var(--tx);font-weight:800}
    .home-chart-col.atual::before{content:'';position:absolute;inset:0 -2px 0 -2px;
                                  background:rgba(37,99,235,.06);border-radius:4px;z-index:-1}
    .home-chart-legend{display:flex;gap:16px;font-size:.68rem;color:var(--txm);margin-top:12px}
    .home-chart-legend i{width:9px;height:9px;border-radius:2px;display:inline-block;margin-right:6px;vertical-align:-1px}
    .home-chart-legend .pos{background:linear-gradient(180deg,#10B981,#047857)}
    .home-chart-legend .neg{background:linear-gradient(180deg,#F87171,#DC2626)}

    /* Breakdown caixa x reserva */
    .home-breakdown-bar{height:10px;border-radius:5px;background:#F3F4F6;overflow:hidden;display:flex;margin-top:4px}
    .home-breakdown-bar > div{transition:flex-basis .3s}
    .home-breakdown-caixa  {background:linear-gradient(90deg,#10B981,#047857)}
    .home-breakdown-reserva{background:linear-gradient(90deg,#A855F7,#7C3AED)}
    .home-breakdown-row{display:flex;justify-content:space-between;align-items:baseline;
                        padding:9px 0;border-bottom:1px dashed var(--bdr)}
    .home-breakdown-row:last-child{border-bottom:none}
    .home-breakdown-lbl{display:flex;align-items:center;gap:8px;font-size:.77rem;color:var(--tx);font-weight:600}
    .home-breakdown-lbl i{width:9px;height:9px;border-radius:2px}
    .home-breakdown-lbl i.caixa  {background:linear-gradient(135deg,#F43F5E,#BE185D)}
    .home-breakdown-lbl i.reserva{background:linear-gradient(135deg,#A855F7,#7C3AED)}
    .home-breakdown-val{font-size:.82rem;font-weight:800;color:var(--tx);font-variant-numeric:tabular-nums}
    .home-breakdown-pct{font-size:.66rem;color:var(--txl);margin-left:6px;font-weight:600}

    /* Insights: Notícias + Pensamento do dia (2 colunas) */
    .home-insights{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:6px}
    @media (max-width: 900px){.home-insights{grid-template-columns:1fr}}
    .home-insights-col{min-width:0;display:flex;flex-direction:column}

    .home-insights-hdr{font-size:.62rem;font-weight:800;letter-spacing:.14em;color:var(--txl);
                       text-transform:uppercase;margin:0 0 12px;display:flex;align-items:center;gap:10px;min-height:28px}
    .home-insights-hdr-right{margin-left:auto;display:flex;align-items:center;gap:8px}
    .home-insights-hdr .home-news-src-pick{font-size:.62rem;font-weight:700;letter-spacing:.05em;
                     color:var(--txm);background:var(--card);border:1px solid var(--bdr);
                     border-radius:8px;padding:4px 8px;cursor:pointer;outline:none;
                     text-transform:none;font-family:inherit;max-width:180px;
                     text-overflow:ellipsis;overflow:hidden;white-space:nowrap}
    .home-insights-hdr .home-news-src-pick:hover{border-color:#C7D2FE}
    .home-insights-hdr .home-news-refresh{background:transparent;border:1px solid var(--bdr);
                     border-radius:8px;padding:4px 8px;cursor:pointer;color:var(--txm);
                     display:inline-flex;align-items:center;gap:5px;font-size:.62rem;
                     font-weight:700;letter-spacing:.05em;transition:border-color .15s,color .15s;
                     font-family:inherit}
    .home-insights-hdr .home-news-refresh:hover{border-color:#C7D2FE;color:#2563EB}
    .home-insights-hdr .home-news-refresh svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.2}
    .home-insights-hdr .home-news-refresh.is-loading svg{animation:homeNewsSpin 1s linear infinite}
    @keyframes homeNewsSpin{to{transform:rotate(360deg)}}

    .home-news{background:var(--card);border:1px solid var(--bdr);border-radius:12px;
               padding:6px 0;overflow:hidden}
    .home-news-list{list-style:none;margin:0;padding:0}
    .home-news-item{display:flex;align-items:flex-start;gap:12px;padding:14px 18px;
                    border-bottom:1px solid var(--bdr);text-decoration:none;color:inherit;
                    transition:background .12s}
    .home-news-item:last-child{border-bottom:0}
    .home-news-item:hover{background:rgba(37,99,235,.03)}
    .home-news-dot{width:6px;height:6px;border-radius:50%;margin-top:7px;flex-shrink:0;
                   background:linear-gradient(135deg,#2563EB,#1D4ED8)}
    .home-news-body{flex:1;min-width:0}
    .home-news-headline{font-size:.82rem;font-weight:600;color:var(--tx);line-height:1.4;
                        margin:0 0 4px;letter-spacing:-0.005em;
                        display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
                        overflow:hidden}
    .home-news-item:hover .home-news-headline{color:#2563EB}
    .home-news-meta{display:flex;align-items:center;gap:8px;font-size:.66rem;color:var(--txl);font-weight:600}
    .home-news-src{color:var(--txm);font-weight:700;letter-spacing:.02em}
    .home-news-dotsep{width:3px;height:3px;border-radius:50%;background:var(--bdr)}
    .home-news-time{font-variant-numeric:tabular-nums}
    .home-news-arrow{color:#94A3B8;flex-shrink:0;margin-top:2px;opacity:0;
                     transition:opacity .15s,transform .15s}
    .home-news-arrow svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
    .home-news-item:hover .home-news-arrow{opacity:1;color:#2563EB;transform:translateX(2px)}

    /* Indicador "já vista" */
    .home-news-check{width:16px;height:16px;border-radius:50%;background:#10B981;
                     color:#fff;display:inline-flex;align-items:center;justify-content:center;
                     margin-left:6px;flex-shrink:0;vertical-align:middle}
    .home-news-check svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:3}
    .home-news-item.is-seen .home-news-dot{background:#CBD5E1}
    .home-news-item.is-seen .home-news-headline{color:var(--txm);font-weight:500}
    .home-news-item.is-seen:hover .home-news-headline{color:#2563EB}

    .home-news-skel{padding:14px 18px;border-bottom:1px solid var(--bdr);display:flex;gap:12px;align-items:flex-start}
    .home-news-skel:last-child{border-bottom:0}
    .home-news-skel-dot{width:6px;height:6px;border-radius:50%;margin-top:7px;flex-shrink:0;
                        background:var(--bdr)}
    .home-news-skel-body{flex:1;display:flex;flex-direction:column;gap:6px}
    .home-news-skel-line{height:10px;border-radius:6px;background:linear-gradient(90deg,var(--bdr),#F1F5F9,var(--bdr));
                         background-size:200% 100%;animation:homeNewsShimmer 1.4s linear infinite}
    .home-news-skel-line.short{width:60%}
    .home-news-skel-line.tiny{width:28%;height:8px}
    @keyframes homeNewsShimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}

    .home-news-empty{padding:20px 18px;text-align:center;color:var(--txm);font-size:.75rem}
    .home-news-empty a{color:#2563EB;text-decoration:none;font-weight:600}
    .home-news-empty a:hover{text-decoration:underline}

    /* Pensamento do dia — minimalista absoluto */
    .home-quote{background:var(--card);border:1px solid var(--bdr);border-radius:12px;
                padding:34px 30px;flex:1;display:flex;flex-direction:column;justify-content:center;
                min-height:220px;position:relative;overflow:hidden}
    .home-quote-text{font-family:Georgia,'Times New Roman',serif;font-style:italic;
                     font-size:1.02rem;line-height:1.6;color:var(--tx);
                     letter-spacing:-0.005em;margin:0 0 18px;font-weight:400}
    .home-quote-author{font-size:.66rem;font-weight:700;letter-spacing:.14em;
                       color:var(--txm);text-transform:uppercase;margin:0}
    .home-quote-author::before{content:'';display:inline-block;width:16px;height:1px;
                                background:var(--txl);margin-right:8px;vertical-align:middle;margin-bottom:2px}
    .home-quote-bio{font-size:.7rem;font-weight:400;letter-spacing:.01em;color:var(--txl);
                    margin:6px 0 0 24px;line-height:1.45;font-style:normal;max-width:560px}
    .home-quote-bio:empty{display:none}
    .home-quote-empty{font-size:.8rem;color:var(--txm);text-align:center;line-height:1.55}
    .home-quote-empty a{color:#2563EB;text-decoration:none;font-weight:600;cursor:pointer}
    .home-quote-empty a:hover{text-decoration:underline}

    /* Modal de configuração dos pensadores */
    .home-quote-cfg{position:fixed;inset:0;z-index:1200;display:none;align-items:center;justify-content:center;padding:20px}
    .home-quote-cfg.open{display:flex}
    .home-quote-cfg-ov{position:absolute;inset:0;background:rgba(15,23,42,.48);backdrop-filter:blur(2px)}
    .home-quote-cfg-md{position:relative;background:var(--card);border-radius:16px;
                       max-width:620px;width:100%;max-height:85vh;display:flex;flex-direction:column;
                       box-shadow:0 20px 60px rgba(15,23,42,.25);border:1px solid var(--bdr)}
    .home-quote-cfg-hd{display:flex;align-items:center;gap:12px;padding:20px 22px;border-bottom:1px solid var(--bdr)}
    .home-quote-cfg-hd h3{margin:0;font-size:1.02rem;font-weight:800;color:var(--tx);letter-spacing:-0.01em;flex:1}
    .home-quote-cfg-hd .x{background:transparent;border:0;font-size:1.3rem;color:var(--txm);
                          cursor:pointer;line-height:1;padding:6px 10px;border-radius:8px;transition:background .12s}
    .home-quote-cfg-hd .x:hover{background:rgba(15,23,42,.06);color:var(--tx)}
    .home-quote-cfg-actions{display:flex;gap:8px;padding:12px 22px;border-bottom:1px solid var(--bdr);align-items:center}
    .home-quote-cfg-actions button{background:transparent;border:1px solid var(--bdr);border-radius:8px;
                                    padding:6px 11px;font-size:.7rem;font-weight:700;color:var(--txm);
                                    cursor:pointer;font-family:inherit;transition:border-color .12s,color .12s}
    .home-quote-cfg-actions button:hover{border-color:#C7D2FE;color:#2563EB}
    .home-quote-cfg-actions .count{margin-left:auto;font-size:.7rem;color:var(--txl);font-weight:600}
    .home-quote-cfg-body{overflow-y:auto;padding:16px 22px 20px}
    .home-quote-cfg-group{margin-bottom:18px}
    .home-quote-cfg-group:last-child{margin-bottom:0}
    .home-quote-cfg-grplbl{font-size:.62rem;font-weight:800;letter-spacing:.12em;color:var(--txl);
                           text-transform:uppercase;margin:0 0 8px}
    .home-quote-cfg-chips{display:flex;flex-wrap:wrap;gap:6px}
    .home-quote-cfg-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;
                          border:1px solid var(--bdr);border-radius:999px;background:var(--bg);
                          font-size:.72rem;font-weight:600;color:var(--txm);cursor:pointer;
                          user-select:none;transition:all .12s}
    .home-quote-cfg-chip:hover{border-color:#C7D2FE}
    .home-quote-cfg-chip.on{background:#EEF2FF;border-color:#818CF8;color:#3730A3}
    .home-quote-cfg-chip .chk{width:12px;height:12px;border-radius:3px;border:1.5px solid #CBD5E1;
                               display:inline-flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
    .home-quote-cfg-chip.on .chk{background:#6366F1;border-color:#6366F1}
    .home-quote-cfg-chip .chk svg{width:8px;height:8px;stroke:currentColor;fill:none;stroke-width:3;display:none}
    .home-quote-cfg-chip.on .chk svg{display:block}
    .home-quote-cfg-chip .del{margin-left:3px;width:14px;height:14px;border-radius:50%;
                               display:inline-flex;align-items:center;justify-content:center;
                               color:var(--txl);font-size:.9rem;line-height:1;
                               transition:background .12s,color .12s}
    .home-quote-cfg-chip .del:hover{background:#FEE2E2;color:#B91C1C}

    /* Formulário de adicionar pensador */
    .home-quote-add{display:flex;flex-direction:column;gap:8px;background:var(--bg);
                    border:1px solid var(--bdr);border-radius:10px;padding:12px}
    .home-quote-add input,
    .home-quote-add textarea{width:100%;border:1px solid var(--bdr);border-radius:8px;
                              padding:8px 10px;font-size:.8rem;color:var(--tx);background:var(--card);
                              outline:none;font-family:inherit;transition:border-color .12s;
                              box-sizing:border-box}
    .home-quote-add input:focus,
    .home-quote-add textarea:focus{border-color:#818CF8}
    .home-quote-add textarea{resize:vertical;min-height:60px;line-height:1.5}
    .home-quote-add-top{display:flex;gap:8px;align-items:stretch}
    .home-quote-add-top input{flex:1;min-width:0}
    .home-quote-add-row{display:flex;justify-content:flex-end}
    .home-quote-add-btn{background:#2563EB;color:#fff;border:0;border-radius:8px;
                         padding:8px 14px;font-size:.75rem;font-weight:700;cursor:pointer;
                         font-family:inherit;transition:background .12s}
    .home-quote-add-btn:hover{background:#1D4ED8}
    .home-quote-add-btn:disabled{background:#CBD5E1;cursor:not-allowed}
    .home-quote-fetch-btn{background:var(--card);border:1px solid var(--bdr);border-radius:8px;
                           padding:8px 12px;font-size:.72rem;font-weight:700;color:var(--txm);
                           cursor:pointer;display:inline-flex;align-items:center;gap:6px;
                           font-family:inherit;transition:border-color .12s,color .12s;
                           white-space:nowrap;flex-shrink:0}
    .home-quote-fetch-btn:hover{border-color:#C7D2FE;color:#2563EB}
    .home-quote-fetch-btn:disabled{opacity:.6;cursor:wait}
    .home-quote-fetch-btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.2}
    .home-quote-fetch-btn.is-loading svg{animation:homeNewsSpin 1s linear infinite}
    .home-quote-add-hint{font-size:.65rem;color:var(--txl);line-height:1.4;margin:-2px 0 0}
    .home-quote-add-hint.ok{color:#059669}
    .home-quote-add-hint.err{color:#B91C1C}

    /* Loading shimmer (para as cotações) */
    @keyframes homeShimmer{0%{opacity:.4}50%{opacity:.85}100%{opacity:.4}}
    .home-loading{animation:homeShimmer 1.4s ease-in-out infinite}

    /* ══════════════════════════════════════════════════════
       MÓDULO RECEITA — planilha editável com abas por ano
       ══════════════════════════════════════════════════════ */

    /* Tabs de ano */
    .rec-year-tabs{display:flex;align-items:center;gap:2px;border-bottom:2px solid var(--bdr);
                   margin-bottom:18px;flex-wrap:wrap}
    .rec-year-tab{padding:9px 14px 9px 16px;font-size:.85rem;font-weight:700;color:var(--txm);
                  background:none;border:none;cursor:pointer;border-bottom:2px solid transparent;
                  margin-bottom:-2px;transition:color .15s,border-color .15s;font-family:inherit;
                  display:inline-flex;align-items:center;gap:8px;letter-spacing:-0.01em}
    .rec-year-tab:hover{color:var(--blue)}
    .rec-year-tab.active{color:var(--blue-d);border-bottom-color:var(--blue-d)}
    .rec-year-del{background:none;border:none;cursor:pointer;color:var(--txl);
                  padding:1px 4px;border-radius:4px;font-size:.75rem;line-height:1;
                  display:none;opacity:.5}
    .rec-year-tab.active .rec-year-del{display:inline-flex}
    .rec-year-del:hover{color:#DC2626;background:var(--red-bg);opacity:1}
    .rec-year-add{padding:7px 13px;background:#fff;border:1px dashed var(--bdr);border-radius:7px;
                  color:var(--txm);font-size:.73rem;cursor:pointer;margin-left:10px;
                  margin-bottom:6px;font-family:inherit;font-weight:600}
    .rec-year-add:hover{color:var(--blue-d);border-color:var(--blue);background:#EFF6FF}

    /* KPI cards do ano */
    .rec-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
                  gap:14px;margin-bottom:16px}
    .rec-kpi{background:var(--card);border-radius:var(--r);padding:14px 17px;
             box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04);
             border-left:3px solid var(--bdr)}
    .rec-kpi.recebido{border-left-color:#10B981}
    .rec-kpi.aberto  {border-left-color:#F59E0B}
    .rec-kpi.total   {border-left-color:var(--blue-d)}
    .rec-kpi.ticket  {border-left-color:#14B8A6}
    .rec-kpi.sim     {border-left-color:#8B5CF6}
    .rec-kpi-val.teal{color:#0F766E}
    .rec-kpi-lbl{font-size:.62rem;font-weight:700;text-transform:uppercase;
                 letter-spacing:.07em;color:var(--txl);margin-bottom:5px}
    .rec-kpi-val{font-size:1.35rem;font-weight:800;letter-spacing:-0.02em;color:var(--tx)}
    .rec-kpi-val.grn{color:#059669}
    .rec-kpi-val.amb{color:#D97706}
    .rec-kpi-val.blu{color:var(--blue-d)}
    .rec-kpi-val.pur{color:#7C3AED}
    .rec-kpi-sub{font-size:.67rem;color:var(--txm);margin-top:3px}

    /* Legenda */
    .rec-legend{display:flex;gap:18px;font-size:.72rem;color:var(--txm);
                margin-bottom:12px;align-items:center;flex-wrap:wrap}
    .rec-leg-item{display:flex;align-items:center;gap:6px}
    .rec-leg-sq{width:14px;height:14px;border-radius:3px;flex-shrink:0}
    .rec-leg-sq.recebido{background:#D1FAE5;border:1px solid #6EE7B7}
    .rec-leg-sq.aberto{background:#FEF3C7;border:1px solid #FCD34D}
    .rec-leg-sq.sim{background:#EDE9FE;border:1px solid #C4B5FD}

    /* Container da planilha */
    .rec-sheet-wrap{background:var(--card);border-radius:var(--r);overflow:auto;
                    box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04);
                    max-height:68vh;position:relative}
    .rec-sheet{width:100%;border-collapse:separate;border-spacing:0;font-size:.77rem}

    /* Cabeçalho */
    .rec-sheet thead th{background:var(--bg);color:#94A3B8;padding:9px 8px;font-size:.65rem;
                        font-weight:700;text-transform:uppercase;letter-spacing:.05em;
                        text-align:right;position:sticky;top:0;z-index:3;white-space:nowrap;
                        border-bottom:1px solid #334155}
    .rec-sheet thead th.l{text-align:left}
    .rec-sheet thead th.c{text-align:center}
    .rec-sheet thead th.stk{z-index:4;background:#0F172A}
    .rec-sheet thead th.stk-1{left:0;min-width:170px;padding-left:14px;text-align:left}
    .rec-sheet thead th.stk-2{left:170px;min-width:52px;text-align:center}
    .rec-sheet thead th.stk-ativo{left:222px;min-width:64px;text-align:center}
    .rec-sheet thead th.stk-3{left:286px;min-width:128px;text-align:left}
    .rec-sheet thead th.stk-4{left:414px;min-width:150px;text-align:left}
    .rec-sheet thead th.stk-5{left:564px;min-width:130px;border-right:2px solid #334155}
    .rec-sheet thead th.stk-5 .sub{display:block;font-size:.56rem;color:#64748B;
                                   margin-top:2px;font-weight:600}
    .rec-sheet thead th.mes{min-width:92px}
    .rec-sheet thead th.del{min-width:88px;max-width:100px;background:var(--bg);text-align:center}

    /* Células (tbody) */
    .rec-sheet tbody td{padding:0;border-bottom:1px solid var(--bdr);background:#fff;
                        vertical-align:middle;white-space:nowrap}
    .rec-sheet tbody tr:hover td{background:#F8FAFF}
    .rec-sheet tbody td.stk{position:sticky;background:#fff;z-index:3}
    .rec-sheet tbody tr:hover td.stk{background:#F8FAFF}
    .rec-sheet tbody td.stk-1{left:0}
    .rec-sheet tbody td.stk-2{left:170px;text-align:center;padding:0 4px}
    .rec-sheet tbody td.stk-ativo{left:222px;text-align:center;padding:0 4px}
    .rec-sheet tbody td.stk-3{left:286px}
    .rec-sheet tbody td.stk-4{left:414px}
    .rec-sheet tbody td.stk-5{left:564px;border-right:2px solid var(--bdr);
                              background:#F9FAFB;font-weight:700;text-align:right;
                              padding:0 12px;font-family:'Menlo','Consolas',monospace;
                              color:var(--blue-d);font-size:.77rem}
    .rec-sheet tbody tr:hover td.stk-5{background:#EFF6FF}

    /* Borda de cor por linha */
    .rec-row-indicator{display:inline-block;width:4px;height:22px;background:var(--rc,#E5E7EB);
                       border-radius:2px;flex-shrink:0;margin-right:8px;vertical-align:middle}

    /* Inputs */
    .rec-input{width:100%;border:1.5px solid transparent;background:transparent;
               padding:9px 10px;font-size:.78rem;font-family:inherit;color:var(--tx);
               outline:none;box-sizing:border-box}
    .rec-input:focus{border-color:var(--blue);background:#EFF6FF;
                     box-shadow:inset 0 0 0 1px rgba(59,130,246,.12)}
    .rec-input.num{text-align:right;font-family:'Menlo','Consolas',monospace}
    .rec-input.first-col{font-weight:700;letter-spacing:-0.01em}

    .rec-first-wrap{display:flex;align-items:center;padding-right:6px}
    .rec-first-wrap .rec-input{padding-left:2px}

    /* Células mensais */
    .rec-cell{position:relative}
    .rec-cell.aberto .rec-input{background:#FEF3C7;color:#92400E;font-weight:600}
    .rec-cell.aberto:hover .rec-input{background:#FDE68A}
    .rec-cell.recebido .rec-input{background:#D1FAE5;color:#065F46;font-weight:700}
    .rec-cell.recebido:hover .rec-input{background:#A7F3D0}
    .rec-cell.aberto.sim .rec-input{background:#EDE9FE;color:#5B21B6}
    .rec-cell.aberto.sim:hover .rec-input{background:#DDD6FE}
    .rec-cell.recebido.sim .rec-input{background:#D1FAE5;color:#065F46}

    /* Botão de toggle de status — invisível por padrão, só aparece no hover
       da célula específica (em ambos os estados: aberto ou recebido). */
    .rec-cell-toggle{position:absolute;top:3px;right:3px;width:12px;height:12px;
                     background:transparent;border:1px solid transparent;border-radius:3px;
                     cursor:pointer;font-size:8px;line-height:1;padding:0;
                     display:flex;align-items:center;justify-content:center;z-index:1;
                     color:transparent;font-family:inherit;opacity:0;pointer-events:none;
                     transition:opacity .12s,transform .1s}
    /* Aparece apenas quando o mouse está sobre a própria célula */
    .rec-cell.aberto:hover   .rec-cell-toggle,
    .rec-cell.recebido:hover .rec-cell-toggle{opacity:.8;pointer-events:auto;
                                                background:rgba(255,255,255,.95);
                                                border-color:#CBD5E1}
    .rec-cell.recebido:hover .rec-cell-toggle{background:#10B981;border-color:#059669;
                                                color:#fff;font-weight:900}
    .rec-cell-toggle:hover{opacity:1 !important;transform:scale(1.12)}

    /* Swatch de cor da linha */
    .rec-color-dot{width:14px;height:14px;border-radius:50%;cursor:pointer;flex-shrink:0;
                   border:2px solid #fff;box-shadow:0 0 0 1px var(--bdr);
                   transition:transform .1s;margin-left:10px;margin-right:4px}
    .rec-color-dot:hover{transform:scale(1.2)}

    /* Agrupamento visual por cliente */
    .rec-proj-badge{display:inline-flex;align-items:center;font-size:.62rem;font-weight:700;
                    color:var(--txm);background:#F3F4F6;border:1px solid var(--bdr);
                    border-radius:10px;padding:1px 7px;margin-left:6px;flex-shrink:0;
                    text-transform:uppercase;letter-spacing:.04em;white-space:nowrap}
    /* Linha "sub" (mesmo cliente das anteriores) */
    .rec-sub-arrow{color:var(--txl);font-size:.85rem;margin-left:14px;margin-right:4px;
                   flex-shrink:0;line-height:1;user-select:none}
    .rec-first-wrap.is-sub .rec-row-indicator{opacity:.55}
    .rec-first-wrap.is-sub .rec-input.first-col{color:var(--txl);font-style:italic;
                                                 font-size:.72rem;font-weight:500}
    .rec-first-wrap.is-sub .rec-input.first-col:focus{color:var(--tx);font-style:normal;
                                                       font-size:.78rem;font-weight:600}

    /* Separador Simular */
    .rec-sep-row td{background:#F3F4F6 !important;padding:10px 14px !important;
                    font-size:.72rem;font-weight:800;color:var(--txm);
                    letter-spacing:.08em;text-transform:uppercase;
                    border-top:2px solid var(--bdr) !important;
                    border-bottom:1px solid var(--bdr);position:sticky;left:0}
    .rec-sep-row td .sep-sub{font-size:.65rem;font-weight:600;text-transform:none;
                             letter-spacing:0;color:var(--txl);margin-left:8px}

    /* Ações da linha (duplicar / excluir) */
    .rec-row-actions{display:inline-flex;gap:2px;padding:0 4px}
    .rec-row-btn{background:none;border:none;cursor:pointer;color:#9CA3AF;
                 padding:5px;border-radius:5px;transition:all .12s;font-family:inherit;
                 display:inline-flex;align-items:center;justify-content:center;
                 width:26px;height:26px}
    .rec-row-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
    .rec-row-btn.edit:hover  {color:var(--blue-d);background:#EFF6FF}
    .rec-row-btn.addproj:hover{color:#047857;background:#ECFDF5}
    .rec-row-btn.dup:hover   {color:#7C3AED;background:#F5F3FF}
    .rec-row-btn.delete:hover{color:#DC2626;background:var(--red-bg)}

    /* Footer (totais por mês) */
    .rec-sheet tfoot td{background:#F1F5F9;font-weight:800;padding:11px 10px;
                        border-top:2px solid #CBD5E1;color:var(--tx);text-align:right;
                        font-family:'Menlo','Consolas',monospace;font-size:.78rem;
                        position:sticky;bottom:0;z-index:2;white-space:nowrap}
    .rec-sheet tfoot td.stk{z-index:3;background:#E2E8F0}
    .rec-sheet tfoot td.l{text-align:left;font-family:inherit;letter-spacing:.05em;
                          font-size:.68rem;text-transform:uppercase;color:var(--txm)}
    .rec-sheet tfoot td.stk-5{color:var(--blue-d);font-size:.84rem;border-right:2px solid var(--bdr)}

    /* Empty state */
    .rec-empty-row td{text-align:center;padding:40px 20px;color:var(--txl);
                      font-size:.82rem;background:#fff !important}

    /* Add row toolbar */
    .rec-add-toolbar{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}

    /* Filtro de TIPO (chips acima da planilha) */
    .rec-filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
                    padding:10px 12px;background:#F9FAFB;border:1px solid var(--bdr);
                    border-bottom:none;border-radius:var(--r) var(--r) 0 0;margin-bottom:0}
    .rec-filter-lbl{font-size:.68rem;font-weight:700;color:var(--txm);
                    text-transform:uppercase;letter-spacing:.06em;margin-right:4px}
    .rec-chip{display:inline-flex;align-items:center;gap:5px;
              padding:5px 11px;border-radius:14px;font-size:.73rem;font-weight:600;
              background:#fff;color:var(--txm);border:1px solid var(--bdr);
              cursor:pointer;transition:all .12s;font-family:inherit}
    .rec-chip:hover{background:#F3F4F6;color:var(--tx)}
    .rec-chip.active{background:var(--blue-d);color:#fff;border-color:var(--blue-d)}
    .rec-chip-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
    .rec-filter-count{margin-left:auto;font-size:.68rem;color:var(--txl)}

    /* Ajuste: sheet-wrap sem borda superior quando tem filtro */
    .rec-sheet-wrap.with-filter{border-radius:0 0 var(--r) var(--r)}

    /* Select de TIPO dentro da célula */
    .rec-tipo-select{width:100%;border:1.5px solid transparent;background:transparent;
                     padding:8px 26px 8px 10px;font-size:.76rem;font-family:inherit;
                     color:var(--tx);outline:none;cursor:pointer;appearance:none;
                     -webkit-appearance:none;-moz-appearance:none;
                     background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='%239CA3AF' stroke-width='3'><polyline points='6 9 12 15 18 9'/></svg>");
                     background-repeat:no-repeat;background-position:right 8px center;
                     box-sizing:border-box}
    .rec-tipo-select:focus{border-color:var(--blue);background-color:#EFF6FF}
    .rec-tipo-select.empty{color:var(--txl);font-style:italic}
    .rec-tipo-select.filled{background-color:var(--tc,transparent);
                            color:var(--ttxt,var(--tx));font-weight:700}
    .rec-tipo-select:hover{filter:brightness(.97)}

    /* Botões "Novo tipo" / "Gerenciar tipos" na barra de filtro */
    .rec-tipo-filter-btn{display:inline-flex;align-items:center;gap:5px;
                         padding:5px 11px;border-radius:14px;font-size:.7rem;font-weight:600;
                         background:#fff;color:var(--txm);border:1px dashed var(--bdr);
                         cursor:pointer;transition:all .12s;font-family:inherit;margin-left:4px}
    .rec-tipo-filter-btn:hover{background:#F3F4F6;color:var(--tx);border-color:#9CA3AF}
    .rec-tipo-filter-btn.primary{color:var(--blue-d);border-color:var(--blue);border-style:solid}
    .rec-tipo-filter-btn.primary:hover{background:#EFF6FF;color:#1E40AF;border-color:#1E40AF}
    .rec-tipo-filter-btn svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.4}

    /* Select compacto de TIPO (substitui chips) */
    .rec-tipo-filter-select{font-size:.73rem;font-family:inherit;border:1px solid var(--bdr);
                            border-radius:14px;padding:5px 28px 5px 12px;background:#fff;
                            color:var(--txm);cursor:pointer;outline:none;font-weight:600;
                            appearance:none;-webkit-appearance:none;-moz-appearance:none;
                            background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='%239CA3AF' stroke-width='3'><polyline points='6 9 12 15 18 9'/></svg>");
                            background-repeat:no-repeat;background-position:right 9px center;
                            max-width:190px;text-overflow:ellipsis}
    .rec-tipo-filter-select:hover{background-color:#F3F4F6;color:var(--tx)}
    .rec-tipo-filter-select:focus{border-color:var(--blue)}
    .rec-tipo-filter-select.has-color{padding-left:24px;
                            background-image:
                              radial-gradient(circle at 10px 50%, var(--tdot,#9CA3AF) 0 4px, transparent 4px),
                              url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='%239CA3AF' stroke-width='3'><polyline points='6 9 12 15 18 9'/></svg>");
                            background-repeat:no-repeat,no-repeat;
                            background-position:left 8px center, right 9px center;
                            border-color:var(--tdot,var(--bdr));color:var(--tx)}

    /* Modal de Tipos */
    .tipo-list{display:flex;flex-direction:column;gap:8px;margin-bottom:14px}
    .tipo-item{display:flex;align-items:center;gap:8px;padding:8px 10px;
               border:1px solid var(--bdr);border-radius:8px;background:#F9FAFB}
    .tipo-item input[type="text"]{flex:1;border:1px solid var(--bdr);border-radius:6px;
                                  padding:6px 8px;font-size:.78rem;font-family:inherit;
                                  background:#fff;outline:none}
    .tipo-item input[type="text"]:focus{border-color:var(--blue)}
    .tipo-item-swatch{width:22px;height:22px;border-radius:50%;cursor:pointer;flex-shrink:0;
                      border:2px solid #fff;box-shadow:0 0 0 1px var(--bdr);transition:transform .1s}
    .tipo-item-swatch:hover{transform:scale(1.12)}
    .tipo-item-del{background:none;border:none;cursor:pointer;color:#9CA3AF;
                   padding:5px;border-radius:5px;transition:all .12s;font-family:inherit;
                   display:inline-flex;align-items:center;justify-content:center;
                   width:28px;height:28px;flex-shrink:0}
    .tipo-item-del svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
    .tipo-item-del:hover{color:#DC2626;background:var(--red-bg)}
    .tipo-empty{text-align:center;color:var(--txl);padding:18px 10px;font-size:.8rem;
                border:1px dashed var(--bdr);border-radius:8px;margin-bottom:14px}
    .tipo-add-row{display:flex;gap:6px;margin-top:6px}
    .tipo-add-btn{background:var(--blue-d);color:#fff;border:none;border-radius:8px;
                  padding:8px 14px;font-size:.77rem;font-weight:700;cursor:pointer;
                  font-family:inherit;display:inline-flex;align-items:center;gap:5px}
    .tipo-add-btn:hover{background:#1E40AF}
    .tipo-add-btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.6}
    .tipo-done-btn{background:#fff;color:var(--txm);border:1px solid var(--bdr);border-radius:8px;
                   padding:8px 14px;font-size:.77rem;font-weight:700;cursor:pointer;
                   font-family:inherit;margin-left:auto}
    .tipo-done-btn:hover{background:#F3F4F6;color:var(--tx)}
    /* Modal: Novo / Duplicar ano */
    .nyr-field{margin-bottom:16px}
    .nyr-label{display:block;font-size:.72rem;font-weight:700;color:var(--txm);
               text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
    .nyr-input{width:140px;border:1.5px solid var(--bdr);border-radius:8px;
               padding:9px 12px;font-size:1rem;font-family:inherit;color:var(--tx);
               outline:none;font-weight:700;letter-spacing:.02em;text-align:center}
    .nyr-input:focus{border-color:var(--blue);background:#EFF6FF}
    .nyr-hint{font-size:.7rem;color:var(--txl);margin-top:6px;line-height:1.5}
    .nyr-hint b{color:var(--tx);font-weight:700}
    .nyr-choice-group{display:flex;flex-direction:column;gap:6px}
    .nyr-choice{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;
                border:1.5px solid var(--bdr);border-radius:8px;cursor:pointer;
                transition:all .12s;background:#fff}
    .nyr-choice:hover{background:#F9FAFB;border-color:#CBD5E1}
    .nyr-choice input[type="radio"]{margin-top:2px;cursor:pointer;accent-color:var(--blue)}
    .nyr-choice input[type="radio"]:checked ~ .nyr-choice-body .nyr-choice-title{color:var(--blue-d)}
    .nyr-choice:has(input:checked){border-color:var(--blue);background:#EFF6FF}
    .nyr-choice-body{flex:1}
    .nyr-choice-title{font-size:.82rem;font-weight:700;color:var(--tx);margin-bottom:2px}
    .nyr-choice-desc{font-size:.7rem;color:var(--txm);line-height:1.4}
    .nyr-check{display:flex;align-items:center;gap:8px;padding:6px 0;
               font-size:.78rem;color:var(--tx);cursor:pointer}
    .nyr-check input[type="checkbox"]{cursor:pointer;accent-color:var(--blue);width:14px;height:14px}
    .nyr-check:hover{color:var(--blue-d)}
    .rec-year-dup{background:none;border:none;cursor:pointer;color:var(--txl);
                   padding:2px 6px;margin-left:4px;border-radius:4px;font-size:.85rem;
                   display:none;align-items:center;line-height:1}
    .rec-year-tab.active .rec-year-dup{display:inline-flex}
    .rec-year-dup:hover{color:var(--blue-d);background:#EFF6FF}

    .tipo-mod-foot{display:flex;gap:8px;align-items:center;
                   padding:10px 16px;border-top:1px solid var(--bdr);background:#F9FAFB}
    .tipo-hint{font-size:.7rem;color:var(--txl);margin-bottom:10px;line-height:1.45}

    /* Coluna de País — botão com bandeira */
    .rec-pais-btn{background:transparent;border:1px solid transparent;border-radius:6px;
                  padding:4px 4px;font-size:1.15rem;cursor:pointer;
                  min-width:34px;width:100%;text-align:center;line-height:1.1;
                  font-family:inherit;transition:all .12s}
    .rec-pais-btn:hover{background:#F3F4F6;border-color:var(--bdr)}
    .rec-pais-btn.empty{color:var(--txl);font-size:.9rem;font-weight:600}

    /* Popup de seleção de país */
    .rec-pais-pop{position:fixed;background:#fff;border:1px solid var(--bdr);
                  border-radius:10px;padding:8px;z-index:500;
                  box-shadow:0 10px 30px rgba(0,0,0,.18);
                  max-height:320px;overflow:hidden;min-width:230px;
                  display:flex;flex-direction:column;gap:6px}
    .rec-pais-search{width:100%;border:1px solid var(--bdr);border-radius:6px;
                     padding:6px 9px;font-size:.78rem;outline:none;font-family:inherit;
                     box-sizing:border-box}
    .rec-pais-search:focus{border-color:var(--blue)}
    .rec-pais-list{overflow-y:auto;max-height:250px;display:flex;flex-direction:column;gap:2px}
    .rec-pais-opt{display:flex;align-items:center;gap:10px;
                  padding:6px 10px;border-radius:6px;cursor:pointer;
                  font-size:.78rem;color:var(--tx);user-select:none}
    .rec-pais-opt:hover{background:#F3F4F6}
    .rec-pais-opt .f{font-size:1.15rem;line-height:1;flex-shrink:0}
    .rec-pais-opt.selected{background:#EFF6FF;color:var(--blue-d);font-weight:700}
    .rec-pais-opt.none{color:var(--txl);font-style:italic}
    .rec-pais-opt.add{color:var(--blue-d);font-weight:600;border-top:1px dashed var(--bdr);
                      margin-top:4px;padding-top:8px}
    .rec-pais-opt.add:hover{background:#EFF6FF}

    /* ── Seletor de Cliente (primeira coluna) ─────────────────── */
    /* Botão-pill na primeira coluna (substitui o input de nome) */
    .rec-cli-btn{flex:1;min-width:0;display:flex;align-items:center;gap:6px;
                 background:transparent;border:1.5px solid transparent;border-radius:6px;
                 padding:8px 8px;cursor:pointer;color:var(--tx);font-family:inherit;
                 font-size:.78rem;font-weight:700;letter-spacing:-0.01em;
                 text-align:left;transition:all .12s;overflow:hidden}
    .rec-cli-btn:hover{background:#F3F4F6;border-color:var(--bdr)}
    .rec-cli-btn:focus{border-color:var(--blue);background:#EFF6FF;outline:none}
    .rec-cli-btn .rec-cli-txt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
                              flex:1;min-width:0}
    .rec-cli-btn.empty .rec-cli-txt{color:var(--txl);font-weight:500;font-style:italic}
    .rec-cli-btn .rec-cli-caret{color:var(--txl);font-size:.7rem;flex-shrink:0;opacity:.6}
    .rec-cli-btn:hover .rec-cli-caret{opacity:1}
    .rec-first-wrap.is-sub .rec-cli-btn{color:var(--txl);font-style:italic;
                                        font-size:.72rem;font-weight:500}
    .rec-first-wrap.is-sub .rec-cli-btn:hover{color:var(--tx)}

    /* Popup do seletor de cliente */
    .rec-cli-pop{position:fixed;background:#fff;border:1px solid var(--bdr);
                 border-radius:10px;padding:0;z-index:500;
                 box-shadow:0 12px 32px rgba(0,0,0,.2);
                 max-height:380px;overflow:hidden;width:330px;
                 display:flex;flex-direction:column}
    .rec-cli-header{padding:10px 12px 8px;border-bottom:1px solid var(--bdr);
                    display:flex;flex-direction:column;gap:6px;background:#FAFAFA}
    .rec-cli-header-title{font-size:.65rem;font-weight:700;text-transform:uppercase;
                          letter-spacing:.06em;color:var(--txm)}
    .rec-cli-search{width:100%;border:1px solid var(--bdr);border-radius:6px;
                    padding:7px 10px;font-size:.8rem;outline:none;font-family:inherit;
                    box-sizing:border-box}
    .rec-cli-search:focus{border-color:var(--blue)}
    .rec-cli-list{overflow-y:auto;flex:1;padding:4px 6px;min-height:40px;max-height:230px}
    .rec-cli-opt{display:flex;align-items:center;gap:8px;padding:7px 8px;
                 border-radius:6px;cursor:pointer;color:var(--tx);
                 font-size:.8rem;user-select:none}
    .rec-cli-opt:hover{background:#F3F4F6}
    .rec-cli-opt.selected{background:#EFF6FF;color:var(--blue-d);font-weight:700}
    .rec-cli-opt .rec-cli-swatch{width:10px;height:10px;border-radius:50%;
                                  flex-shrink:0;border:1px solid rgba(0,0,0,.08)}
    .rec-cli-opt .rec-cli-oflag{font-size:.95rem;line-height:1;flex-shrink:0;width:18px;text-align:center}
    .rec-cli-opt .rec-cli-oname{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .rec-cli-opt .rec-cli-count{color:var(--txm);font-size:.65rem;font-weight:700;
                                background:#F3F4F6;border-radius:10px;
                                padding:1px 7px;flex-shrink:0}
    .rec-cli-opt .rec-cli-rename{display:none;background:transparent;border:none;
                                  padding:3px;cursor:pointer;color:var(--txm);
                                  border-radius:4px;flex-shrink:0}
    .rec-cli-opt:hover .rec-cli-rename{display:flex;align-items:center}
    .rec-cli-opt .rec-cli-rename:hover{background:#E5E7EB;color:var(--tx)}
    .rec-cli-opt .rec-cli-rename svg{width:11px;height:11px;fill:none;stroke:currentColor;stroke-width:2}
    .rec-cli-empty{padding:16px 12px;text-align:center;color:var(--txl);
                   font-size:.74rem;font-style:italic}
    .rec-cli-footer{border-top:1px solid var(--bdr);padding:8px;background:#FAFAFA;
                    display:flex;flex-direction:column;gap:6px}
    .rec-cli-new{width:100%;background:var(--blue);color:#fff;border:none;
                 border-radius:6px;padding:8px 12px;font-size:.78rem;font-weight:700;
                 cursor:pointer;font-family:inherit;display:flex;align-items:center;
                 justify-content:center;gap:6px;transition:background .12s}
    .rec-cli-new:hover{background:var(--blue-d)}
    .rec-cli-new svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2.5}
    .rec-cli-new b{font-weight:800}
    .rec-cli-unlink{width:100%;background:transparent;color:var(--txm);border:1px solid var(--bdr);
                    border-radius:6px;padding:6px 12px;font-size:.72rem;font-weight:600;
                    cursor:pointer;font-family:inherit}
    .rec-cli-unlink:hover{background:#FEE2E2;color:#991B1B;border-color:#FCA5A5}

    /* Coluna Projeto — input de texto livre */
    .rec-projeto-input{width:100%;border:1.5px solid transparent;background:transparent;
                       padding:8px 10px;font-size:.76rem;font-family:inherit;
                       color:var(--tx);outline:none;box-sizing:border-box}
    .rec-projeto-input:focus{border-color:var(--blue);background-color:#EFF6FF}
    .rec-projeto-input::placeholder{color:var(--txl);font-style:italic}

    /* Filtro de país (select na barra de filtro) */
    .rec-pais-filter{font-size:.73rem;font-family:inherit;border:1px solid var(--bdr);
                     border-radius:14px;padding:5px 10px;background:#fff;color:var(--txm);
                     cursor:pointer;outline:none;font-weight:600}
    .rec-pais-filter:hover{background:#F3F4F6;color:var(--tx)}
    .rec-pais-filter:focus{border-color:var(--blue)}
    .rec-filter-sep{width:1px;height:18px;background:var(--bdr);margin:0 4px}

    /* Toggle "incluir simulações no total" */
    .rec-sim-toggle{display:inline-flex;align-items:center;gap:7px;
                    padding:4px 11px 4px 9px;border-radius:14px;
                    font-size:.72rem;font-weight:600;font-family:inherit;
                    border:1px solid var(--bdr);background:#fff;color:var(--txm);
                    cursor:pointer;transition:all .12s;margin-left:6px}
    .rec-sim-toggle:hover{background:#F3F4F6;color:var(--tx);border-color:#9CA3AF}
    .rec-sim-toggle.on{background:#F5F3FF;color:#6D28D9;border-color:#C4B5FD}
    .rec-sim-toggle.on:hover{background:#EDE9FE;border-color:#A78BFA}
    .rec-sim-toggle-ico{font-size:.85rem;line-height:1}
    .rec-sim-toggle-sw{width:24px;height:13px;border-radius:8px;background:#D1D5DB;
                       position:relative;transition:background .15s;flex-shrink:0}
    .rec-sim-toggle.on .rec-sim-toggle-sw{background:#8B5CF6}
    .rec-sim-toggle-dot{position:absolute;top:1px;left:1px;width:11px;height:11px;
                        background:#fff;border-radius:50%;transition:left .15s;
                        box-shadow:0 1px 2px rgba(0,0,0,.2)}
    .rec-sim-toggle.on .rec-sim-toggle-dot{left:12px}
    /* Sem simulações cadastradas no ano → toggle esmaecido */
    .rec-sim-toggle.vazio:not(.on){opacity:.6}
    .rec-sim-toggle.vazio:not(.on):hover{opacity:.85}

    /* Paleta de cores popup */
    .rec-palette{position:fixed;background:#fff;border:1px solid var(--bdr);
                 border-radius:10px;padding:10px;z-index:500;
                 box-shadow:0 10px 30px rgba(0,0,0,.18);
                 display:grid;grid-template-columns:repeat(5,20px);gap:7px}
    .rec-pal-swatch{width:20px;height:20px;border-radius:50%;cursor:pointer;
                    border:2px solid #fff;box-shadow:0 0 0 1px var(--bdr);
                    transition:transform .1s}
    .rec-pal-swatch:hover{transform:scale(1.2)}

    /* Linhas de simulação ficam com fundo roxo claro */
    .rec-sheet tbody tr.is-sim td{background:#FAF5FF}
    .rec-sheet tbody tr.is-sim:hover td{background:#F5F0FF}
    .rec-sheet tbody tr.is-sim td.stk-5{background:#F5F0FF;color:#7C3AED}

    /* Cliente inativo — linha visualmente amortecida */
    .rec-sheet tbody tr.cli-inativo td.stk-1 .rec-cli-txt,
    .rec-sheet tbody tr.cli-inativo td.stk-1 .rec-cli-caret{color:#94A3B8}
    .rec-sheet tbody tr.cli-inativo td.rec-cell .rec-input{color:#94A3B8}
    .rec-sheet tbody tr.cli-inativo td.stk-5{color:#94A3B8}

    /* Toggle Ativo na coluna sticky */
    .rec-ativo-wrap{display:flex;align-items:center;justify-content:center;height:100%}
    .rec-ativo-toggle{position:relative;width:30px;height:16px;border-radius:999px;
                      background:#CBD5E1;border:none;cursor:pointer;padding:0;flex:none;
                      transition:background .15s ease}
    .rec-ativo-toggle::after{content:'';position:absolute;top:2px;left:2px;width:12px;height:12px;
                             background:#fff;border-radius:50%;box-shadow:0 1px 2px rgba(15,23,42,.3);
                             transition:transform .18s ease}
    .rec-ativo-toggle.on{background:#10B981}
    .rec-ativo-toggle.on::after{transform:translateX(14px)}
    .rec-ativo-toggle:hover{filter:brightness(1.05)}
    .rec-ativo-sub{width:14px;height:8px;border-radius:4px;background:#E2E8F0;opacity:.7;
                   margin:0 auto;display:block}
    .rec-ativo-sub.on{background:#BBF7D0}

    /* Ícone "Info" ao lado do nome do cliente — abre o detail card */
    .rec-cli-info{display:inline-flex;align-items:center;justify-content:center;
                  width:20px;height:20px;border-radius:50%;flex:none;
                  margin-left:2px;color:#94A3B8;background:transparent;
                  border:none;cursor:pointer;padding:0;transition:all .12s}
    .rec-cli-info:hover{background:#EFF6FF;color:#2563EB}
    .rec-cli-info svg{width:13px;height:13px}

    /* ════ Card de detalhe do cliente ════ */
    #ov-clidet{position:fixed;inset:0;background:rgba(15,23,42,.55);
               display:none;align-items:center;justify-content:center;z-index:9999;
               backdrop-filter:blur(2px)}
    #ov-clidet.open{display:flex}
    .clidet-card{background:#fff;border-radius:14px;width:540px;max-width:calc(100vw - 40px);
                 max-height:calc(100vh - 80px);overflow:auto;
                 box-shadow:0 20px 60px rgba(15,23,42,.35);
                 animation:clidet-in .2s cubic-bezier(.2,.9,.3,1)}
    @keyframes clidet-in{from{opacity:0;transform:translateY(6px) scale(.97)}
                         to{opacity:1;transform:none}}
    .clidet-head{padding:18px 22px 14px;border-bottom:1px solid #E2E8F0;
                 display:flex;align-items:center;gap:14px;position:relative}
    .clidet-avatar-wrap{position:relative;flex:none;width:44px;height:44px}
    .clidet-avatar{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;
                   justify-content:center;color:#fff;font-weight:700;font-size:1.1rem;
                   background:var(--cc,#2563EB);letter-spacing:-.02em;cursor:pointer;
                   overflow:hidden;position:relative;transition:transform .15s, box-shadow .15s;
                   box-sizing:border-box}
    .clidet-avatar:hover{transform:scale(1.04);box-shadow:0 3px 10px rgba(15,23,42,.18)}
    .clidet-avatar.has-logo{background:#fff;border:1px solid #E2E8F0;padding:2px}
    .clidet-avatar-initials{position:relative;z-index:1}
    .clidet-avatar-img{width:100%;height:100%;object-fit:contain;border-radius:9px;display:block}
    .clidet-avatar-overlay{position:absolute;inset:0;background:rgba(15,23,42,.6);
                           display:flex;align-items:center;justify-content:center;
                           opacity:0;transition:opacity .15s;color:#fff;border-radius:11px}
    .clidet-avatar:hover .clidet-avatar-overlay{opacity:1}
    .clidet-avatar-remove{position:absolute;top:-5px;right:-5px;width:18px;height:18px;
                          border-radius:50%;background:#DC2626;color:#fff;
                          border:2px solid #fff;cursor:pointer;display:flex;
                          align-items:center;justify-content:center;padding:0;
                          opacity:0;transition:opacity .15s, background .15s;
                          box-shadow:0 1px 3px rgba(0,0,0,.2)}
    .clidet-avatar-wrap:hover .clidet-avatar-remove{opacity:1}
    .clidet-avatar-remove:hover{background:#991B1B}
    .clidet-head-txt{flex:1;min-width:0}
    .clidet-name{font-size:1.02rem;font-weight:700;color:#0F172A;margin:0;
                 white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .clidet-sub{font-size:.72rem;color:#64748B;margin-top:2px;display:flex;gap:8px;
                align-items:center}
    .clidet-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;
                  border-radius:999px;font-size:.62rem;font-weight:700;text-transform:uppercase;
                  letter-spacing:.04em}
    .clidet-badge.on{background:#D1FAE5;color:#047857}
    .clidet-badge.off{background:#FEE2E2;color:#B91C1C}
    .clidet-tempo{display:inline-flex;align-items:center;gap:4px;font-size:.7rem;
                  color:#475569;font-weight:500}
    .clidet-tempo svg{flex:none;opacity:.75}
    .clidet-tempo.empty{color:#94A3B8;font-style:italic;font-weight:400}
    .clidet-close{position:absolute;top:14px;right:14px;width:28px;height:28px;
                  border-radius:50%;background:transparent;border:none;cursor:pointer;
                  color:#64748B;display:flex;align-items:center;justify-content:center}
    .clidet-close:hover{background:#F3F4F6;color:#0F172A}
    .clidet-body{padding:16px 22px 20px}
    .clidet-section{margin-bottom:18px}
    .clidet-section:last-child{margin-bottom:0}
    .clidet-sec-title{font-size:.6rem;color:#64748B;font-weight:700;letter-spacing:.06em;
                      text-transform:uppercase;margin-bottom:8px}
    .clidet-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 14px}
    .clidet-field{display:flex;flex-direction:column;gap:4px}
    .clidet-field.full{grid-column:1/-1}
    .clidet-field label{font-size:.68rem;color:#475569;font-weight:600}
    .clidet-input{border:1px solid #E2E8F0;border-radius:7px;padding:7px 9px;font-size:.78rem;
                  font-family:inherit;color:#0F172A;background:#fff;outline:none;width:100%;
                  box-sizing:border-box}
    .clidet-input:focus{border-color:#2563EB;box-shadow:0 0 0 3px rgba(37,99,235,.12)}
    .clidet-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .clidet-stat{border:1px solid #E2E8F0;border-radius:10px;padding:10px 12px;background:#F8FAFC}
    .clidet-stat-lbl{font-size:.62rem;color:#64748B;font-weight:700;text-transform:uppercase;
                     letter-spacing:.05em}
    .clidet-stat-val{font-size:1.05rem;font-weight:700;color:#0F172A;margin-top:2px;
                     font-family:'Menlo','Consolas',monospace;letter-spacing:-.01em}
    .clidet-stat.recebido .clidet-stat-val{color:#059669}
    .clidet-stat.aberto .clidet-stat-val{color:#D97706}
    .clidet-hist-wrap{border:1px solid #E2E8F0;border-radius:10px;overflow:hidden;
                      max-height:240px;overflow-y:auto;background:#fff}
    .clidet-hist{width:100%;border-collapse:collapse;font-size:.76rem;
                 font-variant-numeric:tabular-nums}
    .clidet-hist thead th{background:#F8FAFC;color:#64748B;font-size:.6rem;
                          font-weight:700;text-transform:uppercase;letter-spacing:.05em;
                          padding:8px 10px;text-align:right;border-bottom:1px solid #E2E8F0;
                          position:sticky;top:0;z-index:1}
    .clidet-hist thead th.clidet-hist-yr{text-align:left}
    .clidet-hist tbody td{padding:7px 10px;border-bottom:1px solid #F1F5F9;
                          text-align:right;color:#0F172A;
                          font-family:'Menlo','Consolas',monospace;letter-spacing:-.01em}
    .clidet-hist tbody tr:last-child td{border-bottom:none}
    .clidet-hist tbody tr:hover td{background:#F8FAFC}
    .clidet-hist td.clidet-hist-yr{text-align:left;color:#475569;font-weight:700;
                                    font-family:inherit;letter-spacing:0}
    .clidet-hist td.clidet-hist-rec{color:#059669;font-weight:600}
    .clidet-hist td.clidet-hist-ab{color:#D97706;font-weight:600}
    .clidet-hist td.clidet-hist-tot{font-weight:700;color:#0F172A}
    .clidet-hist tfoot td{padding:9px 10px;background:#F8FAFC;border-top:2px solid #E2E8F0;
                          text-align:right;font-weight:700;
                          font-family:'Menlo','Consolas',monospace;letter-spacing:-.01em;
                          position:sticky;bottom:0}
    .clidet-hist tfoot td.clidet-hist-yr{text-align:left;color:#475569;
                                          font-family:inherit;letter-spacing:.02em;
                                          text-transform:uppercase;font-size:.64rem}
    .clidet-hist tfoot td.clidet-hist-rec{color:#059669}
    .clidet-hist tfoot td.clidet-hist-ab{color:#D97706}
    .clidet-hist tfoot td.clidet-hist-tot{color:#2563EB}
    .clidet-dash{color:#CBD5E1;font-weight:400}
    .clidet-empty{padding:18px 14px;border:1px dashed #E2E8F0;border-radius:10px;
                  background:#F8FAFC;text-align:center;font-size:.76rem;color:#64748B}
    .clidet-sec-title-row{display:flex;align-items:center;justify-content:space-between;
                          gap:10px}
    .clidet-sec-count{font-size:.7rem;font-weight:600;color:var(--txm);
                      text-transform:none;letter-spacing:0}
    /* ── Chips de tipo de pessoa ── */
    .clidet-tipo-chips{display:inline-flex;gap:0;border:1px solid #E2E8F0;
                       border-radius:7px;overflow:hidden;background:#F8FAFC}
    .clidet-tipo-chip{border:none;background:transparent;color:#64748B;
                      font-family:inherit;font-size:.64rem;font-weight:700;
                      letter-spacing:.04em;padding:5px 10px;cursor:pointer;
                      transition:all .12s;text-transform:uppercase}
    .clidet-tipo-chip + .clidet-tipo-chip{border-left:1px solid #E2E8F0}
    .clidet-tipo-chip:hover{background:#EFF6FF;color:#2563EB}
    .clidet-tipo-chip.on{background:#2563EB;color:#fff}
    .clidet-tipo-chip.on:hover{background:#1D4ED8;color:#fff}
    /* ── Input com botão de lookup de CNPJ ── */
    .clidet-doc-row{display:flex;gap:6px;align-items:stretch}
    .clidet-doc-row .clidet-input{flex:1;min-width:0}
    .clidet-doc-btn{flex:none;width:32px;border:1px solid #E2E8F0;background:#fff;
                    color:#2563EB;border-radius:7px;cursor:pointer;display:flex;
                    align-items:center;justify-content:center;transition:all .12s}
    .clidet-doc-btn:hover{background:#EFF6FF;border-color:#93C5FD}
    .clidet-doc-btn:disabled{opacity:.75;cursor:wait}
    .clidet-doc-btn.ok{background:#D1FAE5;border-color:#6EE7B7;color:#047857}
    .clidet-doc-btn.err{background:#FEE2E2;border-color:#FCA5A5;color:#B91C1C}
    .clidet-doc-btn .spin{animation:clidet-spin .8s linear infinite;transform-origin:center}
    @keyframes clidet-spin{to{transform:rotate(360deg)}}
    .clidet-field-hint{font-size:.65rem;color:#64748B;margin-top:3px}
    .clidet-field-hint .err{color:#B91C1C;font-weight:600}
    /* ── LTV card ── */
    .clidet-ltv{border:1px solid #E0E7FF;border-radius:12px;padding:16px 20px;
                background:linear-gradient(135deg,#F5F3FF 0%,#EFF6FF 100%);
                display:flex;flex-direction:column;gap:8px;align-items:flex-start}
    .clidet-ltv-val{font-size:1.85rem;font-weight:800;color:#312E81;
                    font-family:'Menlo','Consolas',monospace;letter-spacing:-.02em;line-height:1}
    .clidet-ltv-formula{display:flex;align-items:baseline;gap:4px;flex-wrap:wrap;
                        font-size:.7rem;color:#4F46E5}
    .clidet-ltv-op{font-family:'Menlo','Consolas',monospace;font-weight:700;color:#312E81;
                   letter-spacing:-.01em}
    .clidet-ltv-lbl{color:#64748B;font-weight:500;margin-right:4px}
    .clidet-ltv-x{color:#A5B4FC;font-weight:700;margin:0 2px}
    /* ── Anexos de contrato ── */
    .clidet-anx-add{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;
                    border:1px solid #CBD5E1;border-radius:7px;font-size:.7rem;
                    font-weight:600;color:#2563EB;background:#fff;cursor:pointer;
                    transition:all .12s;text-transform:none;letter-spacing:0}
    .clidet-anx-add:hover{background:#EFF6FF;border-color:#93C5FD;color:#1D4ED8}
    .clidet-anx-list{display:flex;flex-direction:column;gap:6px}
    .clidet-anx-item{display:flex;align-items:center;gap:10px;padding:8px 10px;
                     border:1px solid #E2E8F0;border-radius:9px;background:#fff;
                     transition:all .12s}
    .clidet-anx-item:hover{border-color:#CBD5E1;background:#F8FAFC}
    .clidet-anx-ext{width:38px;height:38px;border-radius:8px;background:#EFF6FF;
                    color:#2563EB;display:flex;align-items:center;justify-content:center;
                    font-size:.62rem;font-weight:800;letter-spacing:.02em;flex:none}
    .clidet-anx-info{flex:1;min-width:0}
    .clidet-anx-name{font-size:.78rem;font-weight:600;color:#0F172A;
                     white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .clidet-anx-meta{font-size:.66rem;color:#64748B;margin-top:1px;
                     display:flex;gap:5px;align-items:center}
    .clidet-anx-actions{display:flex;gap:4px;flex:none}
    .clidet-anx-btn{width:28px;height:28px;border-radius:7px;border:1px solid #E2E8F0;
                    background:#fff;color:#475569;cursor:pointer;display:flex;
                    align-items:center;justify-content:center;transition:all .12s}
    .clidet-anx-btn:hover{background:#EFF6FF;border-color:#93C5FD;color:#2563EB}
    .clidet-anx-btn.danger:hover{background:#FEE2E2;border-color:#FCA5A5;color:#B91C1C}
    /* ── Ciclos de contrato ── */
    .clidet-ciclo-add{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;
                      border:1px solid #CBD5E1;border-radius:7px;font-size:.7rem;
                      font-weight:600;color:#2563EB;background:#fff;cursor:pointer;
                      transition:all .12s;font-family:inherit}
    .clidet-ciclo-add:hover{background:#EFF6FF;border-color:#93C5FD;color:#1D4ED8}
    .clidet-ciclos-list{display:flex;flex-direction:column;gap:6px}
    .clidet-ciclo{display:flex;align-items:center;gap:10px;padding:8px 10px;
                  border:1px solid #E2E8F0;border-radius:9px;background:#fff;
                  transition:all .12s}
    .clidet-ciclo:hover{border-color:#CBD5E1;background:#F8FAFC}
    .clidet-ciclo.vigente{border-color:#BBF7D0;background:#F0FDF4}
    .clidet-ciclo.vigente:hover{border-color:#86EFAC;background:#ECFDF5}
    .clidet-ciclo-num{width:22px;text-align:center;font-size:.9rem;color:#94A3B8;flex:none}
    .clidet-ciclo.vigente .clidet-ciclo-num{color:#16A34A}
    .clidet-ciclo-fields{display:flex;gap:8px;flex:1;min-width:0}
    .clidet-ciclo-lbl{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
    .clidet-ciclo-lbl span{font-size:.62rem;font-weight:700;color:#64748B;
                          text-transform:uppercase;letter-spacing:.04em}
    .clidet-ciclo-lbl input{padding:5px 8px;border:1px solid #E2E8F0;border-radius:6px;
                           font-size:.72rem;font-family:inherit;color:#0F172A;
                           background:#fff;outline:none;transition:border-color .12s;width:100%;
                           box-sizing:border-box}
    .clidet-ciclo-lbl input:focus{border-color:#93C5FD}
    .clidet-ciclo-meta{display:flex;flex-direction:column;gap:2px;align-items:flex-end;
                       font-size:.68rem;color:#475569;min-width:90px;flex:none}
    .clidet-ciclo-dur{font-weight:600;color:#334155;font-size:.7rem}
    .clidet-ciclo-tag{display:inline-block;padding:1px 7px;border-radius:10px;
                      background:#DCFCE7;color:#15803D;font-size:.58rem;font-weight:700;
                      text-transform:uppercase;letter-spacing:.05em}
    .clidet-ciclo-del{width:26px;height:26px;border-radius:6px;border:1px solid #E2E8F0;
                      background:#fff;color:#94A3B8;cursor:pointer;display:flex;
                      align-items:center;justify-content:center;transition:all .12s;flex:none}
    .clidet-ciclo-del:hover{background:#FEE2E2;border-color:#FCA5A5;color:#B91C1C}
    .clidet-ciclo-hint{font-size:.66rem;color:#64748B;margin-top:8px;line-height:1.4}
    /* Modal "Adicionar ciclo de contrato" */
    /* Modais genéricos (askConfirm, askText, adicionar ciclo) precisam ficar acima
       do card de detalhe do cliente (#ov-clidet z-index:9999). */
    #ov-ciclo,
    #ov-askconfirm,
    #ov-asktext{z-index:10050}
    .ciclomodal-sub{font-size:.78rem;color:#475569;margin-bottom:14px;line-height:1.5}
    .ciclomodal-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:10px}
    .ciclomodal-field{display:flex;flex-direction:column;gap:4px}
    .ciclomodal-field span{font-size:.66rem;font-weight:700;color:#334155;
                            text-transform:uppercase;letter-spacing:.04em}
    .ciclomodal-field span em{font-style:normal;color:#64748B;font-weight:500;text-transform:none;letter-spacing:0}
    .ciclomodal-field input{padding:8px 10px;border:1.5px solid #CBD5E1;border-radius:8px;
                             font-size:.82rem;font-family:inherit;color:#0F172A;
                             background:#fff;outline:none;transition:border-color .12s;
                             width:100%;box-sizing:border-box}
    .ciclomodal-field input:focus{border-color:#2563EB}
    .ciclomodal-field.err input{border-color:#DC2626;background:#FEF2F2}
    .clidet-ativo{display:flex;align-items:center;justify-content:space-between;
                  gap:10px;padding:10px 12px;background:#F8FAFC;border-radius:10px;
                  border:1px solid #E2E8F0}
    .clidet-ativo-lbl{font-size:.76rem;font-weight:600;color:#0F172A}
    .clidet-ativo-hint{font-size:.66rem;color:#64748B;margin-top:2px}
    .clidet-foot{padding:12px 22px 18px;display:flex;gap:10px;justify-content:flex-end;
                 border-top:1px solid #F1F5F9}
    .clidet-btn{border:none;border-radius:8px;padding:8px 16px;font-size:.78rem;
                font-weight:600;font-family:inherit;cursor:pointer;transition:all .12s}
    .clidet-btn.primary{background:#2563EB;color:#fff}
    .clidet-btn.primary:hover{background:#1D4ED8}
    .clidet-btn.ghost{background:transparent;color:#475569}
    .clidet-btn.ghost:hover{background:#F3F4F6;color:#0F172A}

    @media(max-width:700px){
      .rec-sheet thead th.stk-1{min-width:120px;left:0}
      .rec-sheet thead th.stk-2{min-width:42px;left:120px}
      .rec-sheet thead th.stk-ativo{min-width:52px;left:162px}
      .rec-sheet thead th.stk-3{min-width:100px;left:214px}
      .rec-sheet thead th.stk-4{min-width:110px;left:314px}
      .rec-sheet thead th.stk-5{min-width:105px;left:424px}
      .rec-sheet tbody td.stk-2{left:120px}
      .rec-sheet tbody td.stk-ativo{left:162px}
      .rec-sheet tbody td.stk-3{left:214px}
      .rec-sheet tbody td.stk-4{left:314px}
      .rec-sheet tbody td.stk-5{left:424px}
    }

    /* ══════════════════════════════════════════════════════
       MÓDULO PESSOAS — planilha de headcount
       ══════════════════════════════════════════════════════ */
    .pes-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
    .pes-toolbar .btn{padding:8px 14px;font-size:.78rem;font-weight:700;border-radius:8px;
                      cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:6px;
                      border:1px solid var(--bdr);background:#fff;color:var(--txm);transition:all .12s}
    .pes-toolbar .btn:hover{background:#F3F4F6;color:var(--tx)}
    .pes-toolbar .btn.primary{background:var(--blue-d);color:#fff;border-color:var(--blue-d)}
    .pes-toolbar .btn.primary:hover{background:#1E40AF}
    .pes-toolbar .btn.ghost{background:transparent;border-style:dashed}
    .pes-toolbar .btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.5}
    .pes-toolbar-spacer{flex:1}
    .pes-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
                  gap:14px;margin-bottom:16px}
    .pes-kpi{background:var(--card);border-radius:var(--r);padding:14px 17px;
             box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04);
             border-left:3px solid var(--bdr)}
    .pes-kpi.folha{border-left-color:var(--blue-d)}
    .pes-kpi.head {border-left-color:#10B981}
    .pes-kpi.media{border-left-color:#14B8A6}
    .pes-kpi.grupos{border-left-color:#F59E0B}
    .pes-kpi-lbl{font-size:.62rem;font-weight:700;text-transform:uppercase;
                 letter-spacing:.07em;color:var(--txl);margin-bottom:5px}
    .pes-kpi-val{font-size:1.35rem;font-weight:800;letter-spacing:-0.02em;color:var(--tx)}
    .pes-kpi-val.blu{color:var(--blue-d)}
    .pes-kpi-val.grn{color:#059669}
    .pes-kpi-val.teal{color:#0F766E}
    .pes-kpi-val.amb{color:#D97706}
    /* Variação vs ano anterior: cor e borda seguem o sinal (gasto subindo = ruim) */
    .pes-kpi.trend-up{border-left-color:#DC2626}
    .pes-kpi.trend-up .pes-kpi-val{color:#DC2626}
    .pes-kpi.trend-down{border-left-color:#059669}
    .pes-kpi.trend-down .pes-kpi-val{color:#059669}
    .pes-kpi.trend-neutral{border-left-color:#9CA3AF}
    .pes-kpi.trend-neutral .pes-kpi-val{color:#6B7280}
    .pes-kpi-sub{font-size:.67rem;color:var(--txm);margin-top:3px}
    /* Linha com valor + chip de variação lado a lado */
    .pes-kpi-val-row{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
    .pes-kpi-var-chip{display:inline-flex;align-items:center;gap:3px;
                      font-size:.68rem;font-weight:700;padding:2px 7px;border-radius:999px;
                      background:#F3F4F6;color:#6B7280;font-variant-numeric:tabular-nums;line-height:1.1}
    .pes-kpi-var-chip.up   {background:#FEE2E2;color:#B91C1C}
    .pes-kpi-var-chip.down {background:#D1FAE5;color:#047857}
    .pes-kpi-var-chip:empty{display:none}

    /* KPI especial: card dividido com dois valores (Pago × Projetado) */
    .pes-kpi.imp-cor-kpi-split{border-left-color:#10B981}
    .imp-cor-kpi-split .imp-cor-kpi-split-row{display:flex;align-items:stretch;gap:0;margin-top:2px}
    .imp-cor-kpi-split .imp-cor-kpi-split-cell{flex:1;min-width:0;display:flex;
                        flex-direction:column;gap:1px}
    .imp-cor-kpi-split .imp-cor-kpi-split-cell.aberto{padding-left:12px}
    .imp-cor-kpi-split .imp-cor-kpi-split-div{width:1px;background:var(--bdr);
                        margin:4px 0;flex:0 0 auto}
    .imp-cor-kpi-split .imp-cor-kpi-split-lbl{font-size:.58rem;font-weight:700;
                        text-transform:uppercase;letter-spacing:.06em;color:var(--txm)}
    .imp-cor-kpi-split .imp-cor-kpi-split-val{font-size:1.05rem;font-weight:800;
                        letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.15}
    .imp-cor-kpi-split .imp-cor-kpi-split-cell.pago   .imp-cor-kpi-split-lbl{color:#059669}
    .imp-cor-kpi-split .imp-cor-kpi-split-cell.pago   .imp-cor-kpi-split-val{color:#059669}
    .imp-cor-kpi-split .imp-cor-kpi-split-cell.aberto .imp-cor-kpi-split-lbl{color:#DC2626}
    .imp-cor-kpi-split .imp-cor-kpi-split-cell.aberto .imp-cor-kpi-split-val{color:#DC2626}
    /* Chip sutil %FF (força faturável) dentro do sub */
    .kpi-ff-chip{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:10px;
                 background:#EEF2FF;color:#4338CA;font-size:.6rem;font-weight:700;
                 letter-spacing:.02em;vertical-align:1px;cursor:help}

    /* ── Fill handle (arrastar valor entre células, estilo Excel) ───── */
    .xl-fill-handle{
      position:fixed; width:8px; height:8px; background:#2563EB;
      border:1px solid #fff; border-radius:1px;
      cursor:crosshair; z-index:9999;
      display:none; pointer-events:auto;
      box-shadow:0 0 0 1px rgba(37,99,235,.35), 0 1px 2px rgba(0,0,0,.12);
      user-select:none;
    }
    .xl-fill-handle:hover{background:#1D4ED8}
    .xl-fill-handle.active{background:#DC2626;box-shadow:0 0 0 1px rgba(220,38,38,.45), 0 1px 3px rgba(0,0,0,.2)}
    /* Destaque das células que vão receber o valor */
    .xl-fill-preview{
      outline:2px dashed #2563EB !important;
      outline-offset:-2px;
      background:rgba(37,99,235,.08) !important;
    }
    /* Células selecionadas (pra somar/média/etc.) */
    .xl-sel-cell{
      outline:2px solid #2563EB !important;
      outline-offset:-2px;
      background:rgba(37,99,235,.1) !important;
      /* indica que dá pra editar com 2 cliques */
      cursor:cell !important;
    }
    /* Orçamento Previsto: o <input> fica DENTRO de .c-prev (com padding), então
       mover o highlight pra célula e neutralizar no input deixa tudo alinhado. */
    .orc-cell > .c-prev:has(> .orc-prev-input.xl-sel-cell),
    .orc-cell > .c-prev.xl-sel-host{
      outline:2px solid #2563EB !important;
      outline-offset:-2px;
      background:rgba(37,99,235,.12) !important;
      border-radius:2px;
    }
    .orc-prev-input.xl-sel-cell{
      outline:none !important;
      background:transparent !important;
    }
    /* Igualmente: a previsão das células que vão receber o fill */
    .orc-cell > .c-prev:has(> .orc-prev-input.xl-fill-preview),
    .orc-cell > .c-prev.xl-fill-preview-host{
      outline:2px dashed #2563EB !important;
      outline-offset:-2px;
      background:rgba(37,99,235,.08) !important;
    }
    .orc-prev-input.xl-fill-preview{
      outline:none !important;
      background:transparent !important;
    }
    /* Enquanto a célula selecionada ainda não está sendo editada,
       esconde o cursor de texto ao passar o mouse pra reforçar
       o modelo "1 clique = seleciona, 2 cliques = edita" */
    input.rec-input:not(:focus),
    input.pes-sal-input:not(:focus),
    input.est-val-input:not(:focus),
    input.dispo-val-input:not(:focus),
    input.flx-inp:not(:focus),
    input.imp-val-input:not(:focus){
      cursor:cell;
    }
    /* Barra flutuante de agregação (estilo Google Sheets) */
    .xl-sel-summary{
      position:fixed; bottom:16px; right:16px;
      background:rgba(15,23,42,.95); color:#F1F5F9;
      padding:9px 16px; border-radius:999px;
      font-size:.72rem; font-weight:500;
      z-index:9998; display:none;
      box-shadow:0 8px 24px rgba(15,23,42,.25), 0 0 0 1px rgba(255,255,255,.08);
      backdrop-filter:blur(8px);
      letter-spacing:.01em; user-select:text;
    }
    .xl-sel-summary .xl-sel-lbl{color:#94A3B8;font-weight:500;margin-right:4px}
    .xl-sel-summary b{color:#F8FAFC;font-weight:700}
    .xl-sel-summary .xl-sel-sep{color:#475569;margin:0 8px;font-weight:400}
    .xl-sel-summary .xl-sel-action{display:inline-flex;align-items:center;gap:5px;
                                    background:#059669;color:#fff;border:none;
                                    padding:5px 12px;border-radius:999px;
                                    font-size:.7rem;font-weight:700;cursor:pointer;
                                    margin-left:12px;font-family:inherit;
                                    letter-spacing:.02em;transition:all .1s}
    .xl-sel-summary .xl-sel-action:hover{background:#047857;transform:translateY(-1px)}
    .xl-sel-summary .xl-sel-action:active{transform:translateY(0)}
    .xl-sel-summary .xl-sel-action.undo{background:#64748B}
    .xl-sel-summary .xl-sel-action.undo:hover{background:#475569}
    .xl-sel-summary .xl-sel-action svg{width:11px;height:11px;stroke-width:2.4}

    /* Planilha */
    .pes-sheet-wrap{background:var(--card);border-radius:var(--r);overflow:auto;
                    box-shadow:0 1px 3px rgba(0,0,0,.05),0 4px 18px rgba(0,0,0,.04);
                    max-height:72vh;position:relative}
    .pes-sheet{width:100%;border-collapse:separate;border-spacing:0;font-size:.77rem}

    /* Cabeçalho — 2 linhas (ano + mês) */
    .pes-sheet thead th{background:var(--bg);color:#94A3B8;padding:7px 8px;font-size:.64rem;
                        font-weight:700;text-transform:uppercase;letter-spacing:.05em;
                        text-align:center;position:sticky;z-index:3;white-space:nowrap;
                        border-bottom:1px solid #334155}
    .pes-sheet thead tr.yr th{top:0;background:#0F172A;color:#CBD5E1;font-size:.72rem;
                              padding:9px 8px;border-bottom:1px solid #1E293B}
    .pes-sheet thead tr.mo th{top:34px;background:#1E293B;color:#94A3B8}
    .pes-sheet thead th.stk{z-index:4;background:#0F172A}
    .pes-sheet thead tr.mo th.stk{background:#0F172A}
    .pes-sheet thead th.stk-1{left:0;min-width:220px;padding-left:14px;text-align:left}
    .pes-sheet thead th.stk-2{left:220px;min-width:54px;text-align:center}
    .pes-sheet thead th.stk-3{left:274px;min-width:156px;text-align:left}
    .pes-sheet thead th.stk-4{left:430px;min-width:120px;text-align:left;
                              border-right:2px solid #334155}
    .pes-sheet thead th.mes{min-width:94px}
    .pes-sheet thead th.mes.reaj{color:#FCD34D}
    .pes-sheet thead th.mes.reaj .rx{font-size:.58rem;color:#FBBF24;margin-left:2px}
    .pes-sheet thead th.yr-sep{border-left:2px solid #334155}
    .pes-sheet thead th.yr-tot{min-width:110px;color:#CBD5E1;background:#0F172A !important;
                                border-left:2px solid #334155;border-right:1px solid #334155}
    .pes-sheet thead th.del{min-width:52px;background:var(--bg)}

    /* Corpo */
    .pes-sheet tbody td{padding:0;border-bottom:1px solid var(--bdr);background:#fff;
                        vertical-align:middle;white-space:nowrap}
    .pes-sheet tbody tr:hover td{background:#F8FAFF}
    .pes-sheet tbody td.stk{position:sticky;background:#fff;z-index:2}
    .pes-sheet tbody tr:hover td.stk{background:#F8FAFF}
    .pes-sheet tbody td.stk-1{left:0}
    .pes-sheet tbody td.stk-2{left:220px;text-align:center;padding:0 4px}
    .pes-sheet tbody td.stk-3{left:274px}
    .pes-sheet tbody td.stk-4{left:430px;border-right:2px solid var(--bdr);
                              padding:4px 10px;text-align:left}
    .pes-sheet tbody td.pes-reaj-cell{line-height:1.15}
    .pes-sheet tbody td.pes-reaj-cell.empty{color:var(--txl);font-size:.8rem;text-align:center}
    .pes-sheet .pes-reaj-mes{font-size:.68rem;color:var(--txm);font-weight:600;letter-spacing:-0.01em}
    .pes-sheet .pes-reaj-pct{font-size:.8rem;font-weight:800;letter-spacing:-0.02em}
    .pes-sheet .pes-reaj-pct.up{color:#059669}
    .pes-sheet .pes-reaj-pct.dn{color:#DC2626}
    .pes-sheet .pes-reaj-pct.zr{color:var(--txl)}
    tr.inat .pes-reaj-mes,tr.inat .pes-reaj-pct{opacity:.85}

    /* Inputs da primeira coluna (nome) */
    .pes-first-wrap{display:flex;align-items:center;padding-right:6px}
    .pes-nome-input{flex:1;min-width:0;border:1.5px solid transparent;background:transparent;
                    padding:9px 10px 9px 4px;font-size:.8rem;font-family:inherit;color:var(--tx);
                    outline:none;box-sizing:border-box;font-weight:700;letter-spacing:-0.01em}
    .pes-nome-input:focus{border-color:var(--blue);background:#EFF6FF}
    .pes-row-indicator{display:inline-block;width:4px;height:22px;background:var(--rc,#E5E7EB);
                       border-radius:2px;flex-shrink:0;margin-left:10px;margin-right:8px;vertical-align:middle}
    /* Botão "detalhes da pessoa" (abre com duplo clique) — agora exibe
       a foto da pessoa ou as iniciais coloridas pelo tipo. */
    .pes-info-btn{display:inline-flex;align-items:center;justify-content:center;
                  width:26px;height:26px;border-radius:50%;border:1.5px solid transparent;
                  background:transparent;color:var(--txl);cursor:pointer;flex-shrink:0;
                  margin-left:6px;margin-right:2px;padding:0;transition:all .12s;
                  font-family:inherit;-webkit-user-select:none;user-select:none;
                  overflow:hidden;position:relative}
    .pes-info-btn:hover{border-color:var(--blue);box-shadow:0 0 0 2px rgba(37,99,235,.15)}
    tr.inat .pes-info-btn{opacity:.6}
    .pes-info-btn .pes-ava-img{width:100%;height:100%;object-fit:cover;display:block;border-radius:50%}
    .pes-info-btn .pes-ava-ini{width:100%;height:100%;display:flex;align-items:center;
                                justify-content:center;border-radius:50%;
                                background:var(--tc,#E5E7EB);color:var(--ttxt,#0F172A);
                                font-weight:800;font-size:.62rem;letter-spacing:-.02em;
                                font-family:inherit}
    .pes-info-btn .pes-ava-none{width:100%;height:100%;display:flex;align-items:center;
                                 justify-content:center;border-radius:50%;background:#F1F5F9;color:#94A3B8}
    .pes-info-btn .pes-ava-none svg{width:14px;height:14px;fill:currentColor;stroke:none}

    /* Ativo/Inativo switch */
    .pes-sw{appearance:none;-webkit-appearance:none;width:32px;height:18px;
            background:#CBD5E1;border-radius:10px;position:relative;cursor:pointer;
            transition:background .15s;outline:none;flex-shrink:0}
    .pes-sw:checked{background:#10B981}
    .pes-sw::after{content:'';position:absolute;top:2px;left:2px;width:14px;height:14px;
                   background:#fff;border-radius:50%;transition:transform .15s;
                   box-shadow:0 1px 2px rgba(0,0,0,.2)}
    .pes-sw:checked::after{transform:translateX(14px)}

    /* Linha inativa: apenas esmaecida (sem strikethrough) */
    .pes-sheet tbody tr.inat td.stk-1 .pes-nome-input,
    .pes-sheet tbody tr.inat td .pes-sal-input{color:#9CA3AF}
    .pes-sheet tbody tr.inat td{opacity:.55}
    .pes-sheet tbody tr.inat:hover td{opacity:.78}

    /* Tipo select */
    .pes-tipo-select{width:auto;max-width:100%;border:1px solid transparent;background:transparent;
                     padding:3px 26px 3px 20px;font-size:.7rem;font-family:inherit;
                     font-weight:700;color:var(--tx);outline:none;cursor:pointer;appearance:none;
                     -webkit-appearance:none;-moz-appearance:none;border-radius:999px;
                     background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='%239CA3AF' stroke-width='3'><polyline points='6 9 12 15 18 9'/></svg>");
                     background-repeat:no-repeat;background-position:right 8px center;
                     box-sizing:border-box;line-height:1.3;letter-spacing:.005em;
                     white-space:nowrap;text-overflow:ellipsis;overflow:hidden;
                     position:relative}
    .pes-tipo-select.empty{color:var(--txl);font-style:italic;padding-left:10px}
    /* Filled = mesmo look dos pills: fundo tingido + texto escuro na cor do tipo + dot */
    .pes-tipo-select.filled{
      background-color:color-mix(in srgb, var(--tc,#64748B) 22%, white);
      color:color-mix(in srgb, var(--tc,#64748B) 78%, black);
      border-color:color-mix(in srgb, var(--tc,#64748B) 55%, transparent);
      background-image:
        url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='%23334155' stroke-width='3'><polyline points='6 9 12 15 18 9'/></svg>"),
        radial-gradient(circle at 9px center, var(--tc,#64748B) 3px, transparent 3.5px);
      background-repeat:no-repeat, no-repeat;
      background-position:right 8px center, left center;
      padding-left:22px;
      font-weight:800
    }
    .pes-tipo-select:hover{filter:brightness(.97)}
    .pes-tipo-select:focus{box-shadow:0 0 0 3px rgba(107,114,128,.2)}
    /* Wrap do simples com botão de editar alocação */
    .pes-tipo-simples-wrap{display:flex;align-items:center;gap:4px;width:100%}
    .pes-tipo-simples-wrap .pes-tipo-select{flex:1;min-width:0}
    .pes-tipo-split-btn{flex:0 0 auto;background:#F3F4F6;border:1px solid #E5E7EB;
                        border-radius:5px;padding:3px 5px;color:#64748B;
                        cursor:pointer;display:inline-flex;align-items:center;
                        justify-content:center;transition:all .1s;font-family:inherit}
    .pes-tipo-split-btn:hover{background:#F5F3FF;border-color:#C4B5FD;color:#4C1D95}
    /* Multi-tipo (alocação split) */
    .pes-tipo-multi{display:flex;align-items:center;gap:4px;cursor:pointer;
                    padding:3px 6px;border-radius:5px;transition:background .1s}
    .pes-tipo-multi:hover{background:#F3F4F6}
    .pes-tipo-pills{display:flex;gap:3px;flex-wrap:wrap;flex:1;min-width:0}
    .pes-tipo-pill{display:inline-flex;align-items:center;gap:6px;
                   padding:3px 10px 3px 8px;border-radius:999px;font-size:.7rem;
                   font-weight:700;border:1px solid;line-height:1.3;white-space:nowrap;
                   letter-spacing:.005em;position:relative}
    .pes-tipo-pill::before{content:'';width:6px;height:6px;border-radius:50%;
                            background:currentColor;flex:0 0 auto;opacity:.9}
    .pes-tipo-pill.is-current{box-shadow:0 0 0 2px rgba(0,0,0,.08)}
    .pes-tipo-pill b{font-weight:800;font-size:.68rem;opacity:.9;
                     font-variant-numeric:tabular-nums}
    .pes-tipo-badge-mes{display:inline-flex;align-items:center;gap:2px;
                         padding:2px 6px;border-radius:10px;font-size:.58rem;
                         font-weight:700;background:#FEF3C7;color:#B45309;
                         border:1px solid #FCD34D;flex:0 0 auto}
    /* Célula split (pct < 100) */
    td.pes-cell.pes-split{background:linear-gradient(135deg,#F5F3FF 0%,#FAFAFA 100%)}
    .pes-sal-input.is-split{color:#6B7280;font-style:italic;cursor:help}

    /* Modal editor de alocação */
    .pes-aloc-modal{max-width:580px;width:94vw}
    .pes-aloc-tabs{display:flex;gap:4px;border-bottom:1.5px solid #E5E7EB;margin-bottom:14px}
    .pes-aloc-tab{background:transparent;border:none;padding:9px 14px;font-size:.82rem;
                  font-weight:700;color:#94A3B8;cursor:pointer;border-bottom:2px solid transparent;
                  font-family:inherit;margin-bottom:-1.5px;transition:all .15s}
    .pes-aloc-tab:hover{color:var(--tx)}
    .pes-aloc-tab.is-on{color:#4C1D95;border-bottom-color:#4C1D95}
    .pes-aloc-body{text-align:left;max-height:420px;overflow-y:auto;padding:4px 2px}
    .pes-aloc-row{display:flex;align-items:center;gap:8px;padding:6px 8px;
                  border:1px solid #E5E7EB;border-radius:8px;margin-bottom:6px;
                  background:#fff}
    .pes-aloc-row:hover{border-color:#C4B5FD;background:#FAFAFF}
    .pes-aloc-row select{flex:1;border:none;background:transparent;padding:4px;
                         font-size:.82rem;font-weight:600;font-family:inherit;outline:none;cursor:pointer}
    .pes-aloc-row input.pct{width:72px;padding:4px 8px;border:1.5px solid #E5E7EB;
                            border-radius:6px;font-size:.82rem;font-weight:700;
                            text-align:right;font-variant-numeric:tabular-nums;
                            font-family:inherit;outline:none}
    .pes-aloc-row input.pct:focus{border-color:#8B5CF6}
    .pes-aloc-row .pct-suf{font-size:.75rem;color:#94A3B8;font-weight:600;margin-left:-4px}
    .pes-aloc-row .del{background:transparent;border:none;color:#9CA3AF;cursor:pointer;
                       padding:3px 6px;font-size:.9rem;line-height:1;border-radius:4px}
    .pes-aloc-row .del:hover{background:#FEE2E2;color:#DC2626}
    .pes-aloc-add{display:block;width:100%;padding:7px;background:#F5F3FF;
                  border:1.5px dashed #C4B5FD;border-radius:7px;color:#4C1D95;
                  font-size:.76rem;font-weight:700;cursor:pointer;font-family:inherit;
                  margin-top:4px;transition:all .1s}
    .pes-aloc-add:hover{background:#EDE9FE;border-style:solid}
    .pes-aloc-total{display:flex;justify-content:space-between;align-items:center;
                    padding:8px 10px;margin-top:8px;border-top:1.5px dashed #E5E7EB;
                    font-size:.76rem;font-weight:700;color:var(--txm)}
    .pes-aloc-total b{font-size:1rem;font-weight:800;font-variant-numeric:tabular-nums}
    .pes-aloc-total.ok b{color:#059669}
    .pes-aloc-total.err b{color:#DC2626}
    .pes-aloc-mes{display:flex;align-items:center;gap:10px;padding:8px 10px;
                  border:1px solid #E5E7EB;border-radius:8px;margin-bottom:6px;background:#fff}
    .pes-aloc-mes:hover{border-color:#C4B5FD}
    .pes-aloc-mes-lbl{flex:0 0 80px;font-size:.82rem;font-weight:700;color:var(--tx);
                       text-transform:uppercase;letter-spacing:.02em;font-variant-numeric:tabular-nums}
    .pes-aloc-mes-status{flex:1;font-size:.72rem;color:var(--txm)}
    .pes-aloc-mes-status b{color:var(--tx);font-weight:700}
    .pes-aloc-mes-btn{background:#F5F3FF;color:#4C1D95;border:1px solid #C4B5FD;
                      padding:4px 10px;border-radius:6px;font-size:.72rem;font-weight:700;
                      cursor:pointer;font-family:inherit}
    .pes-aloc-mes-btn:hover{background:#EDE9FE}
    .pes-aloc-mes-reset{background:transparent;color:#9CA3AF;border:none;padding:4px 6px;
                        font-size:.72rem;cursor:pointer;font-family:inherit}
    .pes-aloc-mes-reset:hover{color:#DC2626}
    .pes-aloc-tie-opts{display:flex;flex-direction:column;gap:6px;margin:14px 0}
    .pes-aloc-tie-opt{display:flex;align-items:center;gap:10px;padding:10px 12px;
                       border:1.5px solid #E5E7EB;border-radius:8px;cursor:pointer;
                       transition:all .1s}
    .pes-aloc-tie-opt:hover{border-color:var(--c,#C4B5FD);background:#FAFAFF}
    .pes-aloc-tie-opt input[type=radio]{margin:0;accent-color:var(--c,#4C1D95);
                                         width:16px;height:16px}
    .pes-aloc-tie-opt:has(input:checked){border-color:var(--c,#4C1D95);
                                          background:color-mix(in srgb, var(--c,#4C1D95) 8%, white)}
    .pes-aloc-tie-dot{width:10px;height:10px;border-radius:50%;flex:0 0 auto}
    .pes-aloc-tie-nm{flex:1;font-size:.88rem;font-weight:700;color:var(--tx)}
    .pes-aloc-tie-opt b{font-size:.9rem;font-weight:800;color:var(--tx);
                         font-variant-numeric:tabular-nums}

    /* Salário (input numérico) */
    .pes-cell{position:relative}
    .pes-sal-input{width:100%;border:1.5px solid transparent;background:transparent;
                   padding:9px 10px;font-size:.78rem;font-family:'Menlo','Consolas',monospace;
                   color:var(--tx);outline:none;box-sizing:border-box;text-align:right}
    .pes-sal-input:focus{border-color:var(--blue);background:#EFF6FF;
                         box-shadow:inset 0 0 0 1px rgba(59,130,246,.12)}
    .pes-sal-input::placeholder{color:#D1D5DB}
    .pes-cell.reaj .pes-sal-input{background:#FEF9C3;color:#713F12;font-weight:700}
    .pes-cell.reaj:hover .pes-sal-input{background:#FEF08A}
    /* Pessoas — estado "pago" por célula (mesmo padrão de Impostos/Parcelamento) */
    .pes-sheet tbody td.pes-cell.pago{background:#ECFDF5;box-shadow:inset 3px 0 0 #10B981}
    .pes-sheet tbody tr:hover td.pes-cell.pago{background:#D1FAE5}
    .pes-sheet tbody td.pes-cell.pago .pes-sal-input{color:#065F46;font-weight:700}
    .pes-sheet tbody td.pes-cell.pago .pes-sal-input:hover{background:rgba(16,185,129,.12)}
    .pes-sheet tbody td.pes-cell.pago .pes-sal-input:focus{background:#fff;
      border-color:#34D399;box-shadow:inset 0 0 0 1px rgba(16,185,129,.18);color:#064E3B}
    /* Badge ✓ discreto no canto superior esquerdo da célula paga */
    .pes-sheet tbody td.pes-cell.pago::before{
      content:"✓";position:absolute;top:2px;left:5px;z-index:2;pointer-events:none;
      font-size:.55rem;font-weight:700;color:#10B981;opacity:.75;line-height:1
    }
    /* Botão compacto de pagamento — invisível por padrão, aparece no hover */
    .pes-sheet tbody td.pes-cell .pes-pagar-btn{
      position:absolute;top:3px;right:3px;width:13px;height:13px;padding:0;
      background:transparent;border:1px solid transparent;border-radius:3px;
      color:transparent;font-size:9px;line-height:1;font-weight:900;
      cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:3;
      opacity:0;pointer-events:none;font-family:inherit;
      transition:opacity .12s,transform .1s
    }
    .pes-sheet tbody td.pes-cell:hover .pes-pagar-btn{
      opacity:.85;pointer-events:auto;
      background:rgba(255,255,255,.95);border-color:#CBD5E1;color:#64748B
    }
    .pes-sheet tbody td.pes-cell.pago:hover .pes-pagar-btn{
      background:#10B981;border-color:#059669;color:#fff
    }
    .pes-sheet tbody td.pes-cell .pes-pagar-btn:hover{opacity:1 !important;transform:scale(1.12)}
    /* Esconde botão em células sem valor, em simulação (readonly) e em linha inativa */
    .pes-sheet tbody td.pes-cell.empty .pes-pagar-btn,
    .pes-sheet tbody td.pes-cell.sim .pes-pagar-btn,
    .pes-sheet tbody td.pes-cell.yr-tot .pes-pagar-btn,
    .pes-sheet tbody tr.inat td.pes-cell .pes-pagar-btn{display:none}

    /* Pessoas — KPI especial split (Pago × Projetado) */
    .pes-kpi.pes-kpi-split{border-left-color:#10B981}
    .pes-kpi-split .pes-kpi-split-row{display:flex;align-items:stretch;gap:0;margin-top:2px}
    .pes-kpi-split .pes-kpi-split-cell{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px}
    .pes-kpi-split .pes-kpi-split-cell.proj{padding-left:12px}
    .pes-kpi-split .pes-kpi-split-div{width:1px;background:var(--bdr);margin:4px 0;flex:0 0 auto}
    .pes-kpi-split .pes-kpi-split-lbl{font-size:.58rem;font-weight:700;
                      text-transform:uppercase;letter-spacing:.06em;color:var(--txm)}
    .pes-kpi-split .pes-kpi-split-val{font-size:1.05rem;font-weight:800;
                      letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.15}
    .pes-kpi-split .pes-kpi-split-cell.pago .pes-kpi-split-lbl{color:#059669}
    .pes-kpi-split .pes-kpi-split-cell.pago .pes-kpi-split-val{color:#059669}
    .pes-kpi-split .pes-kpi-split-cell.proj .pes-kpi-split-lbl{color:#DC2626}
    .pes-kpi-split .pes-kpi-split-cell.proj .pes-kpi-split-val{color:#DC2626}
    .pes-cell.yr-sep{border-left:2px solid var(--bdr)}
    .pes-cell.yr-tot{background:#EEF2FF;border-left:2px solid var(--bdr);
                     border-right:1px solid var(--bdr);padding:0 12px;text-align:right;
                     font-family:'Menlo','Consolas',monospace;font-weight:700;color:var(--blue-d);
                     font-size:.78rem}

    /* Linha de grupo (header do Tipo) */
    .pes-sheet tbody tr.grp td{background:var(--grpBg,#F3F4F6) !important;
                                padding:9px 10px;font-weight:800;color:var(--tx);
                                border-top:2px solid var(--bdr);border-bottom:1px solid var(--bdr);
                                font-size:.76rem;text-align:right;
                                font-family:'Menlo','Consolas',monospace}
    .pes-sheet tbody tr.grp td.stk{z-index:3}
    .pes-sheet tbody tr.grp td.l{text-align:left;letter-spacing:.02em;
                                  font-family:inherit;text-transform:uppercase;
                                  font-size:.72rem;color:var(--tx);letter-spacing:.06em}
    .pes-sheet tbody tr.grp td.stk-1{padding-left:14px}
    .pes-sheet tbody tr.grp td.stk-2{text-align:center;color:var(--txm);
                                      font-family:'Menlo','Consolas',monospace;
                                      font-weight:800;text-transform:none;letter-spacing:0;
                                      font-size:.82rem}
    .pes-sheet tbody tr.grp td.stk-3{color:var(--txm);font-size:.68rem;text-transform:uppercase;
                                      letter-spacing:.06em;font-family:inherit;font-weight:700}
    .pes-sheet tbody tr.grp td.yr-tot{background:var(--grpBg,#F3F4F6) !important;
                                       color:var(--blue-d);font-weight:800}

    /* Linha Folha (total geral) */
    .pes-sheet tfoot td{background:#1E293B;color:#fff;padding:10px 10px;
                        border-top:2px solid #0F172A;text-align:right;
                        font-family:'Menlo','Consolas',monospace;font-weight:800;font-size:.78rem;
                        position:sticky;bottom:0;z-index:2;white-space:nowrap}
    .pes-sheet tfoot td.stk{z-index:3;background:#0F172A}
    .pes-sheet tfoot td.l{text-align:left;font-family:inherit;letter-spacing:.05em;
                          font-size:.72rem;text-transform:uppercase;color:#CBD5E1}
    .pes-sheet tfoot td.stk-1{padding-left:14px;color:#fff}
    .pes-sheet tfoot tr.head td{background:#334155;color:#E2E8F0;font-size:.72rem;
                                 font-family:inherit;font-weight:700;border-top:1px solid #475569}
    .pes-sheet tfoot tr.head td.stk{background:#1E293B}
    .pes-sheet tfoot td.yr-tot{background:#0F172A;color:#60A5FA;font-size:.84rem}
    .pes-sheet tfoot tr.head td.yr-tot{background:#1E293B;color:#93C5FD;font-size:.72rem}
    /* Linhas de variação da folha — NÃO stick pra não "seguir" o scroll */
    .pes-sheet tfoot tr.var td{background:#273449;color:#CBD5E1;font-size:.7rem;
                               font-weight:700;border-top:1px solid #334155;
                               position:static;bottom:auto}
    .pes-sheet tfoot tr.var td.stk{background:#1E293B;color:#94A3B8;
                                    text-transform:uppercase;letter-spacing:.05em;
                                    font-family:inherit;font-size:.68rem;
                                    position:sticky;left:0}
    .pes-sheet tfoot tr.var td.yr-tot{background:#1E293B;color:#94A3B8;font-size:.7rem}
    .pes-sheet tfoot tr.var td.up{color:#6EE7B7}
    .pes-sheet tfoot tr.var td.dn{color:#FCA5A5}
    .pes-sheet tfoot tr.var td.zr{color:#64748B}

    /* ── ESTRUTURA DE CUSTOS: planilha (herda pes-sheet) ── */
    .est-sheet{min-width:1600px}
    .est-sheet thead th.mes{width:90px;min-width:90px}
    .est-sheet thead th.yr-tot{width:100px;min-width:100px}
    .est-sheet thead th.del{width:38px;min-width:38px}
    .est-sheet thead th.stk-1{width:260px;min-width:260px;max-width:260px}
    .est-sheet thead th.stk-2{left:260px;width:140px;min-width:140px;max-width:140px;text-align:left}
    .est-sheet thead th.stk-3{left:400px;width:140px;min-width:140px;max-width:140px;text-align:left}
    .est-sheet thead th.stk-4{display:none}
    .est-sheet tbody td.stk-1{left:0;width:260px;min-width:260px;max-width:260px}
    .est-sheet tbody td.stk-2{left:260px;text-align:left;padding:0 6px;
                              width:140px;min-width:140px;max-width:140px}
    .est-sheet tbody td.stk-3{left:400px;text-align:left;padding:0 6px;
                              width:140px;min-width:140px;max-width:140px;
                              border-right:2px solid var(--bdr)}
    .est-sheet tbody td.stk-4{display:none}
    .est-sheet tfoot td.stk-1{width:260px;min-width:260px;max-width:260px}
    .est-sheet tfoot td.stk-2{left:260px;width:140px;min-width:140px;max-width:140px}
    .est-sheet tfoot td.stk-3{left:400px;width:140px;min-width:140px;max-width:140px;
                              border-right:2px solid var(--bdr)}
    .est-sheet tfoot td.stk-4{display:none}
    /* Garantir que o fundo das células sticky cubra tudo (sem vazar scrolled content) */
    .est-sheet thead th.stk{background:#0F172A}
    .est-sheet tbody td.stk{background:#fff}
    .est-sheet tbody tr:hover td.stk{background:#F8FAFF}
    .est-sheet tfoot td.stk{background:#0F172A;color:#F9FAFB}

    /* Input de nome com prefixo de tag clicável */
    .est-name-wrap{display:flex;align-items:center;gap:6px;padding:0 10px;height:100%;min-height:32px}
    .est-tag-pill{display:inline-flex;align-items:center;padding:2px 8px;border-radius:10px;
                  font-size:.66rem;font-weight:800;letter-spacing:.02em;cursor:pointer;
                  background:var(--tgc,#F3F4F6);color:var(--tgtx,#374151);flex-shrink:0;
                  border:1px solid transparent;transition:all .12s;white-space:nowrap;
                  max-width:110px;overflow:hidden;text-overflow:ellipsis;
                  -webkit-user-select:none;-moz-user-select:none;user-select:none}
    .est-tag-pill:hover{filter:brightness(.95);border-color:rgba(0,0,0,.08)}
    .est-tag-pill.empty{background:#F9FAFB;color:#9CA3AF;border:1px dashed #D1D5DB;font-weight:600}
    /* Context menu custom — aparece ao clicar com botão direito na pill da tag */
    .est-tag-ctxmenu{position:fixed;z-index:100001;min-width:200px;
                      background:#fff;border-radius:8px;
                      box-shadow:0 12px 40px rgba(15,23,42,.25), 0 0 0 1px rgba(15,23,42,.08);
                      padding:5px;font-family:inherit;
                      animation:confirm-pop .12s cubic-bezier(.17,.84,.44,1)}
    .est-tag-ctxmenu .ctxhd{font-size:.62rem;font-weight:700;letter-spacing:.06em;
                              color:#9CA3AF;text-transform:uppercase;
                              padding:6px 12px 4px;display:flex;align-items:center;gap:6px}
    .est-tag-ctxmenu .ctxhd-pill{display:inline-block;padding:1px 7px;border-radius:8px;
                                   color:#fff;font-size:.62rem;font-weight:800;
                                   max-width:120px;overflow:hidden;text-overflow:ellipsis;
                                   white-space:nowrap;letter-spacing:.02em}
    .est-tag-ctxmenu button{display:flex;align-items:center;gap:8px;width:100%;
                              padding:8px 12px;background:transparent;border:none;
                              border-radius:5px;cursor:pointer;font-family:inherit;
                              font-size:.82rem;color:#1F2937;font-weight:600;
                              text-align:left;transition:background .1s}
    .est-tag-ctxmenu button:hover{background:#F3F4F6}
    .est-tag-ctxmenu button .ico{font-size:.95rem;width:18px;text-align:center;flex-shrink:0}
    .est-tag-ctxmenu .sep{height:1px;background:#F3F4F6;margin:4px 6px}
    .est-tag-ctxmenu .esc-hint{font-size:.6rem;color:#9CA3AF;
                                 padding:6px 12px 4px;border-top:1px solid #F3F4F6;
                                 margin-top:4px;text-align:right}
    .est-name-input{flex:1;border:1.5px solid transparent;background:transparent;
                    padding:5px 6px;font-size:.82rem;color:var(--tx);font-weight:600;
                    outline:none;transition:all .12s;font-family:inherit;min-width:0;border-radius:5px}
    .est-name-input:focus{border-color:var(--blue);background:#EFF6FF}
    .est-name-input::placeholder{color:#D1D5DB}

    /* Tipo dropdown (stk-3) */
    .est-tipo-sel{width:100%;border:1.5px solid transparent;background:var(--tpc,transparent);
                  color:var(--tptx,var(--tx));font-weight:700;font-size:.72rem;
                  padding:6px 8px;cursor:pointer;font-family:inherit;outline:none;
                  text-transform:uppercase;letter-spacing:.04em;border-radius:5px;
                  appearance:none;-webkit-appearance:none;
                  background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),
                                    linear-gradient(135deg,currentColor 50%,transparent 50%);
                  background-position:calc(100% - 14px) 50%, calc(100% - 9px) 50%;
                  background-size:5px 5px;background-repeat:no-repeat;padding-right:26px}
    .est-tipo-sel:focus{border-color:var(--blue)}
    .est-tipo-sel:hover{filter:brightness(.97)}
    .est-tipo-sel.empty{color:#9CA3AF;font-weight:500}

    /* Célula de valor */
    .est-val-input{width:100%;border:1.5px solid transparent;background:transparent;
                   padding:9px 10px;font-size:.78rem;color:var(--tx);text-align:right;
                   outline:none;transition:all .12s;font-family:'Menlo','Consolas',monospace;
                   box-sizing:border-box}
    .est-val-input:focus{border-color:var(--blue);background:#EFF6FF;
                         box-shadow:inset 0 0 0 1px rgba(59,130,246,.12)}
    .est-val-input::placeholder{color:#D1D5DB;font-weight:400}
    .est-sheet tbody tr:hover .est-val-input{background:#F8FAFF}
    .est-sheet tbody tr:hover .est-val-input:focus{background:#EFF6FF}

    /* Cell wrapper para pill da coluna TAG */
    .est-tag-cell{display:flex;align-items:center;justify-content:flex-start;
                  padding:0 10px;height:100%;min-height:32px}

    /* Dropdown de tags (popup) */
    .est-tag-pop{position:absolute;background:#fff;border:1px solid var(--bdr);
                 border-radius:8px;box-shadow:0 10px 30px rgba(0,0,0,.12);
                 padding:6px;min-width:240px;max-width:300px;z-index:200;
                 max-height:360px;overflow-y:auto}
    .est-tag-pop-row{display:flex;align-items:center;gap:4px;
                     border-radius:6px;transition:background .1s}
    .est-tag-pop-row:hover{background:#F3F4F6}
    .est-tag-pop-row.sel{background:#EFF6FF}
    .est-tag-pop-row.editing{background:#FEF3C7}
    .est-tag-pop-item{display:flex;align-items:center;gap:8px;padding:7px 10px;
                      border-radius:6px;cursor:pointer;font-size:.78rem;color:var(--tx);
                      transition:background .1s;border:none;background:transparent;
                      flex:1;text-align:left;font-family:inherit;min-width:0}
    .est-tag-pop-row .est-tag-pop-item{padding:7px 8px}
    .est-tag-pop-item:hover{background:transparent}
    .est-tag-pop-row.sel .est-tag-pop-item{color:var(--blue-d);font-weight:700}
    .est-tag-pop-item.new{color:var(--blue-d);font-weight:700;border-top:1px solid var(--bdr);
                          margin-top:4px;padding-top:9px;padding:9px 10px 7px 10px;width:100%}
    .est-tag-pop-item.new:hover{background:#F3F4F6}
    .est-tag-pop-dot{width:14px;height:14px;border-radius:4px;flex-shrink:0;
                     border:1px solid rgba(0,0,0,.06)}
    .est-tag-pop-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .est-tag-pop-act{display:inline-flex;align-items:center;justify-content:center;
                     width:24px;height:24px;border-radius:5px;border:none;
                     background:transparent;cursor:pointer;color:#6B7280;
                     transition:all .1s;flex-shrink:0;padding:0}
    .est-tag-pop-act:hover{background:#fff;color:var(--tx);box-shadow:0 1px 2px rgba(0,0,0,.08)}
    .est-tag-pop-act.del:hover{color:#DC2626;background:#FEF2F2}
    .est-tag-pop-act:disabled{opacity:.4;cursor:not-allowed}
    .est-tag-pop-act:disabled:hover{background:transparent;box-shadow:none}
    .est-tag-pop-act svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:2;
                         stroke-linecap:round;stroke-linejoin:round}
    .est-tag-pop-row-edit{display:flex;align-items:center;gap:6px;padding:6px 8px;width:100%}
    .est-tag-pop-swatch{width:18px;height:18px;border-radius:4px;cursor:pointer;flex-shrink:0;
                        border:1px solid rgba(0,0,0,.1);position:relative}
    .est-tag-pop-edit-input{flex:1;min-width:0;border:1px solid var(--bdr);background:#fff;
                            border-radius:5px;padding:5px 8px;font-size:.78rem;
                            font-family:inherit;color:var(--tx);outline:none}
    .est-tag-pop-edit-input:focus{border-color:var(--blue);box-shadow:0 0 0 2px rgba(59,130,246,.12)}
    .est-tag-pop-swatch-grid{position:absolute;top:26px;left:0;background:#fff;
                             border:1px solid var(--bdr);border-radius:8px;
                             box-shadow:0 10px 30px rgba(0,0,0,.15);padding:8px;
                             display:grid;grid-template-columns:repeat(6,18px);gap:5px;z-index:210}
    .est-tag-pop-swatch-opt{width:18px;height:18px;border-radius:4px;cursor:pointer;
                            border:1px solid rgba(0,0,0,.08)}
    .est-tag-pop-swatch-opt:hover{transform:scale(1.15)}
    .est-tag-pop-none{padding:6px 10px;font-size:.72rem;color:var(--txm)}
    .est-tag-pop-usage{font-size:.65rem;color:#9CA3AF;padding:0 4px;flex-shrink:0}

    /* Manager modals (tags/tipos) */
    .est-mgr-list{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
    .est-mgr-item{display:grid;grid-template-columns:36px 1fr auto auto;gap:10px;
                  align-items:center;padding:8px 12px;background:#F9FAFB;
                  border:1px solid var(--bdr);border-radius:7px}
    .est-mgr-swatch{width:26px;height:26px;border-radius:6px;cursor:pointer;
                    border:1px solid rgba(0,0,0,.1);position:relative}
    .est-mgr-swatch-pop{position:absolute;top:32px;left:0;background:#fff;
                        border:1px solid var(--bdr);border-radius:8px;padding:8px;
                        box-shadow:0 10px 30px rgba(0,0,0,.12);z-index:10;
                        display:grid;grid-template-columns:repeat(6,24px);gap:6px}
    .est-mgr-swatch-sw{width:24px;height:24px;border-radius:5px;cursor:pointer;
                        border:1px solid rgba(0,0,0,.1);transition:transform .1s}
    .est-mgr-swatch-sw:hover{transform:scale(1.15)}
    .est-mgr-nome-input{border:1px solid var(--bdr);border-radius:6px;padding:6px 9px;
                         font-size:.82rem;font-family:inherit;outline:none;
                         transition:border-color .12s;min-width:0}
    .est-mgr-nome-input:focus{border-color:var(--blue)}
    .est-mgr-uses{font-size:.7rem;color:var(--txm);white-space:nowrap}
    .est-mgr-del{background:none;border:none;cursor:pointer;color:#9CA3AF;
                 padding:5px 7px;border-radius:5px;font-size:1rem}
    .est-mgr-del:hover{color:#DC2626;background:#FEE2E2}
    .est-mgr-del:disabled{opacity:.3;cursor:not-allowed}
    .est-mgr-add{display:flex;gap:8px;align-items:center;padding:10px 0 4px;
                  border-top:1px dashed var(--bdr);margin-top:6px}
    .est-mgr-add button{background:var(--blue);color:#fff;border:none;border-radius:6px;
                         padding:7px 14px;font-size:.78rem;font-weight:700;cursor:pointer;
                         font-family:inherit}
    .est-mgr-add button:hover{background:var(--blue-d)}

    /* Row accent: cor da linha reflete o Tipo */
    .est-sheet tbody tr.est-row{position:relative}
    .est-sheet tbody tr.est-row td.stk-3{background:linear-gradient(90deg,
                                         #fff 0%, var(--trc,#fff) 100%)}
    .est-sheet tbody tr.est-row:hover td.stk-3{background:linear-gradient(90deg,
                                         #F8FAFF 0%, var(--trc,#F8FAFF) 100%)}
    .est-sheet tbody tr.est-row.has-tipo td.stk-1::before{content:'';position:absolute;
                                         left:0;top:0;bottom:0;width:3px;background:var(--trc,transparent)}

    /* Row empty state */
    .est-empty-row td{text-align:center;padding:40px 20px !important;color:var(--txl);
                      font-size:.84rem;background:#fff !important}

    /* ── Workspace de Tag (modal CRUD focado em uma tag) ── */
    .est-tag-ws-modal{background:#fff;border-radius:14px;max-width:1100px;width:96vw;
                       max-height:90vh;overflow:auto;
                       box-shadow:0 20px 60px rgba(0,0,0,.4);
                       animation:confirm-pop .18s cubic-bezier(.17,.84,.44,1);
                       font-family:inherit}
    .est-tag-ws-hd{display:flex;align-items:flex-start;justify-content:space-between;
                    gap:14px;padding:14px 20px;border-bottom:1px solid #E5E7EB;
                    position:sticky;top:0;background:#fff;z-index:5}
    .est-tag-ws-eyebrow{font-size:.62rem;font-weight:700;letter-spacing:.08em;
                         color:#9CA3AF;text-transform:uppercase;margin-bottom:4px}
    .est-tag-ws-hd h3{margin:0;font-size:1rem;display:flex;align-items:center;
                       gap:8px;flex-wrap:wrap}
    .est-tag-ws-pill{display:inline-block;padding:4px 14px;border-radius:999px;
                      color:#fff;font-weight:800;font-size:.85rem;letter-spacing:.02em;
                      text-shadow:0 1px 1px rgba(0,0,0,.15)}
    .est-tag-ws-close{background:transparent;border:none;color:#9CA3AF;
                       font-size:1.3rem;cursor:pointer;padding:4px 12px;
                       border-radius:8px;font-family:inherit;line-height:1}
    .est-tag-ws-close:hover{background:#F3F4F6;color:#111}
    .est-tag-ws-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;
                      padding:12px 20px;background:#F9FAFB}
    .est-tag-ws-kpi{background:#fff;border-radius:8px;padding:10px 14px;
                     border:1px solid #E5E7EB;border-left:4px solid #C4B5FD}
