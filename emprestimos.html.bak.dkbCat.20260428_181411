function _cartOpenAnexoFromLanc(lancId){
  const l = (cartoes && Array.isArray(cartoes.lancamentos)) ? cartoes.lancamentos.find(x => x.id === lancId) : null;
  if(!l){ return; }
  // Se essa parcela não tem anexo, busca na "raiz" da série de parcelas
  let anexo = l.anexo;
  if(!anexo && l.parcela && l.parcela.parentId){
    const root = cartoes.lancamentos.find(x => x.parcela && x.parcela.parentId === l.parcela.parentId && x.parcela.atual === 1);
    if(root) anexo = root.anexo;
  }
  _cartOpenAnexo(anexo);
}
