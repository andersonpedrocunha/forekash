    pessoaId: 0, // cópia começa sem vínculo (precisa de nome único)
    nome: '',
    ativo: src.ativo,
    tipoId: src.tipoId,
    sim: src.sim,
    salarios: JSON.parse(JSON.stringify(src.salarios || {}))
  };
