}

// Ao pressionar o handle, marca o <tr> ancestral como draggable.
function rowHandleDown(ev){
  const tr = ev.currentTarget && ev.currentTarget.closest('tr');
  if(tr){ tr.draggable = true; tr.classList.add('row-drag-hover'); }
}

function rowHandleUp(ev){
  const tr = ev.currentTarget && ev.currentTarget.closest('tr');
  if(tr){ tr.draggable = false; tr.classList.remove('row-drag-hover'); }
}

let _rowReorderCtx = null;

function rowDragStart(ev){
  const tr = ev.currentTarget;
  if(!tr || !tr.dataset || !tr.dataset.reorderMod){ ev.preventDefault(); return; }
  _rowReorderCtx = {
    mod: tr.dataset.reorderMod,
    id:  tr.dataset.reorderId,
    grp: tr.dataset.reorderGrp || '',
    ativo: tr.dataset.reorderAtivo !== 'false',
    tr
  };
  try{
    ev.dataTransfer.effectAllowed = 'move';
    ev.dataTransfer.setData('text/plain', String(tr.dataset.reorderId));
  }catch(_){}
  tr.classList.add('row-dragging');
}

function rowClearDropHints(){
  document.querySelectorAll('tr.row-drop-above, tr.row-drop-below').forEach(el => {
    el.classList.remove('row-drop-above');
    el.classList.remove('row-drop-below');
  });
