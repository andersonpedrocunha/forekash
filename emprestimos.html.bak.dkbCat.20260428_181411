// Resume widget chamando seu próprio render() e extraindo texto/valores reais
function _anaWidgetSummary(widget){
  const def = (typeof ANA_WIDGETS === 'object') && ANA_WIDGETS[widget.widget];
  if(!def) return '[ ' + (widget.widget || 'Widget') + ' ]';
  if(widget.widget === 'text') return null;
  const label = def.label || widget.widget;
  // Tenta render real pra capturar valores
  try {
    if(typeof def.render === 'function' && typeof _anaCollectFacts === 'function'){
      const facts = _anaCollectFacts();
      const k = _anaCalcKPIs(facts);
      const x = _anaCalcIndicadoresExtra(k, facts);
      const tmp = document.createElement('div');
      tmp.style.cssText = 'position:fixed;left:-99999px;top:0;width:300px;height:200px;visibility:hidden';
      document.body.appendChild(tmp);
      let extracted = '';
      try {
        def.render(tmp, { k:k, x:x, item:widget, uid:widget.id || 0 });
        // Extrai texto, separando blocos visuais com ' · '
        const blocks = [];
        tmp.querySelectorAll('h1,h2,h3,h4,strong,b,div,span,p').forEach(el => {
          // Só pega elementos folha (sem filhos com texto próprio)
          if(el.children.length === 0){
            const t = (el.textContent || '').trim();
            if(t && t.length < 80) blocks.push(t);
          }
        });
        // Remove duplicatas consecutivas
        const seen = new Set();
        extracted = blocks.filter(b => { if(seen.has(b)) return false; seen.add(b); return true; }).join(' · ');
        if(!extracted) extracted = (tmp.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 120);
      } finally {
        document.body.removeChild(tmp);
      }
      if(extracted) return label + ' — ' + extracted;
    }
  } catch(e){ console.warn('widget summary failed', widget.widget, e); }
  return '[ ' + label + ' ]';
}

