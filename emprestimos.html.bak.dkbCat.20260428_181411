  s = s.replace(/\[ref:([^\]\[]+)\]/g, function(_, id){
    try{
      const el = document.querySelector('[data-cellref="'+id.replace(/"/g,'\\"')+'"]');
      if(!el) return '0';
      const v = (el.value||'').toString().trim();
      if(!v) return '0';
      if(v.startsWith('=')){
        const r = evalSimpleFormula(v);
        return r.ok ? fmtBR(r.value, 2) : '0';
