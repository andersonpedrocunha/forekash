        <button type="button" class="reg-add-modal-ok" onclick="_regAddLancamentoConfirm()">Adicionar</button>
      </div>
    </div>
  `;
  document.body.appendChild(ov);
  ov.addEventListener('click', e => { if(e.target === ov) closeAddLancamentoModal(); });
