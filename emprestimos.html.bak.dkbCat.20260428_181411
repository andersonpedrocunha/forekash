// Alterna o modo da base de cálculo dos impostos (auto ↔ manual).
// Ao trocar p/ manual, se ainda não houver valores salvos para este ano,
// semeia com os valores atuais da Receita — o usuário edita a partir daí.
function setImpBaseMode(modo){
  const novo = (modo === 'manual') ? 'manual' : 'auto';
  if(novo === 'manual' && impostos.baseMode !== 'manual'){
    const year = impActiveYearCor;
    if(!impostos.baseManual) impostos.baseManual = {};
    let temAlgum = false;
    for(let m=0;m<12;m++){
      if(impostos.baseManual[impMesKey(year,m)] != null){ temAlgum = true; break; }
    }
    if(!temAlgum){
      // Semeia com a receita atual — se a aba Receita tiver dados, servem de ponto de partida
      for(let m=0;m<12;m++){
        let v = 0;
        try{ if(typeof flxReceitaMes === 'function') v = +flxReceitaMes(year, m) || 0; }catch(e){}
        if(v > 0) impostos.baseManual[impMesKey(year,m)] = v;
      }
    }
  }
  impostos.baseMode = novo;
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

// Salva um valor manual da base de cálculo para (ano, mês).
// Valor vazio ou zero remove a entrada (volta a mostrar em branco).
function setImpBaseValor(year, mIdx, val){
  const key = impMesKey(year, mIdx);
  const n = parseBR(val);
  if(!impostos.baseManual) impostos.baseManual = {};
  if(!n || isNaN(n)) delete impostos.baseManual[key];
  else impostos.baseManual[key] = n;
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

// Alíquota Única: percentual plano aplicado sobre a base do mês anterior (competência).
// Valor válido entre 0 e 100. O input só é exibido quando a linha está ativa
// (aliquotaUnicaAtiva = true), então a ativação acontece via chip com confirmação.
function setImpAliquotaUnica(val){
  const n = parseBR(val);
  if(isNaN(n) || n < 0) return;
  impostos.aliquotaUnica = Math.min(100, n);
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

// Liga/desliga a linha Alíquota Única.
//   • Ao ATIVAR: todas as demais rubricas são zeradas e desconsideradas
//     (fica um modo "exclusivo" de estimativa por percentual plano).
//   • Ao DESATIVAR: se houver % > 0 preenchido, não permite — pede pra zerar
//     o percentual primeiro (protege contra esconder uma carga ativa sem querer).
async function toggleImpAliquotaUnica(){
  const aliqUnica = +impostos.aliquotaUnica || 0;

  // ——— Tentativa de OCULTAR ———
  if(impostos.aliquotaUnicaAtiva){
    if(aliqUnica > 0){
      await askConfirm({
        title: 'Zere o percentual antes',
        message: 'A Alíquota Única está com um % maior que zero. Para ocultar a linha, primeiro zere o percentual no campo.',
        sub: 'Evita esconder sem querer uma carga que está somando no Total de Impostos.',
        variant: 'warn',
        confirmLabel: 'Entendi',
        cancelLabel: ''
      });
      return;
    }
    impostos.aliquotaUnicaAtiva = false;
    impSave();
    renderImpCorSheet();
    updateImpCorKpis();
    return;
  }

  // ——— Tentativa de ADICIONAR ———
  const hasValues = (impostos.correntes || []).some(c =>
    c && c.valores && Object.values(c.valores).some(v => (+v) !== 0)
  );

  if(hasValues){
    const ok = await askConfirm({
      title: 'Adicionar Alíquota Única',
      message: 'Ao ativar, todas as outras rubricas terão seus valores zerados e serão desconsideradas do Total de Impostos.',
      sub: 'Use quando quiser estimar toda a carga tributária por um único percentual plano sobre a receita do mês anterior (competência).',
      variant: 'warn',
      confirmLabel: 'Ativar e zerar rubricas',
      cancelLabel: 'Cancelar'
    });
    if(!ok) return;
    // Zera valores de TODAS as rubricas, em TODOS os anos (coerente com o flag global).
    for(const c of impostos.correntes){ if(c) c.valores = {}; }
  } else {
    await askConfirm({
      title: 'Alíquota Única ativada',
      message: 'A partir de agora, toda a carga tributária é estimada por um percentual plano sobre a receita do mês anterior (competência).',
      sub: 'Digite o percentual na própria linha. Outras rubricas ficam desconsideradas enquanto a Alíquota Única estiver ativa.',
      variant: 'info',
      confirmLabel: 'Entendi',
      cancelLabel: ''
    });
  }

  impostos.aliquotaUnicaAtiva = true;
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

// Preenche a planilha de Correntes com os valores de previsão sugeridos pelo
// regime atual — só escreve em células que o usuário ainda não digitou.
async function fillImpForecastValues(){
  const regime = impostos.regimeTributario;
  if(!regime){
    await askConfirm({
      title: 'Escolha um regime tributário',
      message: 'Antes de preencher com a previsão, selecione um regime (Simples, Presumido, Real, MEI ou Personalizado).',
      variant: 'info',
      confirmLabel: 'Entendi',
      cancelLabel: ''
    });
    return;
  }
  const year = impActiveYearCor;
  // Soma total previsto e quantidade de células que serão preenchidas
  let candidatas = 0;
  let somaTotal = 0;
  for(const c of impostos.correntes){
    for(let m = 0; m < 12; m++){
      const key = impMesKey(year, m);
      const atual = c.valores[key];
      if(atual !== undefined && atual !== null && atual !== 0) continue;
      const prev = impForecastValor(c.rubricaId, year, m);
      if(prev != null && prev > 0.005){
        candidatas++;
        somaTotal += prev;
      }
    }
  }
  if(candidatas === 0){
    await askConfirm({
      title: 'Nada a preencher',
      message: `Não há previsões pendentes em ${year}. Todas as células com forecast já têm valor — ou não há receita cadastrada na aba Receita para gerar a previsão.`,
      variant: 'info',
      confirmLabel: 'Entendi',
      cancelLabel: ''
    });
    return;
  }
  const regimeNome = (IMP_REGIMES[regime] && IMP_REGIMES[regime].label) || regime;
  const cellLabel = (candidatas === 1) ? '1 célula' : `${candidatas} células`;
  const totalBRL  = fmtBRL(somaTotal);
  const ok = await askConfirm({
    title: 'Preencher com a previsão',
    message: `Vou preencher ${cellLabel} de ${year} com os valores previstos pelo regime ${regimeNome} — somando ${totalBRL} no total.`,
    sub: 'Apenas células vazias são preenchidas. Valores que você já digitou ficam intactos.',
    variant: 'ok',
    confirmLabel: 'Preencher',
    cancelLabel: 'Cancelar'
  });
  if(!ok) return;

  let preenchidas = 0;
  for(const c of impostos.correntes){
    for(let m = 0; m < 12; m++){
      const key = impMesKey(year, m);
      const atual = c.valores[key];
      if(atual !== undefined && atual !== null && atual !== 0) continue;
      const prev = impForecastValor(c.rubricaId, year, m);
      if(prev != null && prev > 0.005){
        c.valores[key] = +prev.toFixed(2);
        preenchidas++;
      }
    }
  }
  impSave();
  renderImpCorSheet();
  updateImpCorKpis();
}

// Renderiza a barra de controle do regime tributário (seletores + alíquotas contextuais)
