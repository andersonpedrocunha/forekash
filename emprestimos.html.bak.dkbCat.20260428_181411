  const el = _anaFocusedEditable();
  if(!el) return;
  const s = _anaSlideCurrent();
  if(!s) return;
  if(_anaEditTarget === 'title')         s.title    = el.innerHTML;
  else if(_anaEditTarget === 'subtitle') s.subtitle = el.innerHTML;
  else if(_anaEditTarget === 'narrative'){
    const uid = parseInt(el.getAttribute('data-text-uid'), 10);
    if(isFinite(uid)){
      const w = (s.widgets || []).find(w => w.id === uid);
      if(w) w.text = el.innerHTML;
