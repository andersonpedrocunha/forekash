// Só dígitos — usado para saneamento de CNPJ/CPF antes de lookup/validação.
function onlyDigits(s){ return (s||'').replace(/\D+/g, ''); }

// Formata CNPJ "00000000000000" → "00.000.000/0000-00"
function fmtCNPJ(s){
  const d = onlyDigits(s);
  if(d.length !== 14) return s || '';
  return `${d.slice(0,2)}.${d.slice(2,5)}.${d.slice(5,8)}/${d.slice(8,12)}-${d.slice(12,14)}`;
}

// Formata CPF "00000000000" → "000.000.000-00"
function fmtCPF(s){
  const d = onlyDigits(s);
  if(d.length !== 11) return s || '';
  return `${d.slice(0,3)}.${d.slice(3,6)}.${d.slice(6,9)}-${d.slice(9,11)}`;
}

// Valida CPF brasileiro por checksum — 11 dígitos, não todos iguais, DVs corretos.
// Referência: fórmula oficial da Receita (mod 11 sobre os 9 primeiros e 10 primeiros dígitos).
function isValidCPF(s){
  const d = onlyDigits(s);
  if(d.length !== 11) return false;
  if(/^(\d)\1{10}$/.test(d)) return false; // 000.000.000-00, 111.111.111-11, …
  let sum = 0;
  for(let i = 0; i < 9; i++) sum += parseInt(d[i], 10) * (10 - i);
  let r1 = (sum * 10) % 11;
  if(r1 === 10) r1 = 0;
  if(r1 !== parseInt(d[9], 10)) return false;
  sum = 0;
  for(let i = 0; i < 10; i++) sum += parseInt(d[i], 10) * (11 - i);
  let r2 = (sum * 10) % 11;
  if(r2 === 10) r2 = 0;
  return r2 === parseInt(d[10], 10);
}

// ─── Lookup de razão social pelo CNPJ (BrasilAPI) ───
// Cache simples em memória: evita chamar a API duas vezes seguidas.
const _cnpjCache = {};
// Estado reativo por cliente enquanto a chamada está em curso.
const _cnpjLookupState = {}; // {cid: 'loading'|'ok'|'err'|null}

async function lookupCNPJ(cid, opts){
  opts = opts || {};
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;
  const cnpjDigits = onlyDigits(c.cnpj || '');
  if(cnpjDigits.length !== 14){
    if(opts.manual){
      await askConfirm({
        title: 'CNPJ inválido',
        message: 'Informe um CNPJ com 14 dígitos para buscar a razão social.',
        variant: 'warn', confirmLabel: 'Entendi', cancelLabel: ''
      });
    }
    return;
  }
  // Preenchimento automático só roda se a razão estiver vazia — para não
  // sobrescrever o que o usuário já digitou. No modo manual, sempre roda.
  if(!opts.manual && (c.razaoSocial || '').trim()) return;

  _cnpjLookupState[cid] = 'loading';
  if(clidetCtx && clidetCtx.cid === cid) renderClidet();

  try{
    let dados = _cnpjCache[cnpjDigits];
    if(!dados){
      const url = `https://brasilapi.com.br/api/cnpj/v1/${cnpjDigits}`;
      const resp = await fetch(url, {method:'GET'});
      if(!resp.ok){
        if(resp.status === 404) throw new Error('CNPJ não encontrado na Receita Federal.');
        throw new Error(`Falha ao consultar (HTTP ${resp.status}).`);
      }
      dados = await resp.json();
      _cnpjCache[cnpjDigits] = dados;
    }
    const razao = (dados && (dados.razao_social || dados.nome || '')).trim();
    if(!razao){
      throw new Error('Razão social não disponível para este CNPJ.');
    }
    c.razaoSocial = razao;
    c.cnpj = fmtCNPJ(cnpjDigits);
    _cnpjLookupState[cid] = 'ok';
    receitaSave();
    if(clidetCtx && clidetCtx.cid === cid) renderClidet();
    // Limpa o estado "ok" após 2s (deixa o ícone verde piscar)
    setTimeout(() => {
      if(_cnpjLookupState[cid] === 'ok'){
        _cnpjLookupState[cid] = null;
        if(clidetCtx && clidetCtx.cid === cid) renderClidet();
      }
    }, 2000);
  }catch(e){
    _cnpjLookupState[cid] = 'err';
    if(clidetCtx && clidetCtx.cid === cid) renderClidet();
    if(opts.manual){
      await askConfirm({
        title: 'Não foi possível buscar',
        message: e.message || 'Erro ao consultar a BrasilAPI.',
        variant: 'warn', confirmLabel: 'Fechar', cancelLabel: ''
      });
    }
  }
}

// Handler do blur do campo CNPJ: formata e dispara lookup automático se vazio.
function onCNPJBlur(cid, el){
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;
  const v = el.value;
  const d = onlyDigits(v);
  const formatted = d.length === 14 ? fmtCNPJ(d) : v;
  if(c.cnpj !== formatted){
    c.cnpj = formatted;
    receitaSave();
    if(clidetCtx && clidetCtx.cid === cid) renderClidet();
  }
  if(c.tipoPessoa === 'pj' && d.length === 14){
    // Auto-lookup em BR + PJ, apenas se razão social estiver vazia.
    lookupCNPJ(cid, {manual:false});
  }
}

// Handler do blur do campo CPF: apenas formata para exibição.
function onCPFBlur(cid, el){
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;
  const v = el.value;
  const d = onlyDigits(v);
  const formatted = d.length === 11 ? fmtCPF(d) : v;
  if(c.cnpj !== formatted){
    c.cnpj = formatted;
    receitaSave();
    if(clidetCtx && clidetCtx.cid === cid) renderClidet();
  }
}

// Helper: formata "YYYY-MM-DD" → "DD/MM/YYYY". Fallback: retorna o próprio valor.
function fmtDateBR(iso){
  if(!iso || typeof iso !== 'string') return '';
  const [y,m,d] = iso.split('-');
  if(!y || !m || !d) return iso;
  return `${d}/${m}/${y}`;
}

