function _viagEnsureTimestamps(){
  let changed = false;
  for(const v of viagens.itens){
    if(!v.criadoEm){
      v.criadoEm = v.dataInicio ? new Date(v.dataInicio + 'T00:00:00').toISOString() : new Date().toISOString();
      changed = true;
    }
    // Se já está fechada mas sem fechadoEm, infere da data de aprovação/rejeição
    if(_viagIsClosed(v) && !v.fechadoEm){
      if(v.aprovacao && v.aprovacao.data) v.fechadoEm = v.aprovacao.data;
      else if(v.rejeicao && v.rejeicao.data) v.fechadoEm = v.rejeicao.data;
      else v.fechadoEm = new Date().toISOString();
      changed = true;
    }
    // Se foi reaberta (não está mais em status fechado), limpa
    if(!_viagIsClosed(v) && v.fechadoEm){
      delete v.fechadoEm;
      changed = true;
    }
  }
  if(changed) viagSave();
}
