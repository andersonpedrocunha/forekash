// ───── Sheet ─────
function renderOrcSheet(){
  const thead = document.getElementById('orc-thead');
  const tbody = document.getElementById('orc-tbody');
  const sh = document.getElementById('orc-sheet');
  if(!thead || !tbody || !sh) return;
  sh.classList.toggle('mode-previsto',    orcMode === 'previsto');
  sh.classList.toggle('mode-comparativo', orcMode === 'comparativo');

  // Header
  const y = orcActiveYear;
  const mesesTh = [];
  for(let m=0;m<12;m++){
    const nome = ORC_MESES[m];
    mesesTh.push(
      '<th class="mes"><div class="orc-mes-hdr">'+
        '<div class="orc-mes-nome">'+nome+'/'+y.slice(-2)+'</div>'+
        '<div class="orc-mes-cols"><span class="c-prev">Prev</span><span class="c-real">Real</span><span class="c-des">Δ</span></div>'+
      '</div></th>'
    );
  }
  const yrTotTh =
    '<th class="yr-tot"><div class="orc-mes-hdr">'+
      '<div class="orc-mes-nome">Total '+y+'</div>'+
      '<div class="orc-mes-cols"><span class="c-prev">Prev</span><span class="c-real">Real</span><span class="c-des">Δ</span></div>'+
    '</div></th>';
  thead.innerHTML =
    '<tr class="mo">'+
      '<th class="stk stk-1">Linha</th>'+
      mesesTh.join('') +
      yrTotTh +
    '</tr>';

  // Body
  const rows = [];
  // (1) Receita
  rows.push(orcSheetRow('receita'));
  if(orcExpanded.has('receita')) rows.push(...orcSheetChildRows('receita'));
  // (2) Custos — subcategorias
  for(const c of ORC_CUSTO_IDS){
    rows.push(orcSheetRow(c));
    if(orcExpanded.has(c)) rows.push(...orcSheetChildRows(c));
  }
  // (3) Resultado
  rows.push(orcSheetResultRow());
  tbody.innerHTML = rows.join('');

  // Helper: move focus para input vizinho pela matriz (cat,m)
  const orcInputs = () => Array.from(tbody.querySelectorAll('input[data-orc-cat]'));
  const orcFocusCell = (catId, mIdx) => {
    const all = orcInputs();
    const tgt = all.find(x => x.getAttribute('data-orc-cat') === catId &&
                              parseInt(x.getAttribute('data-orc-m')) === mIdx);
    if(tgt){ tgt.focus(); tgt.select(); return true; }
    return false;
  };
  const orcFocusDelta = (from, dr, dc) => {
    const all = orcInputs();
    // Lista distinta de categorias (ordem das linhas) e preserva mês
    const cats = [];
    const seen = new Set();
    for(const inp of all){
      const c = inp.getAttribute('data-orc-cat');
      if(!seen.has(c)){ seen.add(c); cats.push(c); }
    }
    const cat = from.getAttribute('data-orc-cat');
    const m   = parseInt(from.getAttribute('data-orc-m'));
    const rIdx = cats.indexOf(cat);
    if(rIdx < 0) return false;
    let nr = rIdx + dr, nc = m + dc;
    if(nc < 0){ nc = 11; nr--; }
    if(nc > 11){ nc = 0; nr++; }
    if(nr < 0 || nr >= cats.length) return false;
    return orcFocusCell(cats[nr], nc);
  };

  // Ativa binding dos inputs previsto
  orcInputs().forEach(inp => {
    inp.addEventListener('focus', e => { e.target.parentElement.classList.add('edit'); e.target.select(); });
    inp.addEventListener('blur', e => {
      e.target.parentElement.classList.remove('edit');
      const cat = e.target.getAttribute('data-orc-cat');
      const m   = parseInt(e.target.getAttribute('data-orc-m'));
      const raw = e.target.value.trim();
      const n   = (raw === '') ? '' : parseBR(raw);
      orcSetPrev(cat, orcActiveYear, m, (n === '' ? '' : n));
      e.target.value = (n === '' ? '' : fmtBR(n));
      renderOrcSheet();
      updateOrcKpis();
    });
    inp.addEventListener('keydown', e => {
      const tgt = e.target;
      if(e.key === 'Enter'){
        e.preventDefault();
        // Salva e move pra linha de baixo
        const cat = tgt.getAttribute('data-orc-cat');
        const m   = parseInt(tgt.getAttribute('data-orc-m'));
        tgt.blur();
        // Re-render apagou os inputs — precisa buscar de novo após microtask
        setTimeout(()=>{
          const all = Array.from(tbody.querySelectorAll('input[data-orc-cat]'));
          const cats = [];
          const seen = new Set();
          for(const x of all){
            const c = x.getAttribute('data-orc-cat');
            if(!seen.has(c)){ seen.add(c); cats.push(c); }
          }
          const i = cats.indexOf(cat);
          if(i >= 0 && i+1 < cats.length){
            const nxt = all.find(x => x.getAttribute('data-orc-cat') === cats[i+1] &&
                                       parseInt(x.getAttribute('data-orc-m')) === m);
            if(nxt){ nxt.focus(); nxt.select(); }
          }
        }, 0);
      }
      else if(e.key === 'Escape'){
        tgt.blur();
      }
      else if(e.key === 'ArrowDown' && !e.shiftKey){
        e.preventDefault();
        orcFocusDelta(tgt, 1, 0);
      }
      else if(e.key === 'ArrowUp' && !e.shiftKey){
        e.preventDefault();
        orcFocusDelta(tgt, -1, 0);
      }
      else if(e.key === 'ArrowLeft' && (tgt.selectionStart === 0 && tgt.selectionEnd === 0)){
        e.preventDefault();
        orcFocusDelta(tgt, 0, -1);
      }
      else if(e.key === 'ArrowRight' && (tgt.selectionStart === tgt.value.length && tgt.selectionEnd === tgt.value.length)){
        e.preventDefault();
        orcFocusDelta(tgt, 0, 1);
      }
      else if(e.key === 'Tab'){
        // Deixar comportamento padrão (tab navega pela ordem dos inputs no DOM)
      }
    });
  });
}

function orcSheetRow(catId){
  const cat = ORC_CAT_BY_ID[catId];
  const y = orcActiveYear;
  const cols = [];
  let totPrev = 0, totReal = 0;
  let hasReal = false;
  for(let m=0;m<12;m++){
    const prev = orcPrevMes(catId, y, m);
    const real = orcRealMes(catId, y, m);
    const fechado = orcMesFechado(y, m);
    totPrev += prev;
    if(fechado){ totReal += real; hasReal = true; }
    cols.push('<td>'+orcCellHTML(catId, m, prev, real, fechado)+'</td>');
  }
  // YTD column (soma total do ano)
  const anoPrev = orcPrevAno(catId, y);
  const anoReal = orcRealAno(catId, y);
  cols.push('<td class="yr-tot">'+orcCellHTMLTotal(anoPrev, anoReal, true)+'</td>');

  const ico = '<span class="orc-cat-ico" style="background:'+cat.color+'">'+
              '<svg viewBox="0 0 24 24">'+cat.svg+'</svg></span>';
  const hasChildren = (catId !== 'impostos') && (orcChildren(catId, orcActiveYear).length > 0);
  const expanded = orcExpanded.has(catId);
  const expandBtn = hasChildren
    ? '<button class="orc-expand'+(expanded?' open':'')+'" onclick="orcToggleExpand(\''+catId+'\')" title="'+(expanded?'Recolher':'Expandir')+'">'+
      '<svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>'
    : '<span class="orc-expand placeholder" aria-hidden="true"></span>';
  const recCls = (catId === 'receita') ? ' orc-rec' : '';
  const expCls = expanded ? ' expanded' : '';
  return '<tr class="'+recCls.trim()+expCls+'"><td class="stk stk-1">'+expandBtn+ico+esc(cat.nome)+'</td>'+cols.join('')+'</tr>';
}

function orcSheetChildRows(catId){
  const y = orcActiveYear;
  const children = orcChildren(catId, y);
  const out = [];
  for(const ch of children){
    const cols = [];
    let anoReal = 0;
    for(let m=0;m<12;m++){
      const real = ch.real(m);
      const fechado = orcMesFechado(y, m);
      if(fechado) anoReal += real;
      const realDisp = fechado ? fmtBR(real||0) : '—';
      const realCls  = fechado ? 'c-real' : 'c-real empty';
      cols.push('<td><div class="orc-cell child">'+
                  '<div class="c-prev c-disabled" title="Previsto é por categoria (não por item)">—</div>'+
                  '<div class="'+realCls+'">'+realDisp+'</div>'+
                  '<div class="c-des neutral">—</div>'+
                '</div></td>');
    }
    cols.push('<td class="yr-tot"><div class="orc-cell child">'+
                '<div class="c-prev c-disabled">—</div>'+
                '<div class="c-real" style="font-weight:700">'+fmtBR(anoReal||0)+'</div>'+
                '<div class="c-des neutral">—</div>'+
              '</div></td>');
    out.push('<tr class="orc-child"><td class="stk stk-1">'+esc(ch.label)+'</td>'+cols.join('')+'</tr>');
  }
  if(children.length === 0){
    out.push('<tr class="orc-child empty"><td class="stk stk-1" colspan="14">Sem itens para detalhar em '+y+'.</td></tr>');
  }
  return out;
}

function orcSheetResultRow(){
