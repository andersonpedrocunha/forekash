function extSaveModal(tipo){
  const data    = (document.getElementById('ext-fld-data')?.value || '').trim();
  const conta   = (document.getElementById('ext-fld-conta')?.value || '').trim();
  const ccRaw   = (document.getElementById('ext-fld-cc')?.value || '').trim();
