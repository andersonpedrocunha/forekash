  if(words.length === 1) return words[0].slice(0,2).toUpperCase();
  return (words[0][0] + words[1][0]).toUpperCase();
}

function dispoLoad(){
  try{
    const raw = localStorage.getItem(DISPO_KEY);
    if(raw){
      const parsed = JSON.parse(raw);
      dispo = parsed.state || parsed;
      dispoActiveYear = parsed.activeYear || (dispo.years && dispo.years[dispo.years.length-1]);
    }
  }catch(e){ dispo = null; }

  // Migração: state antigo usava grupos + nome livre
  if(dispo && dispo.grupos && !dispo.bancos){
    dispo.bancos = DISPO_BANCOS_DEFAULT.map(b=>({...b}));
    dispo.tipos  = DISPO_TIPOS_DEFAULT.map(t=>({...t}));
    // Tenta mapear contas antigas
    for(const c of (dispo.contas||[])){
      // Banco pelo antigo grupoId
      const g = (dispo.grupos||[]).find(x=>x.id===c.grupoId);
      if(g){
        const byNome = dispo.bancos.find(b => b.nome.toUpperCase() === g.nome.toUpperCase());
        if(byNome){
          c.bancoId = byNome.id;
        } else {
          const novo = { id: dispoNextId('bancos'), nome:g.nome, domain:null, color:g.color };
          dispo.bancos.push(novo);
          c.bancoId = novo.id;
        }
      }
      // Tipo via parsing do nome antigo: "ITAÚ [CC]" → CC, ou nome livre ("COTAS", "BÔNUS")
      const m = c.nome && c.nome.match(/\[([^\]]+)\]/);
      if(m){
        const abrev = m[1].trim().toUpperCase();
        let tp = dispo.tipos.find(t => (t.abrev||'').toUpperCase() === abrev || t.nome.toUpperCase() === abrev);
        if(!tp){
          tp = { id: dispoNextId('tipos'), nome: m[1].trim(), abrev, liquidez: (g && g.tipo) || 'caixa' };
          dispo.tipos.push(tp);
        }
        c.tipoId = tp.id;
      } else if(c.nome){
        // Sem colchete — tenta match pelo nome inteiro
        const nomeUp = c.nome.trim().toUpperCase();
        const tp = dispo.tipos.find(t => (t.abrev||'').toUpperCase() === nomeUp || t.nome.toUpperCase() === nomeUp);
        if(tp){ c.tipoId = tp.id; }
        else if(nomeUp){
          // Cria novo tipo usando a liquidez do grupo antigo
          const abrev = nomeUp.slice(0,6);
          const novo = { id: dispoNextId('tipos'), nome: c.nome.trim(), abrev, liquidez: (g && g.tipo) || 'caixa' };
          dispo.tipos.push(novo);
          c.tipoId = novo.id;
        }
      }
      delete c.grupoId;
      delete c.nome;
    }
    delete dispo.grupos;
  }

  if(!dispo){
    const now = new Date();
    const cur  = String(now.getFullYear());
    const prev = String(now.getFullYear()-1);
    dispo = {
      years:  [prev, cur],
      bancos: DISPO_BANCOS_DEFAULT.map(b=>({...b})),
      tipos:  DISPO_TIPOS_DEFAULT.map(t=>({...t})),
      contas: [
        { id:1, bancoId:'b-itau',   tipoId:'t-cc',    saldos:{} },
        { id:2, bancoId:'b-itau',   tipoId:'t-cdb',   saldos:{} },
        { id:3, bancoId:'b-unilos', tipoId:'t-cc',    saldos:{} },
        { id:4, bancoId:'b-c6',     tipoId:'t-cc',    saldos:{} },
        { id:5, bancoId:'b-bb',     tipoId:'t-cc',    saldos:{} },
        { id:6, bancoId:'b-cresol', tipoId:'t-cotas', saldos:{} }
      ]
    };
    dispoActiveYear = cur;
  }
  dispo.years  = dispo.years  || [];
  dispo.bancos = dispo.bancos || [];
  dispo.tipos  = dispo.tipos  || [];
  dispo.contas = dispo.contas || [];
  // Migração: código Compe (número do banco) em bancos conhecidos
  for(const b of dispo.bancos){
    if(typeof b.codigo !== 'string'){
      b.codigo = DISPO_BANCO_CODIGOS[b.id] || '';
    }
  }
  // Migração: defaults de campos ausentes em contas
  for(const c of dispo.contas){
    if(c.ativo === undefined) c.ativo = true;
    if(!c.dados || typeof c.dados !== 'object'){
      c.dados = { agencia:'', conta:'', digito:'', titular:'', documento:'',
                  pix:'', pixTipo:'', gerente:'', gerenteEmail:'', gerenteTel:'', obs:'' };
    } else {
      if(typeof c.dados.agencia      !== 'string') c.dados.agencia      = '';
      if(typeof c.dados.conta        !== 'string') c.dados.conta        = '';
      if(typeof c.dados.digito       !== 'string') c.dados.digito       = '';
      if(typeof c.dados.titular      !== 'string') c.dados.titular      = '';
      if(typeof c.dados.documento    !== 'string') c.dados.documento    = '';
      if(typeof c.dados.pix          !== 'string') c.dados.pix          = '';
      if(typeof c.dados.pixTipo      !== 'string') c.dados.pixTipo      = '';
      if(typeof c.dados.gerente      !== 'string') c.dados.gerente      = '';
      if(typeof c.dados.gerenteEmail !== 'string') c.dados.gerenteEmail = '';
      if(typeof c.dados.gerenteTel   !== 'string') c.dados.gerenteTel   = '';
      if(typeof c.dados.obs          !== 'string') c.dados.obs          = '';
    }
  }
  if(!['all','ativos','inativos'].includes(dispo.statusFilter)){
    dispo.statusFilter = 'all';
  }
  if(!dispoActiveYear && dispo.years.length) dispoActiveYear = dispo.years[dispo.years.length-1];
  dispoSave();
}

