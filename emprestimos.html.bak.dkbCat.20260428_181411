// (caso alguma re-renderização tenha engolido o focusout do input antigo).
// ATENÇÃO: ignoramos clicks disparados logo após um drag/click-to-insert,
// porque o click nativo cai no alvo do mouseup (que NÃO é o input ativo) e
// esconderia o preview logo depois de inserir a referência.
document.addEventListener('click', function(e){
  if(__formulaDragState) return;
  if(__formulaDragJustEnded && (Date.now() - __formulaDragJustEnded) < 400) return;
  if(!__formulaEditingActive) return;
  const tgtCell = e.target && e.target.closest ? e.target.closest('[data-cellref]') : null;
  if(tgtCell && tgtCell === __formulaActiveInput) return; // clicou no próprio input
  __formulaEditingActive = false;
  __hideFormulaPreview();
}, true);

// Reposiciona o preview ao rolar ou redimensionar (se estiver visível)
window.addEventListener('scroll', function(){
  if(__formulaActiveInput && __formulaPreviewEl
     && __formulaPreviewEl.style.display !== 'none') __updateFormulaPreview();
}, true);
window.addEventListener('resize', function(){
  if(__formulaActiveInput && __formulaPreviewEl
     && __formulaPreviewEl.style.display !== 'none') __updateFormulaPreview();
});

// Percorre todas as células que têm data-cellref e valor começando com "=" — reavalia,
// compara com o valor atualmente salvo, e se diferente, escreve o novo valor e dispara blur
// (que aciona o setter inline de cada tabela). Repete até estabilizar.
function __recomputeAllFormulas(){
  if(__formulaRecomputing) return;
  __formulaRecomputing = true;
  try{
    for(let pass = 0; pass < 6; pass++){
      let changed = false;
      // Snapshot dos pares (cellId, formula) ANTES — o DOM pode ser re-renderizado
      // após cada atualização (o setter inline chama render* para vários módulos).
      const snapshot = [];
      document.querySelectorAll('[data-cellref]').forEach(function(el){
        if(el === __formulaActiveInput) return; // usuário está editando, não mexe
        const v = (el.value||'').toString();
        if(v.trim().startsWith('=')) snapshot.push({cellId: el.getAttribute('data-cellref'), formula: v});
      });
      snapshot.forEach(function(item){
        const fresh = document.querySelector('[data-cellref="'+item.cellId.replace(/"/g,'\\"')+'"]');
        if(!fresh) return;
        if(fresh === __formulaActiveInput) return;
        const resolved = evalSimpleFormula(item.formula);
        if(!resolved.ok) return;
        // Se o input já mostra o valor resolvido, nada a fazer
        const cur = parseFloat((fresh.value||'').toString().replace(/\./g,'').replace(',','.'));
        if(!isNaN(cur) && Math.abs(cur - resolved.value) < 1e-9) return;
        // Atualiza o .value visual pro número + dispara blur para acionar setter inline
        // NOTA: mantemos a fórmula no próprio input só durante edição do usuário;
        // após o cálculo final, ele verá o número (pode re-editar e a fórmula aparecerá se digitada)
        fresh.value = fmtBR(resolved.value, 2);
        // Dispara blur sem refocar (não queremos desviar o user)
        try{
          const ev = new Event('blur', {bubbles:true});
          fresh.dispatchEvent(ev);
          if(typeof fresh.onblur === 'function'){
            // Alguns browsers disparam o inline onblur via dispatchEvent; outros não.
            // Chamar redundante é seguro porque o setter inline é idempotente.
            fresh.onblur({target: fresh, currentTarget: fresh});
          }
        }catch(_){}
        changed = true;
      });
      if(!changed) break;
    }
