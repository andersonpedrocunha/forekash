function closeAddLancamentoModal(){
  const ov = document.getElementById('reg-add-modal-ov');
  if(ov) ov.remove();
  document.removeEventListener('keydown', _regAddModalKey, true);
}
function _regAddModalKey(e){
  if(e.key === 'Escape'){ e.stopPropagation(); closeAddLancamentoModal(); }
  else if(e.key === 'Enter'){ e.stopPropagation(); _regAddLancamentoConfirm(); }
}
function _regAddLancamentoConfirm(){
  const loanSel = document.getElementById('reg-add-loan-sel');
  const tipoSel = document.getElementById('reg-add-tipo-sel');
  const mesEl = document.getElementById('reg-mes');
  if(!loanSel || !tipoSel || !mesEl) return;
  const loanId = parseInt(loanSel.value, 10);
  const tipo = tipoSel.value;
  const mes = mesEl.value;
  closeAddLancamentoModal();
  addRegistroExtra(loanId, mes, tipo);
}

function addRegistroExtra(loanId, mes, tipo){
  const loan = loans.find(l => l.id === loanId); if(!loan) return null;
  if(typeof isMesEfetivado === 'function' && isMesEfetivado(mes)){
    try { if(typeof toast === 'function') toast('🔒 Mês travado — destrave pra editar'); } catch(e){}
    return null;
  }
  const reg = _ensureReg(loan, mes);
  const id = _regNextExtraId();
  const tiposValidos = ['parcela_extra','amort_parcial','amort_total'];
  const t = tiposValidos.includes(tipo) ? tipo : 'parcela_extra';
  const extra = { id, tipo:t, parcela:'', juros:'', amort:'', descricao:'', ts:new Date().toISOString() };
  // Amort total: pré-preenche com o saldo devedor remanescente nesse momento do mês
  if(t === 'amort_total'){
    const saldoBase = _regSaldoBaseParaExtra(loan, mes, id);
    if(saldoBase > 0){
      extra.parcela = saldoBase;
      extra.juros = 0;
      extra.amort = saldoBase;
      extra.descricao = 'Quitação';
    }
  }
  reg.extras.push(extra);
  reg.ts = new Date().toISOString();
  // Saldo devedor em modo auto: se amort_total, o saldo vai a zero
  if(typeof regSaldoMode !== 'undefined' && regSaldoMode === 'auto'){
    reg.saldoEfetivado = _regEstimarSaldo(loan, mes);
  }
  saveData();
  try { renderRegistro(); } catch(e){}
  return id;
}
function removeRegistroExtra(loanId, mes, extraId){
  const loan = loans.find(l => l.id === loanId); if(!loan) return;
  if(typeof isMesEfetivado === 'function' && isMesEfetivado(mes)){
    try { if(typeof toast === 'function') toast('🔒 Mês travado — destrave pra editar'); } catch(e){}
    return;
  }
  const reg = (loan.registros||[]).find(r => r.mes === mes);
  if(!reg || !Array.isArray(reg.extras)) return;
  reg.extras = reg.extras.filter(x => x.id !== extraId);
  reg.ts = new Date().toISOString();
  saveData();
  try { renderRegistro(); } catch(e){}
}
// Grava campo de um lançamento extra. Também aplica auto-sum/split conforme modo.
function saveRegistroExtraField(loanId, mes, extraId, field, rawVal){
  const loan = loans.find(l => l.id === loanId); if(!loan) return;
  if(typeof isMesEfetivado === 'function' && isMesEfetivado(mes)){
    try { if(typeof toast === 'function') toast('🔒 Mês efetivado'); } catch(e){}
    try { renderRegistro(); } catch(e){}
    return;
  }
  const reg = (loan.registros||[]).find(r => r.mes === mes);
  if(!reg) return;
  const ex = (reg.extras||[]).find(x => x.id === extraId);
  if(!ex) return;
  const validos = ['parcela','juros','amort','tipo','descricao'];
  if(!validos.includes(field)) return;
  if(field === 'tipo'){
    const tiposOk = ['parcela_extra','amort_parcial','amort_total'];
    ex.tipo = tiposOk.includes(rawVal) ? rawVal : 'parcela_extra';
  } else if(field === 'descricao'){
    ex.descricao = (rawVal || '').toString();
  } else {
    const n = parseBR(rawVal);
    ex[field] = (n !== '') ? n : '';
  }
  ex.ts = new Date().toISOString();
  let autoFilled = false;

  // AUTO mode: ao gravar parcela do extra, estima juros+amort.
  // Usa saldo já descontado dos pagamentos anteriores (cascading).
  if(field === 'parcela' && ex.parcela !== '' && ex.parcela > 0
     && (typeof regFillMode === 'undefined' || regFillMode === 'auto')){
    const jVazio = ex.juros === '' || ex.juros == null;
    const aVazio = ex.amort === '' || ex.amort == null;
    if(jVazio && aVazio){
      // Para amort_parcial: juros = 0, amort = valor inteiro
      if(ex.tipo === 'amort_parcial'){
        ex.juros = 0; ex.amort = ex.parcela; autoFilled = true;
      } else {
        // Parcela extra: usa saldo cascateado como base de juros
        const saldoBase = _regSaldoBaseParaExtra(loan, mes, extraId);
        const i = (parseFloat(loan.taxa)||0) / 100;
        if(saldoBase > 0 && i > 0){
          const j = Math.min(ex.parcela, saldoBase * i);
          ex.juros = j; ex.amort = Math.max(0, ex.parcela - j); autoFilled = true;
        } else {
          ex.juros = 0; ex.amort = ex.parcela; autoFilled = true;
        }
      }
    }
  }
  // MANUAL mode: ao digitar juros OU amort, parcela do extra = soma.
  if((field === 'juros' || field === 'amort')
     && typeof regFillMode !== 'undefined' && regFillMode === 'manual'){
    const j = parseFloat(ex.juros) || 0;
    const a = parseFloat(ex.amort) || 0;
    if((j + a) > 0){ ex.parcela = j + a; autoFilled = true; }
  }
  // Saldo devedor no mês (auto): recalcular considerando main + extras
  if(typeof regSaldoMode !== 'undefined' && regSaldoMode === 'auto'){
    const novo = _regEstimarSaldo(loan, mes);
    if(reg.saldoEfetivado !== novo){ reg.saldoEfetivado = novo; autoFilled = true; }
  }
  reg.ts = new Date().toISOString();
  saveData();
  if(autoFilled){ try { renderRegistro(); } catch(e){} }
  else { try { const el = document.getElementById('reg-mes'); if(el && el.value === mes) updateRegistroKPIs(mes); } catch(e){} }
  try { if(document.getElementById('tab-divida').classList.contains('active')) drawDivida(); } catch(e){}
}
// Saldo base para cálculo de juros de um extra específico.
// = saldo_anterior_ao_mes − amort do lançamento principal − amort dos extras anteriores.
function _regSaldoBaseParaExtra(loan, mes, extraId){
  const reg = (loan.registros||[]).find(r => r.mes === mes);
  if(!reg) return parseFloat(loan.saldo)||0;
  // Saldo no início do mês: procura registro do mês anterior (calendário)
  const [y, mo] = mes.split('-').map(Number);
  const prev = new Date(y, mo - 2, 1);
  const prevStr = prev.getFullYear() + '-' + String(prev.getMonth()+1).padStart(2,'0');
  const prevReg = (loan.registros||[]).find(r => r.mes === prevStr);
  let saldo = (prevReg && prevReg.saldoEfetivado !== '' && prevReg.saldoEfetivado != null)
    ? (parseFloat(prevReg.saldoEfetivado)||0)
    : (parseFloat(loan.saldo)||0);
  // Desconta amort do lançamento principal
  const amortMain = (reg.amortEfetivada !== '' && reg.amortEfetivada != null)
    ? (parseFloat(reg.amortEfetivada)||0) : 0;
  saldo -= amortMain;
  // Desconta amort dos extras ANTERIORES ao atual (na ordem do array)
  for(const ex of (reg.extras||[])){
    if(ex.id === extraId) break;
    const a = (ex.amort !== '' && ex.amort != null) ? (parseFloat(ex.amort)||0) : 0;
    saldo -= a;
  }
  return Math.max(0, saldo);
}

// ─── Vencimento da parcela (cascata) ───
// Prioridade:
//   1) loan.vencimentos[idx] (override individual)
//   2) loan.diaVencimento (mesmo dia todo mês, dia explícito)
//   3) inicio + idx meses (mesmo dia do inicio)
function _loanGetVencimento(loan, idx){
  if(!loan || idx == null || idx < 0) return '';
  if(Array.isArray(loan.vencimentos) && loan.vencimentos[idx]) return loan.vencimentos[idx];
  const sm = /^(\d{4})-(\d{2})-(\d{2})$/.exec(loan.inicio || '');
  if(!sm) return '';
  let y = parseInt(sm[1], 10);
  let m = parseInt(sm[2], 10) + idx;
  while(m > 12){ m -= 12; y++; }
  while(m < 1){ m += 12; y--; }
  let dia = parseInt(sm[3], 10);
  if(loan.diaVencimento){
    const dExplicit = parseInt(loan.diaVencimento, 10);
    if(dExplicit >= 1 && dExplicit <= 31) dia = dExplicit;
  }
  // Clamp ao último dia do mês
  const lastDay = new Date(y, m, 0).getDate();
  dia = Math.min(dia, lastDay);
  return y + '-' + String(m).padStart(2,'0') + '-' + String(dia).padStart(2,'0');
}
