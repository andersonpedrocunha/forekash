// Resolve avatar (foto/iniciais/genérico) para um responsável, puxando do módulo PESSOAS.
// Aceita pesId que pode ser registry.id OU people.id (legado) OU '__externo__'.
function _bdPesAvatar(pesId, nome, sizeCls){
  sizeCls = sizeCls || '';
  let foto = '';
  let displayNome = nome || '';
  // Tenta resolver no registry de pessoas
  try {
    if(pesId && pesId !== '__externo__' && typeof pessoas !== 'undefined' && pessoas){
      const pid = (typeof pesId === 'string') ? parseInt(pesId, 10) : pesId;
      const reg = Array.isArray(pessoas.registry) ? pessoas.registry : [];
      let r = reg.find(x => x.id === pid);
      // Fallback: se pesId era people.id (legado), resolve pra registry via pessoaId
      if(!r && Array.isArray(pessoas.people)){
        const p = pessoas.people.find(x => x.id === pid);
        if(p && p.pessoaId) r = reg.find(x => x.id === p.pessoaId);
      }
      if(r){
        foto = r.foto || '';
        if(!displayNome) displayNome = r.nome || '';
      }
    }
  } catch(e){}
  // Iniciais
  const ini = (displayNome || '?').trim().split(/\s+/).slice(0,2)
              .map(s => s[0] || '').join('').toUpperCase() || '?';
  // Cor estável a partir do nome (hash → hue)
  let hue = 210;
  try {
    let h = 0;
    for(const ch of (displayNome||'')) h = (h*31 + ch.charCodeAt(0)) >>> 0;
    hue = h % 360;
  } catch(e){}
  const bg = 'hsl(' + hue + ',60%,88%)';
  const fg = 'hsl(' + hue + ',55%,32%)';
  if(foto){
    return '<span class="bd-pes-ava ' + sizeCls + '" title="' + _bdEsc(displayNome) + '">'
         + '<img src="' + _bdEsc(foto) + '" alt="' + _bdEsc(displayNome) + '"></span>';
  }
  return '<span class="bd-pes-ava ' + sizeCls + '" style="background:' + bg + ';color:' + fg + '" title="' + _bdEsc(displayNome) + '">'
       + _bdEsc(ini) + '</span>';
}

