  if(!settings || typeof settings !== 'object'){
    settings = { userName:'Anderson', email:'', companyName:'', cnpj:'', logoDataUrl:'', featuredModules:['fluxo'], hp12cEnabled:true };
  }
  // Sanitiza campos faltantes
  if(typeof settings.userName   !== 'string') settings.userName   = 'Anderson';
