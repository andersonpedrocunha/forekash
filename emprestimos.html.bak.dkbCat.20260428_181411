//  Modal genérico askText — substitui prompt() nativo
// ═══════════════════════════════════════════════════
let _askTextCtx = null; // { onConfirm, onCancel, validate }

// ─────────────────────────────────────────────────────────────────
// Modal de confirmação genérico — retorna Promise<boolean>
// opts: { title, message, sub?, confirmLabel?, cancelLabel?, variant? ('ok'|'danger'|'info'|'warn') }
let _askConfirmCtx = null;
function askConfirm(opts){
  opts = opts || {};
  return new Promise(resolve => {
    _askConfirmCtx = {
      done: false,
      resolve: (val) => {
        if(_askConfirmCtx && _askConfirmCtx.done) return;
        if(_askConfirmCtx) _askConfirmCtx.done = true;
        resolve(!!val);
      }
    };
    const ov   = document.getElementById('ov-askconfirm');
    const ttl  = document.getElementById('askconfirm-title');
    const msg  = document.getElementById('askconfirm-msg');
    const sub  = document.getElementById('askconfirm-sub');
    const okB  = document.getElementById('askconfirm-ok');
    const caB  = document.getElementById('askconfirm-cancel');
    const icow = document.getElementById('askconfirm-icowrap');
    const svg  = document.getElementById('askconfirm-svg');
    if(!ov || !ttl || !msg || !okB){ resolve(false); return; }

    ttl.textContent = opts.title || 'Confirmar ação';
    msg.textContent = opts.message || 'Tem certeza que deseja continuar?';
    if(opts.sub){ sub.textContent = opts.sub; sub.style.display = ''; }
    else { sub.textContent = ''; sub.style.display = 'none'; }
    okB.textContent = opts.confirmLabel || 'Confirmar';
    // Passando cancelLabel === '' (string vazia) → esconde o botão cancelar (diálogo "informativo")
    if(opts.cancelLabel === ''){
      caB.style.display = 'none';
    } else {
      caB.style.display = '';
      caB.textContent = opts.cancelLabel || 'Cancelar';
    }

    const variant = opts.variant || 'ok';
    icow.className = 'askconfirm-icowrap' + (variant === 'danger' ? ' danger'
                                          : variant === 'info'   ? ' info'
                                          : variant === 'warn'   ? ' warn' : '');
    okB.className  = 'asktext-btn ok askconfirm-ok' + (variant === 'danger' ? ' danger' : '');
    // Ícone: check (ok/info), atenção (warn), lixeira (danger)
    const icons = {
      ok:     '<polyline points="20 6 9 17 4 12"/>',
      info:   '<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>',
      warn:   '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
      danger: '<polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>'
    };
    if(svg) svg.innerHTML = icons[variant] || icons.ok;

    ov.classList.add('open');
    setTimeout(()=>{ try{ okB.focus(); }catch(e){} }, 30);
  });
}
function askConfirmOK(){
  if(_askConfirmCtx){ _askConfirmCtx.resolve(true); }
  _askConfirmCloseUI();
}
function askConfirmCancel(){
  if(_askConfirmCtx){ _askConfirmCtx.resolve(false); }
  _askConfirmCloseUI();
}
function _askConfirmCloseUI(){
  const ov = document.getElementById('ov-askconfirm');
  if(ov) ov.classList.remove('open');
  _askConfirmCtx = null;
}
document.addEventListener('keydown', function(ev){
  const ov = document.getElementById('ov-askconfirm');
  if(!ov || !ov.classList.contains('open')) return;
  if(ev.key === 'Escape'){ ev.preventDefault(); askConfirmCancel(); }
  else if(ev.key === 'Enter'){ ev.preventDefault(); askConfirmOK(); }
});

function askText(opts){
  // opts: { title, label, placeholder, initialValue, confirmText, hint, validate, onConfirm, inputType }
  // inputType: 'text' (padrão) ou 'date'
  // Retorna Promise — resolve com o valor confirmado, ou null se cancelado
  return new Promise(resolve => {
    const title    = opts.title || 'Novo item';
    const label    = opts.label || '';
    const placeh   = opts.placeholder || '';
    const initVal  = opts.initialValue != null ? opts.initialValue : '';
    const confirm  = opts.confirmText || 'Salvar';
    const hint     = opts.hint || '';
    const inpType  = opts.inputType || 'text';

    _askTextCtx = {
      validate: opts.validate || null,
      done: false,
      resolve: (val) => {
        if(_askTextCtx && _askTextCtx.done) return;
        if(_askTextCtx) _askTextCtx.done = true;
        if(typeof opts.onConfirm === 'function' && val != null) opts.onConfirm(val);
        resolve(val);
      }
    };

    const ov = document.getElementById('ov-asktext');
    const ttl = document.getElementById('asktext-title');
    const lbl = document.getElementById('asktext-label');
    const inp = document.getElementById('asktext-input');
    const hnt = document.getElementById('asktext-hint');
    const ok  = document.getElementById('asktext-ok');
    if(!ov || !inp) { resolve(null); return; }

    ttl.textContent = title;
    if(label){ lbl.textContent = label; lbl.style.display = ''; }
    else     { lbl.style.display = 'none'; }
    inp.type = inpType;
    inp.placeholder = placeh;
    inp.value = initVal;
    inp.classList.remove('err');
    hnt.textContent = hint;
    hnt.className = 'asktext-hint' + (hint ? ' info' : '');
    ok.textContent = confirm;
    ok.disabled = false;

    ov.classList.add('open');
    setTimeout(()=>{ inp.focus(); inp.select(); }, 30);
  });
}

function askTextConfirm(){
  const inp = document.getElementById('asktext-input');
  const hnt = document.getElementById('asktext-hint');
  if(!inp || !_askTextCtx) return;
  const val = inp.value.trim();
  // Roda validador (sync) — retorna string de erro ou null/undefined se OK
  if(_askTextCtx.validate){
    const err = _askTextCtx.validate(val);
    if(err){
      inp.classList.add('err');
      hnt.textContent = err;
      hnt.className = 'asktext-hint err';
      setTimeout(()=>inp.focus(), 10);
      return;
    }
  }
  _askTextCtx.resolve(val);
  _askTextCloseUI();
}

function askTextCancel(){
  if(!_askTextCtx) { _askTextCloseUI(); return; }
  _askTextCtx.resolve(null);
  _askTextCloseUI();
}

function _askTextCloseUI(){
  const ov = document.getElementById('ov-asktext');
  if(ov) ov.classList.remove('open');
  _askTextCtx = null;
}

function askTextKey(ev){
  if(ev.key === 'Escape'){ ev.preventDefault(); askTextCancel(); }
  else if(ev.key === 'Enter'){ ev.preventDefault(); askTextConfirm(); }
  else {
    // limpa estado de erro quando o usuário digita
    const inp = document.getElementById('asktext-input');
    const hnt = document.getElementById('asktext-hint');
    if(inp && inp.classList.contains('err')){
      inp.classList.remove('err');
      if(hnt){ hnt.textContent = ''; hnt.className = 'asktext-hint'; }
    }
  }
}

