//  CONFIGURAÇÕES · Segurança (trocar e-mail / senha)
// ═══════════════════════════════════════════════════
function cfgSecAlert(id, msg, kind){
  const el = document.getElementById(id);
  if(!el) return;
  if(!msg){ el.className = 'cfg-sec-alert'; el.textContent = ''; return; }
  el.className = 'cfg-sec-alert show ' + (kind === 'ok' ? 'ok' : 'err');
  el.textContent = msg;
  // Auto-limpa sucesso depois de 3.5s
  if(kind === 'ok'){
    clearTimeout(el._cfgSecTimer);
    el._cfgSecTimer = setTimeout(() => { cfgSecAlert(id, ''); }, 3500);
  }
}

function cfgRenderSeguranca(){
  const user = fkCurrentUser();
  const emEl = document.getElementById('cfg-sec-current-email-val');
  if(emEl) emEl.textContent = user ? user.email : '—';

  // Limpa mensagens e inputs
  ['cfg-email-msg','cfg-pass-msg'].forEach(id => cfgSecAlert(id, ''));
  ['cfg-sec-new-email','cfg-sec-email-pass','cfg-sec-pass-cur','cfg-sec-pass-new','cfg-sec-pass-conf']
    .forEach(id => { const el = document.getElementById(id); if(el) el.value = ''; });

  // Wire forms (idempotente via flag)
  const ef = document.getElementById('cfg-email-form');
  if(ef && !ef._cfgWired){
    ef.addEventListener('submit', cfgHandleChangeEmail);
    ef._cfgWired = true;
  }
  const pf = document.getElementById('cfg-pass-form');
  if(pf && !pf._cfgWired){
    pf.addEventListener('submit', cfgHandleChangePassword);
    pf._cfgWired = true;
  }

  // Password toggle (idempotente)
  document.querySelectorAll('#mod-configuracoes .cfg-pass-toggle').forEach(btn => {
    if(btn._cfgWired) return;
    btn._cfgWired = true;
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const inp = document.getElementById(targetId);
      if(!inp) return;
      const show = inp.type === 'password';
      inp.type = show ? 'text' : 'password';
      btn.setAttribute('aria-label', show ? 'Ocultar senha' : 'Mostrar senha');
    });
  });
}

async function cfgHandleChangeEmail(ev){
  if(ev) ev.preventDefault();
  cfgSecAlert('cfg-email-msg', '');
  const btn = document.getElementById('cfg-email-btn');
  const newEmail = fkNormEmail(document.getElementById('cfg-sec-new-email').value);
  const pass     = document.getElementById('cfg-sec-email-pass').value;
  const user = fkCurrentUser();
  if(!user){ cfgSecAlert('cfg-email-msg', 'Sessão inválida. Entre novamente.', 'err'); return; }
  if(!newEmail){ cfgSecAlert('cfg-email-msg', 'Informe o novo e-mail.', 'err'); return; }
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)){
    cfgSecAlert('cfg-email-msg', 'E-mail inválido.', 'err'); return;
  }
  if(newEmail === user.email){
    cfgSecAlert('cfg-email-msg', 'Este já é o seu e-mail atual.', 'err'); return;
  }
  if(!pass){ cfgSecAlert('cfg-email-msg', 'Informe sua senha atual pra confirmar.', 'err'); return; }

  if(btn) btn.disabled = true;
  try{
    const d = fkLoad();
    // E-mail já cadastrado por outra conta?
    if((d.users || []).some(u => u.id !== user.id && u.email === newEmail)){
      cfgSecAlert('cfg-email-msg', 'Já existe uma conta com esse e-mail.', 'err'); return;
    }
    // Revalida senha atual
    const h = await fkHash(pass, user.salt);
    if(h !== user.hash){
      cfgSecAlert('cfg-email-msg', 'Senha atual incorreta.', 'err'); return;
    }
    // Atualiza e-mail
    const u = (d.users || []).find(x => x.id === user.id);
    if(!u){ cfgSecAlert('cfg-email-msg', 'Usuário não encontrado.', 'err'); return; }
    u.email = newEmail;
    u.updatedAt = Date.now();
    fkSave(d);
    cfgSecAlert('cfg-email-msg', 'E-mail atualizado.', 'ok');
    // Atualiza UI
    const emEl = document.getElementById('cfg-sec-current-email-val');
    if(emEl) emEl.textContent = newEmail;
    try{ fkRenderUserMenu(); }catch(_){}
    // Limpa inputs
    document.getElementById('cfg-sec-new-email').value = '';
    document.getElementById('cfg-sec-email-pass').value = '';
  }catch(e){
    cfgSecAlert('cfg-email-msg', 'Erro inesperado: ' + (e && e.message || e), 'err');
  }finally{
    if(btn) btn.disabled = false;
  }
}

async function cfgHandleChangePassword(ev){
  if(ev) ev.preventDefault();
  cfgSecAlert('cfg-pass-msg', '');
  const btn = document.getElementById('cfg-pass-btn');
  const cur  = document.getElementById('cfg-sec-pass-cur').value;
  const neu  = document.getElementById('cfg-sec-pass-new').value;
  const conf = document.getElementById('cfg-sec-pass-conf').value;
  const user = fkCurrentUser();
  if(!user){ cfgSecAlert('cfg-pass-msg', 'Sessão inválida. Entre novamente.', 'err'); return; }
  if(!cur || !neu || !conf){
    cfgSecAlert('cfg-pass-msg', 'Preencha todos os campos.', 'err'); return;
  }
  if(neu.length < 6){
    cfgSecAlert('cfg-pass-msg', 'A nova senha precisa de no mínimo 6 caracteres.', 'err'); return;
  }
  if(neu !== conf){
    cfgSecAlert('cfg-pass-msg', 'A confirmação não bate com a nova senha.', 'err'); return;
  }
  if(neu === cur){
    cfgSecAlert('cfg-pass-msg', 'A nova senha precisa ser diferente da atual.', 'err'); return;
  }

  if(btn) btn.disabled = true;
  try{
    const d = fkLoad();
    const u = (d.users || []).find(x => x.id === user.id);
    if(!u){ cfgSecAlert('cfg-pass-msg', 'Usuário não encontrado.', 'err'); return; }
    // Revalida senha atual
    const hCur = await fkHash(cur, u.salt);
    if(hCur !== u.hash){
      cfgSecAlert('cfg-pass-msg', 'Senha atual incorreta.', 'err'); return;
    }
    // Gera novo salt + hash
    const newSalt = fkRandomSalt();
    const hNew = await fkHash(neu, newSalt);
    u.salt = newSalt;
    u.hash = hNew;
    u.updatedAt = Date.now();
    fkSave(d);
    cfgSecAlert('cfg-pass-msg', 'Senha atualizada.', 'ok');
    // Limpa inputs
    document.getElementById('cfg-sec-pass-cur').value = '';
    document.getElementById('cfg-sec-pass-new').value = '';
    document.getElementById('cfg-sec-pass-conf').value = '';
  }catch(e){
    cfgSecAlert('cfg-pass-msg', 'Erro inesperado: ' + (e && e.message || e), 'err');
  }finally{
    if(btn) btn.disabled = false;
  }
}

async function fkHandleLogin(ev){
  if(ev) ev.preventDefault();
  fkAlert('fk-login-err', '');
  const email = fkNormEmail(document.getElementById('fk-login-email').value);
  const pass  = document.getElementById('fk-login-pass').value;
  const remember = !!document.getElementById('fk-login-remember').checked;
  if(!email || !pass){
    fkAlert('fk-login-err', 'Preencha e-mail e senha.'); return;
  }
  const btn = document.getElementById('fk-login-btn');
  if(btn) btn.disabled = true;
  try{
    const d = fkLoad();
    const user = (d.users || []).find(u => u.email === email);
    if(!user){ fkAlert('fk-login-err', 'Conta não encontrada. Crie uma primeiro.'); return; }
    const h = await fkHash(pass, user.salt);
    if(h !== user.hash){ fkAlert('fk-login-err', 'Senha incorreta.'); return; }
    const ttlMs = (remember ? FK_SESSION_DAYS : 1) * 24 * 60 * 60 * 1000;
    d.session = { userId: user.id, startedAt: Date.now(), expiresAt: Date.now() + ttlMs };
    fkSave(d);
    fkAlert('fk-login-err', 'Tudo certo. Abrindo seu painel…', 'ok');
    setTimeout(() => { fkHideGate(); fkRenderUserMenu(); fkBootApp(); }, 240);
  }catch(e){
    fkAlert('fk-login-err', 'Erro inesperado: ' + (e && e.message || e));
  }finally{
    if(btn) btn.disabled = false;
  }
}

async function fkHandleSignup(ev){
  if(ev) ev.preventDefault();
  fkAlert('fk-signup-err', '');
  const name  = String(document.getElementById('fk-signup-name').value || '').trim();
  const email = fkNormEmail(document.getElementById('fk-signup-email').value);
  const pass  = document.getElementById('fk-signup-pass').value;
  if(!name || !email || !pass){ fkAlert('fk-signup-err', 'Preencha nome, e-mail e senha.'); return; }
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ fkAlert('fk-signup-err', 'E-mail inválido.'); return; }
  if(pass.length < 6){ fkAlert('fk-signup-err', 'A senha precisa de no mínimo 6 caracteres.'); return; }
  const btn = document.getElementById('fk-signup-btn');
  if(btn) btn.disabled = true;
  try{
    const d = fkLoad();
    if((d.users || []).some(u => u.email === email)){
      fkAlert('fk-signup-err', 'Já existe uma conta com esse e-mail. Use "Entrar".'); return;
    }
    const salt = fkRandomSalt();
    const hash = await fkHash(pass, salt);
    const user = {
      id: 'u_' + Date.now().toString(36) + Math.random().toString(36).slice(2,8),
      name, email, salt, hash,
      createdAt: Date.now()
    };
    d.users = d.users || [];
    d.users.push(user);
    const ttlMs = FK_SESSION_DAYS * 24 * 60 * 60 * 1000;
    d.session = { userId: user.id, startedAt: Date.now(), expiresAt: Date.now() + ttlMs };
    fkSave(d);
    fkAlert('fk-signup-err', 'Conta criada. Bem-vindo.', 'ok');
    setTimeout(() => { fkHideGate(); fkRenderUserMenu(); fkBootApp(); }, 320);
  }catch(e){
    fkAlert('fk-signup-err', 'Erro inesperado: ' + (e && e.message || e));
  }finally{
    if(btn) btn.disabled = false;
  }
}

function fkWireGate(){
  // Tabs
  document.querySelectorAll('[data-fk-tab]').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-fk-tab');
      document.querySelectorAll('.fk-tabs [data-fk-tab]').forEach(b => b.classList.toggle('active', b === btn));
      document.querySelectorAll('.fk-panel').forEach(p => p.classList.remove('active'));
      const panel = document.getElementById('fk-panel-' + tab);
      if(panel) panel.classList.add('active');
      // limpa alertas ao trocar
      fkAlert('fk-login-err',''); fkAlert('fk-signup-err','');
    });
  });
  // Toggle senha
  document.querySelectorAll('.fk-pass-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const inp = document.getElementById(targetId);
      if(!inp) return;
      const show = inp.type === 'password';
      inp.type = show ? 'text' : 'password';
      btn.setAttribute('aria-label', show ? 'Ocultar senha' : 'Mostrar senha');
      btn.classList.toggle('on', show);
    });
  });
  // Forms
  const lf = document.getElementById('fk-login-form');
  if(lf) lf.addEventListener('submit', fkHandleLogin);
  const sf = document.getElementById('fk-signup-form');
  if(sf) sf.addEventListener('submit', fkHandleSignup);

  // User menu dropdown
  const ub = document.getElementById('hdr-user-btn');
  const um = document.getElementById('hdr-user-menu');
  if(ub && um){
    ub.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = um.classList.toggle('open');
      ub.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', (e) => {
      if(!um.contains(e.target) && e.target !== ub && !ub.contains(e.target)){
        um.classList.remove('open');
        ub.setAttribute('aria-expanded','false');
      }
    });
  }

  // Modal de auth: clicar no backdrop fecha + ESC fecha
  const bd = document.getElementById('fk-auth-backdrop');
  if(bd){
    bd.addEventListener('click', (e) => {
      if(e.target === bd) fkCloseAuth();
    });
  }
  document.addEventListener('keydown', (e) => {
    if(e.key === 'Escape'){
      const bd2 = document.getElementById('fk-auth-backdrop');
      if(bd2 && bd2.classList.contains('open')){
        e.stopPropagation();
        fkCloseAuth();
      }
    }
  });

  // Delegação para data-* attrs (nav, CTAs, logo, fechar modal).
  // Escopo em `document` pois o modal (#fk-auth-backdrop) fica fora do gate.
  document.addEventListener('click', (e) => {
    const scrollT = e.target.closest('[data-fk-scroll]');
    if(scrollT){
      e.preventDefault();
      const id = scrollT.getAttribute('data-fk-scroll');
      try{ fkScrollTo(id); }catch(err){ try{ console.warn('[FOREKASH] fkScrollTo falhou:', err); }catch(_){ } }
      return;
    }
    const authT = e.target.closest('[data-fk-auth]');
    if(authT){
      e.preventDefault();
      const mode = authT.getAttribute('data-fk-auth');
      try{ fkOpenAuth(mode); }catch(err){ try{ console.warn('[FOREKASH] fkOpenAuth falhou:', err); }catch(_){ } }
      return;
    }
    const closeT = e.target.closest('[data-fk-close="auth"]');
    if(closeT){
      e.preventDefault();
      try{ fkCloseAuth(); }catch(err){ try{ console.warn('[FOREKASH] fkCloseAuth falhou:', err); }catch(_){ } }
      return;
    }
  });
  // Teclado: Enter/Space em elementos role=button com data-fk-*
  document.addEventListener('keydown', (e) => {
    if(e.key !== 'Enter' && e.key !== ' ') return;
    const t = e.target;
    if(!(t && t.matches && (t.matches('[data-fk-scroll]') || t.matches('[data-fk-auth]') || t.matches('[data-fk-close="auth"]')))) return;
    if(t.tagName === 'BUTTON' || t.tagName === 'INPUT' || t.tagName === 'TEXTAREA') return; // já disparam click nativo
    e.preventDefault();
    try{ t.click(); }catch(_){ }
  });
}

