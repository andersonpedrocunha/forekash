function _anaLogoInit(){
  // Só guardamos o PLACEMENT — a logo em si vem de settings.logoDataUrl (Configurações)
  if(!_anaState.companyLogo || typeof _anaState.companyLogo !== 'object'){
    _anaState.companyLogo = { placement: 'all' };
  }
  // Limpa data antigo (migração)
  if('data' in _anaState.companyLogo) delete _anaState.companyLogo.data;
}
function _anaGetUserLogo(){
  // Lê a logo cadastrada em Configurações (mesma usada nos relatórios)
  try {
    if(typeof settings !== 'undefined' && settings && settings.logoDataUrl){
      return settings.logoDataUrl;
    }
  } catch(e){}
  return null;
}
function _anaLogoHTML(slide, slideIdx, totalSlides){
  _anaLogoInit();
  const logoSrc = _anaGetUserLogo();
  if(!logoSrc) return '';
  const placement = (_anaState.companyLogo && _anaState.companyLogo.placement) || 'all';
  if(placement === 'none') return '';
  let show = false;
  if(placement === 'all') show = true;
  else if(placement === 'cover') show = !!slide.isCover || slideIdx === 0;
  else if(placement === 'end') show = (slideIdx === totalSlides - 1);
  if(!show) return '';
  return '<div class="ana-slide-company-logo"><img src="' + logoSrc.replace(/"/g,'&quot;') + '" alt="Logo da empresa"></div>';
}
