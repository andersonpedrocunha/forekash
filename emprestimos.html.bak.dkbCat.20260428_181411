              onclick="_flxStructRemoveCustom('${esc(c.id)}')"
              title="Remover linha">
        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m2 0v14a2 2 0 01-2 2H8a2 2 0 01-2-2V6M10 11v6M14 11v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>`;
  };

  // Render por seção
  const secsHtml = FLX_CUST_SECOES.map(sec => {
    const rows = bySec[sec.id];
    const bodyHtml = rows.length === 0
      ? '<div class="flx-struct-custom-empty">Sem linhas nesta seção.</div>'
      : '<div class="flx-struct-lines">'+rows.map(lineHTML).join('')+'</div>';
    return `
      <div class="flx-struct-sec-head">${esc(sec.nome)}
        <span class="flx-struct-sec-hint">${esc(sec.hint)}</span>
      </div>
      ${bodyHtml}
      <button type="button" class="flx-struct-add" onclick="_flxStructAddCustom('${sec.id}')">
        <span class="plus">+</span> Adicionar em ${esc(sec.nome)}
      </button>
    `;
  }).join('');

  return `
    ${secsHtml}
    <p style="margin:16px 0 0;font-size:.66rem;color:var(--txl);line-height:1.5">
      A <b>seção</b> define onde a linha aparece em cada visão: <i>Custos Operacionais</i> entra dentro do
      bloco de custo (afeta EBITDA/Resultado), <i>Resultado Financeiro</i> aparece junto com Juros/Empréstimos
      (afeta LAIR), e <i>Ajustes de Caixa</i> fica no grupo não operacional do fim (só afeta o Saldo do Mês).
      Independente da seção, o saldo final é o mesmo.
    </p>
  `;
}
