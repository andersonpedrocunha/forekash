    if(Array.isArray(list) && list.length > 0) meta[field] = list.slice();
    else delete meta[field];
    if(ad.save) ad.save();
  } catch(e){ console.warn('dkb auto-persist anexo:', e); }
}
function _dkbAnexoOpenAt(idx){
