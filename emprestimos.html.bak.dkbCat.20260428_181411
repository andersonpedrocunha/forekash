async function supHandleSubmit(ev){
  ev.preventDefault();
  const cat  = (document.getElementById('sup-categoria')||{}).value || '';
  const pr   = (document.getElementById('sup-prioridade')||{}).value || 'normal';
  const mod  = (document.getElementById('sup-modulo')||{}).value || '';
  const asn  = ((document.getElementById('sup-assunto')||{}).value || '').trim();
  const dsc  = ((document.getElementById('sup-descricao')||{}).value || '').trim();
  const em   = ((document.getElementById('sup-contato')||{}).value || '').trim();
  if(!cat){ supAlert('Selecione uma categoria.','err'); return; }
  if(!asn || asn.length < 5){ supAlert('Escreva um assunto com pelo menos 5 caracteres.','err'); return; }
  if(!dsc || dsc.length < 15){ supAlert('A descrição precisa ter pelo menos 15 caracteres.','err'); return; }
  if(!em || !/^\S+@\S+\.\S+$/.test(em)){ supAlert('Informe um e-mail de contato válido.','err'); return; }

  const btn = document.getElementById('sup-submit');
  if(btn) btn.disabled = true;

  const ticket = {
    id: 'SUP-' + Date.now().toString(36).toUpperCase(),
    createdAt: Date.now(),
    categoria: cat,
    prioridade: pr,
    modulo: mod,
    assunto: asn,
    descricao: dsc,
    contato: em,
    status: 'aberto',
    attachments: _supAttachments.map(a => ({ name:a.name, size:a.size, type:a.type, dataUrl:a.dataUrl }))
  };
  try{
    const arr = supLoadTickets();
    arr.unshift(ticket);
    localStorage.setItem(SUP_TICKETS_KEY, JSON.stringify(arr));
  }catch(e){
    if(btn) btn.disabled = false;
    // Mensagem específica para quota excedida (localStorage ~5MB)
    const msg = (e && e.name === 'QuotaExceededError')
      ? 'Espaço local esgotado (limite do navegador). Remova anexos antigos ou reduza o tamanho das imagens.'
      : 'Não foi possível salvar o chamado localmente. Tente novamente.';
    supAlert(msg,'err');
    return;
  }

  const attInfo = ticket.attachments.length
    ? ' <i>(' + ticket.attachments.length + ' anexo' + (ticket.attachments.length>1?'s':'') + ')</i>'
    : '';
  supAlert('Chamado <b>' + ticket.id + '</b> registrado' + attInfo + '! O time de suporte entrará em contato em ' + em + '.', 'ok');
  // Limpa campos (mantém contato)
  const assIn = document.getElementById('sup-assunto'); if(assIn) assIn.value = '';
  const dscIn = document.getElementById('sup-descricao'); if(dscIn) dscIn.value = '';
  const catIn = document.getElementById('sup-categoria'); if(catIn) catIn.value = '';
  const modIn = document.getElementById('sup-modulo'); if(modIn) modIn.value = '';
  const prIn  = document.getElementById('sup-prioridade'); if(prIn) prIn.value = 'normal';
  const cnt   = document.getElementById('sup-descricao-count'); if(cnt) cnt.textContent = '0';
  _supAttachments = [];
  supRenderThumbs();
  if(btn) btn.disabled = false;
  supRenderTickets();
}

function supLoadTickets(){
  try{
    const raw = localStorage.getItem(SUP_TICKETS_KEY);
    if(!raw) return [];
    const arr = JSON.parse(raw);
    return Array.isArray(arr) ? arr : [];
  }catch(_){ return []; }
}

