                  font-weight:800;line-height:1;user-select:none;flex-shrink:0}
    .ana-cw-drag:hover{color:#4C1D95}
    .ana-cw-drag:active{cursor:grabbing}
    .ana-cw-cols-1{grid-column:span 1}
    .ana-cw-cols-2{grid-column:span 2}
    .ana-cw-cols-3{grid-column:span 3}
    .ana-cw-cols-4{grid-column:span 4}
    .ana-cw-rows-1{grid-row:span 1}
    .ana-cw-rows-2{grid-row:span 2}
    .ana-cw-rows-3{grid-row:span 3}
    .ana-cw-rows-4{grid-row:span 4}
    .ana-cw-hd{display:flex;align-items:center;gap:3px;padding:4px 6px;
                background:linear-gradient(180deg,#F8FAFC 0%,#F1F5F9 100%);
