// CONVERSOR DE TAXAS — FAB + janela flutuante com conversão em todos os períodos
// ═══════════════════════════════════════════════════════════════════════════
function rateConvSyncFab(){
  const fab = document.getElementById('rateconv-fab');
  if(!fab) return;
  if(settings && settings.rateConvEnabled) fab.classList.remove('hidden');
  else fab.classList.add('hidden');
}
function rateConvOpenWin(){
  const win = document.getElementById('rateconv-win');
  if(!win) return;
  win.classList.remove('hidden');
  _rateConvUpdateBaseBtns();
  _rateConvCompute();
  const inp = document.getElementById('rateconv-input');
  if(inp){ inp.focus(); inp.select(); }
}
function rateConvCloseWin(){
  const win = document.getElementById('rateconv-win');
  if(win) win.classList.add('hidden');
}
function setRateConvBase(base){
  if(base !== 30 && base !== 21) return;
  if(!settings) settingsLoad();
  settings.rateConvBase = base;
  settingsSave();
  _rateConvUpdateBaseBtns();
  _rateConvCompute();
}
function _rateConvUpdateBaseBtns(){
  const base = (settings && settings.rateConvBase === 21) ? 21 : 30;
  document.querySelectorAll('.rateconv-base-btn').forEach(b => {
    const bv = parseInt(b.getAttribute('data-base'),10);
    b.classList.toggle('is-on', bv === base);
  });
}
// Converte taxa (em qualquer período) em todos os outros via juros compostos.
function _rateConvCompute(){
  const inp = document.getElementById('rateconv-input');
  const sel = document.getElementById('rateconv-period');
  const out = document.getElementById('rateconv-output');
  if(!inp || !sel || !out) return;
  const raw = (inp.value || '').toString().trim().replace(',', '.');
  const rate = parseFloat(raw);
  const period = sel.value;
  const baseDias = (settings && settings.rateConvBase === 21) ? 21 : 30;
  const anoDias = baseDias === 21 ? 252 : 360;
  // Converte taxa de entrada pra fator (1+r/100)^(1/período_em_meses)
  // Trabalho interno: normaliza tudo pra "fator mensal equivalente" f_m = (1+i_m)
  // Relação: i_x = (1+i_m)^n - 1 onde n = meses equivalentes do período x
  // Então f_m = (1+i_x)^(1/n)
  // n equivalentes em meses:
  const nMeses = {
    d: (baseDias === 21 ? (21/21) : (30/30)) / (baseDias === 21 ? 21 : 30),  // 1/dias_por_mes
    m: 1,
    t: 3,
    s: 6,
    a: 12
  };
  // Para diária: n (meses) = 1/dias_por_mes. Mas pra anual dia: 1/(dias_por_ano)
  // Recalibro: vou trabalhar em "fator anual" pra simplicidade.
  // diasPorMes: baseDias (30 ou 21). diasPorAno: anoDias (360 ou 252).
  // Fator anual f_a = (1 + rate/100)^(anoDias/diasPeriodo)
  const diasPeriodo = {
    d: 1, m: baseDias, t: baseDias*3, s: baseDias*6, a: anoDias
  };
  if(!isFinite(rate) || rate === 0){
    out.innerHTML = '<div class="rateconv-row"><div class="rateconv-row-lbl">—</div><div class="rateconv-row-val">0,00%</div></div>'.repeat(5);
    return;
  }
  const fa = Math.pow(1 + rate/100, anoDias / diasPeriodo[period]);
  // Calcula taxas pros 5 períodos
  const taxa = (p) => (Math.pow(fa, diasPeriodo[p]/anoDias) - 1) * 100;
  const fmtPct = n => {
    const abs = Math.abs(n);
    const dec = abs < 1 ? 4 : (abs < 100 ? 3 : 2);
    return n.toLocaleString('pt-BR',{minimumFractionDigits:dec,maximumFractionDigits:dec}) + '%';
  };
  const rows = [
    { id:'d', lbl:'Diária',     per:'a.d.' },
    { id:'m', lbl:'Mensal',     per:'a.m.' },
    { id:'t', lbl:'Trimestral', per:'a.t.' },
    { id:'s', lbl:'Semestral',  per:'a.s.' },
    { id:'a', lbl:'Anual',      per:'a.a.' }
  ];
  out.innerHTML = rows.map(r => {
    const v = taxa(r.id);
    const isBase = r.id === period;
    return (
      '<div class="rateconv-row'+(isBase?' is-base':'')+'">'+
        '<div class="rateconv-row-lbl">'+r.lbl+' <span class="per">'+r.per+'</span>'+(isBase?' ·':'')+'</div>'+
        '<div class="rateconv-row-val">'+fmtPct(v)+'<span class="unit">'+r.per+'</span></div>'+
      '</div>'
    );
  }).join('');
}

// Boot: aplica estado e wire dos eventos
(function _rateConvBoot(){
  const init = () => {
    try {
      rateConvSyncFab();
      const fab = document.getElementById('rateconv-fab');
      if(fab) fab.addEventListener('click', rateConvOpenWin);
      const close = document.getElementById('rateconv-close');
      if(close) close.addEventListener('click', rateConvCloseWin);
      const inp = document.getElementById('rateconv-input');
      if(inp) inp.addEventListener('input', _rateConvCompute);
      const sel = document.getElementById('rateconv-period');
      if(sel) sel.addEventListener('change', _rateConvCompute);
      // Esc fecha a janela se aberta
      document.addEventListener('keydown', e => {
        if(e.key === 'Escape'){
          const w = document.getElementById('rateconv-win');
          if(w && !w.classList.contains('hidden')){ rateConvCloseWin(); }
        }
      });
    } catch(e){}
  };
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();

