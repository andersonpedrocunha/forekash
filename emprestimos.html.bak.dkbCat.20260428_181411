// ─── PICKER de Pessoa (primeira coluna) ───
function openPessoaPicker(rowId, btn, event){
  if(event) event.stopPropagation();
  closePessoaPicker();
  const row = pessoas.people.find(p=>p.id===rowId);
  if(!row) return;
  const currentRid = row.pessoaId || 0;

  const pop = document.createElement('div');
  pop.className = 'rec-cli-pop';
  pop.id = 'pes-pop';
  pop.addEventListener('click', e=>e.stopPropagation());

  const header = document.createElement('div');
  header.className = 'rec-cli-header';
  const htitle = document.createElement('div');
  htitle.className = 'rec-cli-header-title';
  htitle.textContent = currentRid ? 'Trocar / renomear pessoa' : 'Selecionar pessoa';
  const search = document.createElement('input');
  search.type = 'text';
  search.className = 'rec-cli-search';
  search.placeholder = 'Buscar ou digitar novo nome…';
  header.appendChild(htitle);
  header.appendChild(search);

  const listEl = document.createElement('div');
  listEl.className = 'rec-cli-list';
  const footer = document.createElement('div');
  footer.className = 'rec-cli-footer';

  function renderList(query){
    listEl.innerHTML = '';
    const q = (query||'').trim().toLowerCase();
    const regs = pesRegistry().slice().sort((a,b)=>(a.nome||'').localeCompare(b.nome||'','pt'));
    const filtered = q
      ? regs.filter(r => (r.nome||'').toLowerCase().includes(q))
      : regs;

    if(filtered.length === 0){
      const empty = document.createElement('div');
      empty.className = 'rec-cli-empty';
      empty.textContent = regs.length === 0
        ? 'Nenhuma pessoa cadastrada ainda.'
        : 'Nenhuma pessoa corresponde à busca.';
      listEl.appendChild(empty);
    } else {
      // IDs já utilizados por outras linhas — uma pessoa não pode aparecer em 2 rows
      const usedByOthers = new Set(
        pessoas.people.filter(p => p.id !== rowId && p.pessoaId).map(p => p.pessoaId)
      );
      for(const r of filtered){
        const opt = document.createElement('div');
        const isUsed = usedByOthers.has(r.id);
        opt.className = 'rec-cli-opt' + (currentRid === r.id ? ' selected' : '');
        if(isUsed) opt.style.opacity = '.45';

        const name = document.createElement('span');
        name.className = 'rec-cli-oname';
        name.textContent = r.nome || '(sem nome)';
        const n = pesCountRowsForReg(r.id);
        const cnt = document.createElement('span');
        cnt.className = 'rec-cli-count';
        cnt.textContent = isUsed ? 'em uso' : (n + (n===1?' linha':' linhas'));
        const rename = document.createElement('button');
        rename.className = 'rec-cli-rename';
        rename.title = 'Renomear pessoa';
        rename.innerHTML = '<svg viewBox="0 0 24 24"><path d="M17 3a2.828 2.828 0 014 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>';
        rename.onclick = (ev)=>{
          ev.stopPropagation();
          askText({
            title: 'Renomear pessoa',
            label: 'Nome',
            placeholder: 'Ex: Anderson Lemke',
            initialValue: r.nome,
            confirmText: 'Renomear',
            validate: (v)=>{
              if(!v) return 'O nome não pode ficar em branco.';
              if(v === r.nome) return null;
              const ex = pesFindRegByNome(v);
              if(ex && ex.id !== r.id) return null; // merge vai pedir confirmação depois
              return null;
            }
          }).then(novo=>{
            if(novo == null) return;
            const lim = novo.trim();
            if(!lim || lim === r.nome) return;
            const existe = pesFindRegByNome(lim);
            if(existe && existe.id !== r.id){
              const n1 = pesCountRowsForReg(r.id);
              if(!confirm(`Já existe uma pessoa "${lim}". Mesclar "${r.nome}" (${n1} linha${n1===1?'':'s'}) em "${lim}"?`)) return;
              pesReassignReg(r.id, existe.id);
              pesDeleteRegIfOrphan(r.id);
            } else {
              r.nome = lim;
            }
            pessoasSave();
            renderPessoas();
          });
        };

        opt.appendChild(name);
        opt.appendChild(cnt);
        opt.appendChild(rename);
        opt.onclick = ()=>{
          if(isUsed){
            alert('Esta pessoa já aparece em outra linha. Use "Renomear" para editar o nome, ou escolha outra.');
            return;
          }
          linkRowToPessoa(rowId, r.id);
        };
        listEl.appendChild(opt);
      }
    }

    // Footer — criar nova pessoa (dinâmico)
    footer.innerHTML = '';
    const hasExact = regs.some(r => (r.nome||'').toLowerCase() === q && q);
    const newBtn = document.createElement('button');
    newBtn.className = 'rec-cli-new';
    const plus = '<svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    const qRaw = (query||'').trim();
    if(qRaw && !hasExact){
      newBtn.innerHTML = plus + '<span>Criar "<b>' + esc(qRaw) + '</b>"</span>';
    } else {
      newBtn.innerHTML = plus + '<span>Criar nova pessoa</span>';
    }
    newBtn.onclick = ()=>{
      let nome = (qRaw && !hasExact) ? qRaw : null;
      if(nome){
        const existe = pesFindRegByNome(nome);
        if(existe){ linkRowToPessoa(rowId, existe.id); return; }
        createAndLinkPessoa(rowId, nome);
        return;
      }
      // Sem busca digitada — abre modal customizado
      closePessoaPicker();
      askText({
        title: 'Nova pessoa',
        label: 'Nome',
        placeholder: 'Ex: Anderson Lemke',
        confirmText: 'Cadastrar',
        hint: 'O nome será salvo no registro global e não pode repetir.',
        validate: (v)=>{
          if(!v) return 'O nome não pode ficar em branco.';
          const ex = pesFindRegByNome(v);
          if(ex) return 'Já existe uma pessoa com esse nome — escolha-a na lista.';
          return null;
        }
      }).then(val=>{
        if(val == null) return;
        const nm = val.trim();
        if(!nm) return;
        createAndLinkPessoa(rowId, nm);
      });
    };
    footer.appendChild(newBtn);

    if(currentRid){
      const unlink = document.createElement('button');
      unlink.className = 'rec-cli-unlink';
      unlink.textContent = 'Remover vínculo';
      unlink.onclick = ()=> unlinkRowPessoa(rowId);
      footer.appendChild(unlink);
    }
  }

  renderList('');
  search.addEventListener('input', ()=> renderList(search.value));
  search.addEventListener('keydown', e=>{
    if(e.key==='Escape'){ e.stopPropagation(); closePessoaPicker(); }
    if(e.key==='Enter'){
      e.preventDefault();
      const q = search.value.trim();
      if(!q) return;
      const existe = pesFindRegByNome(q);
      if(existe) linkRowToPessoa(rowId, existe.id);
      else       createAndLinkPessoa(rowId, q);
    }
  });

  pop.appendChild(header);
  pop.appendChild(listEl);
  pop.appendChild(footer);

  const rect = btn.getBoundingClientRect();
  pop.style.top  = Math.min(rect.bottom+6, window.innerHeight - 400) + 'px';
  pop.style.left = Math.min(rect.left, window.innerWidth - 350) + 'px';
  document.body.appendChild(pop);
  setTimeout(()=>{
    search.focus();
    document.addEventListener('click', closePessoaPicker, {once:true});
  }, 40);
}

function closePessoaPicker(){
  const p = document.getElementById('pes-pop');
  if(p) p.remove();
}

function linkRowToPessoa(rowId, regId){
  const p = pessoas.people.find(x=>x.id===rowId); if(!p) return;
  const oldReg = p.pessoaId || 0;
  if(oldReg === regId){ closePessoaPicker(); return; }
  // Garante que nenhuma outra linha já usa essa pessoa
  const outra = pessoas.people.find(x => x.id !== rowId && x.pessoaId === regId);
  if(outra){
    alert('Esta pessoa já está em outra linha. Cada pessoa só pode aparecer uma vez na planilha.');
    return;
  }
  p.pessoaId = regId;
  const r = pesRegOf(p);
  if(r) p.nome = r.nome; // sync fallback
  if(oldReg) pesDeleteRegIfOrphan(oldReg);
  pessoasSave();
  closePessoaPicker();
  renderPessoas();
}

function unlinkRowPessoa(rowId){
  const p = pessoas.people.find(x=>x.id===rowId); if(!p) return;
  const oldReg = p.pessoaId || 0;
  p.pessoaId = 0;
  p.nome = '';
  if(oldReg) pesDeleteRegIfOrphan(oldReg);
  pessoasSave();
  closePessoaPicker();
  renderPessoas();
}

function createAndLinkPessoa(rowId, nome){
  const p = pessoas.people.find(x=>x.id===rowId); if(!p) return;
  const lim = (nome||'').trim();
  if(!lim) return;
  const oldReg = p.pessoaId || 0;
  const novo = pesCreateReg({nome:lim});
  p.pessoaId = novo.id;
  p.nome = novo.nome;
  if(oldReg && oldReg !== novo.id) pesDeleteRegIfOrphan(oldReg);
  pessoasSave();
  closePessoaPicker();
