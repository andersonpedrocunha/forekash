    values = _extUniqueValues(all, cfg.getter);
  } catch(e){ values = []; }
  const sel = new Set((_extState[cfg.stateKey] || []).map(s => (s||'').trim()).filter(Boolean));
  // Limpa seleções que não existem mais (ex: depois de excluir lançamentos)
  // — mantém apenas as que ainda batem no dataset
