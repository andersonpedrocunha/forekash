  const mgPct = rec > 0 ? (mg/rec)*100 : 0;
  let msg = `Margem operacional estimada (receita − folha − estrutura − impostos − empréstimos): <b>${fmtBRL(mg)}</b> ou <b>${mgPct.toFixed(1)}%</b>.`;
