// Soma de valores (recebidos ou em aberto) das linhas do cliente,
// agrupado por ano (ignora leads — apenas client rows). Também devolve
// totais gerais em .totalRecebido e .totalAberto.
function clienteValoresPorAno(cid){
  const out = {porAno:{}, totalRecebido:0, totalAberto:0};
  if(!cid || !receita || !receita.years) return out;
  const anos = Object.keys(receita.years).sort();
  for(const y of anos){
    const d = receita.years[y] || {};
    let rec = 0, ab = 0;
    for(const r of (d.clients || [])){
      if(r.clienteId !== cid) continue;
      const meses = r.meses || {};
      for(const m of Object.keys(meses)){
        const cell = meses[m] || {};
        const v = +cell.valor;
        if(!v || isNaN(v)) continue;
        if(cell.status === 'recebido') rec += v;
        else ab += v;
      }
    }
    if(rec > 0 || ab > 0){
      out.porAno[y] = {recebido:rec, aberto:ab};
      out.totalRecebido += rec;
      out.totalAberto   += ab;
    }
  }
  return out;
}

// LTV (Lifetime Value) adaptado para empresa de serviço com faturamento mensal:
//   LTV = Mensalidade média × 12 compras/ano × Anos de retenção
//
//   • ticketMedio — mensalidade média (total recebido ÷ meses de relacionamento)
//   • frequencia  — 12 (número de faturamentos por ano em um contrato mensal)
//   • tempoAnos   — duração do relacionamento em anos (com fração decimal)
//
// O denominador do ticket usa o span do contrato (não apenas os meses com valor > 0),
// de forma que lacunas sem faturamento reduzem a mensalidade média corretamente.
function calcClienteLTV(cid){
  const out = {ltv:0, ticketMedio:0, frequencia:12, tempoAnos:0, tempoMeses:0,
               mesesAtivos:0, totalRecebido:0};
  if(!cid || !receita || !receita.years) return out;

  const mesesAtivosSet = new Set();
  let totalRecebido = 0;
  for(const y of Object.keys(receita.years)){
    const d = receita.years[y] || {};
    for(const r of (d.clients || [])){
      if(r.clienteId !== cid) continue;
      const meses = r.meses || {};
      for(const m of Object.keys(meses)){
        const cell = meses[m] || {};
        const v = +cell.valor;
        if(!v || isNaN(v) || cell.status !== 'recebido') continue;
        totalRecebido += v;
        mesesAtivosSet.add(`${y}-${m}`);
      }
    }
  }
  out.mesesAtivos    = mesesAtivosSet.size;
  out.totalRecebido  = totalRecebido;

  // Tempo de retenção em meses — soma das durações de TODOS os ciclos
  // do contrato (o cliente pode ter saído e voltado). Se não há ciclos
  // registrados, cai de volta para os meses com receita.
  const c = (receita.clientes || []).find(x => x.id === cid);
  let mesesContrato = 0;
  if(c){
    const tempo = clienteTempoContrato(c);
    if(tempo.span){
      mesesContrato = tempo.span.totalMeses || ((tempo.span.anos * 12) + tempo.span.meses);
      if(mesesContrato < 1 && tempo.span.end > tempo.span.start) mesesContrato = 1;
    }
  }
  const tempoMeses = mesesContrato > 0 ? mesesContrato : out.mesesAtivos;
  out.tempoMeses = tempoMeses;
  out.tempoAnos  = tempoMeses / 12;

  // Mensalidade média: total recebido ÷ meses de relacionamento
  // (dilui lacunas, refletindo a receita recorrente típica do contrato)
  out.ticketMedio = tempoMeses > 0 ? (totalRecebido / tempoMeses) : 0;

  // LTV (fórmula empresa de serviço)
  out.ltv = out.ticketMedio * out.frequencia * out.tempoAnos;
  return out;
}

// Formata anos com 1 decimal quando há fração, sem decimal quando inteiro.
// Ex.: 2.0 → "2", 2.3 → "2,3", 0.5 → "0,5"
function fmtAnos(a){
  if(!isFinite(a) || a <= 0) return '0';
  const r = Math.round(a * 10) / 10;
  return Number.isInteger(r) ? String(r) : r.toFixed(1).replace('.', ',');
}

// ─── Anexos de contrato ───────────────────────────────────────────
// Armazenados como data URL no próprio cliente (localStorage). Suporta múltiplos
// arquivos por cliente, com nome, tamanho, tipo MIME e data de anexo.

// Limite individual de 5 MB por arquivo — localStorage tem um teto de ~5-10MB.
const ANEXO_MAX_BYTES = 5 * 1024 * 1024;

function anexoNewId(){
  return 'a' + Date.now().toString(36) + Math.random().toString(36).slice(2,7);
}

function anexoFmtSize(bytes){
  if(!bytes || bytes <= 0) return '0 B';
  if(bytes < 1024)        return bytes + ' B';
  if(bytes < 1048576)     return (bytes/1024).toFixed(1).replace('.0','') + ' KB';
  if(bytes < 1073741824)  return (bytes/1048576).toFixed(1).replace('.0','') + ' MB';
  return (bytes/1073741824).toFixed(2) + ' GB';
}

// Lê um File como data URL (Promise).
function anexoReadFile(file){
  return new Promise((resolve, reject) => {
    const rd = new FileReader();
    rd.onload  = () => resolve(rd.result);
    rd.onerror = () => reject(rd.error || new Error('Falha ao ler arquivo'));
    rd.readAsDataURL(file);
  });
}

// Aceita FileList (ou array) e anexa todos ao cliente. Arquivos muito grandes
// são recusados com alerta. Retorna quando todos foram processados.
async function addAnexosCliente(cid, files){
  const c = (receita.clientes || []).find(x => x.id === cid);
  if(!c) return;
  if(!Array.isArray(c.anexos)) c.anexos = [];
  const arr = Array.from(files || []);
  if(arr.length === 0) return;

  const grandes = arr.filter(f => f.size > ANEXO_MAX_BYTES);
  const ok      = arr.filter(f => f.size <= ANEXO_MAX_BYTES);

  if(grandes.length){
    await askConfirm({
      title: 'Arquivo muito grande',
      message: grandes.length === 1
        ? `"${grandes[0].name}" tem ${anexoFmtSize(grandes[0].size)} — o limite é ${anexoFmtSize(ANEXO_MAX_BYTES)} por arquivo.`
        : `${grandes.length} arquivos excedem o limite de ${anexoFmtSize(ANEXO_MAX_BYTES)} por arquivo e foram ignorados.`,
      variant: 'warn',
      confirmLabel: 'Entendi',
      cancelLabel: ''
    });
  }

  for(const f of ok){
    try{
      const url = await anexoReadFile(f);
      c.anexos.push({
        id: anexoNewId(),
        nome: f.name || 'arquivo',
        tipo: f.type || '',
        tamanho: f.size || 0,
        dataUrl: url,
        dataAnexo: new Date().toISOString()
      });
    }catch(e){
      console.warn('Falha ao anexar', f && f.name, e);
    }
  }
  receitaSave();
  if(clidetCtx && clidetCtx.cid === cid) renderClidet();
}

// Dispara download de um anexo criando um <a> temporário.
