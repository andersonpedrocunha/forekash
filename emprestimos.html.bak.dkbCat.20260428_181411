  if(mode === 'loading'){
    ov.innerHTML = '<div class="viag-ocr-card">'
      + '<div class="viag-ocr-hd"><span style="font-size:1.6rem">🪄</span><div><h2>Lendo o recibo...</h2><p>Reconhecimento de texto rodando local no seu browser</p></div></div>'
      + '<div class="viag-ocr-bd">'
