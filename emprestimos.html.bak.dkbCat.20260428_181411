  const chartWrap = (uid) => '<div class="ana-cw-chart-fill"><canvas id="ana-cw-canvas-' + uid + '"></canvas></div>';
  // Reusamos as funções _anaChRender_X mas precisamos passar canvas ID dinâmico.
  // Como já existem, criamos wrapper que monta canvas e chama render.
  const buildChart = (key, sourceFn) => {
    return (c, ctx) => {
      // Destrói chart anterior nesse uid (se houver) ANTES de recriar HTML
      const prevKey = 'ana-cw-canvas-' + ctx.uid;
      if(_anaChartInstances && _anaChartInstances[prevKey]){
        try { _anaChartInstances[prevKey].destroy(); } catch(_){}
        _anaChartInstances[prevKey] = null;
      }
      c.innerHTML = chartWrap(ctx.uid);
      const canvas = c.querySelector('canvas');
      if(!canvas){ console.warn('chart canvas missing', key); return; }
      // DEFER via RAF — espera o layout do grid calcular dimensões reais
      requestAnimationFrame(() => {
        try { sourceFn(ctx.facts, canvas); }
        catch(e){ console.error('chart render error', key, e); }
        // Resize forçado no próximo frame
        requestAnimationFrame(() => {
          const inst = _anaChartInstances && _anaChartInstances['ana-cw-canvas-' + ctx.uid];
          if(inst && typeof inst.resize === 'function'){
            try { inst.resize(); } catch(_){}
          }
        });
      });
    };
  };
