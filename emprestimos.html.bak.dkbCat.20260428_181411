function importJSON(e){
  const file=e.target.files[0]; if(!file)return;
  const r=new FileReader();
  r.onload=async ev=>{
    try{
      const d=JSON.parse(ev.target.result);
      if(!d.loans||!Array.isArray(d.loans))throw new Error('Formato inválido');
      if(loans.length>0){
        const ok = await showConfirm({
          title:'Substituir dados?',
          message:`Isso substituirá ${loans.length} registro(s) atual(is).\n\nDeseja continuar?`,
          confirmLabel:'Substituir',
          destructive:true
        });
        if(!ok) return;
      }
      loans=d.loans.map(migrate);
      nextId=d.nextId||(loans.reduce((m,l)=>Math.max(m,l.id||0),0)+1);
      saveData(); render();
      toast(`✅ ${loans.length} empréstimo(s) importado(s)!`);
    }catch(err){
      await showInfo({ title:'Arquivo inválido', message:'Arquivo inválido ou corrompido.\n'+err.message, warning:true });
    }
    e.target.value='';
  };
  r.readAsText(file);
}

