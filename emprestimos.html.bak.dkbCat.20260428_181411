function mrcashNormalize(s){
  return (s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
}

function mrcashScrollBottom(){
  const body = document.getElementById('mrcash-body');
  if(body) body.scrollTop = body.scrollHeight;
}

function mrcashRenderGreeting(){
  const body = document.getElementById('mrcash-body');
  if(!body) return;
  body.innerHTML = '';
  const pick = arr => arr[Math.floor(Math.random() * arr.length)];
  const opener = pick(['Olá, amigo.', 'Bom te ver de volta.', 'Bem-vindo de volta.', 'Hello, friend.']);

  const r = diagLastResult;
  if(!r){
    const noData = pick([
      `${opener} Rode o diagnóstico. Com os números na mesa, a gente encontra os caminhos.`,
      `${opener} Me dê os dados e eu te mostro onde estão as oportunidades.`,
      `${opener} Todo plano começa com clareza. Rode o diagnóstico — a partir daí, agimos.`
    ]);
    mrcashAppend('bot', noData);
    return;
  }

  const score = r.ind.score;
  const h = diagHealthLabel(score);
  const alertasAlta = r.alerts.filter(a => a.sev === 'sev-high' || a.sev === 'sev-med').length;

  // Frase do score — motivadora, baseada no nível de saúde
  let scoreMsg;
  if(score >= 75){
    scoreMsg = pick([
      `Score <b>${score}/100</b> — <em>${h.label}</em>. Você construiu algo sólido. Agora é escalar o que já funciona.`,
      `Score <b>${score}/100</b> — <em>${h.label}</em>. Está à frente da maioria. Use essa vantagem enquanto ela é sua.`,
      `Seus números estão respirando. Score <b>${score}/100</b> — <em>${h.label}</em>. O próximo nível está ao alcance.`
    ]);
  } else if(score >= 50){
    scoreMsg = pick([
      `Score <b>${score}/100</b> — <em>${h.label}</em>. A base está aí. Falta transformar potencial em resultado — e você vai.`,
      `Score <b>${score}/100</b> — <em>${h.label}</em>. Cada número aqui é uma alavanca. Você decide quais puxar primeiro.`,
      `O sistema está vivo. Score <b>${score}/100</b> — <em>${h.label}</em>. Dá pra subir esse número. E a gente vai subir.`
    ]);
  } else {
    scoreMsg = pick([
      `Score <b>${score}/100</b> — <em>${h.label}</em>. Você está olhando pro problema de frente. Isso já é metade da virada.`,
      `Score <b>${score}/100</b> — <em>${h.label}</em>. Toda grande recuperação começa com clareza. Você a tem agora.`,
      `Score <b>${score}/100</b> — <em>${h.label}</em>. Não é sentença — é ponto de partida. Vamos subir esse número.`
    ]);
  }

  // Frase dos alertas — como oportunidades
  let alertMsg;
  if(alertasAlta > 0){
    alertMsg = pick([
      `Identifiquei <b>${alertasAlta}</b> ${alertasAlta===1?'ponto':'pontos'} pra endereçar. Cada um é uma alavanca pra subir o score.`,
      `<b>${alertasAlta}</b> ${alertasAlta===1?'sinal':'sinais'} pedindo atenção. Resolver qualquer um deles já muda o jogo.`,
      `${alertasAlta} ${alertasAlta===1?'padrão':'padrões'} pra atacar. E cada ataque é um passo de progresso real.`
    ]);
  } else {
    alertMsg = pick([
      `Nenhum alerta crítico. Isso é conquista — e também é terreno pra crescer.`,
      `Os alertas estão silenciosos. Momento raro. Use bem.`,
      `Sem sinais vermelhos agora. Espaço perfeito pra planejar o próximo salto.`
    ]);
  }

  // Convite final — motivador
  const closing = pick([
    'Me pergunte qualquer coisa. Os números estão aqui. As oportunidades também.',
    'Qual alavanca você quer puxar primeiro?',
    'Diga o que quer otimizar. Eu mostro o caminho.',
    'Cada pergunta é um passo à frente. Bora.',
    'Estou aqui. Pergunte sem medo.'
  ]);

  mrcashAppend('bot', `${opener} ${scoreMsg} ${alertMsg} ${closing}`);
}

