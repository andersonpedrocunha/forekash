function _extImpParseOFX(raw){
  _extImpState.parsed = [];
  _extImpState.errors = [];
  if(!raw || !raw.trim()){
    _extImpState.errors = ['Arquivo vazio'];
    return;
  }
  // Normaliza: remove cabeçalho SGML/XML, mantém o conteúdo OFX
  // OFX 1.x (SGML) tem tags sem fechamento explícito, mas geralmente os parsers funcionam regexando STMTTRN
  // Detecta blocos STMTTRN ... /STMTTRN
  const blockRe = /<STMTTRN>([\s\S]*?)<\/STMTTRN>/gi;
  let m;
  const txns = [];
  while((m = blockRe.exec(raw)) !== null){
    const block = m[1];
    txns.push(block);
  }
  if(txns.length === 0){
    // Fallback: alguns OFX mal formados podem não ter </STMTTRN> — tenta agrupar por <STMTTRN>
    const parts = raw.split(/<STMTTRN>/i).slice(1);
    for(const p of parts){
      const end = p.search(/<\/STMTTRN>|<STMTTRN>/i);
      txns.push(end >= 0 ? p.slice(0, end) : p);
    }
  }
  if(txns.length === 0){
    _extImpState.errors = ['Nenhuma transação (STMTTRN) encontrada no arquivo OFX'];
    return;
  }
  // Tenta achar o nome da conta (BANKACCTFROM > ACCTID + BANKID/ORG)
  let acctName = '';
  try {
    const orgM = /<ORG>([^<\r\n]+)/i.exec(raw);
    const acctIdM = /<ACCTID>([^<\r\n]+)/i.exec(raw);
    const orgVal = orgM ? orgM[1].trim() : '';
    const acctIdVal = acctIdM ? acctIdM[1].trim() : '';
    if(orgVal && acctIdVal) acctName = orgVal + ' · ' + acctIdVal;
    else if(orgVal) acctName = orgVal;
  } catch(e){}
  const getTag = (block, tag) => {
    const re = new RegExp('<' + tag + '>([^<\\r\\n]*)', 'i');
    const mm = re.exec(block);
    return mm ? mm[1].trim() : '';
  };
  const out = [];
  for(const block of txns){
    const trnType = (getTag(block, 'TRNTYPE') || '').toUpperCase();
    const dt = getTag(block, 'DTPOSTED');
    const amt = getTag(block, 'TRNAMT');
    const memo = getTag(block, 'MEMO') || getTag(block, 'NAME') || '';
    const fitid = getTag(block, 'FITID');
    if(!dt || !amt) continue;
    // Data: YYYYMMDD ou YYYYMMDDHHMMSS
    const dm = /^(\d{4})(\d{2})(\d{2})/.exec(dt);
    const data = dm ? (dm[1] + '-' + dm[2] + '-' + dm[3]) : '';
    const valNum = parseFloat(amt);
    if(!isFinite(valNum) || valNum === 0) continue;
    const isCredit = valNum > 0 || trnType === 'CREDIT';
    const tipo = isCredit ? 'ganho' : 'gasto';
    out.push({
      data,
      tipo,
      descricao: memo || (isCredit ? 'Crédito' : 'Débito'),
      contraparte: '',
      conta: acctName || _extImpState.contaDefault || '',
      valor: Math.abs(valNum),
      status: 'pago',
      dataPagamento: data,
      numeroDocumento: fitid || '',
      categoria: '',
      centroCustoId: null,
      _contaOriginal: !!acctName
    });
  }
  _extImpState.parsed = out;
  if(out.length === 0){
    _extImpState.errors = ['Nenhuma transação válida no OFX'];
  }
}
function _extImpParseCSV(raw){
  _extImpState.parsed = [];
  _extImpState.errors = [];
  if(!raw || !raw.trim()){
    _extImpState.errors = ['Arquivo CSV vazio'];
    return;
  }
  // Detecta separador na primeira linha
  const firstLine = raw.split(/\r?\n/)[0] || '';
  const sep = firstLine.includes(';') ? ';' : (firstLine.includes('\t') ? '\t' : ',');
  // Parser CSV simples com suporte a aspas
  const parseLine = (line, separator) => {
    const result = [];
    let cur = '';
    let inQ = false;
    for(let i = 0; i < line.length; i++){
      const ch = line[i];
      if(inQ){
        if(ch === '"' && line[i+1] === '"'){ cur += '"'; i++; }
        else if(ch === '"'){ inQ = false; }
        else cur += ch;
      } else {
        if(ch === '"'){ inQ = true; }
        else if(ch === separator){ result.push(cur); cur = ''; }
        else cur += ch;
      }
    }
    result.push(cur);
    return result;
  };
  const lines = raw.split(/\r?\n/).filter(l => l.trim().length > 0);
  if(lines.length < 2){
    _extImpState.errors = ['CSV precisa ter ao menos cabeçalho + 1 linha de dados'];
    return;
  }
  // Cabeçalho
  const headers = parseLine(lines[0], sep).map(h => h.trim().toLowerCase().replace(/\s+/g, '').replace(/[áàâã]/g,'a').replace(/[éèê]/g,'e').replace(/[íì]/g,'i').replace(/[óòôõ]/g,'o').replace(/[úùû]/g,'u').replace(/ç/g,'c').replace(/[^a-z\/]/g,''));
  const idx = {
    data: headers.indexOf('data'),
    tipo: headers.indexOf('tipo'),
    desc: ['descricao','descrição','description','desc'].map(k => headers.indexOf(k)).find(i => i >= 0),
    cliente: ['cliente/fornecedor','cliente','fornecedor','contraparte'].map(k => headers.indexOf(k)).find(i => i >= 0),
    conta: headers.indexOf('conta'),
    valor: headers.indexOf('valor'),
    status: headers.indexOf('status'),
    dtpag: ['datapagamento','dtpagamento','dt_pagamento'].map(k => headers.indexOf(k)).find(i => i >= 0),
    doc: ['documento','numerodocumento','numero','nfdocumento'].map(k => headers.indexOf(k)).find(i => i >= 0),
    cc: ['centrocusto','cc'].map(k => headers.indexOf(k)).find(i => i >= 0),
    cat: ['categoria','category'].map(k => headers.indexOf(k)).find(i => i >= 0)
  };
  for(const k of Object.keys(idx)) if(idx[k] === undefined) idx[k] = -1;
  if(idx.data < 0 || idx.valor < 0){
    _extImpState.errors = ['CSV precisa ter pelo menos as colunas Data e Valor'];
    return;
  }
  // CCs disponíveis pra match por nome
  const ccByName = new Map();
  try {
    if(typeof centrosCusto !== 'undefined' && Array.isArray(centrosCusto)){
      for(const c of centrosCusto) ccByName.set((c.nome||'').trim().toLowerCase(), c.id);
    }
  } catch(e){}
  const out = [];
  const errs = [];
  for(let li = 1; li < lines.length; li++){
    const cols = parseLine(lines[li], sep);
    const get = (i) => (i >= 0 && i < cols.length) ? (cols[i] || '').trim() : '';
    const dataRaw = get(idx.data);
    const valorRaw = get(idx.valor);
    if(!dataRaw || !valorRaw){ errs.push('Linha ' + (li+1) + ': sem data ou valor'); continue; }
    // Data: YYYY-MM-DD ou DD/MM/YYYY
    let data = '';
    let m1 = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(dataRaw);
    if(m1){
      data = m1[1] + '-' + m1[2].padStart(2,'0') + '-' + m1[3].padStart(2,'0');
    } else {
      let m2 = /^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/.exec(dataRaw);
      if(m2){
        const yy = m2[3].length === 2 ? ('20' + m2[3]) : m2[3];
        data = yy + '-' + m2[2].padStart(2,'0') + '-' + m2[1].padStart(2,'0');
      }
    }
    if(!data){ errs.push('Linha ' + (li+1) + ': data inválida "' + dataRaw + '"'); continue; }
    // Valor: BR ou US
    let valStr = valorRaw.replace(/\s+/g,'').replace(/R\$/i,'');
    let valNum;
    if(valStr.includes(',') && (valStr.lastIndexOf(',') > valStr.lastIndexOf('.'))){
      // BR: 1.234,56
      valStr = valStr.replace(/\./g,'').replace(',', '.');
      valNum = parseFloat(valStr);
    } else {
      valNum = parseFloat(valStr.replace(/,/g,''));
    }
    if(!isFinite(valNum)){ errs.push('Linha ' + (li+1) + ': valor inválido "' + valorRaw + '"'); continue; }
    const valor = Math.abs(valNum);
    // Tipo
    let tipo = (get(idx.tipo) || '').toLowerCase().trim();
    if(tipo === 'despesa' || tipo === 'saida' || tipo === 'saída' || tipo === 'debito' || tipo === 'débito') tipo = 'gasto';
    if(tipo === 'receita' || tipo === 'entrada' || tipo === 'credito' || tipo === 'crédito') tipo = 'ganho';
    if(tipo === 'transf' || tipo === 'transferência' || tipo === 'transfer') tipo = 'transferencia';
    if(!['gasto','ganho','transferencia'].includes(tipo)){
      // Inferência pelo sinal do valor original
      tipo = valNum < 0 ? 'gasto' : 'ganho';
    }
    const status = (get(idx.status) || 'pago').toLowerCase().trim() === 'pendente' ? 'pendente' : 'pago';
    const ccNome = (get(idx.cc) || '').trim().toLowerCase();
    const ccId = ccNome ? (ccByName.get(ccNome) || null) : null;
    const conta = get(idx.conta) || '';
    const dtpag = get(idx.dtpag);
    let dtpagFmt = '';
    if(dtpag){
      let dm1 = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(dtpag);
      if(dm1){
        dtpagFmt = dm1[1] + '-' + dm1[2].padStart(2,'0') + '-' + dm1[3].padStart(2,'0');
      } else {
        let dm2 = /^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/.exec(dtpag);
        if(dm2){
          const yy = dm2[3].length === 2 ? ('20' + dm2[3]) : dm2[3];
          dtpagFmt = yy + '-' + dm2[2].padStart(2,'0') + '-' + dm2[1].padStart(2,'0');
        }
      }
    }
    out.push({
      data,
      tipo,
      descricao: get(idx.desc),
      contraparte: get(idx.cliente),
      conta: conta || (_extImpState.contaDefault || ''),
      valor,
      status,
      dataPagamento: status === 'pago' ? (dtpagFmt || data) : '',
      numeroDocumento: get(idx.doc),
      categoria: get(idx.cat),
      centroCustoId: ccId,
      _contaOriginal: !!conta
    });
  }
  _extImpState.parsed = out;
  _extImpState.errors = errs;
  if(out.length === 0 && errs.length === 0){
    _extImpState.errors = ['Nenhuma linha válida encontrada no CSV'];
  }
}
function _extImpRenderResult(){
  const el = document.getElementById('ext-imp-result');
  if(!el) return;
  const errs = _extImpState.errors || [];
  const items = _extImpState.parsed || [];
  if(items.length === 0 && errs.length === 0){
    el.innerHTML = '';
    return;
  }
  // Detecta duplicatas vs lançamentos manuais existentes
  const dupSelEl = document.getElementById('ext-imp-dup');
  const dupMode = dupSelEl ? dupSelEl.value : 'skip';
  const existing = (typeof extratoData !== 'undefined' && Array.isArray(extratoData.lancamentos)) ? extratoData.lancamentos : [];
  const keyOf = (l) => (l.data||'') + '|' + (Math.round((parseFloat(l.valor)||0)*100)) + '|' + ((l.descricao||'').trim().toLowerCase());
  const existSet = new Set(existing.map(keyOf));
  let nDup = 0;
  for(const it of items){
    it._dup = existSet.has(keyOf(it));
    if(it._dup) nDup++;
  }
  // Soma
  let sumGanho = 0, sumGasto = 0;
  for(const it of items){
    if(dupMode === 'skip' && it._dup) continue;
    if(it.tipo === 'ganho') sumGanho += it.valor;
    else if(it.tipo === 'gasto') sumGasto += it.valor;
  }
  // Summary banner
  let summaryHtml = '';
  if(errs.length > 0){
    summaryHtml += '<div class="ext-imp-summary error">'
      + '<div class="stat"><span class="num">' + errs.length + '</span><span class="lbl">erro(s)</span></div>'
      + '<div style="flex:1;align-self:center">' + _extEsc(errs.slice(0,3).join(' · ')) + (errs.length > 3 ? ' …' : '') + '</div>'
      + '</div>';
  }
  if(items.length > 0){
    const cls = nDup > 0 ? 'warn' : '';
    summaryHtml += '<div class="ext-imp-summary ' + cls + '">'
      + '<div class="stat"><span class="num">' + items.length + '</span><span class="lbl">linhas</span></div>'
      + '<div class="stat"><span class="num">' + (items.length - nDup) + '</span><span class="lbl">a importar</span></div>'
      + '<div class="stat"><span class="num">' + nDup + '</span><span class="lbl">duplicat.</span></div>'
      + '<div class="stat"><span class="num">R$ ' + _extImpFmtMoney(sumGanho) + '</span><span class="lbl">ganhos</span></div>'
      + '<div class="stat"><span class="num">R$ ' + _extImpFmtMoney(sumGasto) + '</span><span class="lbl">gastos</span></div>'
      + '</div>';
  }
  // Tabela preview
  let rows = '';
  for(let i = 0; i < items.length; i++){
    const it = items[i];
    const skip = (dupMode === 'skip' && it._dup);
    const valCls = it.tipo === 'gasto' ? 'v-neg' : 'v-pos';
    const sign = it.tipo === 'gasto' ? '-' : '+';
    const pillCls = it.tipo === 'gasto' ? 'gasto' : (it.tipo === 'ganho' ? 'ganho' : 'transf');
    const pillLbl = it.tipo === 'gasto' ? 'Gasto' : (it.tipo === 'ganho' ? 'Ganho' : 'Transf');
    rows += '<tr' + (skip ? ' class="skip"' : '') + '>'
      + '<td>' + _extImpFmtBR(it.data) + '</td>'
      + '<td><span class="pill ' + pillCls + '">' + pillLbl + '</span></td>'
      + '<td>' + _extEsc((it.descricao || '').slice(0, 60)) + (it._dup ? ' <span style="font-size:.66rem;color:#92400E;font-weight:700">(dup)</span>' : '') + '</td>'
      + '<td>' + _extEsc(it.conta || '') + '</td>'
      + '<td class="' + valCls + '">' + sign + ' R$ ' + _extImpFmtMoney(it.valor) + '</td>'
      + '</tr>';
  }
  let tableHtml = '';
  if(items.length > 0){
    tableHtml = '<div class="ext-imp-preview"><table>'
      + '<thead><tr><th>Data</th><th>Tipo</th><th>Descrição</th><th>Conta</th><th style="text-align:right">Valor</th></tr></thead>'
      + '<tbody>' + rows + '</tbody>'
      + '</table></div>';
  }
  el.innerHTML = summaryHtml + tableHtml;
  // Atualiza footer left text
  const ftL = document.getElementById('ext-imp-ft-left');
  if(ftL){
    if(_extImpState.filename){
      ftL.textContent = '📎 ' + _extImpState.filename;
    } else {
      ftL.textContent = '';
    }
  }
}
