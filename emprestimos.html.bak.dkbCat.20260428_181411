function _cartFatAnexoChange(inp){
  const f = inp && inp.files && inp.files[0];
  if(!f) return;
  if(f.size > 1024 * 1024 * 1.05){
    if(typeof toast === 'function') toast('Arquivo muito grande (máx 1 MB)');
    return;
  }
  const reader = new FileReader();
