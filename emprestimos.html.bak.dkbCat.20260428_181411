                border:1px solid transparent;background:#F9FAFB}
    .diag-alert.sev-high  {background:#FEF2F2;border-color:#FECACA}
    .diag-alert.sev-med   {background:#FFFBEB;border-color:#FDE68A}
    .diag-alert.sev-low   {background:#EFF6FF;border-color:#BFDBFE}
    .diag-alert.sev-ok    {background:#F0FDF4;border-color:#BBF7D0}
    .diag-alert-ico{width:26px;height:26px;flex-shrink:0;border-radius:50%;
                    display:flex;align-items:center;justify-content:center;
                    font-size:.82rem;font-weight:800;color:#fff}
    .diag-alert.sev-high  .diag-alert-ico{background:#DC2626}
    .diag-alert.sev-med   .diag-alert-ico{background:#D97706}
    .diag-alert.sev-low   .diag-alert-ico{background:#2563EB}
