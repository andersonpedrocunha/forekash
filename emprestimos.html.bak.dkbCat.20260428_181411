// Helper de escape (isolado deste módulo)
function _cfgEscape(s){
  return String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

// ── BACKUP ──────────────────────────────────────────
function exportFullBackup(){
  const data = {
    _meta: {
      app: 'Taller Gestão Financeira',
      version: APP_VERSION,
      exportedAt: new Date().toISOString()
    },
    data: {}
  };
  ALL_LS_KEYS.forEach(k => {
    try{
      const raw = localStorage.getItem(k);
      if(raw != null) data.data[k] = raw;
    }catch(e){}
  });
  const blob = new Blob([JSON.stringify(data, null, 2)], { type:'application/json' });
  const url  = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const ts = new Date();
  const pad = n => String(n).padStart(2,'0');
  const fname = 'taller-backup-' + ts.getFullYear() + pad(ts.getMonth()+1) + pad(ts.getDate()) + '-' + pad(ts.getHours()) + pad(ts.getMinutes()) + '.json';
  a.href = url;
  a.download = fname;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 500);
  if(typeof showInfo === 'function'){
    showInfo({
      title:'Backup exportado',
      message:'Arquivo <b>' + _cfgEscape(fname) + '</b> salvo nos seus downloads.'
    });
  }
}

function importFullBackup(){
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = '.json,application/json';
  input.onchange = (ev) => {
    const file = ev.target.files && ev.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = async () => {
      let parsed = null;
      try{ parsed = JSON.parse(reader.result); }catch(e){
        if(typeof showInfo === 'function'){
          showInfo({ title:'Arquivo inválido', message:'Não consegui ler o JSON — verifique o arquivo e tente de novo.' });
        }
        return;
      }
      if(!parsed || !parsed.data || typeof parsed.data !== 'object'){
        if(typeof showInfo === 'function'){
          showInfo({ title:'Formato inesperado', message:'Esse arquivo não parece ser um backup do Taller.' });
        }
        return;
      }
      const proceed = (typeof showConfirm === 'function')
        ? await showConfirm({
            title:'Restaurar backup?',
            message:'Os dados atuais serão <b>substituídos</b> pelo conteúdo do arquivo. Esta ação não pode ser desfeita.',
            confirmText:'Restaurar',
            cancelText:'Cancelar',
            danger:true
          })
        : window.confirm('Restaurar backup? Os dados atuais serão substituídos.');
      if(!proceed) return;
      // Aplica: só escreve chaves que reconhecemos
      let applied = 0;
      Object.keys(parsed.data).forEach(k => {
        if(ALL_LS_KEYS.indexOf(k) === -1) return;
        try{
          localStorage.setItem(k, parsed.data[k]);
          applied++;
        }catch(e){}
      });
      if(typeof showInfo === 'function'){
        await showInfo({
          title:'Backup restaurado',
          message: applied + ' módulo(s) atualizado(s). A página será recarregada para aplicar tudo.'
        });
      }
      location.reload();
    };
    reader.readAsText(file);
  };
  input.click();
}

