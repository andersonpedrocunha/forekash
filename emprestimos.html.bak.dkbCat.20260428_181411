function orcGenSrcChanged(){
  const src = document.getElementById('orc-gen-src').value;
  const pct = document.getElementById('orc-gen-pct');
  const fromY = document.getElementById('orc-gen-from-year');
  const fromV = document.getElementById('orc-gen-from-ver');
  const nome  = document.getElementById('orc-gen-nome');
  const hint  = document.getElementById('orc-gen-hint');
  const isBaseZero = (src === 'zero-absoluto');
  if(fromY) fromY.disabled = isBaseZero;
  if(fromV) fromV.disabled = isBaseZero;
  if(pct)   pct.disabled   = isBaseZero;
  if(pct && isBaseZero) pct.value = '0,0';
  if(nome && isBaseZero && /^Orçamento\s+\S+\s+\(de\s+/.test(nome.value)){
    nome.value = 'Orçamento base zero ' + orcActiveYear;
  }
  if(hint){
    if(isBaseZero){
      hint.innerHTML =
        '<b>Base zero (OBZ):</b> cria uma nova versão com <b>todos os valores zerados</b> — '+
        'sem copiar nada do passado. Você vai preencher cada linha justificando a necessidade, '+
        'ideal para exercícios de reavaliação do orçamento a partir do zero.';
    } else {
      hint.innerHTML =
        'Ex.: copiando <b>ano / versão</b> com <b>IPCA 12m</b> aplica esse % a todos os valores '+
        '(Receita, Folha, Despesas, Empréstimos, Impostos) — mês a mês. '+
        '<br>Você pode ajustar manualmente depois; esta é apenas a base.';
    }
  }
  if(!isBaseZero){
    if(src === 'zero' && pct) pct.value = '0,0';
    else if(src === 'ipca'){
      try{
        const cached = JSON.parse(localStorage.getItem('home_market_v4') || '{}');
        const v = cached && cached.data && cached.data.ipca && cached.data.ipca.value;
        if(v && pct) pct.value = v;
      }catch(e){}
    }
  }
}
function orcGenerateRun(){
  const srcMode = (document.getElementById('orc-gen-src')||{}).value || 'manual';
  const nome    = (document.getElementById('orc-gen-nome').value || '').trim() || 'Nova versão';

  // Base zero (OBZ): cria uma versão vazia sem copiar nada
  if(srcMode === 'zero-absoluto'){
    const novo = orcMakeEmptyVersion(nome);
    novo.origem = { tipo: 'base-zero' };
    const blk = orcGetYearBlock(orcActiveYear);
    blk.versions.push(novo);
    blk.ativa = novo.id;
    orcActiveVerId = novo.id;
    orcamentoSave();
    closeGenericModal();
    renderOrcamento();
    toast('✅ Versão base zero "'+nome+'" criada');
    return;
  }

  const fromY  = document.getElementById('orc-gen-from-year').value;
  const fromV  = document.getElementById('orc-gen-from-ver').value;
  const pctRaw = document.getElementById('orc-gen-pct').value.replace('%','').trim();
  const pctN   = parseBR(pctRaw);
  const pct    = (pctN === '' ? 0 : pctN);
  const factor = 1 + (pct/100);
  const srcBlk = orcamento.years[fromY];
  if(!srcBlk){ toast('Ano origem inválido'); return; }
  const srcVer = srcBlk.versions.find(v => v.id === fromV) || srcBlk.versions[0];
  if(!srcVer){ toast('Versão origem não encontrada'); return; }

  const novo = orcMakeEmptyVersion(nome);
  novo.origem = { ano: fromY, versao: srcVer.id, indicePct: pct };
  for(const c of ORC_CATS){
    const src = (srcVer.linhas||{})[c.id] || {previsto:{}};
    const dst = novo.linhas[c.id] = {previsto:{}};
    for(let m=0;m<12;m++){
      const raw = (src.previsto||{})[m];
      if(raw === undefined || raw === null || raw === '') continue;
      const n = parseFloat(raw);
      if(!isFinite(n)) continue;
      dst.previsto[m] = Math.round((n * factor) * 100) / 100;
    }
  }
  const blk = orcGetYearBlock(orcActiveYear);
  blk.versions.push(novo);
  blk.ativa = novo.id;
  orcActiveVerId = novo.id;
  orcamentoSave();
  closeGenericModal();
  renderOrcamento();
  toast('✅ Versão "'+nome+'" gerada (+'+fmtBR(pct,2)+'%)');
}

// ═══════════ Drill-down (subcategorias) ═══════════
function orcChildrenReceita(year){
  const d = (typeof receita !== 'undefined' && receita && receita.years && receita.years[year])
            ? receita.years[year] : null;
  if(!d) return [];
  const tipos = {};
  for(const c of (d.clients||[])){
    const tipo = (c.tipo && String(c.tipo).trim()) || 'Sem tipo';
    if(!tipos[tipo]) tipos[tipo] = [];
    tipos[tipo].push(c);
  }
  return Object.keys(tipos).sort().map(t => ({
    id: 'rec-tipo:' + t,
    label: t,
    real: (m) => {
      let s = 0;
      for(const c of tipos[t]){
        const cell = c.meses && c.meses[REC_MESES[m]];
        if(cell && cell.valor !== '' && cell.valor != null) s += parseFloat(cell.valor) || 0;
      }
      return s;
    }
  }));
}
function orcChildrenFolha(year){
  if(typeof pessoas === 'undefined' || !pessoas || !Array.isArray(pessoas.people)) return [];
  const ppl = pessoas.people.filter(p => !p.sim);
  return ppl.map(p => ({
    id: 'pes:' + p.id,
    label: p.nome || '—',
    real: (m) => {
      const k = pesMesKey(year, m);
      const v = p.salarios && p.salarios[k];
      return (v !== undefined && v !== '' && v != null) ? (parseFloat(v)||0) : 0;
    }
  }));
}
function orcChildrenDespesas(year){
  if(typeof estrutura === 'undefined' || !estrutura || !Array.isArray(estrutura.itens)) return [];
  const items = estrutura.itens.filter(it =>
    it.valores && Object.keys(it.valores).some(k => k.startsWith(year+'-'))
  );
  return items.map(it => ({
    id: 'est:' + it.id,
    label: it.nome || '—',
    real: (m) => {
      const k = estMesKey(year, m);
      const v = it.valores && it.valores[k];
      return (v !== undefined && v !== '' && v != null) ? (parseFloat(v)||0) : 0;
    }
  }));
}
function orcChildrenEmprestimos(year){
  if(typeof loans === 'undefined' || !Array.isArray(loans)) return [];
  const active = loans.filter(l => (parseFloat(l.parcelaVal)||0) > 0);
  return active.map(l => ({
    id: 'emp:' + l.id,
    label: (l.descricao || l.banco || 'Empréstimo ' + l.id),
    real: (m) => {
      const parcela = parseFloat(l.parcelaVal) || 0;
      if(parcela <= 0) return 0;
      const pagas  = parseInt(l.parcelasPagas) || 0;
      const totalP = parseInt(l.parcelas) || 0;
      if(totalP > 0){
        const saldo = parseFloat(l.saldo) || 0;
        if(saldo <= 0 && pagas >= totalP) return 0;
      }
      return parcela;
    }
  }));
}
function orcChildren(catId, year){
  if(catId === 'receita')     return orcChildrenReceita(year);
  if(catId === 'folha')       return orcChildrenFolha(year);
  if(catId === 'despesas')    return orcChildrenDespesas(year);
  if(catId === 'emprestimos') return orcChildrenEmprestimos(year);
  return [];
}

// ═══════════ Run-rate (projeção fim de ano) ═══════════
function orcRunRateFor(fn, year){
  let meses = 0, acum = 0;
  for(let m=0;m<12;m++){
    if(!orcMesFechado(year, m)) break;
    acum += fn(m);
    meses++;
  }
  if(meses === 0) return null;
  const mediaMes = acum / meses;
  return { acum, mediaMes, projecao: mediaMes * 12, mesesFechados: meses };
}
function orcRunRateCat(catId, year){
  return orcRunRateFor((m) => orcRealMes(catId, year, m), year);
}

// ═══════════ Top desvios do ano ═══════════
function orcTopDeviations(year, N){
  const items = [];
  for(const c of ORC_CATS){
    for(let m=0;m<12;m++){
      if(!orcMesFechado(year, m)) continue;
      const prev = orcPrevMes(c.id, year, m);
      const real = orcRealMes(c.id, year, m);
      if(!prev) continue;
      if(prev === 0 && real === 0) continue;
      const diff = real - prev;
      const pct  = (diff / Math.abs(prev)) * 100;
      if(Math.abs(pct) < 1) continue;
      const invert = (c.id !== 'receita');
      const bom = invert ? (diff < 0) : (diff > 0);
      items.push({
        catId: c.id, catNome: c.nome, catColor: c.color, catSvg: c.svg,
        mIdx: m, mes: ORC_MESES[m],
        prev, real, diff, pct, bom
      });
    }
  }
  items.sort((a,b) => Math.abs(b.pct) - Math.abs(a.pct));
  return items.slice(0, N || 5);
}

