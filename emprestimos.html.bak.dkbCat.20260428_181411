const ORC_ALERTAS_DEFAULT = {
  receita:     { tipo:'abaixo', limitePct: 15 },
  folha:       { tipo:'acima',  limitePct: 15 },
  despesas:    { tipo:'acima',  limitePct: 20 },
  emprestimos: { tipo:'acima',  limitePct: 10 },
  impostos:    { tipo:'acima',  limitePct: 20 }
};
function orcGetAlertas(){
  if(!orcamento.alertas) orcamento.alertas = JSON.parse(JSON.stringify(ORC_ALERTAS_DEFAULT));
  return orcamento.alertas;
}
function orcAlertasCheck(year){
  const rules = orcGetAlertas();
  const alerts = [];
  for(const c of ORC_CATS){
    const r = rules[c.id];
    if(!r) continue;
    let prev = 0, real = 0, mesesFech = 0;
    for(let m=0;m<12;m++){
      if(!orcMesFechado(year, m)) continue;
      prev += orcPrevMes(c.id, year, m);
      real += orcRealMes(c.id, year, m);
      mesesFech++;
    }
    if(prev === 0 || mesesFech === 0) continue;
    const pct = ((real - prev) / Math.abs(prev)) * 100;
    if(r.tipo === 'acima'  && pct > r.limitePct){
      alerts.push({ catId:c.id, catNome:c.nome, catColor:c.color, catSvg:c.svg,
                    tipo:'acima', pct, prev, real, limite:r.limitePct });
    } else if(r.tipo === 'abaixo' && pct < -r.limitePct){
      alerts.push({ catId:c.id, catNome:c.nome, catColor:c.color, catSvg:c.svg,
                    tipo:'abaixo', pct, prev, real, limite:r.limitePct });
    }
  }
  return alerts;
}

// ═══════════ Rolling forecast: re-projetar futuro com run-rate ═══════════
async function orcReProjetarFuturo(){
  const y = orcActiveYear;
  const ver = orcGetVersion();
  if(!ver) return;
  const ok = await (typeof showConfirm === 'function' ? showConfirm({
    title:'Re-projetar com run-rate?',
    message:'Os meses futuros do '+y+' serão preenchidos na versão atual ('+ver.nome+') com a média realizada até agora (run-rate). Meses já fechados não são alterados.',
    confirmLabel:'Re-projetar agora'
  }) : Promise.resolve(confirm('Re-projetar meses futuros com run-rate?')));
  if(!ok) return;
  let changed = 0;
  for(const c of ORC_CATS){
    const rr = orcRunRateCat(c.id, y);
    if(!rr || rr.mesesFechados === 0) continue;
    const media = Math.round(rr.mediaMes * 100) / 100;
    for(let m=0;m<12;m++){
      if(orcMesFechado(y, m)) continue;
      ver.linhas = ver.linhas || {};
      ver.linhas[c.id] = ver.linhas[c.id] || {previsto:{}};
      ver.linhas[c.id].previsto = ver.linhas[c.id].previsto || {};
      ver.linhas[c.id].previsto[m] = media;
      changed++;
    }
  }
  if(changed === 0){ toast('Sem meses realizados para estimar run-rate'); return; }
  orcamentoSave();
  orcCloseVersionMenu();
  renderOrcamento();
  toast('✅ Futuro re-projetado ('+changed+' células atualizadas)');
}

