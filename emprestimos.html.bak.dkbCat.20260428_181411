  impSave();
  renderImpParSheet();
  updateImpParKpis();
}
// Avança/retrocede o mês de início em N meses (padrão: +12 = próximo ano)
function shiftImpParMesInicio(id, delta){
  const p = impostos.parcelamentos.find(x=>x.id===id);
  if(!p) return;
  let base = p.mesInicio && /^\d{4}-\d{2}$/.test(p.mesInicio)
    ? p.mesInicio
    : (new Date()).getFullYear() + '-' + String((new Date()).getMonth()+1).padStart(2,'0');
  const [y, m] = base.split('-').map(Number);
  const total = y * 12 + (m - 1) + (delta || 0);
  const ny = Math.floor(total / 12);
  const nm = total - ny * 12 + 1;
  p.mesInicio = ny + '-' + String(nm).padStart(2,'0');
  p._planKey = null; p._plan = null;
  impSave();
  renderImpParSheet();
  updateImpParKpis();
}

// Picker custom de mês+ano — abre popup ancorado no botão clicado.
// Suporta navegação de ano via setas ‹ › e grid de 12 meses.
function openImpParMesPicker(id, btn){
  // Se já há um picker aberto, fecha antes
  document.querySelectorAll('.imp-mes-picker').forEach(el => el.remove());
  const p = impostos.parcelamentos.find(x => x.id === id);
  if(!p) return;
  const today = new Date();
  const todayYM = today.getFullYear() + '-' + String(today.getMonth()+1).padStart(2,'0');
  const currentVal = p.mesInicio && /^\d{4}-\d{2}$/.test(p.mesInicio) ? p.mesInicio : '';
  const [selY, selM] = currentVal ? currentVal.split('-').map(Number) : [today.getFullYear(), 0];
  // Ano exibido no picker (navegável via setas)
  let navY = selY;

  const pop = document.createElement('div');
  pop.className = 'imp-mes-picker';
  const render = () => {
    pop.innerHTML = `
      <div class="imp-mes-head">
        <button type="button" class="imp-mes-nav" data-act="prev" title="Ano anterior">‹</button>
        <div class="imp-mes-year">${navY}</div>
        <button type="button" class="imp-mes-nav" data-act="next" title="Próximo ano">›</button>
      </div>
      <div class="imp-mes-grid">
        ${IMP_MESES.map((m, i) => {
          const isSel = currentVal && navY === selY && (i+1) === selM;
          return `<button type="button" class="imp-mes-cell${isSel?' selected':''}" data-m="${i+1}">${m.toUpperCase()}</button>`;
        }).join('')}
      </div>
      <div class="imp-mes-footer">
        <button type="button" class="imp-mes-clear" data-act="clear">Limpar</button>
        <button type="button" class="imp-mes-today" data-act="today">Mês atual</button>
      </div>`;
    pop.querySelectorAll('.imp-mes-nav').forEach(b => {
      b.onclick = (e) => {
        e.stopPropagation();
        const act = b.dataset.act;
        if(act === 'prev') navY--;
        else if(act === 'next') navY++;
        render();
      };
    });
    pop.querySelectorAll('.imp-mes-cell').forEach(b => {
      b.onclick = (e) => {
        e.stopPropagation();
        const m = parseInt(b.dataset.m, 10);
        setImpParMesInicio(id, navY + '-' + String(m).padStart(2,'0'));
        close();
      };
    });
    const clearBtn = pop.querySelector('.imp-mes-clear');
    if(clearBtn) clearBtn.onclick = (e) => {
      e.stopPropagation();
      setImpParMesInicio(id, '');
      close();
    };
    const todayBtn = pop.querySelector('.imp-mes-today');
    if(todayBtn) todayBtn.onclick = (e) => {
      e.stopPropagation();
      setImpParMesInicio(id, todayYM);
      close();
    };
  };
  render();
  document.body.appendChild(pop);

  // Posiciona logo abaixo do botão (com fallback pra cima se não couber)
  try {
    const r = btn.getBoundingClientRect();
    const pw = pop.offsetWidth || 260;
    const ph = pop.offsetHeight || 220;
    let left = r.left + (r.width/2) - (pw/2);
    left = Math.max(8, Math.min(window.innerWidth - pw - 8, left));
    let top = r.bottom + 4;
    if(top + ph > window.innerHeight - 8) top = Math.max(8, r.top - ph - 4);
    pop.style.left = left + 'px';
    pop.style.top = top + 'px';
  } catch(e){}

  // Fecha ao clicar fora ou tecla ESC
  const onDoc = (e) => { if(!pop.contains(e.target) && e.target !== btn) close(); };
  const onKey = (e) => { if(e.key === 'Escape') close(); };
  const close = () => {
    document.removeEventListener('click', onDoc, true);
    document.removeEventListener('keydown', onKey, true);
    pop.remove();
  };
  setTimeout(() => {
    document.addEventListener('click', onDoc, true);
    document.addEventListener('keydown', onKey, true);
  }, 0);
}

// ── Ativar/Inativar parcelamento ───────────────────────────────
// Ao inativar, pede motivo (radio + detalhe) e registra data. Ao reativar,
// mostra o motivo antigo e confirma. Motivo fica guardado em `p.statusHistory`.
async function toggleImpParAtivo(id){
  const p = impostos.parcelamentos.find(x => x.id === id);
  if(!p) return;
  const isAtivo = p.ativo !== false;
  if(isAtivo){
    // Inativar — pede motivo
    const motivo = await _askImpParInativoMotivo(p);
    if(!motivo) return;  // cancelou ou vazio
    p.ativo = false;
    p.motivoInativo = motivo;
    p.inativadoEm = new Date().toISOString();
    p.statusHistory = Array.isArray(p.statusHistory) ? p.statusHistory : [];
    p.statusHistory.push({ status: 'inativo', motivo, ts: p.inativadoEm });
    p._planKey = null; p._plan = null;
    impSave();
    renderImpParSheet();
    updateImpParKpis();
    try { if(typeof toast === 'function') toast('🔒 Parcelamento "' + (p.nome||'') + '" inativado'); } catch(e){}
  } else {
    // Reativar — mostra motivo antigo e confirma
    const motivoAnterior = p.motivoInativo || '(sem motivo registrado)';
    let dataTxt = '';
    if(p.inativadoEm){
      try {
        const d = new Date(p.inativadoEm);
        dataTxt = ' em ' + d.toLocaleDateString('pt-BR') + ' às ' + d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
      } catch(e){}
    }
    let ok = true;
    try {
      ok = await showConfirm({
        title: 'Reativar este parcelamento?',
        message: 'Inativado' + dataTxt + '\n\nMotivo registrado:\n"' + motivoAnterior + '"\n\nAo reativar, o parcelamento volta a contar nos totais, DRC e DRE. O histórico de inativação fica preservado.',
        confirmLabel: 'Reativar',
        cancelLabel: 'Cancelar'
      });
    } catch(e){}
    if(!ok) return;
    p.ativo = true;
    p.ativadoEm = new Date().toISOString();
    p.statusHistory = Array.isArray(p.statusHistory) ? p.statusHistory : [];
    p.statusHistory.push({ status: 'ativo', ts: p.ativadoEm });
    p._planKey = null; p._plan = null;
    impSave();
    renderImpParSheet();
    updateImpParKpis();
    try { if(typeof toast === 'function') toast('🔓 Parcelamento "' + (p.nome||'') + '" reativado'); } catch(e){}
  }
}

// Modal bonito pedindo motivo da inativação. Retorna string com motivo ou null.
function _askImpParInativoMotivo(p){
  return new Promise(resolve => {
    const opcoes = [
      { id:'quitado',    label:'Quitado integralmente' },
      { id:'cancelado',  label:'Cancelado pela Receita' },
      { id:'substituido',label:'Substituído por outro parcelamento' },
      { id:'suspenso',   label:'Suspenso (liminar, mandado judicial)' },
      { id:'prescricao', label:'Prescrição da dívida' },
      { id:'outro',      label:'Outro motivo (especificar abaixo)' }
    ];
    const ov = document.createElement('div');
    ov.className = 'confirm-overlay';
    ov.innerHTML = `
      <div class="confirm-modal imp-inat-modal" role="dialog" aria-modal="true" style="max-width:480px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px">
          <div style="flex:0 0 auto;width:42px;height:42px;border-radius:10px;
                      background:linear-gradient(135deg,#FEE2E2,#FEF2F2);
                      display:flex;align-items:center;justify-content:center">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
            </svg>
          </div>
          <div style="flex:1;text-align:left">
            <div class="confirm-title" style="margin:0">Inativar parcelamento</div>
            <div style="font-size:.72rem;color:var(--txm);margin-top:2px">${esc(p.nome || '(sem nome)')}</div>
          </div>
        </div>
        <p class="confirm-msg" style="margin-bottom:14px">
          Escolha o motivo da inativação. O registro será preservado no histórico e o parcelamento some dos totais do DRC/DRE.
        </p>
        <div class="imp-inat-options">
          ${opcoes.map((o, i) => `
            <label class="imp-inat-opt">
              <input type="radio" name="imp-inat-op" value="${o.id}"${i===0?' checked':''}>
              <span>${esc(o.label)}</span>
            </label>
          `).join('')}
        </div>
        <label style="display:block;text-align:left;font-size:.72rem;color:var(--txm);
                      font-weight:600;margin-bottom:4px">Detalhes (opcional)</label>
        <textarea class="imp-inat-detail" placeholder="Ex.: nº do processo, data do evento, observações..."></textarea>
        <div class="confirm-actions" style="justify-content:flex-end;margin-top:14px">
          <button class="confirm-btn confirm-cancel" type="button">Cancelar</button>
          <button class="confirm-btn confirm-ok danger" type="button">Inativar</button>
        </div>
      </div>`;
    let done = false;
    const close = (val) => { if(done) return; done = true; document.removeEventListener('keydown', onKey, true); ov.remove(); resolve(val); };
    const onKey = e => { if(e.key === 'Escape'){ e.stopPropagation(); close(null); } };
    document.addEventListener('keydown', onKey, true);
    ov.addEventListener('click', e => { if(e.target === ov) close(null); });
    document.body.appendChild(ov);
    ov.querySelector('.confirm-cancel').onclick = () => close(null);
    ov.querySelector('.confirm-ok').onclick = () => {
      const radio = ov.querySelector('input[name=imp-inat-op]:checked');
      const opId = radio ? radio.value : 'outro';
      const opLabel = (opcoes.find(o => o.id === opId) || {}).label || 'Outro';
      const detail = (ov.querySelector('.imp-inat-detail').value || '').trim();
      const motivo = detail ? (opLabel + ' — ' + detail) : opLabel;
      close(motivo);
    };
    setTimeout(() => { try { ov.querySelector('.imp-inat-detail').focus(); } catch(e){} }, 30);
  });
}

