function extPeriodNav(delta){
  _extInitPeriod();
  const p = _extState.period;
  if(_extState.grain === 'dia'){
    const d = new Date(p.y, p.m, p.d); d.setDate(d.getDate() + delta);
    p.y = d.getFullYear(); p.m = d.getMonth(); p.d = d.getDate();
  } else if(_extState.grain === 'semana'){
    const d = new Date(p.y, p.m, p.d); d.setDate(d.getDate() + delta * 7);
    p.y = d.getFullYear(); p.m = d.getMonth(); p.d = d.getDate();
  } else if(_extState.grain === 'mes'){
    let m = p.m + delta, y = p.y;
    while(m < 0){ m += 12; y -= 1; }
    while(m > 11){ m -= 12; y += 1; }
    p.m = m; p.y = y;
  } else if(_extState.grain === 'ano'){
    p.y += delta;
  }
  renderExtrato();
}
