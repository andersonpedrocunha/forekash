// Loader de scripts CDN sob demanda (não carrega tudo no boot)
function _anaLoadScript(url, globalCheck){
  return new Promise((resolve, reject) => {
    if(globalCheck && window[globalCheck]) return resolve();
    const s = document.createElement('script');
    s.src = url; s.async = true;
    s.onload = () => resolve();
    s.onerror = () => reject(new Error('Falhou ao carregar ' + url));
    document.head.appendChild(s);
  });
}

// Limpa HTML pra texto puro preservando quebras
function _anaHtmlToText(html){
  if(!html) return '';
  const tmp = document.createElement('div');
  tmp.innerHTML = html;
  // Normaliza <br> e parágrafos
  tmp.querySelectorAll('br').forEach(b => b.replaceWith('\n'));
  tmp.querySelectorAll('p,div').forEach(p => p.appendChild(document.createTextNode('\n')));
  return (tmp.textContent || '').replace(/\n\s*\n+/g, '\n\n').trim();
}

// Lê estilos inline de um slide (cor de fundo do template, etc.)
function _anaLayoutColors(layoutId){
  // Mapeia o template em cores aproximadas pro PDF/PPTX
  const map = {
    'none':           { bg:'#FFFFFF', text:'#0F172A', sub:'#64748B' },
    'cream-exec':     { bg:'#F5F3EE', text:'#0F172A', sub:'#475569' },
    'editorial':      { bg:'#F8F8F5', text:'#0F172A', sub:'#475569' },
