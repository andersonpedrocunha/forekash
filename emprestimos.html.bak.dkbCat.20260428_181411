function clearRegistroKPIs(){
  ['reg-kpi-ef-parc','reg-kpi-ef-juros','reg-kpi-ef-amort','reg-kpi-ef-saldo','reg-kpi-count'].forEach(id=>{
    const el = document.getElementById(id);
    if(el){ el.textContent='—'; el.className='st-val'; }
  });
}

function updateRegistroKPIs(mes){
  let totEfParc=0, totEfSaldo=0, countEf=0, totEfJuros=0, totEfAmort=0;
  loans.forEach(l => {
    const reg = (l.registros||[]).find(r => r.mes === mes);
    if(reg){
      // Parcela principal + extras
      let parcLoan = 0;
      if(reg.parcelaEfetivada!==''&&reg.parcelaEfetivada!=null){ const v=parseFloat(reg.parcelaEfetivada)||0; totEfParc+=v; parcLoan+=v; }
      if(reg.jurosEfetivado !==''&&reg.jurosEfetivado !=null) totEfJuros += parseFloat(reg.jurosEfetivado)||0;
      if(reg.amortEfetivada !==''&&reg.amortEfetivada !=null) totEfAmort += parseFloat(reg.amortEfetivada)||0;
      for(const ex of (reg.extras||[])){
        if(ex.parcela !== '' && ex.parcela != null){ const v=parseFloat(ex.parcela)||0; totEfParc+=v; parcLoan+=v; }
        if(ex.juros   !== '' && ex.juros   != null) totEfJuros += parseFloat(ex.juros)||0;
        if(ex.amort   !== '' && ex.amort   != null) totEfAmort += parseFloat(ex.amort)||0;
      }
      if(reg.saldoEfetivado !==''&&reg.saldoEfetivado !=null) totEfSaldo += parseFloat(reg.saldoEfetivado)||0;
      // Conta o empréstimo se tem ALGUMA parcela > 0 (main ou extras).
      if(parcLoan > 0) countEf++;
    }
  });
  const efetivado = (typeof isMesEfetivado === 'function') ? isMesEfetivado(mes) : false;
  const set = (id, val, cls, keepStyle) => {
    const el = document.getElementById(id); if(!el) return;
    el.textContent = val;
    if(keepStyle){
      // Só atualiza texto — preserva style inline (cor) dos cards Juros/Amort
    } else {
      el.className = 'st-val'+(cls?' '+cls:'');
    }
  };
  const setSub = (id, txt) => {
    const el = document.getElementById(id); if(el) el.textContent = txt;
  };
  // Ratios sobre o total da parcela (útil pra entender composição)
  const pct = (v, base) => (base > 0 ? ((v/base)*100).toFixed(1) + '%' : '—');

  set('reg-kpi-ef-parc',  totEfParc  > 0 ? fmtBRL(totEfParc)  : '—');
  set('reg-kpi-ef-juros', totEfJuros > 0 ? fmtBRL(totEfJuros) : '—', null, true);
  set('reg-kpi-ef-amort', totEfAmort > 0 ? fmtBRL(totEfAmort) : '—', null, true);
  set('reg-kpi-ef-saldo', totEfSaldo > 0 ? fmtBRL(totEfSaldo) : '—', 'red');

  // "Empréstimos registrados" — só exibe número se mês está efetivado.
  // Conta apenas os loans que têm pelo menos uma parcela > 0 naquele mês.
  if(efetivado){
    set('reg-kpi-count', countEf > 0 ? (countEf + ' de ' + loans.length) : '0');
  } else {
    set('reg-kpi-count', '—');
  }

  // Subtítulos dinâmicos
  setSub('reg-kpi-ef-juros-sub', totEfParc > 0 ? (pct(totEfJuros, totEfParc) + ' da parcela') : 'custo financeiro');
  setSub('reg-kpi-ef-amort-sub', totEfParc > 0 ? (pct(totEfAmort, totEfParc) + ' da parcela') : 'redução da dívida');
  setSub('reg-kpi-count-sub',    efetivado
    ? (countEf > 0 ? ('com parcela > 0 em ' + mes) : 'nenhum com parcela > 0')
    : 'disponível após travar o mês');
}

// Estima juros e amortização a partir de uma parcela, usando saldo atual × taxa.
// Se saldo ou taxa forem zero, atribui tudo à amortização (neutro).
function _regEstimarSplit(loan, parcelaEfetivada){
  const p = parseFloat(parcelaEfetivada) || 0;
  if(p <= 0) return { juros: 0, amort: 0 };
  const saldo = parseFloat(loan.saldo) || 0;
  const taxa  = parseFloat(loan.taxa)  || 0;
  const i = taxa / 100;
  if(saldo <= 0 || i <= 0) return { juros: 0, amort: p };
  const juros = Math.min(p, saldo * i);
  const amort = Math.max(0, p - juros);
  return { juros, amort };
}

// ─── Lançamentos extras (múltiplos pagamentos no mesmo mês) ───
// Cada mês pode ter 1 lançamento principal (parcela regular) + N extras
// (parcela adicional ou amortização parcial). Extras ficam em reg.extras[].
function _regNextExtraId(){ return 'ex_' + Math.random().toString(36).slice(2,9) + Date.now().toString(36).slice(-3); }
function _ensureReg(loan, mes){
  if(!Array.isArray(loan.registros)) loan.registros = [];
  let reg = loan.registros.find(r => r.mes === mes);
  if(!reg){
    reg = {mes, parcelaEfetivada:'', saldoEfetivado:'', jurosEfetivado:'', amortEfetivada:'', extras:[], ts: new Date().toISOString()};
    loan.registros.push(reg);
  }
  if(!Array.isArray(reg.extras)) reg.extras = [];
  return reg;
}
