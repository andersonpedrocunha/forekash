// Lista oficial de categorias: tags de Estrutura + categorias fixas do sistema
function _extOfficialCats(tipo){
  const cats = new Set();
  if(tipo === 'ganho'){
    cats.add('Receita');
    cats.add('Comissões');
    cats.add('Outros recebimentos');
  } else {
    // Despesa: Folha, Impostos, Empréstimo + tags de Estrutura
    cats.add('Folha');
    cats.add('Impostos');
    cats.add('Empréstimo');
    try {
      if(typeof estrutura !== 'undefined' && estrutura && Array.isArray(estrutura.tags)){
        for(const t of estrutura.tags){
          const nm = (t.nome||'').trim();
          if(nm) cats.add(nm);
        }
      }
    } catch(_){}
    cats.add('Outros');
  }
  return Array.from(cats).sort((a,b) => a.localeCompare(b, 'pt', { sensitivity:'base' }));
}

