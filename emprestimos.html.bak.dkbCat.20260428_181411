async function delEstTag(id){
  const used = estrutura.itens.some(it => it.tagId === id);
  if(used){ toast('⚠️ Tag em uso — remova das despesas antes.'); return; }
  const t = estrutura.tags.find(x=>x.id===id);
  const ok = await showConfirm({
    title: 'Excluir tag',
    message: `Remover a tag <strong>${t?t.nome:id}</strong>?`,
    confirmLabel: 'Excluir', destructive: true
  });
  if(!ok) return;
  estrutura.tags = estrutura.tags.filter(t => t.id !== id);
  estSave();
  renderEstTagManager();
  renderEstrutura();
}
function toggleEstMgrSwatch(el, kind, id){
