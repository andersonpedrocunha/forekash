const _EXT_FORMAS_PG = ['Boleto bancário','Transferência (TED/DOC)','PIX','Cartão de crédito','Cartão de débito','Dinheiro','Cheque','Débito automático','Outros'];

let _extBaixaCtx = null;
let _extBxCompData = []; // comprovantes (multi)

// Preload: lê comprovantes existentes do item de origem
function _extBxCompPreload(it){
  try {
    if(!it) return [];
    if(it.id && it.id.startsWith && it.id.startsWith('m:')){
      const raw = it.raw || {};
      return _dkbNormalizeAnexos(raw.comprovante);
    }
    if(it.id && it.id.startsWith && it.id.startsWith('dkb:') && it.raw){
      const ctxId = it.raw.ctxId, itemId = it.raw.itemId, ym = it.raw.ym;
      const ad = (typeof DKB_ADAPTERS !== 'undefined') ? DKB_ADAPTERS[ctxId] : null;
      if(!ad) return [];
      const item = (ad.items() || []).find(x => x.id === itemId);
      if(!item) return [];
      const meta = (item.meta && item.meta[ym]) ? item.meta[ym] : {};
      return _dkbNormalizeAnexos(meta.comprovante);
    }
    if(it.id && it.id.startsWith && it.id.startsWith('rec:')){
      const raw = it.raw || {};
      return _dkbNormalizeAnexos(raw.comprovante);
    }
  } catch(_){}
  return [];
}

function _extBxCompChange(inp){
  if(typeof _dkbAnexoIngest !== 'function') return;
  _dkbAnexoIngest(inp, (newOnes) => {
    _extBxCompData = (_extBxCompData || []).concat(newOnes);
    const wrap = document.getElementById('ext-bx-comp-wrap');
    if(wrap) wrap.innerHTML = _dkbRenderAnexoUI(_extBxCompData, 'bx-comp');
    _extBxAutoPersist();
  });
}
function _extBxCompRemoveAt(idx){
  if(Array.isArray(_extBxCompData)) _extBxCompData.splice(idx, 1);
  const wrap = document.getElementById('ext-bx-comp-wrap');
  if(wrap) wrap.innerHTML = _dkbRenderAnexoUI(_extBxCompData, 'bx-comp');
  _extBxAutoPersist();
}
// Auto-persiste comprovante do extBaixa no item de origem (sync com DKB/RecKb/manual)
function _extBxAutoPersist(){
  try {
    const c = _extBaixaCtx;
    if(!c || !c.id) return;
    const id = c.id;
    const list = Array.isArray(_extBxCompData) ? _extBxCompData.slice() : [];
    if(id.startsWith('m:')){
      const realId = parseInt(id.replace(/^m:/, ''), 10);
      const l = (extratoData.lancamentos || []).find(x => x.id === realId);
      if(l){ if(list.length > 0) l.comprovante = list; else delete l.comprovante; if(typeof _extSave === 'function') _extSave(); }
    } else if(id.startsWith('dkb:')){
      const parts = id.split(':');
      const ctxId = parts[1], itemId = parts.slice(2, parts.length-1).join(':'), ym = parts[parts.length-1];
      const ad = DKB_ADAPTERS[ctxId];
      if(ad){
        const it = (ad.items() || []).find(x => String(x.id) === itemId || x.id === parseInt(itemId,10));
        if(it){
          const meta = _dkbMeta(it, ym);
          if(list.length > 0) meta.comprovante = list; else delete meta.comprovante;
          if(ad.save) ad.save();
        }
      }
    } else if(id.startsWith('rec:')){
      const parts = id.split(':');
      const y = parseInt(parts[1], 10), rowId = parseInt(parts[2], 10), mAbbr = parts[3];
      const d = receita && receita.years && receita.years[y];
      if(d){
        const row = (d.clients || []).find(r => r.id === rowId);
        if(row && row.meses && row.meses[mAbbr]){
          if(list.length > 0) row.meses[mAbbr].comprovante = list; else delete row.meses[mAbbr].comprovante;
          if(typeof receitaSave === 'function') receitaSave();
        }
      }
    }
  } catch(e){ console.warn('extBx auto-persist:', e); }
}
function _extBxCompOpenAt(idx){
  if(Array.isArray(_extBxCompData) && _extBxCompData[idx] && typeof _dkbOpenAttachment === 'function'){
    _dkbOpenAttachment(_extBxCompData[idx]);
  }
}
try {
  window._extBxCompChange = _extBxCompChange;
  window._extBxCompRemoveAt = _extBxCompRemoveAt;
  window._extBxCompOpenAt = _extBxCompOpenAt;
} catch(e){}

