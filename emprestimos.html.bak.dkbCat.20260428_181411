// ─── Tempo de empresa ────────────────────────────────
function parsePesDate(s){
  if(!s) return null;
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s).trim());
  if(!m) return null;
  const y = +m[1], mo = +m[2]-1, d = +m[3];
  const dt = new Date(y, mo, d);
  if(dt.getFullYear() !== y || dt.getMonth() !== mo || dt.getDate() !== d) return null;
  return dt;
}
function fmtPesDateBR(s){
  const d = parsePesDate(s);
  if(!d) return '';
  const dd = String(d.getDate()).padStart(2,'0');
  const mm = String(d.getMonth()+1).padStart(2,'0');
  return `${dd}/${mm}/${d.getFullYear()}`;
}
function computeTempoEmpresa(fromStr, toStr){
  const from = parsePesDate(fromStr);
  if(!from) return null;
  const to = parsePesDate(toStr) || new Date();
  // normaliza "hoje" para a meia-noite (consistente com o input date)
  const toD = new Date(to.getFullYear(), to.getMonth(), to.getDate());
  if(toD < from) return null;
  let anos = toD.getFullYear() - from.getFullYear();
  let meses = toD.getMonth() - from.getMonth();
  let dias = toD.getDate() - from.getDate();
  if(dias < 0){
    meses--;
    // dias no mês anterior ao toD
    const prev = new Date(toD.getFullYear(), toD.getMonth(), 0);
    dias += prev.getDate();
  }
  if(meses < 0){ anos--; meses += 12; }
  return { anos, meses, dias };
}
function fmtTempoEmpresa(t){
  if(!t) return '—';
  const parts = [];
  if(t.anos > 0)  parts.push(t.anos  + ' ano' + (t.anos  !== 1 ? 's' : ''));
  if(t.meses > 0) parts.push(t.meses + (t.meses === 1 ? ' mês' : ' meses'));
  if(t.anos === 0 && t.meses === 0){
    if(t.dias > 0) parts.push(t.dias + ' dia' + (t.dias !== 1 ? 's' : ''));
    else return 'menos de 1 dia';
  }
  return parts.join(' e ');
}
// Tier de tempo (0..4) para cor adaptativa do ícone
function pesTempoTier(t){
  if(!t) return 0;
  const anos = t.anos + (t.meses/12);
  if(anos < 1)  return 1; // novato (verde)
  if(anos < 3)  return 2; // >1 ano (âmbar)
  if(anos < 5)  return 3; // >3 anos (laranja)
  return 4;               // 5+ anos (dourado)
}
