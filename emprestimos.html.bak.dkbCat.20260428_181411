// Calcula o aumento absoluto mensal (em R$) que uma regra específica
// produz no mês em que entra em vigor. Usa as pessoas ativas do tipo e
// considera fatores de reajustes anteriores (cumulativo), respeitando o
// toggle "incluir simulados nos totais".
function pesReajSimIncreaseForRule(rule){
  if(!rule || !rule.key || !rule.pct) return 0;
  const includeSim = !!pessoas.includeSimInTotals;
  const people = (pessoas.people || []).filter(p => includeSim ? true : !p.sim);
  let inc = 0;
  const mult = 1 + (rule.pct / 100);
  for(const p of people){
    if(!p.ativo) continue;
    if(p.tipoId !== rule.tipoId) continue;
    const base = p.salarios && p.salarios[rule.key];
    if(!base) continue;
    // Fator acumulado INCLUINDO esta regra (pois key === rule.key, pesReajSimFactor a aplica).
    const fWith = pesReajSimFactor(p, rule.key);
    const salAfter  = base * fWith;
    const salBefore = salAfter / mult;
    inc += (salAfter - salBefore);
  }
  return inc;
}

// Banner de alerta com o resumo de reajustes programados (só aparece quando
// a simulação está ativa E existe pelo menos uma regra completa NO ANO ATIVO).
function renderPesReajSimBanner(){
  const el = document.getElementById('pes-reajsim-banner');
  if(!el) return;
  const sim = pessoas && pessoas.reajSim;
  const year = String(pesActiveYear || '');
  // Filtra só regras do ano atualmente selecionado na aba
  const rules = pesReajSimAllRules().filter(r => String(r.year) === year);
  const active = !!(sim && sim.enabled) && rules.length > 0;
  if(!active){
    el.style.display = 'none';
    el.innerHTML = '';
    return;
  }
  // Mapa tipoId → nome (para rotular cada item)
  const tipoNome = {};
  for(const t of (pessoas.tipos || [])){ tipoNome[t.id] = t.nome || t.id; }
  // Ordena por data e depois por tipo
  const sorted = rules.slice().sort((a,b)=>{
    if(a.key !== b.key) return a.key < b.key ? -1 : 1;
    const na = tipoNome[a.tipoId] || '';
    const nb = tipoNome[b.tipoId] || '';
    return na.localeCompare(nb,'pt-BR');
  });
  let totalInc = 0;
  const parts = sorted.map(r => {
    const [y, mStr] = String(r.key).split('-');
    const mi = Math.max(0, Math.min(11, (parseInt(mStr,10) || 1) - 1));
    const mes = (PES_MESES[mi] || '').toUpperCase();
    const pct = fmtBR(r.pct, 2) + '%';
    const nome = esc(tipoNome[r.tipoId] || r.tipoId);
    const inc  = pesReajSimIncreaseForRule(r);
    totalInc += inc;
    const incTxt = 'R$&nbsp;' + fmtBR(inc, 2);
    return `<span class="pes-sim-banner-item">
              <b>${nome}</b> +${pct} em ${mes}/${y}
              <span class="pes-sim-banner-inc">+${incTxt}/mês</span>
            </span>`;
  }).join('<span class="pes-sim-banner-sep">•</span>');
  const totalTxt = 'R$&nbsp;' + fmtBR(totalInc, 2);
  el.innerHTML = `
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
    <span><b>Reajuste ativo:</b></span>
    <span class="pes-sim-banner-list">${parts}</span>
    <span class="pes-sim-banner-total"><b>Total:</b>&nbsp;+${totalTxt}/mês</span>
    <span class="sp"></span>
    <a onclick="openPesReajSimModal()">editar</a>`;
  el.style.display = '';
}

// Aplica as regras de simulação aos salários base. Percorre todas as pessoas
// e todos os meses com valor > 0, multiplicando pelo fator cumulativo e
// gravando o resultado como novo salário base. Depois, limpa as regras
// e desliga o toggle (não há mais o que simular).
async function applyPesReajSimToData(){
  const rules = pesReajSimAllRules();
  if(!rules.length){
    await showInfo({ title:'Nada para aplicar', message:'Configure ao menos uma regra de reajuste antes de aplicar.', warning:true });
    return;
  }
  const byYear = {};
  for(const r of rules){ (byYear[r.year] = byYear[r.year] || []).push(r); }
  const years = Object.keys(byYear).sort();
  const summary = years.map(y => {
    const n = byYear[y].length;
    return `${y}: ${n} regra${n===1?'':'s'}`;
  }).join(' • ');
  const ok = await showConfirm({
    title: 'Aplicar reajuste aos salários?',
    message: `Isso vai <b>gravar os valores simulados como novo salário base</b> dos colaboradores, a partir do mês de cada regra.<br><br><b>Resumo:</b> ${esc(summary)}<br><br>As regras serão limpas e a simulação desligada. Esta ação não pode ser desfeita automaticamente.`,
    confirmLabel: 'Aplicar reajuste',
    cancelLabel: 'Cancelar',
    destructive: true
  });
  if(!ok) return;

  // Garante cálculo com a simulação considerada enabled, independente do toggle atual.
  const wasEnabled = pessoas.reajSim.enabled;
  pessoas.reajSim.enabled = true;
  for(const p of (pessoas.people || [])){
    const newSal = {};
    for(const k of Object.keys(p.salarios || {})){
      const v = p.salarios[k];
      if(v === undefined || v === null || v === 0) continue;
      newSal[k] = Math.round(v * pesReajSimFactor(p, k) * 100) / 100;
    }
    p.salarios = newSal;
  }
  // Limpa regras e desliga a simulação.
  pessoas.reajSim.enabled = false;
  pessoas.reajSim.rulesByYear = {};
  pessoasSave();
  closePesReajSimModal();
  await showInfo({
    title: 'Reajuste aplicado',
    message: `Os salários foram atualizados com ${rules.length} regra${rules.length===1?'':'s'} de reajuste. A simulação foi desligada.`
  });
}

