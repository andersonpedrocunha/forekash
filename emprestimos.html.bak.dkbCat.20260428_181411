// ─── Split amortização/juros estimado ───
// Empréstimo: simula a tabela Price ou SAC pra estimar o split de uma parcela.
function _extLoanParcelaSplit(loanId, idx){
  if(typeof loans === 'undefined' || !Array.isArray(loans)) return null;
  const ln = loans.find(x => x.id === loanId);
  if(!ln) return null;
  const taxa = (parseFloat(ln.taxa) || 0) / 100; // mensal em decimal
  const total = parseInt(ln.parcelas, 10) || 0;
  const parcela = parseFloat(ln.parcelaVal) || 0;
  if(parcela === 0) return { amortizacao: 0, juros: 0, parcela: 0, fonte: 'sem dados' };
  if(taxa === 0 || total === 0){
    return { amortizacao: parcela, juros: 0, parcela, fonte: 'sem juros' };
  }
  const isSAC = (typeof isSACEngine === 'function') ? isSACEngine(ln.tipo) : (String(ln.tipo||'').toLowerCase().includes('sac'));
  // Calcula saldo inicial pelo método de cálculo
  let saldoInicial = 0;
  if(isSAC){
    // SAC: parcela_n = (S/n) + (S - (n-1) * S/n) * i = (S/n) + (S * i * (n - n+1)/n)
    // Approx: usa estimativa baseada em parcela média
    // Resolve: parcela_1 (maior) = S/n + S*i = S * (1/n + i)
    // Sem saber qual é a parcela_1, usamos parcela média ≈ (parcela_1 + parcela_n) / 2
    // parcela_n = S/n + (S/n)*i = S/n * (1+i)
    // parcela_média ≈ (S * (1/n + i) + S/n * (1+i)) / 2 = S/n * ((1 + ni) + (1+i)) / 2
    // = S/n * (2 + i*(n+1)) / 2
    // S = parcela_média * 2n / (2 + i*(n+1))
    saldoInicial = parcela * 2 * total / (2 + taxa * (total + 1));
  } else {
    // Price: PV = parcela * (1 - (1+i)^-n) / i
    saldoInicial = parcela * (1 - Math.pow(1 + taxa, -total)) / taxa;
  }
  // Simula até a parcela idx (0-based)
  let saldo = saldoInicial;
  let amort = 0, juros = 0, parcelaCalc = parcela;
  const amortFix = saldoInicial / total;
  for(let i = 0; i <= idx; i++){
    juros = saldo * taxa;
    if(isSAC){
      amort = amortFix;
      parcelaCalc = amort + juros;
    } else {
      amort = parcela - juros;
      parcelaCalc = parcela;
    }
    if(amort < 0) amort = 0;
    if(juros < 0) juros = 0;
    saldo -= amort;
    if(saldo < 0) saldo = 0;
  }
  return { amortizacao: amort, juros: juros, parcela: parcelaCalc, fonte: isSAC ? 'SAC' : 'Price' };
}

