function diagLoadHistory(idx){
  const h = diagHistory[idx];
  if(!h || !h.result) return;
  // Re-gera alertas/narrativa/passos a partir do snapshot salvo para pegar
  // quaisquer atualizações de linguagem feitas após o salvamento. Se o
  // snapshot antigo não for compatível, cai para o texto armazenado.
  const r = h.result;
  try {
    if(r.snap && r.ind){
      const ml = r.ml || null;
      r.alerts = diagAlertas(r.snap, r.ind, ml);
      r.nar    = diagNarrativa(r.snap, r.ind, ml);
      r.passos = diagPassos(r.snap, r.ind, ml);
    }
  } catch(e){ console.warn('diagLoadHistory: falhou re-gerar texto, usando cache', e); }
  diagRenderResult(r, { elapsedMs: 0 });
  diagRenderHistory();
}

