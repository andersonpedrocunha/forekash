      </svg>
      <span class="fk-logo-text">FORE<em>KASH</em></span>
    </div>

    <div class="fk-tabs" role="tablist">
      <button type="button" class="active" data-fk-tab="login" role="tab">Entrar</button>
      <button type="button" data-fk-tab="signup" role="tab">Criar conta</button>
    </div>

    <div class="fk-panel active" id="fk-panel-login" role="tabpanel">
      <h2 id="fk-auth-title">Bom te ver de volta</h2>
      <div class="fk-panel-sub">Entre com suas credenciais pra continuar.</div>
      <form id="fk-login-form" autocomplete="on" novalidate>
        <div class="fk-field">
          <label for="fk-login-email">E-mail</label>
          <input type="email" id="fk-login-email" name="email" autocomplete="email" required placeholder="voce@empresa.com.br">
        </div>
        <div class="fk-field">
          <label for="fk-login-pass">Senha</label>
          <div class="fk-pass-wrap">
            <input type="password" id="fk-login-pass" name="password" autocomplete="current-password" required placeholder="••••••••">
            <button type="button" class="fk-pass-toggle" data-target="fk-login-pass" aria-label="Mostrar senha">
              <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <label class="fk-remember">
          <input type="checkbox" id="fk-login-remember" checked>
          Lembrar de mim neste dispositivo
        </label>
        <button type="submit" class="fk-cta" id="fk-login-btn">
          <span>Entrar</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <div class="fk-alert" id="fk-login-err"></div>
      </form>
    </div>

    <div class="fk-panel" id="fk-panel-signup" role="tabpanel">
      <h2>Crie sua conta grátis</h2>
      <div class="fk-panel-sub">Leva menos de um minuto. Você começa no plano FREE.</div>
      <form id="fk-signup-form" autocomplete="on" novalidate>
        <div class="fk-field">
          <label for="fk-signup-name">Nome</label>
          <input type="text" id="fk-signup-name" name="name" autocomplete="name" required placeholder="Como quer ser chamado">
        </div>
        <div class="fk-field">
          <label for="fk-signup-email">E-mail</label>
          <input type="email" id="fk-signup-email" name="email" autocomplete="email" required placeholder="voce@empresa.com.br">
        </div>
        <div class="fk-field">
          <label for="fk-signup-pass">Senha</label>
          <div class="fk-pass-wrap">
            <input type="password" id="fk-signup-pass" name="new-password" autocomplete="new-password" required minlength="6" placeholder="Mínimo 6 caracteres">
            <button type="button" class="fk-pass-toggle" data-target="fk-signup-pass" aria-label="Mostrar senha">
              <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <button type="submit" class="fk-cta" id="fk-signup-btn">
          <span>Criar conta grátis</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <div class="fk-alert" id="fk-signup-err"></div>
        <div class="fk-legal">Seus dados ficam salvos apenas no seu navegador. Nada vai pra nenhum servidor.</div>
      </form>
    </div>
  </div>
