// Variações de títulos por tema — sorteia uma a cada chamada
const TITLE_VARIATIONS = {
  clientes:    ['A Carteira em Movimento','Clientes que Sustentam o Negócio','Onde Está a Receita','Anatomia da Base Ativa','Quem Está Comprando — e Quanto'],
