// Calcula saldo e parcela projetados para um empréstimo em um mês relativo (mDiff = meses a partir de hoje)
function calcProjected(loan, mDiff){
  const saldo   = parseFloat(loan.saldo)    || 0;
  const parcela = parseFloat(loan.parcelaVal)|| 0;
  const taxa    = parseFloat(loan.taxa)      || 0;
  const r = taxa / 100;
  const today   = new Date(); today.setDate(1); today.setHours(0,0,0,0);
  const termino = loan.termino ? new Date(loan.termino+'T00:00:00') : null;
  const targetDt = new Date(today.getFullYear(), today.getMonth()+mDiff, 1);

  let saldoPrev = 0, parcelaPrev = parcela;

  if(mDiff === 0){
    saldoPrev = saldo;
  } else if(termino && targetDt > termino){
    saldoPrev = 0; parcelaPrev = 0;
  } else if(saldo === 0){
    saldoPrev = 0;
  } else if(parcela === 0){
    saldoPrev = saldo;
  } else if(r === 0){
    saldoPrev = Math.max(0, saldo - parcela * mDiff);
  } else if(isSACEngine(loan.tipo)){
    const mRest = termino
      ? Math.max(1,(termino.getFullYear()-today.getFullYear())*12+(termino.getMonth()-today.getMonth()))
      : null;
    const amort = mRest ? saldo/(mRest+1) : Math.max(0, parcela - saldo*r);
    saldoPrev   = Math.max(0, saldo - amort*mDiff);
    parcelaPrev = mDiff > 0 && amort > 0 ? amort + saldoPrev*r : parcela;
  } else {
    const factor = Math.pow(1+r, mDiff);
    saldoPrev = Math.max(0, saldo*factor - (parcela*(factor-1))/r);
  }
  return {saldoPrev, parcelaPrev};
}

function renderRegistro(){
  const mesEl = document.getElementById('reg-mes');
  if(!mesEl || !mesEl.value) return;
