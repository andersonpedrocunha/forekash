function recKbCardSave(){
  const ctx = _recKbModalCtx;
  if(!ctx) return;
  const { year, mesAbbr, rowId, minDate, maxDate } = ctx;
  const d = receita && receita.years && receita.years[year];
  if(!d) return;
  const row = (d.clients || []).find(x => x.id === rowId);
  if(!row || !row.meses || !row.meses[mesAbbr]) return;
  const cell = row.meses[mesAbbr];
  if(cell.valor === '' || cell.valor == null) return;

  const venc    = (document.getElementById('rec-kb-fld-venc')?.value    || '').trim();
  const receb   = (document.getElementById('rec-kb-fld-receb')?.value   || '').trim();
  const doc     = (document.getElementById('rec-kb-fld-doc')?.value     || '').trim();
  const emissao = (document.getElementById('rec-kb-fld-emissao')?.value || '').trim();
  const banco   = (document.getElementById('rec-kb-fld-banco-wrap')?.getAttribute('data-banco-id') || '').trim();
  const ccRaw   = (document.getElementById('rec-kb-fld-cc-wrap')?.getAttribute('data-cc-id') || document.getElementById('rec-kb-fld-cc')?.value || '').trim();
  const centroCustoId = ccRaw ? parseInt(ccRaw, 10) : null;
  const formaPg = (document.getElementById('rec-kb-fld-forma')?.value || '').trim();
  const parseN = (typeof _dkbParseNumBR === 'function') ? _dkbParseNumBR : (s => parseFloat(s)||0);
  const valorRecRaw = (document.getElementById('rec-kb-fld-valpago')?.value || '').trim();
  const valorRecNum = valorRecRaw === '' ? null : parseN(valorRecRaw);
  const jurosNum = parseN(document.getElementById('rec-kb-fld-juros')?.value);
  const multaNum = parseN(document.getElementById('rec-kb-fld-multa')?.value);
  const descNum = parseN(document.getElementById('rec-kb-fld-desc')?.value);

  if(doc)     cell.numeroDocumento = doc;     else delete cell.numeroDocumento;
  if(emissao) cell.dataEmissao     = emissao; else delete cell.dataEmissao;
  if(banco)   cell.banco           = banco;   else delete cell.banco;
  if(centroCustoId) cell.centroCustoId = centroCustoId; else delete cell.centroCustoId;
  if(formaPg) cell.formaPagamento = formaPg; else delete cell.formaPagamento;
  if(valorRecNum != null && isFinite(valorRecNum) && valorRecNum > 0) cell.valorPago = valorRecNum; else delete cell.valorPago;
  if(jurosNum > 0) cell.juros = jurosNum; else delete cell.juros;
  if(multaNum > 0) cell.multa = multaNum; else delete cell.multa;
  if(descNum > 0) cell.desconto = descNum; else delete cell.desconto;
  // Anexos (sempre array): documento (Detalhes) + comprovante (Recebimento)
  if(Array.isArray(_recKbAnexoData) && _recKbAnexoData.length > 0) cell.anexo = _recKbAnexoData.slice(); else delete cell.anexo;
  if(Array.isArray(_recKbCompData)  && _recKbCompData.length > 0)  cell.comprovante = _recKbCompData.slice(); else delete cell.comprovante;

  // Vencimento dentro do mês
  if(venc && (venc < minDate || venc > maxDate)){
    if(typeof toast === 'function') toast('⚠ Data de Vencimento deve estar dentro do mês de referência');
    return;
  }
  // Pra dar baixa (registrar recebimento), exige selecionar o banco
  if(receb && !banco){
    if(typeof toast === 'function') toast('⚠ Selecione o BANCO para dar baixa do recebimento');
    setTimeout(() => {
      const btn = document.getElementById('rec-kb-fld-banco-btn');
      if(btn){ btn.click(); btn.focus(); btn.scrollIntoView({block:'center', behavior:'smooth'}); }
    }, 50);
    return;
  }
  // Recebimento livre — pode atrasar.
  if(venc && receb && receb < venc){
    if(typeof toast === 'function') toast('ℹ Pagamento antecipado (antes do vencimento) — registrado mesmo assim');
  }

  if(venc) cell.dataVencimento = venc; else delete cell.dataVencimento;
  if(receb){
    cell.dataRecebimento = receb;
    cell.status = 'recebido';
  } else {
    delete cell.dataRecebimento;
    cell.status = 'aberto';
  }
  // Notas/anexos são gerenciados em tempo real (recKbNotaAdd/Delete) — não tocar aqui.

  // ─── Repetição: aplica o valor desta célula nos próximos meses do mesmo cliente ───
  try {
    const dataBase = venc || (year + '-' + String(REC_MESES.indexOf(mesAbbr)+1).padStart(2,'0') + '-01');
    const repCfg = _repReadCfg('rec', dataBase);
    if(repCfg && repCfg.mode !== 'once' && repCfg.count > 1){
      const f = _EXT_FREQ.find(x => x.id === repCfg.freq) || { mes:1 };
      const valNum = parseFloat(cell.valor) || 0;
      const m0Idx = REC_MESES.indexOf(mesAbbr);
      const y0 = parseInt(year, 10);
      let countCriado = 0;
      for(let i=1; i<repCfg.count; i++){
        const ymoTotal = m0Idx + i*f.mes;
        const yi = y0 + Math.floor(ymoTotal/12);
        const mi = ((ymoTotal % 12) + 12) % 12;
        const mAbbrTarget = REC_MESES[mi];
        // Garante que existe receita.years[yi]
        if(!receita.years[yi]) receita.years[yi] = { clients: [], leads: [] };
        if(!Array.isArray(receita.years[yi].clients)) receita.years[yi].clients = [];
        // Procura linha do mesmo cliente
        let rowTarget = receita.years[yi].clients.find(r => r.clienteId === row.clienteId);
        if(!rowTarget){
          if(!receita.years[yi].nextRowId) receita.years[yi].nextRowId = 1;
          rowTarget = { id: receita.years[yi].nextRowId++, clienteId: row.clienteId, nome: row.nome, pais: row.pais, descricao: row.descricao || '', meses: {} };
          receita.years[yi].clients.push(rowTarget);
        }
        if(!rowTarget.meses) rowTarget.meses = {};
        const cellTarget = rowTarget.meses[mAbbrTarget] || {};
        cellTarget.valor = valNum;
        if(banco) cellTarget.banco = banco; else delete cellTarget.banco;
        if(centroCustoId) cellTarget.centroCustoId = centroCustoId; else delete cellTarget.centroCustoId;
        if(doc) cellTarget.numeroDocumento = doc; else delete cellTarget.numeroDocumento;
        if(emissao) cellTarget.dataEmissao = emissao; else delete cellTarget.dataEmissao;
        // Vencimento ajustado
        if(venc){
          const day = venc.slice(8,10);
          const lastD = new Date(yi, mi+1, 0).getDate();
          const dd = Math.min(parseInt(day,10), lastD);
          cellTarget.dataVencimento = yi + '-' + String(mi+1).padStart(2,'0') + '-' + String(dd).padStart(2,'0');
        }
        // Repetições começam abertas
        cellTarget.status = 'aberto';
        delete cellTarget.dataRecebimento;
        delete cellTarget.valorPago;
        delete cellTarget.juros;
        delete cellTarget.multa;
        delete cellTarget.desconto;
        delete cellTarget.comprovante;
        rowTarget.meses[mAbbrTarget] = cellTarget;
        countCriado++;
      }
      if(countCriado > 0 && typeof toast === 'function'){
        setTimeout(() => toast('✓ Repetido em ' + countCriado + ' meses seguintes'), 50);
      }
    }
  } catch(e){ console.warn('rec repetição:', e); }

  // ─── Itens adicionais (rec-kb): cria entries em receita via auto-propagação ───
  try {
    const itensAdd = (Array.isArray(_recItems) ? _recItems : []).filter(x => (parseFloat(x.valor)||0) > 0);
    if(itensAdd.length > 0 && typeof _extAutoPropagate === 'function'){
      const mIdx = REC_MESES.indexOf(mesAbbr);
      const ymStr = year + '-' + String(mIdx+1).padStart(2,'0') + '-' + (venc ? venc.slice(8,10) : '01');
      let contaNome = '';
      try {
        if(banco && typeof dispo !== 'undefined' && Array.isArray(dispo.bancos)){
          const b = dispo.bancos.find(x => x.id === banco);
          if(b) contaNome = b.nome || '';
        }
      } catch(_){}
      // Cliente atual = nome da row
      const cliFallback = row.nome || '';
      const grupoId = 'g:' + Date.now() + ':' + Math.floor(Math.random()*9999);
      cell.grupoId = grupoId;
      let countCriado = 0;
      for(const it of itensAdd){
        const propResult = _extAutoPropagate({
          tipo: 'ganho',
          data: ymStr,
          valor: it.valor,
          descricao: it.descricao || ('Item adicional - ' + ymStr),
          categoria: it.categoria || '',
          contraparte: it.contraparte || cliFallback,
          conta: contaNome,
          status: receb ? 'pago' : 'pendente',
          notas: '',
          tipo: 'ganho',
          centroCustoId: centroCustoId,
          dataPagamento: receb,
          grupoId: grupoId
        });
        if(propResult && propResult.propagated) countCriado++;
      }
      if(countCriado > 0 && typeof toast === 'function'){
        setTimeout(() => toast('✓ ' + countCriado + ' item' + (countCriado>1?'ns':'') + ' adicionado' + (countCriado>1?'s':'') + ' à Receita'), 50);
      }
    }
  } catch(e){ console.warn('rec itens adicionais:', e); }

  if(typeof receitaSave === 'function') receitaSave();
  _recKbSyncSheetCell(year, mesAbbr, rowId);
  if(typeof updateRecTotals === 'function'){ try { updateRecTotals(); } catch(_){} }
  recKbCardClose();
  recRenderKanban();
  // Se o calendário está visível, atualiza ele também
  const calEl = document.getElementById('rec-view-calendar');
  if(calEl && calEl.style.display !== 'none' && typeof renderRecCalendar === 'function'){
    try { renderRecCalendar(); } catch(_){}
  }
  if(typeof toast === 'function') toast(receb ? '✓ Pagamento registrado em ' + (typeof fmtData === 'function' ? fmtData(receb) : receb) : '✓ Card atualizado');
}

