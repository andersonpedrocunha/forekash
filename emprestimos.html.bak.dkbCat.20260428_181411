function extOpenSource(id){
  if(typeof id === 'string' && id.startsWith('grp:')){ extEditGroup(id); return; }
  // Cartão: navega pra módulo Cartões e abre o detalhe da fatura do lançamento
  if(id && id.startsWith && id.startsWith('cartao:')){
    const lanId = parseInt(id.split(':')[1], 10);
    const lan = (typeof cartoes !== 'undefined' && Array.isArray(cartoes.lancamentos))
      ? cartoes.lancamentos.find(x => x.id === lanId) : null;
    if(lan){
      if(typeof switchModule === 'function'){
        const btn = document.querySelector('.sb-item[data-module="cartoes"]');
        switchModule('cartoes', btn || null);
      }
      setTimeout(() => {
        if(typeof cartOpenDetail === 'function') cartOpenDetail(lan.cartaoId);
        if(typeof cartViewFatura === 'function') setTimeout(() => cartViewFatura(lan.faturaId), 50);
      }, 60);
    }
    return;
  }
  if(id.startsWith('rec:')){
    if(typeof toast === 'function') toast('Abra o módulo Receita pra ver detalhes desse lançamento');
  } else if(id.startsWith('loan:')){
    if(typeof toast === 'function') toast('Abra a página principal (Empréstimos) pra editar este contrato');
  } else if(id.startsWith('dkb:')){
    if(typeof toast === 'function') toast('Use o módulo de origem (Estrutura/Pessoas/Impostos) pra editar');
  }
}

