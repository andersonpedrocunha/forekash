function showHist(id,type){
  const loan=loans.find(l=>l.id===id); if(!loan)return;
  const hist=(type==='saldo'?loan.saldoHist:loan.parcelaHist||[]).slice().reverse();
  const label=type==='saldo'?'Saldo Devedor':'Valor da Parcela';
  const banco=loan.banco==='— Digitar manualmente —'?(loan.bancoManual||'Manual'):(loan.banco||'Banco');
  document.getElementById('hist-title').textContent=`Histórico de ${label} — ${banco} · ${loan.descricao||'#'+id}`;
  const body=document.getElementById('hist-body');
  if(hist.length===0){ body.innerHTML=`<div class="no-hi">Nenhuma atualização registrada.</div>`; }
  else{
    body.innerHTML=hist.map((h,i)=>{
      let badge='';
      if(i===hist.length-1)badge=`<span class="badge b-blu">Inicial</span>`;
      else{const d=h.val-hist[i+1].val;badge=d<0?`<span class="badge b-grn">▼ ${fmtBRL(Math.abs(d))}</span>`:d>0?`<span class="badge b-red">▲ ${fmtBRL(d)}</span>`:`<span class="badge" style="background:#F3F4F6;color:#6B7280">Inalterado</span>`;}
      return `<div class="hi"><div style="display:flex;align-items:center;gap:8px"><span class="hi-val">${fmtBRL(h.val)}</span>${badge}</div><span class="hi-date">${fmtTsF(h.ts)}</span></div>`;
    }).join('');
  }
  document.getElementById('ov-hist').classList.add('open');
}

