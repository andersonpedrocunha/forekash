// Popula o multi-select de contas (com cartões em grupo separado).
// Filtra bancos cujos nomes coincidem com apelidos de cartão (evita duplicação).
function _extPopulateContas(){
  const wrap = document.getElementById('ext-conta-filter');
  if(!wrap) return;
  const cardNames = new Set();
  try {
    if(typeof cartoes !== 'undefined' && Array.isArray(cartoes.list)){
      for(const c of cartoes.list){
        const nm = (c.apelido || '').trim().toLowerCase();
        if(nm) cardNames.add(nm);
      }
    }
  } catch(e){}
  const set = new Set();
  // 1) Bancos: cada CONTA aparece como "Banco · Tipo" — separa caixa de reserva
  const bancosCaixa = []; // [{ id, label, value }]
  const reservas = [];     // [{ id, label, value }]
  try {
    if(typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.contas) && Array.isArray(dispo.tipos) && Array.isArray(dispo.bancos)){
      for(const c of dispo.contas){
        if(!c || c.ativo === false) continue;
        const banco = dispo.bancos.find(b => b.id === c.bancoId);
        if(!banco || !banco.nome) continue;
        if(cardNames.has(banco.nome.trim().toLowerCase())) continue; // pula nomes que batem com cartão
        const tp = dispo.tipos.find(t => t.id === c.tipoId);
        const tipoLbl = (tp && tp.nome) ? tp.nome : '';
        const composite = banco.nome + (tipoLbl ? ' · ' + tipoLbl : '');
        const isReserva = !!(tp && tp.liquidez === 'reserva');
        const item = { id: 'conta:' + c.id, label: composite, value: 'conta:' + c.id, banco: banco.nome, tipo: tipoLbl };
        if(isReserva) reservas.push(item);
        else bancosCaixa.push(item);
      }
      bancosCaixa.sort((a,b) => a.label.localeCompare(b.label,'pt'));
      reservas.sort((a,b) => a.label.localeCompare(b.label,'pt'));
    }
  } catch(e){}

  // 2) Contas vistas em lançamentos coletados (exclui cartões e nomes de cartão)
  try {
    const all = _extCollect();
    for(const it of all){
      if(it.sourceKind === 'cartao' || it.sourceKind === 'cartao-fatura') continue;
      if(!it.conta) continue;
      if(cardNames.has(it.conta.trim().toLowerCase())) continue;
      set.add(it.conta);
    }
  } catch(e){}
  // Estado de seleção
  const selected = new Set((Array.isArray(_extState.contas) ? _extState.contas : []).filter(Boolean));
  // Compat: incluir _extState.conta antigo (single)
  if(_extState.conta) selected.add(_extState.conta);
  // Lista de cartões disponíveis
  let cartList = [];
  try {
    if(typeof cartoes !== 'undefined' && Array.isArray(cartoes.list)){
      cartList = cartoes.list.filter(c => c.ativo !== false).slice().sort((a,b) => (a.apelido||'').localeCompare(b.apelido||'','pt'));
    }
  } catch(e){}
  // Search interno
  const search = (_extMultiSearch && _extMultiSearch.conta || '').toLowerCase().trim();
  // Constrói botão
  const totalSel = selected.size;
  let btnInner;
  if(totalSel === 0){
    btnInner = '<span class="ic">🏦</span><span class="nm placeholder">Todas as contas</span>';
  } else if(totalSel === 1){
    const only = [...selected][0];
    let lbl = only;
    if(only && only.startsWith('cartao:')){
      const id = parseInt(only.split(':')[1], 10);
      const cc = cartList.find(c => c.id === id);
      lbl = '💳 ' + (cc ? cc.apelido : 'Cartão');
    } else if(only && only.startsWith('reserva:')){
      const r = reservas.find(x => x.value === only || x.id === only);
      lbl = '📈 ' + (r ? r.label : 'Reserva');
    } else if(only && only.startsWith('conta:')){
      const b = bancosCaixa.find(x => x.value === only) || reservas.find(x => x.value === only);
      lbl = (b ? b.label : 'Conta');
    }
    btnInner = '<span class="ic">🏦</span><span class="nm">' + _extEsc(lbl) + '</span>';
  } else {
    btnInner = '<span class="ic">🏦</span><span class="nm">Contas</span><span class="badge">' + totalSel + '</span>';
  }
  // Lista de opções
  const bancos = [...set].sort((a,b) => a.localeCompare(b,'pt'));
  const filterBancos = search ? bancos.filter(n => n.toLowerCase().includes(search)) : bancos;
  const filterCartoes = search ? cartList.filter(c => (c.apelido||'').toLowerCase().includes(search)) : cartList;
  let listHtml = '';
  const filterBancosCheck = search ? bancosCaixa.filter(b => b.label.toLowerCase().includes(search)) : bancosCaixa;
  const filterReservasCheck = search ? reservas.filter(r => r.label.toLowerCase().includes(search)) : reservas;
  if(filterBancos.length === 0 && filterCartoes.length === 0 && filterBancosCheck.length === 0 && filterReservasCheck.length === 0){
    listHtml = '<div class="ext-multi-empty">' + (search ? 'Nenhum resultado para "' + _extEsc(search) + '"' : 'Sem dados disponíveis') + '</div>';
  } else {
    // Bancos cadastrados (com tipo) — cada conta como entrada individual
    const filterBancosContas = search ? bancosCaixa.filter(b => b.label.toLowerCase().includes(search)) : bancosCaixa;
    if(filterBancosContas.length > 0){
      listHtml += '<div style="padding:6px 8px 2px;font-size:.62rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.06em">🏦 Bancos</div>';
      for(const b of filterBancosContas){
        const isSel = selected.has(b.value);
        listHtml += '<button type="button" class="ext-multi-opt' + (isSel ? ' is-sel' : '') + '" '
          + 'onclick="event.stopPropagation();_extContaToggle(\'' + b.value + '\')">'
          + '<span class="chk"></span><span class="nm">' + _extEsc(b.label) + '</span>'
          + '</button>';
      }
    }

    if(filterCartoes.length > 0){
      listHtml += '<div style="padding:8px 8px 2px;font-size:.62rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.06em">💳 Cartões de crédito</div>';
      for(const c of filterCartoes){
        const v = 'cartao:' + c.id;
        const isSel = selected.has(v);
        listHtml += '<button type="button" class="ext-multi-opt' + (isSel ? ' is-sel' : '') + '" '
          + 'onclick="event.stopPropagation();_extContaToggle(\'' + v + '\')">'
          + '<span class="chk"></span><span class="nm">💳 ' + _extEsc(c.apelido || '') + '</span>'
          + '</button>';
      }
    }
    // Reservas por último
    const filterReservas = search ? reservas.filter(r => r.label.toLowerCase().includes(search)) : reservas;
    if(filterReservas.length > 0){
      listHtml += '<div style="padding:8px 8px 2px;font-size:.62rem;font-weight:800;color:#94A3B8;text-transform:uppercase;letter-spacing:.06em">📈 Reservas</div>';
      for(const r of filterReservas){
        const isSel = selected.has(r.value);
        listHtml += '<button type="button" class="ext-multi-opt' + (isSel ? ' is-sel' : '') + '" '
          + 'onclick="event.stopPropagation();_extContaToggle(\'' + r.value + '\')">'
          + '<span class="chk"></span><span class="nm">📈 ' + _extEsc(r.label) + '</span>'
          + '</button>';
      }
    }
  }
  wrap.innerHTML = '<button type="button" class="ext-multi-btn" onclick="event.stopPropagation();_extContaFilterToggle()">'
    + btnInner + '<span class="caret">▾</span>'
    + '</button>'
    + '<div class="ext-multi-list" id="ext-conta-filter-list" hidden>'
      + '<div class="ext-multi-search-wrap">'
        + '<input type="text" id="ext-conta-filter-search" placeholder="Buscar..." '
        + 'oninput="_extContaSearchInput(this.value)" '
        + 'onkeydown="event.stopPropagation()" '
        + 'onclick="event.stopPropagation()" '
        + 'value="' + _extEsc(_extMultiSearch.conta || '') + '">'
      + '</div>'
      + '<div class="ext-multi-actions">'
        + '<button type="button" onclick="event.stopPropagation();_extContaSelectAll()">Selecionar todas</button>'
        + '<button type="button" onclick="event.stopPropagation();_extContaClear()">Limpar</button>'
      + '</div>'
      + '<div class="ext-multi-options">' + listHtml + '</div>'
    + '</div>';
}
