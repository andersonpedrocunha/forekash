// ========= Extrato: próximas saídas / a pagar / atrasados =========
function mrcashExtratoProximas(snap){
  let lan = [];
  try {
    lan = (typeof extratoData !== 'undefined' && extratoData && Array.isArray(extratoData.lancamentos)) ? extratoData.lancamentos
        : (window.extratoData && Array.isArray(window.extratoData.lancamentos)) ? window.extratoData.lancamentos : [];
  } catch(_){}
  if(lan.length === 0){
    return `Nenhum lançamento em <b>Extrato Financeiro</b>.`;
  }
  const hoje = new Date(); hoje.setHours(0,0,0,0);
  const fimMes = new Date(hoje.getFullYear(), hoje.getMonth()+1, 0); fimMes.setHours(23,59,59,999);
  // Filtra por status pendente ou aberto e tipo saida
  const pendentes = lan.filter(l => {
    if(!l) return false;
    const status = (l.status||'').toString().toLowerCase();
    if(status === 'pago' || status === 'recebido' || status === 'cancelado') return false;
    return true;
  });
  if(pendentes.length === 0){
    return `Tudo em ordem — nenhum lançamento pendente em aberto. ✓`;
  }
  // Atrasadas (vencimento < hoje)
  const atrasadas = pendentes.filter(l => {
    const v = l.vencimento || l.data;
    if(!v) return false;
    const d = new Date(v + (v.length===10?'T00:00:00':''));
    return d < hoje;
  });
  // Esse mes
  const esseMes = pendentes.filter(l => {
    const v = l.vencimento || l.data;
    if(!v) return false;
    const d = new Date(v + (v.length===10?'T00:00:00':''));
    return d >= hoje && d <= fimMes;
  });
  let msg = `<b>Resumo dos lançamentos abertos no Extrato:</b>`;
  if(atrasadas.length > 0){
    const totA = atrasadas.reduce((s,l)=>s+Math.abs(parseFloat(l.valor)||0),0);
    msg += `<br><br>🚨 <b>${atrasadas.length} lançamento${atrasadas.length===1?'':'s'} atrasado${atrasadas.length===1?'':'s'}</b> totalizando <b>${fmtBRL(totA)}</b>:<ul style="margin:6px 0 0 18px">`;
    for(const l of atrasadas.slice(0,8)){
      const desc = (l.descricao || l.tipo || 'Sem descrição').toString().slice(0,50);
      const v = Math.abs(parseFloat(l.valor)||0);
      const venc = (l.vencimento || l.data || '').slice(0,10);
      const vencLbl = venc ? venc.split('-').reverse().join('/') : '';
      msg += `<li><b>${esc(desc)}</b> — ${fmtBRL(v)} <small style="color:var(--txl)">(venc. ${esc(vencLbl)})</small></li>`;
    }
    if(atrasadas.length > 8) msg += `<li style="opacity:.7">… e mais ${atrasadas.length-8}</li>`;
    msg += `</ul>`;
  }
  if(esseMes.length > 0){
    const totM = esseMes.reduce((s,l)=>s+Math.abs(parseFloat(l.valor)||0),0);
    msg += `<br><br>📅 <b>${esseMes.length} a vencer este mês</b> totalizando <b>${fmtBRL(totM)}</b>:<ul style="margin:6px 0 0 18px">`;
    const ord = esseMes.slice().sort((a,b)=>{
      const da = new Date((a.vencimento||a.data||'') + 'T00:00:00');
      const db = new Date((b.vencimento||b.data||'') + 'T00:00:00');
      return da-db;
    });
    for(const l of ord.slice(0,8)){
      const desc = (l.descricao || l.tipo || 'Sem descrição').toString().slice(0,50);
      const v = Math.abs(parseFloat(l.valor)||0);
      const venc = (l.vencimento || l.data || '').slice(0,10);
      const vencLbl = venc ? venc.split('-').reverse().join('/') : '';
      msg += `<li><b>${esc(desc)}</b> — ${fmtBRL(v)} <small style="color:var(--txl)">(venc. ${esc(vencLbl)})</small></li>`;
    }
    if(esseMes.length > 8) msg += `<li style="opacity:.7">… e mais ${esseMes.length-8}</li>`;
    msg += `</ul>`;
  }
  if(atrasadas.length === 0 && esseMes.length === 0){
    msg += `<br><br>Sem atrasos nem vencimentos para este mês — todos os pendentes estão em competências futuras.`;
  }
  return msg;
}

