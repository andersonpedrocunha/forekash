// ─── Sync Registro ↔ Extrato (loan.pagamentos) ───
// Converte mes "YYYY-MM" pra parcela idx (0-based) baseado no loan.inicio
function _loanIdxFromMes(loan, mes){
  if(!loan || !mes) return -1;
  const startStr = loan.inicio || '';
  const m = /^(\d{4})-(\d{2})$/.exec(mes);
  if(!m) return -1;
  let startY, startM;
  const sm = /^(\d{4})-(\d{2})-(\d{2})$/.exec(startStr);
  if(sm){ startY = parseInt(sm[1],10); startM = parseInt(sm[2],10); }
  else {
    // Sem inicio: usa o mes corrente como ref
    const t = new Date();
    startY = t.getFullYear(); startM = t.getMonth() + 1;
  }
  const targetY = parseInt(m[1],10), targetM = parseInt(m[2],10);
  const diff = (targetY - startY) * 12 + (targetM - startM);
  return Math.max(0, diff);
}
// Converte idx (0-based) pra mes "YYYY-MM"
function _loanMesFromIdx(loan, idx){
  if(!loan || idx == null || idx < 0) return '';
  const sm = /^(\d{4})-(\d{2})/.exec(loan.inicio || '');
  let y, m;
  if(sm){ y = parseInt(sm[1],10); m = parseInt(sm[2],10); }
  else {
    const t = new Date();
    y = t.getFullYear(); m = t.getMonth() + 1;
  }
  m += idx;
  while(m > 12){ m -= 12; y++; }
  while(m < 1){ m += 12; y--; }
  return y + '-' + String(m).padStart(2, '0');
}
// Resolve bancoId a partir de um nome (case-insensitive)
function _loanResolveBancoIdByNome(nome){
  if(!nome) return '';
  try {
    if(typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.bancos)){
      const n = nome.trim().toLowerCase();
      const b = dispo.bancos.find(x => (x.nome||'').trim().toLowerCase() === n);
      if(b) return b.id || '';
    }
  } catch(e){}
  return '';
}
// Sync: extrato → registro. Quando loan.pagamentos[idx] for atualizado, escreve no registros[mes] correspondente
function _loanSyncExtToReg(loan, idx, payment){
  if(!loan || !payment) return;
  const mes = _loanMesFromIdx(loan, idx);
  if(!mes) return;
  if(!Array.isArray(loan.registros)) loan.registros = [];
  let reg = loan.registros.find(r => r.mes === mes);
  if(!reg){
    reg = { mes, parcelaEfetivada:'', saldoEfetivado:'', jurosEfetivado:'', amortEfetivada:'', extras:[], ts: new Date().toISOString() };
    loan.registros.push(reg);
  }
  if(payment.valorPago != null) reg.parcelaEfetivada = parseFloat(payment.valorPago) || 0;
  if(payment.amortizacao != null) reg.amortEfetivada = parseFloat(payment.amortizacao) || 0;
  if(payment.jurosEmbutidos != null) reg.jurosEfetivado = parseFloat(payment.jurosEmbutidos) || 0;
  if(payment.data) reg.dataPagamento = payment.data;
  if(payment.conta){
    const bid = _loanResolveBancoIdByNome(payment.conta);
    if(bid) reg.bancoId = bid;
  }
  reg.ts = new Date().toISOString();
}
// Sync: registro → extrato. Quando registros[mes] muda, atualiza pagamentos[idx]
function _loanSyncRegToExt(loan, mes, reg){
  if(!loan || !mes || !reg) return;
  const idx = _loanIdxFromMes(loan, mes);
  if(idx < 0) return;
  if(!loan.pagamentos) loan.pagamentos = {};
  if(!loan.pagamentos[idx]) loan.pagamentos[idx] = {};
  const pg = loan.pagamentos[idx];
  if(reg.parcelaEfetivada !== '' && reg.parcelaEfetivada != null) pg.valorPago = parseFloat(reg.parcelaEfetivada) || 0;
  if(reg.amortEfetivada !== '' && reg.amortEfetivada != null) pg.amortizacao = parseFloat(reg.amortEfetivada) || 0;
  if(reg.jurosEfetivado !== '' && reg.jurosEfetivado != null) pg.jurosEmbutidos = parseFloat(reg.jurosEfetivado) || 0;
  if(reg.dataPagamento) pg.data = reg.dataPagamento;
  if(reg.bancoId){
    try {
      if(typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.bancos)){
        const b = dispo.bancos.find(x => x.id === reg.bancoId);
        if(b) pg.conta = b.nome || '';
      }
    } catch(e){}
  }
  // Se tem dataPagamento e parcelaEfetivada, considera paga (atualiza parcelasPagas se for sequencial)
  const pagasAtual = parseInt(loan.parcelasPagas, 10) || 0;
  const temPagamento = (reg.parcelaEfetivada !== '' && reg.parcelaEfetivada != null && parseFloat(reg.parcelaEfetivada) > 0)
                    || reg.dataPagamento;
  if(temPagamento && idx === pagasAtual){
    loan.parcelasPagas = pagasAtual + 1;
  }
}
