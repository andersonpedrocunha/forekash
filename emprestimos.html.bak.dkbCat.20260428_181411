  const d = receita && receita.years && receita.years[ctx.year];
  if(!d) return null;
  const row = (d.clients || []).find(x => x.id === ctx.rowId);
  if(!row || !row.meses) return null;
  return row.meses[ctx.mesAbbr] || null;
}

function _recKbNotesRenderInline(){
  const cell = _recKbModalCellRef();
  if(!cell) return;
  const list = _recKbNormalizeNotas(cell);
  const wrap = document.getElementById('rec-kb-notas-list');
  if(!wrap) return;
  if(!list.length){
    wrap.innerHTML = '';
    wrap.style.display = 'none';
    return;
  }
  wrap.style.display = '';
  // Mais recentes primeiro
  const sorted = list.map((n, i) => ({n, i})).sort((a, b) => (b.n.ts || '').localeCompare(a.n.ts || ''));
  let html = '';
  for(const {n, i} of sorted){
    const dt = n.ts ? new Date(n.ts) : null;
    const fmtDt = dt && !isNaN(dt.getTime())
      ? dt.toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' })
      : '—';
    let anex = '';
    if(n.anexo && n.anexo.data){
      const isImg = n.anexo.type && n.anexo.type.startsWith('image/');
      const ico = isImg ? '🖼' : (n.anexo.type === 'application/pdf' ? '📄' : '📎');
      const nm = (n.anexo.name || 'arquivo');
      const short = nm.length > 28 ? (nm.slice(0, 26) + '…') : nm;
      anex = '<div class="rec-kb-nota-anex-wrap">'
           + '<button type="button" class="rec-kb-nota-anex" onclick="event.stopPropagation();recKbNotaAnexoView(' + i + ')" title="' + _recKbEsc(nm) + '">'
           + ico + ' ' + _recKbEsc(short) + '</button>'
           + '</div>';
    }
    const txtHtml = n.text ? '<div class="rec-kb-nota-text">' + _recKbEsc(n.text) + '</div>' : '';
    html += '<div class="rec-kb-nota">'
          + '<div class="rec-kb-nota-hd">'
          +   '<span class="ts">🕒 ' + fmtDt + '</span>'
          +   '<button type="button" class="rec-kb-nota-del" onclick="event.stopPropagation();recKbNotaDelete(' + i + ')" title="Excluir nota">✕</button>'
          + '</div>'
          + txtHtml
          + anex
          + '</div>';
  }
  wrap.innerHTML = html;
}

function recKbNotaAttachClick(){
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = 'image/*,application/pdf,.txt,.csv,.json';
  inp.style.display = 'none';
  inp.onchange = () => recKbNotaAttachFile(inp);
  document.body.appendChild(inp);
  inp.click();
  setTimeout(() => { try { document.body.removeChild(inp); } catch(_){} }, 1500);
}

function recKbNotaAttachFile(input){
  const file = input && input.files && input.files[0];
  if(!file) return;
  if(file.size > _REC_KB_ANEXO_MAX){
    if(typeof toast === 'function') toast('⚠ Arquivo grande demais (máx 1 MB)');
    return;
  }
  const reader = new FileReader();
  reader.onload = (e) => {
    _recKbNewAnexo = { name: file.name, type: file.type || 'application/octet-stream', data: e.target.result, size: file.size };
    _recKbRenderAnexoChip();
  };
  reader.onerror = () => { if(typeof toast === 'function') toast('Erro ao ler arquivo'); };
  reader.readAsDataURL(file);
}

function _recKbRenderAnexoChip(){
  const ch = document.getElementById('rec-kb-nota-anexo-chip');
  if(!ch) return;
  if(!_recKbNewAnexo){ ch.innerHTML = ''; ch.style.display = 'none'; return; }
  ch.style.display = 'inline-flex';
  const isImg = _recKbNewAnexo.type && _recKbNewAnexo.type.startsWith('image/');
  const ico = isImg ? '🖼' : (_recKbNewAnexo.type === 'application/pdf' ? '📄' : '📎');
  const nm = _recKbNewAnexo.name || '';
  const short = nm.length > 24 ? (nm.slice(0, 22) + '…') : nm;
  ch.innerHTML = ico + ' ' + _recKbEsc(short)
    + ' <button type="button" onclick="recKbNotaClearAnexo()" title="Remover anexo selecionado">✕</button>';
