        ind({cls:'amber', lbl:'Break-even', val:fmtPct(x.breakEven), sub:'<span class="status ' + stBE.s + '">' + stBE.l + '</span>', help:'% da receita consumida pelos custos operacionais. Acima de 100% = prejuízo operacional'}),
        ind({cls: stMarg.s==='ok'?'good':stMarg.s==='att'?'warn':'bad', lbl:'Margem EBITDA', val:fmtPct(k.margem), sub:'<span class="status ' + stMarg.s + '">' + stMarg.l + '</span>', help:'EBITDA dividido pela receita. Saudável > 15% (varia por setor)'}),
        ind({cls:'purp',  lbl:'Total Custos Op.', val:fmt(x.totalCustos), sub:'folha + estrutura + comissões + empréstimos', help:'Custos operacionais totais somados no período'})
      ])
