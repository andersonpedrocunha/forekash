// ─── DnD do PIVOT ─────────────────────────────────────────
let _anaPvDrag = null;  // { source:'lib'|'zone', fieldId, fromZone?, fromIdx? }
function _anaPvDragStartLib(e, fieldId){
  _anaPvDrag = { source:'lib', fieldId };
  try { e.dataTransfer.effectAllowed = 'copyMove'; } catch(_){}
  try { e.dataTransfer.setData('text/plain', 'pv-lib:' + fieldId); } catch(_){}
  e.currentTarget.classList.add('dragging');
}
function _anaPvDragStartChip(e, fromZone, fromIdx, fieldId){
  _anaPvDrag = { source:'zone', fieldId, fromZone, fromIdx };
  try { e.dataTransfer.effectAllowed = 'move'; } catch(_){}
  try { e.dataTransfer.setData('text/plain', 'pv-chip:' + fromZone + ':' + fromIdx); } catch(_){}
  e.stopPropagation();
  e.currentTarget.classList.add('dragging');
}
function _anaPvDragEnd(e){
  _anaPvDrag = null;
  document.querySelectorAll('.ana-field-chip,.ana-zone-chip,.ana-zone,.ana-pivot-fields')
    .forEach(el => el.classList.remove('dragging','drop-active'));
}
function _anaPvDragOverZone(e, zone){
  if(!_anaPvDrag) return;
  const f = ANA_FIELDS.find(x => x.id === _anaPvDrag.fieldId);
  if(!f) return;
  if(zone === 'values' && f.kind !== 'val') return;
  if((zone === 'rows' || zone === 'cols') && f.kind !== 'dim') return;
  e.preventDefault();
  e.dataTransfer.dropEffect = _anaPvDrag.source === 'lib' ? 'copy' : 'move';
  e.currentTarget.classList.add('drop-active');
}
function _anaPvDragLeaveZone(e){
  if(!e.currentTarget.contains(e.relatedTarget)){
    e.currentTarget.classList.remove('drop-active');
  }
}
function _anaPvDropZone(e, zone){
  if(!_anaPvDrag) return;
  const f = ANA_FIELDS.find(x => x.id === _anaPvDrag.fieldId);
  if(!f) return;
  if(zone === 'values' && f.kind !== 'val') return;
  if((zone === 'rows' || zone === 'cols') && f.kind !== 'dim') return;
  e.preventDefault();
  e.stopPropagation();
  if(_anaPvDrag.source === 'lib'){
    if(zone === 'values'){
      _anaState.pivot.values.push({ field: f.id, agg: f.defaultAgg || 'sum' });
    } else {
      if(!_anaState.pivot[zone].includes(f.id)){
        _anaState.pivot[zone].push(f.id);
      }
    }
  } else {
    const fromZone = _anaPvDrag.fromZone;
    const fromIdx  = _anaPvDrag.fromIdx;
    if(fromZone === 'values'){
      if(zone !== 'values'){ _anaPvDrag = null; _anaSaveState(); renderAnaliseModule(); return; }
      const item = _anaState.pivot.values.splice(fromIdx, 1)[0];
      _anaState.pivot.values.push(item);
    } else {
      if(zone === 'values'){ _anaPvDrag = null; _anaSaveState(); renderAnaliseModule(); return; }
      const item = _anaState.pivot[fromZone].splice(fromIdx, 1)[0];
      if(zone === fromZone){
        _anaState.pivot[zone].push(item);
      } else {
        if(!_anaState.pivot[zone].includes(item)){
          _anaState.pivot[zone].push(item);
        }
      }
    }
  }
  _anaPvDrag = null;
  _anaSaveState();
  renderAnaliseModule();
}
function _anaPvDragOverLib(e){
  if(!_anaPvDrag || _anaPvDrag.source !== 'zone') return;
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  e.currentTarget.classList.add('drop-active');
}
function _anaPvDragLeaveLib(e){
  if(!e.currentTarget.contains(e.relatedTarget)){
    e.currentTarget.classList.remove('drop-active');
  }
}
function _anaPvDropLib(e){
  if(!_anaPvDrag || _anaPvDrag.source !== 'zone') return;
  e.preventDefault();
  if(_anaPvDrag.fromZone === 'values'){
    _anaState.pivot.values.splice(_anaPvDrag.fromIdx, 1);
  } else {
    _anaState.pivot[_anaPvDrag.fromZone].splice(_anaPvDrag.fromIdx, 1);
  }
  _anaPvDrag = null;
  _anaSaveState();
  renderAnaliseModule();
}
