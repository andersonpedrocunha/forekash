function _anaCustomDragStart(e, id){
  _anaCustomDraggingId = id;
  _anaCustomDraggingLib = null;
  e.dataTransfer.effectAllowed = 'move';
  try { e.dataTransfer.setData('text/plain', String(id)); } catch(err){}
  // Adiciona classe dragging no widget
  const el = e.currentTarget;
  setTimeout(() => el.classList.add('dragging'), 0);
}
function _anaCustomDragOver(e, id){
  // Drag de library: aceita drop pra REPLACE
  if(_anaCustomDraggingLib){
    e.preventDefault();
    e.dataTransfer.dropEffect = 'copy';
    e.stopPropagation();
    const el = e.currentTarget;
    if(!el.classList.contains('drop-replace')) el.classList.add('drop-replace');
    return;
  }
  // Drag interno (reordenar) — quando flow é por célula explícita,
  // o dragOver no widget fica como visual mas o drop real vai pro canvas
  if(_anaCustomDraggingId == null || _anaCustomDraggingId === id) return;
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  const el = e.currentTarget;
  const rect = el.getBoundingClientRect();
  const mid = rect.left + rect.width / 2;
  const before = e.clientX < mid;
  // Só aplica classe se ainda não tem (evita flicker do toggle)
  const wantClass = before ? 'drop-before' : 'drop-after';
  const otherClass = before ? 'drop-after' : 'drop-before';
  if(el.classList.contains(otherClass)) el.classList.remove(otherClass);
  if(!el.classList.contains(wantClass)) el.classList.add(wantClass);
}
function _anaCustomDragLeave(e, id){
  const el = e.currentTarget;
  if(!el.contains(e.relatedTarget)){
    el.classList.remove('drop-before','drop-after','drop-replace');
  }
}
function _anaCustomDrop(e, targetId){
  e.preventDefault();
  e.stopPropagation();
  // Caso 1: drop de library = SUBSTITUIR widget alvo
  if(_anaCustomDraggingLib){
    const arr = _anaState.custom;
    const tgt = arr.find(w => w.id === targetId);
    if(tgt && ANA_WIDGETS[_anaCustomDraggingLib]){
      tgt.widget = _anaCustomDraggingLib;
      // Mantém cols atual; mas se widget novo tem default maior, opcionalmente atualiza
      // (deixamos como está pra não surpreender o user)
      _anaSaveState();
      _anaCustomCleanupDrag();
      _anaRenderCustom();
      try { if(typeof toast === 'function') toast('🔄 Widget substituído'); } catch(_){}
    }
    return;
  }
  // Caso 2: drop interno = REORDENAR
  const srcId = _anaCustomDraggingId;
  if(srcId == null || srcId === targetId){
    _anaCustomCleanupDrag();
    return;
  }
  const arr = _anaState.custom;
  const srcIdx = arr.findIndex(w => w.id === srcId);
  const tgtIdx = arr.findIndex(w => w.id === targetId);
  if(srcIdx < 0 || tgtIdx < 0){ _anaCustomCleanupDrag(); return; }
  const el = e.currentTarget;
  const rect = el.getBoundingClientRect();
  const mid = rect.left + rect.width / 2;
  const before = e.clientX < mid;
  const [moved] = arr.splice(srcIdx, 1);
  let newTgt = arr.findIndex(w => w.id === targetId);
  if(newTgt < 0) newTgt = 0;
  arr.splice(before ? newTgt : newTgt + 1, 0, moved);
  _anaSaveState();
  _anaCustomCleanupDrag();
  _anaRenderCustom();
}
function _anaCustomDragEnd(e){
  _anaCustomCleanupDrag();
}
function _anaCustomCleanupDrag(){
  _anaCustomDraggingId = null;
  _anaCustomDraggingLib = null;
  if(_anaDragRAF){ cancelAnimationFrame(_anaDragRAF); _anaDragRAF = null; }
  _anaDragLastEv = null;
  _anaCustomLastPhIdx = -1;
  document.querySelectorAll('.ana-custom-widget').forEach(w => {
    w.classList.remove('dragging','drop-before','drop-after','drop-replace');
  });
  document.querySelectorAll('.ana-lib-chip').forEach(c => c.classList.remove('dragging'));
  const canvas = document.getElementById('ana-custom-canvas');
  if(canvas){
    canvas.classList.remove('drop-active');
    canvas.classList.remove('dragging-active');
  }
}
try {
  window._anaCustomDragStart = _anaCustomDragStart;
  window._anaCustomDragOver  = _anaCustomDragOver;
  window._anaCustomDragLeave = _anaCustomDragLeave;
  window._anaCustomDrop      = _anaCustomDrop;
  window._anaCustomDragEnd   = _anaCustomDragEnd;
} catch(e){}

// ─── Render do canvas customizado ───
// Resize observer global pros canvases dos charts — força chart.resize()
// quando o tamanho do widget muda (ex: usuário ajustou cols/rows)
let _anaResizeObs = null;
function _anaSetupResizeObs(){
  if(_anaResizeObs || typeof ResizeObserver === 'undefined') return;
  _anaResizeObs = new ResizeObserver((entries) => {
    for(const en of entries){
      const canvas = en.target.querySelector('canvas');
      if(!canvas) continue;
      const inst = _anaChartInstances && _anaChartInstances[canvas.id];
      if(inst && typeof inst.resize === 'function'){
        try { inst.resize(); } catch(_){}
      }
    }
  });
}
function _anaObserveBodies(){
  _anaSetupResizeObs();
  if(!_anaResizeObs) return;
  document.querySelectorAll('.ana-cw-body').forEach(body => {
    try { _anaResizeObs.unobserve(body); } catch(_){}
    try { _anaResizeObs.observe(body); } catch(_){}
  });
}

function _anaRenderCustom(){
  // Renderiza library sidebar (sempre visível)
  if(typeof _anaCustomLibRender === 'function') _anaCustomLibRender();
  const canvas = document.getElementById('ana-custom-canvas');
  const stat = document.getElementById('ana-custom-stat');
  if(!canvas) return;
  // Destrói charts antigos do custom
  for(const k of Object.keys(_anaCustomChartInst)){
    try { _anaCustomChartInst[k] && _anaCustomChartInst[k].destroy(); } catch(e){}
  }
  _anaCustomChartInst = {};
  if(_anaState.custom.length === 0){
    canvas.innerHTML = '';
    if(stat) stat.textContent = '0 widgets';
    return;
  }
  // Renderiza cada widget
  const facts = _anaCollectFacts();
  const k = _anaCalcKPIs(facts);
  const x = _anaCalcIndicadoresExtra(k, facts);
  const s = _anaCalcSeries(facts);
  // Monta primeiro o HTML dos containers, depois renderiza cada widget no seu container
  canvas.innerHTML = _anaState.custom.map((it, i) => {
    const w = ANA_WIDGETS[it.widget];
    const lbl = w ? w.label : '(widget removido)';
    const cols = it.cols || 1;
    const isFirst = i === 0;
    const isLast = i === _anaState.custom.length - 1;
    const rows = it.rows || 1;
    const styleParts = [];
    if(it.colStart) styleParts.push('grid-column:' + it.colStart + ' / span ' + cols);
    if(it.rowStart) styleParts.push('grid-row:' + it.rowStart + ' / span ' + rows);
    const styleAttr = styleParts.length ? ' style="' + styleParts.join(';') + '"' : '';
    return '<div class="ana-custom-widget ana-cw-cols-' + cols + ' ana-cw-rows-' + rows + '" data-cw-id="' + it.id + '"' + styleAttr + ' draggable="true"'
      +   ' ondragstart="_anaCustomDragStart(event, ' + it.id + ')"'
      +   ' ondragover="_anaCustomDragOver(event, ' + it.id + ')"'
      +   ' ondragleave="_anaCustomDragLeave(event, ' + it.id + ')"'
      +   ' ondrop="_anaCustomDrop(event, ' + it.id + ')"'
      +   ' ondragend="_anaCustomDragEnd(event)">'
      + '<div class="ana-cw-hd">'
      +   '<span class="ana-cw-drag" title="Arraste pra reposicionar">⠿</span>'
      +   '<span class="ana-cw-cols-pick" title="Colunas (largura)">'
      +     [1,2,3,4].map(n => '<button class="' + (cols===n?'active':'') + '" onclick="anaCustomResize(' + it.id + ',' + n + ')" title="' + n + ' col' + (n>1?'s':'') + '" draggable="false">' + n + '</button>').join('')
      +   '</span>'
      +   '<span class="ana-cw-rows-pick" title="Linhas (altura)">'
      +     [1,2,3,4].map(n => '<button class="' + (rows===n?'active':'') + '" onclick="anaCustomResizeRows(' + it.id + ',' + n + ')" title="' + n + ' linha' + (n>1?'s':'') + ' (altura)" draggable="false">' + n + 'h</button>').join('')
      +   '</span>'
      +   ((it.colStart || it.rowStart) ? '<button class="ctrl" onclick="anaCustomUnpin(' + it.id + ')" title="Voltar ao auto-flow (desfixar posição)" draggable="false" style="color:#0891B2;flex-shrink:0">📌</button>' : '')
      +   '<span class="label" title="' + esc(lbl) + '">' + esc(lbl) + '</span>'
      +   '<button class="ctrl del" onclick="anaCustomRemove(' + it.id + ')" title="Remover widget" draggable="false">✕</button>'
      + '</div>'
      + '<div class="ana-cw-body" id="ana-cw-body-' + it.id + '"></div>'
      + '</div>';
  }).join('');
  // Renderiza cada widget no seu body
  for(const it of _anaState.custom){
    const w = ANA_WIDGETS[it.widget];
    const body = document.getElementById('ana-cw-body-' + it.id);
    if(!w || !body) continue;
    try {
      w.render(body, { facts, k, x, s, uid: it.id });
    } catch(e){
      console.warn('Widget render erro:', it.widget, e);
      body.innerHTML = '<div style="color:#9CA3AF;font-size:.74rem;font-style:italic;padding:10px">Erro ao renderizar</div>';
    }
  }
  if(stat) stat.textContent = _anaState.custom.length + ' widget' + (_anaState.custom.length===1?'':'s');
  _anaUpdateActiveLabel();
  _anaApplyMode();
  _anaApplyFlow();
  // Configura observer pra forçar resize dos charts em mudanças de tamanho
  _anaObserveBodies();
}
