  }
  wrap.innerHTML = '<button type="button" class="ext-multi-btn" onclick="event.stopPropagation();_extMultiToggle(\'' + kind + '\')">'
    + btnInner + '<span class="caret">▾</span>'
    + '</button>'
    + '<div class="ext-multi-list" id="' + cfg.listId + '" hidden>'
      + '<div class="ext-multi-search-wrap">'
        + '<input type="text" id="' + cfg.searchId + '" placeholder="Buscar..." '
        + 'oninput="_extMultiSearchInput(\'' + kind + '\',this.value)" '
        + 'onkeydown="event.stopPropagation()" '
        + 'onclick="event.stopPropagation()" '
        + 'value="' + _extEsc(_extMultiSearch[kind] || '') + '">'
      + '</div>'
      + '<div class="ext-multi-actions">'
        + '<button type="button" onclick="event.stopPropagation();_extMultiSelectAll(\'' + kind + '\')">Selecionar todos</button>'
        + '<button type="button" onclick="event.stopPropagation();_extMultiClear(\'' + kind + '\')">Limpar</button>'
      + '</div>'
      + '<div class="ext-multi-options">' + listHtml + '</div>'
    + '</div>';
}
