let _fcardOpenId = null;
let _fcardTab = 'dados';

function openFornecedorCard(pid){
  const reg = (typeof pesRegistry === 'function') ? pesRegistry().find(r => r.id === pid) : null;
  if(!reg){ if(typeof toast === 'function') toast('Fornecedor não encontrado'); return; }
  if(typeof reg.tipoPessoa !== 'string' || !['pf','pj','est'].includes(reg.tipoPessoa)) reg.tipoPessoa = 'pj';
  if(typeof reg.razaoSocial !== 'string') reg.razaoSocial = '';
  if(typeof reg.cnpj !== 'string') reg.cnpj = '';
  if(typeof reg.cpf !== 'string') reg.cpf = '';
  if(typeof reg.taxId !== 'string') reg.taxId = '';
  if(typeof reg.nomeLegal !== 'string') reg.nomeLegal = '';
  if(typeof reg.nacionalidade !== 'string') reg.nacionalidade = '';
  if(typeof reg.email !== 'string') reg.email = '';
  if(typeof reg.telefone !== 'string') reg.telefone = '';
  if(typeof reg.notas !== 'string') reg.notas = '';
  if(!reg.bancoPag || typeof reg.bancoPag !== 'object'){
    reg.bancoPag = { banco:'', agencia:'', conta:'', tipo:'corrente', pix:'' };
  }
  if(typeof reg.ativo !== 'boolean') reg.ativo = true;
  if(!Array.isArray(reg.tags)) reg.tags = [];
  if(!Array.isArray(reg.anexos)) reg.anexos = [];
  if(typeof reg.foto !== 'string') reg.foto = '';
  _fcardOpenId = pid;
  _fcardTab = 'dados';
  _fcardRender();
  const ov = document.getElementById('ov-forn-card');
  if(ov) ov.classList.add('open');
}
function closeFornecedorCard(){
  // Cleanup de draft: se criado por "+ Novo fornecedor" e nome ainda vazio, remove.
  try {
    if(_fcardOpenId != null){
      // Salva possíveis edits pendentes nos inputs primeiro
      if(typeof _fcardCommitInputs === 'function') _fcardCommitInputs();
      const reg = pesRegistry().find(r => r.id === _fcardOpenId);
      if(reg){
        const nomeVazio = !reg.nome || !reg.nome.trim();
        if(reg._draft && nomeVazio){
          pessoas.registry = pessoas.registry.filter(r => r.id !== reg.id);
          if(typeof pessoasSave === 'function') pessoasSave();
          if(typeof renderWfFornecedores === 'function') renderWfFornecedores();
        } else if(reg._draft){
          delete reg._draft;
          if(typeof pessoasSave === 'function') pessoasSave();
          if(typeof renderWfFornecedores === 'function') renderWfFornecedores();
        }
      }
    }
  } catch(e){}
  const ov = document.getElementById('ov-forn-card');
  if(ov) ov.classList.remove('open');
  _fcardOpenId = null;
}
function _fcardSetTab(tab){
  _fcardCommitInputs();
  _fcardTab = tab;
  _fcardRender();
}
function _fcardEsc(s){
  return String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
