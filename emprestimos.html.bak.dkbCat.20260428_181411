// Reverte o status sem perguntar (usado após confirmação)
function _extToggleStatusForce(id){
  if(id.startsWith('m:')){
    const realId = parseInt(id.replace(/^m:/, ''), 10);
    const l = extratoData.lancamentos.find(x => x.id === realId);
    if(!l) return;
    l.status = 'pendente';
    l.dataPagamento = '';
    _extSave();
    renderExtrato();
    return;
  }
  if(id.startsWith('loan:')){
    // loan:loanId:parcelaIdx
    const parts = id.split(':');
    const loanId = parseInt(parts[1], 10);
    const idx = parseInt(parts[2], 10);
    const ln = (typeof loans !== 'undefined' && Array.isArray(loans)) ? loans.find(x => x.id === loanId) : null;
    if(!ln) return;
    const pagas = parseInt(ln.parcelasPagas, 10) || 0;
    // Permite só toggle sequencial (próxima a pagar OU última paga pra estornar)
    if(idx === pagas){
      ln.parcelasPagas = idx + 1;
      if(typeof toast === 'function') toast('✓ Parcela ' + (idx+1) + ' marcada como paga');
    } else if(idx === pagas - 1){
      ln.parcelasPagas = idx;
      if(typeof toast === 'function') toast('Parcela ' + (idx+1) + ' estornada');
    } else {
      if(typeof toast === 'function') toast('⚠ Parcelas devem ser pagas em ordem (próxima: ' + (pagas+1) + ')');
      return;
    }
    if(typeof saveData === 'function'){ try { saveData(); } catch(_){} }
    if(typeof render === 'function'){ try { render(); } catch(_){} }
    if(typeof updateSummary === 'function'){ try { updateSummary(); } catch(_){} }
    renderExtrato();
    return;
  }
  if(id.startsWith('rec:')){
    // rec:Y:rowId:mAbbr
    const parts = id.split(':');
    const y = parseInt(parts[1], 10);
    const rowId = parseInt(parts[2], 10);
    const mAbbr = parts[3];
    const d = receita && receita.years && receita.years[y];
    if(!d) return;
    const row = (d.clients || []).find(r => r.id === rowId);
    if(!row || !row.meses || !row.meses[mAbbr]) return;
    const cell = row.meses[mAbbr];
    cell.status = (cell.status === 'recebido') ? 'aberto' : 'recebido';
    if(cell.status === 'recebido' && !cell.dataRecebimento){
      cell.dataRecebimento = new Date().toISOString().slice(0,10);
    } else if(cell.status !== 'recebido'){
      delete cell.dataRecebimento;
    }
    if(typeof receitaSave === 'function') receitaSave();
    if(typeof _recKbSyncSheetCell === 'function') _recKbSyncSheetCell(y, mAbbr, rowId);
    if(typeof updateRecTotals === 'function'){ try { updateRecTotals(); } catch(_){} }
    renderExtrato();
    return;
  }
  // ─── DKB (Estrutura/Pessoas/Impostos) ───
  // Formato: dkb:ctxId:itemId:ym
  if(id.startsWith('dkb:')){
    const parts = id.split(':');
    const ctxId  = parts[1];
    const itemId = parseInt(parts[2], 10);
    const ym     = parts[3];
    if(typeof DKB_ADAPTERS === 'undefined' || !DKB_ADAPTERS[ctxId]) return;
    const ad = DKB_ADAPTERS[ctxId];
    const list = (ad.items() || []);
    const it = list.find(x => x.id === itemId);
    if(!it) return;
    // Reverte: marca como nao pago. Limpa APENAS campos estritos da baixa.
    // Preserva: numeroDocumento, dataEmissao, dataVencimento, banco (Detalhes),
    //           fornecedorId, centroCustoId, notas, anexo (documento).
    try { ad.setPago(it, ym, false); } catch(_){}
    const meta = _dkbMeta(it, ym);
    // Campos da baixa (Pagamento) — limpar
    delete meta.dataPagamento;
    delete meta.valorPago;
    delete meta.juros;
    delete meta.multa;
    delete meta.desconto;
    delete meta.formaPagamento;
    delete meta.comprovante;          // anexo de pagamento
    delete meta.amortizacao;          // split de empréstimo
    delete meta.jurosEmbutidos;
    if(ad.save) ad.save();
    if(typeof toast === 'function') toast('↩️ Voltou pra Em Aberto · data passou pra vencimento (demais dados preservados)');
    renderExtrato();
    return;
  }
}
