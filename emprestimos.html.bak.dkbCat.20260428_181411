function rowDragEnd(ev){
  const tr = ev.currentTarget;
  if(tr){ tr.classList.remove('row-dragging'); tr.classList.remove('row-drag-hover'); tr.draggable = false; }
  rowClearDropHints();
  _rowReorderCtx = null;
}

function rowIsValidTarget(tr){
  const ctx = _rowReorderCtx;
  if(!ctx || !tr || !tr.dataset || !tr.dataset.reorderMod) return false;
  if(tr.dataset.reorderMod !== ctx.mod) return false;
  if(tr.dataset.reorderId === ctx.id)   return false;
  const tgtAtivo = tr.dataset.reorderAtivo !== 'false';
  if(tgtAtivo !== ctx.ativo) return false;
  if((tr.dataset.reorderGrp || '') !== ctx.grp) return false;
  return true;
