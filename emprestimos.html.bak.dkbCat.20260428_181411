function bdRenderKPIs(){
  const el = document.getElementById('bd-kpi-row');
  if(!el) return;
  const cs = board.cards;
  const ativas = cs.filter(c => c.col !== 'done');
  const concluidas = cs.length - ativas.length;
  const altaPri = ativas.filter(c => c.priority === 'alta').length;
  const overdue = ativas.filter(c => c.deadline && _bdDeadlineCls(c.deadline) === 'bd-deadline-overdue').length;
  el.innerHTML =
      '<div class="bd-kpi"><div class="bd-kpi-lbl">Total</div><div class="bd-kpi-val">' + cs.length + '</div><div class="bd-kpi-sub">cards no board</div></div>'
    + '<div class="bd-kpi"><div class="bd-kpi-lbl">Ativos</div><div class="bd-kpi-val">' + ativas.length + '</div><div class="bd-kpi-sub">não concluídos</div></div>'
    + '<div class="bd-kpi"><div class="bd-kpi-lbl">Alta Prioridade</div><div class="bd-kpi-val">' + altaPri + '</div><div class="bd-kpi-sub">cards ativos</div></div>'
    + '<div class="bd-kpi' + (overdue > 0 ? ' is-overdue' : '') + '"><div class="bd-kpi-lbl">⚠ Vencidos</div><div class="bd-kpi-val">' + overdue + '</div><div class="bd-kpi-sub">deadline passou</div></div>';
}
// Ordena por prioridade (alta > media > baixa); empate desempata por deadline mais próximo,
// depois por createdAt (mais novo primeiro).
const _BD_PRI_ORDER = { alta: 0, media: 1, baixa: 2 };
function _bdSortByPriority(cards){
  return cards.slice().sort((a, b) => {
    const pa = (_BD_PRI_ORDER[a.priority] != null) ? _BD_PRI_ORDER[a.priority] : 3;
    const pb = (_BD_PRI_ORDER[b.priority] != null) ? _BD_PRI_ORDER[b.priority] : 3;
    if(pa !== pb) return pa - pb;
    const da = a.deadline || '\uffff';
    const db = b.deadline || '\uffff';
    if(da !== db) return da < db ? -1 : 1;
    return (b.createdAt || '').localeCompare(a.createdAt || '');
  });
}

function _bdRenderKanban(){
  const cs = _bdFilteredCards();
  let html = '<div class="bd-kanban">';
  for(const col of BD_COLS){
    const cards = _bdSortByPriority(cs.filter(c => c.col === col.id));
    const isBlocked = col.id === 'blocked', isDone = col.id === 'done';
    html += '<div class="bd-col bd-col-' + col.id + '" data-col="' + col.id + '"'
      + ' ondragover="event.preventDefault();this.classList.add(\'is-drop\')"'
      + ' ondragleave="this.classList.remove(\'is-drop\')"'
      + ' ondrop="bdDropCard(event,\'' + col.id + '\')">'
      + '<div class="bd-col-hd"><span class="bd-col-name">' + col.nome + '</span><span class="bd-col-n">' + cards.length + '</span></div>';
    for(const c of cards){
      html += _bdRenderCard(c);
    }
    html += '<button class="bd-col-add" onclick="bdOpenCardModal(null,\'' + col.id + '\')">+ Adicionar</button>';
    html += '</div>';
  }
  html += '</div>';
  return html;
}
function _bdRenderCard(c){
  const dlCls = _bdDeadlineCls(c.deadline);
  const tagsHtml = (c.tagIds||[]).map(tid => {
    const t = _bdTag(tid); if(!t) return '';
    return '<span class="bd-tag" style="background:' + t.color.bg + ';color:' + t.color.text + '">' + _bdEsc(t.text) + '</span>';
  }).join('');
  const ms = _bdMsAberta(c);
  const isDone = c.col === 'done';
  const ageHtml = (ms != null) ? '<span class="bd-card-age">⏱ ' + _bdFmtAberta(ms) + (isDone ? ' p/ fechar' : '') + '</span>' : '';
  const prog = _bdSubtaskProgress(c);
  const progHtml = prog ? '<span class="bd-card-prog' + (prog.pct === 100 ? ' is-complete' : '') + '" title="Subtarefas: ' + prog.done + ' de ' + prog.total + '">☑ ' + prog.done + '/' + prog.total + '</span>' : '';
  const asgN = (c.assignees||[]).length;
  const attN = (c.attachments||[]).length;
  // Stack de mini-avatares (até 3) com "+N" se houver mais
  let asgHtml = '';
  if(asgN > 0){
    const list = c.assignees || [];
    const visible = list.slice(0, 3);
    const extra = list.length - visible.length;
    const titleAll = list.map(a => _bdEsc(a.nome||'')).join(', ');
    asgHtml = '<span class="bd-card-asg-stack" title="' + titleAll + '">'
            + visible.map(a => _bdPesAvatar(a.pesId, a.nome, 'bd-pes-ava-mini')).join('')
            + (extra > 0 ? '<span class="bd-pes-ava bd-pes-ava-mini bd-pes-ava-more">+' + extra + '</span>' : '')
            + '</span>';
  }
  const attHtml = attN > 0 ? '<span class="bd-card-att" title="' + attN + ' anexo(s)">📎 ' + attN + '</span>' : '';
  return '<div class="bd-card' + (isDone ? ' is-done' : '') + '"'
    + ' draggable="true"'
    + ' ondragstart="bdDragCard(event,' + c.id + ')"'
    + ' onclick="bdOpenCardModal(' + c.id + ')">'
    + (tagsHtml ? '<div class="bd-card-tags">' + tagsHtml + '</div>' : '')
    + '<div class="bd-card-name">' + _bdEsc(c.name) + '</div>'
    + '<div class="bd-card-meta">'
    +   '<span class="bd-pbadge bd-p-' + c.priority + '">' + c.priority.charAt(0).toUpperCase() + c.priority.slice(1) + '</span>'
    +   (c.deadline ? '<span class="bd-card-deadline ' + dlCls + '">📅 ' + _bdFmtData(c.deadline) + '</span>' : '')
    +   progHtml
    +   asgHtml
    +   attHtml
    +   ageHtml
    + '</div>'
    + '</div>';
}
function _bdRenderList(){ return _bdRenderChecklist(); }
function _bdDiasAberta(c){
  if(!c.createdAt) return null;
  try {
    const created = new Date(c.createdAt).getTime();
    const end = c.doneAt ? new Date(c.doneAt).getTime() : Date.now();
    const ms = end - created;
    if(!isFinite(ms) || ms < 0) return 0;
    return Math.floor(ms / 86400000);
  } catch(e){ return null; }
}
function _bdMsAberta(c){
  if(!c.createdAt) return null;
  try {
    const created = new Date(c.createdAt).getTime();
    const end = c.doneAt ? new Date(c.doneAt).getTime() : Date.now();
    const ms = end - created;
    return (isFinite(ms) && ms >= 0) ? ms : 0;
  } catch(e){ return null; }
}
function _bdSubtaskProgress(c){
  const s = c.subtasks || [];
  if(s.length === 0) return null;
  const done = s.filter(t => t.done).length;
  return { done: done, total: s.length, pct: Math.round(done / s.length * 100) };
}
function _bdFmtAberta(ms){
  if(ms == null) return '';
  if(ms < 60000) return '<1min';
  if(ms < 3600000) return Math.floor(ms/60000) + 'min';
  if(ms < 86400000) return Math.floor(ms/3600000) + 'h';
  const d = Math.floor(ms/86400000);
  return d + (d === 1 ? ' dia' : ' dias');
}
function _bdRenderChecklist(){
  const cs = _bdFilteredCards();
  if(cs.length === 0) return '<div class="bd-empty">Nenhum card com os filtros atuais</div>';
  // Separa ativos x concluídos
  const priOrd = { alta:0, media:1, baixa:2 };
  const sortFn = (a,b) => {
    const dp = (priOrd[a.priority]||9) - (priOrd[b.priority]||9);
    if(dp !== 0) return dp;
    if(a.deadline && b.deadline) return a.deadline.localeCompare(b.deadline);
    if(a.deadline) return -1;
    if(b.deadline) return 1;
    return 0;
  };
  const ativos = cs.filter(c => c.col !== 'done').sort(sortFn);
  const concluidos = cs.filter(c => c.col === 'done').sort((a,b) => (b.doneAt||'').localeCompare(a.doneAt||''));
  let html = '';
  // Seção ativos
  if(ativos.length > 0){
    html += '<div class="bd-checklist">';
    for(const c of ativos){ html += _bdRenderChecklistRow(c); }
    html += '</div>';
  }
  // Divider + concluídos
  if(concluidos.length > 0){
    html += '<div class="bd-cl-divider"><span>Concluídos (' + concluidos.length + ')</span></div>';
    html += '<div class="bd-checklist bd-checklist-done">';
    for(const c of concluidos){ html += _bdRenderChecklistRow(c); }
    html += '</div>';
  }
  return html;
}
function _bdRenderChecklistRow(c){
  const isDone = c.col === 'done';
  const col = BD_COLS.find(x => x.id === c.col) || {};
  const dias = _bdDiasAberta(c);
  const ms = c.createdAt ? ((c.doneAt ? new Date(c.doneAt).getTime() : Date.now()) - new Date(c.createdAt).getTime()) : null;
  const tagsHtml = (c.tagIds||[]).map(tid => {
    const t = _bdTag(tid); if(!t) return '';
    return '<span class="bd-tag" style="background:' + t.color.bg + ';color:' + t.color.text + '">' + _bdEsc(t.text) + '</span>';
  }).join('');
  let deadlineHtml = '';
  if(c.deadline){
    const cls = _bdDeadlineCls(c.deadline);
    const isOverdue = cls === 'bd-deadline-overdue';
    deadlineHtml = '<span class="bd-cl-deadline ' + cls + '">' + (isOverdue ? '⚠ Venceu ' : '📅 ') + _bdFmtData(c.deadline) + '</span>';
  }
  let diasHtml = '';
  if(ms != null){
    const lbl = (isDone ? '✓ ' : '⏱ ') + _bdFmtAberta(ms);
    diasHtml = '<span class="bd-cl-dias">' + lbl + '</span>';
  }
  return '<div class="bd-cl-row' + (isDone ? ' is-done' : '') + '" onclick="if(event.target.tagName!==\'BUTTON\')bdOpenCardModal(' + c.id + ')">'
    + '<button class="bd-cl-check' + (isDone ? ' checked' : '') + '" onclick="event.stopPropagation();bdToggleDone(' + c.id + ')" title="' + (isDone ? 'Reabrir' : 'Marcar como concluído') + '"></button>'
    + '<div class="bd-cl-body">'
    +   '<div class="bd-cl-name">' + _bdEsc(c.name) + '</div>'
    +   '<div class="bd-cl-pills">'
    +     '<span class="bd-pbadge bd-p-' + c.priority + '">' + c.priority.charAt(0).toUpperCase() + c.priority.slice(1) + '</span>'
    +     tagsHtml
    +     '<span class="bd-cl-col">' + _bdEsc(col.nome || c.col) + '</span>'
    +     deadlineHtml
    +     diasHtml
    +   '</div>'
    + '</div>'
    + '</div>';
}
// Calendário — estado mês atual
let _bdCalRefDate = new Date();
function bdCalNav(delta){
  _bdCalRefDate.setMonth(_bdCalRefDate.getMonth() + delta);
  bdRender();
}
function bdCalToday(){
  _bdCalRefDate = new Date();
  bdRender();
}
function _bdRenderCalendar(){
  const cs = _bdFilteredCards();
  const ref = _bdCalRefDate;
  const yr = ref.getFullYear(), mo = ref.getMonth();
  const firstDay = new Date(yr, mo, 1);
  const lastDay = new Date(yr, mo + 1, 0);
  const daysInMonth = lastDay.getDate();
  const startOffset = firstDay.getDay();
  const prevMonthLast = new Date(yr, mo, 0).getDate();
  const monthNames = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const dayNames = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
  const byDate = {};
  for(const c of cs){
    if(!c.deadline) continue;
    if(!byDate[c.deadline]) byDate[c.deadline] = [];
    byDate[c.deadline].push(c);
  }
  const todayStr = new Date().toISOString().slice(0,10);
  let html = '<div class="bd-cal-wrap">'
    + '<div class="bd-cal-hd">'
    +   '<button class="bd-cal-nav" onclick="bdCalNav(-1)" title="Mês anterior">‹</button>'
    +   '<div class="bd-cal-month">' + monthNames[mo] + ' ' + yr + '</div>'
    +   '<button class="bd-cal-nav" onclick="bdCalNav(1)" title="Próximo mês">›</button>'
    +   '<button class="bd-cal-today" onclick="bdCalToday()">Hoje</button>'
    + '</div>';
  html += '<div class="bd-cal-grid bd-cal-hdr">';
  for(const d of dayNames) html += '<div class="bd-cal-hcell">' + d + '</div>';
  html += '</div>';
  html += '<div class="bd-cal-grid">';
  let cellIdx = 0;
  for(let i = startOffset - 1; i >= 0; i--){
    const d = prevMonthLast - i;
    const prevDate = new Date(yr, mo - 1, d);
    const key = prevDate.getFullYear() + '-' + String(prevDate.getMonth()+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
    const cards = byDate[key] || [];
    html += _bdCalCell(d, key, cards, true, key === todayStr);
    cellIdx++;
  }
  for(let d = 1; d <= daysInMonth; d++){
    const key = yr + '-' + String(mo+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
    const cards = byDate[key] || [];
    html += _bdCalCell(d, key, cards, false, key === todayStr);
    cellIdx++;
  }
  let nextDay = 1;
  while(cellIdx < 42){
    const nextDate = new Date(yr, mo + 1, nextDay);
    const key = nextDate.getFullYear() + '-' + String(nextDate.getMonth()+1).padStart(2,'0') + '-' + String(nextDay).padStart(2,'0');
    const cards = byDate[key] || [];
    html += _bdCalCell(nextDay, key, cards, true, key === todayStr);
    nextDay++;
    cellIdx++;
  }
  html += '</div>';
  const semDate = cs.filter(c => !c.deadline);
  if(semDate.length > 0){
    html += '<div class="bd-cal-no-date">'
      + '<div class="bd-cal-no-date-hd">Sem deadline (' + semDate.length + ')</div>'
      + '<div class="bd-cal-no-date-list">'
      +   semDate.slice(0, 20).map(c => '<span class="bd-cal-card bd-p-' + c.priority + '" onclick="bdOpenCardModal(' + c.id + ')">' + _bdEsc(c.name) + '</span>').join('')
      +   (semDate.length > 20 ? '<span style="color:#999;font-size:11px;font-style:italic"> + ' + (semDate.length-20) + ' outros</span>' : '')
      + '</div>'
      + '</div>';
  }
  html += '</div>';
  return html;
}
function _bdCalCell(dayNum, dateKey, cards, isOther, isToday){
  let html = '<div class="bd-cal-cell' + (isOther ? ' bd-cal-other' : '') + (isToday ? ' bd-cal-today-cell' : '') + '">';
  html += '<div class="bd-cal-day">' + dayNum + '</div>';
  if(cards.length > 0){
    html += '<div class="bd-cal-cards">';
    for(const c of cards.slice(0, 4)){
      const isDone = c.col === 'done';
      const dlOverdue = !isDone && _bdDeadlineCls(c.deadline) === 'bd-deadline-overdue';
      html += '<div class="bd-cal-card bd-p-' + c.priority + (isDone ? ' is-done' : '') + (dlOverdue ? ' is-overdue' : '') + '"'
        + ' onclick="event.stopPropagation();bdOpenCardModal(' + c.id + ')"'
        + ' title="' + _bdEsc(c.name) + '">' + _bdEsc(c.name) + '</div>';
    }
    if(cards.length > 4){
      html += '<div class="bd-cal-more">+ ' + (cards.length - 4) + '</div>';
    }
    html += '</div>';
  }
  html += '</div>';
  return html;
}
