// Formata duração em ms pra "2d 4h" / "5h 12min" / "32min" / "<1min"
function _viagFmtDuracao(ms){
  if(ms == null || !isFinite(ms)) return '—';
  if(ms < 60000) return '<1min';
  const totalMin = Math.floor(ms / 60000);
  const totalH = Math.floor(totalMin / 60);
  const d = Math.floor(totalH / 24);
  const h = totalH % 24;
  const min = totalMin % 60;
  if(d >= 1) return d + 'd' + (h > 0 ? ' ' + h + 'h' : '');
  if(totalH >= 1) return totalH + 'h' + (min > 0 ? ' ' + min + 'min' : '');
  return totalMin + 'min';
}
