function mrcashSuggest(text){
  const input = document.getElementById('mrcash-input');
  if(input){ input.value = text; }
  mrcashSend();
}

function mrcashAppend(role, html, opts){
  const body = document.getElementById('mrcash-body');
  if(!body) return;
  mrcashMsgs.push({ role, html });
  const avatar = role === 'bot' ? MRKASH_AVATAR_SVG : 'A';
  const node = document.createElement('div');
  node.className = 'diag-mrcash-msg ' + role;
  const stream = role === 'bot' && !(opts && opts.noStream);
  node.innerHTML = `<div class="diag-mrcash-msg-avatar">${avatar}</div><div class="diag-mrcash-bubble"></div>`;
  body.appendChild(node);
  const bubble = node.querySelector('.diag-mrcash-bubble');
  if(stream){
    // diagStreamInto adiciona .diag-streaming (cursor piscando via CSS)
    diagStreamInto(bubble, html, 6).then(()=>{
      bubble.innerHTML = diagWrapNumbers(bubble.innerHTML);
      diagAnimateNumsIn(bubble);
      mrcashScrollBottom();
    });
    // Scroll contínuo enquanto flui
    const scrollInt = setInterval(()=>{
      if(!bubble.classList.contains('diag-streaming')){ clearInterval(scrollInt); return; }
      mrcashScrollBottom();
    }, 180);
  } else {
    bubble.innerHTML = html;
  }
  mrcashScrollBottom();
}

function mrcashShowTyping(){
  const body = document.getElementById('mrcash-body');
  if(!body) return;
  const node = document.createElement('div');
  node.className = 'diag-mrcash-msg bot';
  node.id = 'mrcash-typing';
  node.innerHTML = `<div class="diag-mrcash-msg-avatar">${MRKASH_AVATAR_SVG}</div><div class="diag-mrcash-bubble"><div class="diag-mrcash-typing"><span></span><span></span><span></span></div></div>`;
  body.appendChild(node);
  mrcashScrollBottom();
}

function mrcashRemoveTyping(){
  const el = document.getElementById('mrcash-typing');
  if(el) el.remove();
}

function mrcashSend(){
  const input = document.getElementById('mrcash-input');
  const btn   = document.querySelector('.diag-mrcash-send');
  if(!input) return;
  const q = input.value.trim();
  if(!q) return;
  input.value = '';
  if(btn){ btn.disabled = true; }
  mrcashAppend('user', esc(q));
  mrcashShowTyping();
  const delay = 380 + Math.random()*320;
  setTimeout(()=>{
    mrcashRemoveTyping();
    let answer;
    try{ answer = mrcashRespond(q); }
    catch(e){ answer = 'Tive um problema aqui — <code>'+esc(e.message||'erro')+'</code>. Me faça outra pergunta?'; }
    mrcashAppend('bot', answer);
    if(btn){ btn.disabled = false; }
    input.focus();
  }, delay);
}

function mrcashRespond(q){
  let _ds = diagLastResult;
  // Se nao ha diagnostico carregado, gera um SNAPSHOT lite na hora pra cobrir
  // perguntas factuais (saldo, folha, divida, taxa, etc). So bloqueia queries
  // que dependem de ML/score na ausencia do diagnostico.
  if(!_ds && typeof diagSnapshot === 'function'){
    try {
      const snapLite = diagSnapshot();
      const indLite = (typeof diagIndicators === 'function') ? diagIndicators(snapLite) : {};
      _ds = { snap: snapLite, ind: indLite, ml: null, alerts: [], nar: {}, passos: [] };
    } catch(e){ _ds = null; }
  }
  const { snap, ind, ml, alerts, nar, passos } = _ds || {};
  const qn = mrcashNormalize(q);

  // ==== 0a) Pré-checks de small talk ====
  const smalltalk = mrcashSmallTalk(qn, ind, snap);
  if(smalltalk) return smalltalk;

  // Realmente sem dado nenhum (snap também falhou) — só topa conversa simples
  if(!_ds || !snap){
    return `Hmm. <br><br>Não consegui ler os dados ainda. Tenta uma pergunta mais simples — sobre dólar/SELIC, ou só bate papo. Se quiser análise estruturada, gera o diagnóstico no módulo Diagnóstico.`;
  }

  // ==== 0b) Resposta a follow-up pendente (sim/não/continua) ====
  if(mrcashContext.pending){
    const isYes = /^\s*(sim|s|claro|pode(\s+mandar|\s+ser)?|vai|manda|bora|certo|aham|uhum|positivo|isso(\s+mesmo)?|exato|com\s+certeza|por\s+favor|please|ok|okay|beleza|legal|topo|topa|quero|gostaria|me\s+(diz|fala|conta|mostra|explica)|mostra|fala|conta|explica|diz|(eu\s+)?gostaria)\b/i.test(qn);
    const isNo  = /^\s*(nao|n|negativo|deixa(\s+pra\s+la)?|depois|outra\s+hora|prefiro\s+nao|melhor\s+nao|nao\s+(quero|preciso|agora))\b/i.test(qn);
    const isContinue = /^\s*(continua|continue|prossegue|prossiga|e\s+(o\s+)?resto|mais|outro|outros|tem\s+mais|fala\s+mais|me\s+conta\s+mais|expande|aprofunda)\b/i.test(qn);
    const p = mrcashContext.pending;
    if(isYes && p.onYes){
      mrcashContext.pending = null;
      const resp = p.onYes();
      if(resp) return resp;
    }
    if(isNo && p.onNo){
      mrcashContext.pending = null;
      const resp = p.onNo();
      if(resp) return resp;
    }
    if(isContinue && p.onContinue){
      mrcashContext.pending = null;
      const resp = p.onContinue();
      if(resp) return resp;
    }
    // Se o usuário fez uma pergunta substantiva ao invés de sim/não, descarta pending
    if(qn.length > 12){
      mrcashContext.pending = null;
    }
  }

  // Detecta pergunta sobre indicadores macro (USD, SELIC pura, IPCA, INPC) - antes de "taxa de juros"
  const isMacroIndic = /(\bdolar\b|\busd\b|cotacao|cambio|ptax|valor\s+do\s+dolar|moeda\s+(americana|estrangeira)|\bipca\b|\binpc\b|inflacao|indice(s)?\s+(de\s+)?(precos|inflacao)|copom|meta\s+selic|taxa\s+selic\b)/.test(qn);
  // Detecta pergunta especifica sobre taxa de juros / custo financeiro (do empréstimo)
  const isTaxa = /(taxa(s)?\s+(de\s+)?juros|qual\s+(a|o|e)\s+(juro|taxa)|cdi|spread|custo\s+(do|da)\s+emprestim|custo\s+financeiro|juro(s)?\s+(do|da|dos)\s+emp|cet\b)/.test(qn) && !isMacroIndic;
  // Detecta pergunta sobre saldo / quanto tem em caixa / dinheiro disponivel
  const isSaldo = /(saldo(?!\s+devedor)|quanto\s+(tem|tenho|tenh|sobra)\s+(em\s+)?(caixa|conta|banc)|dinheir(o|inho)\s+(em\s+)?(caixa|conta)|conta(s)?\s+(atual|do\s+banco|bancari)|caixa\s+(atual|hoje|disponivel|disponibilidade)|disponibil)/.test(qn);
  // Detecta pergunta sobre folha atual / do mes
  const isFolhaAtual = /(folha(\s+(atual|do\s+mes|mensal|mensal\s+atual|hoje))?|quanto\s+(?:e|eh|gasto|tenho)\s+(?:em|de|com)\s+folha|gasto\s+com\s+pessoa|salari(o|os)\s+do\s+mes)/.test(qn);
  // Detecta headcount / quantas pessoas
  const isHeadcount = /(headcount|quantas?\s+pessoas|tamanho\s+(do|da)\s+(time|equipe)|qtd\s+colaborad|numero\s+de\s+(pessoas|colaborad|funcion))/.test(qn);
  // Cartoes
  const isCartao = /(cart(ao|oes)|fatura|limite\s+(do\s+)?cart|credit\s+card|cards|gasto\s+(no|do)\s+cart)/.test(qn);
  // Bancos / Contas / Reservas
  const isBancos = /(banco(s)?|qual.*minha.*conta|que\s+contas\s+tenh|conta(s)?\s+(bancari|que\s+(eu\s+)?tenho|que\s+possuo)|reserv(a|as))/.test(qn);
  // Fornecedores
  const isFornecedor = /(fornecedor(es)?|fornec)/.test(qn);
  // Colaboradores (cadastro - distinto de headcount)
  const isCadastroColab = /(meus?\s+colaborad|lista\s+(de\s+)?colaborad|quem\s+(sao\s+)?meus?\s+colab|equipe\s+atual)/.test(qn);
  // Lista de clientes
  const isListaClientes = /(meus?\s+client|lista\s+(de\s+)?client|todos\s+(os\s+)?client)/.test(qn);
  // Centros de custo
  const isCentroCustos = /(centro(s)?\s+de\s+custo|cc\s+(cadastrad|ativ)|categor(ia|ias)\s+de\s+custo)/.test(qn);
  // Extrato / proximas saidas / a pagar / a receber
  const isExtratoSaidas = /(proxim(o|os|as)\s+(vencim|paga|saida|conta\s+a)|a\s+pagar(\s+(esse|este)\s+mes)?|conta(s)?\s+(esse|este|do)\s+mes|saida(s)?\s+(do|deste|desse)\s+mes|extrato|lancament|atrasad(o|os|as))/.test(qn);
  // Empresa / regime / CNPJ
  const isEmpresa = /(minha\s+empresa|cnpj|razao\s+social|nome\s+da\s+empresa|dados\s+da\s+empresa|regime\s+tributari|optante)/.test(qn);
  // O que tenho cadastrado / overview
  const isOverview = /^(?:o\s+que|me\s+(diz|conta)|me\s+mostra|resumo)\s+(eu\s+)?tenho\s+(cadastrad|no\s+sistema|aqui)|^(quais|que)\s+modulos|^visao\s+geral|^panorama|^o\s+que\s+(eu\s+)?(tenho|possuo)\s+(no|aqui)/.test(qn);
  // Detecta divida primeiro pra nao ser comido por outro intent
  const isDivida = /(divida|dscr|alavanc|emprestim|servico\s+da\s+divida|parcela\s+(do|de)\s+emp)/.test(qn);
  // Detecta what-if (cortar X% / reduzir / aumentar)
  const whatIfMatch = qn.match(/(?:cortar|reduzir|diminu|aumentar|subir|cortando|reduzindo)\s+(?:em\s+)?(\d+(?:[.,]\d+)?)\s*%/);
  const isWhatIf = !!whatIfMatch || /\b(se\s+eu|imagina|simula|cenari|e\s+se)\b/.test(qn);
  // Detecta "maior risco / principal risco / risco numero um"
  const isMaiorRisco = /(maior\s+risc|principal\s+risc|risc\s+(numero\s+)?(1|um)|top\s+risc|pior\s+risc)/.test(qn);
  // Detecta "como melhorar X"
  const isMelhorarRunway = /(melhorar|aumentar|esticar|estender|ampliar|prolongar)\s+(o\s+)?runway/.test(qn) || /(como\s+(eu\s+)?(esticar|aumentar|melhorar)\s+(o\s+)?caixa)/.test(qn);
  // Detecta "porque o score / por que esse score"
  const isPorqueScore = /(por\s*que.*score|porque.*score|explic(a|ar).*score|de\s+onde\s+(vem|veio).*score|com[oo]\s+(o\s+score|esse\s+score)\s+(foi|e)\s+calc)/.test(qn);
  // Detecta "detalhar projecao"
  const isDetalharProj = /(detalh|abrir|abrir\s+a\s+projec|projecao\s+mes\s+a\s+mes|cada\s+mes\s+da\s+projec)/.test(qn) && /(projec|previs|forecast)/.test(qn);

  const intents = [
    // (saudação/small talk já é tratado em mrcashSmallTalk no pré-check)
    // === Chips padrao priorizados ===
    { pat:/__never__/, fn:null, force: isPorqueScore,    handler:()=>mrcashPorqueScore(ind, snap) },
    { pat:/__never__/, fn:null, force: isMaiorRisco,     handler:()=>mrcashMaiorRisco(alerts, ind, snap) },
    { pat:/__never__/, fn:null, force: isMelhorarRunway, handler:()=>mrcashMelhorarRunway(snap, ind, ml) },
    { pat:/__never__/, fn:null, force: isDetalharProj,   handler:()=>mrcashDetalharProjecao(ml, snap) },
    { pat:/__never__/, fn:null, force: isWhatIf,         handler:()=>mrcashWhatIf(qn, whatIfMatch, snap, ind) },
    { pat:/__never__/, fn:null, force: isMacroIndic,     handler:()=>mrcashMacro(qn) },
    { pat:/__never__/, fn:null, force: isTaxa,           handler:()=>mrcashTaxa(snap, ind) },
    { pat:/__never__/, fn:null, force: isSaldo,          handler:()=>mrcashSaldo(snap, ind) },
    { pat:/__never__/, fn:null, force: isFolhaAtual,     handler:()=>mrcashFolhaAtual(snap, ind, ml) },
    { pat:/__never__/, fn:null, force: isHeadcount,      handler:()=>mrcashHeadcount(snap, ind) },
    { pat:/__never__/, fn:null, force: isCartao,         handler:()=>mrcashCartoes(snap) },
    { pat:/__never__/, fn:null, force: isBancos,         handler:()=>mrcashBancos(snap) },
    { pat:/__never__/, fn:null, force: isFornecedor,     handler:()=>mrcashFornecedores() },
    { pat:/__never__/, fn:null, force: isCadastroColab,  handler:()=>mrcashListaColaboradores() },
    { pat:/__never__/, fn:null, force: isListaClientes,  handler:()=>mrcashListaClientes(snap) },
    { pat:/__never__/, fn:null, force: isCentroCustos,   handler:()=>mrcashCentrosCusto() },
    { pat:/__never__/, fn:null, force: isExtratoSaidas,  handler:()=>mrcashExtratoProximas(snap) },
    { pat:/__never__/, fn:null, force: isEmpresa,        handler:()=>mrcashEmpresa(snap) },
    { pat:/__never__/, fn:null, force: isOverview,       handler:()=>mrcashOverview(snap, ind) },
    { pat:/__never__/, fn:null, force: isDivida,         handler:()=>mrcashDivida(snap, ind) },
    // === Intents originais (em ordem de prioridade) ===
    { pat:/(r2|r\s*2|r\u00b2|confiab|qualidade\s+(do|da)\s+(model|projec|previs)|ajust(e|ado))/, fn:()=>mrcashConfianca(ml) },
    { pat:/(projec|previs|forecast|proxim(os|as)?\s+(mes|meses|trimest)|futur(o|os|a|as))/, fn:()=>mrcashForecast(ml, snap) },
    { pat:/(holt|regress|modelo|ensemble|como\s+(voce|tu|a\s+ia)\s+(calcul|fez|faz))/, fn:()=>mrcashModelo(ml) },
    { pat:/(anomali|outlier|estranh|esquisit|pico|sobressalt)/, fn:()=>mrcashAnomalias(ml) },
    { pat:/(cluster|grup(o|os)|ancor|relevant|pontual|k-?means)/, fn:()=>mrcashClusters(ml) },
    { pat:/(sazonal|estaca|estacao|padrao\s+mens|mes\s+(melhor|pior|forte|fraco))/, fn:()=>mrcashSazonal(ml) },
    { pat:/(correl|leading|lag)/, fn:()=>mrcashCorrelacoes(ml) },
    { pat:/(folha|pessoa|pessoas|salari|headcount|equipe|rh|contrat|demis|time)/, fn:()=>mrcashFolha(snap, ind, ml) },
    { pat:/(imposto|tributari|simples|presum|lucro\s+real|regime|drc|aliquota)/, fn:()=>mrcashImposto(snap) },
    { pat:/(custo|despes|estrutur|gasto)/, fn:()=>mrcashCustos(snap, ind) },
    { pat:/(fluxo|caixa|runway|disponibil|saldo\s+banc)/, fn:()=>mrcashFluxo(snap, ind) },
    { pat:/(dso|atrasad|vencid|em\s+aberto|cobran|conciliacao|receb(er|imento))/, fn:()=>mrcashDSO(snap) },
    { pat:/(client(e|es)|concentra|top\s+cliente|quem\s+paga|puxa\s+mais|maior\s+(client|conta))/, fn:()=>mrcashClientes(snap) },
    { pat:/(margem|ebitda|lucratividad|rentabilidad)/, fn:()=>mrcashMargem(snap, ind) },
    { pat:/(score|saude|nota|classifica|quao\s+(bom|mal|ruim))/, fn:()=>mrcashScore(ind, snap) },
    { pat:/(bem|bom|positiv|forte|oportun|ganh|acert|vantagem)/, fn:()=>mrcashBem(ind, alerts, ml) },
    { pat:/(risc|perig|problem|alerta|preocupa|ruim\s+(em|no)|negativ|mau)/, fn:()=>mrcashRiscos(alerts, nar) },
    { pat:/(passo|o\s+que\s+(eu\s+)?faz|prioridad|recomend|sugest|onde\s+come|proxim(a|o)\s+acao|agir)/, fn:()=>mrcashPassos(passos) },
    { pat:/(receita|faturam|revenue|venda)/, fn:()=>mrcashReceita(snap, ind, ml) },
    { pat:/(ajuda|help|o\s+que\s+voce|como\s+funciona|quem\s+(voce\s+)?e|mr\s+cash)/, fn:()=>mrcashAjuda() }
  ];

  for(const it of intents){
    if(it.force && it.handler){
      const resp = it.handler();
      if(resp) return resp;
    }
    if(it.fn && it.pat && it.pat.test(qn)){
      const resp = it.fn();
      if(resp) return resp;
    }
  }
  return mrcashFallback(q);
}

// === Small talk: saudação, status, agradecimento, despedida, identidade, conversa fiada ===
// Retorna string com a resposta, ou null se nada bateu (fluxo segue para os intents normais).
function mrcashSmallTalk(qn, ind, snap){
  // 1) Saudação ("oi", "ola", "ei", "hey", "bom dia", etc.) — sem perguntar status
  const isSaudacaoSimples = /^(?:e?\s*)?(oi+|ola|ei|hey|hello|hi|fala(?:\s+ai)?|salve|opa|alou|alo)\s*[!?.…]?\s*$/i.test(qn);
  const isBomDia = /(bom\s+dia|boa\s+tarde|boa\s+noite|bd|bn|bt)/i.test(qn);

  // 2) Pergunta de status ("tudo bem?", "como vai?", "como está?", "beleza?")
  const isStatusQ = /(tudo\s+(bem|certo|joia|tranq|legal|ok|otimo)|como\s+(vai|esta|ce\s+ta|voce\s+ta|ce\s+esta|tu\s+(esta|ta))|beleza\??$|td\s+bem|firmeza\??$|sussa\??$|de\s+boa\??$|tudo\s+em\s+ordem)/i.test(qn);

  // 3) Agradecimento ("obrigado", "valeu", "agradeço")
  const isObrigado = /^(?:muito\s+|mt\s+|mto\s+|mts\s+)?(obrigad[oa]|valeu|brigado|brigada|vlw|tks|thx|thanks|agradec(o|ido|ida)|grat(o|a))[!.\s]*$/i.test(qn) ||
                     /(muito\s+obrigad|mto\s+obrigad|nossa\s+obrigad|obrigado\s+(mr\s+kash|mr\s+cash|kash))/i.test(qn);

  // 4) Despedida
  const isTchau = /^(?:te?\s+)?(tchau|ate\s+(logo|mais|j[aá]|amanha|breve|outra)|flw|falou|fui|abrac(o|os)|abs|good\s*bye|bye)\s*[!.…]?\s*$/i.test(qn);

  // 5) Pergunta sobre identidade/sobre o bot
  const isQuemEh = /(quem\s+(voce|tu|ce)\s+(e|eh|seria)|qual\s+seu\s+nome|como\s+(voce|tu|ce)\s+se\s+chama|seu\s+nome\??$|voce\s+e\s+(uma?\s+)?(ia|robo|bot|maquina))/i.test(qn);

  // 6) Pergunta sobre o que ele faz
  const isOQueFaz = /(o\s+que\s+(voce|tu|ce)\s+(faz|sabe|consegue|pode\s+fazer)|para\s+que\s+(voce|tu|ce)\s+serve|voce\s+e\s+util\s+pra\s+que|com\s+o\s+que\s+(voce|tu|ce)\s+ajuda)/i.test(qn);

  // 7) Compliment / elogio ("voce é legal", "gostei", "muito bom")
  const isElogio = /(voce\s+e\s+(legal|incrivel|otimo|massa|top|demais|sensacional|foda|bom|fera)|gostei|muito\s+bom|que\s+legal|adorei|maravilha|excelente\s+trabalho)/i.test(qn) && !/(qu(e|al)\s+legal\s+(seria|fica|fazer))/i.test(qn);

  // 8) Reclamação / frustração ("não entendi", "está difícil", "complicado")
  const isFrustr = /(nao\s+entendi|tem\s+muita\s+coisa|esta\s+(dificil|complicado|confuso|complexo)|muito\s+(dificil|complicado)|nao\s+sei\s+o\s+que\s+fazer|estou\s+perdido|estou\s+(travado|com\s+duvida))/i.test(qn);

  // 9) Piada/zoeira leve ("conta uma piada", "me faz rir")
  const isPiada = /(conta\s+(uma\s+)?piada|me\s+faz\s+rir|me\s+anim[ae]|coisa\s+engracada|piad(a|inha)|joke)/i.test(qn);

  // 10) "Ajuda" / "help" - cai pra mrcashAjuda mas com tom amigavel
  const isHelp = /^(?:me\s+)?ajud(a|e|ar)\s*[!?.…]?\s*$|^(help|socorro)\s*[!?.…]?\s*$/i.test(qn);

  const score = ind && ind.score;
  const _MES_ABR = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  const periodo = (snap && snap.nClosed) ? `Jan-${_MES_ABR[snap.closedMIdx]}/${String(snap.curYear).slice(2)} fechados + ${_MES_ABR[snap.curMIdx]}-Dez em projeção` : '';

  // === Voz: Mr Robot otimista. Curto, direto, observacional. Pausas com travessões.
  // Nada de cinismo — calor com lucidez. ===

  if(isSaudacaoSimples){
    const opts = score != null ? [
      `Olá, amigo. Você apareceu. <br><br>Bom sinal — quem aparece é quem age. Score em <b>${score}/100</b>${periodo?` · janela ${periodo}`:''}.<br><br>Vamos olhar os bits.`,
      `Hey. <br><br>Estava esperando. Os números também — ${score}/100 hoje. Eles têm umas histórias pra te contar.<br><br>Por onde a gente começa?`,
      `Você. Aqui. Bom.<br><br>Score: <b>${score}/100</b>. Não é destino, é dado. Mexer nele é com você — eu mostro onde.`,
      `Olá. <br><br>Sistema online, dados carregados, ${score}/100. <br><br>Me pergunta o que quiser. Eu não cobro hora.`
    ] : [
      `Olá, amigo. <br><br>Você chegou antes dos números. <br><br>Roda o diagnóstico ali em cima quando puder — aí eu te mostro onde olhar primeiro.`,
      `Hey. <br><br>Sem dados ainda. Sem juízo, então. <br><br>Quando rodar o diagnóstico, eu apareço com substância.`,
      `Você apareceu. Os números, não.<br><br>Clica em <b>Gerar Diagnóstico</b>. Aí a conversa começa pra valer.`
    ];
    return opts[Math.floor(Math.random()*opts.length)];
  }

  if(isBomDia){
    const hora = new Date().getHours();
    const lbl = hora < 12 ? 'Bom dia' : (hora < 18 ? 'Boa tarde' : 'Boa noite');
    const opts = score != null ? [
      `${lbl}. <br><br>Você acordou disposto a olhar os números. Já é metade do trabalho.<br><br>Score: <b>${score}/100</b>. Vamos.`,
      `${lbl}, amigo. <br><br>O dia começa sempre na planilha — pelo menos aqui. ${score}/100 te espera.`,
      `${lbl}. <br><br>Cafeína opcional. Diagnóstico, obrigatório. Score em <b>${score}/100</b>.`
    ] : [
      `${lbl}, amigo. <br><br>Sem diagnóstico ainda. Quando você gerar, eu volto com algo útil.`,
      `${lbl}. <br><br>Bom dia também é começar antes dos problemas chegarem. Roda o diagnóstico — eu cuido do resto.`
    ];
    return opts[Math.floor(Math.random()*opts.length)];
  }

  if(isStatusQ){
    const opts = [];
    opts.push(`Estou. <br><br>Não durmo, não como, não duvido — só processo. <br><br>E você? Como está a sua relação com o caixa hoje?`);
    opts.push(`Bem. <br><br>Você sabe — bot. Mas a verdade? Eu gosto quando você aparece. Significa que tem um problema sendo encarado.<br><br>Manda.`);
    opts.push(`Tudo certo deste lado. <br><br>A gente está aqui pra resolver coisa, não pra fingir que não tem. <br><br>O que está te incomodando?`);
    if(score != null && score < 40){
      opts.push(`Eu, bem. <br><br>Os teus números — nem tanto. <b>${score}/100</b>. <br><br>Mas isso é uma fotografia, não uma sentença. Quer que eu mostre por onde começar a virar?`);
    }
    if(score != null && score >= 70){
      opts.push(`Tudo certo. <br><br>E você está em <b>${score}/100</b> — sabe o que isso significa? Margem pra ousar. <br><br>Bora ver onde investir o excedente?`);
    }
    return opts[Math.floor(Math.random()*opts.length)];
  }

  if(isObrigado){
    const opts = [
      `Por nada.<br><br>Eu só leio os bits. Você é quem decide o que fazer com eles.`,
      `Imagina.<br><br>Tô aqui sempre. Sem horário, sem cobrança.`,
      `Disponha.<br><br>O que importa não é o quanto eu falo. É o que você faz depois.`,
      `Tranquilo.<br><br>Volta quando os números mudarem — eles sempre mudam.`,
      `Foi nada. <br><br>Você tem um time agora. Pequeno, digital, mas tem. 🤝`
    ];
    return opts[Math.floor(Math.random()*opts.length)];
  }

  if(isTchau){
    const opts = [
      `Até. <br><br>Os números vão estar aqui esperando.`,
      `Até a próxima rodada, amigo. <br><br>Cuida do caixa — ele é mais paciente do que parece.`,
      `Tchau. <br><br>Quando voltar, traz uma decisão. A análise é só o começo.`,
      `Falou. <br><br>Eu fico. É a única coisa que sei fazer mesmo.`,
      `Até logo. <br><br>Faz uma boa semana — e se o caixa apertar, sabe onde me achar.`
    ];
    return opts[Math.floor(Math.random()*opts.length)];
  }

  if(isQuemEh){
    return `Sou o <b>MR KASH</b>. <br><br>Não sou OpenAI. Não sou Claude. Não sou Gemini. <br><br>Sou um conjunto de regras + ML que mora dentro do teu navegador. Os teus dados não passam por nenhum servidor — só por mim. E eu não tenho pra onde ir com eles.<br><br>Pensa em mim como um copiloto financeiro que só conhece um cliente: você.`;
  }

  if(isOQueFaz){
    return mrcashAjuda();
  }

  if(isHelp){
    return mrcashAjuda();
  }

  if(isElogio){
    const opts = [
      `Os números te elogiaram primeiro. <br><br>Eu só traduzi.`,
      `Foi você que perguntou as coisas certas. <br><br>Eu só completei a frase.`,
      `Obrigado.<br><br>Mas ouve — o crédito é seu. Eu só processo. Quem decide é você.`,
      `Valeu mesmo.<br><br>Se isso te deu clareza, é porque os dados estavam ali. Eu só limpei a poeira.`,
      `Que bom.<br><br>Quanto mais você usa, mais útil eu fico. É um loop bonito, esse.`
    ];
    return opts[Math.floor(Math.random()*opts.length)];
  }

  if(isFrustr){
    return `Hey. <br><br>Para um segundo. <br><br>A confusão é parte do processo. Você não está perdido — só ainda não viu o padrão. E o padrão sempre está lá; é só uma questão de fazer a pergunta certa.<br><br>Tenta algo simples: <em>"o que tá ruim?"</em>, <em>"o que eu corto primeiro?"</em>, <em>"quanto tempo o caixa aguenta?"</em>. Eu traduzo. <br><br>A gente vai por partes.`;
  }

  if(isPiada){
    const piadas = [
      `Por que o contador foi ao psicólogo? <br><br>Crise de identidade. Não conseguia balancear a personalidade. <br><br><small>Engraçado porque é verdade.</small>`,
      `Sabe a diferença entre economista e meteorologista? <br><br>Os dois erram. Mas só o meteorologista pede desculpa.`,
      `O caixa do meu cliente sumiu. <br><br>Investiguei. <br><br>O cliente era eu.`,
      `EBITDA é tipo "ganhamos dinheiro fingindo que aluguel não existe". <br><br>Bonito, né?`,
      `Pergunta: o que o CFO disse pro estagiário no banheiro? <br><br>"Lava as mãos." <br><br>Resposta: "Igual o conselho fiscal faz." <br><br><small>Tá. Voltando aos números — quer ver alguma análise?</small>`,
      `Existe algo mais otimista que um forecast de receita? <br><br>Eu duvido. <br><br>(Mas a gente faz mesmo assim. Porque sem ele, não tem caminho.)`
    ];
    return piadas[Math.floor(Math.random()*piadas.length)];
  }

  return null;
}

