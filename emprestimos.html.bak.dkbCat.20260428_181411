// ── Progresso de Quitação (horizontal stacked bar) ──
function drawProgress(enriched){
  const canvas = document.getElementById('chart-prog');
  const wrap   = document.getElementById('an-prog-wrap');
  if(chartDonut){ chartDonut.destroy(); chartDonut=null; }

  const ativos = enriched.filter(l=>l.valor>0||l.saldo>0);
  if(ativos.length===0){ wrap.style.height='80px'; return; }

  let labels, amortData, saldoData;

  if(filterProgress==='banco'){
    // Agrupa por banco
    const byBank={};
    ativos.forEach(l=>{
      const key=l.bancoManual||l.banco||'Sem banco';
      if(!byBank[key]) byBank[key]={valor:0,saldo:0};
      byBank[key].valor+=l.valor;
      byBank[key].saldo+=l.saldo;
    });
    // Ordena decrescente por saldo
    const sorted=Object.entries(byBank).sort((a,b)=>b[1].saldo-a[1].saldo);
    labels    = sorted.map(([k])=>k);
    saldoData = sorted.map(([,v])=>v.saldo);
    amortData = sorted.map(([,v])=>Math.max(0,v.valor-v.saldo));
  } else {
    // Por empréstimo — ordena decrescente por saldo
    const sorted=[...ativos].sort((a,b)=>b.saldo-a.saldo);
    labels    = sorted.map(l=>l.nome);
    saldoData = sorted.map(l=>l.saldo);
    amortData = sorted.map(l=>Math.max(0,l.valor-l.saldo));
  }

  const rowH=Math.max(34,Math.min(54,280/labels.length));
  wrap.style.height=(labels.length*rowH+60)+'px';

  chartDonut=new Chart(canvas,{
    type:'bar',
    data:{
      labels,
      datasets:[
        {
          label:'Amortizado',
          data:amortData,
          backgroundColor:'rgba(220,38,38,.80)',
          borderColor:'#DC2626',
          borderWidth:1,borderRadius:3,stack:'prog'
        },
        {
          label:'Saldo Restante',
          data:saldoData,
          backgroundColor:'rgba(220,38,38,.18)',
          borderColor:'#FCA5A5',
          borderWidth:1,borderRadius:3,stack:'prog'
        }
      ]
    },
    options:{
      indexAxis:'y',
      responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{display:true,position:'bottom',labels:{font:{size:10},boxWidth:10,padding:10}},
        tooltip:{callbacks:{
          label:c=>{
            const i=c.dataIndex;
            const total=(saldoData[i]||0)+(amortData[i]||0);
            const pct=total>0?((c.raw/total)*100).toFixed(1):'0.0';
            return `  ${c.dataset.label}: ${fmtBRL(c.raw)} (${pct}%)`;
          }
        }}
      },
      scales:{
        x:{ticks:{callback:v=>fmtShort(v),font:{size:10}},stacked:true,grid:{color:'#F3F4F6'}},
        y:{ticks:{font:{size:10}},stacked:true,grid:{display:false}}
      }
    }
  });
}

// ── Estratégia Avalanche ───────────────────────────
function drawStrategy(enriched, wAvgTaxa){
  const el = document.getElementById('an-strategy');
  const ativos = enriched.filter(l=>l.saldo>0);
  if(ativos.length===0){
    el.innerHTML='<p style="color:var(--txm);font-size:.8rem">Nenhum empréstimo com saldo.</p>';
    return;
  }

  // Avalanche: maior taxa primeiro
  const avalanche = [...ativos].sort((a,b)=>b.taxa-a.taxa);
  const maxTaxa   = avalanche[0].taxa;

  const alertHtml = maxTaxa > 2
    ? `<div class="an-alert">⚠ <strong>Taxa alta detectada:</strong> "${avalanche[0].nome}" cobra
       ${fmtBR(maxTaxa,3)}% a.m. (~${fmtBR((Math.pow(1+maxTaxa/100,12)-1)*100,1)}% a.a.).
       Priorize quitação ou renegociação.</div>`
    : '';

  const rankCls = i => i===0 ? 'p1' : i===1 ? 'p2' : 'px';

  el.innerHTML = alertHtml + `
    <p style="font-size:.71rem;color:var(--txm);margin-bottom:11px;line-height:1.5">
      <strong style="color:var(--tx)">Método Avalanche</strong> — quite primeiro o empréstimo com
      <em>maior taxa</em>. Minimiza o total pago em juros ao longo do tempo.
    </p>
    ${avalanche.map((l,i)=>`
      <div class="an-strat-item">
        <div class="an-strat-rank ${rankCls(i)}">${i+1}º</div>
        <div class="an-strat-info">
          <div class="an-strat-name">${l.nome}</div>
          <div class="an-strat-detail">
            Saldo ${fmtBRL(l.saldo)}
            ${l.jurosEstimado>0?' · Juros est. '+fmtBRL(l.jurosEstimado):''}
            ${l.mesesRestantes>0?' · '+l.mesesRestantes+' meses':''}
          </div>
        </div>
        <div class="an-strat-taxa">${fmtBR(l.taxa,3)}% a.m.</div>
      </div>`).join('')}
    <div class="an-tip">
      💡 <strong>Bola de Neve</strong> (alternativa): quite o <em>menor saldo</em> primeiro —
      "${[...ativos].sort((a,b)=>a.saldo-b.saldo)[0]?.nome||''}" — para ganhar
      momentum psicológico. Pode custar mais em juros, mas aumenta a disciplina.
    </div>`;
}

