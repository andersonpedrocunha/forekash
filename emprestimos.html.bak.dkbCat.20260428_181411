  divida:      ['O Peso da Dívida','Endividamento sob Controle?','Estrutura de Capital','Compromissos com Bancos','Serviço da Dívida'],
  financeiro:  ['Resultado em uma Página','O Que o P&L Está Dizendo','Receita · Margem · Resultado','Desempenho Financeiro','A Linha do Resultado'],
  conclusao:   ['O Que Levar Deste Período','Síntese & Ações','Decisões Pendentes','Resumo Executivo','Próximas Movimentações'],
  geral:       ['Foto do Período','Painel Executivo','Indicadores em Destaque','Visão Consolidada','O Que Mudou no Período']
};
// Cycle counter pra alternar variações de forma "aleatória mas estável" entre chamadas
let _anaVarSeed = 0;
function _anaPickVar(arr){
  if(!arr || arr.length === 0) return '';
  _anaVarSeed = (_anaVarSeed + 1) % 1000;
  // Usa Date.now() pra variar a cada clique
  const i = (Math.floor(Date.now()/100) + _anaVarSeed) % arr.length;
  return arr[i];
}

function _anaAutoTitleFromSlide(slide){
  if(!slide) return _anaPickVar(TITLE_VARIATIONS.geral);
  if(!slide.widgets || slide.widgets.length === 0) return _anaPickVar(TITLE_VARIATIONS.geral);
  const cats = { hero:0, kpi:0, chart:0, text:0 };
  const subjects = new Set();
  for(const w of slide.widgets){
    const def = ANA_WIDGETS[w.widget];
    if(!def) continue;
    cats[def.category] = (cats[def.category] || 0) + 1;
    const wid = w.widget || '';
    if(/receita|ebitda|burn|margem|fluxo|cash|breakeven|mom|yoy/.test(wid)) subjects.add('financeiro');
    if(/clientes|churn|top-clientes|ltv|ticket/.test(wid)) subjects.add('clientes');
    if(/headcount|folha|sal|turnover|func/.test(wid)) subjects.add('pessoas');
    if(/endiv|loans/.test(wid)) subjects.add('divida');
    if(/saldo|runway/.test(wid)) subjects.add('caixa');
  }
  if(subjects.has('clientes') && subjects.size === 1) return _anaPickVar(TITLE_VARIATIONS.clientes);
  if(subjects.has('pessoas') && subjects.size === 1) return _anaPickVar(TITLE_VARIATIONS.pessoas);
  if(subjects.has('caixa') && subjects.size <= 2) return _anaPickVar(TITLE_VARIATIONS.caixa);
  if(subjects.has('divida') && subjects.size <= 2) return _anaPickVar(TITLE_VARIATIONS.divida);
  if(subjects.has('financeiro') && subjects.size === 1) return _anaPickVar(TITLE_VARIATIONS.financeiro);
  if(cats.text > 0 && cats.chart === 0 && cats.kpi === 0) return _anaPickVar(TITLE_VARIATIONS.conclusao);
  return _anaPickVar(TITLE_VARIATIONS.geral);
}
function _anaAutoNarrativaFromSlide(slide){
  if(!slide) return '';
  const facts = _anaCollectFacts();
  const k = _anaCalcKPIs(facts);
  const x = _anaCalcIndicadoresExtra(k, facts);
  const fmt = (n) => fmtBRL(n||0);
  const fmtPct = (n) => (isFinite(n) ? n.toFixed(1).replace('.',',') : '0,0') + '%';
  const meses = x.meses;
  const subjects = new Set();
  for(const w of (slide.widgets||[])){
    const wid = w.widget || '';
    if(/receita|ebitda|margem|fluxo|burn|cash|breakeven|mom|yoy/.test(wid)) subjects.add('financeiro');
    if(/clientes|churn|top-clientes|ltv|ticket/.test(wid)) subjects.add('clientes');
    if(/headcount|folha|sal|turnover|func/.test(wid)) subjects.add('pessoas');
    if(/endiv|loans/.test(wid)) subjects.add('divida');
    if(/saldo|runway/.test(wid)) subjects.add('caixa');
  }
  const cliMap = new Map();
  for(const f of facts){
    if(f.modulo !== 'receita') continue;
    cliMap.set(f.entidade, (cliMap.get(f.entidade)||0) + (parseFloat(f.valor)||0));
  }
  const topCli = Array.from(cliMap.entries()).sort((a,b)=>b[1]-a[1]).slice(0,3);
  const top3Pct = k.receita > 0 ? (topCli.reduce((s,c)=>s+c[1], 0) / k.receita * 100) : 0;

  // ═══ CONCLUSÃO — gera formato 3-COL: Vitória | Realidade | Estratégia ═══
  const isConclusao = (slide.title || '').match(/conclus|pr[óo]ximos|recomenda|s[íi]ntese|a[çc][õo]es/i)
                    || ((slide.widgets||[]).every(w => w.widget === 'text'));
  if(subjects.size === 0 && isConclusao){
    // ── A VITÓRIA — o que está bem ──
    const vitoria = [];
    if(k.margem >= 15) vitoria.push('Margem saudável de ' + fmtPct(k.margem) + ' — operação gera resultado.');
    else if(k.margem > 0 && k.ebitda > 0) vitoria.push('Operação no positivo: ' + fmt(k.ebitda) + ' de EBITDA no período.');
    if(k.runway >= 12) vitoria.push('Caixa de ' + fmt(k.saldo) + ' garante ' + k.runway.toFixed(1) + ' meses de pista — fôlego confortável.');
    else if(k.runway >= 6 && k.runway < 12) vitoria.push(k.runway.toFixed(1) + ' meses de runway — posição razoável de liquidez.');
    if(k.churn > 0 && k.churn < 5) vitoria.push('Retenção sólida — churn em apenas ' + fmtPct(k.churn) + '.');
    if(x.momPct > 5) vitoria.push('Receita acelerando: +' + fmtPct(x.momPct) + ' MoM no último mês.');
    if(k.turnover > 0 && k.turnover < 10) vitoria.push('Time estável — turnover de ' + fmtPct(k.turnover) + '.');
    if(x.pctFolha > 0 && x.pctFolha < 30) vitoria.push('Folha enxuta em ' + fmtPct(x.pctFolha) + ' da receita.');
    if(vitoria.length === 0){
      // fallback: pelo menos algo positivo
      if(k.receita > 0) vitoria.push('Geramos ' + fmt(k.receita) + ' em receita ao longo do período.');
      else vitoria.push('Período registrado e indicadores monitorados.');
    }

    // ── A REALIDADE — riscos / pontos de atenção ──
    const realidade = [];
    if(k.runway >= 0 && k.runway < 6) realidade.push((k.runway < 3 ? 'Caixa crítico — apenas ' : 'Pista curta — ') + k.runway.toFixed(1) + ' meses de runway no burn atual.');
    if(k.ebitda < 0) realidade.push('Operação no vermelho: ' + fmt(k.ebitda) + ' de EBITDA negativo.');
    else if(k.margem > 0 && k.margem < 5) realidade.push('Margem apertada de ' + fmtPct(k.margem) + ' deixa pouca gordura.');
    if(k.churn >= 15) realidade.push('Churn elevado em ' + fmtPct(k.churn) + ' — clientes saindo mais rápido que o saudável.');
    if(top3Pct > 50) realidade.push('Concentração alta: top 3 clientes = ' + fmtPct(top3Pct) + ' da receita.');
    if(x.pctLoans > 30) realidade.push('Endividamento pesado: ' + fmtPct(x.pctLoans) + ' da receita compromete dívida.');
    if(x.momPct < -5) realidade.push('Receita desacelerando: ' + fmtPct(x.momPct) + ' MoM no último mês.');
    if(k.turnover >= 20) realidade.push('Turnover elevado de ' + fmtPct(k.turnover) + ' — pessoas saindo demais.');
    if(x.pctFolha >= 50) realidade.push('Folha pesa ' + fmtPct(x.pctFolha) + ' da receita — limite operacional.');
    if(realidade.length === 0) realidade.push('Sem alertas críticos no período. Manter monitoramento.');

    // ── A ESTRATÉGIA — ações numeradas ──
    const estrategia = [];
    if(k.runway < 6 && k.runway >= 0) estrategia.push((k.runway < 3 ? 'Reforçar caixa imediato' : 'Reforçar caixa') + ': acelerar cobrança e ativar Crédito Disponível.');
    if(k.margem < 5 && k.receita > 0) estrategia.push('Revisar precificação e estrutura de custos — buscar +5pp de margem.');
    else if(k.margem >= 15 && k.runway >= 6) estrategia.push('Reinvestir resultado em alavancas de crescimento (produto, GTM, time).');
    if(k.churn >= 15) estrategia.push('Diagnosticar causa-raiz dos últimos cancelamentos antes de qualquer ação comercial.');
    if(top3Pct > 50) estrategia.push('Reduzir dependência do top 3 — meta de levar abaixo de 40% nos próximos trimestres.');
    if(x.pctLoans > 30) estrategia.push('Refinanciar dívidas mais caras via Crédito Disponível.');
    if(k.turnover >= 20) estrategia.push('Investigar saídas dos últimos meses e revisar política de retenção.');
    if(x.pctFolha >= 50) estrategia.push('Avaliar produtividade por pessoa e racionalizar headcount onde couber.');
    if(estrategia.length === 0) estrategia.push('Manter disciplina operacional e ritmo de acompanhamento mensal.');
    // Limita a 3-4 ações por coluna pra não inflar
    const top3 = (arr, n) => arr.slice(0, n);

    // ── Composição final no formato [3-COL] ──
    // Sorteia variação visual + conjunto de títulos pra dar variedade
    const VARIANTS = ['default', 'cards', 'numerals', 'stripes'];
    const TITLE_SETS = [
      { v: 'A Vitória (O Que Celebramos)',  r: 'A Realidade (Onde Há Risco)',     e: 'A Estratégia (Próximos Passos)' },
      { v: 'Performance',                    r: 'Riscos',                            e: 'Decisões' },
      { v: 'O Que Funciona',                 r: 'O Que Pesa',                        e: 'O Que Fazer' },
      { v: 'Forças do Período',              r: 'Pontos de Atenção',                 e: 'Movimentos Recomendados' },
      { v: 'Onde Ganhamos',                  r: 'Onde Sofremos',                     e: 'Onde Apostar' },
      { v: 'Conquistas',                     r: 'Frentes em Risco',                  e: 'Próximos Passos' }
    ];
    const variant = _anaPickVar(VARIANTS);
    const titles = _anaPickVar(TITLE_SETS);
    const join = (arr) => arr.map(x => x).join('\n');
    return '[3-COL:' + variant + ']\n'
         + '✓ ' + titles.v + '\n' + join(top3(vitoria, 3))
         + '\n---\n'
         + '⚠ ' + titles.r + '\n' + join(top3(realidade, 3))
         + '\n---\n'
         + '◎ ' + titles.e + '\n'
         + top3(estrategia, 4).map((a, i) => (i+1) + '. ' + a).join('\n');
  }

  // ═══ Slides sem assunto identificado ═══  // ═══ Slides sem assunto identificado ═══
