    msg += `<li><b>Impostos</b>: ${fmtBRL(snap.impostos.totalCorrente||0)} correntes/ano</li>`;
  }
  // Empréstimos
  if(snap.emprestimos){
    msg += `<li><b>Empréstimos</b>: ${snap.emprestimos.qtd||0} ativo${snap.emprestimos.qtd===1?'':'s'}, saldo ${fmtBRL(snap.emprestimos.saldo||0)}, total ano ${fmtBRL(snap.emprestimos.totalAno||0)}</li>`;
  }
  // Disponibilidades
  if(snap.dispo){
    msg += `<li><b>Disponibilidades</b>: ${snap.dispo.contasAtivas||0} conta${snap.dispo.contasAtivas===1?'':'s'} ativa${snap.dispo.contasAtivas===1?'':'s'}, saldo ${fmtBRL(snap.dispo.saldoAtual||0)}</li>`;
  }
  // Cartoes
  try {
    const cd = (typeof cartoes !== 'undefined' && cartoes) ? cartoes : null;
    if(cd && Array.isArray(cd.list) && cd.list.length > 0){
      const ativos = cd.list.filter(c=>c.ativo!==false).length;
      msg += `<li><b>Cartões</b>: ${ativos} ativo${ativos===1?'':'s'}</li>`;
    }
  } catch(_){}
  // Cadastro
  try {
    const reg = (typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.registry)) ? pessoas.registry : [];
    const cli = reg.filter(p => p && p.kind === 'cli' && p.ativo!==false).length;
    const forn = reg.filter(p => p && p.kind === 'forn' && p.ativo!==false).length;
    if(cli + forn > 0) msg += `<li><b>Cadastro</b>: ${cli} cliente${cli===1?'':'s'} + ${forn} fornecedor${forn===1?'':'es'}</li>`;
  } catch(_){}
  msg += `</ul>`;
  if(ind.score != null) msg += `<br><b>Score de saúde geral:</b> ${ind.score}/100 (${diagHealthLabel(ind.score).label}).`;
  msg += `<br><br><small style="opacity:.75">Quer detalhar alguma dessas áreas? É só perguntar — ex.: "lista meus cartões", "fornecedores cadastrados", "próximos vencimentos".</small>`;
  return msg;
}

// ========= Indicadores macroeconomicos (USD/SELIC/IPCA/INPC) =========
function mrcashMacro(qn){
  // Pesca cache do market do home (sessionStorage 'home_market_v4')
  let cache = null;
  try {
    if(typeof _homeMarketCache !== 'undefined' && _homeMarketCache) cache = _homeMarketCache;
    if(!cache){
      const raw = sessionStorage.getItem('home_market_v4');
      if(raw) cache = JSON.parse(raw);
    }
  } catch(_){}

  if(!cache){
    return `Hmm.<br><br>Ainda não tenho a cotação carregada — passa rápido na <b>Início</b> que ela atualiza, depois me pergunta de novo. Os indicadores ficam em cache por 15 minutos.`;
  }

  // Detecta qual indicador especifico
  const wantUSD   = /(dolar|usd|cotacao|cambio|ptax|moeda)/.test(qn);
  const wantSelic = /selic/.test(qn);
  const wantIpca  = /ipca/.test(qn);
  const wantInpc  = /inpc/.test(qn);
  const wantInflacao = /inflacao|precos/.test(qn);
  const showAll = !wantUSD && !wantSelic && !wantIpca && !wantInpc && !wantInflacao;

  let msg = '';
  // Dolar
  if(wantUSD || showAll){
    const u = cache.usd;
    if(u){
      const pct = u.pctChange;
      const dirSym = pct > 0 ? '▲' : (pct < 0 ? '▼' : '·');
      const cls = pct > 0 ? 'diag-hi-neg' : (pct < 0 ? 'diag-hi-pos' : '');
      const dataTs = u.timestamp ? new Date(u.timestamp*1000).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}) : '';
      msg += `<b>Dólar (USD/BRL):</b> <b>R$ ${u.bid.toFixed(4).replace('.',',')}</b> <span class="${cls}">${dirSym} ${(pct>=0?'+':'')+pct.toFixed(2)}%</span> hoje${dataTs?` <small>(${dataTs})</small>`:''}.<br>Mín: R$ ${u.low.toFixed(4).replace('.',',')} · Máx: R$ ${u.high.toFixed(4).replace('.',',')}<br>`;
    } else if(wantUSD){
      msg += `<b>Dólar:</b> não disponível no cache.<br>`;
    }
  }
  // SELIC
  if(wantSelic || showAll){
    const sl = cache.selic;
    if(sl){
      const v = (sl.valor != null) ? sl.valor : sl;
      const lbl = sl.data ? ` <small>(meta Copom · ${sl.data})</small>` : '';
      msg += `<b>SELIC:</b> <b>${parseFloat(v).toFixed(2).replace('.',',')}%</b> a.a.${lbl}<br>`;
    } else if(wantSelic){
      msg += `<b>SELIC:</b> não disponível no cache.<br>`;
    }
  }
  // IPCA
  if(wantIpca || wantInflacao || showAll){
    const ip = cache.ipca;
    if(ip){
      msg += `<b>IPCA acum. 12m:</b> <b>${parseFloat(ip.valor).toFixed(2).replace('.',',')}%</b> ${ip.data?`<small>(ref. ${ip.data})</small>`:''}<br>`;
    } else if(wantIpca){
      msg += `<b>IPCA:</b> não disponível no cache.<br>`;
    }
  }
  // INPC
  if(wantInpc || wantInflacao || showAll){
    const np = cache.inpc;
    if(np){
      msg += `<b>INPC acum. 12m:</b> <b>${parseFloat(np.valor).toFixed(2).replace('.',',')}%</b> ${np.data?`<small>(ref. ${np.data})</small>`:''}<br>`;
    } else if(wantInpc){
      msg += `<b>INPC:</b> não disponível no cache.<br>`;
    }
  }
  if(!msg){
    return `Não tenho esse indicador no cache. <br><br>Os disponíveis no momento são: <b>dólar</b>, <b>SELIC</b>, <b>IPCA</b> e <b>INPC</b>.`;
  }

  // Comentario contextual
  if(showAll){
    msg += `<br><small style="opacity:.75">Os 4 indicadores que aparecem no painel inicial. Atualizo o cache a cada 15 min.</small>`;
  }
  return msg;
}

function mrcashFallback(qOriginal){
