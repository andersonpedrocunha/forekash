function _extBaixaCalcTotal(){
  const v = parseFloat(document.getElementById('ext-bx-val')?.value) || 0;
  const j = parseFloat(document.getElementById('ext-bx-juros')?.value) || 0;
  const m = parseFloat(document.getElementById('ext-bx-multa')?.value) || 0;
  const d = parseFloat(document.getElementById('ext-bx-desc')?.value) || 0;
  const total = v + j + m - d;
  const elT = document.getElementById('ext-bx-total');
  if(elT) elT.textContent = total.toFixed(2).replace('.', ',');
  // Saldo restante = original - valor pago/recebido
  const orig = (_extBaixaCtx && _extBaixaCtx.valorOrig) || 0;
  const saldo = Math.max(0, orig - v);
  const elS = document.getElementById('ext-bx-saldo');
  const elH = document.getElementById('ext-bx-saldo-hint');
  if(elS){
    elS.textContent = 'R$ ' + saldo.toFixed(2).replace('.', ',');
    elS.classList.toggle('zero', saldo <= 0.001);
  }
  if(elH){
    if(saldo > 0.001){
      elH.textContent = '⚠ Pagamento parcial — saldo permanece em aberto.';
      elH.style.color = '#FCD34D';
    } else if(v > orig + 0.001){
      elH.textContent = 'ℹ Valor maior que o original (juros/multa cobertos).';
      elH.style.color = '#86EFAC';
    } else {
      elH.textContent = 'Quitação total · esta parcela será encerrada.';
      elH.style.color = '#94A3B8';
    }
  }
}
function extBaixaSave(){
  const c = _extBaixaCtx;
  if(!c) return;
  if(c.blocked){
    if(typeof toast === 'function') toast('⛔ ' + (c.blockedMsg || 'Operação bloqueada por regra do módulo'));
    return;
  }
  const data  = (document.getElementById('ext-bx-data')?.value  || '').trim();
  const forma = (document.getElementById('ext-bx-forma')?.value || '').trim();
  const conta = (document.getElementById('ext-bx-conta')?.value || '').trim();
  const valor = parseFloat(document.getElementById('ext-bx-val')?.value)   || 0;
  const juros = parseFloat(document.getElementById('ext-bx-juros')?.value) || 0;
  const multa = parseFloat(document.getElementById('ext-bx-multa')?.value) || 0;
  const desc  = parseFloat(document.getElementById('ext-bx-desc')?.value)  || 0;
  if(!data){ if(typeof toast === 'function') toast('⚠ Preencha a data'); return; }
  if(!conta){ if(typeof toast === 'function') toast('⚠ Selecione a conta'); return; }
  if(valor < 0){ if(typeof toast === 'function') toast('⚠ Valor inválido'); return; }
  const totalPago = valor + juros + multa - desc;
  // Lê split (se a seção foi exibida)
  const _splitAmort = parseFloat(document.getElementById('ext-bx-amort')?.value);
  const _splitJurosEmb = parseFloat(document.getElementById('ext-bx-juros-emb')?.value);
  const _hasSplit = !isNaN(_splitAmort) && !isNaN(_splitJurosEmb);
  // Lê fornecedor selecionado (custom select dkb-forn-wrap).
  // _fornFieldShown indica se o input foi exibido (só quando o item NÃO tinha fornecedor).
  // Se o campo NÃO foi exibido, mantemos o fornecedor existente sem mexer.
  const _fornFieldShown = !!document.getElementById('dkb-forn-wrap');
  const fornIdNew = (function(){
    const w = document.getElementById('dkb-forn-wrap');
    const v = w ? w.getAttribute('data-forn-id') : '';
    return v ? parseInt(v, 10) : null;
  })();

  // Aplica conforme tipo de origem
  const id = c.id;
  if(id.startsWith('rec:')){
    const parts = id.split(':');
    const y = parseInt(parts[1], 10), rowId = parseInt(parts[2], 10), mAbbr = parts[3];
    const d = receita && receita.years && receita.years[y];
    if(!d) return;
    const row = (d.clients || []).find(r => r.id === rowId);
    if(!row || !row.meses || !row.meses[mAbbr]) return;
    const cell = row.meses[mAbbr];
    cell.status = 'recebido';
    cell.dataRecebimento = data;
    // Banco: tenta resolver bancoId pelo nome
    if(conta && typeof dispo !== 'undefined' && Array.isArray(dispo.bancos)){
      const b = dispo.bancos.find(x => (x.nome||'') === conta);
      if(b) cell.banco = b.id;
    }
    if(forma) cell.formaPagamento = forma;
    cell.valorPago = valor; cell.juros = juros; cell.multa = multa; cell.desconto = desc;
    if(_fornFieldShown){
      if(fornIdNew) cell.fornecedorId = fornIdNew; else delete cell.fornecedorId;
    }
    // Comprovantes (multi-anexo)
    if(Array.isArray(_extBxCompData) && _extBxCompData.length > 0) cell.comprovante = _extBxCompData.slice();
    else delete cell.comprovante;
    if(typeof receitaSave === 'function') receitaSave();
    if(typeof _recKbSyncSheetCell === 'function') _recKbSyncSheetCell(y, mAbbr, rowId);
    if(typeof updateRecTotals === 'function'){ try { updateRecTotals(); } catch(_){} }
    if(typeof renderReceita === 'function'){ try { renderReceita(); } catch(_){} }
    if(typeof recRenderKanban === 'function'){ try { recRenderKanban(); } catch(_){} }
    if(typeof renderRecCalendar === 'function'){ try { renderRecCalendar(); } catch(_){} }
  } else if(id.startsWith('dkb:')){
    const parts = id.split(':');
    const ctxId = parts[1], itemId = parts.slice(2, parts.length-1).join(':'), ym = parts[parts.length-1];
    const ad = DKB_ADAPTERS[ctxId];
    if(!ad) return;
    const it = (ad.items() || []).find(x => String(x.id) === itemId || x.id === parseInt(itemId,10));
    if(!it) return;
    ad.setPago(it, ym, true);
    const meta = _dkbMeta(it, ym);
    meta.dataPagamento = data;
    if(conta && typeof dispo !== 'undefined' && Array.isArray(dispo.bancos)){
      const b = dispo.bancos.find(x => (x.nome||'') === conta);
      if(b) meta.banco = b.id;
    }
    if(forma) meta.formaPagamento = forma;
    meta.valorPago = valor; meta.juros = juros; meta.multa = multa; meta.desconto = desc;
    if(_hasSplit){ meta.amortizacao = _splitAmort; meta.jurosEmbutidos = _splitJurosEmb; }
    // Fornecedor: só atualiza se o campo apareceu (item ainda não tinha forn).
    // Se já havia fornecedor, o campo nem foi mostrado — preserva o existente.
    if(_fornFieldShown){
      if(fornIdNew) meta.fornecedorId = fornIdNew; else delete meta.fornecedorId;
    }
    // Para parcelamentos de impostos, ajusta o valor pago real (em vez do parcelaMensal default)
    if(ctxId === 'imp-par'){
      if(!it.pagamentos) it.pagamentos = {};
      it.pagamentos[ym] = valor;
    }
    if(ad.save) ad.save();
    if(typeof dkbRender === 'function'){ try { dkbRender(ctxId); } catch(_){} }
    // Atualiza a planilha do módulo de origem (Estrutura / Pessoas / Impostos)
    if(ad.onSheetReturn){ try { ad.onSheetReturn(); } catch(_){} }
  } else if(id.startsWith('m:')){
    const realId = parseInt(id.replace(/^m:/,''), 10);
    const l = (extratoData.lancamentos||[]).find(x => x.id === realId);
    if(!l) return;
    l.status = 'pago';
    l.dataPagamento = data;
    l.conta = conta || l.conta;
