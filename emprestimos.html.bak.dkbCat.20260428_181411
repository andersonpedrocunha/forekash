  if(board.cards.length === 0){
    body.innerHTML = '<div class="bd-empty"><span class="bd-empty-icon">🗂</span>'
      + '<div style="font-weight:800;color:#475569;font-size:1rem;margin-bottom:6px">Nenhum card no board</div>'
      + '<div style="font-size:.84rem">Click em <strong>+ Novo card</strong> ou <strong>⬇ Importar</strong> JSON do kanban_v8 antigo</div>'
