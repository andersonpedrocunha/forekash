function bdSaveCard(){
  if(_bdEditId == null) return;
  const name = (document.getElementById('bd-i-name')?.value || '').trim();
  if(!name){ if(typeof toast === 'function') toast('⚠ Nome obrigatório'); return; }
  let c = board.cards.find(x => x.id === _bdEditId);
  const isNew = !c;
  // Captura valores antigos pra comparar e gerar auto-notes
  const oldCol = isNew ? null : c.col;
  const oldDeadline = isNew ? null : c.deadline;
  if(isNew){
    c = { id: _bdEditId, createdAt: new Date().toISOString(), doneAt: null, notes: [] };
    board.cards.push(c);
  }
  if(!Array.isArray(c.notes)) c.notes = [];
  c.name = name;
  c.col = document.getElementById('bd-i-col')?.value || 'backlog';
  c.priority = document.getElementById('bd-i-pri')?.value || 'media';
  c.deadline = document.getElementById('bd-i-deadline')?.value || null;
  c.tagIds = _bdEditTagIds.slice();
  if(c.col === 'done' && !c.doneAt) c.doneAt = new Date().toISOString();
  if(c.col !== 'done' && c.doneAt) c.doneAt = null;
  // Auto-notes
  const colNomeOf = (id) => { const co = (typeof BD_COLS!=='undefined') ? BD_COLS.find(x => x.id===id) : null; return co ? co.nome : id; };
  if(isNew){
    _bdAutoNote(c, 'Card criado em "' + colNomeOf(c.col) + '"');
    if(c.deadline) _bdAutoNote(c, 'Deadline definido: ' + _bdFmtData(c.deadline).replace(/\/(\d{2})$/, '/20$1'));
  } else {
    if(c.col !== oldCol) _bdAutoNote(c, 'Movido para "' + colNomeOf(c.col) + '"');
    if((c.deadline||'') !== (oldDeadline||'')){
      if(c.deadline) _bdAutoNote(c, (oldDeadline ? 'Deadline alterado: ' : 'Deadline definido: ') + _bdFmtData(c.deadline).replace(/\/(\d{2})$/, '/20$1'));
      else _bdAutoNote(c, 'Deadline removido');
    }
  }
  bdSave();
  bdCloseCardModal();
  bdRender();
  if(typeof toast === 'function') toast(isNew ? '✓ Card criado' : '✓ Card atualizado');
}
