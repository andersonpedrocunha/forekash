function _anaSlideCanvasDrop(e){
  if(!_anaSlideDragLib && _anaSlideDragWid == null) return;
  e.preventDefault();
  e.currentTarget.classList.remove('drop-active');
  const s = _anaSlideCurrent(); if(!s) return;
  // Calcula cell do cursor
  const rect = e.currentTarget.getBoundingClientRect();
  const cs = getComputedStyle(e.currentTarget);
  const padL = parseFloat(cs.paddingLeft) || 0;
  const padT = parseFloat(cs.paddingTop) || 0;
  const usableW = rect.width - padL*2;
  const colW = usableW / 4;
  const gap = parseFloat(cs.gap) || 10;
  const rowH = parseFloat(cs.gridAutoRows) || 120;
  const x = e.clientX - rect.left - padL;
  const y = e.clientY - rect.top - padT;
  let col = Math.max(1, Math.min(4, Math.floor(x / colW) + 1));
  let row = Math.max(1, Math.floor(y / (rowH + gap)) + 1);
  if(_anaSlideDragLib){
    const w = ANA_WIDGETS[_anaSlideDragLib];
    if(w){
      const defaultRows = (w.category === 'chart' || w.category === 'table') ? 2 : 1;
      let actualCol = col;
      if(actualCol + w.defaultCols - 1 > 4) actualCol = Math.max(1, 5 - w.defaultCols);
      s.widgets.push({
        id: _anaSlideWidgetNextId++, widget: _anaSlideDragLib,
        cols: w.defaultCols, rows: defaultRows,
        colStart: actualCol, rowStart: row,
        text: _anaSlideDragLib === 'text' ? '' : undefined
      });
    }
  } else if(_anaSlideDragWid != null){
    const w = (s.widgets||[]).find(x => x.id === _anaSlideDragWid);
    if(w){
      let actualCol = col;
      const cols = w.cols || 1;
      if(actualCol + cols - 1 > 4) actualCol = Math.max(1, 5 - cols);
      w.colStart = actualCol;
      w.rowStart = row;
    }
  }
  _anaSlideDragLib = null; _anaSlideDragWid = null;
  _anaSaveState();
  _anaRenderPresent();
}
