function updateGuiaHeaderProgress(){
  if(!_guiaProgress) return;
  let doneCount = 0;
  GUIA_NODES.forEach(n => { if(guiaNodeDone(n.key)) doneCount++; });
  const total = GUIA_NODES.length;
  const pctEl = document.getElementById('guia-prog-fill');
  const valEl = document.getElementById('guia-prog-val');
  const totEl = document.getElementById('guia-prog-tot');
  if(pctEl) pctEl.style.width = (total ? (100 * doneCount / total) : 0) + '%';
  if(valEl) valEl.textContent = doneCount;
  if(totEl) totEl.textContent = total;
}

function _guiaHexToRGBA(hex, a){
  let h = (hex || '').replace(/^#/, '');
  if(h.length === 3) h = h.split('').map(c => c+c).join('');
  const r = parseInt(h.slice(0,2), 16);
  const g = parseInt(h.slice(2,4), 16);
  const b = parseInt(h.slice(4,6), 16);
  if([r,g,b].some(v => isNaN(v))) return 'rgba(99,102,241,' + (a != null ? a : 1) + ')';
  return 'rgba(' + r + ',' + g + ',' + b + ',' + (a != null ? a : 1) + ')';
}

