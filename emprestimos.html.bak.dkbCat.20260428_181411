// Grid de meses — fechados (snapshot) vs abertos (usa default)
function _cacRenderOverrideGrid(kind, id, mesKey){
  const cur = mesKey.split('-').map(n => parseInt(n, 10));
  const months = [];
  for(let i = -11; i <= 0; i++){
    const d = new Date(cur[0], cur[1] - 1 + i, 1);
    const k = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
    const lbl = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'][d.getMonth()] + '/' + String(d.getFullYear()).slice(2);
    months.push({ key: k, label: lbl, isCurrent: k === mesKey });
  }
  const getClosed = kind === 'item' ? _cacItemPctClosed : _cacPessoaPctClosed;
  const getDef = kind === 'item' ? _cacItemPctDefault : _cacPessoaPctDefault;
  const setterFn = kind === 'item' ? 'cacSetItemPctClosed' : 'cacSetPessoaPctClosed';
  const clearFn = kind === 'item' ? 'cacClearItemClosed' : 'cacClearPessoaClosed';
  const def = getDef(id);
  let html = '<div class="cfg-cac-ov-grid">'
    + '<div class="cfg-cac-ov-hint">'
    +   '<span class="cfg-cac-ov-legend"><span class="dot dot-open"></span> Aberto = usa o padrão (' + def + '%) — muda automaticamente se você alterar o padrão</span>'
    +   '<span class="cfg-cac-ov-legend"><span class="dot dot-closed"></span> Fechado = snapshot travado naquele % específico</span>'
    + '</div>'
    + '<div class="cfg-cac-ov-months">';
  for(const m of months){
    const closed = getClosed(id, m.key);
    const isClosed = closed !== null;
    const displayVal = isClosed ? closed : def;
    html += '<div class="cfg-cac-ov-month' + (m.isCurrent ? ' is-current' : '') + (isClosed ? ' is-closed' : ' is-open') + '">'
      + '<div class="cfg-cac-ov-lbl">' + m.label + '</div>'
      + '<input type="number" min="0" max="100" step="5" value="' + displayVal + '"' + (isClosed ? '' : ' disabled') + ' onchange="' + setterFn + '(' + id + ', \'' + m.key + '\', this.value)" title="' + (isClosed ? 'Mês fechado · clique no cadeado pra reabrir' : 'Mês aberto · usa o padrão') + '">'
      + '<button class="cfg-cac-ov-lock" onclick="' + (isClosed ? 'cacReabrirMes(\'' + kind + '\', ' + id + ', \'' + m.key + '\')' : 'cacFecharMes(\'' + kind + '\', ' + id + ', \'' + m.key + '\')') + '" title="' + (isClosed ? 'Reabrir (volta a usar o padrão)' : 'Fechar mês com o % atual') + '">' + (isClosed ? '🔒' : '🔓') + '</button>'
    + '</div>';
  }
  html += '</div>'
    + '<div class="cfg-cac-ov-actions">'
    +   '<button onclick="cacFecharAteMes(\'' + kind + '\', ' + id + ', \'' + mesKey + '\')" class="cfg-cac-quick" title="Fecha 24 meses até e incluindo o mês de referência">🔒 Fechar até ' + months[months.length-1].label + '</button>'
    +   '<button onclick="' + clearFn + '(' + id + ')" class="cfg-cac-quick" title="Reabre todos os meses fechados">🔓 Reabrir todos</button>'
    + '</div>'
    + '</div>';
  return html;
}
