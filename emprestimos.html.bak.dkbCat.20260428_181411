function addNewTipo(){
  if(!receita.tipos) receita.tipos = [];
  const id = recTipoNewId();
  // Escolhe a próxima cor da paleta que ainda não está em uso (ou cicla)
  const usadas = new Set(receita.tipos.map(t => t.color));
  let color = REC_TIPO_PALETTE.find(c => !usadas.has(c)) || REC_TIPO_PALETTE[receita.tipos.length % REC_TIPO_PALETTE.length];
  receita.tipos.push({id, nome:'Novo tipo', color});
  receitaSave();
  renderTipoManager();
  // Foca no input do novo tipo para renomear
  setTimeout(()=>{
    const el = document.querySelector(`.tipo-item[data-tipo-id="${id}"] input[type="text"]`);
    if(el){ el.focus(); el.select(); }
  }, 40);
}

function renameTipo(id, novoNome){
  const tipos = receita.tipos || [];
  const t = tipos.find(x => x.id === id);
  if(!t) return;
  const nomeAntigo = t.nome;
  const nomeLimpo = (novoNome || '').trim();
  if(!nomeLimpo){
    // Rejeita nome vazio — restaura
    const el = document.querySelector(`.tipo-item[data-tipo-id="${id}"] input[type="text"]`);
    if(el) el.value = nomeAntigo;
    return;
  }
  if(nomeLimpo === nomeAntigo) return;
  // Evita duplicatas (case-insensitive)
  const existe = tipos.some(x => x.id !== id && x.nome.toLowerCase() === nomeLimpo.toLowerCase());
  if(existe){
    toast('⚠️ Já existe um tipo com esse nome.');
    const el = document.querySelector(`.tipo-item[data-tipo-id="${id}"] input[type="text"]`);
    if(el) el.value = nomeAntigo;
    return;
  }
  t.nome = nomeLimpo;
  // Atualiza todas as linhas que referenciam o nome antigo
  for(const y of Object.keys(receita.years)){
    const d = receita.years[y];
    for(const r of [...(d.clients||[]), ...(d.leads||[])]){
      if(r.tipo === nomeAntigo) r.tipo = nomeLimpo;
    }
  }
  if(recFilterTipo === nomeAntigo) recFilterTipo = nomeLimpo;
  receitaSave();
}

async function deleteTipo(id){
  const tipos = receita.tipos || [];
  const t = tipos.find(x => x.id === id);
  if(!t) return;
  // Conta quantas linhas usam esse tipo
  let emUso = 0;
  for(const y of Object.keys(receita.years)){
    const d = receita.years[y];
    for(const r of [...(d.clients||[]), ...(d.leads||[])]){
      if(r.tipo === t.nome) emUso++;
    }
  }
  const msg = emUso
    ? `Excluir o tipo "${t.nome}"?\n\n${emUso} linha${emUso===1?'':'s'} ficará${emUso===1?'':'o'} sem tipo. Essa ação não pode ser desfeita.`
    : `Excluir o tipo "${t.nome}"?`;
  const ok = await showConfirm({
    title: 'Excluir tipo?',
    message: msg,
    confirmLabel: 'Excluir',
    destructive: true
  });
  if(!ok) return;
  // Remove referências nas linhas
  for(const y of Object.keys(receita.years)){
    const d = receita.years[y];
    for(const r of [...(d.clients||[]), ...(d.leads||[])]){
      if(r.tipo === t.nome) r.tipo = '';
    }
  }
  if(recFilterTipo === t.nome) recFilterTipo = '';
  receita.tipos = tipos.filter(x => x.id !== id);
  receitaSave();
  renderTipoManager();
  toast('✅ Tipo excluído.');
}

function changeTipoColor(id, color){
  const t = (receita.tipos || []).find(x => x.id === id);
  if(!t) return;
  t.color = color;
  receitaSave();
  renderTipoManager();
}

