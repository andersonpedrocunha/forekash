const REG_EFETIV_KEY = 'reg_efetivados_v1';
let regsEfetivados = {};
(function _regEfetivLoad(){
  try {
    const raw = localStorage.getItem(REG_EFETIV_KEY);
    if(!raw) return;
    const parsed = JSON.parse(raw);
    // Migração: se veio como array de strings (formato antigo), converte com ts = now
    if(Array.isArray(parsed)){
      const nowIso = new Date().toISOString();
      for(const mes of parsed) if(typeof mes === 'string') regsEfetivados[mes] = nowIso;
    } else if(parsed && typeof parsed === 'object'){
      for(const k of Object.keys(parsed)){
        if(typeof parsed[k] === 'string') regsEfetivados[k] = parsed[k];
      }
    }
  } catch(e){}
})();
