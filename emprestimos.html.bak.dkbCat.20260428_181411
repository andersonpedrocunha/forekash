function updatePnyrOptions(){
  const sel = document.querySelector('input[name="pnyr-src"]:checked');
  const opts = document.getElementById('pnyr-copy-options');
  const preview = document.getElementById('pnyr-preview');
  if(!sel || !opts) return;
  const src = sel.value;
  if(src){
    opts.style.display = '';
    const copySal  = document.getElementById('pnyr-copy-salarios');
    const copyReaj = document.getElementById('pnyr-copy-reaj');
    const doSal  = copySal ? copySal.checked  : true;
    const doReaj = copyReaj ? copyReaj.checked : true;
    if(preview){
      const parts = [];
      if(doSal)  parts.push('salários');
      if(doReaj) parts.push('reajustes');
      preview.textContent = parts.length
        ? `Copiará: ${parts.join(' + ')} de ${src}`
        : `Apenas criará o ano (nada será copiado de ${src})`;
    }
  } else {
    opts.style.display = 'none';
    if(preview) preview.textContent = 'Ano em branco — nenhum valor copiado.';
  }
}
// Atualiza o preview quando o usuário mexe nos checkboxes
document.addEventListener('change', (ev)=>{
  if(ev.target && (ev.target.id === 'pnyr-copy-salarios' || ev.target.id === 'pnyr-copy-reaj')){
    updatePnyrOptions();
  }
});

function copyPesYearData(fromY, toY, opts){
  const { copySalarios = true, copyReajustes = true } = opts || {};
  if(copySalarios){
    for(const p of pessoas.people){
      if(!p.salarios) p.salarios = {};
      for(let i=0;i<12;i++){
        const kFrom = pesMesKey(fromY, i);
        const kTo   = pesMesKey(toY,   i);
        if(p.salarios[kFrom] !== undefined && p.salarios[kFrom] !== null){
          p.salarios[kTo] = p.salarios[kFrom];
        }
      }
    }
  }
  if(copyReajustes){
    if(!pessoas.reajustes) pessoas.reajustes = {};
    for(const k of Object.keys(pessoas.reajustes)){
      if(!k.startsWith(fromY+'-')) continue;
      const mm = k.slice(fromY.length+1); // 'YYYY-MM' → 'MM'
      pessoas.reajustes[toY + '-' + mm] = pessoas.reajustes[k];
    }
  }
}

async function submitPesNewYear(){
  const inp = document.getElementById('pnyr-year');
  if(!inp) return;
  const y = String(inp.value||'').trim();
  if(!/^\d{4}$/.test(y)){
    await showInfo({title:'Ano inválido', message:'Informe um ano com 4 dígitos (ex: 2027).', warning:true});
    inp.focus();
    return;
  }
  if(pessoas.years.includes(y)){
    await showInfo({title:'Ano já existe', message:'Este ano já existe.', warning:true});
    inp.focus();
    return;
  }
  const srcSel = document.querySelector('input[name="pnyr-src"]:checked');
  const src = srcSel ? srcSel.value : '';
  const copySal  = document.getElementById('pnyr-copy-salarios');
  const copyReaj = document.getElementById('pnyr-copy-reaj');
  pessoas.years.push(y);
  pessoas.years.sort();
  if(src){
    copyPesYearData(src, y, {
      copySalarios:  copySal  ? copySal.checked  : true,
      copyReajustes: copyReaj ? copyReaj.checked : true
    });
  }
  pesActiveYear = y;
  pessoasSave();
  closePesNewYearModal();
  renderPessoas();
  if(typeof toast === 'function'){
    toast(src
      ? `✅ Ano ${y} criado a partir de ${src}.`
      : `✅ Ano ${y} criado em branco.`);
  }
}

async function delPesYear(y){
  if(pessoas.years.length <= 1){ await showInfo({title:'Ação não permitida', message:'É preciso manter ao menos um ano.', warning:true}); return; }
  const ok = await showConfirm({
    title:`Remover ano ${y}?`,
    message:`Remover o ano ${y} da planilha?\n\nOs salários deste ano serão apagados.`,
    confirmLabel:'Remover',
    destructive:true
  });
  if(!ok) return;
  pessoas.years = pessoas.years.filter(x=>x!==y);
  // limpa salários deste ano em todas as pessoas
  for(const p of pessoas.people){
    for(const k of Object.keys(p.salarios)){
      if(k.startsWith(y+'-')) delete p.salarios[k];
    }
  }
  // limpa reajustes do ano
  for(const k of Object.keys(pessoas.reajustes)){
    if(k.startsWith(y+'-')) delete pessoas.reajustes[k];
  }
  pesActiveYear = pessoas.years[pessoas.years.length-1];
  pessoasSave();
  renderPessoas();
}

