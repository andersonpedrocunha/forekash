let _guiaProgress  = null;   // { [key]: Set<idx> }
let _guiaActiveKey = null;

function guiaLoadProgress(){
  try{
    const raw = localStorage.getItem(GUIA_KEY);
    const obj = raw ? JSON.parse(raw) : {};
    const out = {};
    GUIA_NODES.forEach(n => {
      const arr = Array.isArray(obj[n.key]) ? obj[n.key] : [];
      out[n.key] = new Set(arr.filter(i => Number.isInteger(i) && i >= 0 && i < n.steps.length));
    });
    _guiaProgress = out;
  }catch(e){
    _guiaProgress = {};
    GUIA_NODES.forEach(n => { _guiaProgress[n.key] = new Set(); });
  }
}

function guiaSaveProgress(){
  try{
    const out = {};
    Object.keys(_guiaProgress || {}).forEach(k => {
      out[k] = Array.from(_guiaProgress[k]).sort((a,b)=>a-b);
    });
    localStorage.setItem(GUIA_KEY, JSON.stringify(out));
  }catch(e){}
}

function guiaNodeDone(key){
  const n = GUIA_NODES.find(x => x.key === key);
  if(!n) return false;
  const set = _guiaProgress && _guiaProgress[key];
  return !!(set && set.size >= n.steps.length && n.steps.length > 0);
}

function guiaNodeProgress(key){
  const n = GUIA_NODES.find(x => x.key === key);
  if(!n) return 0;
  const set = _guiaProgress && _guiaProgress[key];
  const total = n.steps.length || 1;
  return set ? (set.size / total) : 0;
}

function openGuia(){
  if(!_guiaProgress) guiaLoadProgress();
  const ov = document.getElementById('ov-guia');
  if(!ov) return;
  renderGuiaMap();
  updateGuiaHeaderProgress();
  selectGuiaNode(_guiaActiveKey || null);
  ov.classList.add('open');
}

function closeGuia(){
  const ov = document.getElementById('ov-guia');
  if(ov) ov.classList.remove('open');
}

function renderGuiaMap(){
  const map = document.getElementById('guia-map');
  const svg = document.getElementById('guia-links');
  if(!map || !svg) return;

  // Remove nós antigos e linhas (preserva .guia-center e #guia-links)
  Array.from(map.querySelectorAll('.guia-node')).forEach(el => el.remove());
  while(svg.firstChild) svg.removeChild(svg.firstChild);

  const cx = 380, cy = 310, radius = 240;
  const total = GUIA_NODES.length;
  const svgNS = 'http://www.w3.org/2000/svg';

  GUIA_NODES.forEach((n, i) => {
    const angle = (-90 + (360/total) * i) * (Math.PI / 180);
    const x = cx + Math.cos(angle) * radius;
    const y = cy + Math.sin(angle) * radius;

    // Linha central → nó
    const line = document.createElementNS(svgNS, 'line');
    line.setAttribute('x1', cx);
    line.setAttribute('y1', cy);
    line.setAttribute('x2', x);
    line.setAttribute('y2', y);
    line.setAttribute('data-node', n.key);
    if(guiaNodeDone(n.key)) line.classList.add('done');
    svg.appendChild(line);

    // Card do nó
    const done = guiaNodeDone(n.key);
    const prog = guiaNodeProgress(n.key);
    const set  = (_guiaProgress && _guiaProgress[n.key]) || new Set();
    const ringCirc = 2 * Math.PI * 9; // r=9
    const offset   = ringCirc * (1 - prog);

    const card = document.createElement('div');
    card.className = 'guia-node' + (done ? ' done' : '');
    card.setAttribute('data-node', n.key);
    card.style.left = x + 'px';
    card.style.top  = y + 'px';
    card.addEventListener('click', () => selectGuiaNode(n.key));
    card.innerHTML = `
      <div class="guia-node-head">
        <span class="guia-node-ord">${String(n.ord).padStart(2,'0')}</span>
        <div class="guia-node-ring" title="${set.size} de ${n.steps.length} concluídos">
          <svg viewBox="0 0 22 22">
            <circle class="bg" cx="11" cy="11" r="9"></circle>
            <circle class="fg" cx="11" cy="11" r="9"
                    stroke-dasharray="${ringCirc.toFixed(2)}"
                    stroke-dashoffset="${offset.toFixed(2)}"></circle>
          </svg>
        </div>
      </div>
      <div class="guia-node-ico" style="background:${n.color}">${n.icon}</div>
      <div class="guia-node-lbl">${esc(n.label)}</div>
      <span class="guia-node-done-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>
      </span>
    `;
    map.appendChild(card);
  });

  // Destaca nó ativo (se houver)
  if(_guiaActiveKey){
    const active = map.querySelector('.guia-node[data-node="' + _guiaActiveKey + '"]');
    if(active) active.classList.add('active');
    const line = svg.querySelector('line[data-node="' + _guiaActiveKey + '"]');
    if(line) line.classList.add('hl');
  }
}

function selectGuiaNode(key){
  _guiaActiveKey = key;

  const map     = document.getElementById('guia-map');
  const svg     = document.getElementById('guia-links');
  const empty   = document.getElementById('guia-drawer-empty');
  const content = document.getElementById('guia-drawer-content');
  if(!map || !svg || !empty || !content) return;

  // Remove realce anterior
  map.querySelectorAll('.guia-node.active').forEach(el => el.classList.remove('active'));
  svg.querySelectorAll('line.hl').forEach(el => el.classList.remove('hl'));

  if(!key){
    empty.style.display = '';
    content.style.display = 'none';
    return;
  }

  const n = GUIA_NODES.find(x => x.key === key);
  if(!n){
    empty.style.display = '';
    content.style.display = 'none';
    return;
  }

  // Marca ativo no mapa
  const card = map.querySelector('.guia-node[data-node="' + key + '"]');
  if(card) card.classList.add('active');
  const line = svg.querySelector('line[data-node="' + key + '"]');
  if(line) line.classList.add('hl');

  empty.style.display = 'none';
  content.style.display = '';

  // Cabeçalho do drawer
  const ordEl = document.getElementById('guia-drawer-ord');
  if(ordEl){
    ordEl.textContent = 'Etapa ' + n.ord;
    ordEl.style.background = _guiaHexToRGBA(n.color, .18);
    ordEl.style.color      = n.color;
  }
  const icoEl = document.getElementById('guia-drawer-ico');
  if(icoEl){
    icoEl.style.background = n.color;
    icoEl.innerHTML = n.icon;
  }
  const nameEl = document.getElementById('guia-drawer-name');
  if(nameEl) nameEl.textContent = n.label;

  const introEl = document.getElementById('guia-drawer-intro');
  if(introEl) introEl.textContent = n.intro || '';

  const tipEl = document.getElementById('guia-drawer-tip');
  if(tipEl){
    if(n.tip){
      tipEl.innerHTML = '<strong>Dica:</strong> ' + esc(n.tip);
      tipEl.style.display = '';
    }else{
      tipEl.style.display = 'none';
    }
  }

  // Checklist
  const stepsEl = document.getElementById('guia-drawer-steps');
  const countEl = document.getElementById('guia-drawer-count');
  const set = (_guiaProgress && _guiaProgress[key]) || new Set();
  if(stepsEl){
    stepsEl.innerHTML = n.steps.map((txt, idx) => {
      const done = set.has(idx);
      return '<li class="guia-step' + (done?' done':'') + '" onclick="toggleGuiaStep(\'' + key + '\',' + idx + ')">'
           +   '<span class="guia-step-box">'
           +     '<svg viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></svg>'
           +   '</span>'
           +   '<span class="guia-step-txt">' + esc(txt) + '</span>'
           + '</li>';
    }).join('');
  }
  if(countEl){
    countEl.textContent = set.size + ' / ' + n.steps.length;
  }
}

function toggleGuiaStep(key, idx){
  if(!_guiaProgress) guiaLoadProgress();
  if(!_guiaProgress[key]) _guiaProgress[key] = new Set();
  if(_guiaProgress[key].has(idx)) _guiaProgress[key].delete(idx);
  else                            _guiaProgress[key].add(idx);
  guiaSaveProgress();
  renderGuiaMap();
  selectGuiaNode(key);
  updateGuiaHeaderProgress();
}

function guiaResetProgress(){
  if(!_guiaActiveKey) return;
  if(!_guiaProgress) guiaLoadProgress();
  _guiaProgress[_guiaActiveKey] = new Set();
  guiaSaveProgress();
  renderGuiaMap();
  selectGuiaNode(_guiaActiveKey);
  updateGuiaHeaderProgress();
}

function guiaOpenModule(){
  if(!_guiaActiveKey) return;
