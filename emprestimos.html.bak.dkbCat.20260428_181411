/* ─── Fact extractor — gera linhas planas a partir de todos módulos ─── */
function _anaIterPeriodo(cb){
  const idxDe = _anaState.anoDe*12 + _anaState.mesDe;
  const idxAte = _anaState.anoAte*12 + _anaState.mesAte;
  for(let idx = idxDe; idx <= idxAte; idx++){
    const y = String(Math.floor(idx/12));
    const m = idx % 12;
    const ym = y + '-' + String(m+1).padStart(2,'0');
    cb(y, m, ym, idx);
  }
}
function _anaPeriodoLabel(ym){
  if(!ym || !/^\d{4}-\d{2}$/.test(ym)) return ym;
  const [y,mm] = ym.split('-').map(Number);
  return ANA_MESES[mm-1] + '/' + String(y).slice(2);
}
function _anaCollectFacts(){
  const facts = [];
  const includeMod = (id) => _anaState.modulos.includes(id);
  const stFilter = _anaState.statusFilter || 'all';
  // ─── RECEITA ───
  if(includeMod('receita') && typeof receita !== 'undefined' && receita && receita.years){
    const MESES_NM = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
    _anaIterPeriodo((y, m, ym) => {
      const yData = receita.years[y]; if(!yData) return;
      for(const cli of (yData.clients || [])){
        const cName = (receita.clientes || []).find(c => c.id === cli.clienteId);
        const cell = (cli.meses || {})[MESES_NM[m]];
        if(!cell) continue;
        const v = parseFloat(cell.valor) || 0;
        if(v <= 0) continue;
        const baixado = (cell.status === 'recebido');
        if(stFilter === 'baixado' && !baixado) continue;
        if(stFilter === 'aberto'  &&  baixado) continue;
        facts.push({
          ym, ano:String(y), modulo:'receita',
          entidade: (cName && cName.nome) || '(cliente)',
          categoria: cell.status || 'pendente',
          baixado, valor: v
        });
      }
    });
  }
  // ─── COMISSÕES ───
  if(includeMod('comissoes') && typeof vendedores !== 'undefined' && vendedores && Array.isArray(vendedores.lista)){
    _anaIterPeriodo((y, m, ym) => {
      for(const v of vendedores.lista){
        if(v.ativo === false) continue;
        const com = (typeof comissaoVendedorMes === 'function')
          ? (comissaoVendedorMes(v, y, m) || 0) : 0;
        if(com === 0) continue;
        const baixado = !!(v.pagos && v.pagos[ym]);
        if(stFilter === 'baixado' && !baixado) continue;
        if(stFilter === 'aberto'  &&  baixado) continue;
        facts.push({ ym, ano:String(y), modulo:'comissoes', entidade: v.nome || '(vendedor)', categoria:'comissao', baixado, valor: com });
      }
    });
  }
  // ─── PESSOAS (folha) — sem conceito de baixado; entra em "todos" e "baixado"
  if(includeMod('pessoas') && typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.people)){
    _anaIterPeriodo((y, m, ym) => {
      for(const p of pessoas.people){
        if(p.sim) continue;
        if(p.ativo === false) continue;
        const sal = (p.salarios && p.salarios[ym]) ? (parseFloat(p.salarios[ym])||0) : 0;
        if(sal === 0) continue;
        if(stFilter === 'aberto') continue; // folha já é considerada baixada
        const tipo = (pessoas.tipos||[]).find(t => t.id === p.tipoId);
        facts.push({ ym, ano:String(y), modulo:'pessoas', entidade: p.nome || '(pessoa)',
                     categoria: (tipo && tipo.nome) || 'sem tipo', baixado:true, valor: sal });
      }
    });
  }
  // ─── ESTRUTURA ───
  if(includeMod('estrutura') && typeof estrutura !== 'undefined' && estrutura && Array.isArray(estrutura.itens)){
    _anaIterPeriodo((y, m, ym) => {
      for(const it of estrutura.itens){
        const v = parseFloat((it.valores||{})[ym]) || 0;
        if(v === 0) continue;
        const baixado = !!(it.pagos && it.pagos[ym]);
        if(stFilter === 'baixado' && !baixado) continue;
        if(stFilter === 'aberto'  &&  baixado) continue;
        const tag = (estrutura.tags||[]).find(t => t.id === it.tagId);
        facts.push({ ym, ano:String(y), modulo:'estrutura', entidade: it.nome || '(item)',
                     categoria: (tag && tag.nome) || 'sem tag', baixado, valor: v });
      }
    });
  }
  // ─── EMPRÉSTIMOS (parcela mensal) — sem conceito ym de baixado por parcela;
  //     consideramos baixado se a parcela cai num mês JÁ PASSADO (pago) e em aberto se futuro
  if(includeMod('loans') && typeof loans !== 'undefined' && Array.isArray(loans)){
    const today = new Date();
    const curYm = today.getFullYear() + '-' + String(today.getMonth()+1).padStart(2,'0');
    _anaIterPeriodo((y, m, ym) => {
      for(const ln of loans){
        const parc = parseFloat(ln.parcelaVal) || 0;
        if(parc <= 0) continue;
        const saldo = parseFloat(ln.saldo) || 0;
        if(saldo <= 0) continue;
        const baixado = ym <= curYm;  // parcelas passadas = pagas
        if(stFilter === 'baixado' && !baixado) continue;
        if(stFilter === 'aberto'  &&  baixado) continue;
        facts.push({ ym, ano:String(y), modulo:'loans',
                     entidade: (ln.banco||'?') + (ln.descricao?(' — '+ln.descricao):''),
                     categoria: ln.tipo || 'price', baixado, valor: parc });
      }
    });
  }
  // ─── DISPONIBILIDADES (saldos) — saldo é sempre "realizado/baixado"
  if(includeMod('dispo') && typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.contas)){
    _anaIterPeriodo((y, m, ym) => {
      if(stFilter === 'aberto') return; // saldo não tem conceito de aberto
      for(const c of dispo.contas){
        const v = parseFloat((c.saldos||{})[ym]) || 0;
        if(v === 0) continue;
        const banco = (dispo.bancos||[]).find(b => b.id === c.bancoId);
        const tipo  = (dispo.tipos||[]).find(t => t.id === c.tipoId);
        facts.push({ ym, ano:String(y), modulo:'dispo',
                     entidade: (banco && banco.nome) || (c.banco||'(conta)'),
                     categoria: (tipo && tipo.nome) || 'conta', baixado:true, valor: v });
      }
    });
  }
  return facts;
}

/* ─── Métricas calculadas (KPIs) ─── */
function _anaCalcKPIs(facts){
  const kpis = {};
  // Soma simples por módulo
  const sumByMod = (mod) => facts.filter(f => f.modulo === mod).reduce((s,f) => s + f.valor, 0);
  kpis.receita = sumByMod('receita');
  kpis.folha   = sumByMod('pessoas');
  kpis.estrutura = sumByMod('estrutura');
  kpis.comissoes = sumByMod('comissoes');
  kpis.loans     = sumByMod('loans');
  kpis.endividamento = (typeof loans !== 'undefined' && Array.isArray(loans))
    ? loans.reduce((s,l) => s + (parseFloat(l.saldo)||0), 0) : 0;
  // EBITDA simplificado: receita − folha − estrutura − comissões
  kpis.ebitda = kpis.receita - kpis.folha - kpis.estrutura - kpis.comissoes;
  kpis.margem = kpis.receita > 0 ? (kpis.ebitda / kpis.receita * 100) : 0;
  // Saldo: último valor de dispo
  let saldoAtual = 0;
  if(typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.contas)){
    const idxAte = _anaState.anoAte*12 + _anaState.mesAte;
    const yA = Math.floor(idxAte/12), mA = idxAte%12;
    const ymA = yA + '-' + String(mA+1).padStart(2,'0');
    for(const c of dispo.contas) saldoAtual += parseFloat((c.saldos||{})[ymA]) || 0;
  }
  kpis.saldo = saldoAtual;
  // Headcount: média de pessoas ativas no período
  let hc = 0, hcCount = 0;
  if(typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.people)){
    _anaIterPeriodo((y,m,ym) => {
      let c = 0;
      for(const p of pessoas.people){
        if(p.sim || p.ativo === false) continue;
        if((p.salarios||{})[ym] && parseFloat(p.salarios[ym]) > 0) c++;
      }
      hc += c; hcCount++;
    });
  }
  kpis.headcount = hcCount > 0 ? Math.round(hc / hcCount) : 0;
  // LTV: receita média por cliente × 12 (proxy simples)
  const clientes = new Set(facts.filter(f => f.modulo === 'receita').map(f => f.entidade));
  const ticketMedio = clientes.size > 0 ? kpis.receita / clientes.size : 0;
  // Estimativa LTV = ticket médio mensal × 12 meses (proxy)
  const meses = (_anaState.anoAte*12 + _anaState.mesAte) - (_anaState.anoDe*12 + _anaState.mesDe) + 1;
  const ticketMensal = meses > 0 ? ticketMedio / meses : 0;
  kpis.ltv = ticketMensal * 12;
  kpis.clientesAtivos = clientes.size;
  // Churn: clientes que tinham receita no período anterior mas não tem agora
  // (proxy: compara último mês vs primeiro mês)
  if(meses >= 2){
    const idxDe = _anaState.anoDe*12 + _anaState.mesDe;
    const idxAte = _anaState.anoAte*12 + _anaState.mesAte;
    const ymDe = Math.floor(idxDe/12) + '-' + String((idxDe%12)+1).padStart(2,'0');
    const ymAte = Math.floor(idxAte/12) + '-' + String((idxAte%12)+1).padStart(2,'0');
    const setDe = new Set(facts.filter(f => f.ym === ymDe && f.modulo==='receita').map(f => f.entidade));
    const setAte= new Set(facts.filter(f => f.ym === ymAte && f.modulo==='receita').map(f => f.entidade));
    let churned = 0;
    for(const c of setDe) if(!setAte.has(c)) churned++;
    kpis.churn = setDe.size > 0 ? (churned / setDe.size * 100) : 0;
  } else kpis.churn = 0;
  // Turnover: pessoas que saíram no período / headcount inicial
  if(typeof pessoas !== 'undefined' && pessoas && Array.isArray(pessoas.people)){
    let saidas = 0, hcIni = 0;
    const ymDe = Math.floor((_anaState.anoDe*12+_anaState.mesDe)/12)+'-'+String(((_anaState.anoDe*12+_anaState.mesDe)%12)+1).padStart(2,'0');
    const ymAte= Math.floor((_anaState.anoAte*12+_anaState.mesAte)/12)+'-'+String(((_anaState.anoAte*12+_anaState.mesAte)%12)+1).padStart(2,'0');
    for(const p of pessoas.people){
      if(p.sim) continue;
      const tinhaIni = (p.salarios||{})[ymDe] && parseFloat(p.salarios[ymDe])>0;
      const tinhaAte = (p.salarios||{})[ymAte] && parseFloat(p.salarios[ymAte])>0;
      if(tinhaIni) hcIni++;
      if(tinhaIni && !tinhaAte) saidas++;
    }
    kpis.turnover = hcIni > 0 ? (saidas / hcIni * 100) : 0;
  } else kpis.turnover = 0;
  // Runway: saldo / burn rate mensal (folha + estrutura + comissões) / meses
  const burnMes = meses > 0 ? (kpis.folha + kpis.estrutura + kpis.comissoes) / meses : 0;
  kpis.runway = burnMes > 0 ? (kpis.saldo / burnMes) : 0;
  return kpis;
}

/* ─── Pivot engine ─── */
function _anaPivot(facts, rowFields, colFields, valueDefs){
  const rowKeyOf  = (f) => rowFields.map(rf => _anaFieldVal(f, rf)).join(' | ');
  const colKeyOf  = (f) => colFields.map(cf => _anaFieldVal(f, cf)).join(' | ');
  const rowSortOf = (f) => rowFields.map(rf => _anaFieldSortVal(f, rf)).join('|');
  const colSortOf = (f) => colFields.map(cf => _anaFieldSortVal(f, cf)).join('|');
  const rowKeys = new Set();
  const colKeys = new Set();
  // Maps display → sortKey (pra ordenar)
  const rowSortMap = {}, colSortMap = {};
  // bucket[rowKey][colKey][valIdx] = array de valores agregar
  const buckets = {};
  for(const f of facts){
    const rk = rowKeys.size === 0 || rowFields.length > 0 ? rowKeyOf(f) : '_';
    const ck = colFields.length > 0 ? colKeyOf(f) : '_';
    if(rowFields.length > 0){ rowKeys.add(rk); rowSortMap[rk] = rowSortOf(f); }
    if(colFields.length > 0){ colKeys.add(ck); colSortMap[ck] = colSortOf(f); }
    if(!buckets[rk]) buckets[rk] = {};
    if(!buckets[rk][ck]) buckets[rk][ck] = valueDefs.map(() => []);
    valueDefs.forEach((vd, i) => {
      let v = 0;
      if(vd.field === 'valor') v = parseFloat(f.valor) || 0;
      else if(vd.field === 'count') v = 1;
      buckets[rk][ck][i].push(v);
    });
  }
  const agg = (arr, type) => {
    if(arr.length === 0) return null;
    if(type === 'sum')   return arr.reduce((s,v)=>s+v, 0);
    if(type === 'avg')   return arr.reduce((s,v)=>s+v, 0) / arr.length;
    if(type === 'count') return arr.length;
    if(type === 'max')   return Math.max(...arr);
    if(type === 'min')   return Math.min(...arr);
    return arr.reduce((s,v)=>s+v, 0);
  };
  // Sort por sortKey (mantém ordem natural pros fields conhecidos)
  const cmp = (a, b, sortMap) => {
    const sa = sortMap[a] || a;
    const sb = sortMap[b] || b;
    return String(sa).localeCompare(String(sb));
  };
  const rkSorted = Array.from(rowKeys).sort((a,b) => cmp(a,b,rowSortMap));
  const ckSorted = Array.from(colKeys).sort((a,b) => cmp(a,b,colSortMap));
  if(rowFields.length === 0) rkSorted.unshift('_');
  if(colFields.length === 0) ckSorted.unshift('_');
  // Calcula matriz de agregados
  const matrix = {};
  for(const rk of rkSorted){
    matrix[rk] = {};
    for(const ck of ckSorted){
      matrix[rk][ck] = valueDefs.map((vd, i) => {
        const arr = buckets[rk] && buckets[rk][ck] ? buckets[rk][ck][i] : [];
        return agg(arr, vd.agg);
      });
    }
  }
  return { rowKeys: rkSorted, colKeys: ckSorted, matrix };
}
function _anaFieldVal(fact, fieldId){
  if(fieldId === 'periodo') return _anaPeriodoLabel(fact.ym);
  if(fieldId === 'ano')     return fact.ano;
  if(fieldId === 'modulo'){
    const m = ANA_MODULOS.find(x => x.id === fact.modulo);
    return m ? m.label : fact.modulo;
  }
  if(fieldId === 'entidade')  return fact.entidade || '—';
  if(fieldId === 'categoria') return fact.categoria || '—';
  return '—';
}
// Chave sortável (não pra display) — mantém ordem natural de cada field
function _anaFieldSortVal(fact, fieldId){
  if(fieldId === 'periodo') return fact.ym || '';                   // YYYY-MM ordena cronologicamente
  if(fieldId === 'ano')     return String(fact.ano || '').padStart(4,'0');
  if(fieldId === 'modulo'){
    const idx = ANA_MODULOS.findIndex(x => x.id === fact.modulo);
    return String(idx >= 0 ? idx : 99).padStart(2,'0');
  }
  // Pros demais (entidade, categoria) usa display normal
  return _anaFieldVal(fact, fieldId);
}

