      + '<div class="viag-kpi hl"><div class="viag-kpi-lbl">Total gasto</div><div class="viag-kpi-val">' + _viagFmt(totalGasto) + '</div><div class="viag-kpi-sub">empresa + funcionário</div></div>'
      + '<div class="viag-kpi"><div class="viag-kpi-lbl">💵 A reembolsar</div><div class="viag-kpi-val">' + _viagFmt(Math.max(0, totalFunc - totalAdiantado)) + '</div><div class="viag-kpi-sub">despesas do func. − adiantamentos</div></div>'
      + '<div class="viag-kpi"><div class="viag-kpi-lbl">⏱ Tempo médio (aberto)</div><div class="viag-kpi-val">' + (tempoMedioMs != null ? _viagFmtDuracao(tempoMedioMs) : '—') + '</div><div class="viag-kpi-sub">' + abertas.length + ' aberta(s) · ' + fechadas.length + ' fechada(s)</div></div>';
  }
  // KANBAN
  const gridEl = document.getElementById('viag-grid');
  if(!gridEl) return;
  const search = (document.getElementById('viag-search')?.value || '').toLowerCase().trim();
  let lista = viagens.itens.slice();
  if(search) lista = lista.filter(v =>
    (v.titulo || '').toLowerCase().includes(search) ||
    (v.destino || '').toLowerCase().includes(search) ||
    (v.colaborador || '').toLowerCase().includes(search)
  );
  // Filtro de data — pela DATA DA VIAGEM (dataInicio até dataFim)
  // Considera intersecção: viagem que tenha qualquer dia dentro do range
  const dFrom = document.getElementById('viag-date-from')?.value || '';
  const dTo   = document.getElementById('viag-date-to')?.value || '';
  if(dFrom || dTo){
    const fromMs = dFrom ? new Date(dFrom + 'T00:00:00').getTime() : -Infinity;
    const toMs   = dTo   ? new Date(dTo   + 'T23:59:59').getTime() :  Infinity;
    lista = lista.filter(v => {
      if(!v.dataInicio) return false;
      const startMs = new Date(v.dataInicio + 'T00:00:00').getTime();
      const endMs = v.dataFim ? new Date(v.dataFim + 'T23:59:59').getTime() : startMs + 86400000;
      // Intersecção entre [startMs, endMs] e [fromMs, toMs]
      return startMs <= toMs && endMs >= fromMs;
    });
  }
  if(viagens.itens.length === 0){
    gridEl.innerHTML = '<div class="viag-empty">'
      + '<span class="viag-empty-icon">✈</span>'
      + '<div class="viag-empty-title">Nenhum relatório de viagem ainda</div>'
      + '<div class="viag-empty-sub">Clique em <strong>+ Novo relatório</strong> para começar</div>'
      + '</div>';
    return;
  }
  // Decide view: kanban / tabela / categoria
  const view = _viagSettings.view || 'kanban';
  setTimeout(() => {
    const bk = document.getElementById('viag-view-kanban');
    const bt = document.getElementById('viag-view-table');
    const bc = document.getElementById('viag-view-cat');
    const bd = document.getElementById('viag-view-dash');
    if(bk) bk.classList.toggle('is-active', view === 'kanban');
    if(bt) bt.classList.toggle('is-active', view === 'table');
    if(bc) bc.classList.toggle('is-active', view === 'categoria');
    if(bd) bd.classList.toggle('is-active', view === 'dashboard');
  }, 0);
  if(view === 'table'){
    gridEl.innerHTML = _viagRenderTable(lista);
    return;
  }
  if(view === 'categoria'){
    gridEl.innerHTML = _viagRenderCategoria(lista);
    return;
  }
  if(view === 'dashboard'){
    gridEl.innerHTML = _viagRenderDashboard(lista);
    return;
  }
  // Agrupa por status (Kanban)
  const cols = VIAG_STATUS.map(st => ({
    id: st.id, nome: _viagColName(st.id),
    cards: lista.filter(v => (v.status || 'rascunho') === st.id)
                .sort((a,b) => (b.dataInicio||'').localeCompare(a.dataInicio||''))
  }));
  const _showAging = _viagSettings.showAging !== false;
  const _showSaldo = _viagSettings.showSaldo !== false;
  const _showColab = _viagSettings.showColab !== false;
  let html = '<div class="viag-kanban">';
  for(const col of cols){
    html += '<div class="viag-kb-col" data-status="' + col.id + '"'
         +   ' ondragover="event.preventDefault();this.classList.add(\'is-drop\')"'
         +   ' ondragleave="this.classList.remove(\'is-drop\')"'
         +   ' ondrop="viagDropCard(event, \'' + col.id + '\')">';
    html += '<div class="viag-kb-col-hd viag-kb-col-' + col.id + '">';
    html +=   '<span class="viag-kb-col-name">' + col.nome + '</span>';
    html +=   '<span class="viag-kb-col-count">' + col.cards.length + '</span>';
    html += '</div>';
    html += '<div class="viag-kb-col-bd">';
    if(col.cards.length === 0){
      html += '<div class="viag-kb-empty">Vazio</div>';
    } else {
      for(const v of col.cards){
        const tot = _viagTotalDesp(v);
        const saldo = _viagSaldo(v);
        const tEmp = _viagTotalEmpresa(v);
        const tFunc = _viagTotalFuncionario(v);
        html += '<div class="viag-kb-card" draggable="true"'
             +   ' ondragstart="viagDragCard(event, ' + v.id + ')"'
             +   ' onclick="viagOpenEditor(' + v.id + ')">'
             +   '<div class="viag-kb-card-name">' + esc(v.titulo || 'Sem título') + '</div>'
             +   '<div class="viag-kb-card-meta">'
             +     '<div>📍 ' + esc(v.destino || '—') + '</div>'
             +     (_showColab && v.colaborador
                  ? (function(){
                      const foto = _viagColabFoto(v);
                      const ava = foto
                        ? '<img src="' + foto + '" class="viag-kb-ava" alt="">'
                        : '<span class="viag-kb-ava-fb">👤</span>';
                      return '<div class="viag-kb-colab">' + ava + '<span>' + esc(v.colaborador) + '</span></div>';
                    })()
                  : '')
             +     '<div>📅 ' + _viagFmtData(v.dataInicio) + (v.dataFim && v.dataFim !== v.dataInicio ? ' → ' + _viagFmtData(v.dataFim) : '') + '</div>'
             +     (function(){
                  if(!_showAging) return '';
                  const ms = _viagMsAberta(v);
                  const dias = _viagDiasAberta(v);
                  if(ms == null) return '';
                  const closed = _viagIsClosed(v);
                  const cls = _viagAgeClass(dias || 0, closed);
                  const fmt = _viagFmtDuracao(ms);
                  const lbl = closed ? ('Fechada em ' + fmt) : ('Aberta há ' + fmt);
                  return '<div class="viag-kb-age ' + cls + '">⏱ ' + lbl + '</div>';
                })()
             +   '</div>'
             +   '<div class="viag-kb-card-foot">'
             +     '<div class="viag-kb-card-tot">'
             +       '<span class="lbl">Total</span>'
             +       '<span class="val">' + _viagFmt(tot) + '</span>'
             +     '</div>'
             +     (_showSaldo && saldo !== 0 ? '<div class="viag-kb-card-tot"><span class="lbl">Saldo</span><span class="val ' + (saldo >= 0 ? 'bal-pos' : 'bal-neg') + '">' + _viagFmt(saldo) + '</span></div>' : '')
             +   '</div>'
             +   (v.aprovacao ? '<div class="viag-kb-card-sig">🔏 ' + esc(v.aprovacao.aprovador||'') + (v.aprovacao.codigo ? ' · ' + v.aprovacao.codigo : '') + '</div>' : '')
             +   (v.rejeicao ? '<div class="viag-kb-card-rej" title="' + esc(v.rejeicao.motivo||'') + '">❌ ' + esc(v.rejeicao.por||'') + (v.rejeicao.codigo ? ' · ' + v.rejeicao.codigo : '') + '<div style="font-style:italic;font-weight:500;margin-top:2px;font-family:inherit">' + esc((v.rejeicao.motivo||'').slice(0,50)) + ((v.rejeicao.motivo||'').length > 50 ? '…' : '') + '</div></div>' : '')
             +   ((tFunc > 0 || tEmp > 0) ? '<div class="viag-kb-card-split">'
                  + (tFunc > 0 ? '<span style="color:#7C3AED">💵 ' + _viagFmt(tFunc) + '</span>' : '')
                  + (tEmp > 0 ? '<span style="color:#0F766E">💳 ' + _viagFmt(tEmp) + '</span>' : '')
                  + '<span style="color:#94A3B8;margin-left:auto">' + (v.despesas||[]).length + ' item(s)</span>'
                  + '</div>' : '')
             + '</div>';
      }
    }
    html += '</div></div>';
  }
  html += '</div>';
  gridEl.innerHTML = html;
}

