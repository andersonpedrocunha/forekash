function pessoasLoad(){
  let raw = null;
  try{ raw = localStorage.getItem(PES_KEY); }catch(e){}
  if(raw){
    try{
      pessoas = JSON.parse(raw);
    }catch(e){ pessoas = null; }
  }
  if(!pessoas || typeof pessoas !== 'object'){
    const y = String(new Date().getFullYear());
    pessoas = {
      activeYear: y,
      years: [String(parseInt(y)-1), y],
      tipos: JSON.parse(JSON.stringify(PES_TIPOS_DEFAULT)),
      people: [],
      registry: [],
      nextRegId: 1,
      reajustes: {},   // key 'YYYY-MM' => true
      nextId: 1
    };
  }
  // Migração / saneamento
  // ─── Migração: separar colaboradores e fornecedores no registry ───
  // Regra: quem tem linha em pessoas.people → colaborador; resto → fornecedor.
  // Itens já migrados (com kind válido) permanecem inalterados.
  if(Array.isArray(pessoas.registry)){
    const linkedIds = new Set();
    if(Array.isArray(pessoas.people)){
      for(const pp of pessoas.people){ if(pp.pessoaId) linkedIds.add(pp.pessoaId); }
    }
    for(const r of pessoas.registry){
      if(typeof r.kind !== 'string' || !['colaborador','fornecedor'].includes(r.kind)){
        if(linkedIds.has(r.id)) r.kind = 'colaborador';
        else r.kind = 'fornecedor';
      }
    }
  }
  if(!Array.isArray(pessoas.years) || pessoas.years.length === 0){
    const y = String(new Date().getFullYear());
    pessoas.years = [y];
  }
  pessoas.years = pessoas.years.map(String);
  if(!Array.isArray(pessoas.tipos) || pessoas.tipos.length === 0){
    pessoas.tipos = JSON.parse(JSON.stringify(PES_TIPOS_DEFAULT));
  }
  if(!Array.isArray(pessoas.people)) pessoas.people = [];
  if(!pessoas.reajustes || typeof pessoas.reajustes !== 'object') pessoas.reajustes = {};
  // Incluir "Simular Contratação" nos totais/KPIs? (default: não)
  if(typeof pessoas.includeSimInTotals !== 'boolean') pessoas.includeSimInTotals = false;
  // Simulação de reajuste por ano e por tipo
  //   { enabled, rulesByYear: { 'YYYY': { tipoId: { key:'YYYY-MM', pct } } } }
  if(!pessoas.reajSim || typeof pessoas.reajSim !== 'object'){
    pessoas.reajSim = { enabled: false, rulesByYear: {} };
  }
  if(typeof pessoas.reajSim.enabled !== 'boolean') pessoas.reajSim.enabled = false;
  if(!pessoas.reajSim.rulesByYear || typeof pessoas.reajSim.rulesByYear !== 'object') pessoas.reajSim.rulesByYear = {};
  // Migração da versão antiga: pessoas.reajSim.rules → rulesByYear[yearOfKey]
  if(pessoas.reajSim.rules && typeof pessoas.reajSim.rules === 'object'){
    for(const [tipoId, r] of Object.entries(pessoas.reajSim.rules)){
      if(!r || !r.key || !r.pct) continue;
      const y = String(r.key).split('-')[0];
      if(!pessoas.reajSim.rulesByYear[y]) pessoas.reajSim.rulesByYear[y] = {};
      pessoas.reajSim.rulesByYear[y][tipoId] = { key: r.key, pct: r.pct };
    }
    delete pessoas.reajSim.rules;
  }
  if(!pessoas.nextId){
    const maxId = pessoas.people.reduce((m,p)=>Math.max(m, p.id||0), 0);
    pessoas.nextId = Math.max(1, maxId+1);
  }
  // Filtro de status (todos | ativos | inativos)
  if(!['all','ativos','inativos'].includes(pessoas.statusFilter)){
    pessoas.statusFilter = 'all';
  }
  // ─── Registro global (nome único) ───
  if(!Array.isArray(pessoas.registry)) pessoas.registry = [];
  if(!pessoas.nextRegId){
    const maxReg = pessoas.registry.reduce((m,r)=>Math.max(m, r.id||0), 0);
    pessoas.nextRegId = Math.max(1, maxReg+1);
  }
  // Migração: dados cadastrais por pessoa (CLT/PJ/Estrangeiro) e ciclos anteriores.
  for(const r of pessoas.registry){
    // Migração: 'clt' foi renomeado pra 'pf' (pessoa física) pra alinhar com
    // a nomenclatura já usada no módulo de clientes.
    if(r.tipoPessoa === 'clt') r.tipoPessoa = 'pf';
    if(typeof r.tipoPessoa !== 'string' ||
       !['pf','pj','est'].includes(r.tipoPessoa)){
      r.tipoPessoa = 'pf';
    }
    if(typeof r.documento     !== 'string') r.documento     = '';
    if(typeof r.razaoSocial   !== 'string') r.razaoSocial   = '';
    // Para registros antigos, semeia "nome completo" com o que existia em
    // r.nome. Edições futuras no card não afetam mais a coluna da planilha.
    if(typeof r.nomeCompleto  !== 'string') r.nomeCompleto  = (r.nome || '');
    // Campos independentes por tipo — PF / Empresa / Estrangeiro guardam
    // seus próprios dados pra permitir trocar de tipo sem clobberizar.
    if(typeof r.cpf       !== 'string') r.cpf       = '';
    if(typeof r.cnpj      !== 'string') r.cnpj      = '';
    if(typeof r.taxId     !== 'string') r.taxId     = '';
    if(typeof r.nomeLegal !== 'string') r.nomeLegal = '';
    // Migração 1x: se ainda não houver valor pelo tipo ativo, herda do legado
    // r.documento / r.nomeCompleto conforme era usado antes.
    if(r.tipoPessoa === 'pf'  && !r.cpf       && r.documento)    r.cpf       = r.documento;
    if(r.tipoPessoa === 'pj'  && !r.cnpj      && r.documento)    r.cnpj      = r.documento;
    if(r.tipoPessoa === 'est' && !r.taxId     && r.documento)    r.taxId     = r.documento;
    if(r.tipoPessoa === 'est' && !r.nomeLegal && r.nomeCompleto) r.nomeLegal = r.nomeCompleto;
    if(!Array.isArray(r.ciclos))            r.ciclos        = [];
    if(!Array.isArray(r.anexos))            r.anexos        = [];
    if(typeof r.foto          !== 'string') r.foto          = '';
    if(typeof r.nacionalidade !== 'string') r.nacionalidade = '';
  }
  for(const p of pessoas.people){
    if(typeof p.ativo !== 'boolean') p.ativo = true;
    if(!p.salarios || typeof p.salarios !== 'object') p.salarios = {};
    if(!p.pagos    || typeof p.pagos    !== 'object') p.pagos    = {};
    if(!p.nome) p.nome = '';
    if(!p.tipoId) p.tipoId = (pessoas.tipos[0] || {}).id || '';
    if(!p.sim) p.sim = false;
  }
  // Migração de rows antigos: transformar p.nome legado em p.pessoaId via registry
  const byNome = new Map();
  for(const r of pessoas.registry){
    const key = (r.nome||'').trim().toLowerCase();
    if(key) byNome.set(key, r);
  }
  for(const p of pessoas.people){
    if(p.pessoaId) continue; // já migrado
    const nome = (p.nome||'').trim();
    if(!nome){ p.pessoaId = 0; continue; }
    const key = nome.toLowerCase();
    let reg = byNome.get(key);
    if(!reg){
      reg = { id: pessoas.nextRegId++, nome, kind: 'colaborador' };
      pessoas.registry.push(reg);
      byNome.set(key, reg);
    }
    p.pessoaId = reg.id;
  }
  if(!pessoas.activeYear || !pessoas.years.includes(pessoas.activeYear)){
    pessoas.activeYear = pessoas.years[pessoas.years.length-1];
  }
  pesActiveYear = pessoas.activeYear;
}

function pessoasSave(){
  pessoas.activeYear = pesActiveYear;
  try{ localStorage.setItem(PES_KEY, JSON.stringify(pessoas)); }catch(e){}
}

/* ═══════════════════════════════════════════════════════════════
   VENDEDORES & COMISSÕES
   Cada vendedor tem regras por período (de/ate) com % de comissão,
   base de cálculo (todos clientes OU específicos OU excluir alguns),
   tipo de receita (bruta ou líquida) e modo (simples OU escalonado).
   Escalonamento: faixas [{ate, pct}] — receita da faixa × pct.
   ═══════════════════════════════════════════════════════════════ */
const VEND_KEY = 'taller_vendedores_v1';
let vendedores = null;
function vendedoresLoad(){
  try { const raw = localStorage.getItem(VEND_KEY); vendedores = raw ? JSON.parse(raw) : null; }
  catch(e){ vendedores = null; }
  if(!vendedores || typeof vendedores !== 'object') vendedores = { lista: [], nextId: 1 };
  if(!Array.isArray(vendedores.lista)) vendedores.lista = [];
  if(!vendedores.nextId) vendedores.nextId = 1;
  for(const v of vendedores.lista){
    if(!Array.isArray(v.regras)) v.regras = [];
    for(const r of v.regras){
      if(!Array.isArray(r.clientes)) r.clientes = [];
      if(!Array.isArray(r.faixas))   r.faixas = [];
      if(typeof r.modo !== 'string') r.modo = 'simples';
    }
    // Migração: ajustes era um mapa { 'YYYY-MM': {valor, nota} };
    // agora é array [{ ym, valor, nota, regraId }] pra permitir
    // múltiplos ajustes no mesmo mês (1 por regra).
    if(v.ajustes && !Array.isArray(v.ajustes) && typeof v.ajustes === 'object'){
      const arr = [];
      for(const k of Object.keys(v.ajustes)){
        const a = v.ajustes[k] || {};
        arr.push({
          ym: k,
          valor: parseFloat(a.valor) || 0,
          nota: a.nota || '',
          regraId: null
        });
      }
      v.ajustes = arr;
    }
    if(!Array.isArray(v.ajustes)) v.ajustes = [];
    // Garante shape em cada item
    for(const a of v.ajustes){
      if(typeof a !== 'object' || a == null) continue;
      if(typeof a.ym !== 'string') a.ym = '';
      if(typeof a.nota !== 'string') a.nota = '';
      if(a.regraId === undefined) a.regraId = null;
    }
  }
}
function vendedoresSave(){
  try { localStorage.setItem(VEND_KEY, JSON.stringify(vendedores)); } catch(e){}
}
// Converte 'YYYY-MM' pra índice absoluto de meses (ano*12+mês)
function _vendYmIdx(ym){
  if(!ym || !/^\d{4}-\d{2}$/.test(ym)) return null;
  const [y,m] = ym.split('-').map(Number);
  return y*12 + (m-1);
}
// Retorna a primeira regra vigente pra um mês (compat — usado pra rótulo principal).
function vendedorRegraDoMes(v, year, mIdx){
  const todas = vendedorRegrasDoMes(v, year, mIdx);
  return todas.length > 0 ? todas[0] : null;
}
// Retorna TODAS as regras vigentes pra um mês (períodos sobrepostos são comuns
// quando o vendedor tem escopos disjuntos — cliente X a 5%, cliente Y a 80%).
function vendedorRegrasDoMes(v, year, mIdx){
  const out = [];
  if(!v || !Array.isArray(v.regras)) return out;
  const target = parseInt(year,10)*12 + mIdx;
  for(const r of v.regras){
    const de = _vendYmIdx(r.de);
    const ate = _vendYmIdx(r.ate);
    if(de != null && target < de) continue;
    if(ate != null && target > ate) continue;
    out.push(r);
  }
  return out;
}
// Soma da receita (bruta ou líquida) pra um conjunto de clientes num mês.
// tipoBase: 'bruta' (todas as linhas) | 'liquida' (só recebidas).
// clienteIds: array de IDs; se [] e base='todos', pega todos; se excluir=true,
// retorna soma EXCLUINDO os clientes listados.
function _vendReceitaClientesMes(year, mIdx, tipoBase, clienteIds, base){
  if(!receita || !receita.years) return 0;
  const yData = receita.years[year] || {};
  // Receita usa nomes de mês como chaves: 'jan','fev',...,'dez'
  const MESES_NM = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  const mKey = MESES_NM[mIdx];
  const rows = yData.clients || [];
  const idSet = new Set(clienteIds || []);
  let tot = 0;
  for(const r of rows){
    if(!r) continue;
    if(base === 'clientes' && !idSet.has(r.clienteId)) continue;
    if(base === 'exceto'   &&  idSet.has(r.clienteId)) continue;
    const cell = (r.meses || {})[mKey];
    if(!cell) continue;
    const v = parseFloat(cell.valor) || 0;
    if(v <= 0) continue;
    if(tipoBase === 'liquida' && cell.status !== 'recebido') continue;
    tot += v;
  }
  return tot;
}
// Retorna a comissão BRUTA (sem override/ajuste) detalhada por cliente —
// Map<clienteId, {bruto, liq, com, pct, regraIdx}>. Itera TODAS as regras
// vigentes no mês; pra evitar duplicar, um cliente só é contado pela PRIMEIRA
// regra cujo escopo o inclui (first-match wins).
function _vendComissaoPorCliente(v, year, mIdx){
  const MESES_NM = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  const out = new Map();
  if(!v || v.ativo === false) return out;
  const regras = vendedorRegrasDoMes(v, year, mIdx);
  if(regras.length === 0) return out;
  const yData = (receita && receita.years && receita.years[year]) || {};
  const mKey  = MESES_NM[mIdx];
  const claimed = new Set(); // clienteIds já alocados a uma regra
  // Processa cada regra na ordem — first-match wins pra evitar duplicação
  for(let ri = 0; ri < regras.length; ri++){
    const r = regras[ri];
    const tipoBase = r.tipoBase || 'bruta';
    const base     = r.base     || 'todos';
    const idSet    = new Set(r.clientes || []);
    const abaterPct = parseFloat(r.abaterImpostos) || 0;
    const modo = r.modo || 'simples';
    const pctPadrao = parseFloat(r.pct) || 0;
    const pctMap = (r.clientesPct && typeof r.clientesPct === 'object') ? r.clientesPct : {};
    // Coleta clientes desta regra (respeitando o escopo e sem duplicar com regras anteriores)
    const perClienteDaRegra = new Map();
    for(const row of (yData.clients || [])){
      if(!row) continue;
      if(base === 'clientes' && !idSet.has(row.clienteId)) continue;
      if(base === 'exceto'   &&  idSet.has(row.clienteId)) continue;
      if(claimed.has(row.clienteId)) continue; // já atendido por regra anterior
      const cell = (row.meses || {})[mKey];
      if(!cell) continue;
      const val = parseFloat(cell.valor) || 0;
      if(val <= 0) continue;
      if(tipoBase === 'liquida' && cell.status !== 'recebido') continue;
      if(!perClienteDaRegra.has(row.clienteId)){
        perClienteDaRegra.set(row.clienteId, {bruto:0, liq:0});
      }
      const pc = perClienteDaRegra.get(row.clienteId);
      pc.bruto += val;
      pc.liq   += val * (1 - abaterPct/100);
    }
    // Aplica modo pra esta regra e transfere pro out
    if(modo === 'escalonado' && Array.isArray(r.faixas) && r.faixas.length){
      let totalLiq = 0;
      for(const [, pc] of perClienteDaRegra) totalLiq += pc.liq;
      let effPct = 0;
      if(totalLiq > 0){
        const faixas = r.faixas.slice().sort((a,b) => (parseFloat(a.ate)||0) - (parseFloat(b.ate)||0));
        let comTot = 0, rest = totalLiq, base0 = 0;
        for(const f of faixas){
          const limite = parseFloat(f.ate) || 0;
          if(limite <= base0) continue;
          const slice = Math.min(rest, limite - base0);
          if(slice <= 0) break;
          comTot += slice * ((parseFloat(f.pct) || 0) / 100);
          rest -= slice; base0 = limite;
          if(rest <= 0) break;
        }
        if(rest > 0){
          const last = faixas[faixas.length - 1];
          if(last) comTot += rest * ((parseFloat(last.pct) || 0) / 100);
        }
        effPct = comTot/totalLiq*100;
      }
      for(const [cid, pc] of perClienteDaRegra){
        out.set(cid, { bruto:pc.bruto, liq:pc.liq, pct:effPct, com:pc.liq*effPct/100, regraIdx:ri });
        claimed.add(cid);
      }
    } else if(modo === 'porCliente'){
      for(const [cid, pc] of perClienteDaRegra){
        const pctRaw = pctMap[cid];
        const pct = (pctRaw !== undefined && pctRaw !== null && pctRaw !== '')
          ? (parseFloat(pctRaw) || 0) : pctPadrao;
        out.set(cid, { bruto:pc.bruto, liq:pc.liq, pct, com:pc.liq*pct/100, regraIdx:ri });
        claimed.add(cid);
      }
    } else {
      for(const [cid, pc] of perClienteDaRegra){
        out.set(cid, { bruto:pc.bruto, liq:pc.liq, pct:pctPadrao, com:pc.liq*pctPadrao/100, regraIdx:ri });
        claimed.add(cid);
      }
    }
  }
  return out;
}
// Calcula a comissão do vendedor num mês específico.
function comissaoVendedorMes(v, year, mIdx){
  if(!v || v.ativo === false) return 0;
  const _ym = year + '-' + String(mIdx+1).padStart(2,'0');
  // Override manual na célula — se presente, substitui o cálculo base.
  // Ajuste continua sendo adicionado em cima (independente).
  const override = (v.overrides && v.overrides[_ym] !== undefined && v.overrides[_ym] !== '')
    ? parseFloat(v.overrides[_ym]) : null;
  // Soma todos os ajustes do mês (estrutura nova: array). Cada ajuste pode
  // estar marcado pra uma regra específica via regraId — somamos todos pro
  // total do mês (a vinculação por regra é informativa/relatório).
  let ajuste = 0;
  if(Array.isArray(v.ajustes)){
    for(const a of v.ajustes){
      if(a && a.ym === _ym) ajuste += parseFloat(a.valor) || 0;
    }
  } else if(v.ajustes && v.ajustes[_ym]){
    // Backward-compat: ainda não migrado em memória
    ajuste = parseFloat(v.ajustes[_ym].valor) || 0;
  }
  if(override !== null && !isNaN(override)) return override + ajuste;
  const r = vendedorRegraDoMes(v, year, mIdx);
  if(!r) return ajuste;
  // Delega pro helper per-cliente e soma — cobre simples/escalonado/porCliente
  const perCli = _vendComissaoPorCliente(v, year, mIdx);
  let com = 0;
  for(const [, pc] of perCli) com += pc.com;
  return com + ajuste;
}
// Soma total de comissões de todos os vendedores ativos num mês.
function comissaoTotalMes(year, mIdx){
  if(!vendedores || !Array.isArray(vendedores.lista)) return 0;
  let tot = 0;
  for(const v of vendedores.lista){
    if(v.ativo === false) continue;
    tot += comissaoVendedorMes(v, year, mIdx) || 0;
  }
  return tot;
}
// Venda do vendedor num mês — soma a receita BRUTA de todos os clientes atendidos
// por alguma regra vigente (first-match pra evitar duplicar entre regras).
function vendedorVendaMes(v, year, mIdx){
  if(!v || v.ativo === false) return 0;
  const perCli = _vendComissaoPorCliente(v, year, mIdx);
  let total = 0;
  for(const [, pc] of perCli) total += pc.bruto;
  return total;
}
// Comissão PAGA num mês: só conta se pagos[ym] é true. Senão, zero.
function vendedorComissaoPagaMes(v, year, mIdx){
  if(!v) return 0;
  const ym = year + '-' + String(mIdx+1).padStart(2,'0');
  if(!(v.pagos && v.pagos[ym])) return 0;
  return comissaoVendedorMes(v, year, mIdx) || 0;
}
