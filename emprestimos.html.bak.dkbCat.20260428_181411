// safety net do click esconderia o preview imediatamente após inserir a ref.
let __formulaDragJustEnded = 0;
// Estado do arrasto:
//   null quando parado; quando ativo:
//   { inp, before, after, startCaret, cellsOrdered, cellsSet, downX, downY, committed }
let __formulaDragState  = null;

function __isFormulaMode(inp){
  if(!inp) return false;
  const v = inp.value; if(typeof v !== 'string') return false;
  return v.trim().startsWith('=');
}

// ── Preview flutuante do resultado da fórmula ───────────────────────────────
let __formulaPreviewEl = null;
function __ensureFormulaPreviewEl(){
