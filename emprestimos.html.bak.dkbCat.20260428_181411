function updateFlxKpis(){
  const year = flxActiveYear;
  let totR=0, totF=0, totD=0, totE=0, totI=0;
  for(let m=0;m<12;m++){
    totR += flxReceitaMes(year,m);
    totF += flxFolhaMes(year,m);
    totD += flxDespesasMes(year,m);
    totE += flxEmprestimosMes(year,m);
    totI += flxImpostoMes(year,m);
  }
  const totC = totF+totD+totE+totI;
  const totRes = totR - totC;

  // Saldo acumulado em dez — respeita mês âncora do saldo inicial
  let acc = flxSaldoInicialVal(year);
  const siMesKpi = flxSaldoInicialMesVal(year);
  for(let m=siMesKpi;m<12;m++){
    const sm = (flxReceitaMes(year,m) - (flxFolhaMes(year,m)+flxDespesasMes(year,m)+flxEmprestimosMes(year,m)+flxImpostoMes(year,m)))
             + flxCreditoMes(year,m) + flxOutrasMes(year,m) - flxOutrasDespMes(year,m);
    acc += sm;
  }

  const setKpi = (id, val, extraCls) => {
    const el = document.getElementById(id);
    if(!el) return;
    el.textContent = fmtBRL(val);
    el.classList.remove('flx-neg','flx-pos','flx-zero');
    if(extraCls) el.classList.add(extraCls);
  };
  setKpi('flx-kpi-receita', totR);
  setKpi('flx-kpi-custo',   totC);
  setKpi('flx-kpi-result',  totRes, totRes < 0 ? 'flx-neg' : (totRes > 0 ? 'flx-pos' : ''));
  setKpi('flx-kpi-saldo',   acc,    acc    < 0 ? 'flx-neg' : (acc    > 0 ? 'flx-pos' : ''));

  const subCusto = document.getElementById('flx-kpi-custo-sub');
  if(subCusto){
    const pct = totR > 0 ? Math.round((totC/totR)*100) : 0;
    subCusto.textContent = totR > 0 ? pct+'% da receita' : 'folha + despesas + empréstimos + impostos';
  }
  const subResult = document.getElementById('flx-kpi-result-sub');
  if(subResult){
    const pct = totR > 0 ? Math.round((totRes/totR)*100) : 0;
    subResult.textContent = totR > 0 ? (pct >= 0 ? 'margem de '+pct+'%' : 'prejuízo de '+Math.abs(pct)+'%') : 'receita − gasto total';
  }
}

