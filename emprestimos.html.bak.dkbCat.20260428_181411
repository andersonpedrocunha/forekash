// Atalho: cria um novo tipo direto da barra de filtro, sem abrir o modal inteiro.
async function quickAddTipo(){
  if(!receita.tipos) receita.tipos = [];
  const nome = await askText({
    title: 'Novo tipo',
    label: 'Nome do tipo',
    placeholder: 'Ex: Consultoria',
    confirmText: 'Criar',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!s) return 'Nome não pode ser vazio.';
      if(receita.tipos.some(t => t.nome.toLowerCase() === s.toLowerCase()))
        return 'Já existe um tipo com esse nome.';
      return null;
    }
  });
  if(!nome) return;
  const nomeLimpo = nome.trim();
  const id = recTipoNewId();
  const usadas = new Set(receita.tipos.map(t => t.color));
  const color = REC_TIPO_PALETTE.find(c => !usadas.has(c))
             || REC_TIPO_PALETTE[receita.tipos.length % REC_TIPO_PALETTE.length];
  receita.tipos.push({id, nome:nomeLimpo, color});
  receitaSave();
  renderReceita();
  toast('✅ Tipo "'+nomeLimpo+'" criado.');
}

// ═══════════════════════════════════════════════════
//  MÓDULO FLUXO DE CAIXA
//    Consolida Receita/Folha/Despesas/Empréstimos mês-a-mês
//    + entradas editáveis (Impostos, Crédito, Outras, Saldo Inicial)
// ═══════════════════════════════════════════════════
const FLX_KEY   = 'taller_fluxo_v1';
const FLX_MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];

let fluxo = null;
let flxActiveYear = null;

function flxMonthKey(mIdx){ return String(mIdx); } // interno (0..11)

function fluxoLoad(){
  let raw = null;
  try{ raw = localStorage.getItem(FLX_KEY); }catch(e){}
  if(raw){
    try{ fluxo = JSON.parse(raw); }catch(e){ fluxo = null; }
  }
  if(!fluxo || typeof fluxo !== 'object'){
    const y = String(new Date().getFullYear());
    fluxo = {
      activeYear: y,
      years: [y],
      inputs: {},        // inputs[year].impostos[mIdx], inputs[year].creditoAlv[mIdx], inputs[year].outrasRec[mIdx]
      saldoInicial: {},  // saldoInicial[year] = valor numérico
      saldoInicialMes:{},// saldoInicialMes[year] = mIdx (0..11) — mês em que o saldo inicial é válido
      rowModes: {},      // rowModes[year][rowKey] = 'auto' | 'manual'  (receita|folha|despesas|emprestimos)
      manualOverrides:{},// manualOverrides[year][rowKey][mIdx] = valor manual quando rowModes==='manual'
      confirmed: {}      // confirmed[year][rowKey][mIdx] = true  → célula marcada como confirmada
    };
  }
  // Migração / saneamento
  if(!Array.isArray(fluxo.years) || fluxo.years.length === 0){
    fluxo.years = [String(new Date().getFullYear())];
  }
  fluxo.years = fluxo.years.map(String);
  if(!fluxo.inputs || typeof fluxo.inputs !== 'object') fluxo.inputs = {};
  if(!fluxo.saldoInicial || typeof fluxo.saldoInicial !== 'object') fluxo.saldoInicial = {};
  if(!fluxo.saldoInicialMes || typeof fluxo.saldoInicialMes !== 'object') fluxo.saldoInicialMes = {};
  if(!fluxo.rowModes || typeof fluxo.rowModes !== 'object') fluxo.rowModes = {};
  if(!fluxo.manualOverrides || typeof fluxo.manualOverrides !== 'object') fluxo.manualOverrides = {};
  if(!fluxo.confirmed || typeof fluxo.confirmed !== 'object') fluxo.confirmed = {};
  for(const y of fluxo.years){
    if(!fluxo.inputs[y]) fluxo.inputs[y] = {};
    if(!fluxo.inputs[y].impostos)   fluxo.inputs[y].impostos   = {};
    if(!fluxo.inputs[y].creditoAlv) fluxo.inputs[y].creditoAlv = {};
    if(!fluxo.inputs[y].outrasRec)  fluxo.inputs[y].outrasRec  = {};
    if(!fluxo.inputs[y].outrasDesp) fluxo.inputs[y].outrasDesp = {};
    if(fluxo.saldoInicial[y] === undefined) fluxo.saldoInicial[y] = '';
    if(fluxo.saldoInicialMes[y] === undefined || fluxo.saldoInicialMes[y] === null) fluxo.saldoInicialMes[y] = 0;
    if(!fluxo.rowModes[y] || typeof fluxo.rowModes[y] !== 'object') fluxo.rowModes[y] = {};
    if(!fluxo.manualOverrides[y] || typeof fluxo.manualOverrides[y] !== 'object') fluxo.manualOverrides[y] = {};
    if(!fluxo.confirmed[y] || typeof fluxo.confirmed[y] !== 'object') fluxo.confirmed[y] = {};
  }
  // Une com anos presentes nos outros módulos (read-only merge)
  const allYears = new Set(fluxo.years);
  try{
    if(receita && receita.years) Object.keys(receita.years).forEach(y => allYears.add(String(y)));
    if(estrutura && estrutura.years) estrutura.years.forEach(y => allYears.add(String(y)));
    if(pessoas && pessoas.years) pessoas.years.forEach(y => allYears.add(String(y)));
  }catch(e){}
  fluxo.years = Array.from(allYears).sort();
  for(const y of fluxo.years){
    if(!fluxo.inputs[y]) fluxo.inputs[y] = {impostos:{},creditoAlv:{},outrasRec:{},outrasDesp:{}};
    if(fluxo.saldoInicial[y] === undefined) fluxo.saldoInicial[y] = '';
    if(fluxo.saldoInicialMes[y] === undefined || fluxo.saldoInicialMes[y] === null) fluxo.saldoInicialMes[y] = 0;
    if(!fluxo.rowModes[y]) fluxo.rowModes[y] = {};
    if(!fluxo.manualOverrides[y]) fluxo.manualOverrides[y] = {};
    if(!fluxo.confirmed[y]) fluxo.confirmed[y] = {};
  }
  // Migração: impostos antes ficava em fluxo.inputs[y].impostos — agora é
  // override manual do auto-pull (impostos.correntes). Move o que já existe.
  for(const y of fluxo.years){
    const oldImp = fluxo.inputs[y] && fluxo.inputs[y].impostos;
    if(oldImp && typeof oldImp === 'object'){
      const keys = Object.keys(oldImp);
      if(keys.length > 0){
        if(!fluxo.manualOverrides[y].impostos) fluxo.manualOverrides[y].impostos = {};
        for(const k of keys){
          const v = oldImp[k];
          if(v !== undefined && v !== '' && v !== null
             && fluxo.manualOverrides[y].impostos[k] === undefined){
            fluxo.manualOverrides[y].impostos[k] = v;
          }
        }
        fluxo.inputs[y].impostos = {};
      }
    }
  }
  // Ano ativo
  const savedY = fluxo.activeYear;
  flxActiveYear = (savedY && fluxo.years.includes(savedY))
                  ? savedY : fluxo.years[fluxo.years.length-1];
}

function fluxoSave(){
  fluxo.activeYear = flxActiveYear;
  try{ localStorage.setItem(FLX_KEY, JSON.stringify(fluxo)); }catch(e){}
}

// ───── Derivações (dados de outros módulos) ─────
// Cada linha tem um valor "auto" (puxado da aba de origem) e um "override" manual
// por célula (guardado em fluxo.manualOverrides[year][rowKey][mIdx]).
// Se houver override, ele vence; senão, usa o valor derivado automaticamente.
// Chaves: 'receita', 'folha', 'despesas', 'emprestimos', 'impostos'.
function flxHasOverride(year, rowKey, mIdx){
  try{
    const v = fluxo && fluxo.manualOverrides && fluxo.manualOverrides[year]
            && fluxo.manualOverrides[year][rowKey]
            && fluxo.manualOverrides[year][rowKey][mIdx];
    return (v !== undefined && v !== '' && v !== null);
  }catch(e){ return false; }
}
function flxOverrideVal(year, rowKey, mIdx){
  try{
    const v = fluxo && fluxo.manualOverrides && fluxo.manualOverrides[year]
            && fluxo.manualOverrides[year][rowKey]
            && fluxo.manualOverrides[year][rowKey][mIdx];
    return (v !== undefined && v !== '' && v !== null) ? (parseFloat(v)||0) : 0;
  }catch(e){ return 0; }
}
function flxIsConfirmed(year, rowKey, mIdx){
  try{
    return !!(fluxo && fluxo.confirmed && fluxo.confirmed[year]
              && fluxo.confirmed[year][rowKey]
              && fluxo.confirmed[year][rowKey][mIdx]);
  }catch(e){ return false; }
}

// ─── Catmap → Fluxo de Caixa (Phase 2) ───
// Helpers que permitem ao catmap (Customizações → Categorias) realocar items de
// estrutura.itens pra outras linhas do DRC/DRE.
function _flxCatmapForItem(it){
  if(!it || typeof catmapFindByNome !== 'function') return null;
  // Resolve o nome da tag pelo tagId
  let tagNome = null;
  try {
    if(typeof estrutura !== 'undefined' && estrutura && Array.isArray(estrutura.tags)){
      const tag = estrutura.tags.find(t => t.id === it.tagId);
      if(tag) tagNome = tag.nome;
    }
  } catch(_){}
  if(!tagNome) return null;
  return catmapFindByNome(tagNome);
}
function _flxCatmapLineFor(it, view){
  const c = _flxCatmapForItem(it);
  if(!c) return null;
  const k = (view === 'dre') ? 'dreLineId' : 'drcLineId';
  return c[k] || null;
}
// Soma valores de estrutura.itens cujo catmap mapeia pra `lineId` na view atual.
function _flxCatmapEstruturaPara(lineId, year, mIdx){
  if(typeof estrutura === 'undefined' || !estrutura || !Array.isArray(estrutura.itens)) return 0;
  const view = (typeof flxView === 'string') ? flxView : 'drc';
  const k = (typeof estMesKey === 'function') ? estMesKey(year, mIdx) : (year + '-' + String(mIdx+1).padStart(2,'0'));
  let tot = 0;
  for(const it of estrutura.itens){
    const mapped = _flxCatmapLineFor(it, view);
    if(mapped !== lineId) continue;
    const v = it.valores && it.valores[k];
    if(v !== undefined && v !== '' && v !== null) tot += parseFloat(v) || 0;
  }
  return tot;
}
try {
  window._flxCatmapForItem = _flxCatmapForItem;
  window._flxCatmapLineFor = _flxCatmapLineFor;
  window._flxCatmapEstruturaPara = _flxCatmapEstruturaPara;
} catch(e){}

function _flxAutoReceita(year, mIdx){
  if(!receita || !receita.years || !receita.years[year]) return 0;
  const d = receita.years[year];
  const mesNome = REC_MESES[mIdx];
  let tot = 0;
  // Apenas clientes (contratos confirmados). Leads = prospecção, não entra no fluxo.
  for(const r of (d.clients||[])){
    const c = r.meses && r.meses[mesNome];
    if(c && c.valor !== '' && c.valor != null){
      tot += parseFloat(c.valor) || 0;
    }
  }
  return tot;
}
function _flxAutoFolha(year, mIdx){
  if(!pessoas || !Array.isArray(pessoas.people)) return 0;
  const k = pesMesKey(year, mIdx);
  let tot = 0;
  for(const p of pessoas.people){
    if(p.sim) continue; // linhas de simulação não entram no real
    const v = p.salarios && p.salarios[k];
    if(v !== undefined && v !== '' && v != null){
      tot += parseFloat(v) || 0;
    }
  }
  return tot;
}
function _flxAutoDespesas(year, mIdx){
  let tot = 0;
  // Despesas fixas cadastradas na planilha (estrutura.itens).
  // Catmap (Customizações → Categorias): se a tag do item está mapeada pra OUTRA
  // linha do DRC/DRE atual (ex: 'juros' no DRE), o item é EXCLUÍDO daqui — vai
  // contar na linha mapeada via _flxCatmapEstruturaPara.
  if(estrutura && Array.isArray(estrutura.itens)){
    const k = estMesKey(year, mIdx);
    const view = (typeof flxView === 'string') ? flxView : 'drc';
    for(const it of estrutura.itens){
      const v = it.valores && it.valores[k];
      if(v === undefined || v === '' || v == null) continue;
      // Filtro catmap: se a tag tem mapping pra linha diferente de 'despesas', pula
      const mapped = (typeof _flxCatmapLineFor === 'function') ? _flxCatmapLineFor(it, view) : null;
      if(mapped && mapped !== 'despesas') continue;
      tot += parseFloat(v) || 0;
    }
  }
  // Comissões de vendedores (calculadas dinamicamente com base na receita do mês)
  try { tot += comissaoTotalMes(String(year), mIdx) || 0; } catch(e){}
  return tot;
}
function _flxAutoEmprestimos(year, mIdx){
  // Reproduz a lógica de buildParcelaTimeline() para UM mês específico.
  // Puxa da aba "Dívida · Parcela Mensal":
  //   - Mês EFETIVADO → usa parcela_efetivada + extras (desefetivado volta à projeção)
  //   - SAC com saldo > 0 → amortização constante decrescente + juros sobre saldo futuro
  //   - Demais (Price/custom) → parcela fixa informada
  if(!Array.isArray(loans) || loans.length === 0) return 0;
  const today = new Date(); today.setDate(1); today.setHours(0,0,0,0);
  const cur = new Date(parseInt(year), mIdx, 1);
  const mesStr = year + '-' + String(mIdx+1).padStart(2,'0');
  const mDiff  = (cur.getFullYear()-today.getFullYear())*12 + (cur.getMonth()-today.getMonth());
  let tot = 0;
  for(const l of loans){
    const saldo   = parseFloat(l.saldo)     || 0;
    const parcela = parseFloat(l.parcelaVal)|| 0;
    const taxa    = parseFloat(l.taxa)      || 0;
    const termino = l.termino ? new Date(l.termino+'T00:00:00') : null;
    // 1) Mês EFETIVADO → usa valores registrados (main + extras)
    const totEf = _flxRegEfetivadoTotais(l, mesStr);
    if(totEf && totEf.hasParcela){
      tot += totEf.parcela;
      continue;
    }
    if(parcela === 0) continue;
    if(termino && cur > termino) continue;
    // 2) Mês atual → parcela informada
    if(mDiff === 0){ tot += parcela; continue; }
    // 3) SAC → projeção com amortização constante + juros sobre saldo futuro
    if(typeof isSACEngine === 'function' && isSACEngine(l.tipo) && parcela > 0 && saldo > 0){
      let amortConst = 0;
      if(termino){
        const mRest = (termino.getFullYear()-today.getFullYear())*12 + (termino.getMonth()-today.getMonth());
        amortConst = mRest > 0 ? saldo/(mRest+1) : Math.max(0, parcela - saldo*(taxa/100));
      } else {
        amortConst = Math.max(0, parcela - saldo*(taxa/100));
      }
      if(amortConst > 0){
        const saldoFut = Math.max(0, saldo - amortConst*mDiff);
        tot += saldoFut > 0 ? (amortConst + saldoFut*(taxa/100)) : 0;
        continue;
      }
    }
    // 4) Price/custom → parcela fixa
    tot += parcela;
  }
  return tot;
}

// Parcelamentos de impostos — split por parcelamento.
//   parcela       = row.parcela          (cash outflow do mês)
//   principal     = parcela inicial (nominal original sem SELIC)  — capado em parcela
//   jurosPago     = parcela - principal   (correção SELIC acumulada paga no mês)
// Semântica: principal é o valor nominal base do parcelamento. Juros é a correção
// SELIC que vai se acumulando mês a mês. Quitação antecipada (pago > nominal) vai
// todo o excedente pra amortização (principal = pago, juros = 0).
function _flxImpParcelamentoRow(p, ym){
  if(!p || p.ativo === false) return null;
  if(!p.saldoInicial || !p.parcelaMensal) return null;
  try {
    const idx = impParcMesIdx(p, ym);
    if(idx < 0) return null;
    const plan = _impParcPlan(p);
    const row = plan.rows[idx];
    if(!row) return null;
    const parcela = row.parcela || 0;
    const parcelaInicial = parseFloat(p.parcelaMensal) || 0;
    // Pagamento ≥ nominal base: excedente é amortização (principal = parcela, juros = 0).
    // Pagamento < nominal base: tudo é amortização (principal = parcela, juros = 0).
    // Pagamento no nível previsto (nominal + SELIC acumulada): principal = nominal,
    // juros = o que excedeu do nominal.
    let principal, jurosPago;
    if(parcela <= parcelaInicial){
      principal = parcela;
      jurosPago = 0;
    } else {
      principal = parcelaInicial;
      jurosPago = parcela - parcelaInicial;
    }
    return { parcela, principal, jurosPago };
  } catch(e){ return null; }
}
// Wrapper que respeita override manual digitado na planilha. Se o usuário
// digitou um valor em `fluxo.manualOverrides[year]['parcImpostos'][mIdx]`, usa
// esse. Senão, devolve o auto (flxImpParcelamentoMesAuto).
function flxImpParcelamentoMesFinal(year, mIdx){
  return flxHasOverride(year,'parcImpostos',mIdx)
       ? flxOverrideVal(year,'parcImpostos',mIdx)
       : flxImpParcelamentoMesAuto(year, mIdx);
}
// Auto = soma real dos parcelamentos ativos (antigo flxImpParcelamentoMes).
function flxImpParcelamentoMesAuto(year, mIdx){
  if(typeof impostos === 'undefined' || !impostos || !Array.isArray(impostos.parcelamentos)) return 0;
  const ym = year + '-' + String(mIdx+1).padStart(2,'0');
  let tot = 0;
  for(const p of impostos.parcelamentos){
    const r = _flxImpParcelamentoRow(p, ym);
    if(r) tot += r.parcela;
  }
  return tot;
}
// Parcelamentos de impostos: total pago no mês (principal + juros) consolidado
// nos parcelamentos ativos. Respeita override manual digitado na planilha.
function flxImpParcelamentoMes(year, mIdx){
  return flxImpParcelamentoMesFinal(year, mIdx);
}
// Parcelamentos de impostos: juros efetivamente pagos (≠ juros teóricos SELIC).
// Deriva da variação do saldo: jurosPago = parcela - principal_amortizado.
function flxImpParcelamentoJurosMes(year, mIdx){
  if(typeof impostos === 'undefined' || !impostos || !Array.isArray(impostos.parcelamentos)) return 0;
  const ym = year + '-' + String(mIdx+1).padStart(2,'0');
  let tot = 0;
  for(const p of impostos.parcelamentos){
    const r = _flxImpParcelamentoRow(p, ym);
    if(r) tot += r.jurosPago;
  }
  return tot;
}
// Parcelamentos de impostos: principal (amortização real) do mês.
function flxImpParcelamentoPrincipalMes(year, mIdx){
  if(typeof impostos === 'undefined' || !impostos || !Array.isArray(impostos.parcelamentos)) return 0;
  const ym = year + '-' + String(mIdx+1).padStart(2,'0');
  let tot = 0;
  for(const p of impostos.parcelamentos){
    const r = _flxImpParcelamentoRow(p, ym);
    if(r) tot += r.principal;
  }
  return tot;
}

// Puxa Impostos da aba "Impostos Correntes" — soma dos valores lançados por rubrica
// no mês (impostos.correntes[].valores[impMesKey(year, mIdx)]).
function _flxAutoImpostos(year, mIdx){
  try{
    if(typeof impostos === 'undefined' || !impostos || !Array.isArray(impostos.correntes)) return 0;
    const key = year + '-' + String(mIdx+1).padStart(2,'0');
    let tot = 0;
    for(const c of impostos.correntes){
      const v = c && c.valores && c.valores[key];
      if(v !== undefined && v !== '' && v != null){
        tot += parseFloat(v) || 0;
      }
    }
    return tot;
  }catch(e){ return 0; }
}

// Wrappers: override manual (se houver) vence; senão, usa o valor derivado da aba.
// Usados em: renderFlxSheet, updateFlxKpis, módulo Orçamento (realizado).
function flxReceitaMes(year, mIdx){
  return flxHasOverride(year,'receita',mIdx)
       ? flxOverrideVal(year,'receita',mIdx)
       : _flxAutoReceita(year,mIdx);
}
function flxFolhaMes(year, mIdx){
  return flxHasOverride(year,'folha',mIdx)
       ? flxOverrideVal(year,'folha',mIdx)
       : _flxAutoFolha(year,mIdx);
}
function flxDespesasMes(year, mIdx){
  return flxHasOverride(year,'despesas',mIdx)
       ? flxOverrideVal(year,'despesas',mIdx)
       : _flxAutoDespesas(year,mIdx);
}
function flxEmprestimosMes(year, mIdx){
  return flxHasOverride(year,'emprestimos',mIdx)
       ? flxOverrideVal(year,'emprestimos',mIdx)
       : _flxAutoEmprestimos(year,mIdx);
}
function flxImpostoMes(year, mIdx){
  return flxHasOverride(year,'impostos',mIdx)
       ? flxOverrideVal(year,'impostos',mIdx)
       : _flxAutoImpostos(year, mIdx);
}

// ─── Natureza de imposto para a DRE gerencial ─────────────────────────────
// Heurística 100% automática por nome/id da rubrica:
//   - IRPJ, CSLL, IR isolado, Contribuição Social,
//     "Imposto sobre Lucro", "Lucro Real/Presumido"   → 'despesa' (tributária)
//   - Resto (ISS, PIS, COFINS, ICMS, Simples, DAS…)   → 'deducao' (sobre vendas)
// Classificação é sempre automática. Se alguma rubrica cair errado, basta
// renomeá-la contendo uma das palavras-chave acima.
function _flxImpostoNatureza(rubrica){
  if(!rubrica) return 'deducao';
  // Catmap primeiro: se a rubrica está mapeada no catmap, usa o dreLineId pra decidir.
  //   dreLineId='despesasTrib' → 'despesa'
  //   dreLineId='deducoes'     → 'deducao'
  //   (qualquer outra coisa cai pro fallback regex)
  try {
    if(typeof catmapFindByNome === 'function' && rubrica.nome){
      const c = catmapFindByNome(rubrica.nome);
      if(c){
        if(c.dreLineId === 'despesasTrib') return 'despesa';
        if(c.dreLineId === 'deducoes')     return 'deducao';
      }
    }
  } catch(_){}
  const raw = ((rubrica.nome || '') + ' ' + (rubrica.id || ''))
              .normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  // \b = word boundary. "ir" isolado evita match em palavras como "Jantar".
  const patt = /\birpj\b|\bcsll\b|\bir\b|contribui[cç]?ao\s+social|imposto\s+.*lucro|lucro\s+real|lucro\s+presumido/;
  return patt.test(raw) ? 'despesa' : 'deducao';
}

// Split do imposto de um mês em {deducao, despesa, total}.
// Se a linha "Impostos" tem override, aplica proporcional ao ratio natural
// (se no natural 70% vem de deduções e 30% de IRPJ/CSLL, o override é dividido nessa proporção).
function flxImpostoSplitMes(year, mIdx){
  let natDed = 0, natDes = 0;
  if(typeof impostos !== 'undefined' && impostos && Array.isArray(impostos.correntes)){
    const key = year + '-' + String(mIdx+1).padStart(2,'0');
    for(const c of impostos.correntes){
      if(!c) continue;
      const v = c.valores && c.valores[key];
      if(v === undefined || v === '' || v === null) continue;
      const n = parseFloat(v) || 0;
      if(n === 0) continue;
      const rub = (typeof impRubrica === 'function') ? impRubrica(c.rubricaId) : null;
      const nat = _flxImpostoNatureza(rub || { id: c.rubricaId });
      if(nat === 'despesa') natDes += n;
      else                  natDed += n;
    }
  }
  const total = flxImpostoMes(year, mIdx);
  const natTot = natDed + natDes;
  if(natTot <= 0){
    // Sem rubricas classificáveis — override "solto" cai tudo em dedução por default
    return { deducao: total, despesa: 0, total };
  }
  // Aplica proporcional ao total efetivo (que pode ser override)
  const rDed = natDed / natTot;
  return { deducao: total * rDed, despesa: total * (1 - rDed), total };
}
function flxImpostoDeducaoMes(year, mIdx){ return flxImpostoSplitMes(year, mIdx).deducao; }
function flxImpostoDespesaMes(year, mIdx){ return flxImpostoSplitMes(year, mIdx).despesa; }

function flxCreditoMes(year, mIdx){
  const v = (((fluxo.inputs||{})[year]||{}).creditoAlv||{})[mIdx];
  return (v !== undefined && v !== '') ? (parseFloat(v)||0) : 0;
}
function flxOutrasMes(year, mIdx){
  const v = (((fluxo.inputs||{})[year]||{}).outrasRec||{})[mIdx];
  let base = (v !== undefined && v !== '') ? (parseFloat(v)||0) : 0;
  // Soma valores de Outras Operações com catmap mapeado pra outrasRec
  try { if(typeof _flxOutrasOpMes === 'function') base += _flxOutrasOpMes('outrasRec', year, mIdx); } catch(_){}
  return base;
}
function flxOutrasDespMes(year, mIdx){
  const v = (((fluxo.inputs||{})[year]||{}).outrasDesp||{})[mIdx];
  let base = (v !== undefined && v !== '') ? (parseFloat(v)||0) : 0;
  try { if(typeof _flxOutrasOpMes === 'function') base += _flxOutrasOpMes('outrasDesp', year, mIdx); } catch(_){}
  return base;
}
function flxSaldoInicialVal(year){
  const v = fluxo.saldoInicial[year];
  return (v !== undefined && v !== '') ? (parseFloat(v)||0) : 0;
}
// Mês em que o saldo inicial está "ancorado" (0..11). Default: jan (0).
function flxSaldoInicialMesVal(year){
  const v = (fluxo.saldoInicialMes || {})[year];
  const n = parseInt(v, 10);
  return (Number.isFinite(n) && n >= 0 && n <= 11) ? n : 0;
}

// Agregados (mês a mês)
function flxCustoTotalMes(year, mIdx){
  return flxFolhaMes(year,mIdx) + flxDespesasMes(year,mIdx)
       + flxEmprestimosMes(year,mIdx) + flxImpostoMes(year,mIdx);
}
function flxResultadoMes(year, mIdx){
  return flxReceitaMes(year,mIdx) - flxCustoTotalMes(year,mIdx);
}
function flxSaldoMesVal(year, mIdx){
  return flxResultadoMes(year,mIdx) + flxCreditoMes(year,mIdx) + flxOutrasMes(year,mIdx) - flxOutrasDespMes(year,mIdx);
}

// ───── Render ─────
function renderFluxo(){
  if(!fluxo){ fluxoLoad(); }
  // Re-sincroniza anos com outros módulos a cada render
  const before = JSON.stringify(fluxo.years);
  const allYears = new Set(fluxo.years);
  try{
    if(receita && receita.years) Object.keys(receita.years).forEach(y => allYears.add(String(y)));
    if(estrutura && estrutura.years) estrutura.years.forEach(y => allYears.add(String(y)));
    if(pessoas && pessoas.years) pessoas.years.forEach(y => allYears.add(String(y)));
  }catch(e){}
  fluxo.years = Array.from(allYears).sort();
  for(const y of fluxo.years){
    if(!fluxo.inputs[y]) fluxo.inputs[y] = {impostos:{},creditoAlv:{},outrasRec:{},outrasDesp:{}};
    if(!fluxo.inputs[y].outrasDesp) fluxo.inputs[y].outrasDesp = {};
    if(fluxo.saldoInicial[y] === undefined) fluxo.saldoInicial[y] = '';
    if(!fluxo.saldoInicialMes) fluxo.saldoInicialMes = {};
    if(fluxo.saldoInicialMes[y] === undefined || fluxo.saldoInicialMes[y] === null) fluxo.saldoInicialMes[y] = 0;
    if(!fluxo.rowModes || !fluxo.rowModes[y]) (fluxo.rowModes = fluxo.rowModes || {})[y] = {};
    if(!fluxo.manualOverrides || !fluxo.manualOverrides[y]) (fluxo.manualOverrides = fluxo.manualOverrides || {})[y] = {};
    if(!fluxo.confirmed || !fluxo.confirmed[y]) (fluxo.confirmed = fluxo.confirmed || {})[y] = {};
  }
  if(!fluxo.years.includes(flxActiveYear)){
    flxActiveYear = fluxo.years[fluxo.years.length-1];
  }
  if(before !== JSON.stringify(fluxo.years)) fluxoSave();
  renderFlxYearTabs();
  renderFlxSheet();
  updateFlxKpis();
}

function renderFlxYearTabs(){
  const tabs = document.getElementById('flx-year-tabs');
  if(!tabs) return;
  const years = fluxo.years.slice().sort();
  tabs.innerHTML = years.map(y => {
    const act = y === flxActiveYear;
    // "Espelhado" = ano existe em outro módulo (não pode excluir daqui). Ainda pode duplicar/limpar.
    const mirrored = flxYearIsMirrored(y);
    const delTitle = mirrored
      ? 'Limpar valores editáveis (Impostos/Crédito/Outras/Saldo Inicial)'
      : 'Excluir ano do Fluxo';
    return `<button class="pes-year-tab${act?' active':''}" onclick="setFlxActiveYear('${y}')">
      ${y}
      <span class="rec-year-dup" onclick="event.stopPropagation();duplicateFlxYear('${y}')" title="Duplicar valores editáveis deste ano">⧉</span>
      <span class="pes-year-del" onclick="event.stopPropagation();delFlxYear('${y}')" title="${delTitle}">✕</span>
    </button>`;
  }).join('') + `<button class="pes-year-add" onclick="addFlxYear()">+ Adicionar ano</button>`;
}

// Verifica se o ano existe em algum módulo "fonte" (Receita / Pessoas / Estrutura)
function flxYearIsMirrored(y){
  const ys = String(y);
  try{
    if(receita && receita.years && receita.years[ys]) return true;
    if(pessoas && pessoas.years && pessoas.years.includes(ys)) return true;
    if(estrutura && estrutura.years && estrutura.years.includes(ys)) return true;
  }catch(e){}
  return false;
}

function setFlxActiveYear(y){
  if(flxActiveYear === y) return;
  flxActiveYear = y;
  fluxoSave();
  renderFluxo();
}

// Adiciona um novo ano ao Fluxo de Caixa
async function addFlxYear(){
  const nums = fluxo.years.map(Number).filter(n => !isNaN(n));
  const suggested = String((nums.length ? Math.max(...nums) : new Date().getFullYear()) + 1);
  const ys = await askText({
    title: 'Adicionar ano ao Fluxo de Caixa',
    label: 'Ano',
    placeholder: 'YYYY',
    initialValue: suggested,
    confirmText: 'Adicionar',
    hint: 'Ex: 2027',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!/^\d{4}$/.test(s)) return 'Informe um ano válido de 4 dígitos.';
      if(fluxo.years.includes(s)) return 'Esse ano já está cadastrado.';
      return null;
    }
  });
  if(ys === null) return;
  fluxo.years.push(ys);
  fluxo.years.sort();
  if(!fluxo.inputs[ys]) fluxo.inputs[ys] = {impostos:{}, creditoAlv:{}, outrasRec:{}};
  if(fluxo.saldoInicial[ys] === undefined) fluxo.saldoInicial[ys] = '';
  flxActiveYear = ys;
  fluxoSave();
  renderFluxo();
}

// Duplica valores editáveis (Impostos, Crédito, Outras, Saldo Inicial) de um ano para outro novo
async function duplicateFlxYear(srcYear){
  if(!fluxo.years.includes(srcYear)) return;
  const suggested = String(parseInt(srcYear)+1);
  const ys = await askText({
    title: 'Duplicar ano',
    label: 'Duplicar valores de ' + srcYear + ' para:',
    placeholder: 'YYYY',
    initialValue: suggested,
    confirmText: 'Duplicar',
    hint: 'Copia Impostos, Crédito, Outras Receitas, Outras Despesas, Saldo Inicial, modos Auto/Manual, valores manuais e marcações de confirmação.',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!/^\d{4}$/.test(s)) return 'Informe um ano válido de 4 dígitos.';
      if(s === srcYear) return 'Escolha um ano diferente.';
      return null;
    }
  });
  if(ys === null) return;
  if(fluxo.years.includes(ys)){
    const ok = await showConfirm({
      title: 'Sobrescrever valores',
      message: `O ano <strong>${ys}</strong> já existe no Fluxo. Sobrescrever Impostos, Crédito, Outras Receitas, Outras Despesas, Saldo Inicial, modos Auto/Manual, valores manuais e confirmações com os de ${srcYear}?`,
      confirmLabel: 'Sobrescrever', cancelLabel: 'Cancelar', destructive: true
    });
    if(!ok) return;
  } else {
    fluxo.years.push(ys);
    fluxo.years.sort();
  }
  // Copia
  const src = fluxo.inputs[srcYear] || {impostos:{}, creditoAlv:{}, outrasRec:{}, outrasDesp:{}};
  fluxo.inputs[ys] = {
    impostos:   {...(src.impostos   || {})},
    creditoAlv: {...(src.creditoAlv || {})},
    outrasRec:  {...(src.outrasRec  || {})},
    outrasDesp: {...(src.outrasDesp || {})}
  };
  fluxo.saldoInicial[ys] = fluxo.saldoInicial[srcYear] !== undefined ? fluxo.saldoInicial[srcYear] : '';
  if(!fluxo.saldoInicialMes) fluxo.saldoInicialMes = {};
  fluxo.saldoInicialMes[ys] = (fluxo.saldoInicialMes[srcYear] !== undefined ? fluxo.saldoInicialMes[srcYear] : 0);
  // Copia modos por linha, overrides manuais e confirmações
  if(!fluxo.rowModes) fluxo.rowModes = {};
  if(!fluxo.manualOverrides) fluxo.manualOverrides = {};
  if(!fluxo.confirmed) fluxo.confirmed = {};
  const srcModes = fluxo.rowModes[srcYear] || {};
  fluxo.rowModes[ys] = {...srcModes};
  const srcMan = fluxo.manualOverrides[srcYear] || {};
  fluxo.manualOverrides[ys] = {};
  for(const k of Object.keys(srcMan)){
    fluxo.manualOverrides[ys][k] = {...(srcMan[k]||{})};
  }
  const srcCon = fluxo.confirmed[srcYear] || {};
  fluxo.confirmed[ys] = {};
  for(const k of Object.keys(srcCon)){
    fluxo.confirmed[ys][k] = {...(srcCon[k]||{})};
  }
  flxActiveYear = ys;
  fluxoSave();
  renderFluxo();
}

// Remove / limpa um ano do Fluxo de Caixa
async function delFlxYear(y){
  if(!fluxo.years.includes(y)) return;
  const mirrored = flxYearIsMirrored(y);
  // Anos "espelhados" de outros módulos só podem ter seus inputs limpos
  if(mirrored){
    const ok = await showConfirm({
      title: `Limpar valores editáveis de ${y}`,
      message: `O ano <strong>${y}</strong> também existe em <strong>Receita / Pessoas / Estrutura</strong> e continuará visível aqui.<br><br>Apenas os valores editáveis do Fluxo de Caixa (Impostos, Crédito, Outras Receitas, Outras Despesas e Saldo Inicial) serão removidos.`,
      confirmLabel: 'Limpar valores', destructive: true
    });
    if(!ok) return;
    delete fluxo.inputs[y];
    delete fluxo.saldoInicial[y];
    if(fluxo.saldoInicialMes) delete fluxo.saldoInicialMes[y];
    if(fluxo.rowModes)        delete fluxo.rowModes[y];
    if(fluxo.manualOverrides) delete fluxo.manualOverrides[y];
    if(fluxo.confirmed)       delete fluxo.confirmed[y];
    fluxoSave();
    renderFluxo();
    return;
  }
  // Ano exclusivo do Fluxo — remove completamente
  if(fluxo.years.length <= 1){ await showInfo({title:'Ação não permitida', message:'Não é possível excluir o único ano.', warning:true}); return; }
  const ok = await showConfirm({
    title: `Excluir ano ${y}`,
    message: `Todos os valores editáveis do Fluxo para <strong>${y}</strong> serão removidos. Essa ação não pode ser desfeita.`,
    confirmLabel: 'Excluir ano', destructive: true
  });
  if(!ok) return;
  fluxo.years = fluxo.years.filter(v => v !== y);
  delete fluxo.inputs[y];
  delete fluxo.saldoInicial[y];
  if(fluxo.saldoInicialMes) delete fluxo.saldoInicialMes[y];
  if(fluxo.rowModes)        delete fluxo.rowModes[y];
  if(fluxo.manualOverrides) delete fluxo.manualOverrides[y];
  if(fluxo.confirmed)       delete fluxo.confirmed[y];
  if(flxActiveYear === y){
    flxActiveYear = fluxo.years[fluxo.years.length-1] || String(new Date().getFullYear());
  }
  fluxoSave();
  renderFluxo();
}

function _flxCell(v, opts){
  // opts: { muted?, allowNeg?, zeroAsDash?, colorize?, noSymbol? }
  const n = parseFloat(v) || 0;
  if(opts && opts.zeroAsDash && n === 0){
    return `<span class="flx-zero">—</span>`;
  }
  let cls = '';
  if(opts && opts.colorize){
    if(n < 0) cls = 'flx-neg';
    else if(n > 0) cls = 'flx-pos';
    else cls = 'flx-zero';
  }
  const txt = (opts && opts.noSymbol) ? fmtBR(n) : fmtBRL(n);
  return `<span${cls?' class="'+cls+'"':''}>${txt}</span>`;
}

function _flxInpCell(year, mIdx, field, curVal){
  const val = curVal !== '' && curVal != null ? fmtBR(curVal) : '';
  return `<input class="flx-inp" type="text" value="${val}" placeholder="0,00"
                 onfocus="this.select()"
                 onblur="setFlx${field}('${year}',${mIdx},this.value);fmtInp(this)"
                 onkeydown="if(event.key==='Enter'){this.blur();event.preventDefault();}">`;
}

// Retorna o valor auto (derivado de outra aba) para uma rowKey pullable.
function _flxAutoForRow(year, rowKey, mIdx){
  try{
    if(rowKey === 'receita')      return _flxAutoReceita(year, mIdx);
    if(rowKey === 'folha')        return _flxAutoFolha(year, mIdx);
    if(rowKey === 'despesas')     return _flxAutoDespesas(year, mIdx);
    if(rowKey === 'emprestimos')  return _flxAutoEmprestimos(year, mIdx);
    if(rowKey === 'impostos')     return _flxAutoImpostos(year, mIdx);
    if(rowKey === 'parcImpostos') return flxImpParcelamentoMesAuto(year, mIdx);
  }catch(e){}
  return 0;
}

// Input cell editável para linhas que puxam de outras abas:
// value = override (se houver); placeholder = valor auto formatado (mostra o que a aba
// está puxando). Se o usuário digitar vazio/0, o override é apagado e volta a puxar auto.
function _flxManualCell(year, rowKey, mIdx){
  const hasOvr = flxHasOverride(year, rowKey, mIdx);
  const valStr = hasOvr ? fmtBR(flxOverrideVal(year, rowKey, mIdx)) : '';
  const autoN  = _flxAutoForRow(year, rowKey, mIdx);
  const ph     = autoN ? fmtBR(autoN) : '0,00';
  const confirmed = flxIsConfirmed(year, rowKey, mIdx);
  const tip    = confirmed
    ? 'Valor confirmado — remova o ✓ para editar.'
    : (autoN
        ? 'Puxado da aba de origem: '+fmtBRL(autoN)+'. Digite para sobrescrever.'
        : 'Nada registrado na aba de origem. Digite para preencher manualmente.');
  const ro = confirmed ? ' readonly' : '';
  const roClick = confirmed ? ' onmousedown="notifyLocked()"' : '';
  return `<input class="flx-inp${hasOvr?' flx-ovr':''}" type="text"
                 value="${valStr}"
                 placeholder="${ph}"
                 title="${tip}"${ro}${roClick}
                 onfocus="this.select()"
                 onblur="setFlxManual('${year}','${rowKey}',${mIdx},this.value);fmtInp(this)"
                 onkeydown="if(event.key==='Enter'){this.blur();event.preventDefault();}">`;
}

// Botão sutil de confirmação (✓) por célula — segue padrão .pago das outras planilhas.
function _flxCheckBtn(year, rowKey, mIdx){
  const on = flxIsConfirmed(year, rowKey, mIdx);
