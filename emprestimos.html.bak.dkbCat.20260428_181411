function orcCellHTML(catId, mIdx, prev, real, fechado){
  const prevRaw = orcPrevMesRaw(catId, orcActiveYear, mIdx);
  const prevDisp = (prevRaw === '' || prevRaw === null || prevRaw === undefined) ? '' : fmtBR(parseFloat(prevRaw)||0);
  const realDisp = fechado ? fmtBR(real||0) : '—';
  const realCls = fechado ? 'c-real' : 'c-real empty';
  const desvio = orcDesvioChip(catId, prev, real, fechado);
  return (
    '<div class="orc-cell">'+
      '<div class="c-prev">'+
        '<input class="orc-prev-input" type="text" data-orc-cat="'+catId+'" data-orc-m="'+mIdx+'" '+
               'data-cellref="orc:'+catId+':'+orcActiveYear+':'+mIdx+'" '+
               'placeholder="—" value="'+prevDisp+'">'+
      '</div>'+
      '<div class="'+realCls+'">'+realDisp+'</div>'+
      '<div class="c-des '+desvio.cls+'" title="'+esc(desvio.tip)+'">'+desvio.lbl+'</div>'+
    '</div>'
  );
}

function orcCellHTMLTotal(prev, real, showBoth){
  const prevDisp = fmtBR(prev||0);
  const realDisp = showBoth ? fmtBR(real||0) : '—';
  const des = orcDesvioChipRaw(prev, real, showBoth, false);
  return (
    '<div class="orc-cell">'+
      '<div class="c-prev" style="font-weight:800">'+prevDisp+'</div>'+
      '<div class="c-real" style="font-weight:700">'+realDisp+'</div>'+
      '<div class="c-des '+des.cls+'" title="'+esc(des.tip)+'">'+des.lbl+'</div>'+
    '</div>'
  );
}

function orcCellHTMLResult(mIdx, prev, real, fechado){
  const prevDisp = fmtBR(prev||0);
  const realDisp = fechado ? fmtBR(real||0) : '—';
  // Para resultado, receita + custo já combinados; desvio calculado em cima do resultado
  // Invertendo sinal: real > prev = bom (verde)
  const des = orcDesvioChipRaw(prev, real, fechado, false);
  return (
    '<div class="orc-cell">'+
      '<div class="c-prev">'+prevDisp+'</div>'+
      '<div class="c-real">'+realDisp+'</div>'+
      '<div class="c-des '+des.cls+'" title="'+esc(des.tip)+'">'+des.lbl+'</div>'+
    '</div>'
  );
}

function orcCellHTMLTotalResult(prev, real){
  return orcCellHTMLTotal(prev, real, true);
}

// Chip de desvio (heatmap)
//  Para Receita: real > prev = verde (bom); real < prev = vermelho (ruim).
//  Para Custos:   real > prev = vermelho (ruim); real < prev = verde (bom).
//  Para Resultado: real > prev = verde.
function orcDesvioChip(catId, prev, real, fechado){
  if(!fechado) return {cls:'neutral', lbl:'—', tip:''};
  const invert = (catId !== 'receita'); // custos: menos é melhor
  return orcDesvioClassify(prev, real, invert);
}
function orcDesvioChipRaw(prev, real, fechado, invertCusto){
  if(!fechado) return {cls:'neutral', lbl:'—', tip:''};
  return orcDesvioClassify(prev, real, invertCusto);
}
function orcDesvioClassify(prev, real, invert){
  if(!prev && !real) return {cls:'neutral', lbl:'—', tip:'Sem dados'};
  if(!prev) return {cls:'neutral', lbl:'—', tip:'Sem previsão'};
  const diff = real - prev;
  const pct = (diff / Math.abs(prev)) * 100;
  // Sinal "bom" se diff>0 && !invert  OU  diff<0 && invert
  const bom = invert ? (diff < 0) : (diff > 0);
  const absP = Math.abs(pct);
  let band = '';
  if(absP >= 30) band = bom ? 'good30' : 'bad30';
  else if(absP >= 20) band = bom ? 'good20' : 'bad20';
  else if(absP >= 10) band = bom ? 'good10' : 'bad10';
  else if(absP >= 5)  band = bom ? 'good5'  : 'bad5';
  else band = 'neutral';
  const signo = (pct >= 0 ? '+' : '');
  const lbl = signo + fmtBR(pct, 0) + '%';
  const tip = 'Previsto: '+fmtBRL(prev)+' · Real: '+fmtBRL(real)+' · Δ '+fmtBRL(diff);
  return {cls:'orc-des-h '+band, lbl, tip};
}

// ───── KPIs anuais + Run-rate + Alertas + Top 5 ─────
function updateOrcKpis(){
  const y = orcActiveYear;
  const recPrev = orcPrevAno('receita', y);
  const cusPrev = ORC_CUSTO_IDS.reduce((s,c) => s + orcPrevAno(c, y), 0);
  const resPrev = recPrev - cusPrev;
  let recReal = 0, cusReal = 0;
  for(let m=0;m<12;m++){
    if(!orcMesFechado(y, m)) continue;
    recReal += orcRealMes('receita', y, m);
    for(const c of ORC_CUSTO_IDS) cusReal += orcRealMes(c, y, m);
  }
  const resReal = recReal - cusReal;

  const today = new Date();
  const ty = today.getFullYear();
  const tm = today.getMonth();
  const mesLbl = (parseInt(y) < ty) ? '(ano completo)'
               : (parseInt(y) > ty) ? '(ainda não iniciado)'
               : '(até '+ORC_MESES[tm]+'/'+y.slice(-2)+')';

  const setTxt = (id, txt) => { const el = document.getElementById(id); if(el) el.textContent = txt; };
  const setHtml= (id, html) => { const el = document.getElementById(id); if(el) el.innerHTML = html; };
  setTxt('orc-kpi-rec-prev', fmtBRL(recPrev));
  setTxt('orc-kpi-cus-prev', fmtBRL(cusPrev));
  setTxt('orc-kpi-res-prev', fmtBRL(resPrev));
  setTxt('orc-kpi-rec-sub', 'realizado '+mesLbl+': '+fmtBRL(recReal));
  setTxt('orc-kpi-cus-sub', 'realizado '+mesLbl+': '+fmtBRL(cusReal));
  setTxt('orc-kpi-res-sub', 'realizado '+mesLbl+': '+fmtBRL(resReal));

  // Run-rate (projeção fim de ano baseada na média realizada)
  const rrRec = orcRunRateCat('receita', y);
  const rrCus = orcRunRateFor((m) => ORC_CUSTO_IDS.reduce((s,c)=>s+orcRealMes(c,y,m),0), y);
  const rrRes = orcRunRateFor((m) => orcResultRealMes(y, m), y);
  const rrFmt = (rr, label) => {
    if(!rr || rr.mesesFechados === 0) return '';
    const diff = rr.projecao - (label === 'rec' ? recPrev : label === 'cus' ? cusPrev : resPrev);
    const base = (label === 'rec' ? recPrev : label === 'cus' ? cusPrev : resPrev);
    const pct = base ? ((diff/Math.abs(base))*100) : 0;
    const sinal = diff >= 0 ? '+' : '';
    const cor = (label === 'cus' ? (diff > 0 ? '#DC2626' : '#059669') : (diff > 0 ? '#059669' : '#DC2626'));
    return 'Proj. fim de ano: <b>'+fmtBRL(rr.projecao)+'</b> ' +
           '<span style="color:'+cor+'">('+sinal+fmtBR(pct, 1)+'%)</span>';
  };
  setHtml('orc-kpi-rec-rr', rrFmt(rrRec, 'rec'));
  setHtml('orc-kpi-cus-rr', rrFmt(rrCus, 'cus'));
  setHtml('orc-kpi-res-rr', rrFmt(rrRes, 'res'));

  // Desvio YTD
  let resPrevAcum = 0;
  for(let m=0;m<12;m++){ if(orcMesFechado(y,m)) resPrevAcum += orcResultPrevMes(y, m); }
  const desvio = resReal - resPrevAcum;
  const pctStr = resPrevAcum ? (' · '+((desvio>=0?'+':'')+fmtBR(desvio/Math.abs(resPrevAcum)*100, 1))+'%') : '';
  setTxt('orc-kpi-desvio', (desvio>=0?'+':'')+fmtBRL(desvio)+pctStr);
  const dEl = document.getElementById('orc-kpi-desvio');
  if(dEl) dEl.style.color = (desvio > 0) ? '#059669' : (desvio < 0 ? '#DC2626' : '');
  setTxt('orc-kpi-desvio-sub', 'prev acum: '+fmtBRL(resPrevAcum)+' · real acum: '+fmtBRL(resReal));

  // Run-rate no KPI de desvio: projeção de fim de ano para o Resultado
  if(rrRes && rrRes.mesesFechados > 0){
    const resDiffAno = rrRes.projecao - resPrev;
    const resPctAno = resPrev ? (resDiffAno/Math.abs(resPrev))*100 : 0;
    const cor = resDiffAno > 0 ? '#059669' : resDiffAno < 0 ? '#DC2626' : '';
    setHtml('orc-kpi-desvio-rr',
      'Projeção fim de ano: <b style="color:'+cor+'">'+(resDiffAno>=0?'+':'')+fmtBRL(resDiffAno)+'</b> ' +
      '<span style="color:'+cor+'">('+(resDiffAno>=0?'+':'')+fmtBR(resPctAno, 1)+'% vs prev)</span>'
    );
  } else {
    setHtml('orc-kpi-desvio-rr', '');
  }

  renderOrcAlertas();
  renderOrcTop5();
}

// ═══════════ Alertas ═══════════
function renderOrcAlertas(){
  const host = document.getElementById('orc-alerts-banner');
  if(!host) return;
  const alerts = orcAlertasCheck(orcActiveYear);
  if(!alerts.length){
    host.style.display = 'none';
    host.innerHTML = '';
    return;
  }
  host.style.display = 'flex';
  const rows = alerts.map(a => {
    const danger = Math.abs(a.pct) > (a.limite + 10);
    const sinal = a.pct >= 0 ? '+' : '';
    const tipoLbl = a.tipo === 'acima' ? 'acima do previsto' : 'abaixo do previsto';
    const ico = '<span style="width:22px;height:22px;border-radius:6px;background:'+a.catColor+';'+
                'display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">'+
                '<svg viewBox="0 0 24 24" style="width:12px;height:12px;stroke:#fff;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round">'+a.catSvg+'</svg></span>';
    return '<div class="orc-alert'+(danger ? ' danger' : '')+'">'+
             ico +
             '<div class="orc-alert-msg"><b>'+esc(a.catNome)+'</b> está '+tipoLbl+
             ' (limite '+a.limite+'%). Previsto acum. '+fmtBRL(a.prev)+' · realizado '+fmtBRL(a.real)+'.</div>'+
             '<div class="orc-alert-pill">'+sinal+fmtBR(a.pct, 1)+'%</div>'+
           '</div>';
  });
  host.innerHTML = rows.join('');
}

