<div class="fk-auth-backdrop" id="fk-auth-backdrop" role="dialog" aria-modal="true" aria-labelledby="fk-auth-title">
  <div class="fk-auth-modal">
    <button type="button" class="fk-auth-close" data-fk-close="auth" aria-label="Fechar">×</button>
    <div class="fk-auth-brand">
      <svg class="fk-logo-icon" viewBox="0 0 40 40" aria-hidden="true">
        <rect x="0" y="0" width="40" height="40" rx="10" fill="#0F172A"/>
        <path d="M11 13 L21 20 L11 27" stroke="#F8FAFC" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
