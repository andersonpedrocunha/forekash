];

let estrutura = null;
let estActiveYear = null;

function estMesKey(y, mIdx){ return y + '-' + String(mIdx+1).padStart(2,'0'); }
function estTipo(tid){ return (estrutura.tipos||[]).find(t=>t.id===tid) || null; }
function estTag(gid){ return (estrutura.tags||[]).find(g=>g.id===gid) || null; }
function estCurYear(){ return estActiveYear || (estrutura && estrutura.years[0]); }

function estNextTagId(){
  const ids = new Set((estrutura.tags||[]).map(t=>t.id));
  let n=1; while(ids.has('tag'+n)) n++; return 'tag'+n;
}
function estNextTipoId(){
  const ids = new Set((estrutura.tipos||[]).map(t=>t.id));
  let n=1; while(ids.has('tp'+n)) n++; return 'tp'+n;
}

function estLoad(){
  let raw = null;
  try{ raw = localStorage.getItem(EST_KEY); }catch(e){}
  if(raw){
    try{ estrutura = JSON.parse(raw); }catch(e){ estrutura = null; }
  }
  if(!estrutura || typeof estrutura !== 'object'){
    const y = String(new Date().getFullYear());
    estrutura = {
      activeYear: y,
      years: [String(parseInt(y)-1), y],
      tipos: JSON.parse(JSON.stringify(EST_TIPOS_DEFAULT)),
      tags:  JSON.parse(JSON.stringify(EST_TAGS_DEFAULT)),
      itens: [],
      nextId: 1
    };
  }
  // Migração / saneamento
  if(!Array.isArray(estrutura.years) || estrutura.years.length === 0){
    estrutura.years = [String(new Date().getFullYear())];
  }
  estrutura.years = estrutura.years.map(String);
  if(!Array.isArray(estrutura.tipos) || estrutura.tipos.length === 0){
    estrutura.tipos = JSON.parse(JSON.stringify(EST_TIPOS_DEFAULT));
  }
  if(!Array.isArray(estrutura.tags)) estrutura.tags = JSON.parse(JSON.stringify(EST_TAGS_DEFAULT));
  if(!Array.isArray(estrutura.itens)) estrutura.itens = [];
  if(!estrutura.nextId){
    estrutura.nextId = Math.max(1, estrutura.itens.reduce((m,i)=>Math.max(m,i.id||0),0)+1);
  }
  for(const it of estrutura.itens){
    if(!it.valores || typeof it.valores !== 'object') it.valores = {};
    if(!it.pagos   || typeof it.pagos   !== 'object') it.pagos   = {};
    if(typeof it.nome !== 'string') it.nome = '';
    if(!it.tipoId) it.tipoId = '';
    if(!it.tagId) it.tagId = '';
  }
  // Ano ativo
  const savedY = estrutura.activeYear;
  estActiveYear = (savedY && estrutura.years.includes(savedY))
                  ? savedY : estrutura.years[estrutura.years.length-1];
}

function estSave(){
  estrutura.activeYear = estActiveYear;
  try{ localStorage.setItem(EST_KEY, JSON.stringify(estrutura)); }catch(e){}
}

