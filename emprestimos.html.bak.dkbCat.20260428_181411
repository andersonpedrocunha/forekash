function _anaAutoSubtitleFromSlide(slide){
  if(!slide) return '';
  const facts = _anaCollectFacts();
  const k = _anaCalcKPIs(facts);
  const x = _anaCalcIndicadoresExtra(k, facts);
  const fmt = (n) => fmtBRL(n||0);
  const fmtPct = (n) => (isFinite(n) ? n.toFixed(1).replace('.',',') : '0,0') + '%';
  const m = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
  const periodo = m[_anaState.mesDe] + '/' + String(_anaState.anoDe).slice(2)
                + ' → ' + m[_anaState.mesAte] + '/' + String(_anaState.anoAte).slice(2);
  const subjects = new Set();
  for(const w of (slide.widgets || [])){
    const wid = w.widget || '';
    if(/receita|ebitda|margem|fluxo|burn|cash|breakeven/.test(wid)) subjects.add('financeiro');
    if(/clientes|churn|top-clientes|ltv|ticket/.test(wid)) subjects.add('clientes');
    if(/headcount|folha|sal|turnover|func/.test(wid)) subjects.add('pessoas');
    if(/endiv|loans/.test(wid)) subjects.add('divida');
    if(/saldo|runway/.test(wid)) subjects.add('caixa');
  }
  // Variações de subtítulo — tom executivo, leve, com hierarquia
  const variations = {
    capa: [
      periodo.toUpperCase() + '   ·   ' + x.meses + ' ' + (x.meses === 1 ? 'mês de história' : 'meses de história'),
      'Visão consolidada do período ' + periodo,
      periodo + '   ·   um retrato em ' + x.meses + ' ' + (x.meses === 1 ? 'mês' : 'meses'),
      'Indicadores, leituras e próximos movimentos',
      periodo
    ],
    generic: [
      'Período de referência: ' + periodo + '   ·   ' + x.meses + (x.meses === 1 ? ' mês' : ' meses'),
      periodo + '   ·   leitura consolidada',
      'Recorte de ' + x.meses + (x.meses === 1 ? ' mês' : ' meses') + ' encerrado em ' + periodo.split(' → ')[1],
      'Snapshot · ' + periodo
    ],
    clientes: [
      k.clientesAtivos + ' clientes ativos   ·   ticket ' + fmt(x.ticketMedio) + '   ·   LTV ' + fmt(k.ltv),
      'Base de ' + k.clientesAtivos + '   ·   ' + fmt(x.ticketMedio) + '/cliente   ·   churn ' + fmtPct(k.churn),
      'Quem está comprando — ' + k.clientesAtivos + ' clientes movimentaram ' + fmt(k.receita),
      'Base ativa ' + k.clientesAtivos + '   ·   retenção ' + fmtPct(100-k.churn)
    ],
    pessoas: [
      Math.round(k.headcount) + ' pessoas   ·   folha ' + fmt(k.folha) + '   ·   ' + fmtPct(x.pctFolha) + ' da receita',
      'Time de ' + Math.round(k.headcount) + '   ·   custo médio ' + fmt(x.salarioMedio) + '/pessoa',
      Math.round(k.headcount) + ' no time   ·   turnover ' + fmtPct(k.turnover),
      'Equipe de ' + Math.round(k.headcount) + '   ·   ' + fmt(k.folha) + ' em ' + x.meses + ' ' + (x.meses === 1 ? 'mês' : 'meses')
    ],
    caixa: [
      'Saldo ' + fmt(k.saldo) + '   ·   runway ' + (isFinite(k.runway)&&k.runway>=0?k.runway.toFixed(1):'∞') + ' meses   ·   burn ' + fmt(x.burnMes) + '/mês',
      'Liquidez atual ' + fmt(k.saldo) + '   ·   queima ' + fmt(x.burnMes) + '/mês',
      'Caixa hoje ' + fmt(k.saldo) + '   ·   projeção ' + (isFinite(k.runway)&&k.runway>=0?k.runway.toFixed(1):'∞') + ' meses de pista',
      fmt(k.saldo) + ' em caixa   ·   burn médio ' + fmt(x.burnMes)
    ],
    divida: [
      'Estoque devedor ' + fmt(k.endividamento) + '   ·   ' + fmtPct(x.pctLoans) + ' da receita',
      'Dívida total ' + fmt(k.endividamento) + '   ·   serviço ' + fmtPct(x.pctLoans),
      fmt(k.endividamento) + ' em empréstimos   ·   compromete ' + fmtPct(x.pctLoans) + ' da receita'
    ],
    financeiro: [
      'Receita ' + fmt(k.receita) + '   ·   EBITDA ' + fmt(k.ebitda) + '   ·   margem ' + fmtPct(k.margem),
      'Receita ' + fmt(k.receita) + '   ·   margem ' + fmtPct(k.margem) + '   ·   MoM ' + fmtPct(x.momPct),
      fmt(k.receita) + ' faturados   ·   ' + fmt(k.ebitda) + ' de EBITDA',
      'Performance · receita ' + fmt(k.receita) + '   ·   break-even ' + fmtPct(x.breakEven)
    ]
  };
  if(slide.isCover) return _anaPickVar(variations.capa);
  if(subjects.size === 0) return _anaPickVar(variations.generic);
  if(subjects.has('clientes') && subjects.size === 1) return _anaPickVar(variations.clientes);
  if(subjects.has('pessoas') && subjects.size === 1)  return _anaPickVar(variations.pessoas);
  if(subjects.has('caixa'))                            return _anaPickVar(variations.caixa);
  if(subjects.has('divida') && subjects.size === 1)   return _anaPickVar(variations.divida);
  if(subjects.has('financeiro'))                       return _anaPickVar(variations.financeiro);
  return _anaPickVar(variations.generic);
}
