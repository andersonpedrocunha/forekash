               value="${real!=null ? fmtBR(real,2) : ''}">
        <div class="imp-pagar-hint">Deixe vazio e clique em <b>Limpar</b> para voltar à parcela prevista.</div>
      </div>
      `}
      <div class="imp-pagar-actions">
        <div class="imp-pagar-actions-l">
          <button class="confirm-btn imp-pagar-skip sec" type="button" title="Marcar como não pago — a parcela acumula no próximo mês com correção SELIC">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
            Não paguei
          </button>
          <button class="confirm-btn imp-pagar-clear sec" type="button"${real==null?' disabled':''} title="Voltar ao valor previsto">Limpar</button>
        </div>
        <div class="imp-pagar-actions-r">
          <button class="confirm-btn confirm-cancel" type="button">Cancelar</button>
          <button class="confirm-btn confirm-ok" type="button">Salvar</button>
        </div>
      </div>
    </div>`;

  let done = false;
  const close = () => {
    if(done) return; done = true;
    document.removeEventListener('keydown', onKey, true);
    ov.remove();
  };
  const onKey = (e) => {
    if(e.key === 'Escape'){ e.stopPropagation(); close(); }
    else if(e.key === 'Enter'){ e.stopPropagation(); save(); }
  };
  const save = () => {
    if(temAtrasos){
      // Modo lista: marca os checkbox selecionados como pagos com o valor digitado
      p.pagamentos = p.pagamentos || {};
      let nPagos = 0;
      const items = ov.querySelectorAll('.imp-atraso-item');
      items.forEach(item => {
        const chk = item.querySelector('.imp-atraso-chk, .imp-atraso-chk-cur');
        const inp = item.querySelector('.imp-atraso-val-inp');
        if(!chk || !inp || !chk.checked) return;
        const val = parseBR(inp.value || '') || 0;
        if(val <= 0) return;
        const atrYm = chk.getAttribute('data-ym') || ym;
        p.pagamentos[atrYm] = val;
        nPagos++;
      });
      p._planKey = null; p._plan = null;
      impSave();
      try { if(typeof toast === 'function') toast('✅ ' + nPagos + ' parcela(s) registrada(s)'); } catch(e){}
      renderImpParSheet();
      updateImpParKpis();
      close();
      return;
    }
    const inp = ov.querySelector('#imp-pagar-input');
    const raw = (inp.value||'').trim();
    if(raw === ''){
      // Vazio = equivalente a remover
      clearPag();
      return;
    }
    const v = parseBR(raw);
    if(!isFinite(v) || v < 0){
      inp.classList.add('err');
      return;
    }
    p.pagamentos = p.pagamentos || {};
    p.pagamentos[ym] = +v;
    p._planKey = null; p._plan = null;  // invalida cache
    impSave();
    renderImpParSheet();
    updateImpParKpis();
    close();
  };
  const clearPag = () => {
    if(p.pagamentos && Object.prototype.hasOwnProperty.call(p.pagamentos, ym)){
      delete p.pagamentos[ym];
      p._planKey = null; p._plan = null;
      impSave();
      renderImpParSheet();
      updateImpParKpis();
    }
    close();
  };
  const skipMes = async () => {
    // Conta meses em atraso ATUAIS (antes deste mês) pra avisar do cancelamento
    const info = impParcAcumuladoAteMes(p, ym);
    const totalAtraso = info.skippedMonths + 1;
    const warn = totalAtraso >= 3
      ? `\n\n🚨 ATENÇÃO: este será o ${totalAtraso}º mês em atraso consecutivo. Após 3 parcelas em atraso o parcelamento poderá ser cancelado pela Receita.`
      : `\n\n⚠️ Lembrete: após 3 parcelas em atraso o parcelamento poderá ser cancelado pela Receita.`;
    let ok = true;
    try {
      ok = await showConfirm({
        title: 'Não pagou este mês?',
        message: 'Marcar ' + mesLabel + ' como não pago. A parcela não desaparece — ela acumula no próximo mês corrigida pela SELIC. Você pode quitar o atraso pagando o valor acumulado nos meses seguintes.' + warn,
        confirmLabel: 'Sim, marcar em atraso',
        cancelLabel: 'Cancelar',
        destructive: true
      });
    } catch(e){}
    if(!ok) return;
    p.pagamentos = p.pagamentos || {};
    p.pagamentos[ym] = 0;
    p._planKey = null; p._plan = null;
    impSave();
    renderImpParSheet();
    updateImpParKpis();
    close();
  };

  document.addEventListener('keydown', onKey, true);
  ov.addEventListener('click', (e) => { if(e.target === ov) close(); });
  document.body.appendChild(ov);

  ov.querySelector('.confirm-cancel').onclick = close;
  ov.querySelector('.confirm-ok').onclick = save;
  const btnClear = ov.querySelector('.imp-pagar-clear');
  if(btnClear) btnClear.onclick = clearPag;
  const btnSkip = ov.querySelector('.imp-pagar-skip');
  if(btnSkip) btnSkip.onclick = skipMes;

  // Atualiza o total em tempo real quando marca/desmarca checkboxes OU edita valor.
  // Edição do MÊS ATUAL propaga pra parcelas em atraso que ainda não foram editadas
  // manualmente (costumam ter o mesmo valor nominal).
  if(temAtrasos){
    const totalEl = ov.querySelector('#imp-atraso-total-val');
    const curInp  = ov.querySelector('.imp-atraso-val-cur');
    const atrInps = ov.querySelectorAll('.imp-atraso-val-inp:not(.imp-atraso-val-cur)');
    // Referências pros KVs do cabeçalho — atualizam conforme o usuário edita
    const parcelaEl  = ov.querySelector('#imp-pagar-parcela-val');
    const amortEl    = ov.querySelector('#imp-pagar-amort-val');
    const jurosElHdr = ov.querySelector('#imp-pagar-juros-val');
    const jurosTagHdr= ov.querySelector('#imp-pagar-juros-tag');
    const recalcTotal = () => {
      let total = 0, amort = 0, juros = 0;
      ov.querySelectorAll('.imp-atraso-item').forEach(item => {
        const chk = item.querySelector('.imp-atraso-chk, .imp-atraso-chk-cur');
        const inp = item.querySelector('.imp-atraso-val-inp');
        if(!chk || !inp || !chk.checked) return;
        const v = parseBR(inp.value || '') || 0;
        if(v <= 0) return;
        total += v;
        // Amortização nominal = p.parcelaMensal (mesmo valor pra todas as parcelas)
        const a = Math.min(v, amortBase);
        amort += a;
        juros += Math.max(0, v - amortBase);
      });
      if(totalEl) totalEl.textContent = fmtBRL(total);
      if(parcelaEl) parcelaEl.textContent = fmtBRL(total);
      if(amortEl)   amortEl.textContent   = fmtBRL(amort);
      if(jurosElHdr){
        jurosElHdr.textContent = fmtBRL(juros);
        jurosElHdr.style.color = '#DC2626';
      }
      if(jurosTagHdr){
        jurosTagHdr.textContent = '(a pagar)';
        jurosTagHdr.style.color = '#DC2626';
      }
    };
    const propagateFromCurrent = () => {
      if(!curInp) return;
      const raw = (curInp.value || '').trim();
      const v = parseBR(raw);
      if(!isFinite(v) || v < 0) return;
      atrInps.forEach(inp => {
        if(inp.dataset.touched === '1') return;
        inp.value = fmtBR(v, 2);
      });
    };
    ov.querySelectorAll('.imp-atraso-chk, .imp-atraso-chk-cur').forEach(c => {
      c.addEventListener('change', recalcTotal);
    });
    // Parcelas em atraso: marca como "editada" quando o usuário digita nelas
    atrInps.forEach(inp => {
      inp.addEventListener('input', () => {
        inp.dataset.touched = '1';
        recalcTotal();
      });
      inp.addEventListener('blur', recalcTotal);
    });
    // Mês atual: propaga o valor pras parcelas em atraso não editadas
    if(curInp){
      curInp.addEventListener('input', () => {
        propagateFromCurrent();
        recalcTotal();
      });
      curInp.addEventListener('blur', () => {
        propagateFromCurrent();
        recalcTotal();
      });
    }
    // Sincroniza valores iniciais do cabeçalho (parcela/amort/juros) com a lista
    recalcTotal();
  }

  // Juros = valor pago − amortização (live) — só quando NÃO está em modo lista de atrasos
  const jurosEl = ov.querySelector('#imp-pagar-juros-val');
  const jurosTag = ov.querySelector('#imp-pagar-juros-tag');
  const updateJuros = () => {
    const inp2 = ov.querySelector('#imp-pagar-input');
    if(!inp2) return;
    const raw = (inp2.value||'').trim();
    if(raw === ''){
      if(jurosEl)  jurosEl.textContent = fmtBRL(jurosPrev);
      if(jurosTag){ jurosTag.textContent = '(previsto)'; jurosTag.style.color = '#9CA3AF'; }
      return;
    }
    const v = parseBR(raw);
    if(!isFinite(v) || v < 0){
      if(jurosEl)  jurosEl.textContent = '—';
      if(jurosTag){ jurosTag.textContent = ''; }
      return;
    }
    const j = v - amortBase;
    if(jurosEl){
      jurosEl.textContent = (j < 0)
        ? '−' + fmtBRL(Math.abs(j))   // pagou menos que a amortização
        : fmtBRL(j);
      jurosEl.style.color = (j < 0) ? '#B45309' : '#DC2626';
    }
    if(jurosTag){
      if(j < 0){
        jurosTag.textContent = '(amort. parcial)'; jurosTag.style.color = '#B45309';
      } else {
        jurosTag.textContent = '(pago)'; jurosTag.style.color = '#DC2626';
      }
    }
  };

  const inp = ov.querySelector('#imp-pagar-input');
  if(inp){
    inp.addEventListener('input', () => { inp.classList.remove('err'); updateJuros(); });
    setTimeout(()=>{ inp.focus(); inp.select(); updateJuros(); }, 20);
  }
}

