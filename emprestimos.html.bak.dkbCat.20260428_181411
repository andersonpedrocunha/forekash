  ov.innerHTML = '<div class="rec-cal-day-modal">'
    + '<div class="rec-cal-day-modal-hd">'
    +   '<h3>📅 ' + hd + '</h3>'
    +   '<div class="rec-cal-day-modal-sum">' + filtered.length + ' item(s) · <b>' + fmtTot + '</b></div>'
