    .ana-cw-chart-fill{position:absolute;top:6px;left:8px;right:8px;bottom:6px;min-height:120px}
    .ana-cw-chart-fill > canvas{display:block}
    /* Tabelas em slides (Apresentação) */
    .ana-pres-table-wrap{width:100%;height:100%;overflow:auto}
    .ana-pres-table{width:100%;border-collapse:collapse;font-size:.7rem;font-family:Consolas,Menlo,monospace;letter-spacing:.01em}
