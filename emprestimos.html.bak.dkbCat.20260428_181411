function _recPagFormatBlur(el){
  if(!el) return;
  const n = (typeof _dkbParseNumBR === 'function') ? _dkbParseNumBR(el.value) : parseFloat(el.value) || 0;
  el.value = (typeof _dkbFmtNumBR === 'function') ? _dkbFmtNumBR(n) : n.toFixed(2).replace('.', ',');
  _recPagCalc();
}
function _recPagCalc(){
  const parse = (typeof _dkbParseNumBR === 'function') ? _dkbParseNumBR : (s => parseFloat(s)||0);
  const fmt = (typeof _dkbFmtNumBR === 'function') ? _dkbFmtNumBR : (n => (n||0).toFixed(2).replace('.', ','));
  const v = parse(document.getElementById('rec-kb-fld-valpago')?.value);
  const j = parse(document.getElementById('rec-kb-fld-juros')?.value);
  const m = parse(document.getElementById('rec-kb-fld-multa')?.value);
  const d = parse(document.getElementById('rec-kb-fld-desc')?.value);
  const total = v + j + m - d;
  const elT = document.getElementById('rec-kb-pag-total');
  if(elT) elT.textContent = fmt(total);
  const ctx = _recKbModalCtx;
  let orig = 0;
  if(ctx){
    const d2 = receita?.years?.[ctx.year];
    const row = d2 && (d2.clients||[]).find(r => r.id === ctx.rowId);
    const cell = row && row.meses && row.meses[ctx.mesAbbr];
    if(cell) orig = parseFloat(cell.valor) || 0;
  }
  const saldo = Math.max(0, orig - v);
  const elS = document.getElementById('rec-kb-pag-saldo');
  const elH = document.getElementById('rec-kb-pag-saldo-hint');
  if(elS){ elS.textContent = 'R$ ' + fmt(saldo); elS.classList.toggle('zero', saldo <= 0.001); }
  if(elH){
    if(saldo > 0.001){ elH.textContent = '⚠ Recebimento parcial — saldo permanece em aberto.'; elH.style.color = '#FCD34D'; }
    else if(v > orig + 0.001){ elH.textContent = 'ℹ Valor maior que o original (juros/multa cobertos).'; elH.style.color = '#86EFAC'; }
    else { elH.textContent = 'Quitação total · esta parcela será encerrada.'; elH.style.color = '#94A3B8'; }
  }
}
