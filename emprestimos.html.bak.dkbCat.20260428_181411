function _viagRejectPessoa(val){
  const inp = document.getElementById('viag-reject-por');
  if(!inp) return;
  if(val === '__externo__'){
    inp.style.display = 'block';
    inp.value = '';
    inp.focus();
  } else {
    inp.style.display = 'none';
    inp.value = val;
  }
}
function _viagConfirmReject(viagemId){
  const v = viagens.itens.find(x => x.id === viagemId);
  if(!v) return;
  const motivo = (document.getElementById('viag-reject-motivo')?.value || '').trim();
  const sel = document.getElementById('viag-reject-pessoa');
  const inp = document.getElementById('viag-reject-por');
  let por = '';
  if(sel && sel.value && sel.value !== '__externo__'){
    por = sel.value;
  } else if(inp && inp.value.trim()){
    por = inp.value.trim();
  }
  if(!por){
    if(typeof toast === 'function') toast('⚠ Selecione/digite quem está rejeitando');
    return;
  }
  if(!motivo){
    if(typeof toast === 'function') toast('⚠ Informe o motivo da rejeição');
    return;
  }
  // Valida assinatura
  const cv = document.getElementById('viag-reject-canvas');
  if(!cv){ if(typeof toast === 'function') toast('Canvas não encontrado'); return; }
  const ctx = cv.getContext('2d');
  const data = ctx.getImageData(0, 0, cv.width, cv.height).data;
  let hasInk = false;
  for(let i = 3; i < data.length; i += 4){ if(data[i] > 0){ hasInk = true; break; } }
  if(!hasInk){
    if(typeof toast === 'function') toast('⚠ Faça a assinatura no quadro');
    return;
  }
  const sigData = cv.toDataURL('image/png');
  const dataISO = new Date().toISOString();
  // Hash SHA-256 da combinação (assinatura | responsável | motivo | data | viagemId | título)
  const payload = sigData + '|' + por + '|' + motivo + '|' + dataISO + '|' + v.id + '|' + (v.titulo || '');
  _viagComputeHash(payload).then(hash => {
    const codigo = _viagShortCode(hash);
    v.status = 'rejeitado';
    if(!v.fechadoEm) v.fechadoEm = dataISO;
    v.rejeicao = {
      motivo: motivo,
      por: por,
      data: dataISO,
      assinatura: sigData,
      hash: hash,
      codigo: codigo
    };
    viagSave();
    const ovEl = document.getElementById('viag-reject-modal');
    if(ovEl) ovEl.remove();
    renderViagens();
    if(_viagEditingId === v.id){ try { _viagRenderEditor(); } catch(e){} }
    if(typeof toast === 'function') toast('❌ Rejeitado por ' + por + ' · código ' + codigo);
  }).catch(err => {
    console.error('hash failed:', err);
    if(typeof toast === 'function') toast('Erro ao gerar hash da assinatura');
  });
}
