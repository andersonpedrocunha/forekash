                <path d="M12 9v4M12 17h.01"/>
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              </svg>
            </span>
            <div class="pcard-alert-body">
              <b>Reajuste fora do prazo.</b> ${origem} — considere revisar a remuneração.
            </div>
          </div>`;
      }
    }
  }

  if(titleEl) titleEl.textContent = nome;

  const reajHtml = hist.length
    ? `<div class="pcard-reaj-list">${hist.slice().reverse().map(r => {
         const sinal = r.pct > 0 ? '+' : (r.pct < 0 ? '' : '±');
         const cls = r.pct > 0 ? 'up' : (r.pct < 0 ? 'down' : 'flat');
         return `<div class="pcard-reaj-item">
           <div class="pcard-reaj-mes">${esc(pesKeyToLabel(r.key))}</div>
           <div class="pcard-reaj-vals">de <b>${fmtBRL(r.from)}</b> para <b>${fmtBRL(r.to)}</b></div>
           <div class="pcard-reaj-var ${cls}">${sinal}${r.pct.toFixed(1).replace('.',',')}%</div>
         </div>`;
       }).join('')}</div>`
    : `<div class="pcard-empty">Sem histórico de reajuste — preencha salários em pelo menos dois meses distintos para começar o histórico.</div>`;

  // Avatar: foto OU iniciais. Clicar abre o seletor de arquivo.
  const regId = p.pessoaId || 0;
  const fotoData = view.foto || '';
  const avatarInner = fotoData
    ? `<img class="pcard-ava-img" src="${esc(fotoData)}" alt="Foto de ${esc(nome)}">`
    : esc(initials);
  // O label-wrapper recebe o input de arquivo. Se não houver registry (sem nome),
  // não deixa trocar foto — obriga a selecionar a pessoa primeiro.
  const podeEditarFoto = regId > 0;
  const avatarHtml = podeEditarFoto
    ? `<label class="pcard-avatar" style="--tc:${tipoColor};--ttxt:${tipoTxt}"
              title="${fotoData?'Trocar foto':'Adicionar foto'}">
         ${avatarInner}
         <span class="pcard-ava-cam" aria-hidden="true">
           <svg viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
         </span>
         ${fotoData ? `
           <button type="button" class="pcard-ava-remove" title="Remover foto"
                   onclick="event.preventDefault();event.stopPropagation();removePesFoto(${regId})">
             <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
           </button>` : ''}
         <input type="file" accept="image/*" hidden
                onchange="onPesFotoChange(${regId}, this)">
       </label>`
    : `<div class="pcard-avatar" style="--tc:${tipoColor};--ttxt:${tipoTxt};cursor:default" title="Selecione uma pessoa para adicionar foto">${avatarInner}</div>`;

  // ─── Dados cadastrais (registry-level) ────────────────
  const reg          = pesRegOf(p);
  const tipoPessoa   = (reg && reg.tipoPessoa) || 'pf';
  // Campos independentes por tipo — cada chip guarda seus próprios dados.
  const cpfVal       = (reg && reg.cpf) || '';
  const cnpjVal      = (reg && reg.cnpj) || '';
  const taxIdVal     = (reg && reg.taxId) || '';
  const razaoSocial  = (reg && reg.razaoSocial) || '';
  const nomeCompleto = (reg && reg.nomeCompleto) || '';
  const nomeLegal    = (reg && reg.nomeLegal) || '';
  // Seleciona o nome/documento a exibir conforme o tipo ativo.
  const docAtual     = tipoPessoa === 'pf' ? cpfVal
                     : tipoPessoa === 'pj' ? cnpjVal
                     : taxIdVal;
  const nomeAtual    = tipoPessoa === 'pf' ? nomeCompleto
                     : tipoPessoa === 'pj' ? razaoSocial
                     : nomeLegal;
  const nacioCode    = (reg && reg.nacionalidade) || '';
  const nacioObj     = nacioCode ? recPaisByCode(nacioCode) : null;
  const nacioFlag    = nacioObj ? nacioObj.flag : (nacioCode ? flagFromCode(nacioCode) : '');
  const nacioNome    = nacioObj ? nacioObj.nome : (nacioCode || '');
  const labels       = pesRegLabels(tipoPessoa);
  const lookupState  = (regId && _pesCnpjLookupState[regId]) || null;
  // Estado do CPF (válido / inválido / duplicado) só importa em PF.
  const cpfState     = (tipoPessoa === 'pf' && regId > 0) ? pesCpfStateOf(regId) : null;

  // Chips PF/Empresa/Estrangeiro.
