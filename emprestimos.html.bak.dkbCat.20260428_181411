let pesReajSimModalYear = null;

// Anos disponíveis para configurar reajuste (anos cadastrados ≥ ano atual).
function pesReajSimModalYears(){
  const now = new Date();
  const curY = now.getFullYear();
  const years = (pessoas.years || []).slice().map(String).sort();
  return years.filter(y => parseInt(y,10) >= curY);
}
// Opções de mês para um ano específico (futuros dentro daquele ano).
function pesReajSimMesOptionsForYear(year, selected){
  const now = new Date();
  const curY = now.getFullYear();
  const curM = now.getMonth();
  const yNum = parseInt(year,10);
  const startM = (yNum === curY) ? curM : 0;
  let html = '<option value="">— escolha o mês —</option>';
  for(let m = startM; m < 12; m++){
    const k = pesMesKey(String(year), m);
    const label = (PES_MESES_LONG[m] || PES_MESES[m]);
    const pretty = label.charAt(0).toUpperCase() + label.slice(1);
    const sel = (selected === k) ? ' selected' : '';
    html += `<option value="${k}"${sel}>${esc(pretty)}</option>`;
  }
  return html;
}
