  const slidesHtml = slides.map((s, idx) => {
    const colors = _anaLayoutColors(s.layout || 'cream-exec');
    const widgets = (s.widgets || []);
    const textWidgets = widgets.filter(w => w.widget === 'text');
    const otherWidgets = widgets.filter(w => w.widget !== 'text');
    const textHtml = textWidgets.map(w => '<div class="slide-text">' + (w.text || '') + '</div>').join('');
    const otherHtml = otherWidgets.length
      ? '<div class="slide-widgets">' + otherWidgets.map(w => '<div class="slide-widget-tag">' + (_anaWidgetSummary(w) || '') + '</div>').join('') + '</div>'
      : '';
    return '<section class="print-slide" style="background:' + colors.bg + ';color:' + colors.text + '">'
         +   '<div class="slide-header">'
         +     '<div class="slide-pos">' + (idx+1) + ' / ' + slides.length + '</div>'
         +     '<h1 class="slide-title">' + (s.title || 'Sem título') + '</h1>'
         +     (s.subtitle ? '<div class="slide-sub" style="color:' + colors.sub + '">' + s.subtitle + '</div>' : '')
         +   '</div>'
         +   '<div class="slide-body">'
         +     textHtml
         +     otherHtml
         +   '</div>'
         + '</section>';
  }).join('');

  const html = '<!DOCTYPE html><html><head><meta charset="utf-8"><title>' + (p.name || 'Apresentação') + '</title>'
    + '<style>'
    +   '@page { size: A4 landscape; margin: 0; }'
    +   '* { box-sizing: border-box; }'
    +   'html, body { margin:0; padding:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; -webkit-print-color-adjust:exact; print-color-adjust:exact; }'
    +   '.print-slide { width:297mm; height:209mm; padding:24mm 28mm; page-break-after:always; position:relative; overflow:hidden; display:flex; flex-direction:column; }'
    +   '.print-slide:last-child { page-break-after:auto; }'
    +   '.slide-pos { font-size:10pt; color:rgba(0,0,0,.4); font-family:Consolas,Menlo,monospace; letter-spacing:.1em; margin-bottom:14mm; font-weight:700; }'
    +   '.slide-title { font-size:32pt; font-weight:900; letter-spacing:-.025em; line-height:1.05; margin:0 0 6mm 0; }'
    +   '.slide-sub { font-size:14pt; font-weight:500; line-height:1.4; margin-bottom:10mm; }'
    +   '.slide-body { flex:1; font-size:11pt; line-height:1.55; }'
    +   '.slide-text { margin-bottom:6mm; }'
    +   '.slide-widgets { margin-top:8mm; display:flex; flex-wrap:wrap; gap:4mm; }'
    +   '.slide-widget-tag { padding:4mm 6mm; border:1px dashed rgba(0,0,0,.2); border-radius:3mm; font-family:Consolas,Menlo,monospace; font-size:10pt; opacity:.7; }'
    +   /* Renderiza narrativa 3-COL como 3 colunas no print */
        '.ana-narr-3col { display:grid; grid-template-columns:1fr 1fr 1fr; gap:6mm; }'
    +   '.ana-narr-col { padding:6mm; border-left:1px solid rgba(0,0,0,.15); }'
    +   '.ana-narr-col:first-child { border-left:none; }'
    +   '.ana-narr-col-title { font-weight:800; font-size:13pt; margin-bottom:4mm; line-height:1.2; }'
    +   '.ana-narr-col-icon svg { width:32px; height:32px; }'
    +   '.ana-narr-col-body p { margin:0 0 3mm 0; font-size:10pt; line-height:1.5; }'
    +   '.ana-narr-col-body ol { padding-left:5mm; }'
    +   '.ana-narr-col-body ol li { font-size:10pt; line-height:1.5; padding:1mm 0; }'
    +   '.ana-narr-wrap { font-size:11pt; line-height:1.55; }'
    +   '.ana-narr-headline { font-style:italic; font-weight:800; margin-bottom:4mm; }'
    +   '.ana-narr-eyebrow { font-size:9pt; font-weight:800; text-transform:uppercase; letter-spacing:.16em; color:#5A7A98; font-family:Consolas,Menlo,monospace; margin-bottom:3mm; margin-top:4mm; }'
    +   '.ana-narr-list { list-style:none; padding:0; margin:0; }'
    +   '.ana-narr-list li { padding:2mm 0 2mm 4mm; position:relative; border-bottom:1px solid rgba(0,0,0,.05); font-size:10pt; }'
    +   '.ana-narr-list li::before { content:"—"; position:absolute; left:0; }'
    + '</style></head><body>'
    + slidesHtml
    + '<scr' + 'ipt>window.onload = function(){ setTimeout(function(){ window.print(); }, 250); };</scr' + 'ipt>'
    + '</body></html>';
  // Tenta abrir window dedicada; fallback iframe
  let w = null;
  try { w = window.open('', '_blank'); } catch(e){}
  if(w){
    w.document.open(); w.document.write(html); w.document.close();
  } else {
    // Fallback: iframe oculto
    const iframe = document.createElement('iframe');
    iframe.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0';
    document.body.appendChild(iframe);
    iframe.contentDocument.open(); iframe.contentDocument.write(html); iframe.contentDocument.close();
    setTimeout(() => { try { iframe.contentWindow.print(); } catch(e){} }, 500);
  }
  if(typeof toast === 'function') toast('📄 Janela de impressão aberta — salve como PDF');
}

// ─── PPTX: gera arquivo .pptx via pptxgenjs ───
async function anaArchiveDownloadPPTX(id){
  _anaInitSavedStores();
  const p = _anaState.archive.find(x => x.id === id);
  if(!p){ if(typeof toast === 'function') toast('Arquivo não encontrado'); return; }
  const slides = p.slides || [];
  if(slides.length === 0){ if(typeof toast === 'function') toast('Apresentação vazia'); return; }
  if(typeof toast === 'function') toast('📊 Carregando biblioteca PPTX...');
  // Tenta múltiplos CDNs (alguns podem estar bloqueados/fora do ar)
  const cdns = [
    'https://unpkg.com/pptxgenjs@3.12.0/dist/pptxgen.bundle.js',
    'https://cdn.jsdelivr.net/npm/pptxgenjs@3.12.0/dist/pptxgen.bundle.js',
    'https://cdnjs.cloudflare.com/ajax/libs/pptxgenjs/3.11.0/pptxgen.bundle.js'
  ];
  let loaded = false;
  for(const url of cdns){
    try { await _anaLoadScript(url, 'PptxGenJS'); loaded = true; break; }
    catch(e){ console.warn('CDN falhou:', url, e); }
  }
  if(!loaded || !window.PptxGenJS){
    if(typeof toast === 'function') toast('❌ Não consegui carregar a biblioteca PPTX. Verifique sua conexão.');
    alert('Falha ao carregar a biblioteca de PowerPoint (pptxgenjs). Tentamos 3 CDNs diferentes:\n\n' + cdns.join('\n') + '\n\nVerifique se sua rede permite scripts externos.');
    return;
  }
  const PptxGenJS = window.PptxGenJS;
  if(typeof toast === 'function') toast('📊 Gerando PPTX... (pode levar alguns segundos)');
  const pres = new PptxGenJS();
  pres.layout = 'LAYOUT_WIDE'; // 13.33 x 7.5 inches (16:9)
  pres.title = p.name || 'Apresentação';
  pres.author = 'Cowork · Empréstimos TALLER';

  for(const s of slides){
    const colors = _anaLayoutColors(s.layout || 'cream-exec');
    const slide = pres.addSlide();
    // Fundo
    slide.background = { color: colors.bg.replace('#', '') };
    // Título
    const titleText = _anaHtmlToText(s.title || 'Sem título');
    slide.addText(titleText, {
      x: 0.6, y: 0.5, w: 12.13, h: 1.0,
      fontSize: 36, bold: true, color: colors.text.replace('#', ''),
      fontFace: 'Calibri', valign: 'middle', align: 'left'
    });
    // Subtítulo
    if(s.subtitle){
      const subText = _anaHtmlToText(s.subtitle);
      if(subText){
        slide.addText(subText, {
          x: 0.6, y: 1.4, w: 12.13, h: 0.5,
          fontSize: 16, color: colors.sub.replace('#', ''),
          fontFace: 'Calibri', valign: 'middle', align: 'left'
        });
      }
    }
    // Conteúdo (text widgets)
    const widgets = s.widgets || [];
    const textWidgets = widgets.filter(w => w.widget === 'text');
    const otherWidgets = widgets.filter(w => w.widget !== 'text');
    let yPos = 2.2;
    for(const w of textWidgets){
      const txt = _anaHtmlToText(w.text || '');
      if(!txt) continue;
      // Detecta formato 3-COL
      if(/^\[3-COL/i.test(txt.trim())){
        const body = txt.replace(/^\[3-COL[^\]]*\]\s*\n?/i, '');
        const cols = body.split(/\n---+\n/).slice(0, 3);
        const colW = 4.0;
        for(let ci = 0; ci < cols.length; ci++){
          const colTxt = cols[ci].trim();
          const lines = colTxt.split('\n').filter(l => l.trim());
          const colTitle = lines[0] ? lines[0].replace(/^[✓⚠◎]\s*/, '') : '';
          const colBody  = lines.slice(1).join('\n');
          const xPos = 0.6 + ci * (colW + 0.15);
          const accent = ci === 0 ? '16A34A' : ci === 1 ? 'DC2626' : '1E40AF';
          slide.addText(colTitle, {
            x: xPos, y: yPos, w: colW, h: 0.6,
            fontSize: 16, bold: true, color: accent,
            fontFace: 'Calibri', align: 'left'
          });
          slide.addText(colBody, {
            x: xPos, y: yPos + 0.7, w: colW, h: 4.0,
            fontSize: 11, color: colors.text.replace('#', ''),
            fontFace: 'Calibri', valign: 'top', align: 'left'
          });
        }
        yPos += 4.8;
      } else {
        slide.addText(txt, {
          x: 0.6, y: yPos, w: 12.13, h: 4.5,
          fontSize: 12, color: colors.text.replace('#', ''),
          fontFace: 'Calibri', valign: 'top', align: 'left'
        });
        yPos += 1.5;
      }
    }
    // Resumo dos widgets não-textuais (charts/KPIs viram caixa de texto)
    if(otherWidgets.length > 0){
      const widgetSummary = otherWidgets.map(w => '• ' + (_anaWidgetSummary(w) || '')).join('\n');
      slide.addText(widgetSummary, {
        x: 0.6, y: 6.0, w: 12.13, h: 1.2,
        fontSize: 10, color: colors.sub.replace('#', ''),
        fontFace: 'Consolas', italic: true, valign: 'top', align: 'left'
      });
    }
    // Footer com numeração
    const idx = slides.indexOf(s) + 1;
    slide.addText(idx + ' / ' + slides.length, {
      x: 11.5, y: 7.05, w: 1.5, h: 0.3,
      fontSize: 9, color: colors.sub.replace('#', ''),
      fontFace: 'Consolas', align: 'right'
    });
  }
  // Nome do arquivo
  const safeName = (p.name || 'apresentacao').replace(/[^\w\s-]/g, '').replace(/\s+/g, '_');
  try {
    const result = await pres.writeFile({ fileName: safeName + '.pptx' });
    console.log('PPTX writeFile OK:', result);
    if(typeof toast === 'function') toast('✅ PPTX baixado: ' + safeName + '.pptx');
  } catch(e){
    console.error('writeFile error:', e);
    if(typeof toast === 'function') toast('❌ Erro ao salvar: ' + (e && e.message || 'desconhecido'));
    alert('Erro ao gerar PPTX:\n' + (e && e.message || e));
  }
}

