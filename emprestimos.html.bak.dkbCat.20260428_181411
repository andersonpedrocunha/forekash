    const valHtml = (sign >= 0 ? '<span class="val-pos">' + _extFmtBRL(it.valor) + '</span>' : '<span class="val-neg">−' + _extFmtBRL(it.valor) + '</span>');
    const saldoHtml = '<span class="' + (saldoAcc < 0 ? 'saldo-neg' : '') + '">' + _extFmtBRL(saldoAcc) + '</span>';
    const effSt = _extEffStatus(it);
    const statusCls = effSt === 'pago' ? 'pago' : (effSt === 'atrasado' ? 'atraso' : 'pendente');
    const statusLbl = effSt === 'pago' ? 'Pago ✓' : (effSt === 'atrasado' ? 'Atrasado' : 'Pendente');
    const catColor = _extCatColor(it);
    let catLbl = _extEsc((it.categoria || it.tipo).slice(0, 22));
