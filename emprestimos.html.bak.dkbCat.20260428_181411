function cartSaveModal(){
  const apelido = (document.getElementById('cart-i-apelido')?.value || '').trim();
  if(!apelido){ if(typeof toast === 'function') toast('Informe um apelido'); return; }
  const bandeira = document.getElementById('cart-i-bandeira')?.value || '';
  const banco = (document.getElementById('cart-i-banco')?.value || '').trim();
  const dig = (document.getElementById('cart-i-digitos')?.value || '').replace(/\D/g,'').slice(0,4);
  const lim = parseFloat(document.getElementById('cart-i-limite')?.value) || 0;
  const fech = Math.max(1, Math.min(31, parseInt(document.getElementById('cart-i-fech')?.value, 10) || 1));
  const venc = Math.max(1, Math.min(31, parseInt(document.getElementById('cart-i-venc')?.value, 10) || 10));
  const cor = _cartPickedColor || (document.querySelector('.cart-color-opt.selected')?.style.background) || CART_COLORS[0];
  if(_cartEditingId){
    const c = cartoes.list.find(x => x.id === _cartEditingId);
    if(c){
      Object.assign(c, { apelido, bandeira, bancoEmissor:banco, ultimosDigitos:dig, limite:lim, diaFechamento:fech, diaVencimento:venc, cor });
    }
  } else {
    cartoes.list.push({
      id: cartoes.nextCartaoId++,
      apelido, bandeira, bancoEmissor: banco, ultimosDigitos: dig,
      limite: lim, diaFechamento: fech, diaVencimento: venc,
      cor: cor, ativo: true,
      criadoEm: new Date().toISOString()
    });
  }
  cartSave();
  cartCloseModal();
  renderCartoes();
  if(typeof toast === 'function') toast('✓ Cartão salvo');
}
function cartDelete(id){
  const c = cartoes.list.find(x => x.id === id);
  if(!c) return;
  // Tem faturas vinculadas?
  const temFat = cartoes.faturas.some(f => f.cartaoId === id);
  const msg = temFat ? 'Excluir o cartão "' + c.apelido + '" também removerá todas as faturas e lançamentos vinculados. Continuar?' : 'Excluir o cartão "' + c.apelido + '"?';
  if(!confirm(msg)) return;
  cartoes.list = cartoes.list.filter(x => x.id !== id);
  cartoes.faturas = cartoes.faturas.filter(f => f.cartaoId !== id);
  cartoes.lancamentos = cartoes.lancamentos.filter(l => l.cartaoId !== id);
  cartSave();
  cartCloseModal();
  if(_cartView.cartaoId === id) cartBackToList();
  else renderCartoes();
  if(typeof toast === 'function') toast('Cartão excluído');
}

// Coleta categorias visíveis no Extrato Financeiro.
// Para itens de "Estrutura", usa o nome da TAG (estrutura.tags) em vez do label "Estrutura".
function _cartCollectCategorias(){
  const set = new Set();
  try {
    if(typeof _extCollect === 'function'){
      const all = _extCollect();
      for(const it of all){
        if(it.categoria === 'Estrutura'){
          // Pega a tag do item via _extEstruturaTagOf
          let tagNome = null;
          if(typeof _extEstruturaTagOf === 'function'){
            try { const t = _extEstruturaTagOf(it); if(t && t.nome) tagNome = t.nome.trim(); } catch(_){}
          }
          if(tagNome) set.add(tagNome);
          // (sem tag: ignora — não polui o autocomplete com "Estrutura" genérico)
          continue;
        }
        const v = (it.categoria || '').trim();
        if(v) set.add(v);
      }
    }
  } catch(e){}
  // Bonus: inclui todas as tags cadastradas em Estrutura, mesmo as sem lançamento ainda
  try {
    if(typeof estrutura !== 'undefined' && estrutura && Array.isArray(estrutura.tags)){
      for(const t of estrutura.tags){
        const nm = (t.nome || '').trim();
        if(nm) set.add(nm);
      }
    }
  } catch(e){}
  return Array.from(set).sort((a,b) => a.localeCompare(b, 'pt', { sensitivity:'base' }));
}

// ─── Abrir anexo em nova aba ───
function _cartOpenAnexo(anexo){
  if(!anexo || !anexo.dataUrl){
    if(typeof toast === 'function') toast('Anexo indisponível');
    return;
  }
  try {
    // dataURL → Blob → URL.createObjectURL (mais compatível pra abrir em nova aba)
    const m = /^data:([^;]+);base64,(.*)$/.exec(anexo.dataUrl);
    if(!m){
      // Fallback direto
      window.open(anexo.dataUrl, '_blank');
      return;
    }
    const mime = m[1];
    const b64 = m[2];
    const bin = atob(b64);
    const len = bin.length;
    const bytes = new Uint8Array(len);
    for(let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
    const blob = new Blob([bytes], { type: mime });
    const url = URL.createObjectURL(blob);
    const win = window.open(url, '_blank');
    // Revoga após algum tempo (deixa a aba carregar antes)
    setTimeout(() => { try { URL.revokeObjectURL(url); } catch(e){} }, 60000);
    if(!win){
      if(typeof toast === 'function') toast('⚠ Permita pop-ups pra abrir o anexo');
    }
  } catch(e){
    console.error('Erro abrindo anexo:', e);
    if(typeof toast === 'function') toast('Erro abrindo anexo');
  }
}
function _cartOpenAnexoFat(faturaId){
