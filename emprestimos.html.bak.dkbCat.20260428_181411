}

function setEstActiveYear(y){
  if(!estrutura.years.includes(y)) return;
  estActiveYear = y;
  estSave();
  renderEstrutura();
}

async function addEstYear(){
  const current = estrutura.years.slice().sort();
  const suggested = String((parseInt(current[current.length-1])||new Date().getFullYear())+1);
  const ys = await askText({
    title: 'Adicionar ano',
    label: 'Ano',
    placeholder: 'YYYY',
    initialValue: suggested,
    confirmText: 'Adicionar',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!/^\d{4}$/.test(s)) return 'Informe um ano válido de 4 dígitos.';
      if(estrutura.years.includes(s)) return 'Esse ano já está cadastrado.';
      return null;
    }
  });
  if(!ys) return;
  estrutura.years.push(ys);
  estActiveYear = ys;
  estSave();
  renderEstrutura();
}

async function duplicateEstYear(srcYear){
  if(!estrutura.years.includes(srcYear)) return;
  const suggested = String(parseInt(srcYear)+1);
  const ys = await askText({
    title: 'Duplicar ano',
    label: 'Duplicar valores de ' + srcYear + ' para:',
    placeholder: 'YYYY',
    initialValue: suggested,
    confirmText: 'Duplicar',
    validate: (v) => {
      const s = String(v||'').trim();
      if(!/^\d{4}$/.test(s)) return 'Informe um ano válido de 4 dígitos.';
      if(s === srcYear) return 'Escolha um ano diferente.';
      return null;
    }
  });
  if(!ys) return;
  if(estrutura.years.includes(ys)){
    const ok = await showConfirm({
      title: 'Sobrescrever valores',
      message: `O ano <strong>${ys}</strong> já existe. Sobrescrever os valores atuais com os de ${srcYear}?`,
      confirmLabel: 'Sobrescrever', cancelLabel: 'Cancelar', destructive: true
    });
    if(!ok) return;
  } else {
    estrutura.years.push(ys);
  }
  for(const it of estrutura.itens){
    for(let m=0;m<12;m++){
      const srcK = estMesKey(srcYear, m);
      const dstK = estMesKey(ys, m);
      if(it.valores[srcK] !== undefined){
        it.valores[dstK] = it.valores[srcK];
      }
    }
  }
  estActiveYear = ys;
  estSave();
  renderEstrutura();
}

async function delEstYear(y){
  if(!estrutura.years.includes(y)) return;
  if(estrutura.years.length <= 1){ await showInfo({title:'Ação não permitida', message:'Não é possível excluir o único ano.', warning:true}); return; }
  const ok = await showConfirm({
    title: `Excluir ano ${y}`,
    message: `Todos os valores mensais de <strong>${y}</strong> serão removidos. Essa ação não pode ser desfeita.`,
    confirmLabel: 'Excluir ano', destructive: true
  });
  if(!ok) return;
  // Remove valores deste ano
  for(const it of estrutura.itens){
    for(let m=0;m<12;m++){
      delete it.valores[estMesKey(y, m)];
    }
  }
  estrutura.years = estrutura.years.filter(x => x !== y);
  if(estActiveYear === y) estActiveYear = estrutura.years[estrutura.years.length-1];
  estSave();
  renderEstrutura();
}

