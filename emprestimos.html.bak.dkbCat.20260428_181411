function _recKbNormalizeNotas(cell){
  if(!cell) return [];
  if(typeof cell.notas === 'string'){
    if(cell.notas.trim()){
      cell.notas = [{ ts: new Date().toISOString(), text: cell.notas.trim(), anexo: null }];
    } else {
      cell.notas = [];
    }
  } else if(!Array.isArray(cell.notas)){
    cell.notas = [];
  }
  return cell.notas;
}

