// Rubricas que aceitam alíquota personalizada (%, aplicada sobre a receita bruta)
const IMP_CUSTOM_RUBRICAS = [
  { id:'das',    label:'DAS' },
  { id:'pis',    label:'PIS' },
  { id:'cofins', label:'COFINS' },
  { id:'irpj',   label:'IRPJ' },
