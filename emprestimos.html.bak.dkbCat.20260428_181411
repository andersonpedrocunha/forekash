function openDispoBancoManager(){
  const ov = document.getElementById('ov-dispo-banco'); if(!ov) return;
  renderDispoBancoManager(); ov.classList.add('open');
}
function closeDispoBancoManager(){
  const ov = document.getElementById('ov-dispo-banco'); if(ov) ov.classList.remove('open');
}
function renderDispoBancoManager(){
  const body = document.getElementById('dispo-banco-body'); if(!body) return;
  const usage = new Map();
  for(const c of dispo.contas){ if(c.bancoId) usage.set(c.bancoId, (usage.get(c.bancoId)||0)+1); }
  const itemsHtml = dispo.bancos.map(b => {
    const logo = dispoLogoUrl(b);
    const fb   = dispoLogoFallback(b);
    const ini  = dispoBancoInitials(b);
    const logoHtml = logo
      ? `<img class="dispo-banco-logo" src="${logo}" data-fb="${fb||''}" data-ini="${esc(ini)}" data-bc="${esc(b.color||'#E5E7EB')}" onerror="dispoLogoImgFallback(this)">`
      : `<span class="dispo-banco-initials" style="background:${b.color||'#E5E7EB'}">${esc(ini)}</span>`;
    const use = usage.get(b.id) || 0;
    return `
    <div class="dispo-banco-mgr-item" data-bnc-id="${esc(b.id)}">
      <div class="dispo-banco-mgr-logo">
        ${logoHtml}
        <span class="est-mgr-swatch" style="background:${b.color||'#E5E7EB'}"
              title="Cor de destaque" onclick="toggleDispoBancoSwatch(this, '${esc(b.id)}')"></span>
      </div>
      <input class="dispo-mgr-nome-in" value="${esc(b.nome)}" placeholder="Nome do banco"
             onchange="renameDispoBanco('${esc(b.id)}', this.value)">
      <input class="dispo-mgr-sec-in" value="${esc(b.domain||'')}" placeholder="dominio.com.br"
             onchange="setDispoBancoDomain('${esc(b.id)}', this.value)"
             title="Domínio usado para buscar o logo via Clearbit">
      <span class="dispo-mgr-uses${use?'':' zero'}">${use} ${use===1?'conta':'contas'}</span>
      <button class="dispo-mgr-del" onclick="delDispoBanco('${esc(b.id)}')"
              ${use ? 'title="Banco em uso — realoque as contas antes" disabled' : 'title="Excluir banco"'}>
        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m2 0v14a2 2 0 01-2 2H8a2 2 0 01-2-2V6m4 4v8m4-8v8"/></svg>
      </button>
    </div>`;
  }).join('');
  body.innerHTML = `
    <p class="dispo-mgr-intro">
      Adicione, edite ou remova bancos que aparecem ao cadastrar uma conta. Informe o <strong>domínio</strong> (ex.: <em>itau.com.br</em>) para que o logo seja carregado automaticamente. A <strong>cor</strong> identifica o banco na planilha e é usada como fundo caso o logo não esteja disponível.
    </p>
    <div class="dispo-mgr-list">
      ${itemsHtml || '<div class="dispo-mgr-list-empty">Nenhum banco cadastrado ainda.</div>'}
    </div>
    <div class="dispo-mgr-add-row for-banco">
      <div class="dispo-banco-preview-empty">+</div>
      <input class="dispo-mgr-nome-in" id="dispo-new-bnc-nome" placeholder="Nome do novo banco"
             onkeydown="if(event.key==='Enter')addDispoBanco()">
      <input class="dispo-mgr-sec-in" id="dispo-new-bnc-domain" placeholder="dominio.com.br"
             onkeydown="if(event.key==='Enter')addDispoBanco()">
      <button class="dispo-mgr-add-btn" onclick="addDispoBanco()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        Adicionar
      </button>
    </div>`;
}
function addDispoBanco(){
  const nome   = (document.getElementById('dispo-new-bnc-nome').value || '').trim();
  const domain = (document.getElementById('dispo-new-bnc-domain').value || '').trim().toLowerCase().replace(/^https?:\/\//,'').replace(/\/.*$/,'');
  if(!nome){
    document.getElementById('dispo-new-bnc-nome').focus();
    return;
  }
  const id = dispoNextId('bancos');
  const color = DISPO_COLOR_PALETTE[dispo.bancos.length % DISPO_COLOR_PALETTE.length];
  dispo.bancos.push({ id, nome, domain: domain || null, color });
  dispoSave();
  renderDispoBancoManager();
  renderDispo();
}
function renameDispoBanco(id, nome){
  const b = dispoBanco(id); if(!b) return;
  b.nome = (nome||'').trim() || b.nome;
  dispoSave(); renderDispoBancoManager(); renderDispo();
}
function setDispoBancoDomain(id, domain){
  const b = dispoBanco(id); if(!b) return;
  const d = (domain||'').trim().toLowerCase().replace(/^https?:\/\//,'').replace(/\/.*$/,'');
  b.domain = d || null;
  dispoSave(); renderDispoBancoManager(); renderDispo();
}
function setDispoBancoColor(id, color){
  const b = dispoBanco(id); if(!b) return;
  b.color = color; dispoSave();
  document.querySelectorAll('.est-mgr-swatch-pop').forEach(p => p.remove());
  renderDispoBancoManager(); renderDispo();
}
async function delDispoBanco(id){
  const usedByDispo = dispo.contas.some(c => c.bancoId === id);
  const usedByLoan  = (typeof loans !== 'undefined' && Array.isArray(loans))
                        ? loans.some(l => l.bancoId === id) : false;
  if(usedByDispo || usedByLoan){
    toast('⚠️ Banco em uso — realoque as contas/empréstimos antes.');
    return;
  }
  const b = dispoBanco(id); if(!b) return;
  const ok = await showConfirm({
    title: 'Excluir banco',
    message: `Deseja remover o banco <strong>${esc(b.nome)}</strong> do seu registro?`,
    confirmLabel: 'Excluir', destructive: true
  });
  if(!ok) return;
  dispo.bancos = dispo.bancos.filter(x => x.id !== id);
  dispoSave(); renderDispoBancoManager(); renderDispo();
  if(typeof render === 'function') render();
}
function toggleDispoBancoSwatch(el, bncId){
  event.stopPropagation();
  const existing = el.querySelector('.est-mgr-swatch-pop');
  document.querySelectorAll('.est-mgr-swatch-pop').forEach(p => p.remove());
  if(existing) return;
  const pop = document.createElement('div');
  pop.className = 'est-mgr-swatch-pop';
  pop.innerHTML = DISPO_COLOR_PALETTE.map(c =>
    `<div class="est-mgr-swatch-sw" style="background:${c}"
          onclick="event.stopPropagation();setDispoBancoColor('${esc(bncId)}','${c}')"></div>`
