// ─── Multi-select genérico (Descrição / Cliente) ───
// Coleta valores únicos do dataset atual (já passado pelo período/contas/etc seria bom mas mantemos amplo)
function _extUniqueValues(items, getter){
  const seen = new Set();
  const out = [];
  for(const it of items){
    const v = (getter(it) || '').trim();
    if(!v) continue;
    if(seen.has(v)) continue;
    seen.add(v);
    out.push(v);
  }
  out.sort((a,b) => a.localeCompare(b, 'pt', { sensitivity:'base' }));
  return out;
}
