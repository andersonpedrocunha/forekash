// Apaga todos os registros de fontes (manual, estrutura, receita) com mesmo grupoId+data
function _extDeleteGroup(grupoId, data){
  if(!grupoId || !data) return 0;
  let removed = 0;
  // 1) Manuais
  try {
    if(typeof extratoData !== 'undefined' && extratoData && Array.isArray(extratoData.lancamentos)){
      const before = extratoData.lancamentos.length;
      extratoData.lancamentos = extratoData.lancamentos.filter(l => !(l && l.grupoId === grupoId && l.data === data));
      removed += (before - extratoData.lancamentos.length);
      if(typeof _extSave === 'function') _extSave();
    }
  } catch(e){ console.warn('_extDeleteGroup/manual:', e); }
  // 2) Estrutura (cells em item.meta[ym] com grupoId)
  try {
    const m = /^(\d{4})-(\d{2})-/.exec(data);
    const ym = m ? (m[1] + '-' + m[2]) : null;
    if(ym && typeof estrutura !== 'undefined' && estrutura && Array.isArray(estrutura.itens)){
      for(const item of estrutura.itens){
        const cellMeta = item.meta && item.meta[ym];
        if(cellMeta && cellMeta.grupoId === grupoId){
          if(item.valores) delete item.valores[ym];
          if(item.meta)    delete item.meta[ym];
          if(item.pagos)   delete item.pagos[ym];
          removed++;
        }
      }
      // Remove itens órfãos (sem nenhum mês com valor)
      estrutura.itens = estrutura.itens.filter(item => {
        const ks = Object.keys(item.valores || {});
        for(const k of ks){
          const v = parseFloat(item.valores[k]);
          if(isFinite(v) && v !== 0) return true;
        }
        return false;
      });
      if(typeof estSave === 'function') estSave();
    }
  } catch(e){ console.warn('_extDeleteGroup/estrutura:', e); }
  // 3) Receita (cells em row.meses[mAbbr] com grupoId)
  try {
    const m = /^(\d{4})-(\d{2})-/.exec(data);
    if(m && typeof receita !== 'undefined' && receita && receita.years){
      const y = parseInt(m[1], 10);
      const mIdx = parseInt(m[2], 10) - 1;
      const meses_lower = (typeof REC_MESES !== 'undefined') ? REC_MESES : ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
      const mAbbr = meses_lower[mIdx];
      const yData = receita.years[y];
      if(yData && Array.isArray(yData.clients)){
        for(const r of yData.clients){
          const cell = r.meses && r.meses[mAbbr];
          if(cell && cell.grupoId === grupoId){
            delete r.meses[mAbbr];
            removed++;
          }
        }
      }
      if(typeof receitaSave === 'function') receitaSave();
    }
  } catch(e){ console.warn('_extDeleteGroup/receita:', e); }
  return removed;
}
