  if(snap.receita){
    msg += `<li><b>Receita</b>: ${snap.receita.clientesAtivos||0} cliente${snap.receita.clientesAtivos===1?'':'s'} ativo${snap.receita.clientesAtivos===1?'':'s'}, ${fmtBRL(snap.receita.anual)} previsto no ano</li>`;
  }
  // Pessoas
  if(snap.pessoas){
    msg += `<li><b>Pessoas</b>: ${snap.pessoas.headcount||0} colaborador${snap.pessoas.headcount===1?'':'es'}, folha anual ${fmtBRL(snap.pessoas.folhaAno||0)}</li>`;
  }
  // Estrutura
  if(snap.estrutura){
