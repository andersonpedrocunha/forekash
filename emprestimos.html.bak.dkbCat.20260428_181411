// ═══ APROVAÇÃO COM ASSINATURA (ClickSign-like) ═══
let _viagApprovalContext = null;

// SHA-256 (Web Crypto API nativa — não vai pra servidor)
async function _viagComputeHash(payload){
  const enc = new TextEncoder().encode(payload);
  const buf = await crypto.subtle.digest('SHA-256', enc);
  const arr = Array.from(new Uint8Array(buf));
  return arr.map(b => b.toString(16).padStart(2, '0')).join('');
}
// Código curto legível derivado dos primeiros 9 chars do hash (~16M combinações)
function _viagShortCode(hash){
  const hex = (hash || '').toUpperCase();
  const slice = hex.slice(0, 9);
  return slice.slice(0,3) + '-' + slice.slice(3,6) + '-' + slice.slice(6,9);
}
// Recalcula hash a partir do conteúdo da aprovação pra verificação
async function viagVerificarRejeicao(viagemId){
  const v = viagens.itens.find(x => x.id === viagemId);
  if(!v || !v.rejeicao || !v.rejeicao.hash){ if(typeof toast === 'function') toast('Sem assinatura registrada'); return; }
  const r = v.rejeicao;
  const payload = (r.assinatura || '') + '|' + (r.por || '') + '|' + (r.motivo || '') + '|' + (r.data || '') + '|' + v.id + '|' + (v.titulo || '');
  const recomputed = await _viagComputeHash(payload);
  if(recomputed === r.hash){
    if(typeof toast === 'function') toast('✅ Assinatura íntegra · código ' + (r.codigo || _viagShortCode(r.hash)));
  } else {
    if(typeof toast === 'function') toast('⚠ Assinatura alterada — hash não bate!');
    if(typeof alert === 'function') alert('⚠ ATENÇÃO\n\nO hash recalculado não bate com o salvo da rejeição.\n\nHash salvo:\n' + r.hash + '\n\nHash recalculado:\n' + recomputed);
  }
}
