function _bdAddAttachments(input){
  const c = board.cards.find(x => x.id === _bdEditId);
  if(!c) return;
  if(!Array.isArray(c.attachments)) c.attachments = [];
  const files = Array.from(input.files || []);
  let errors = 0, processed = 0;
  files.forEach(file => {
    if(file.size > 1024 * 1024){ errors++; return; }
    const reader = new FileReader();
    reader.onload = (e) => {
      c.attachments.push({
        id: 'a' + Date.now() + Math.random().toString(36).slice(2,6),
        name: file.name, type: file.type, size: file.size,
        dataUrl: e.target.result,
        addedAt: new Date().toISOString()
      });
      processed++;
      bdSave();
      document.getElementById('bd-att-list').innerHTML = _bdRenderAttachments(c);
    };
    reader.readAsDataURL(file);
  });
  if(errors > 0 && typeof toast === 'function') toast('⚠ ' + errors + ' arquivo(s) ignorado(s) — máx 1MB cada');
  input.value = '';
}
