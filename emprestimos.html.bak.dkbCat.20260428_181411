}
function _anaRenderUserGal(){
  _anaInitSavedStores();
  const body = document.getElementById('ana-user-gal-body');
  if(!body) return;
  const presets = _anaState.userPresets;
  const slidesNow = (_anaState.presentation.slides || []).length;
  const canSaveNow = slidesNow > 0;
  const atLimit = presets.length >= ANA_USER_GAL_LIMIT;
  let html = '<div class="ana-saved-toolbar">'
    + '<input type="text" id="ana-user-gal-name" placeholder="Nome da apresentação..." maxlength="60"'
    + (canSaveNow && !atLimit ? '' : ' disabled')
    + ' onkeypress="if(event.key===\'Enter\') anaUserGalSaveCurrent()">'
    + '<button onclick="anaUserGalSaveCurrent()"'
    + (canSaveNow && !atLimit ? '' : ' disabled')
    + '>💾 Salvar atual</button>'
    + '<span class="ana-saved-info">' + presets.length + ' / ' + ANA_USER_GAL_LIMIT + '</span>'
    + '</div>';
  if(atLimit){
    html += '<div style="padding:10px 14px;background:#FEF3C7;border-left:3px solid #F59E0B;border-radius:6px;font-size:.82rem;color:#92400E;margin-bottom:14px">'
      + '⚠ Galeria cheia (' + ANA_USER_GAL_LIMIT + ' slots). Apague algum pra liberar espaço, ou use o <strong>Arquivo</strong> que não tem limite.'
      + '</div>';
  } else if(!canSaveNow){
    html += '<div style="padding:10px 14px;background:#F1F5F9;border-radius:6px;font-size:.82rem;color:#64748B;margin-bottom:14px">Adicione slides à apresentação atual antes de salvar.</div>';
  }
  if(presets.length === 0){
    html += '<div class="ana-saved-empty"><span class="ana-saved-empty-icon">💾</span>Nenhuma apresentação salva ainda</div>';
  } else {
    html += '<div class="ana-saved-grid">'
      + presets.map(p =>
          '<div class="ana-saved-card">'
        +   '<div class="ana-saved-card-name">' + esc(p.name) + '</div>'
        +   '<div class="ana-saved-card-meta">' + (p.slides ? p.slides.length : 0) + ' slides · ' + _anaFmtSavedAt(p.savedAt) + '</div>'
        +   '<div class="ana-saved-card-preview">' + esc(_anaPreviewText(p.slides)) + '</div>'
        +   '<div class="ana-saved-card-actions">'
        +     '<button class="btn-restore" onclick="anaUserGalRestore(\'' + p.id + '\')">↻ Carregar</button>'
        +     '<button class="btn-delete" onclick="anaUserGalDelete(\'' + p.id + '\')" title="Excluir">🗑</button>'
        +   '</div>'
        + '</div>'
        ).join('')
      + '</div>';
  }
  body.innerHTML = html;
}
function anaUserGalSaveCurrent(){
  _anaInitSavedStores();
  const slides = _anaState.presentation.slides || [];
  if(slides.length === 0){ if(typeof toast === 'function') toast('Nada pra salvar — apresentação vazia'); return; }
  if(_anaState.userPresets.length >= ANA_USER_GAL_LIMIT){
    if(typeof toast === 'function') toast('Galeria cheia. Apague um slot ou use o Arquivo.');
    return;
  }
  const inp = document.getElementById('ana-user-gal-name');
  let name = inp ? inp.value.trim() : '';
  if(!name) name = 'Apresentação ' + new Date().toLocaleDateString('pt-BR');
  _anaState.userPresets.push({
    id: 'ug_' + Date.now(), name: name, savedAt: Date.now(),
    slides: _anaCloneSlides()
  });
  _anaSaveState();
  _anaRenderUserGal();
  if(typeof toast === 'function') toast('💾 Salvo na galeria como "' + name + '"');
}
function anaUserGalRestore(id){
  _anaInitSavedStores();
  const p = _anaState.userPresets.find(x => x.id === id);
  if(!p) return;
  anaConfirm({
    eyebrow: 'Carregar da galeria',
    title: 'Substituir apresentação atual?',
    message: 'A apresentação atual será <strong>substituída</strong> por "' + esc(p.name) + '" (' + (p.slides ? p.slides.length : 0) + ' slides). Os slides atuais serão perdidos — salve antes se quiser preservar.',
    okText: 'Sim, carregar',
    cancelText: 'Cancelar'
  }, function(){
    _anaState.presentation.slides = JSON.parse(JSON.stringify(p.slides || []));
    _anaState.presentation.currentId = (_anaState.presentation.slides[0] && _anaState.presentation.slides[0].id) || null;
    let maxId = 0, maxWid = 0;
    for(const s of _anaState.presentation.slides){
      if(s.id > maxId) maxId = s.id;
      for(const w of (s.widgets || [])) if(w.id > maxWid) maxWid = w.id;
    }
    _anaSlideNextId = maxId + 1;
    _anaSlideWidgetNextId = maxWid + 1;
    _anaSaveState();
    anaUserGalClose();
    _anaRenderPresent();
    if(typeof toast === 'function') toast('↻ "' + p.name + '" carregada');
  });
}
function anaUserGalDelete(id){
  _anaInitSavedStores();
  const p = _anaState.userPresets.find(x => x.id === id);
  if(!p) return;
  anaConfirm({
    eyebrow: 'Excluir da galeria',
    title: 'Apagar "' + p.name + '"?',
    message: 'Esta apresentação será removida da galeria. Esta ação não pode ser desfeita.',
    okText: 'Apagar',
    cancelText: 'Manter',
    danger: true
  }, function(){
    _anaState.userPresets = _anaState.userPresets.filter(x => x.id !== id);
    _anaSaveState();
    _anaRenderUserGal();
    if(typeof toast === 'function') toast('Slot liberado');
  });
}

