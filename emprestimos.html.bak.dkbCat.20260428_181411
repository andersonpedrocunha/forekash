// ─── Validação de chave PIX ───
// Tipos: cpf, cnpj, email, telefone, aleatoria
function _fcardDetectPix(raw){
  const v = String(raw||'').trim();
  if(!v) return { type:'empty', valid:false, label:'Sem chave', formatted:'' };
  // E-mail
  if(/@/.test(v)){
    const ok = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/.test(v);
    return { type:'email', valid: ok, label: ok ? 'E-mail válido' : 'E-mail inválido', formatted: v.toLowerCase() };
  }
  const onlyDigits = v.replace(/\D/g,'');
  // Aleatória (UUID): 32 hex com hífens
  if(/^[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}$/i.test(v)){
    const norm = v.replace(/-/g,'').toLowerCase();
    const fmt = norm.replace(/^(.{8})(.{4})(.{4})(.{4})(.{12})$/, '$1-$2-$3-$4-$5');
    return { type:'aleatoria', valid: true, label:'Chave aleatória válida', formatted: fmt };
  }
  // CNPJ (14 dígitos)
  if(onlyDigits.length === 14){
    const ok = _validateCNPJ(onlyDigits);
    const fmt = onlyDigits.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5');
    return { type:'cnpj', valid: ok, label: ok ? 'CNPJ válido' : 'CNPJ inválido (DV incorreto)', formatted: fmt };
  }
  // CPF (11 dígitos)
  if(onlyDigits.length === 11){
    const ok = _validateCPF(onlyDigits);
    const fmt = onlyDigits.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/, '$1.$2.$3-$4');
    return { type:'cpf', valid: ok, label: ok ? 'CPF válido' : 'CPF inválido (DV incorreto)', formatted: fmt };
  }
  // Telefone — formato +55 + DDD + número
  // Aceita: +5511999990000, 5511999990000, 11999990000, (11) 99999-0000
  if(onlyDigits.length === 13 && onlyDigits.startsWith('55')){
    const fmt = '+' + onlyDigits.slice(0,2) + ' (' + onlyDigits.slice(2,4) + ') ' + onlyDigits.slice(4,9) + '-' + onlyDigits.slice(9);
    return { type:'telefone', valid: true, label:'Telefone válido (BR +55)', formatted: fmt };
  }
  if(onlyDigits.length === 11 && /^\d{2}9/.test(onlyDigits)){
    // 11 dígitos sem código país, começa com DDD + 9 (móvel)
    const fmt = '+55 (' + onlyDigits.slice(0,2) + ') ' + onlyDigits.slice(2,7) + '-' + onlyDigits.slice(7);
    return { type:'telefone', valid: true, label:'Telefone válido (BR)', formatted: fmt };
  }
  if(onlyDigits.length === 10){
    // Telefone fixo (DDD + 8)
    const fmt = '+55 (' + onlyDigits.slice(0,2) + ') ' + onlyDigits.slice(2,6) + '-' + onlyDigits.slice(6);
    return { type:'telefone', valid: true, label:'Telefone fixo (BR)', formatted: fmt };
  }
  return { type:'unknown', valid:false, label:'Formato não reconhecido', formatted: v };
}
function _validateCPF(cpf){
  cpf = String(cpf).replace(/\D/g,'');
  if(cpf.length !== 11) return false;
  if(/^(\d)\1{10}$/.test(cpf)) return false; // todos iguais
  let sum = 0;
  for(let i = 0; i < 9; i++) sum += parseInt(cpf[i]) * (10 - i);
  let d = (sum * 10) % 11;
  if(d === 10) d = 0;
  if(d !== parseInt(cpf[9])) return false;
  sum = 0;
  for(let i = 0; i < 10; i++) sum += parseInt(cpf[i]) * (11 - i);
  d = (sum * 10) % 11;
  if(d === 10) d = 0;
  return d === parseInt(cpf[10]);
}
function _validateCNPJ(cnpj){
  cnpj = String(cnpj).replace(/\D/g,'');
  if(cnpj.length !== 14) return false;
  if(/^(\d)\1{13}$/.test(cnpj)) return false;
  const calc = (digs, len) => {
    const w = len === 12 ? [5,4,3,2,9,8,7,6,5,4,3,2] : [6,5,4,3,2,9,8,7,6,5,4,3,2];
    let s = 0;
    for(let i = 0; i < len; i++) s += parseInt(digs[i]) * w[i];
    const r = s % 11;
    return r < 2 ? 0 : 11 - r;
  };
  const d1 = calc(cnpj, 12);
  if(d1 !== parseInt(cnpj[12])) return false;
  const d2 = calc(cnpj, 13);
  return d2 === parseInt(cnpj[13]);
}
function _fcardValidatePix(applyFormat){
  const inp = document.getElementById('fcard-bp-pix');
  const ico = document.getElementById('fcard-pix-icon');
  const info = document.getElementById('fcard-pix-info');
  if(!inp) return;
  const det = _fcardDetectPix(inp.value);
  // Ícone do tipo
  const iconMap = {
    cpf: '🧑', cnpj: '🏢', email: '✉️', telefone: '📱', aleatoria: '🔑',
    empty: '', unknown: '❓'
  };
  if(ico){
    if(det.type === 'empty'){
      ico.textContent = '';
    } else if(det.valid){
      ico.textContent = '✓';
      ico.style.color = '#16A34A';
      ico.style.fontWeight = '900';
    } else {
      ico.textContent = '⚠';
      ico.style.color = '#DC2626';
      ico.style.fontWeight = '900';
    }
  }
  if(info){
    if(det.type === 'empty'){
      info.innerHTML = '';
    } else {
      const cls = det.valid ? 'ok' : (det.type === 'unknown' ? 'err' : 'err');
      const tipoLabel = ({
        cpf:'CPF', cnpj:'CNPJ', email:'E-mail', telefone:'Telefone', aleatoria:'Aleatória', unknown:'?'
      })[det.type] || '';
      info.innerHTML = '<span class="fcard-pix-info ' + cls + '">' + (iconMap[det.type] || '') + ' ' + tipoLabel + (tipoLabel ? ' · ' : '') + _fcardEsc(det.label) + '</span>';
    }
  }
  // Aplica formatação ao perder foco se válido
  if(applyFormat && det.valid && det.formatted && inp.value !== det.formatted){
    inp.value = det.formatted;
  }
}

