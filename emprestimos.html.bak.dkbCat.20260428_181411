const CATMAP_KEY = 'forekash:catmap:v1';
let catmapData = { categorias: [], nextId: 1 };
let _catmapEditingId = null;

// Lista canônica de módulos do app que fazem sentido como CATEGORIA.
// Estrutura e Impostos são decompostos (tags / rubricas) — não viram categoria direto.
// Removidos: Cartões, Disponibilidades, Fluxo de Caixa, Orçamento, Outros (são views/planejamento).
const CATMAP_MODULOS = [
  { id: 'receita',     nome: 'Receita' },
  { id: 'estrutura',   nome: 'Estrutura' },
  { id: 'pessoas',     nome: 'Folha (Pessoas)' },
  { id: 'emprestimos', nome: 'Empréstimos' },
  { id: 'impostos',    nome: 'Impostos' },
  { id: 'comissoes',   nome: 'Comissões' },
  { id: 'outrasRec',   nome: 'Outras Receitas' },
  { id: 'outrasDesp',  nome: 'Outras Despesas' },
  { id: 'extrato',     nome: 'Apenas Extrato' }
];

// Nomes ignorados no discovery (case-insensitive). Usado pra filtrar tags
// criadas por engano ou que não devem virar categoria.
const CATMAP_NOME_BLACKLIST = ['abc'];

function catmapModuloNome(id){
  const m = CATMAP_MODULOS.find(x => x.id === id);
  return m ? m.nome : '';
}

// Lê linhas do DRC (default + custom de flxStruct.custom)
function _catmapLinhasDRC(){
  const out = [];
  try {
    if(typeof _FLX_LINES_DRC !== 'undefined' && Array.isArray(_FLX_LINES_DRC)){
      for(const ln of _FLX_LINES_DRC){
        let label = ln.def;
        try {
          if(typeof flxStruct !== 'undefined' && flxStruct && flxStruct.drc && flxStruct.drc.labels && flxStruct.drc.labels[ln.id]){
            label = flxStruct.drc.labels[ln.id];
          }
        } catch(_){}
        out.push({ id: ln.id, nome: label });
      }
    }
    // Linhas customizadas (secao 'drc')
    if(typeof flxStruct !== 'undefined' && flxStruct && Array.isArray(flxStruct.custom)){
      for(const c of flxStruct.custom){
        if(c && c.secao === 'drc') out.push({ id: 'custom:' + c.id, nome: (c.nome || '(sem nome)') + ' (custom)' });
      }
    }
  } catch(e){ console.warn('catmap/linhasDRC:', e); }
  return out;
}

function _catmapLinhasDRE(){
  const out = [];
  try {
    if(typeof _FLX_LINES_DRE !== 'undefined' && Array.isArray(_FLX_LINES_DRE)){
      for(const ln of _FLX_LINES_DRE){
        let label = ln.def;
        try {
          if(typeof flxStruct !== 'undefined' && flxStruct && flxStruct.dre && flxStruct.dre.labels && flxStruct.dre.labels[ln.id]){
            label = flxStruct.dre.labels[ln.id];
          }
        } catch(_){}
        out.push({ id: ln.id, nome: label });
      }
    }
    if(typeof flxStruct !== 'undefined' && flxStruct && Array.isArray(flxStruct.custom)){
      for(const c of flxStruct.custom){
        if(c && c.secao === 'dre') out.push({ id: 'custom:' + c.id, nome: (c.nome || '(sem nome)') + ' (custom)' });
      }
    }
  } catch(e){ console.warn('catmap/linhasDRE:', e); }
  return out;
}

function catmapDRCNome(id){
  const ls = _catmapLinhasDRC();
  const m = ls.find(x => x.id === id);
  return m ? m.nome : '';
}
function catmapDRENome(id){
