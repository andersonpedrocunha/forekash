}
function addEstTipo(){
  const inp = document.getElementById('est-new-tipo-nome');
  const nome = (inp?.value||'').trim();
  if(!nome) return;
  const color = EST_COLOR_PALETTE[(estrutura.tipos.length + 8) % EST_COLOR_PALETTE.length];
  estrutura.tipos.push({ id: estNextTipoId(), nome, color });
