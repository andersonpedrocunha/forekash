// Extrator de taxa de juros de contrato PDF (via PDF.js)
// ═══════════════════════════════════════════════════════════════════════════
// Extrai o texto de um PDF (dataURL base64) usando PDF.js.
async function _extractPdfText(dataUrl){
  if(typeof pdfjsLib === 'undefined') throw new Error('PDF.js não carregado');
  if(!dataUrl || !dataUrl.startsWith('data:')) throw new Error('Anexo inválido');
  const base64 = dataUrl.split(',')[1] || '';
  const bin = atob(base64);
  const bytes = new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++) bytes[i] = bin.charCodeAt(i);
  const pdf = await pdfjsLib.getDocument({ data: bytes }).promise;
  let text = '';
  for(let i=1;i<=pdf.numPages;i++){
    const page = await pdf.getPage(i);
    const content = await page.getTextContent();
    text += content.items.map(it => it.str).join(' ') + '\n';
  }
  return text;
}

// Busca a Meta Selic anualizada atual na API do BACEN (série 432).
// Retorna { selicAnual:Number, data:String, fonte:'BACEN' } ou throw.
async function fetchSelicAnual(){
  const url = 'https://api.bcb.gov.br/dados/serie/bcdata.sgs.432/dados/ultimos/1?formato=json';
  const resp = await fetch(url, { method:'GET' });
  if(!resp.ok) throw new Error('BACEN retornou ' + resp.status);
  const arr = await resp.json();
  if(!Array.isArray(arr) || arr.length === 0) throw new Error('BACEN sem dados');
  const last = arr[arr.length - 1];
  const selic = parseFloat(String(last.valor || '').replace(',','.'));
  if(!isFinite(selic) || selic <= 0) throw new Error('Selic inválida');
  return { selicAnual: selic, data: last.data || '', fonte: 'BACEN (SGS-432)' };
}

// Procura candidatos de taxa de juros no texto do contrato.
// Retorna [{rate, unit:'a.m.'|'a.a.', rateMensalEquiv, context, matchStart}]
function _findTaxaCandidates(text){
  const out = [];
  const norm = text.replace(/\s+/g,' ');
  const lower = norm.toLowerCase();

  // Padrão 1: X,XX% a.m. / ao mês / mensal
  const reM = /(\d{1,2}(?:[.,]\d{1,5})?)\s*%\s*(?:a\.?\s*m\.?|ao\s*m[eê]s|mensal|\/m\b|per\s*m[eê]s|mensalmente)/gi;
  // Padrão 2: X,XX% a.a. / ao ano / anual
  const reA = /(\d{1,3}(?:[.,]\d{1,5})?)\s*%\s*(?:a\.?\s*a\.?|ao\s*ano|anual|\/a\b|per\s*ano|anualmente)/gi;
  // Padrão 3: CET (Custo Efetivo Total): X,XX% a.m. ou a.a.
  const reCET = /cet[^%]{0,50}?(\d{1,3}(?:[.,]\d{1,5})?)\s*%\s*(a\.?\s*[am]\.?|ao\s*m[eê]s|ao\s*ano|mensal|anual)/gi;
  // Padrão 4: Taxa Selic + X% a.a. (PRONAMPE, BNDES, etc.)
  //   Aceita: "Selic + 6%", "Selic ... acrescida de 6%", "Selic mais 6%", "Selic + sobretaxa de 6%"
  const reSelic = /selic[\s\S]{0,180}?(?:\+|acrescid[oa]s?(?:\s+d[aoe])?|mais|somad[oa])\s*(?:a\s+)?(?:sobretaxa\s+(?:efetiva\s+)?(?:de\s+)?)?(\d{1,3}(?:[.,]\d{1,5})?)\s*%\s*(?:a\.?\s*a\.?|ao\s*ano|anual)/gi;

  const extractContext = (pos, len) => {
    const start = Math.max(0, pos - 120);
    const end = Math.min(norm.length, pos + len + 60);
    let ctx = norm.slice(start, end).trim();
    if(start > 0) ctx = '…' + ctx;
    if(end < norm.length) ctx = ctx + '…';
    return ctx;
  };

  let m;
  // Mensal
  while((m = reM.exec(norm)) !== null){
    const raw = m[1].replace('.',',');
    const rate = parseFloat(raw.replace(',','.'));
    if(isFinite(rate) && rate > 0 && rate < 50){
      out.push({ rate, unit:'a.m.', rateMensalEquiv:rate, context: extractContext(m.index, m[0].length), hit: m[0], source:'mensal' });
    }
  }
  // Anual → converte pra mensal equivalente
  while((m = reA.exec(norm)) !== null){
    const rate = parseFloat(m[1].replace(',','.'));
    if(isFinite(rate) && rate > 0 && rate < 500){
      const eq = (Math.pow(1 + rate/100, 1/12) - 1) * 100;
      out.push({ rate, unit:'a.a.', rateMensalEquiv:eq, context: extractContext(m.index, m[0].length), hit: m[0], source:'anual' });
    }
  }
  // CET
  while((m = reCET.exec(norm)) !== null){
    const rate = parseFloat(m[1].replace(',','.'));
    const unitRaw = (m[2]||'').toLowerCase();
    const isMensal = /m/.test(unitRaw) && !/anual/.test(unitRaw) && !/\ba/.test(unitRaw.replace(/a\./,''));
    const unit = isMensal ? 'a.m.' : 'a.a.';
    const eq = unit === 'a.m.' ? rate : ((Math.pow(1 + rate/100, 1/12) - 1) * 100);
    if(isFinite(rate) && rate > 0 && rate < 500){
      out.push({ rate, unit, rateMensalEquiv:eq, context: extractContext(m.index, m[0].length), hit: m[0], source:'CET' });
    }
  }
  // Selic + spread
  while((m = reSelic.exec(norm)) !== null){
    const spread = parseFloat(m[1].replace(',','.'));
    if(isFinite(spread) && spread >= 0 && spread < 50){
      // Ainda não temos a Selic atual — deixamos como "pendente", o modal resolve depois.
      out.push({
        spread,
        unit: 'a.a.',
        source: 'selic+spread',
        needsSelic: true,
        context: extractContext(m.index, m[0].length),
        hit: m[0]
      });
    }
  }

  // Dedup: mesma taxa + mesma unidade em contextos quase idênticos
  const seen = new Set();
  const dedup = [];
  for(const c of out){
    const key = (c.source === 'selic+spread')
      ? 'selic+' + c.spread + '|' + (c.context||'').slice(0,40)
      : c.rate + '|' + c.unit + '|' + (c.context||'').slice(0,40);
    if(!seen.has(key)){ seen.add(key); dedup.push(c); }
  }
  // Ordena: Selic+spread primeiro (mais específico), depois CET, mensal, anual
  const order = { 'selic+spread':0, 'CET':1, 'mensal':2, 'anual':3 };
  dedup.sort((a,b) => (order[a.source]??99) - (order[b.source]??99));
  return dedup;
}

async function extractTaxaFromContrato(loanId){
  const loan = loans.find(l => l.id === loanId);
  if(!loan){ try { toast('Empréstimo não encontrado'); } catch(e){} return; }
  if(!loan.contratos || loan.contratos.length === 0){
    try { toast('Nenhum contrato anexado neste empréstimo'); } catch(e){}
    return;
  }
  _openTaxaModalLoading(loanId);
  try {
    // Extrai texto de TODOS os contratos anexados
    let allText = '';
    const sources = [];
    for(const c of loan.contratos){
      if(!c.data || !/\.pdf$/i.test(c.name) && c.type !== 'application/pdf') continue;
      try {
        const t = await _extractPdfText(c.data);
        allText += '\n\n=== ' + (c.name||'contrato') + ' ===\n' + t;
        sources.push(c.name || 'contrato.pdf');
      } catch(e){
        console.error('Erro ao ler', c.name, e);
      }
    }
    if(!allText.trim()){
      _renderTaxaModalEmpty(loanId, 'Não consegui extrair texto dos anexos. Pode ser um PDF escaneado (imagem) — nesse caso, preencha a taxa manualmente.');
      return;
    }
    const candidates = _findTaxaCandidates(allText);
    if(candidates.length === 0){
      _renderTaxaModalEmpty(loanId, 'Texto extraído (' + allText.length + ' caracteres), mas nenhuma taxa encontrada com os padrões "X,XX% a.m./a.a.". Verifique o contrato ou preencha manualmente.');
      return;
    }
    // Se algum candidato for Selic+spread, busca a Selic atual no BACEN
    const needsSelic = candidates.some(c => c.needsSelic);
    if(needsSelic){
      const bd = document.querySelector('#taxa-modal-ov .taxa-modal-bd');
      if(bd) bd.innerHTML = '<div class="taxa-modal-loading"><div class="spinner"></div>Buscando <b>Meta Selic</b> atual no BACEN…</div>';
      try {
        const info = await fetchSelicAnual();
        for(const c of candidates){
          if(c.needsSelic){
            const total = info.selicAnual + c.spread;
            c.rate = total;
            c.unit = 'a.a.';
            c.rateMensalEquiv = (Math.pow(1 + total/100, 1/12) - 1) * 100;
            c.selicUsada = info;
            c.needsSelic = false;
          }
        }
      } catch(e){
        for(const c of candidates){
          if(c.needsSelic) c.selicError = e.message || 'Selic indisponível';
        }
      }
    }
    _renderTaxaModalCandidates(loanId, candidates, sources);
  } catch(e){
    _renderTaxaModalEmpty(loanId, 'Erro ao processar o contrato: ' + e.message);
  }
}

function _openTaxaModalLoading(loanId){
  closeTaxaModal();
  const ov = document.createElement('div');
  ov.className = 'taxa-modal-ov';
  ov.id = 'taxa-modal-ov';
  const loan = loans.find(l => l.id === loanId);
  const nome = loan ? ((loan.banco||'Empréstimo') + (loan.descricao ? ' — '+loan.descricao : '')) : 'Empréstimo';
  ov.innerHTML =
    '<div class="taxa-modal" role="dialog" aria-modal="true">'+
      '<div class="taxa-modal-hd">'+
        '<div><h3 class="taxa-modal-ttl">Buscar taxa no contrato<small>'+esc(nome)+'</small></h3></div>'+
        '<button class="taxa-modal-close" onclick="closeTaxaModal()" aria-label="Fechar">×</button>'+
      '</div>'+
      '<div class="taxa-modal-bd"><div class="taxa-modal-loading"><div class="spinner"></div>Lendo PDF e buscando taxas…</div></div>'+
    '</div>';
  document.body.appendChild(ov);
  ov.addEventListener('click', e => { if(e.target === ov) closeTaxaModal(); });
  document.addEventListener('keydown', _taxaModalKey, true);
}
function closeTaxaModal(){
  const ov = document.getElementById('taxa-modal-ov');
  if(ov) ov.remove();
  document.removeEventListener('keydown', _taxaModalKey, true);
}
function _taxaModalKey(e){ if(e.key === 'Escape'){ closeTaxaModal(); } }

function _renderTaxaModalCandidates(loanId, candidates, sources){
  const bd = document.querySelector('#taxa-modal-ov .taxa-modal-bd');
  if(!bd) return;
  const fmtPct = n => n.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:4}) + '%';
  const html = [];
  html.push('<p style="font-size:.72rem;color:var(--txl);margin:0 0 12px">Encontrei ' + candidates.length + ' candidato' + (candidates.length>1?'s':'') + '. Clique em um pra aplicar na coluna Juros. Use o contexto pra confirmar qual é a taxa certa.</p>');
  for(const c of candidates){
    const ctx = esc(c.context||'').replace(esc(c.hit||''), '<span class="hit">'+esc(c.hit||'')+'</span>');
    // Candidato Selic+spread com erro de fetch: bloqueia clique e mostra mensagem
    if(c.source === 'selic+spread' && c.selicError){
      html.push(
        '<div class="taxa-candidate" style="opacity:.65;cursor:not-allowed" title="Selic indisponível">'+
          '<div class="taxa-candidate-val" style="color:#9CA3AF">Selic + '+fmtPct(c.spread)+'<span class="eq" style="color:#DC2626">⚠ '+esc(c.selicError)+'</span></div>'+
          '<div class="taxa-candidate-ctx">'+ctx+'<span class="src">fonte: Selic + spread (BACEN off)</span></div>'+
        '</div>'
      );
      continue;
    }
    // Candidato Selic+spread resolvido: mostra cálculo detalhado
    if(c.source === 'selic+spread' && c.selicUsada){
      const si = c.selicUsada;
      const siStr = fmtPct(si.selicAnual) + ' a.a.';
      const spStr = fmtPct(c.spread) + ' a.a.';
      const totStr = fmtPct(c.rate) + ' a.a.';
      const eqStr = fmtPct(c.rateMensalEquiv) + ' a.m.';
      html.push(
        '<div class="taxa-candidate" onclick="_taxaApplyCandidate('+loanId+', '+c.rateMensalEquiv.toFixed(6)+')">'+
          '<div class="taxa-candidate-val">'+totStr+'<span class="eq">≈ '+eqStr+'</span></div>'+
          '<div class="taxa-candidate-ctx">'+
            '<div style="font-weight:700;color:#0F172A;margin-bottom:3px">Selic <b>'+siStr+'</b> + spread <b>'+spStr+'</b> = <b>'+totStr+'</b></div>'+
            ctx+
            '<span class="src">fonte: '+esc(si.fonte)+' · '+esc(si.data)+'</span>'+
          '</div>'+
        '</div>'
      );
      continue;
    }
    // Candidatos normais (mensal / anual / CET)
    const eq = (c.unit === 'a.a.') ? '<span class="eq">≈ '+fmtPct(c.rateMensalEquiv)+' a.m.</span>' : '';
    const origStr = (c.unit === 'a.a.') ? fmtPct(c.rate) + ' a.a.' : fmtPct(c.rate) + ' a.m.';
    html.push(
      '<div class="taxa-candidate" onclick="_taxaApplyCandidate('+loanId+', '+c.rateMensalEquiv.toFixed(6)+')">'+
        '<div class="taxa-candidate-val">'+origStr+eq+'</div>'+
        '<div class="taxa-candidate-ctx">'+ctx+'<span class="src">fonte: '+c.source+'</span></div>'+
      '</div>'
    );
  }
  bd.innerHTML = html.join('');
  // Footer com info
  const existingFt = document.querySelector('#taxa-modal-ov .taxa-modal-ft');
  if(!existingFt){
    const ft = document.createElement('div');
    ft.className = 'taxa-modal-ft';
    ft.innerHTML =
      '<span class="hint">Sempre confirme a taxa aplicada antes de salvar o empréstimo.</span>'+
      '<button class="taxa-modal-cancel" onclick="closeTaxaModal()">Fechar</button>';
    document.querySelector('#taxa-modal-ov .taxa-modal').appendChild(ft);
  }
}
function _renderTaxaModalEmpty(loanId, msg){
  const bd = document.querySelector('#taxa-modal-ov .taxa-modal-bd');
  if(!bd) return;
  bd.innerHTML = '<div class="taxa-empty">'+esc(msg)+'</div>';
  const existingFt = document.querySelector('#taxa-modal-ov .taxa-modal-ft');
  if(!existingFt){
    const ft = document.createElement('div');
    ft.className = 'taxa-modal-ft';
    ft.innerHTML = '<span class="hint">Dica: abra o PDF e copie a taxa manualmente.</span>'+
                   '<button class="taxa-modal-cancel" onclick="closeTaxaModal()">Fechar</button>';
    document.querySelector('#taxa-modal-ov .taxa-modal').appendChild(ft);
  }
}
function _taxaApplyCandidate(loanId, taxaMensal){
  const loan = loans.find(l => l.id === loanId);
  if(!loan) return;
  // Arredonda pra 4 casas (fmtBR usa parseFloat — precisa ser number ou string com ponto).
  const n = Math.round(taxaMensal * 10000) / 10000;
  loan.taxa = n;  // grava como number — compatível com parseFloat e fmtBR
  saveData();
  render();
  closeTaxaModal();
  try { toast('✓ Taxa aplicada: ' + n.toLocaleString('pt-BR',{minimumFractionDigits:3,maximumFractionDigits:4}) + '% a.m.'); } catch(e){}
}

// ═══════════════════════════════════════════════════════════════════════════
// Extrator completo de campos do contrato (modalidade, parcelas, valor,
// parcela, início, término, descrição/linha, banco). Módulo "Extrair do
// contrato" — busca todos, mostra modal de revisão com checkboxes.
// ═══════════════════════════════════════════════════════════════════════════
function _extrCtx(norm, pos, len){
  const start = Math.max(0, pos - 80);
  const end = Math.min(norm.length, pos + len + 60);
  let c = norm.slice(start, end).trim();
  if(start > 0) c = '…' + c;
  if(end < norm.length) c = c + '…';
  return c;
}
function _parseDataBR(str){
  // DD/MM/AAAA → YYYY-MM-DD
  const m = str.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
  if(!m) return null;
  let y = parseInt(m[3], 10);
  const mo = parseInt(m[2], 10);
  const d = parseInt(m[1], 10);
  if(y < 100) y += 2000;
  if(y < 1990 || y > 2100 || mo < 1 || mo > 12 || d < 1 || d > 31) return null;
  return y + '-' + String(mo).padStart(2,'0') + '-' + String(d).padStart(2,'0');
}
function _parseBrValor(str){
  // "83.940,18" → 83940.18
  const clean = str.replace(/\./g,'').replace(',','.');
  const n = parseFloat(clean);
  return isFinite(n) ? n : NaN;
}

function _findModalidadeCandidates(norm){
  const out = [];
  // SAC
  let m;
  const reSAC = /(sistema\s+de\s+amortiza[cç][aã]o\s+constante|\bsistema\s+sac\b|\bsac\b(?!\s*\w))/gi;
  while((m = reSAC.exec(norm)) !== null){
    out.push({ value:'sac', label:'SAC', context:_extrCtx(norm, m.index, m[0].length), hit:m[0] });
    break; // uma detecção basta
  }
  // Price
  const rePrice = /(tabela\s+price|sistema\s+price|m[eé]todo\s+price|\bprice\b(?!\s*\w))/gi;
  while((m = rePrice.exec(norm)) !== null){
    out.push({ value:'price', label:'Price', context:_extrCtx(norm, m.index, m[0].length), hit:m[0] });
    break;
  }
  return out;
}
function _findParcelasCandidates(norm){
  const out = [];
  const seen = new Set();
  // Padrões: "48 parcelas", "prazo de 60 meses", "parcelado em X vezes", "em X prestações"
  const patterns = [
    /(\d{1,3})\s*(?:parcelas|presta[çc][õo]es|vezes)\b/gi,
    /prazo\s+de\s+(\d{1,3})\s*(?:meses|parcelas)/gi,
    /parcelado\s+em\s+(\d{1,3})/gi,
    /em\s+(\d{1,3})\s+presta[cç][oõ]es/gi
  ];
  for(const re of patterns){
    let m;
    while((m = re.exec(norm)) !== null){
      const n = parseInt(m[1], 10);
      if(n > 0 && n <= 600 && !seen.has(n)){
        seen.add(n);
        out.push({ value:n, label:n + ' parcelas', context:_extrCtx(norm, m.index, m[0].length), hit:m[0] });
      }
    }
  }
  return out;
}
function _findDatasCandidates(norm, tipo /* 'inicio' | 'termino' */){
  const out = [];
  const seen = new Set();
  const keywords = tipo === 'inicio'
    ? [
        /primeira\s+parcela[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi,
        /data\s+de\s+vencimento\s+(?:inicial|da\s+primeira)[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi,
        /vencimento\s+inicial[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi,
        /in[ií]cio\s+(?:das?\s+presta[cç][oõ]es?|dos?\s+pagamentos?|das?\s+parcelas?)[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi,
        /car[êe]ncia\s+at[ée][^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi,
        /liberado?\s+em[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi
      ]
    : [
        /[uú]ltima\s+parcela[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi,
        /vencimento\s+(?:final|[uú]ltimo)[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi,
        /quita[çc][aã]o[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi,
        /t[eé]rmino\s+(?:do\s+contrato|das?\s+presta[cç][oõ]es?)[^\d]{0,40}?(\d{1,2}\/\d{1,2}\/\d{2,4})/gi
      ];
  for(const re of keywords){
    let m;
    while((m = re.exec(norm)) !== null){
      const iso = _parseDataBR(m[1]);
      if(iso && !seen.has(iso)){
        seen.add(iso);
        const dd = iso.split('-').reverse().join('/');
        out.push({ value:iso, label:dd, context:_extrCtx(norm, m.index, m[0].length), hit:m[0] });
      }
    }
  }
  return out;
}
function _findValoresCandidates(norm, tipo /* 'valor' | 'parcela' */){
  const out = [];
  const seen = new Set();
  const patterns = tipo === 'valor'
    ? [
        /valor\s+(?:do\s+contrato|da\s+opera[çc][aã]o|contratado|principal|financiado|tomado|do\s+empr[eé]stimo)[^\d]{0,60}?R?\$?\s*([\d.]+,\d{2})/gi,
        /valor\s+l[ií]quido(?:\s+liberado)?[^\d]{0,60}?R?\$?\s*([\d.]+,\d{2})/gi,
        /valor\s+solicitado[^\d]{0,60}?R?\$?\s*([\d.]+,\d{2})/gi,
        /cr[eé]dito\s+concedido[^\d]{0,60}?R?\$?\s*([\d.]+,\d{2})/gi
      ]
    : [
        /(?:valor\s+d[aoe]s?\s+)?(?:parcela|presta[çc][aã]o)\s+(?:mensal|parcelar?)[^\d]{0,60}?R?\$?\s*([\d.]+,\d{2})/gi,
        /pagamento\s+mensal\s+de[^\d]{0,60}?R?\$?\s*([\d.]+,\d{2})/gi,
        /parcela\s+(?:fixa\s+)?de[^\d]{0,60}?R?\$?\s*([\d.]+,\d{2})/gi,
        /presta[cç][aã]o\s+(?:fixa\s+)?de[^\d]{0,60}?R?\$?\s*([\d.]+,\d{2})/gi
      ];
  for(const re of patterns){
    let m;
    while((m = re.exec(norm)) !== null){
      const v = _parseBrValor(m[1]);
      if(isFinite(v) && v > 0 && !seen.has(v)){
        seen.add(v);
        out.push({
          value: v,
          label: v.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}),
          context: _extrCtx(norm, m.index, m[0].length),
          hit: m[0]
        });
      }
    }
  }
  return out;
}
function _findDescricaoCandidates(norm){
  const out = [];
  const seen = new Set();
  // Linhas conhecidas com label bonito
  const linhas = [
    [/pronampe/i, 'PRONAMPE'],
    [/\bfgi\b/i, 'FGI'],
    [/\bbndes\b/i, 'BNDES'],
    [/finame/i, 'FINAME'],
    [/\bfinep\b/i, 'FINEP'],
    [/\bfco\b/i, 'FCO'],
    [/\bfne\b/i, 'FNE'],
    [/\bfno\b/i, 'FNO'],
    [/\bpeac\b/i, 'PEAC'],
    [/\bfampe\b/i, 'FAMPE'],
    [/capital\s+de\s+giro/i, 'Capital de Giro'],
    [/cr[eé]dito\s+rotativo/i, 'Crédito Rotativo'],
    [/desconto\s+de\s+duplicatas/i, 'Desconto de Duplicatas'],
    [/\bccb\b/i, 'CCB'],
    [/\bcdc\b/i, 'CDC'],
    [/c[eé]dula\s+de\s+cr[eé]dito\s+banc[aá]rio/i, 'Cédula de Crédito Bancário']
  ];
  for(const [re, lbl] of linhas){
    const m = re.exec(norm);
    if(m && !seen.has(lbl)){
      seen.add(lbl);
      out.push({ value: lbl, label: lbl, context: _extrCtx(norm, m.index, m[0].length), hit: m[0] });
    }
  }
  return out;
}
function _findBancoCandidates(norm){
  const out = [];
  // Se temos dispo.bancos, tenta matchar por nome
  try {
    if(typeof dispo !== 'undefined' && dispo && Array.isArray(dispo.bancos)){
      const n = norm.toLowerCase();
      for(const b of dispo.bancos){
        if(!b || !b.nome) continue;
        const nome = String(b.nome).toLowerCase();
        if(nome.length < 3) continue;
        if(n.includes(nome)){
          out.push({ value: b.id, label: b.nome, context: 'Detectado pelo nome no texto', hit: b.nome });
        }
      }
    }
  } catch(e){}
  return out;
}

// Orquestra: extrai texto dos contratos, chama todos os finders, monta resultado.
async function extractAllFromContrato(loanId){
  const loan = loans.find(l => l.id === loanId);
  if(!loan){ try { toast('Empréstimo não encontrado'); } catch(e){} return; }
  if(!loan.contratos || loan.contratos.length === 0){
    try { toast('Nenhum contrato anexado'); } catch(e){}
    return;
  }
  _openExtrModalLoading(loanId);
  try {
    let allText = '';
    for(const c of loan.contratos){
      if(!c.data) continue;
      if(!/\.pdf$/i.test(c.name) && c.type !== 'application/pdf') continue;
      try {
        const t = await _extractPdfText(c.data);
        allText += '\n\n=== ' + (c.name||'contrato') + ' ===\n' + t;
      } catch(e){ console.error('PDF erro', e); }
    }
    if(!allText.trim()){
      _renderExtrModalError(loanId, 'Não consegui extrair texto dos anexos. Pode ser um PDF escaneado (imagem).');
      return;
    }
    const norm = allText.replace(/\s+/g,' ');
    // Executa todos os finders
    const result = {
      modalidade: _findModalidadeCandidates(norm),
      parcelas:   _findParcelasCandidates(norm),
      valor:      _findValoresCandidates(norm, 'valor'),
      parcelaVal: _findValoresCandidates(norm, 'parcela'),
      inicio:     _findDatasCandidates(norm, 'inicio'),
      termino:    _findDatasCandidates(norm, 'termino'),
      descricao:  _findDescricaoCandidates(norm),
      banco:      _findBancoCandidates(norm),
      taxa:       _findTaxaCandidates(norm)
    };
    // Se taxa tem Selic+spread, busca Selic
    if(result.taxa.some(c => c.needsSelic)){
      try {
        const info = await fetchSelicAnual();
        for(const c of result.taxa){
          if(c.needsSelic){
            const total = info.selicAnual + c.spread;
            c.rate = total; c.unit = 'a.a.';
            c.rateMensalEquiv = (Math.pow(1+total/100, 1/12) - 1) * 100;
            c.selicUsada = info; c.needsSelic = false;
          }
        }
      } catch(e){
        for(const c of result.taxa){ if(c.needsSelic) c.selicError = e.message; }
      }
    }
    _renderExtrModalReview(loanId, result);
  } catch(e){
    _renderExtrModalError(loanId, 'Erro: ' + e.message);
  }
}

