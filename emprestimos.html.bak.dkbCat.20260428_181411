function receitaLoad(){
  try{
    const raw = localStorage.getItem(REC_KEY);
    if(raw) receita = JSON.parse(raw);
  }catch(e){}
  if(!receita){
    const y = new Date().getFullYear().toString();
    receita = {activeYear:y, years:{[y]:{clients:[],leads:[],nextId:1}}};
  }
  // Migração: tipos globais (lista editável pelo usuário)
  if(!Array.isArray(receita.tipos) || receita.tipos.length === 0){
    receita.tipos = REC_TIPOS_DEFAULT.map(t => ({...t}));
  }
  // Migração: países customizados adicionados pelo usuário (lookup automático de bandeira)
  if(!Array.isArray(receita.paisesCustom)) receita.paisesCustom = [];
  // Migração + sanity (anos)
  const nomesValidos = new Set(receita.tipos.map(t => t.nome));
  for(const y of Object.keys(receita.years)){
    const d = receita.years[y];
    if(!d.clients) d.clients=[];
    if(!d.leads)   d.leads=[];
    if(!d.nextId)  d.nextId = 1 + [...d.clients, ...d.leads].reduce((m,r)=>Math.max(m,r.id||0),0);
    for(const r of [...d.clients, ...d.leads]){
      if(!r.meses) r.meses={};
      if(!r.color) r.color=REC_COLORS[0];
      // Migração antiga: campo "projeto" (texto livre) -> "tipo" (nome do tipo)
      // Nota: se o projeto antigo virou tipo, esvaziamos r.projeto aqui
      // para não confundir com o NOVO campo projeto (descrição livre).
      if(r.tipo === undefined){
        if(nomesValidos.has(r.projeto)){
          r.tipo = r.projeto;
          r.projeto = ''; // já foi migrado pra tipo
        } else {
          r.tipo = '';
          // se tinha algo em projeto mas não é um tipo, preserva como descrição
          if(typeof r.projeto !== 'string') r.projeto = '';
        }
      }
      // Novos campos (default vazio)
      if(r.pais === undefined)    r.pais    = '';
      if(r.projeto === undefined) r.projeto = '';
    }
  }
  if(!receita.years[receita.activeYear]){
    receita.activeYear = Object.keys(receita.years)[0];
  }
  recActiveYear = receita.activeYear;

  // ── Migração: cliente como entidade única (DB-like) ──
  if(!Array.isArray(receita.clientes)) receita.clientes = [];
  if(!receita.nextClienteId){
    const maxExisting = receita.clientes.reduce((m,c)=>Math.max(m,c.id||0),0);
    receita.nextClienteId = Math.max(1, maxExisting+1);
  }
  // Campos estendidos (dados cadastrais + status). Padrão: cliente ativo.
  for(const c of receita.clientes){
    if(typeof c.ativo !== 'boolean')        c.ativo        = true;
    if(typeof c.razaoSocial !== 'string')   c.razaoSocial  = '';
    if(typeof c.cnpj !== 'string')          c.cnpj         = '';
    if(typeof c.dataInicioContrato !== 'string') c.dataInicioContrato = '';
    if(typeof c.dataFimContrato !== 'string')    c.dataFimContrato    = '';
    if(!Array.isArray(c.anexos))                 c.anexos             = [];
    if(typeof c.logo !== 'string')               c.logo               = '';
    if(c.tipoPessoa !== 'pj' && c.tipoPessoa !== 'pf' && c.tipoPessoa !== 'est'){
      // Default: BR → PJ, outros países → Estrangeiro, sem país → PJ
      c.tipoPessoa = (c.pais === 'BR' ? 'pj' : (c.pais ? 'est' : 'pj'));
    }
    // Migração: um cliente pode sair e voltar. Guardamos o contrato como
    // uma lista de CICLOS {inicio, fim}. O último ciclo sem "fim" representa
    // o contrato vigente. Se só temos os campos antigos, convertemos em um
    // único ciclo preservando as datas já preenchidas.
    if(!Array.isArray(c.ciclos)){
      const ini = c.dataInicioContrato || '';
      const fim = c.dataFimContrato || '';
      if(ini || fim){
        c.ciclos = [{inicio: ini, fim: (c.ativo ? '' : fim)}];
      } else {
        c.ciclos = [];
      }
    }
    // Normaliza cada ciclo (garante shape mesmo que venha de import malformado)
    c.ciclos = c.ciclos
      .filter(p => p && typeof p === 'object')
      .map(p => ({
        inicio: typeof p.inicio === 'string' ? p.inicio : '',
        fim:    typeof p.fim    === 'string' ? p.fim    : ''
      }));
  }
  // Indexa clientes já existentes por nome normalizado (caso migração já rodou parcial)
  const byNome = new Map();
  for(const c of receita.clientes){
    const key = (c.nome||'').trim().toLowerCase();
    if(key) byNome.set(key, c);
  }
  // Varre todas as linhas de todos os anos, criando clientes conforme necessário
  for(const y of Object.keys(receita.years)){
    const d = receita.years[y];
    for(const r of [...(d.clients||[]), ...(d.leads||[])]){
      if(r.clienteId !== undefined) continue;
      const nome = (r.nome||'').trim();
      if(!nome){ r.clienteId = UNASSIGNED; continue; }
      const key = nome.toLowerCase();
      let c = byNome.get(key);
      if(!c){
        c = {
          id: receita.nextClienteId++,
          nome,
          pais: r.pais || '',
          color: r.color || REC_COLORS[receita.clientes.length % REC_COLORS.length]
        };
        receita.clientes.push(c);
        byNome.set(key, c);
      } else {
        // Preenche campos vazios do cliente com valores desta linha, se houver
        if(!c.pais && r.pais) c.pais = r.pais;
      }
      r.clienteId = c.id;
    }
  }
}

function receitaSave(){
  receita.activeYear = recActiveYear;
  try{ localStorage.setItem(REC_KEY, JSON.stringify(receita)); }catch(e){}
  // Atualiza selo de salvamento geral
  const sb = document.getElementById('sb-save-ts');
  if(sb){
    const t=new Date();
    sb.textContent = 'salvo ' + t.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
  }
}

// Abre o modal de novo ano. Se `prefillSource` for passado (ex: "2026"),
// já seleciona o radio "Copiar de <ano>".
function addRecYear(prefillSource){
  const existing = Object.keys(receita.years).map(Number).filter(n=>!isNaN(n));
  const suggestion = existing.length ? Math.max(...existing)+1 : new Date().getFullYear();

  // Preenche o input do ano
  const inp = document.getElementById('nyr-year');
  if(inp) inp.value = suggestion;

  // Re-renderiza as escolhas de "copiar de"
  const group = document.getElementById('nyr-choices');
  if(group){
    // Remove opções antigas (deixa a primeira — "Em branco")
    Array.from(group.querySelectorAll('.nyr-choice.copy-src')).forEach(el => el.remove());

    const years = Object.keys(receita.years).sort();
    for(const y of years){
      const d = receita.years[y];
      const nLinhas = (d.clients||[]).length + (d.leads||[]).length;
      if(nLinhas === 0) continue; // não faz sentido "copiar" de um ano vazio
      const label = document.createElement('label');
      label.className = 'nyr-choice copy-src';
      const checked = prefillSource === y ? 'checked' : '';
      label.innerHTML = `
        <input type="radio" name="nyr-src" value="${y}" ${checked} onchange="updateNyrOptions()">
        <div class="nyr-choice-body">
          <div class="nyr-choice-title">📋 Copiar de ${y}</div>
          <div class="nyr-choice-desc">${nLinhas} linha${nLinhas===1?'':'s'} (clientes + leads)</div>
        </div>
      `;
      group.appendChild(label);
    }
  }

  // Reset das checkboxes para valores-padrão
  const cbRows  = document.getElementById('nyr-copy-rows');
  const cbLeads = document.getElementById('nyr-copy-leads');
  const cbMeses = document.getElementById('nyr-copy-meses');
  if(cbRows)  cbRows.checked  = true;
  if(cbLeads) cbLeads.checked = true;
  if(cbMeses) cbMeses.checked = false;

  // Título dinâmico
  const title = document.getElementById('nyr-title');
  if(title) title.textContent = prefillSource
    ? `Duplicar ano ${prefillSource}`
    : 'Novo ano de receita';

  updateNyrOptions();
  document.getElementById('ov-newyear').classList.add('open');
  setTimeout(()=>{ if(inp){ inp.focus(); inp.select(); } }, 60);
}

function closeNewYearModal(){
  document.getElementById('ov-newyear').classList.remove('open');
}

// Mostra/esconde o bloco de opções "o que copiar" conforme a escolha
function updateNyrOptions(){
  const radios = document.getElementsByName('nyr-src');
  let src = '';
  for(const r of radios){ if(r.checked){ src = r.value; break; } }
  const box = document.getElementById('nyr-copy-options');
  if(box) box.style.display = src ? 'block' : 'none';

  // Preview no rodapé
  const prev = document.getElementById('nyr-preview');
  if(prev){
    if(!src){
      prev.textContent = 'Criar um ano totalmente vazio.';
    } else {
      const d = receita.years[src] || {clients:[],leads:[]};
      prev.textContent = `Copiando ${d.clients.length} cliente(s) e ${d.leads.length} lead(s) de ${src}.`;
    }
  }
}

// Cria o novo ano (em branco ou copiando de outro)
async function submitNewYear(){
  const inp = document.getElementById('nyr-year');
  const y = (inp ? inp.value : '').trim();
  if(!/^\d{4}$/.test(y)){ await showInfo({title:'Ano inválido', message:'Informe um ano válido de 4 dígitos (ex: 2027).', warning:true}); inp && inp.focus(); return; }
  if(receita.years[y]){ await showInfo({title:'Ano já existe', message:'Esse ano já está cadastrado.', warning:true}); return; }

  const radios = document.getElementsByName('nyr-src');
  let src = '';
  for(const r of radios){ if(r.checked){ src = r.value; break; } }

  if(!src){
    // Em branco
    receita.years[y] = {clients:[], leads:[], nextId:1};
  } else {
    const copyRows  = document.getElementById('nyr-copy-rows') .checked;
    const copyLeads = document.getElementById('nyr-copy-leads').checked;
    const copyMeses = document.getElementById('nyr-copy-meses').checked;
    receita.years[y] = copyYearData(src, {copyRows, copyLeads, copyMeses});
  }

  recActiveYear = y;
  receitaSave();
  closeNewYearModal();
  renderReceita();
  toast(src ? `✅ Ano ${y} criado a partir de ${src}.` : `✅ Ano ${y} adicionado.`);
}

// Retorna uma nova estrutura de ano {clients,leads,nextId} a partir de outro ano.
// O clienteId é preservado (os clientes são globais), mas os ids das linhas
// são renumerados a partir de 1 para o novo ano.
function copyYearData(fromY, opts){
  const src = receita.years[fromY];
  if(!src) return {clients:[], leads:[], nextId:1};
  const { copyRows = true, copyLeads = true, copyMeses = false } = opts || {};

  const cloneRow = (r, newId) => {
    const copy = {
      id: newId,
      clienteId: r.clienteId || 0,
      nome: r.nome || '',   // legacy fallback
      pais: r.pais || '',   // legacy fallback
      color: r.color,
      tipo: r.tipo || '',
      projeto: r.projeto || '',
      meses: {}
    };
    if(copyMeses){
      for(const m of REC_MESES){
        if(r.meses && r.meses[m]){
          copy.meses[m] = {
            valor: r.meses[m].valor,
            // Nota: o status recebido pode não fazer sentido no ano futuro.
            // Ao copiar valores, reseto tudo para 'aberto' (expectativa de recebimento).
            status: 'aberto'
          };
        }
      }
    }
    return copy;
  };

  let nextId = 1;
  const clients = copyRows ? (src.clients||[]).map(r => cloneRow(r, nextId++)) : [];
  const leads   = copyLeads ? (src.leads  ||[]).map(r => cloneRow(r, nextId++)) : [];
  return { clients, leads, nextId };
}

// Atalho: duplica o ano ativo (ou outro ano qualquer) abrindo o modal pré-preenchido
function duplicateRecYear(y){
  addRecYear(y || recActiveYear);
}

async function delRecYear(y){
  if(Object.keys(receita.years).length<=1){
    await showInfo({title:'Não foi possível remover', message:'Deixe ao menos um ano cadastrado.', warning:true});
    return;
  }
  const d = receita.years[y];
  const count = (d.clients||[]).length + (d.leads||[]).length;
  const ok = await showConfirm({
    title:`Remover ano ${y}?`,
    message:`Remover o ano ${y} e ${count} linha(s) registrada(s)?\n\nEssa ação não pode ser desfeita.`,
    confirmLabel:'Remover',
    destructive:true
  });
  if(!ok) return;
  delete receita.years[y];
  recActiveYear = Object.keys(receita.years).sort()[0];
  receitaSave(); renderReceita();
}

function switchRecYear(y){
  if(y === recActiveYear) return;
  recActiveYear = y;
  receitaSave(); renderReceita();
}

function addRecRow(type){
  const d = receita.years[recActiveYear];
  const id = d.nextId++;
  const color = REC_COLORS[((d.clients.length + d.leads.length)) % REC_COLORS.length];
  // Se houver um filtro ativo, já cria com esse tipo pré-selecionado
  const tipoPadrao = recFilterTipo || '';
  // clienteId:0 → linha órfã (sem cliente vinculado); será criado/linkado
  // assim que o usuário digitar um nome no primeiro input.
  const row = {id, clienteId:UNASSIGNED, nome:'', pais:'', tipo:tipoPadrao, projeto:'', color, meses:{}};
  (type==='lead' ? d.leads : d.clients).push(row);
  receitaSave(); renderReceita();
  // Abre automaticamente o picker de cliente na nova linha
  setTimeout(()=>{
    const el = document.querySelector(`tr[data-rec="${type}-${id}"] .rec-cli-btn`);
    if(el) el.click();
  }, 60);
}

function changeRecTipo(type, id, sel){
  saveRecField(type, id, 'tipo', sel.value);
  // atualiza estilos visuais da própria célula (cor vem do tipo)
  applyTipoSelectStyle(sel, sel.value);
  // se há filtro ativo e o tipo saiu dele, re-renderiza para esconder a linha
  if(recFilterTipo && sel.value !== recFilterTipo) renderReceita();
}

function applyTipoSelectStyle(sel, nome){
  const t = recTipoByNome(nome);
  if(t){
    sel.className = 'rec-tipo-select filled';
    sel.style.setProperty('--tc',   t.color);
    sel.style.setProperty('--ttxt', REC_TIPO_TXT);
  } else {
    sel.className = 'rec-tipo-select empty';
    sel.style.removeProperty('--tc');
    sel.style.removeProperty('--ttxt');
  }
}

async function delRecRow(type, id){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id);
  if(!row) return;
  const view = clienteView(row);
  // Se o cliente tem vários projetos, mostra descrição do projeto para desambiguar
  const projDesc = (row.projeto||'').trim();
  const nClienteRows = row.clienteId ? countRowsForCliente(row.clienteId) : 0;
  let label = 'esta linha';
  if(view.nome){
    label = nClienteRows > 1 && projDesc
      ? `o projeto "${projDesc}" de "${view.nome}"`
      : `"${view.nome}"`;
  }
  const ok = await showConfirm({
    title:'Excluir linha?',
    message:`Excluir ${label}?\n\nTodos os valores mensais serão perdidos. Essa ação não pode ser desfeita.`,
    confirmLabel:'Excluir',
    destructive:true
  });
  if(!ok) return;
  const wasClienteId = row.clienteId;
  if(type==='lead') d.leads   = d.leads.filter(r=>r.id!==id);
  else              d.clients = d.clients.filter(r=>r.id!==id);
  // Se o cliente ficou sem nenhuma linha em nenhum ano, remove também o registro
  // do cliente (para manter o "banco de dados" enxuto — pode ser revertido se desejar).
  if(wasClienteId) deleteClienteIfOrphan(wasClienteId);
  receitaSave(); renderReceita();
  toast('✅ Linha excluída.');
}

function editRecRow(type, id){
  // "Edit" = abre o picker de cliente (permite trocar, renomear, ou criar)
  const el = document.querySelector(`tr[data-rec="${type}-${id}"] .rec-cli-btn`);
  if(el) el.click();
}

function dupRecRow(type, id){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const src = list.find(r=>r.id===id); if(!src) return;
  const newId = d.nextId++;
  // Deep copy meses
  const mesesCopy = {};
  for(const m of REC_MESES){
    if(src.meses[m]) mesesCopy[m] = {...src.meses[m]};
  }
  // A duplicação mantém o MESMO cliente (mesmo clienteId). O identificador
  // do projeto fica no campo "projeto" (descrição livre) — adicionamos " (cópia)"
  // para diferenciar visualmente da linha original.
  const view = clienteView(src);
  const copy = {
    id: newId,
    clienteId: src.clienteId || UNASSIGNED,
    nome: view.nome,
    pais: view.pais,
    color: view.color,
    tipo: src.tipo || '',
    projeto: src.projeto ? src.projeto + ' (cópia)' : '(cópia)',
    meses: mesesCopy
  };
  // Insere logo após o original
  const idx = list.findIndex(r=>r.id===id);
  list.splice(idx+1, 0, copy);
  receitaSave(); renderReceita();
  setTimeout(()=>{
    const el = document.querySelector(`tr[data-rec="${type}-${newId}"] .rec-projeto-input`);
    if(el){ el.focus(); el.select(); }
  }, 40);
  toast('✅ Linha duplicada.');
}

function saveRecField(type, id, field, val){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  row[field] = val;
  receitaSave();
}

// Adiciona um NOVO projeto para o MESMO cliente (mesmo clienteId) — herda
// cliente, tipo e cor; deixa descrição e valores mensais em branco.
// Insere logo após o último projeto do grupo.
async function addProjetoSameClient(type, id){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const src = list.find(r=>r.id===id); if(!src) return;
  if(!src.clienteId){
    await showInfo({title:'Defina o cliente', message:'Defina o nome do cliente primeiro para adicionar outro projeto.', warning:true});
    return;
  }
  const newId = d.nextId++;
  const view = clienteView(src);
  const newRow = {
    id: newId,
    clienteId: src.clienteId,
    nome: view.nome,
    pais: view.pais,
    color: view.color,
    tipo: src.tipo || '',
    projeto: '',
    meses: {}
  };
  // Insere logo após o último projeto do grupo (mesmo clienteId consecutivo)
  let idx = list.findIndex(r=>r.id===id);
  while(idx+1 < list.length && (list[idx+1].clienteId||0) === src.clienteId){
    idx++;
  }
  list.splice(idx+1, 0, newRow);
  receitaSave(); renderReceita();
  setTimeout(()=>{
    const el = document.querySelector(`tr[data-rec="${type}-${newId}"] .rec-projeto-input`);
    if(el){ el.focus(); el.select(); }
  }, 40);
  toast('✅ Novo projeto para '+(view.nome||'cliente')+'.');
}

// Gerencia o nome do cliente a partir do input de uma linha:
//   - nome vazio          → desvincula a linha (clienteId=0)
//   - nome novo, órfã     → cria cliente, vincula
//   - nome novo, vinculada→ renomeia o cliente (afeta todas as linhas do grupo)
//   - nome já existe      → linka/mescla (com confirmação quando há risco de perda)
async function setRowClienteNome(type, id, novoNome){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;

  const nomeLimpo = (novoNome||'').trim();
  const currentCliente = clienteOf(row);

  // Mantém legacy field atualizado (usado como fallback para linhas órfãs)
  row.nome = nomeLimpo;

  // Caso 1: nome vazio → desvincula
  if(!nomeLimpo){
    row.clienteId = UNASSIGNED;
    receitaSave(); renderReceita();
    return;
  }

  const alvo = findClienteByNome(nomeLimpo);

  // Caso 2: nome igual ao cliente atual (apenas mudança de capitalização)
  if(currentCliente && alvo && alvo.id === currentCliente.id){
    if(currentCliente.nome !== nomeLimpo){
      currentCliente.nome = nomeLimpo;
      receitaSave(); renderReceita();
    } else {
      renderReceita(); // redesenha para garantir sincronismo visual
    }
    return;
  }

  // Caso 3: já existe outro cliente com esse nome
  if(alvo){
    if(currentCliente){
      const n = countRowsForCliente(currentCliente.id);
      const msg = n>1
        ? `Mesclar "${currentCliente.nome}" em "${alvo.nome}"?\n\n${n} linhas passarão a referenciar "${alvo.nome}". O cliente antigo será removido.`
        : `Vincular esta linha ao cliente existente "${alvo.nome}"?\n\nO cliente "${currentCliente.nome}" ficará sem linhas e será removido.`;
      const ok = await showConfirm({
        title: n>1 ? 'Mesclar clientes?' : 'Vincular cliente?',
        message: msg,
        confirmLabel: n>1 ? 'Mesclar' : 'Vincular',
        destructive: n>1
      });
      if(!ok){
        renderReceita(); // reverte UI
        return;
      }
      reassignCliente(currentCliente.id, alvo.id);
      deleteClienteIfOrphan(currentCliente.id);
    } else {
      row.clienteId = alvo.id;
    }
    receitaSave(); renderReceita();
    return;
  }

  // Caso 4: nome novo, linha já vinculada a um cliente → renomeia o cliente
  if(currentCliente){
    currentCliente.nome = nomeLimpo;
    receitaSave(); renderReceita();
    return;
  }

  // Caso 5: nome novo, linha órfã → cria cliente novo (usa país/cor pendentes)
  const pendingPais  = row.pais  || '';
  const pendingColor = row.color || REC_COLORS[recClientes().length % REC_COLORS.length];
  const novo = createCliente({nome:nomeLimpo, pais:pendingPais, color:pendingColor});
  row.clienteId = novo.id;
  receitaSave(); renderReceita();
}

// ── Picker de Cliente (popup com lista + busca + criar novo) ─────
function openClientePicker(type, id, btn, event){
  if(event) event.stopPropagation();
  closeClientePicker();
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  const currentCid = row.clienteId || 0;

  const pop = document.createElement('div');
  pop.className = 'rec-cli-pop';
  pop.id = 'cli-pop';
  pop.addEventListener('click', e=>e.stopPropagation());

  const header = document.createElement('div');
  header.className = 'rec-cli-header';
  const htitle = document.createElement('div');
  htitle.className = 'rec-cli-header-title';
  htitle.textContent = currentCid ? 'Trocar / renomear cliente' : 'Selecionar cliente';
  const search = document.createElement('input');
  search.type = 'text';
  search.className = 'rec-cli-search';
  search.placeholder = 'Buscar ou digitar novo nome…';
  header.appendChild(htitle);
  header.appendChild(search);

  const listEl = document.createElement('div');
  listEl.className = 'rec-cli-list';

  const footer = document.createElement('div');
  footer.className = 'rec-cli-footer';

  function renderList(query){
    listEl.innerHTML = '';
    const q = (query||'').trim().toLowerCase();
    const clientes = recClientes().slice().sort((a,b)=>(a.nome||'').localeCompare(b.nome||'','pt'));
    const filtered = q
      ? clientes.filter(c => (c.nome||'').toLowerCase().includes(q))
      : clientes;

    if(filtered.length === 0){
      const empty = document.createElement('div');
      empty.className = 'rec-cli-empty';
      empty.textContent = clientes.length === 0
        ? 'Nenhum cliente cadastrado ainda.'
        : 'Nenhum cliente corresponde à busca.';
      listEl.appendChild(empty);
    } else {
      for(const c of filtered){
        const opt = document.createElement('div');
        opt.className = 'rec-cli-opt' + (currentCid === c.id ? ' selected' : '');
        const swatch = document.createElement('span');
        swatch.className = 'rec-cli-swatch';
        swatch.style.background = c.color || REC_COLORS[0];
        const flag = document.createElement('span');
        flag.className = 'rec-cli-oflag';
        const p = recPaisByCode(c.pais);
        flag.textContent = p ? p.flag : '—';
        if(!p) flag.style.opacity = '.35';
        const name = document.createElement('span');
        name.className = 'rec-cli-oname';
        name.textContent = c.nome || '(sem nome)';
        const n = countRowsForCliente(c.id);
        const cnt = document.createElement('span');
        cnt.className = 'rec-cli-count';
        cnt.textContent = n + (n===1?' projeto':' projetos');
        const rename = document.createElement('button');
        rename.className = 'rec-cli-rename';
        rename.title = 'Renomear cliente';
        rename.innerHTML = '<svg viewBox="0 0 24 24"><path d="M17 3a2.828 2.828 0 014 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>';
        rename.onclick = async (ev)=>{
          ev.stopPropagation();
          const novo = await askText({
            title: 'Renomear cliente',
            label: 'Nome',
            placeholder: 'Digite o nome do cliente…',
            initialValue: c.nome,
            confirmText: 'Renomear',
            validate: (v) => !String(v||'').trim() ? 'Nome não pode ser vazio.' : null
          });
          if(novo == null) return;
          const nomeLimpo = novo.trim();
          if(nomeLimpo === c.nome){ return; }
          const existe = findClienteByNome(nomeLimpo);
          if(existe && existe.id !== c.id){
            const n1 = countRowsForCliente(c.id);
            const ok = await showConfirm({
              title: 'Mesclar clientes',
              message: `Já existe um cliente "<strong>${esc(nomeLimpo)}</strong>". Mesclar "<strong>${esc(c.nome)}</strong>" (${n1} linha${n1===1?'':'s'}) em "<strong>${esc(nomeLimpo)}</strong>"?`,
              confirmLabel: 'Mesclar', destructive: true
            });
            if(!ok) return;
            reassignCliente(c.id, existe.id);
            deleteClienteIfOrphan(c.id);
          } else {
            c.nome = nomeLimpo;
          }
          receitaSave();
          renderList(search.value);
          renderReceita();
        };

        opt.appendChild(swatch);
        opt.appendChild(flag);
        opt.appendChild(name);
        opt.appendChild(cnt);
        opt.appendChild(rename);
        opt.onclick = ()=> linkRowToCliente(type, id, c.id);
        listEl.appendChild(opt);
      }
    }

    // Footer — botão de criar (dinâmico conforme busca)
    footer.innerHTML = '';
    const hasExact = clientes.some(c => (c.nome||'').toLowerCase() === q && q);
    const newBtn = document.createElement('button');
    newBtn.className = 'rec-cli-new';
    const plus = '<svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    const qRaw = (query||'').trim();
    if(qRaw && !hasExact){
      newBtn.innerHTML = plus + '<span>Criar "<b>' + esc(qRaw) + '</b>"</span>';
    } else {
      newBtn.innerHTML = plus + '<span>Criar novo cliente</span>';
    }
    newBtn.onclick = async ()=>{
      let nome = (qRaw && !hasExact) ? qRaw : null;
      if(!nome){
        const entered = await askText({
          title: 'Novo cliente',
          label: 'Nome',
          placeholder: 'Digite o nome do cliente…',
          confirmText: 'Criar',
          validate: (v) => !String(v||'').trim() ? 'Nome não pode ser vazio.' : null
        });
        if(entered == null) return;
        nome = entered.trim();
        if(!nome) return;
      }
      const existe = findClienteByNome(nome);
      if(existe){ linkRowToCliente(type, id, existe.id); return; }
      createAndLinkCliente(type, id, nome);
    };
    footer.appendChild(newBtn);

    if(currentCid){
      const unlink = document.createElement('button');
      unlink.className = 'rec-cli-unlink';
      unlink.textContent = 'Remover vínculo com cliente';
      unlink.onclick = ()=> unlinkRowCliente(type, id);
      footer.appendChild(unlink);
    }
  }

  renderList('');
  search.addEventListener('input', ()=> renderList(search.value));
  search.addEventListener('keydown', e=>{
    if(e.key==='Escape'){ e.stopPropagation(); closeClientePicker(); }
    if(e.key==='Enter'){
      e.preventDefault();
      const q = search.value.trim();
      if(!q) return;
      const existe = findClienteByNome(q);
      if(existe) linkRowToCliente(type, id, existe.id);
      else       createAndLinkCliente(type, id, q);
    }
  });

  pop.appendChild(header);
  pop.appendChild(listEl);
  pop.appendChild(footer);

  const rect = btn.getBoundingClientRect();
  pop.style.top  = Math.min(rect.bottom+6, window.innerHeight - 400) + 'px';
  pop.style.left = Math.min(rect.left, window.innerWidth - 350) + 'px';
  document.body.appendChild(pop);
  setTimeout(()=>{
    search.focus();
    document.addEventListener('click', closeClientePicker, {once:true});
  }, 40);
}

function closeClientePicker(){
  const p = document.getElementById('cli-pop');
  if(p) p.remove();
}

function linkRowToCliente(type, id, clienteId){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  const oldCid = row.clienteId || 0;
  if(oldCid === clienteId){ closeClientePicker(); return; }
  row.clienteId = clienteId;
  const c = clienteOf(row);
  if(c){ row.nome = c.nome; row.pais = c.pais; row.color = c.color; } // sync legacy fields
  if(oldCid) deleteClienteIfOrphan(oldCid);
  receitaSave();
  closeClientePicker();
  renderReceita();
}

function unlinkRowCliente(type, id){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  const oldCid = row.clienteId || 0;
  row.clienteId = UNASSIGNED;
  row.nome = '';
  if(oldCid) deleteClienteIfOrphan(oldCid);
  receitaSave();
  closeClientePicker();
  renderReceita();
}

function createAndLinkCliente(type, id, nome){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  const nomeLimpo = (nome||'').trim();
  if(!nomeLimpo) return;
  const oldCid = row.clienteId || 0;
  const view = clienteView(row);
  const pendingPais  = view.pais  || '';
  const pendingColor = view.color || REC_COLORS[recClientes().length % REC_COLORS.length];
  const novo = createCliente({nome:nomeLimpo, pais:pendingPais, color:pendingColor});
  row.clienteId = novo.id;
  row.nome = novo.nome; row.pais = novo.pais; row.color = novo.color;
  if(oldCid && oldCid !== novo.id) deleteClienteIfOrphan(oldCid);
  receitaSave();
  closeClientePicker();
  renderReceita();
  toast('✅ Cliente "'+novo.nome+'" criado.');
}

function saveRecMes(type, id, mes, rawVal){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  // Regra: célula marcada como "recebido" (✓) trava edição até o ✓ ser removido
  const cur = row.meses && row.meses[mes];
  if(cur && cur.status === 'recebido' && cur.valor !== '' && cur.valor != null && cur.valor !== 0){
    notifyLocked();
    return;
  }
  const n = parseBR(rawVal);
  if(!row.meses[mes]) row.meses[mes] = {valor:'', status:'aberto'};
  // Zero é tratado como vazio (não muda a cor da célula)
  row.meses[mes].valor = (n !== '' && n !== 0) ? n : '';
  receitaSave();

  // Atualiza classe da célula
  const td = document.querySelector(`tr[data-rec="${type}-${id}"] td.rec-cell[data-mes="${mes}"]`);
  if(td){
    td.classList.remove('recebido','aberto');
    if(row.meses[mes].valor !== '' && row.meses[mes].valor !== 0){
      td.classList.add(row.meses[mes].status==='recebido'?'recebido':'aberto');
    }
    // Limpa o ícone ✓ do toggle se a célula ficou vazia
    const tog = td.querySelector('.rec-cell-toggle');
    if(tog && (row.meses[mes].valor === '' || row.meses[mes].valor === 0)) tog.textContent = '';
  }
  updateRecRowTotal(type, id);
  updateRecTotals();
}

function toggleRecMesStatus(type, id, mes){
  const d = receita.years[recActiveYear];
  const list = type==='lead' ? d.leads : d.clients;
  const row = list.find(r=>r.id===id); if(!row) return;
  if(!row.meses[mes] || row.meses[mes].valor === '') return; // só célula com valor
  row.meses[mes].status = row.meses[mes].status==='recebido' ? 'aberto' : 'recebido';
  receitaSave();

  const td = document.querySelector(`tr[data-rec="${type}-${id}"] td.rec-cell[data-mes="${mes}"]`);
  if(td){
    td.classList.remove('recebido','aberto');
    td.classList.add(row.meses[mes].status==='recebido'?'recebido':'aberto');
    const tog = td.querySelector('.rec-cell-toggle');
    if(tog) tog.textContent = row.meses[mes].status==='recebido' ? '✓' : '';
  }
  updateRecTotals();
}

