// Encontra (ou cria) um fornecedor em pessoas.registry a partir do bancoId
// Retorna o fornecedorId. Se o banco não tem CNPJ ou pessoas não está disponível, retorna null.
function _extEnsureBancoFornecedor(bancoId){
  if(!bancoId || typeof dispo === 'undefined' || !dispo || !Array.isArray(dispo.bancos)) return null;
  const banco = dispo.bancos.find(x => x.id === bancoId);
  if(!banco) return null;
  if(typeof pessoas === 'undefined' || !pessoas) return null;
  if(!Array.isArray(pessoas.registry)) pessoas.registry = [];
  // 1) Procura no registry por CNPJ
  if(banco.cnpj){
    const cnpjDigits = String(banco.cnpj).replace(/\D/g,'');
    const fr = pessoas.registry.find(r => String(r.cnpj || '').replace(/\D/g,'') === cnpjDigits);
    if(fr) return fr.id;
    // 2) Não achou — cria
    if(!pessoas.nextRegId) pessoas.nextRegId = 1;
    const novo = {
      id: pessoas.nextRegId++,
      nome: banco.razaoSocial || banco.nome || ('Banco ' + banco.id),
      cnpj: cnpjDigits,
      tipoPessoa: 'pj',
      foto: '',
      anexos: [],
      tags: ['banco'],
      kind: 'fornecedor'
    };
    pessoas.registry.push(novo);
    if(typeof pessoasSave === 'function') try { pessoasSave(); } catch(_){}
    if(typeof renderWfFornecedores === 'function'){ try { renderWfFornecedores(); } catch(_){} }
    return novo.id;
  }
  // 3) Sem CNPJ — procura por nome
  const frByNome = pessoas.registry.find(r => (r.nome||'').trim().toLowerCase() === (banco.nome||'').trim().toLowerCase());
  if(frByNome) return frByNome.id;
  return null;
}
try { window._extEnsureBancoFornecedor = _extEnsureBancoFornecedor; } catch(e){}

// Resolve o fornecedorId atual de um item do extrato (qualquer fonte)
function _extResolveFornId(it){
  if(!it) return '';
  // Forma direta: o próprio item já tem fornecedorId (preenchido pelo _extCollect)
  if(it.fornecedorId) return it.fornecedorId;
  // Manual
  if(it.id && it.id.startsWith('m:') && it.raw && it.raw.fornecedorId) return it.raw.fornecedorId;
  // Receita: lookup direto no cell (fallback)
  if(it.id && it.id.startsWith('rec:')){
    try {
      const parts = it.id.split(':');
      const y = parseInt(parts[1],10), rowId = parseInt(parts[2],10), mAbbr = parts[3];
      const cell = receita?.years?.[y]?.clients?.find(r => r.id === rowId)?.meses?.[mAbbr];
      if(cell && cell.fornecedorId) return cell.fornecedorId;
    } catch(e){}
  }
  // Loan: ln.fornecedorId
  if(it.id && it.id.startsWith('loan:')){
    try {
      const parts = it.id.split(':');
      const loanId = parseInt(parts[1], 10);
      const ln = (typeof loans !== 'undefined' && Array.isArray(loans)) ? loans.find(x => x.id === loanId) : null;
      if(ln && ln.fornecedorId) return ln.fornecedorId;
    } catch(e){}
  }
  return '';
}

