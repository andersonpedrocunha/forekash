function setPesReajSimField(tipoId, field, val){
  if(!pessoas.reajSim) pessoas.reajSim = { enabled:false, rulesByYear:{} };
  if(!pessoas.reajSim.rulesByYear) pessoas.reajSim.rulesByYear = {};
  const year = pesReajSimModalYear;
  if(!year) return;
  // Preserva parciais para que o usuário possa preencher campos separadamente
  // sem perder o que já digitou.
  pessoas.reajSim.rulesByYear[year] = pessoas.reajSim.rulesByYear[year] || {};
  const map = pessoas.reajSim.rulesByYear[year];
  const rule = map[tipoId] || {};
  if(field === 'key'){
    rule.key = (val || '').trim();
  } else if(field === 'pct'){
    const n = parseBR(val);
    rule.pct = (n === '' || n === 0) ? 0 : n;
  }
  const hasKey = !!rule.key;
  const hasPct = !!(rule.pct && rule.pct !== 0);
  if(!hasKey && !hasPct){
    // Ambos vazios → remove a regra
    delete map[tipoId];
  } else {
    map[tipoId] = rule;
  }
  if(!Object.keys(map).length) delete pessoas.reajSim.rulesByYear[year];
  pessoasSave();
  // Regra só "conta" (has-rule visual, KPI, render) se estiver completa
  const card = document.querySelector('.pes-reajsim-tipo[data-tipo="'+tipoId+'"]');
  if(card){
    card.classList.toggle('has-rule', hasKey && hasPct);
  }
  renderPesReajSimYearTabs();
}
