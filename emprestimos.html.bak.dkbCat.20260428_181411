// ════════════════════════════════════════════════════════════
const OUTRAS_OP_KEY = 'taller_outras_op_v1';
let outrasOp = { valores: {}, nextId: 1 };
let _outrasOpTab = 'receitas';
let _outrasOpYear = new Date().getFullYear();
const OUTRAS_MESES = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

function outrasOpLoad(){
  try {
    const raw = localStorage.getItem(OUTRAS_OP_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && typeof obj === 'object'){
        if(obj.valores && typeof obj.valores === 'object') outrasOp.valores = obj.valores;
        if(typeof obj.nextId === 'number') outrasOp.nextId = obj.nextId;
      }
    }
  } catch(e){ console.warn('outrasOp/load:', e); }
}
function outrasOpSave(){
  try {
    localStorage.setItem(OUTRAS_OP_KEY, JSON.stringify({ valores: outrasOp.valores, nextId: outrasOp.nextId }));
  } catch(e){ console.warn('outrasOp/save:', e); }
}
outrasOpLoad();

function _outrasOpYM(year, mIdx){ return year + '-' + String(mIdx+1).padStart(2,'0'); }
function _outrasOpFmt(v){
  if(v === undefined || v === null || v === '' || v === 0) return '';
  return Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function _outrasOpParseNum(s){
  if(s == null) return 0;
  let str = String(s).replace(/[^0-9.,\-]/g, '');
  // Se tem vírgula, é formato BR (1.500,50 → 1500.50)
  if(str.indexOf(',') !== -1){
    str = str.replace(/\./g, '').replace(',', '.');
  }
  // Senão, ponto é decimal (1500.00)
  const n = parseFloat(str);
  return isFinite(n) ? n : 0;
}

function outrasOpSetVal(catId, ym, raw){
  // Usa parseBR (compartilhado) que suporta fórmulas (=10+20, =SOMA(1;2;3))
  // e formato BR (1.500,50) E formato decimal (1500.50).
  let v;
  if(typeof parseBR === 'function'){
    const r = parseBR(raw);
    v = (typeof r === 'number') ? r : 0;
  } else {
    v = _outrasOpParseNum(raw);
  }
  if(!outrasOp.valores) outrasOp.valores = {};
  if(!outrasOp.valores[catId]) outrasOp.valores[catId] = {};
  if(!v || v === 0){
    delete outrasOp.valores[catId][ym];
  } else {
    outrasOp.valores[catId][ym] = v;
  }
  outrasOpSave();
  // Atualiza só o total da linha sem re-render completo
  renderOutrasOp();
  // Revalidate Fluxo de Caixa se estiver visível
  try { if(typeof renderFlxSheet === 'function' && document.getElementById('mod-fluxo')?.classList.contains('active')) renderFlxSheet(); } catch(_){}
}

function _outrasOpCategoriasPara(tipo){
  const moduloId = (tipo === 'receitas') ? 'outrasRec' : 'outrasDesp';
  return (catmapData && Array.isArray(catmapData.categorias) ? catmapData.categorias : [])
    .filter(c => c && c.moduloId === moduloId)
    .sort((a,b) => (a.nome||'').localeCompare(b.nome||'','pt'));
}

function _outrasOpRenderTab(tipo){
  const cats = _outrasOpCategoriasPara(tipo);
  const theadId = 'outras-' + tipo + '-thead';
  const tbodyId = 'outras-' + tipo + '-tbody';
  const tfootId = 'outras-' + tipo + '-tfoot';
  const thead = document.getElementById(theadId);
  const tbody = document.getElementById(tbodyId);
  const tfoot = document.getElementById(tfootId);
  if(!thead || !tbody || !tfoot) return;
  // Header
  let mesesH = OUTRAS_MESES.map(m => '<th>' + m + '</th>').join('');
  thead.innerHTML = '<tr><th class="col-cat">Categoria</th>' + mesesH + '<th class="col-tot">Total</th></tr>';
  // Body
  if(cats.length === 0){
    tbody.innerHTML = '<tr><td colspan="14" class="outras-empty">Nenhuma categoria cadastrada ainda. Use o botão acima pra criar.</td></tr>';
    tfoot.innerHTML = '';
    return;
  }
  // Totais por mês (pra tfoot)
  const totMes = new Array(12).fill(0);
  let bodyHtml = '';
  for(const c of cats){
    let totLinha = 0;
    let cells = '';
    for(let m=0;m<12;m++){
      const ym = _outrasOpYM(_outrasOpYear, m);
      const v = (outrasOp.valores[c.id] && outrasOp.valores[c.id][ym]) || 0;
      totLinha += v;
      totMes[m] += v;
      const cellRef = 'outras:' + c.id + ':' + ym;
      cells += '<td><input type="text" class="outras-cell" value="' + _outrasOpFmt(v) + '" '
            +  'data-cellref="' + cellRef + '" '
            +  'onblur="outrasOpSetVal(' + c.id + ',\'' + ym + '\',this.value)" '
            +  'onkeydown="if(event.key===\'Enter\'){event.preventDefault();this.blur();}"></td>';
    }
    bodyHtml += '<tr>'
      + '<td class="col-cat"><span class="dot" style="background:' + (c.cor || '#7C3AED') + '"></span>' + _extEsc(c.nome) + '</td>'
      + cells
      + '<td class="col-tot">' + _outrasOpFmt(totLinha) + '</td>'
      + '</tr>';
  }
  tbody.innerHTML = bodyHtml;
  // Footer com totais por mês + total geral
  const totGeral = totMes.reduce((a,b)=>a+b, 0);
  let footCells = '';
  for(let m=0;m<12;m++) footCells += '<td>' + _outrasOpFmt(totMes[m]) + '</td>';
  tfoot.innerHTML = '<tr><td class="col-cat">Total</td>' + footCells + '<td class="col-tot">' + _outrasOpFmt(totGeral) + '</td></tr>';
}

