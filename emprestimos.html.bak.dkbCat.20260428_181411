function extImpDownloadTemplate(){
  const headers = ['Data','Tipo','Descricao','Cliente/Fornecedor','Conta','Valor','Status','DataPagamento','Documento','CentroCusto','Categoria'];
  const today = new Date();
  const ymd = today.getFullYear() + '-' + String(today.getMonth()+1).padStart(2,'0') + '-' + String(today.getDate()).padStart(2,'0');
  const sample = [
    [ymd,'gasto','Aluguel escritório','Imobiliária XYZ','Itaú PJ','3500,00','pago',ymd,'NF-1234','Estrutura','Aluguel'],
    [ymd,'ganho','Pagamento cliente ABC','ABC Ltda','Bradesco','12000,00','pago',ymd,'NF-5678','Receita Operacional','Serviço'],
    [ymd,'gasto','Combustível','Posto Shell','Caixa','250,50','pendente','','BL-99','Estrutura','Transporte'],
    [ymd,'transferencia','Transferência interna','','Itaú PJ','1500,00','pago',ymd,'','','']
  ];
  const sep = ';';
  const lines = [headers.join(sep)];
  for(const r of sample) lines.push(r.map(v => String(v).includes(sep) ? '"' + v.replace(/"/g,'""') + '"' : v).join(sep));
  const csv = '\ufeff' + lines.join('\r\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'forekash-modelo.csv';
  document.body.appendChild(a); a.click();
  setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
}
