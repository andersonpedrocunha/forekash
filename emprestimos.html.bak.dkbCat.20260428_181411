    // Percentual literal: converte "N%" em "(N/100)"
    s = s.replace(/(\d+(?:\.\d+)?)%/g, '($1/100)');
    // eslint-disable-next-line no-new-func
    const fn = new Function('Math', 'return ('+s+');');
    const v = fn(Math);
    if(typeof v !== 'number' || !isFinite(v)) return {ok:false, value:''};
