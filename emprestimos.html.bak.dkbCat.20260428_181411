  try{
    const raw = localStorage.getItem(DIAG_KEY);
    if(raw){ diagHistory = JSON.parse(raw) || []; }
  }catch(e){ diagHistory = []; }
}
function diagSave(){
  try{ localStorage.setItem(DIAG_KEY, JSON.stringify(diagHistory.slice(0,20))); }catch(e){}
}

// ---------- Snapshot: coleta dados crus ----------
function diagSnapshot(){
  const now = new Date();
  const curYear  = String(now.getFullYear());
  const prevYear = String(now.getFullYear() - 1);
  const curMIdx  = now.getMonth();
  // Meses fechados: anteriores ao corrente. O mes atual ainda esta em curso = projecao.
  // Ex.: hoje=27/abr -> curMIdx=3 (abr), closedMIdx=2 (mar) -> realizados: jan,fev,mar.
  const closedMIdx = curMIdx - 1;
  const nClosed    = Math.max(0, closedMIdx + 1);

  const snap = {
    ts: now.toISOString(),
    curYear, prevYear, curMIdx,
    closedMIdx, nClosed,
    receita: { anual: 0, anualPrev: 0, porCliente: [], porMes: new Array(12).fill(0),
               porMesPrev: new Array(12).fill(0), clientesAtivos: 0, clientesInativos: 0,
               totalRecebido: 0, totalEmAberto: 0, totalAtrasado: 0, totalFuturo: 0,
               realizadoAno: 0, projetadoAno: 0, realizadoAnoPrevSamePeriod: 0 },
    pessoas: { headcount: 0, folhaAno: 0, folhaAnoPrev: 0, folhaMes: 0, custoMedio: 0,
               porTipo: {}, porMes: new Array(12).fill(0),
               realizadoAno: 0, projetadoAno: 0 },
    estrutura:{ totalAno: 0, totalAnoPrev: 0, totalPago: 0, totalProjetado: 0,
                porMes: new Array(12).fill(0), itens: 0,
                realizadoAno: 0, projetadoAnoCalend: 0 },
    impostos:{ totalCorrente: 0, totalParcelamento: 0, totalPago: 0, totalProjetado: 0,
               porMes: new Array(12).fill(0),
               realizadoAno: 0, projetadoAnoCalend: 0 },
    emprestimos:{ saldo: 0, parcelaMensal: 0, qtd: 0,
                  realizadoAno: 0, projetadoAno: 0,
                  porMes: new Array(12).fill(0),       // soma da parcela real mes a mes
                  porMesJuros: new Array(12).fill(0),  // juros mes a mes (split)
                  porMesAmort: new Array(12).fill(0),  // amortizacao mes a mes (split)
                  totalAno: 0, totalJurosAno: 0, totalAmortAno: 0 },
    dispo:{ saldoAtual: 0, contas: 0, contasAtivas: 0 },
    fluxo:{ saldoFinal: 0 }
  };

  // ---- Receita ----
  try{
    if(receita && receita.years){
      const d = receita.years[curYear];
      if(d){
        const allRows = [...(d.clients||[])];
        for(const r of allRows){
          let somaCli = 0;
          for(let i=0;i<12;i++){
            const k = REC_MESES[i];
            const c = r.meses && r.meses[k];
            if(!c) continue;
            const v = +c.valor || 0;
            if(!v) continue;
            snap.receita.anual += v;
            snap.receita.porMes[i] += v;
            somaCli += v;
            // Realizado: meses fechados (i <= closedMIdx). Projetado: mes corrente + futuros.
            if(i <= closedMIdx) snap.receita.realizadoAno += v;
            else                snap.receita.projetadoAno += v;
            if(c.status === 'recebido'){
              snap.receita.totalRecebido += v;
            } else {
              snap.receita.totalEmAberto += v;
              // Só é "atrasado" se a competência já passou ou é o mês corrente;
              // competências futuras são projeção, não problema de cobrança.
              if(i <= curMIdx) snap.receita.totalAtrasado += v;
              else              snap.receita.totalFuturo   += v;
            }
          }
          if(somaCli > 0){
            snap.receita.porCliente.push({ nome: (clienteView(r)||{}).nome || 'Cliente', valor: somaCli });
          }
        }
        // contagem de clientes ativos/inativos (entidade global em receita.clientes)
        const allCli = (receita && Array.isArray(receita.clientes)) ? receita.clientes : [];
        if(allCli.length > 0){
          for(const c of allCli){
            if(c.ativo === false) snap.receita.clientesInativos++;
            else                  snap.receita.clientesAtivos++;
          }
        } else {
          snap.receita.clientesAtivos = snap.receita.porCliente.length;
        }
      }
      // ano anterior
      const dPrev = receita.years[prevYear];
      if(dPrev){
        for(const r of (dPrev.clients||[])){
          for(let i=0;i<12;i++){
            const c = r.meses && r.meses[REC_MESES[i]];
            const v = c ? (+c.valor || 0) : 0;
            if(v){
              snap.receita.anualPrev += v;
              snap.receita.porMesPrev[i] += v;
              // Mesmo periodo do ano anterior (jan..closedMIdx) para YoY justo
              if(i <= closedMIdx) snap.receita.realizadoAnoPrevSamePeriod += v;
            }
          }
        }
      }
    }
  }catch(e){ console.warn('diag receita:',e); }

  // ---- Pessoas ----
  try{
    if(pessoas && pessoas.people){
      const active = pessoas.people.filter(p => p.ativo !== false);
      snap.pessoas.headcount = active.length;
      for(const p of active){
        let somaP = 0;
        for(let i=0;i<12;i++){
          const k = pesMesKey(curYear, i);
          const v = (typeof pesEffVal === 'function') ? (+pesEffVal(p,k) || 0) : (+(p.salarios||{})[k] || 0);
          if(v > 0){
            snap.pessoas.folhaAno += v;
            snap.pessoas.porMes[i] += v;
            somaP += v;
            if(i <= closedMIdx) snap.pessoas.realizadoAno += v;
            else                snap.pessoas.projetadoAno += v;
          }
        }
        // ano anterior
        for(let i=0;i<12;i++){
          const k = pesMesKey(prevYear, i);
          const v = (typeof pesEffVal === 'function') ? (+pesEffVal(p,k) || 0) : (+(p.salarios||{})[k] || 0);
          if(v > 0) snap.pessoas.folhaAnoPrev += v;
        }
        // tipo
        const tipoId = p.tipoId || 'sem';
        snap.pessoas.porTipo[tipoId] = (snap.pessoas.porTipo[tipoId]||0) + somaP;
      }
      // folha do mês corrente
      const curKey = pesMesKey(curYear, curMIdx);
      for(const p of active){
        const v = (typeof pesEffVal === 'function') ? (+pesEffVal(p,curKey) || 0) : (+(p.salarios||{})[curKey] || 0);
        if(v > 0) snap.pessoas.folhaMes += v;
      }
      snap.pessoas.custoMedio = snap.pessoas.headcount > 0 ? (snap.pessoas.folhaAno / 12 / snap.pessoas.headcount) : 0;
    }
  }catch(e){ console.warn('diag pessoas:',e); }

  // ---- Estrutura de Custos ----
  try{
    if(estrutura && estrutura.itens){
      snap.estrutura.itens = estrutura.itens.length;
      for(const it of estrutura.itens){
        const pagos = it.pagos || {};
        for(let i=0;i<12;i++){
          const k = (typeof estMesKey === 'function') ? estMesKey(curYear,i) : (curYear+'-'+String(i+1).padStart(2,'0'));
          const v = +((it.valores||{})[k]) || 0;
          if(!v) continue;
          snap.estrutura.totalAno += v;
          snap.estrutura.porMes[i] += v;
          if(pagos[k]) snap.estrutura.totalPago += v;
          else         snap.estrutura.totalProjetado += v;
          if(i <= closedMIdx) snap.estrutura.realizadoAno += v;
          else                snap.estrutura.projetadoAnoCalend += v;
        }
        // ano anterior
        for(let i=0;i<12;i++){
          const k = (typeof estMesKey === 'function') ? estMesKey(prevYear,i) : (prevYear+'-'+String(i+1).padStart(2,'0'));
          const v = +((it.valores||{})[k]) || 0;
          if(v) snap.estrutura.totalAnoPrev += v;
        }
      }
    }
  }catch(e){ console.warn('diag estrutura:',e); }

  // ---- Impostos ----
  try{
    if(impostos && Array.isArray(impostos.correntes)){
      for(const row of impostos.correntes){
        if(!row) continue;
        const pagos = row.pagos || {};
        const valores = row.valores || {};
        for(let i=0;i<12;i++){
          const k = curYear+'-'+String(i+1).padStart(2,'0');
          const v = +(valores[k]) || 0;
          if(!v) continue;
          snap.impostos.totalCorrente += v;
          snap.impostos.porMes[i] += v;
          if(pagos[k]) snap.impostos.totalPago += v;
          else         snap.impostos.totalProjetado += v;
          if(i <= closedMIdx) snap.impostos.realizadoAno += v;
          else                snap.impostos.projetadoAnoCalend += v;
        }
      }
    }
    // Soma também os parcelamentos (parcela mensal × 12 meses, somente meses ativos)
    if(impostos && Array.isArray(impostos.parcelamentos)){
      for(const p of impostos.parcelamentos){
        if(!p || p.ativo === false) continue;
        const parcMes = parseFloat(p.parcelaMensal) || 0;
        for(let i=0;i<12;i++){
          if(parcMes > 0){
            snap.impostos.totalCorrente += parcMes;
            snap.impostos.porMes[i] += parcMes;
            snap.impostos.totalProjetado += parcMes;
            if(i <= closedMIdx) snap.impostos.realizadoAno += parcMes;
            else                snap.impostos.projetadoAnoCalend += parcMes;
          }
        }
      }
    }
  }catch(e){ console.warn('diag impostos:',e); }

  // ---- Empréstimos ----
  // Lê a parcela REAL mês a mês usando _flxLoanParcelaMes (idem aba Evolução),
  // que considera SAC decrescente, Price fixo, carência, registros efetivados
  // e fim de contrato. Antes era parcelaVal × 12 — superestimava SAC.
  try{
    const loanArr = (typeof loans !== 'undefined' && Array.isArray(loans))
      ? loans
      : (window.emprestimos && Array.isArray(window.emprestimos.loans))
        ? window.emprestimos.loans
        : (window.loans && Array.isArray(window.loans)) ? window.loans : [];
    const hasParcelaFn = typeof _flxLoanParcelaMes === 'function';
    const hasSplitFn   = typeof _flxLoanSplitMes === 'function';
    for(const l of loanArr){
      if(!l) continue;
      snap.emprestimos.qtd++;
      const saldoLn = parseFloat(l.saldo) || parseFloat(l.saldoAtual) || parseFloat(l.valor) || 0;
      snap.emprestimos.saldo += saldoLn;
      // Parcela atual (mês corrente) — para compat com indicadores que ainda usam isso
      const parcLn = parseFloat(l.parcelaVal) || parseFloat(l.parcela) || 0;
      snap.emprestimos.parcelaMensal += parcLn;
      // Parcela REAL mês a mês neste ano calendário
      if(hasParcelaFn){
        for(let m=0;m<12;m++){
          let pm = 0;
          try { pm = _flxLoanParcelaMes(l, curYear, m) || 0; } catch(_){}
          snap.emprestimos.porMes[m] += pm;
          snap.emprestimos.totalAno   += pm;
          if(m <= closedMIdx) snap.emprestimos.realizadoAno += pm;
          else                snap.emprestimos.projetadoAno += pm;
          // Split juros/amortizacao (se função disponível)
          if(hasSplitFn){
            try {
              const sp = _flxLoanSplitMes(l, curYear, m) || {juros:0, amort:0};
              snap.emprestimos.porMesJuros[m] += (sp.juros||0);
              snap.emprestimos.porMesAmort[m] += (sp.amort||0);
              snap.emprestimos.totalJurosAno  += (sp.juros||0);
              snap.emprestimos.totalAmortAno  += (sp.amort||0);
            } catch(_){}
          }
        }
      }
    }
    // Fallback se a função de parcela mensal não estiver disponível
    if(!hasParcelaFn){
      snap.emprestimos.totalAno     = snap.emprestimos.parcelaMensal * 12;
      snap.emprestimos.realizadoAno = snap.emprestimos.parcelaMensal * Math.max(0, nClosed);
      snap.emprestimos.projetadoAno = snap.emprestimos.parcelaMensal * Math.max(0, 12 - nClosed);
      for(let m=0;m<12;m++) snap.emprestimos.porMes[m] = snap.emprestimos.parcelaMensal;
    }
    // Média mensal projetada do restante do ano (mês corrente em diante)
    if(snap.nClosed != null && snap.nClosed < 12){
      const rest = 12 - snap.nClosed;
      snap.emprestimos.parcelaProjMediaMes = snap.emprestimos.projetadoAno / Math.max(1, rest);
    } else {
      snap.emprestimos.parcelaProjMediaMes = snap.emprestimos.parcelaMensal;
    }
    // Próximas 12 parcelas (rolling) a partir do mês corrente — útil pra DSCR forward
    if(hasParcelaFn){
      let next12 = 0;
      const startY = parseInt(curYear,10);
      for(let k=0; k<12; k++){
        const mAbs = curMIdx + k;
        const yk = startY + Math.floor(mAbs/12);
        const mk = mAbs % 12;
        for(const l of loanArr){
          try { next12 += _flxLoanParcelaMes(l, String(yk), mk) || 0; } catch(_){}
        }
      }
      snap.emprestimos.parcelaForward12 = next12;
    }
  }catch(e){ console.warn('diag emprestimos:',e); }

  // ---- Disponibilidades ----
  try{
    if(dispo && Array.isArray(dispo.contas)){
      for(const c of dispo.contas){
        if(c.ativo !== false) snap.dispo.contasAtivas++;
        snap.dispo.contas++;
        if(c.ativo === false) continue;
        const saldos = c.saldos || {};
        // Procura último saldo não-zero em qualquer mês até o atual (ano atual primeiro, depois retroage anos)
        let lastV = 0;
        // 1) Ano atual: do mês atual pra trás
        for(let i=curMIdx;i>=0;i--){
          const k = curYear+'-'+String(i+1).padStart(2,'0');
          const v = parseFloat(saldos[k]);
          if(isFinite(v) && v !== 0){ lastV = v; break; }
        }
        // 2) Se não achou, pega o último saldo registrado em QUALQUER chave (ordenada desc)
        if(lastV === 0){
          const keys = Object.keys(saldos).sort().reverse();
          for(const k of keys){
            const v = parseFloat(saldos[k]);
            if(isFinite(v) && v !== 0){ lastV = v; break; }
          }
        }
        snap.dispo.saldoAtual += lastV;
      }
    }
  }catch(e){ console.warn('diag dispo:',e); }

  return snap;
}

// ---------- Indicators: derivados ----------
function diagIndicators(snap){
  const ind = {};
  const rec = snap.receita, pes = snap.pessoas, est = snap.estrutura, imp = snap.impostos;
  const cur = snap.curMIdx;

  // Quantidade de meses fechados (Jan..closedMIdx). Resto eh projecao.
  const nClosed = snap.nClosed != null ? snap.nClosed : Math.max(0, snap.curMIdx);

  // Crescimento YoY receita: comparar mesmo periodo realizado vs equivalente do ano anterior
  // (evita misturar realizado + projecao no numerador e ano cheio no denominador).
  const recRealAtual = rec.realizadoAno || 0;
  const recRealPrev  = rec.realizadoAnoPrevSamePeriod || 0;
  if(nClosed > 0 && recRealPrev > 0){
    ind.recYoY = ((recRealAtual - recRealPrev) / recRealPrev) * 100;
    ind.recYoYBase = 'realizado-vs-mesmo-periodo';
  } else if(rec.anualPrev > 0){
    ind.recYoY = ((rec.anual - rec.anualPrev) / rec.anualPrev) * 100;
    ind.recYoYBase = 'anual-completo';
  } else {
    ind.recYoY = null;
    ind.recYoYBase = null;
  }
  ind.folhaYoY    = pes.folhaAnoPrev > 0 ? ((pes.folhaAno - pes.folhaAnoPrev)/pes.folhaAnoPrev)*100 : null;
  ind.estYoY      = est.totalAnoPrev > 0 ? ((est.totalAno - est.totalAnoPrev)/est.totalAnoPrev)*100 : null;

  // Concentração cliente
  const cliSorted = [...rec.porCliente].sort((a,b)=>b.valor-a.valor);
  ind.topCliente  = cliSorted[0] || null;
  ind.concentracao = (ind.topCliente && rec.anual>0) ? (ind.topCliente.valor/rec.anual)*100 : 0;
  ind.top3Share   = (rec.anual>0) ? (cliSorted.slice(0,3).reduce((s,c)=>s+c.valor,0)/rec.anual)*100 : 0;
  ind.nClientes   = cliSorted.length;
  ind.ticketMedio = (cliSorted.length>0) ? (rec.anual/cliSorted.length) : 0;

  // Razões de custo
  // Empréstimos: usa o total real anual (varia mes a mes em SAC) em vez de parcelaMensal × 12
  const _empAno = (snap.emprestimos.totalAno > 0)
    ? snap.emprestimos.totalAno
    : (snap.emprestimos.parcelaMensal * 12);
  ind.custoTotalAno = pes.folhaAno + est.totalAno + imp.totalCorrente + _empAno;
  ind.empAno = _empAno;
  // ===== MARGEM ANUAL (realizado + projecao) =====
  ind.margemOpAno  = rec.anual>0 ? ((rec.anual - ind.custoTotalAno)/rec.anual)*100 : null;

  // ===== MARGEM REALIZADA (somente meses fechados) =====
  const _nClosed = snap.nClosed != null ? snap.nClosed : 0;
  if(_nClosed > 0){
    const recR  = rec.realizadoAno || 0;
    const custR = (pes.realizadoAno||0) + (est.realizadoAno||0) + (imp.realizadoAno||0) + (snap.emprestimos.realizadoAno||0);
    ind.custoTotalReal = custR;
    ind.recRealAno     = recR;
    ind.margemOpReal   = recR > 0 ? ((recR - custR)/recR)*100 : null;
    ind.pctFolhaReal     = recR>0 ? ((pes.realizadoAno||0)/recR)*100 : null;
    ind.pctEstruturaReal = recR>0 ? ((est.realizadoAno||0)/recR)*100 : null;
    ind.pctImpostosReal  = recR>0 ? ((imp.realizadoAno||0)/recR)*100 : null;
    ind.pctEmprestimosReal = recR>0 ? ((snap.emprestimos.realizadoAno||0)/recR)*100 : null;
  } else {
    ind.margemOpReal = null;
  }
  // Percentuais ANUAIS (base receita anual prevista) - referencia primaria
  ind.pctFolha     = rec.anual>0 ? (pes.folhaAno/rec.anual)*100 : null;
  ind.pctEstrutura = rec.anual>0 ? (est.totalAno/rec.anual)*100 : null;
  ind.pctImpostos  = rec.anual>0 ? (imp.totalCorrente/rec.anual)*100 : null;
  ind.pctEmprestimos = rec.anual>0 ? (_empAno/rec.anual)*100 : null;

  // === MARGEM EQUILIBRADA: media ponderada entre realizado e anual ===
  // Realizado pesa pelo tempo decorrido; projecao pelo restante.
  if(ind.margemOpReal != null && ind.margemOpAno != null){
    const wReal = _nClosed / 12;
    const wProj = (12 - _nClosed) / 12;
    ind.margemOpEq = ind.margemOpReal * wReal + ind.margemOpAno * wProj;
    ind.margemOpBase = 'equilibrado';
  } else {
    ind.margemOpEq = ind.margemOpReal != null ? ind.margemOpReal : ind.margemOpAno;
    ind.margemOpBase = ind.margemOpReal != null ? 'realizado' : 'anual';
  }
  // margemOp = principal (equilibrada): NAO privilegia um cenario sobre o outro
  ind.margemOp = ind.margemOpEq;

  // Tendência últimos meses: usa apenas meses FECHADOS para evitar projecao na media.
  // Janela de 3 meses fechados mais recentes vs 3 anteriores a esses.
  const meses = rec.porMes;
  const closeI = (snap.closedMIdx != null) ? snap.closedMIdx : (snap.curMIdx - 1);
  const ult3 = [meses[closeI-2]||0, meses[closeI-1]||0, meses[closeI]||0];
  const pre3 = [meses[closeI-5]||0, meses[closeI-4]||0, meses[closeI-3]||0];
  const avgU = (ult3[0]+ult3[1]+ult3[2])/3;
  const avgP = (pre3[0]+pre3[1]+pre3[2])/3;
  ind.tendencia = avgP>0 ? ((avgU - avgP)/avgP)*100 : null;
  ind.recUlt3   = avgU;

  // === Burn HISTORICO baseado APENAS em meses fechados ===
  // Receita realizada por mes (media dos meses fechados)
  const recRealMes = nClosed > 0 ? (rec.realizadoAno || 0) / nClosed : 0;
  // Custo realizado por mes (folha + estrutura + impostos + servico de divida realizado)
  const custoRealAno = (pes.realizadoAno || 0)
                     + (est.realizadoAno || 0)
                     + (imp.realizadoAno || 0)
                     + (snap.emprestimos.realizadoAno || 0);
  const custoRealMes = nClosed > 0 ? custoRealAno / nClosed : 0;
  ind.recRealMes   = recRealMes;
  ind.custoRealMes = custoRealMes;
  ind.nClosed      = nClosed;
  // Burn liquido HISTORICO: consumo medio dos meses fechados
  const burnMes = nClosed > 0
    ? (custoRealMes - recRealMes)
    : (ind.custoTotalAno / 12 - rec.anual/12); // fallback se nao houver mes fechado
  ind.burnMes = burnMes;
  ind.runwayMeses = burnMes > 0 && snap.dispo.saldoAtual > 0 ? (snap.dispo.saldoAtual / burnMes) : null;

  // === Burn PROJETADO usando ML forecasts dos proximos meses ===
  try {
    const fc = (typeof window !== 'undefined' && window.__diagML && window.__diagML.forecast) ? window.__diagML.forecast : null;
    const fcMean = (f) => (f && f.forecast && f.forecast.length > 0)
      ? f.forecast.reduce((a,b)=>a+b,0) / f.forecast.length
      : null;
    const recProjMes = fc ? (fcMean(fc.receita) || recRealMes) : recRealMes;
    const folProjMes = fc ? (fcMean(fc.folha)     || (pes.folhaMes || 0)) : (pes.folhaMes || 0);
    const estProjMes = fc ? (fcMean(fc.estrutura) || (est.realizadoAno && nClosed ? est.realizadoAno/nClosed : 0)) : (est.realizadoAno && nClosed ? est.realizadoAno/nClosed : 0);
    const impProjMes = fc ? (fcMean(fc.impostos)  || (imp.realizadoAno && nClosed ? imp.realizadoAno/nClosed : 0)) : (imp.realizadoAno && nClosed ? imp.realizadoAno/nClosed : 0);
    const empProjMes = (snap.emprestimos.parcelaMensal || 0);
    ind.recProjMes   = recProjMes;
    ind.custoProjMes = folProjMes + estProjMes + impProjMes + empProjMes;
    ind.burnProjMes  = ind.custoProjMes - recProjMes;
    // Liquidez = saldo + recebiveis pendentes (em aberto + atrasado)
    const recebiveis = (snap.receita.totalEmAberto || 0) + (snap.receita.totalAtrasado || 0);
    ind.recebiveisPendentes = recebiveis;
    ind.liquidezProj = (snap.dispo.saldoAtual || 0) + recebiveis;
    if(ind.burnProjMes > 0 && ind.liquidezProj > 0){
      ind.runwayProjMeses = ind.liquidezProj / ind.burnProjMes;
    } else if(ind.burnProjMes <= 0){
      ind.runwayProjMeses = Infinity; // operacao gera caixa
    } else {
      ind.runwayProjMeses = null;
    }
  } catch(e){ console.warn('diag burnProj:', e); ind.runwayProjMeses = null; }

  // === ANALISE DE DIVIDA (empréstimos) ===
  const emp = snap.emprestimos || {};
  ind.divQtd        = emp.qtd || 0;
  ind.divSaldo      = emp.saldo || 0;
  ind.divParcelaMes = emp.parcelaMensal || 0;
  // % serviço da dívida / receita anual (capacidade de pagamento ao longo do ano)
  // Usa o total ANUAL real (parcelas decrescem em SAC) em vez de parcelaMensal × 12.
  ind.divTotalAno = snap.emprestimos.totalAno || (ind.divParcelaMes * 12);
  ind.divParcelaProjMes = snap.emprestimos.parcelaProjMediaMes || ind.divParcelaMes;
  ind.divParcelaForward12 = snap.emprestimos.parcelaForward12 || (ind.divParcelaMes * 12);
  if(rec.anual > 0){
    ind.divPctReceitaAno = (ind.divTotalAno / rec.anual) * 100;
  }
  if(recRealMes > 0){
    // Para o realizado, usa media das parcelas dos meses fechados
    const realPar = nClosed > 0 ? (snap.emprestimos.realizadoAno || 0) / nClosed : ind.divParcelaMes;
    ind.divPctReceitaReal = (realPar / recRealMes) * 100;
  }
  // % saldo devedor / receita anual (debt-to-revenue)
  if(rec.anual > 0){
    ind.divSaldoVsReceita = (ind.divSaldo / rec.anual) * 100;
  }
  // DSCR (Debt Service Coverage Ratio) = EBITDA / Servico da divida
  // EBITDA aprox = receita - folha - estrutura - impostos (sem dividas)
  if(nClosed > 0){
    const ebitdaRealMes = recRealMes - (pes.realizadoAno||0)/nClosed - (est.realizadoAno||0)/nClosed - (imp.realizadoAno||0)/nClosed;
    ind.ebitdaRealMes = ebitdaRealMes;
    if(ind.divParcelaMes > 0){
      ind.dscrReal = ebitdaRealMes / ind.divParcelaMes;
    } else {
      ind.dscrReal = null; // sem divida = nao se aplica
    }
  }
  // DSCR projetado
  if(ind.recProjMes != null && ind.recProjMes > 0){
    const fc = (typeof window !== 'undefined' && window.__diagML && window.__diagML.forecast) ? window.__diagML.forecast : null;
    const folMes = fc && fc.folha && fc.folha.forecast.length ? fc.folha.forecast.reduce((a,b)=>a+b,0)/fc.folha.forecast.length : (pes.folhaMes||0);
    const estMes = fc && fc.estrutura && fc.estrutura.forecast.length ? fc.estrutura.forecast.reduce((a,b)=>a+b,0)/fc.estrutura.forecast.length : ((est.realizadoAno||0)/Math.max(1,nClosed));
    const impMes = fc && fc.impostos && fc.impostos.forecast.length ? fc.impostos.forecast.reduce((a,b)=>a+b,0)/fc.impostos.forecast.length : ((imp.realizadoAno||0)/Math.max(1,nClosed));
    const ebitdaProjMes = ind.recProjMes - folMes - estMes - impMes;
    ind.ebitdaProjMes = ebitdaProjMes;
    if(ind.divParcelaProjMes > 0){
      // DSCR projetado usa parcela MÉDIA dos meses futuros (pode ser menor que a atual em SAC)
      ind.dscrProj = ebitdaProjMes / ind.divParcelaProjMes;
    } else if(ind.divParcelaMes > 0){
      ind.dscrProj = ebitdaProjMes / ind.divParcelaMes;
    }
  }
  // Meses para quitar (saldo / parcela media projetada) — heuristico, ignora juros
  // Em SAC a parcela média futura é menor, então o tempo é mais longo.
  if(ind.divParcelaProjMes > 0 && ind.divSaldo > 0){
    ind.divMesesQuitar = ind.divSaldo / ind.divParcelaProjMes;
  } else if(ind.divParcelaMes > 0 && ind.divSaldo > 0){
    ind.divMesesQuitar = ind.divSaldo / ind.divParcelaMes;
  }

  // Meses sem receita lançada: apenas entre os meses FECHADOS
  ind.mesesSemReceita = nClosed > 0 ? meses.slice(0, nClosed).filter(v => v===0).length : 0;

  // % Receita recebida vs projetada
  ind.pctRecebido = (rec.totalRecebido+rec.totalEmAberto)>0
    ? (rec.totalRecebido/(rec.totalRecebido+rec.totalEmAberto))*100 : null;

  // Score composto (0-100)
  let score = 50, reasons = [];
  if(ind.margemOp != null){
    if(ind.margemOp > 25)      { score += 18; reasons.push({k:'margem',good:true,txt:`margem operacional saudável (${ind.margemOp.toFixed(1)}%)`}); }
    else if(ind.margemOp > 10) { score += 6;  reasons.push({k:'margem',good:true,txt:`margem operacional razoável (${ind.margemOp.toFixed(1)}%)`}); }
    else if(ind.margemOp > 0)  { score -= 5;  reasons.push({k:'margem',good:false,txt:`margem operacional apertada (${ind.margemOp.toFixed(1)}%)`}); }
    else                       { score -= 20; reasons.push({k:'margem',good:false,txt:`margem operacional negativa (${ind.margemOp.toFixed(1)}%)`}); }
  }
  if(ind.recYoY != null){
    if(ind.recYoY > 15)      { score += 12; reasons.push({k:'crescimento',good:true,txt:`receita crescendo ${ind.recYoY.toFixed(1)}% vs ano anterior`}); }
    else if(ind.recYoY > 0)  { score += 4;  reasons.push({k:'crescimento',good:true,txt:`receita em alta de ${ind.recYoY.toFixed(1)}% vs ano anterior`}); }
    else if(ind.recYoY > -10){ score -= 6;  reasons.push({k:'crescimento',good:false,txt:`receita em queda de ${Math.abs(ind.recYoY).toFixed(1)}% vs ano anterior`}); }
    else                     { score -= 16; reasons.push({k:'crescimento',good:false,txt:`queda forte de receita (${Math.abs(ind.recYoY).toFixed(1)}%) vs ano anterior`}); }
  }
  if(ind.concentracao > 50) { score -= 10; reasons.push({k:'concentracao',good:false,txt:`alta concentração em ${ind.topCliente.nome} (${ind.concentracao.toFixed(0)}% da receita)`}); }
  else if(ind.concentracao > 30){ score -= 4; reasons.push({k:'concentracao',good:false,txt:`concentração relevante em ${ind.topCliente.nome} (${ind.concentracao.toFixed(0)}%)`}); }
  if(ind.pctFolha != null){
    if(ind.pctFolha > 60)     { score -= 10; reasons.push({k:'folha',good:false,txt:`folha muito pesada (${ind.pctFolha.toFixed(0)}% da receita)`}); }
    else if(ind.pctFolha < 35){ score += 5;  reasons.push({k:'folha',good:true,txt:`folha sob controle (${ind.pctFolha.toFixed(0)}% da receita)`}); }
  }
  if(ind.runwayMeses != null && ind.runwayMeses < 3){
    score -= 15; reasons.push({k:'runway',good:false,txt:`caixa projetado para apenas ${ind.runwayMeses.toFixed(1)} meses`});
  } else if(ind.runwayMeses != null && ind.runwayMeses > 12){
    score += 8; reasons.push({k:'runway',good:true,txt:`runway confortável de ${ind.runwayMeses.toFixed(0)}+ meses`});
  }
  // Runway projetado — pondera com forecasts
  if(ind.runwayProjMeses != null && isFinite(ind.runwayProjMeses)){
    if(ind.runwayProjMeses < 3){
      score -= 12; reasons.push({k:'runway-proj',good:false,txt:`projeção: caixa + recebíveis cobrem apenas ${ind.runwayProjMeses.toFixed(1)} meses do burn projetado`});
    } else if(ind.runwayProjMeses > 18){
      score += 5; reasons.push({k:'runway-proj',good:true,txt:`projeção saudável: ${ind.runwayProjMeses.toFixed(0)}+ meses com recebíveis e custos futuros`});
    }
    if(ind.burnProjMes != null && burnMes != null && burnMes !== 0){
      const piorou = (ind.burnProjMes - burnMes) / Math.abs(burnMes);
      if(piorou > 0.15){
        score -= 8; reasons.push({k:'burn-proj',good:false,txt:`burn projetado ${(piorou*100).toFixed(0)}% maior que histórico — deterioração`});
      } else if(piorou < -0.15){
        score += 5; reasons.push({k:'burn-proj',good:true,txt:`burn projetado ${Math.abs(piorou*100).toFixed(0)}% menor que histórico — melhorando`});
      }
    }
  }
  if(ind.tendencia != null){
    if(ind.tendencia > 10)      { score += 6; reasons.push({k:'tendencia',good:true,txt:`tendência recente de alta (+${ind.tendencia.toFixed(0)}% últ. trimestre)`}); }
    else if(ind.tendencia < -10){ score -= 8; reasons.push({k:'tendencia',good:false,txt:`tendência recente de queda (${ind.tendencia.toFixed(0)}% últ. trimestre)`}); }
  }
  // === DIVIDA: ponderacao no score ===
  if(ind.divQtd > 0){
    // DSCR realizado (capacidade de pagar a divida com EBITDA realizado)
    if(ind.dscrReal != null && isFinite(ind.dscrReal)){
      if(ind.dscrReal >= 2.5)      { score += 8; reasons.push({k:'divida',good:true,txt:`DSCR ${ind.dscrReal.toFixed(2)}× — EBITDA realizado cobre folgadamente o serviço da dívida`}); }
      else if(ind.dscrReal >= 1.5) { score += 3; reasons.push({k:'divida',good:true,txt:`DSCR ${ind.dscrReal.toFixed(2)}× — EBITDA realizado cobre o serviço da dívida com folga adequada`}); }
      else if(ind.dscrReal >= 1.0) { score -= 4; reasons.push({k:'divida',good:false,txt:`DSCR ${ind.dscrReal.toFixed(2)}× — cobrindo a dívida sem folga (zona de atenção)`}); }
      else if(ind.dscrReal >= 0)   { score -= 12; reasons.push({k:'divida',good:false,txt:`DSCR ${ind.dscrReal.toFixed(2)}× — EBITDA realizado insuficiente para o serviço da dívida`}); }
      else                          { score -= 18; reasons.push({k:'divida',good:false,txt:`DSCR negativo — EBITDA realizado não cobre nem custos básicos antes da dívida`}); }
    }
    // % da parcela vs receita anual
    if(ind.divPctReceitaAno != null){
      if(ind.divPctReceitaAno > 25)      { score -= 10; reasons.push({k:'divida-pct',good:false,txt:`serviço da dívida consome ${ind.divPctReceitaAno.toFixed(0)}% da receita anual — alavancagem alta`}); }
      else if(ind.divPctReceitaAno > 15) { score -= 5;  reasons.push({k:'divida-pct',good:false,txt:`serviço da dívida em ${ind.divPctReceitaAno.toFixed(0)}% da receita anual — atenção à alavancagem`}); }
      else if(ind.divPctReceitaAno > 0 && ind.divPctReceitaAno < 8){ score += 3; reasons.push({k:'divida-pct',good:true,txt:`serviço da dívida controlado (${ind.divPctReceitaAno.toFixed(0)}% da receita)`}); }
    }
    // saldo devedor vs receita anual (alavancagem total)
    if(ind.divSaldoVsReceita != null && ind.divSaldoVsReceita > 100){
      score -= 8; reasons.push({k:'divida-saldo',good:false,txt:`saldo devedor (${ind.divSaldoVsReceita.toFixed(0)}% da receita anual) supera o faturamento de 1 ano`});
    }
    // DSCR projetado deteriorando
    if(ind.dscrReal != null && ind.dscrProj != null && isFinite(ind.dscrProj)){
      if(ind.dscrProj < ind.dscrReal * 0.7 && ind.dscrProj < 1.5){
        score -= 4; reasons.push({k:'divida-proj',good:false,txt:`DSCR projetado deteriora (${ind.dscrProj.toFixed(2)}× vs ${ind.dscrReal.toFixed(2)}× realizado)`});
      }
    }
  }
  score = Math.max(0, Math.min(100, Math.round(score)));
  ind.score = score;
  ind.reasons = reasons;

  return ind;
}

// ---------- Rules: alertas ----------
function diagAlertas(snap, ind, ml){
  const out = [];
  const push = (sev,title,msg,ico) => out.push({sev,title,msg,ico:ico||''});

  // ---- Alertas derivados dos modelos de ML ----
  if(ml && ml.forecast){
    const rec = ml.forecast.receita;
    if(rec && rec.serie.length >= 6){
      const last3 = rec.serie.slice(-3).reduce((s,v)=>s+v,0)/3;
      const next3 = rec.forecast.slice(0,3).reduce((s,v)=>s+v,0)/3;
      const delta = last3 > 0 ? ((next3-last3)/last3)*100 : 0;
      const r2Pct = Math.round(rec.r2*100);
      if(delta < -8 && rec.r2 >= 0.3){
        push('sev-high','Modelo projeta queda de receita',
          `Regressão (R²=${rec.r2.toFixed(2)}) e Holt convergem para <b>${delta.toFixed(1)}%</b> de retração no próximo trimestre — de <b>${fmtBRL(last3)}</b>/mês para <b>${fmtBRL(next3)}</b>/mês. Antecipe: revisar pipeline, acelerar propostas abertas e adiar despesas não essenciais.`, '▼');
      } else if(delta < -3 && rec.r2 >= 0.2){
        push('sev-med','Tendência de leve queda projetada',
          `O ensemble LR+Holt indica <b>${delta.toFixed(1)}%</b> de queda nos próximos 3 meses (ajuste ${r2Pct>50?'razoável':'fraco'}: R²=${rec.r2.toFixed(2)}). Valide com o comercial antes de decisões irreversíveis.`);
      } else if(delta > 12 && rec.r2 >= 0.3){
        push('sev-ok','Modelo aponta crescimento projetado',
          `Ensemble projeta <b>+${delta.toFixed(1)}%</b> no próximo trimestre (R²=${rec.r2.toFixed(2)}). Janela favorável — reforce reserva e só aprove novas contratações com demanda sustentada.`, '▲');
      }
    }
    // Folha crescendo mais rápido que receita (comparando inclinações)
    const fol = ml.forecast.folha;
    if(rec && fol && rec.slope !== undefined && fol.slope !== undefined){
      const folLast = fol.serie[fol.serie.length-1] || 1;
      const recLast = rec.serie[rec.serie.length-1] || 1;
      const folGrowth = fol.slope/folLast*100;
      const recGrowth = rec.slope/recLast*100;
      if(folGrowth - recGrowth > 1.5 && folLast > 0){
        push('sev-med','Folha acelera mais que receita',
          `Inclinação da folha (${folGrowth>=0?'+':''}${folGrowth.toFixed(1)}%/mês) supera a da receita (${recGrowth>=0?'+':''}${recGrowth.toFixed(1)}%/mês). Mantido esse ritmo, a margem será pressionada nos próximos trimestres.`);
      }
    }
  }
  // Anomalias notáveis → alerta contextual
  if(ml && ml.anomalies && ml.anomalies.length > 0){
    const top = ml.anomalies[0];
    if(Math.abs(top.z) >= 2.5){
      push(top.tipo==='alta' ? 'sev-low' : 'sev-med',
        `Anomalia em ${top.label.toLowerCase()}`,
        `<b>${top.mesLbl}</b>: <b>${fmtBRL(top.valor)}</b> ficou <b>${top.z.toFixed(1)}σ</b> ${top.tipo==='alta'?'acima':'abaixo'} da média histórica (esperado <b>${fmtBRL(top.esperado)}</b>). Verifique se foi evento pontual ou uma mudança estrutural.`, top.tipo==='alta'?'▲':'▼');
    }
  }
  // Correlações preditivas (lead indicators)
  if(ml && ml.correlations && ml.correlations.length > 0){
    const lead = ml.correlations.find(c => c.lag !== 0 && Math.abs(c.r) >= 0.55);
    if(lead){
      const antec = lead.lag > 0 ? lead.labelA : lead.labelB;
      const result = lead.lag > 0 ? lead.labelB : lead.labelA;
      push('sev-low','Indicador antecedente detectado',
        `<b>${antec}</b> antecipa <b>${result}</b> em ${Math.abs(lead.lag)} ${Math.abs(lead.lag)===1?'mês':'meses'} (r=${lead.r.toFixed(2)}). Use ${antec.toLowerCase()} como alerta antecipado para planejar ${result.toLowerCase()}.`, '⟷');
    }
  }
  // Sazonalidade marcante → oportunidade / preparação
  if(ml && ml.seasonality && ml.seasonality.fortes && ml.seasonality.fortes.length > 0){
    const topForte = ml.seasonality.fortes[0];
    const topFraco = ml.seasonality.fracos[0];
    if(topForte.desvio > 15){
      push('sev-low','Padrão sazonal identificado',
        `<b>${topForte.mes}</b> historicamente fica <b>+${topForte.desvio.toFixed(0)}%</b> acima da tendência, enquanto <b>${topFraco.mes}</b> fica <b>${topFraco.desvio.toFixed(0)}%</b>. Ajuste o planejamento de caixa e campanhas em função desse ciclo — não use meta linear.`, '◴');
    }
  }

  if(ind.concentracao > 50){
    push('sev-high','Risco de concentração',`<b>${ind.topCliente.nome}</b> concentra <b>${ind.concentracao.toFixed(0)}%</b> da receita — exposição crítica. Se esse contrato reduzir ou encerrar, o impacto no caixa é severo. Diversificar a carteira é prioridade estratégica.`, '!');
  } else if(ind.concentracao > 30){
    push('sev-med','Concentração elevada',`<b>${ind.topCliente.nome}</b> responde por <b>${ind.concentracao.toFixed(0)}%</b> da receita — acima do saudável (20-25%). Priorize aquisição de novos clientes grandes para reduzir dependência.`, '!');
  }

  if(ind.margemOpReal != null && ind.margemOpReal < 0){
    const recR = snap.receita.realizadoAno || 0;
    const mesAte = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'][snap.closedMIdx];
    push('sev-high','Operação deficitária no realizado',`Nos meses fechados (Jan&ndash;${mesAte}/${snap.curYear.slice(2)}), os custos (<b>${fmtBRL(ind.custoTotalReal||0)}</b>) superaram a receita realizada (<b>${fmtBRL(recR)}</b>) — margem realizada de <b>${ind.margemOpReal.toFixed(1)}%</b>. Ação imediata: revisar precificação, custos fixos e escopo de contratação.`, '✕');
  } else if(ind.margemOpAno != null && ind.margemOpAno < 0 && (ind.margemOpReal == null || ind.margemOpReal >= 0)){
    push('sev-med','Projeção anual deficitária',`A projeção do ano completo aponta custos (<b>${fmtBRL(ind.custoTotalAno)}</b>) acima da receita prevista (<b>${fmtBRL(snap.receita.anual)}</b>) — margem anual de <b>${ind.margemOpAno.toFixed(1)}%</b>. Ainda há ${12-(snap.nClosed||0)} ${(12-(snap.nClosed||0))===1?'mês':'meses'} para reverter o cenário; o realizado de Jan&ndash;${['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'][snap.closedMIdx]||'mar'} (${(ind.margemOpReal||0).toFixed(1)}%) sugere capacidade operacional positiva.`);
  } else if(ind.margemOp != null && ind.margemOp < 10){
    push('sev-med','Margem apertada',`Margem operacional de <b>${ind.margemOp.toFixed(1)}%</b> deixa pouca gordura para imprevistos. Um cliente inadimplente ou aumento de custos pode zerar o resultado. Considere reajuste de preços ou redução dos 3 maiores custos fixos.`, '!');
  }

  if(ind.pctFolha != null && ind.pctFolha > 60){
    push('sev-high','Folha pesada',`A folha consome <b>${ind.pctFolha.toFixed(0)}%</b> da receita — qualquer oscilação comprime fortemente a margem. Avalie automação, redistribuição de funções ou adequação ao faturamento real.`, '!');
  } else if(ind.pctFolha != null && ind.pctFolha > 45){
    push('sev-med','Folha elevada',`Folha em <b>${ind.pctFolha.toFixed(0)}%</b> da receita está acima do saudável para serviços (<40%). Mantenha hiring freeze até o crescimento acomodar a estrutura.`);
  }

  if(ind.runwayMeses != null && ind.runwayMeses < 3){
    push('sev-high','Runway crítico',`No ritmo atual de queima, o caixa (<b>${fmtBRL(snap.dispo.saldoAtual)}</b>) suporta apenas <b>${ind.runwayMeses.toFixed(1)} meses</b> de operação. Antecipe recebíveis, corte despesas não essenciais e renegocie prazos.`, '✕');
  } else if(ind.runwayMeses != null && ind.runwayMeses < 6){
    push('sev-med','Runway curto',`Caixa cobre aprox. <b>${ind.runwayMeses.toFixed(1)} meses</b> de operação. Prepare plano de contingência caso a receita projetada atrase 30-60 dias.`);
  }
  // Risco projetado: avalia futuro considerando recebíveis pendentes + projeções de receita/custos
  if(ind.runwayProjMeses != null && isFinite(ind.runwayProjMeses)){
    if(ind.runwayProjMeses < 3){
      push('sev-high','Risco projetado crítico',
        `Considerando recebíveis pendentes (<b>${fmtBRL(ind.recebiveisPendentes||0)}</b>) e projeção de receita/custos para os próximos meses, o caixa cobriria apenas <b>${ind.runwayProjMeses.toFixed(1)} meses</b> de operação projetada. <b>Burn projetado:</b> ${fmtBRL(ind.burnProjMes||0)}/mês. Antecipe recebíveis ou ajuste custos urgentemente.`, '!');
    } else if(ind.runwayProjMeses < 6 && ind.runwayMeses != null && ind.runwayProjMeses < ind.runwayMeses * 0.75){
      push('sev-med','Projeção pior que histórico',
        `Cenário projetado deteriora vs histórico: caixa+recebíveis cobrem <b>${ind.runwayProjMeses.toFixed(1)} meses</b> projetados (vs <b>${ind.runwayMeses.toFixed(1)} meses</b> hoje). A combinação de receita esperada e custos futuros aponta para queima maior. Reveja precificação ou contratação planejada.`);
    }
  }
  // Burn projetado piorando significativamente
  if(ind.burnProjMes != null && ind.burnMes != null && ind.burnMes > 0){
    const piorou = (ind.burnProjMes - ind.burnMes) / Math.abs(ind.burnMes);
    if(piorou > 0.25){
      push('sev-med','Burn projetado em alta',
        `O ritmo de queima projetado (<b>${fmtBRL(ind.burnProjMes)}/mês</b>) é <b>${(piorou*100).toFixed(0)}% maior</b> que o histórico (${fmtBRL(ind.burnMes)}/mês). A projeção de custos+receita aponta deterioração nos próximos meses.`);
    }
  }

  if(ind.tendencia != null && ind.tendencia < -15){
    push('sev-med','Queda de receita recente',`A receita dos últimos 3 meses caiu <b>${Math.abs(ind.tendencia).toFixed(0)}%</b> vs o trimestre anterior. Investigue a causa: churn, sazonalidade, faturamento atrasado ou contratos que terminaram.`);
  }

  if(snap.receita.totalAtrasado > 0){
    // só levanta alerta se o ATRASADO (competência ≤ mês corrente) for relevante
    const atrasadoPct = snap.receita.anual > 0 ? (snap.receita.totalAtrasado/snap.receita.anual)*100 : 0;
    if(atrasadoPct >= 8){
      push('sev-med','Recebimentos em atraso',`<b>${fmtBRL(snap.receita.totalAtrasado)}</b> em receita já vencida (competência ≤ ${['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'][snap.curMIdx]}/${snap.curYear.slice(2)}) ainda não recebida — <b>${atrasadoPct.toFixed(0)}%</b> do faturamento anual. Reforce a cobrança e a conciliação.`);
    }
  }

  if(ind.folhaYoY != null && ind.recYoY != null && (ind.folhaYoY - (ind.recYoY||0)) > 15){
    push('sev-med','Folha cresce acima da receita',`Folha subiu <b>${ind.folhaYoY.toFixed(1)}%</b> enquanto receita subiu <b>${(ind.recYoY||0).toFixed(1)}%</b>. As contratações estão rodando à frente do crescimento — risco de compressão de margem nos próximos ciclos.`);
  }

  if(ind.mesesSemReceita > 2){
    push('sev-low','Meses com receita zerada',`<b>${ind.mesesSemReceita}</b> meses do ano corrente estão sem receita lançada. Verifique se há faturamento pendente de registro — dados incompletos distorcem o diagnóstico.`);
  }

  // ===== ALERTAS DE DIVIDA =====
  if(ind.divQtd > 0){
    // DSCR realizado abaixo de 1
    if(ind.dscrReal != null && ind.dscrReal < 1 && isFinite(ind.dscrReal)){
      push('sev-high','Capacidade de pagamento da dívida insuficiente',
        `O EBITDA realizado de <b>${fmtBRL(ind.ebitdaRealMes||0)}/mês</b> não cobre o serviço da dívida (parcela mensal de <b>${fmtBRL(ind.divParcelaMes)}</b>). DSCR realizado: <b>${ind.dscrReal.toFixed(2)}×</b>. Indicado: ≥ 1,5× — você está pagando dívida com caixa, não com geração de resultado. Renegocie prazo, busque carência ou amortize parcial com sobra de caixa para reduzir parcela.`,
        '!');
    } else if(ind.dscrReal != null && ind.dscrReal < 1.5 && isFinite(ind.dscrReal)){
      push('sev-med','DSCR apertado (cobertura sem folga)',
        `O EBITDA realizado cobre a dívida em <b>${ind.dscrReal.toFixed(2)}×</b> (saudável: ≥1,5×, ideal: ≥2×). Pequenas oscilações de receita ou aumento de custos podem comprometer a capacidade de pagamento.`);
    }
    // Saldo devedor alto vs receita
    if(ind.divSaldoVsReceita != null && ind.divSaldoVsReceita > 150){
      push('sev-high','Endividamento elevado',
        `Saldo devedor de <b>${fmtBRL(ind.divSaldo)}</b> equivale a <b>${ind.divSaldoVsReceita.toFixed(0)}% da receita anual prevista</b> (<b>${fmtBRL(snap.receita.anual)}</b>). Mais de 1,5× a receita anual é zona de risco — qualquer desaceleração comercial dificulta o serviço da dívida.`,
        '!');
    } else if(ind.divSaldoVsReceita != null && ind.divSaldoVsReceita > 80){
      push('sev-med','Alavancagem relevante',
        `Saldo devedor (<b>${fmtBRL(ind.divSaldo)}</b>) representa <b>${ind.divSaldoVsReceita.toFixed(0)}%</b> da receita anual. Faixa próxima do limite saudável (até 80%) — evite contrair novas linhas até reduzir o saldo atual.`);
    }
    // Parcela vs receita
    if(ind.divPctReceitaAno != null && ind.divPctReceitaAno > 25){
      push('sev-high','Serviço da dívida pesado',
        `As parcelas de empréstimos consomem <b>${ind.divPctReceitaAno.toFixed(0)}% da receita anual</b> — <b>${fmtBRL(ind.divTotalAno||0)}</b> distribuído ao longo do ano (parcela atual <b>${fmtBRL(ind.divParcelaMes)}/mês</b>${ind.divParcelaProjMes && Math.abs(ind.divParcelaProjMes-ind.divParcelaMes)>ind.divParcelaMes*0.03 ? `, média projetada ${fmtBRL(ind.divParcelaProjMes)}/mês` : ''}). Acima de 25% é insustentável a médio prazo. Renegociar prazos é prioridade.`,
        '!');
    }
    // DSCR projetado deteriorando
    if(ind.dscrReal != null && ind.dscrProj != null && isFinite(ind.dscrProj) && ind.dscrProj < ind.dscrReal * 0.75 && ind.dscrProj < 1.5){
      push('sev-med','DSCR projetado em deterioração',
        `Cobertura do serviço da dívida cai de <b>${ind.dscrReal.toFixed(2)}×</b> (realizado) para <b>${ind.dscrProj.toFixed(2)}×</b> (projetado), refletindo aumento de custos vs receita esperada. Antecipe-se: revise o pipeline ou negocie amortização extra com a sobra de caixa atual.`);
    }
    // Caso positivo: divida saudavel
    if(ind.dscrReal != null && ind.dscrReal >= 2.5 && ind.divPctReceitaAno != null && ind.divPctReceitaAno < 12){
      push('sev-ok','Endividamento saudável',
        `<b>${ind.divQtd}</b> empréstimo${ind.divQtd===1?'':'s'} ativo${ind.divQtd===1?'':'s'} com parcela de <b>${fmtBRL(ind.divParcelaMes)}/mês</b> (${ind.divPctReceitaAno.toFixed(0)}% da receita) — DSCR de <b>${ind.dscrReal.toFixed(2)}×</b>. Estrutura de capital confortável.`,
        '✓');
    }
  }

  if(snap.impostos.totalProjetado > 0 && snap.impostos.totalProjetado > snap.dispo.saldoAtual){
    push('sev-med','Impostos acima do caixa',`Impostos correntes em aberto (<b>${fmtBRL(snap.impostos.totalProjetado)}</b>) superam o caixa disponível (<b>${fmtBRL(snap.dispo.saldoAtual)}</b>). Provisione antecipadamente ou repriorize para evitar problema tributário.`);
  }

  // positivos
  if(ind.margemOp != null && ind.margemOp > 25 && ind.recYoY != null && ind.recYoY > 10){
    push('sev-ok','Momento saudável',`Margem de <b>${ind.margemOp.toFixed(1)}%</b> com crescimento de <b>+${ind.recYoY.toFixed(1)}%</b> — negócio em fase positiva. Janela favorável para investir em capacidade, marketing ou novos produtos.`, '✓');
  } else if(ind.margemOp != null && ind.margemOp > 20 && out.length === 0){
    push('sev-ok','Operação estável',`Margem de <b>${ind.margemOp.toFixed(1)}%</b> sem sinais críticos. Mantenha o monitoramento de concentração de clientes e eficiência de custos.`, '✓');
  }

  if(out.length === 0){
    push('sev-low','Dados insuficientes','Ainda não há volume histórico suficiente para alertas relevantes. Preencha mais dados (receita, folha, custos, impostos) e rode o diagnóstico novamente para refinar a análise.');
  }
  return out;
}

// ---------- Narrativa por área ----------
function diagNarrativa(snap, ind, ml){
  const fmt = v => fmtBRL(v);
  const sign = v => (v>=0?'+':'');

  const precif = [];
  if(ind.nClientes > 0){
    precif.push(`A carteira tem <b>${ind.nClientes} cliente${ind.nClientes===1?'':'s'}</b> ativo${ind.nClientes===1?'':'s'} com ticket médio anual de <b>${fmt(ind.ticketMedio)}</b>.`);
  }
  if(ind.topCliente){
    precif.push(`O maior cliente, <b>${ind.topCliente.nome}</b>, concentra <b>${ind.concentracao.toFixed(0)}%</b> da receita — os três maiores somam <b>${ind.top3Share.toFixed(0)}%</b>.`);
  }
  if(ml && ml.clusters){
    const anc = ml.clusters.summary[0];
    const tot = ml.clusters.summary.reduce((s,c)=>s+c.total,0);
    if(anc && anc.qtd > 0 && tot > 0){
      const pct = (anc.total/tot)*100;
      precif.push(`O K-Means identificou <b>${anc.qtd} cliente${anc.qtd===1?'':'s'} âncora</b> (centróide ${fmt(anc.centroid)}/ano) respondendo por <b>${pct.toFixed(0)}%</b> da receita — esse é o núcleo que o comercial precisa blindar.`);
    }
  }
  // Receita: separa realizado (meses fechados) de projecao (corrente + futuros)
  const recReal = snap.receita.realizadoAno || 0;
  const recProj = snap.receita.projetadoAno || 0;
  const nC      = snap.nClosed != null ? snap.nClosed : 0;
  if(nC > 0 && (recReal > 0 || recProj > 0)){
    const meta = `<b>${fmt(recReal)}</b> realizado nos ${nC} ${nC===1?'mês fechado':'meses fechados'}` + (recProj > 0 ? ` + <b>${fmt(recProj)}</b> em projeção (mês corrente + futuros)` : '');
    if(ind.recYoY != null){
      const cls = ind.recYoY >= 0 ? 'diag-hi-pos' : 'diag-hi-neg';
      const baseLbl = ind.recYoYBase === 'realizado-vs-mesmo-periodo' ? 'mesmo período do ano anterior' : 'ano anterior';
      precif.push(`Receita do ano: ${meta}. Variação <span class="${cls}">${sign(ind.recYoY)}${ind.recYoY.toFixed(1)}%</span> vs ${baseLbl}.`);
    } else {
      precif.push(`Receita do ano: ${meta}.`);
    }
  } else if(ind.recYoY != null){
    const cls = ind.recYoY >= 0 ? 'diag-hi-pos' : 'diag-hi-neg';
    precif.push(`A receita anual está em <b>${fmt(snap.receita.anual)}</b>, variação de <span class="${cls}">${sign(ind.recYoY)}${ind.recYoY.toFixed(1)}%</span> vs o ano anterior.`);
  } else if(snap.receita.anual > 0){
    precif.push(`A receita anual está em <b>${fmt(snap.receita.anual)}</b>. Sem dados do ano anterior para comparar o crescimento.`);
  }
  if(ind.tendencia != null){
    const cls = ind.tendencia >= 0 ? 'diag-hi-pos' : 'diag-hi-neg';
    precif.push(`Últimos 3 meses fechados: variação de <span class="${cls}">${sign(ind.tendencia)}${ind.tendencia.toFixed(0)}%</span> vs o trimestre anterior — ${ind.tendencia>=5?'momento positivo':(ind.tendencia<=-5?'sinal de alerta':'estável')}.`);
  }
  if(ml && ml.forecast && ml.forecast.receita){
    const rec = ml.forecast.receita;
    const next3 = rec.forecast.slice(0,3).reduce((s,v)=>s+v,0)/3;
    const next6 = rec.forecast.reduce((s,v)=>s+v,0)/rec.forecast.length;
    const r2Pct = Math.round(rec.r2*100);
    const cls = rec.slope >= 0 ? 'diag-hi-pos' : 'diag-hi-neg';
    precif.push(`O ensemble LR+Holt (R²=${rec.r2.toFixed(2)}, ${r2Pct>60?'ajuste forte':r2Pct>35?'ajuste moderado':'ajuste fraco'}) projeta média de <b>${fmt(next3)}</b>/mês no próximo trimestre e <b>${fmt(next6)}</b>/mês no semestre, com tendência <span class="${cls}">${rec.slope>=0?'+':''}${fmt(rec.slope)}/mês</span>.`);
  }
  if(ml && ml.seasonality){
    const forte = ml.seasonality.fortes[0];
    const fraco = ml.seasonality.fracos[0];
    if(forte && fraco && (forte.desvio > 10 || Math.abs(fraco.desvio) > 10)){
      precif.push(`A decomposição sazonal mostra <b>${forte.mes}</b> como pico (+${forte.desvio.toFixed(0)}% vs tendência) e <b>${fraco.mes}</b> como vale (${fraco.desvio.toFixed(0)}%). Calibre metas mensais pelos fatores sazonais, não por orçamento linear.`);
    }
  }
  if(ind.concentracao > 25){
    precif.push(`<b>Recomendação:</b> diversificar a carteira deve ser prioridade comercial. Dependência acima de 25% em um único cliente aumenta materialmente o risco do negócio.`);
  } else if(ind.recYoY != null && ind.recYoY < 0){
    precif.push(`<b>Recomendação:</b> revisar o pipeline comercial e a proposta de valor. Crescimento negativo costuma ter causas estruturais — uma análise de churn (clientes perdidos) ajuda a identificar a origem.`);
  }

  const custos = [];
  // Detalhamento de custo: ANUAL (referencia) + REALIZADO (lado a lado)
  custos.push(`<b>Custos anuais previstos (12 meses):</b> <b>${fmt(ind.custoTotalAno)}</b> — folha <b>${fmt(snap.pessoas.folhaAno)}</b> (${(ind.pctFolha||0).toFixed(0)}%), estrutura <b>${fmt(snap.estrutura.totalAno)}</b> (${(ind.pctEstrutura||0).toFixed(0)}%), impostos <b>${fmt(snap.impostos.totalCorrente)}</b> (${(ind.pctImpostos||0).toFixed(0)}%) e serviço da dívida <b>${fmt(ind.empAno||0)}</b> (${(ind.pctEmprestimos||0).toFixed(0)}%).`);
  if(ind.custoTotalReal != null && (snap.nClosed||0) > 0){
    custos.push(`<b>Custos realizados nos meses fechados:</b> <b>${fmt(ind.custoTotalReal)}</b> em ${snap.nClosed} ${snap.nClosed===1?'mês':'meses'} — folha <b>${fmt(snap.pessoas.realizadoAno||0)}</b> (${(ind.pctFolhaReal||0).toFixed(0)}%), estrutura <b>${fmt(snap.estrutura.realizadoAno||0)}</b> (${(ind.pctEstruturaReal||0).toFixed(0)}%), impostos <b>${fmt(snap.impostos.realizadoAno||0)}</b> (${(ind.pctImpostosReal||0).toFixed(0)}%), dívida <b>${fmt(snap.emprestimos.realizadoAno||0)}</b> (${(ind.pctEmprestimosReal||0).toFixed(0)}%).`);
  }
  if(ind.estYoY != null){
    const cls = ind.estYoY <= 0 ? 'diag-hi-pos' : 'diag-hi-neg';
    custos.push(`Estrutura de custos variou <span class="${cls}">${sign(ind.estYoY)}${ind.estYoY.toFixed(1)}%</span> vs o ano anterior.`);
  }
  // Comparativo Realizado x Projetado (margem)
  if(ind.margemOpReal != null && ind.margemOpAno != null){
    const clsR = ind.margemOpReal > 15 ? 'diag-hi-pos' : (ind.margemOpReal < 5 ? 'diag-hi-neg' : '');
    const clsP = ind.margemOpAno  > 15 ? 'diag-hi-pos' : (ind.margemOpAno  < 5 ? 'diag-hi-neg' : '');
    const lblR = ind.margemOpReal > 25 ? 'saudável' : ind.margemOpReal > 10 ? 'razoável' : ind.margemOpReal > 0 ? 'apertada' : 'negativa';
    const lblP = ind.margemOpAno  > 25 ? 'saudável' : ind.margemOpAno  > 10 ? 'razoável' : ind.margemOpAno  > 0 ? 'apertada' : 'negativa';
    custos.push(`<b>Margem operacional (EBIT)</b> — Realizado: <span class="${clsR}">${ind.margemOpReal.toFixed(1)}%</span> (${lblR}, com base em meses fechados) · Anual completo (incluindo projeção): <span class="${clsP}">${ind.margemOpAno.toFixed(1)}%</span> (${lblP}). ${Math.abs(ind.margemOpReal - ind.margemOpAno) > 8 ? 'A diferença entre as duas reflete custos previstos para os próximos meses ainda sem contrapartida de receita registrada — esses meses ainda podem ser influenciados por novos contratos ou ajustes de estrutura.' : 'As duas estão próximas — boa coerência entre realidade e projeção.'}`);
  } else if(ind.margemOpReal != null){
    const cls = ind.margemOpReal > 15 ? 'diag-hi-pos' : (ind.margemOpReal < 5 ? 'diag-hi-neg' : '');
    custos.push(`A margem operacional (EBIT) realizada nos meses fechados é <span class="${cls}">${ind.margemOpReal.toFixed(1)}%</span> — ${ind.margemOpReal > 25 ? 'saudável' : ind.margemOpReal > 10 ? 'razoável' : ind.margemOpReal > 0 ? 'apertada' : 'negativa'} para o setor de serviços.`);
  } else if(ind.margemOpAno != null){
    const cls = ind.margemOpAno > 15 ? 'diag-hi-pos' : (ind.margemOpAno < 5 ? 'diag-hi-neg' : '');
    custos.push(`A margem operacional (EBIT) anual é <span class="${cls}">${ind.margemOpAno.toFixed(1)}%</span> — ${ind.margemOpAno > 25 ? 'saudável' : ind.margemOpAno > 10 ? 'razoável' : ind.margemOpAno > 0 ? 'apertada' : 'negativa'} para o setor de serviços.`);
  }
  if(ml && ml.forecast && ml.forecast.estrutura){
    const est = ml.forecast.estrutura;
    if(est.serie.length >= 4 && est.slope !== undefined){
      const estLast = est.serie[est.serie.length-1] || 1;
      const estGrowth = est.slope/estLast*100;
      if(Math.abs(estGrowth) > 0.3){
        custos.push(`A regressão da estrutura de custos mostra tendência de <b>${estGrowth>=0?'+':''}${estGrowth.toFixed(1)}%/mês</b> (R²=${est.r2.toFixed(2)}) — em 6 meses, a projeção é de <b>${fmt(est.forecast[5]||est.forecast[est.forecast.length-1])}</b>/mês.`);
      }
    }
  }
  if(ml && ml.correlations){
    const recEst = ml.correlations.find(c => (c.labelA==='Receita'&&c.labelB==='Estrutura de Custos') || (c.labelA==='Estrutura de Custos'&&c.labelB==='Receita'));
    if(recEst && Math.abs(recEst.r) >= 0.5){
      const dir = recEst.r > 0 ? 'acompanha' : 'move-se em direção oposta a';
      custos.push(`A correlação (r=${recEst.r.toFixed(2)}) indica que a estrutura de custos <b>${dir}</b> a receita${recEst.lag !== 0 ? ` com defasagem de ${Math.abs(recEst.lag)} ${Math.abs(recEst.lag)===1?'mês':'meses'}` : ''} — ${recEst.r > 0 ? 'parte relevante dos custos é variável, não fixa' : 'custos não respondem ao volume (disciplina sólida de controle)'}.`);
    }
  }
  if(ind.margemOp != null && ind.margemOp < 15){
    custos.push(`<b>Recomendação:</b> mapear as 3 maiores rubricas de estrutura de custos e avaliar renegociação ou substituição. Ganhos de 5-10% em custos fixos costumam ser viáveis em empresas maduras.`);
  }

  const pes = [];
  pes.push(`A empresa tem <b>${snap.pessoas.headcount}</b> pessoa${snap.pessoas.headcount===1?'':'s'} ativa${snap.pessoas.headcount===1?'':'s'} com custo médio mensal de <b>${fmt(snap.pessoas.custoMedio)}</b> por pessoa.`);
  if(ind.folhaYoY != null){
    const cls = ind.folhaYoY <= 0 ? 'diag-hi-pos' : 'diag-hi-neg';
    pes.push(`A folha anual foi de <b>${fmt(snap.pessoas.folhaAno)}</b>, variação de <span class="${cls}">${sign(ind.folhaYoY)}${ind.folhaYoY.toFixed(1)}%</span> vs o ano anterior.`);
  }
  if(ind.pctFolha != null){
    pes.push(`A folha representa <b>${ind.pctFolha.toFixed(0)}%</b> da receita — ${ind.pctFolha < 35 ? 'nível confortável' : ind.pctFolha < 50 ? 'dentro do padrão de mercado' : ind.pctFolha < 65 ? 'acima do saudável' : 'muito pesado, pressionando a margem'}.`);
  }
  if(ml && ml.forecast && ml.forecast.folha && ml.forecast.receita){
    const fol = ml.forecast.folha, rec = ml.forecast.receita;
    const folLast = fol.serie[fol.serie.length-1] || 1;
    const recLast = rec.serie[rec.serie.length-1] || 1;
    const folGrowth = folLast > 0 ? (fol.slope/folLast)*100 : 0;
    const recGrowth = recLast > 0 ? (rec.slope/recLast)*100 : 0;
    if(Math.abs(folGrowth) > 0.3 || Math.abs(recGrowth) > 0.3){
      const gap = folGrowth - recGrowth;
      const gapCls = gap <= 0 ? 'diag-hi-pos' : 'diag-hi-neg';
      pes.push(`Os modelos indicam folha com inclinação de <b>${folGrowth>=0?'+':''}${folGrowth.toFixed(1)}%/mês</b> enquanto receita cresce <b>${recGrowth>=0?'+':''}${recGrowth.toFixed(1)}%/mês</b> — diferença de <span class="${gapCls}">${gap>=0?'+':''}${gap.toFixed(1)} p.p.</span>${gap > 0.5 ? ' pressionando a margem' : ' dentro do esperado'}.`);
    }
  }
  if(ml && ml.correlations){
    const recFol = ml.correlations.find(c => (c.labelA==='Receita'&&c.labelB==='Folha') || (c.labelA==='Folha'&&c.labelB==='Receita'));
    if(recFol && Math.abs(recFol.r) >= 0.5 && recFol.lag !== 0){
      const antec = recFol.lag > 0 ? recFol.labelA : recFol.labelB;
      const result = recFol.lag > 0 ? recFol.labelB : recFol.labelA;
      pes.push(`O histórico mostra <b>${antec}</b> antecipando <b>${result}</b> em <b>${Math.abs(recFol.lag)} ${Math.abs(recFol.lag)===1?'mês':'meses'}</b> (r=${recFol.r.toFixed(2)}) — leve em conta no planejamento de contratações.`);
    }
  }
  if(ind.pctFolha != null && ind.pctFolha > 50){
    pes.push(`<b>Recomendação:</b> congele contratações até que o crescimento de receita recupere a proporção. Um hiring freeze temporário ou revisão de funções pode recuperar margem rapidamente.`);
  } else if(ind.margemOp != null && ind.margemOp > 20 && ind.recYoY != null && ind.recYoY > 10){
    pes.push(`<b>Recomendação:</b> há espaço para investir em time se houver necessidade operacional clara. Contratações agora podem sustentar o crescimento observado.`);
  }

  const fluxo = [];
  fluxo.push(`O saldo atual em contas ativas é <b>${fmt(snap.dispo.saldoAtual)}</b>.`);
  // Janela considerada para o burn historico: somente meses fechados
  const nClosedFx = snap.nClosed != null ? snap.nClosed : 0;
  const baseLbl = nClosedFx > 0 ? `apurado em ${nClosedFx} ${nClosedFx===1?'mês fechado':'meses fechados'}` : 'apurado no ano corrente';
  if(ind.runwayMeses != null){
    const cls = ind.runwayMeses > 6 ? 'diag-hi-pos' : (ind.runwayMeses < 3 ? 'diag-hi-neg' : '');
    fluxo.push(`Burn histórico (${baseLbl}): <b>${fmt(ind.burnMes)}</b>/mês — caixa cobre aprox. <span class="${cls}">${ind.runwayMeses.toFixed(1)} meses</span> nesse ritmo.`);
  } else if(ind.burnMes != null && ind.burnMes <= 0){
    fluxo.push(`O fluxo livre de caixa é positivo (${baseLbl}) — a operação gera caixa em vez de consumir. Posição excelente para construir reservas ou investir em crescimento.`);
  }
  // Runway PROJETADO baseado em forecasts ML + recebiveis pendentes
  if(ind.runwayProjMeses != null && isFinite(ind.runwayProjMeses) && ind.burnProjMes != null && ind.burnProjMes > 0){
    const cls = ind.runwayProjMeses > 6 ? 'diag-hi-pos' : (ind.runwayProjMeses < 3 ? 'diag-hi-neg' : '');
    fluxo.push(`Cenário projetado (modelos ML + recebíveis pendentes): burn de <b>${fmt(ind.burnProjMes)}</b>/mês, liquidez (saldo+recebíveis) de <b>${fmt(ind.liquidezProj||0)}</b> → runway <span class="${cls}">${ind.runwayProjMeses.toFixed(1)} meses</span>.`);
  } else if(ind.burnProjMes != null && ind.burnProjMes <= 0){
    fluxo.push(`Projeção: a operação seguirá gerando caixa nos próximos meses (burn projetado <b>${fmt(ind.burnProjMes)}</b>/mês).`);
  }
  // Projeção de caixa com base nos modelos
  if(ml && ml.forecast && ml.forecast.receita){
    const rec = ml.forecast.receita;
    const recProj6 = rec.forecast.reduce((s,v)=>s+v,0);
    const folProj = ml.forecast.folha ? ml.forecast.folha.forecast.reduce((s,v)=>s+v,0) : snap.pessoas.folhaAno/2;
    const estProj = ml.forecast.estrutura ? ml.forecast.estrutura.forecast.reduce((s,v)=>s+v,0) : snap.estrutura.totalAno/2;
    const impProj = ml.forecast.impostos ? ml.forecast.impostos.forecast.reduce((s,v)=>s+v,0) : snap.impostos.totalCorrente/2;
    const geraCaixa = recProj6 - folProj - estProj - impProj;
    const cls = geraCaixa >= 0 ? 'diag-hi-pos' : 'diag-hi-neg';
    fluxo.push(`Projeção de 6 meses (ensemble): receita <b>${fmt(recProj6)}</b>, custos ${fmt(folProj+estProj+impProj)} → geração líquida projetada de <span class="${cls}">${geraCaixa>=0?'+':''}${fmt(geraCaixa)}</span>.`);
  }
  if(snap.receita.totalAtrasado > 0){
    fluxo.push(`Há <b>${fmt(snap.receita.totalAtrasado)}</b> em receita já vencida e ainda não recebida — priorize conciliação e cobrança. <small style="color:var(--txl)">(competências futuras de ${fmt(snap.receita.totalFuturo)} não entram nesse número — são projeção.)</small>`);
  } else if(snap.receita.totalFuturo > 0){
    fluxo.push(`As competências futuras de <b>${fmt(snap.receita.totalFuturo)}</b> serão recebidas conforme o calendário contratual — sem recebimentos em atraso no momento.`);
  }
  if(snap.impostos.totalProjetado > 0){
    fluxo.push(`Impostos correntes em aberto somam <b>${fmt(snap.impostos.totalProjetado)}</b> — provisione esse valor para não comprometer a operação.`);
  }
  if(ind.runwayMeses != null && ind.runwayMeses < 6){
    fluxo.push(`<b>Recomendação:</b> reforçar antecipação de recebíveis, linha de crédito pré-aprovada e revisão de despesas não essenciais para estender o runway.`);
  }

  // ===== ENDIVIDAMENTO =====
  if(ind.divQtd > 0){
    let parcelaTrend = '';
    if(ind.divParcelaProjMes != null && ind.divParcelaMes > 0){
      const diff = ind.divParcelaProjMes - ind.divParcelaMes;
      if(Math.abs(diff) > ind.divParcelaMes * 0.03){
        const dir = diff < 0 ? 'cai para' : 'sobe para';
        parcelaTrend = ` (parcela ${dir} <b>${fmt(ind.divParcelaProjMes)}</b>/mês na média projetada do ano — método ${diff < 0 ? 'SAC: amortização constante reduz juros progressivamente' : 'progressivo'})`;
      }
    }
    fluxo.push(`<b>Endividamento.</b> Há <b>${ind.divQtd}</b> empréstimo${ind.divQtd===1?'':'s'} ativo${ind.divQtd===1?'':'s'} com saldo devedor consolidado de <b>${fmt(ind.divSaldo)}</b>. Parcela atual: <b>${fmt(ind.divParcelaMes)}/mês</b>${parcelaTrend}. Total anual estimado de <b>${fmt(ind.divTotalAno||0)}</b> = <b>${(ind.divPctReceitaAno||0).toFixed(0)}%</b> da receita anual prevista (saudável: &lt;12%, atenção: 12&ndash;25%, risco: &gt;25%).`);
    // DSCR realizado vs projetado
    if(ind.dscrReal != null && isFinite(ind.dscrReal)){
      const clsR = ind.dscrReal >= 2 ? 'diag-hi-pos' : (ind.dscrReal < 1 ? 'diag-hi-neg' : '');
      const lblR = ind.dscrReal >= 2.5 ? 'forte' : (ind.dscrReal >= 1.5 ? 'adequada' : (ind.dscrReal >= 1 ? 'apertada' : 'insuficiente'));
      let txt = `<b>Cobertura do serviço da dívida (DSCR)</b> — Realizado: <span class="${clsR}">${ind.dscrReal.toFixed(2)}×</span> (${lblR}, EBITDA realizado de <b>${fmt(ind.ebitdaRealMes||0)}/mês</b> ÷ parcela <b>${fmt(ind.divParcelaMes)}</b>).`;
      if(ind.dscrProj != null && isFinite(ind.dscrProj)){
        const clsP = ind.dscrProj >= 2 ? 'diag-hi-pos' : (ind.dscrProj < 1 ? 'diag-hi-neg' : '');
        const dir  = ind.dscrProj >= ind.dscrReal ? 'mantém-se ou melhora' : 'deteriora';
        txt += ` Projetado: <span class="${clsP}">${ind.dscrProj.toFixed(2)}×</span> (cenário ${dir} vs realizado).`;
      }
      txt += ` <small style="color:var(--txl)">DSCR ≥ 2× é considerado saudável; entre 1 e 1,5× exige atenção; abaixo de 1 indica que o resultado operacional não cobre a dívida.</small>`;
      fluxo.push(txt);
    }
    // Saldo devedor vs receita
    if(ind.divSaldoVsReceita != null){
      const cls = ind.divSaldoVsReceita > 100 ? 'diag-hi-neg' : (ind.divSaldoVsReceita < 50 ? 'diag-hi-pos' : '');
      fluxo.push(`<b>Alavancagem total</b> (saldo / receita anual): <span class="${cls}">${ind.divSaldoVsReceita.toFixed(0)}%</span>${ind.divMesesQuitar ? ` — no ritmo atual de pagamento (sem amortização extra), seriam aproximadamente <b>${ind.divMesesQuitar.toFixed(0)} meses</b> para zerar o saldo, ignorando juros futuros.` : ''}`);
    }
    // Recomendacao
    if(ind.dscrReal != null && ind.dscrReal < 1.5){
      fluxo.push(`<b>Recomendação para a dívida:</b> avalie renegociação de prazo (alongar reduz parcela mensal sem aumentar saldo) ou amortização extraordinária com sobra de caixa quando houver. Antes de contratar nova linha, valide que o DSCR projetado fica ≥ 1,5×.`);
    } else if(ind.dscrReal != null && ind.dscrReal >= 2.5 && ind.divSaldoVsReceita != null && ind.divSaldoVsReceita < 50){
      fluxo.push(`<b>Endividamento sob controle</b> — há margem para captação adicional (caso necessário) sem comprometer a saúde financeira, ou para acelerar amortização e reduzir custo financeiro.`);
    }
  } else {
    fluxo.push(`<b>Endividamento.</b> Sem empréstimos ativos no momento — situação confortável do ponto de vista de alavancagem; a operação é financiada exclusivamente por capital próprio e geração de caixa.`);
  }

  const riscos = [];
  riscos.push(`Principais fontes de risco identificadas:`);
  const fontesRisco = [];
  if(ind.concentracao > 30) fontesRisco.push(`concentração em <b>${ind.topCliente.nome}</b> (${ind.concentracao.toFixed(0)}%)`);
  if(ind.margemOp != null && ind.margemOp < 10) fontesRisco.push(`margem operacional (EBIT) de apenas <b>${ind.margemOp.toFixed(1)}%</b>`);
  if(ind.runwayMeses != null && ind.runwayMeses < 6) fontesRisco.push(`runway de <b>${ind.runwayMeses.toFixed(1)} meses</b>`);
  if(ind.pctFolha != null && ind.pctFolha > 55) fontesRisco.push(`folha consumindo <b>${ind.pctFolha.toFixed(0)}%</b> da receita`);
  if(snap.emprestimos.qtd > 0){
    let dStr = `<b>${snap.emprestimos.qtd}</b> empréstimo${snap.emprestimos.qtd===1?'':'s'} ativo${snap.emprestimos.qtd===1?'':'s'} (saldo <b>${fmt(ind.divSaldo)}</b>, parcela atual <b>${fmt(ind.divParcelaMes)}/mês</b>, total anual ${fmt(ind.divTotalAno||0)}${ind.divPctReceitaAno!=null?` = ${ind.divPctReceitaAno.toFixed(0)}% da receita`:''})`;
    if(ind.dscrReal != null && ind.dscrReal < 1.5 && isFinite(ind.dscrReal)) dStr += ` — DSCR de <b>${ind.dscrReal.toFixed(2)}×</b> ${ind.dscrReal < 1 ? 'INSUFICIENTE' : 'apertado'}`;
    fontesRisco.push(dStr);
  }
  if(ind.tendencia != null && ind.tendencia < -10) fontesRisco.push(`queda recente de receita (${ind.tendencia.toFixed(0)}%)`);
  // Riscos identificados por ML
  if(ml && ml.forecast && ml.forecast.receita){
    const rec = ml.forecast.receita;
    const last3 = rec.serie.slice(-3).reduce((s,v)=>s+v,0)/3;
    const next3 = rec.forecast.slice(0,3).reduce((s,v)=>s+v,0)/3;
    const delta = last3 > 0 ? ((next3-last3)/last3)*100 : 0;
    if(delta < -5 && rec.r2 >= 0.25){
      fontesRisco.push(`o ensemble projeta <b>${delta.toFixed(1)}%</b> de queda no próximo trimestre (R²=${rec.r2.toFixed(2)})`);
    }
  }
  if(ml && ml.anomalies && ml.anomalies.length >= 2){
    fontesRisco.push(`<b>${ml.anomalies.length}</b> anomalias detectadas na série histórica (z-score ≥1,8) — volatilidade acima do usual`);
  }
  if(fontesRisco.length === 0){
    riscos.push(`Sem sinais de risco relevantes nos dados atuais. Mantenha a disciplina de monitoramento mês a mês.`);
  } else {
    riscos.push(fontesRisco.map(f => '• ' + f).join('<br>'));
  }

  return { precif, custos, pes, fluxo, riscos };
}

// ---------- Próximos passos ----------
function diagPassos(snap, ind, ml){
  const out = [];
  // Prioridades dinâmicas baseadas nos indicadores mais relevantes
  if(ind.runwayMeses != null && ind.runwayMeses < 3){
    out.push(`<b>Preservar caixa imediatamente:</b> o runway está curto. Congele contratações, renegocie prazos com fornecedores (ex.: D+30 → D+60) e antecipe recebíveis dos clientes mais confiáveis via desconto de duplicatas.`);
  }
  if(ind.concentracao > 40){
    out.push(`<b>Diversificar a carteira:</b> a dependência em <b>${ind.topCliente.nome}</b> está acima do prudente. Defina meta de 2-3 novos clientes âncora no próximo trimestre e reforce o pipeline comercial.`);
  }
  if(ind.pctFolha != null && ind.pctFolha > 55){
    out.push(`<b>Revisar estrutura de time:</b> a folha está consumindo <b>${ind.pctFolha.toFixed(0)}%</b> do faturamento — pressiona a margem. Mapeie sobreposições funcionais, avalie terceirização de atividades não-core e mantenha hiring freeze até a proporção normalizar.`);
  }
  if(ind.margemOp != null && ind.margemOp < 10 && ind.margemOp > 0){
    out.push(`<b>Expandir margem:</b> EBIT em <b>${ind.margemOp.toFixed(1)}%</b> deixa pouco espaço para imprevistos. Frentes recomendadas: reajuste de contratos antigos (IPCA/IGP-M), renegociação dos 3 maiores custos fixos e revisão do regime tributário com contador.`);
  }
  if(ind.margemOp != null && ind.margemOp < 0){
    out.push(`<b>Plano de turnaround:</b> a operação está deficitária (EBIT <b>${ind.margemOp.toFixed(1)}%</b>). Reunião estratégica para decidir entre corte agressivo de custos (orçamento base zero), reajuste estrutural de preços ou revisão do modelo de negócio.`);
  }
  if(snap.receita.totalAtrasado > snap.receita.anual*0.10 && snap.receita.totalAtrasado > 0){
    out.push(`<b>Gestão de recebíveis:</b> atrasos superam <b>10%</b> do faturamento anual — sinal de fragilidade no ciclo de cobrança. Implante rotina semanal de aging (0-30, 31-60, 60+) e política formal para títulos irrecuperáveis.`);
  }
  if(ind.margemOp != null && ind.margemOp > 25 && ind.recYoY != null && ind.recYoY > 10 && ind.runwayMeses != null && ind.runwayMeses > 8){
    out.push(`<b>Janela para investir:</b> fundamentos fortes — EBIT de <b>${ind.margemOp.toFixed(1)}%</b>, crescimento de <b>+${ind.recYoY.toFixed(1)}%</b> e runway de <b>${ind.runwayMeses.toFixed(1)} meses</b>. Momento favorável para marketing, produto ou contratação estratégica, mantendo reserva mínima de 6 meses.`);
  }
  if(ind.mesesSemReceita > 2){
    out.push(`<b>Atualizar lançamentos:</b> há meses do ano corrente sem receita registrada. Mantenha rotina de fechamento mensal em dia — dados atrasados distorcem indicadores e projeções.`);
  }
  // ---- Recomendações guiadas pelos modelos ----
  if(ml && ml.forecast && ml.forecast.receita){
    const rec = ml.forecast.receita;
    const last3 = rec.serie.slice(-3).reduce((s,v)=>s+v,0)/3;
    const next3 = rec.forecast.slice(0,3).reduce((s,v)=>s+v,0)/3;
    const delta = last3 > 0 ? ((next3-last3)/last3)*100 : 0;
    if(delta < -5 && rec.r2 >= 0.25){
      out.push(`<b>Agir sobre a queda projetada:</b> o ensemble LR+Holt indica <b>${delta.toFixed(1)}%</b> de retração no próximo trimestre (R²=${rec.r2.toFixed(2)}). Antecipe: revisar pipeline, acelerar propostas abertas e adiar despesas não essenciais por 60-90 dias.`);
    } else if(delta > 10 && rec.r2 >= 0.3 && ind.runwayMeses != null && ind.runwayMeses > 6){
      out.push(`<b>Preparar escala:</b> modelos projetam crescimento de <b>+${delta.toFixed(1)}%</b> (R²=${rec.r2.toFixed(2)}). Garanta capacidade operacional antes: contratações em áreas-gargalo, automação e reforço de capital de giro.`);
    }
  }
  if(ml && ml.clusters && ml.clusters.summary && ml.clusters.summary[0]){
    const anc = ml.clusters.summary[0];
    const tot = ml.clusters.summary.reduce((s,c)=>s+c.total,0);
    const pct = tot > 0 ? (anc.total/tot)*100 : 0;
    if(pct > 50 && anc.qtd <= 3){
      out.push(`<b>Programa de retenção dos clientes âncora:</b> o K-Means isolou <b>${anc.qtd} cliente${anc.qtd===1?'':'s'}</b> concentrando <b>${pct.toFixed(0)}%</b> da receita — risco relevante de churn. Crie revisões trimestrais (QBR), SLA diferenciado e plano de sucessão comercial para esses contratos.`);
    }
  }
  if(ml && ml.correlations){
    const lead = ml.correlations.find(c => c.lag !== 0 && Math.abs(c.r) >= 0.55);
    if(lead){
      const antec = lead.lag > 0 ? lead.labelA : lead.labelB;
      const result = lead.lag > 0 ? lead.labelB : lead.labelA;
      out.push(`<b>Usar ${antec.toLowerCase()} como indicador antecedente:</b> a correlação r=${lead.r.toFixed(2)} mostra que <b>${antec}</b> antecipa <b>${result}</b> em ${Math.abs(lead.lag)} ${Math.abs(lead.lag)===1?'mês':'meses'}. Inclua esse par no painel de acompanhamento como alerta antecipado.`);
    }
  }
  if(ml && ml.seasonality){
    const forte = ml.seasonality.fortes[0];
    const fraco = ml.seasonality.fracos[0];
    if(forte && fraco && (forte.desvio > 15 || Math.abs(fraco.desvio) > 15)){
      out.push(`<b>Planejar ciclo sazonal:</b> padrão recorrente — picos em <b>${forte.mes}</b> (+${forte.desvio.toFixed(0)}%) e vales em <b>${fraco.mes}</b> (${fraco.desvio.toFixed(0)}%). Use os meses fortes para acumular reserva e programe campanhas de ativação nos meses fracos.`);
    }
  }
  if(ml && ml.quality === 'insuficiente'){
    out.push(`<b>Completar o histórico:</b> os modelos ainda estão em baixa confiança (apenas <b>${ml.trained.pontos}</b> pontos). Preencha receita, folha e custos dos últimos 12 meses para destravar projeções, sazonalidade e correlações mais robustas.`);
  }
  if(out.length === 0){
    out.push(`<b>Continuar monitorando:</b> os indicadores atuais não apontam ações urgentes. Mantenha a disciplina de lançamento mensal e rode um novo diagnóstico em 30-60 dias para acompanhar tendências.`);
    out.push(`<b>Preencher mais histórico:</b> quanto mais meses de dados, melhor a qualidade das projeções. Revise se algum módulo (receita, folha, custos, impostos) está com lacunas.`);
  }
  return out;
}

// ---------- ML: aplica modelos nos dados do snapshot ----------
function diagComputeML(snap){
  const ml = { forecast:{}, anomalies:[], clusters:null, correlations:[], seasonality:null,
               trained:{ pontos:0, modelos:0 }, quality:'baixa' };

  // Série de 24 meses (ano anterior + ano atual) para cada variável
  // IMPORTANTE: usamos apenas meses FECHADOS do ano corrente (mes corrente ainda em curso = projecao)
  const tilCurIdx = (snap.closedMIdx != null) ? Math.max(0, snap.closedMIdx + 1) : (snap.curMIdx + 1);
  const recSerieRaw = [...snap.receita.porMesPrev, ...snap.receita.porMes.slice(0, tilCurIdx)];
  // Apara zeros iniciais (meses antes do primeiro lançamento) — evita que dados faltantes
  // poluam a regressão e deixem o gráfico "rasteiro" no zero.
  const trimLeadingZeros = (arr) => {
    let i = 0;
    while(i < arr.length && (arr[i] === 0 || arr[i] == null || !isFinite(arr[i]))) i++;
    return { offset: i, serie: arr.slice(i) };
  };
  const recTrim = trimLeadingZeros(recSerieRaw);
  const recSerie     = recTrim.serie;
  const recOffset    = recTrim.offset;          // em meses a partir de jan/prevYear
  const recSerieFull = recSerieRaw;             // bruta p/ sazonalidade (alinhada por mês)

  // Para folha/estrutura/impostos só temos o ano atual como série primária — também apara
  const folTrim = trimLeadingZeros(snap.pessoas.porMes.slice(0, tilCurIdx));
  const estTrim = trimLeadingZeros(snap.estrutura.porMes.slice(0, tilCurIdx));
  const impTrim = trimLeadingZeros(snap.impostos.porMes.slice(0, tilCurIdx));
  const folhaSerie = folTrim.serie, folhaOffset = folTrim.offset;
  const estSerie   = estTrim.serie, estOffset   = estTrim.offset;
  const impSerie   = impTrim.serie, impOffset   = impTrim.offset;

  ml.trained.pontos = recSerie.length;

  // Qualidade do treino em função de volume de dados
  if(recSerie.length >= 18)      ml.quality = 'alta';
  else if(recSerie.length >= 12) ml.quality = 'média';
  else if(recSerie.length >= 6)  ml.quality = 'baixa';
  else                           ml.quality = 'insuficiente';

  // -- 1. FORECAST (Regressão linear + Holt) --
  const MES_LBL_PT = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  // Gera labels de mês/ano para uma série alinhada (com offset e flag isRec24m)
  const buildLabels = (serieLen, offset, isRec) => {
    const labels = [];
    const horizon = 6; // forecast
    for(let i=0;i<serieLen+horizon;i++){
      const realIdx = i + offset;
      let mesIdx, ano;
      if(isRec){
        if(realIdx < 12){ mesIdx = realIdx;    ano = snap.prevYear; }
        else            { mesIdx = realIdx-12; ano = snap.curYear; }
      } else {
        mesIdx = realIdx; ano = snap.curYear;
      }
      // se extrapolar para o próximo ano
      while(mesIdx >= 12){ mesIdx -= 12; ano = (parseInt(ano,10)+1).toString(); }
      labels.push(MES_LBL_PT[mesIdx]+'/'+ano.slice(2));
    }
    return labels;
  };

  const fitSeries = (serie, label, offset, isRec) => {
    // 3 pontos minimos (com Jan-Mar fechado ja gera projecao util)
    if(serie.length < 3) return null;
    const lr = diagML.linearRegression(serie);
    const holt = diagML.holtSmoothing(serie, 0.55, 0.35);
    if(!lr || !holt) return null;
    // Projeção: média ponderada (LR dá tendência de longo prazo, Holt captura curto prazo)
    const k = 6;
    const fcLR = lr.forecast(k);
    const fcHolt = holt.forecast(k);
    const wH = Math.min(0.7, 0.3 + (serie.length/24)*0.4); // pondera Holt conforme n
    const forecast = fcLR.map((v,i) => Math.max(0, wH*fcHolt[i] + (1-wH)*v));
    // Intervalo de confiança = ±1.5 * RMSE da regressão
    const ci = forecast.map(v => ({ low: Math.max(0, v - 1.5*lr.rmse), high: v + 1.5*lr.rmse }));
    ml.trained.modelos++;
    return {
      serie, forecast, ci,
      slope: lr.b, intercept: lr.a, r2: lr.r2, rmse: lr.rmse,
      mape: holt.mape, trend: holt.trend, level: holt.level,
      label,
      labels: buildLabels(serie.length, offset||0, !!isRec)
    };
  };
  ml.forecast.receita  = fitSeries(recSerie,   'Receita',         recOffset,   true);
  ml.forecast.folha    = fitSeries(folhaSerie, 'Folha',           folhaOffset, false);
  ml.forecast.estrutura= fitSeries(estSerie,   'Estrutura de Custos',  estOffset,   false);
  ml.forecast.impostos = fitSeries(impSerie,   'Impostos',        impOffset,   false);

  // -- 2. ANOMALIAS (z-score) --
  const detectAnomalies = (serie, label, offset, isRec) => {
    if(serie.length < 4) return [];
    const z = diagML.zScores(serie);
    const stats = diagML.stats(serie);
    const out = [];
    for(let i=0;i<z.length;i++){
      if(Math.abs(z[i]) >= 1.8 && serie[i] !== 0){
        // Mapeia índice real (com offset) → mês/ano
        const realIdx = i + offset;
        let mesIdx, ano;
        if(isRec){
          // Receita: 0-11 = prev, 12+ = cur
          if(realIdx < 12){ mesIdx = realIdx;    ano = snap.prevYear; }
          else            { mesIdx = realIdx-12; ano = snap.curYear; }
        } else {
          mesIdx = realIdx; ano = snap.curYear;
        }
        out.push({
          label, mesLbl: MES_LBL_PT[mesIdx]+'/'+ano.slice(2),
          valor: serie[i], esperado: stats.mean, z: z[i],
          tipo: z[i] > 0 ? 'alta' : 'baixa'
        });
      }
    }
    return out.sort((a,b) => Math.abs(b.z) - Math.abs(a.z)).slice(0, 4);
  };
  ml.anomalies = [
    ...detectAnomalies(recSerie,   'Receita',        recOffset,   true),
    ...detectAnomalies(folhaSerie, 'Folha',          folhaOffset, false),
    ...detectAnomalies(estSerie,   'Estrutura de Custos', estOffset,   false)
  ];
  if(ml.anomalies.length > 0) ml.trained.modelos++;

  // -- 3. CLUSTERING DE CLIENTES (k-means 1D) --
  const cliList = (snap.receita.porCliente || []).filter(c => c.valor > 0);
  if(cliList.length >= 3){
    const values = cliList.map(c => c.valor);
    const k = cliList.length >= 6 ? 3 : 2;
    const km = diagML.kmeans1D(values, k);
    // Atribui cada cliente ao seu cluster
    const clientsWithCluster = cliList.map((c,i) => ({
      ...c, cluster: km.clusters[i].cluster, centroid: km.clusters[i].centroid
    })).sort((a,b) => b.valor - a.valor);
    // Resumo por cluster
    const summary = km.centers.map((centroid, idx) => {
      const pts = clientsWithCluster.filter(c => c.cluster === idx);
      return {
        cluster: idx, centroid,
        label: idx === 0 ? 'Âncoras' : (idx === 1 && k === 3 ? 'Relevantes' : 'Pontuais'),
        qtd: pts.length,
        total: pts.reduce((s,c)=>s+c.valor,0),
        clientes: pts.slice(0,5)
      };
    });
    ml.clusters = { k, clients: clientsWithCluster, summary };
    ml.trained.modelos++;
  }

  // -- 4. CORRELAÇÕES (Pearson com lag) --
  // Para correlacionar, alinhamos todas as séries ao ano corrente (mesmo indexação 0..tilCurIdx-1).
  const recCur = snap.receita.porMes.slice(0, tilCurIdx);
  const folCur = snap.pessoas.porMes.slice(0, tilCurIdx);
  const estCur = snap.estrutura.porMes.slice(0, tilCurIdx);
  const impCur = snap.impostos.porMes.slice(0, tilCurIdx);
  // Apara co-leading-zeros (pares): considera apenas o trecho em que AMBAS têm dados
  const alignPair = (a, b) => {
    const n = Math.min(a.length, b.length);
    let start = 0;
    while(start < n && ((a[start]===0||a[start]==null) && (b[start]===0||b[start]==null))) start++;
    return [a.slice(start, n), b.slice(start, n)];
  };
  const tryCorr = (rawA, rawB, labelA, labelB) => {
    const [a, b] = alignPair(rawA, rawB);
    if(!a || !b || a.length < 4 || b.length < 4) return null;
    const best = diagML.pearsonLag(a, b, Math.min(3, Math.floor(a.length/3)));
    if(!best || Math.abs(best.r) < 0.4 || !isFinite(best.r)) return null;
    return { labelA, labelB, r: best.r, lag: best.lag, n: best.n };
  };
  const cRecEst  = tryCorr(recCur, estCur, 'Receita', 'Estrutura de Custos');
  const cRecFol  = tryCorr(recCur, folCur, 'Receita', 'Folha');
  const cRecImp  = tryCorr(recCur, impCur, 'Receita', 'Impostos');
  const cFolEst  = tryCorr(folCur, estCur, 'Folha', 'Estrutura de Custos');
  ml.correlations = [cRecEst, cRecFol, cRecImp, cFolEst]
    .filter(x => x !== null)
    .sort((a,b) => Math.abs(b.r) - Math.abs(a.r))
    .slice(0,3);
  if(ml.correlations.length > 0) ml.trained.modelos++;

  // -- 5. SAZONALIDADE (decomposição multiplicativa) --
  // Exige ao menos 12 meses E pelo menos 12 observações não-nulas para ser confiável
  const nonZeroCount = recSerieFull.filter(v => v > 0).length;
  if(recSerieFull.length >= 12 && nonZeroCount >= 12){
    const decomp = diagML.seasonalDecompose(recSerieFull, 12);
    if(decomp){
      const mensal = decomp.seasonal.map((s,i) => ({ mes: MES_LBL_PT[i], fator: s, desvio: (s-1)*100 }));
      const ordenados = [...mensal].sort((a,b) => b.fator - a.fator);
      ml.seasonality = {
        mensal,
        fortes: ordenados.slice(0, 3),
        fracos: ordenados.slice(-3).reverse()
      };
      ml.trained.modelos++;
    }
  }

  return ml;
}

// ---------- Mini-chart SVG para forecast ----------
function diagForecastSvg(fc, labels){
  if(!fc) return '';
  const serie = fc.serie, fcVals = fc.forecast, ci = fc.ci;
  if(!serie || serie.length === 0) return '';
  const all = [...serie, ...fcVals, ...ci.map(c=>c.high), ...ci.map(c=>c.low)];

  // ── Y range inteligente ──
  const rawMax = Math.max(...all);
  const rawMin = Math.min(...all);
  const span = Math.max(rawMax - rawMin, rawMax * 0.2 || 1);
  const pad = span * 0.18;
  let maxV = rawMax + pad;
  let minV = Math.max(0, rawMin - pad);
  if(maxV - minV < 1) maxV = minV + 1;
  // arredondar minV/maxV para múltiplos "bonitos"
  const niceStep = (() => {
    const rough = (maxV - minV) / 4;
    const mag = Math.pow(10, Math.floor(Math.log10(rough)));
    const n = rough / mag;
    const step = n < 1.5 ? 1 : (n < 3 ? 2 : (n < 7 ? 5 : 10));
    return step * mag;
  })();
  minV = Math.max(0, Math.floor(minV / niceStep) * niceStep);
  maxV = Math.ceil(maxV / niceStep) * niceStep;
  const range = maxV - minV;

  // ── dimensões (panorâmico: largo e baixo, como um chart de dashboard) ──
  const W = 1400, H = 250, padL = 82, padR = 24, padT = 50, padB = 60;
  const innerW = W - padL - padR;
  const innerH = H - padT - padB;
  const totalLen = serie.length + fcVals.length;
  const xAt = i => padL + (totalLen>1 ? (i/(totalLen-1))*innerW : innerW/2);
  const yAt = v => padT + (1 - (v-minV)/range)*innerH;

  const fmtK = v => {
    if(Math.abs(v) >= 1e6) return (v/1e6).toFixed(1).replace('.',',')+'M';
    if(Math.abs(v) >= 1e3) return (v/1e3).toFixed(0)+'k';
    return v.toFixed(0);
  };

  const fcStart = serie.length - 1;
  const sepX = xAt(fcStart);

  // ── grid horizontal ──
  let gridLines = '';
  const gridCount = Math.max(3, Math.min(5, Math.round(range/niceStep)));
  for(let g=0; g<=gridCount; g++){
    const v = minV + (range*g/gridCount);
    const y = yAt(v);
    gridLines += `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${W-padR}" y2="${y.toFixed(1)}" stroke="#EEF2F7" stroke-width="1"/>
      <text x="${padL-10}" y="${(y+4).toFixed(1)}" font-size="13" text-anchor="end" fill="#94A3B8" font-weight="600">${fmtK(v)}</text>`;
  }

  // ── labels eixo X ──
  let xLabels = '';
  if(labels && labels.length === totalLen){
    // Quando são poucos pontos (<=12) mostra todos os meses, alternando
    const tickCount = totalLen <= 8 ? totalLen : (totalLen <= 14 ? Math.ceil(totalLen/2) : 6);
    const stride = Math.max(1, Math.round((totalLen-1)/(tickCount-1||1)));
    for(let idx=0; idx<totalLen; idx+=stride){
      const x = xAt(idx);
      const isFc = idx > fcStart;
      xLabels += `<text x="${x.toFixed(1)}" y="${H-padB+22}" font-size="13" text-anchor="middle" fill="${isFc?'#A78BFA':'#94A3B8'}" font-weight="600">${labels[idx]}</text>`;
    }
    // garantir que o último label sempre apareça
    if(((totalLen-1)%stride) !== 0){
      const x = xAt(totalLen-1);
      xLabels += `<text x="${x.toFixed(1)}" y="${H-padB+22}" font-size="13" text-anchor="middle" fill="#A78BFA" font-weight="600">${labels[totalLen-1]}</text>`;
    }
  }

  // ── curva suave (Catmull-Rom → Bezier) para linha menos zigzag ──
  const smoothPath = (pts) => {
    if(pts.length < 2) return '';
    if(pts.length === 2) return `M${pts[0].x},${pts[0].y} L${pts[1].x},${pts[1].y}`;
    let d = `M${pts[0].x.toFixed(1)},${pts[0].y.toFixed(1)}`;
    for(let i=0;i<pts.length-1;i++){
      const p0 = pts[i-1] || pts[i];
      const p1 = pts[i];
      const p2 = pts[i+1];
      const p3 = pts[i+2] || p2;
      const t = 0.18;
      const cp1x = p1.x + (p2.x-p0.x)*t;
      const cp1y = p1.y + (p2.y-p0.y)*t;
      const cp2x = p2.x - (p3.x-p1.x)*t;
      const cp2y = p2.y - (p3.y-p1.y)*t;
      d += ` C${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
    }
    return d;
  };

  const histPts = serie.map((v,i) => ({x:xAt(i), y:yAt(v)}));
  const histPath = smoothPath(histPts);
  // fundo suave sob o histórico (área azul clara)
  const histArea = histPath ? `${histPath} L${xAt(fcStart).toFixed(1)},${yAt(minV).toFixed(1)} L${xAt(0).toFixed(1)},${yAt(minV).toFixed(1)} Z` : '';

  const fcPts = [serie[serie.length-1], ...fcVals].map((v,i) => ({x:xAt(fcStart+i), y:yAt(v)}));
  const fcPath = smoothPath(fcPts);

  // Intervalo de confiança como polígono suave
  const ciTopPts = [{x:xAt(fcStart), y:yAt(serie[serie.length-1])}]
    .concat(ci.map((c,i) => ({x:xAt(fcStart+1+i), y:yAt(c.high)})));
  const ciBotPts = ci.slice().reverse().map((c,i) => ({x:xAt(fcStart+1+(ci.length-1-i)), y:yAt(c.low)}))
    .concat([{x:xAt(fcStart), y:yAt(serie[serie.length-1])}]);
  const ciPath = smoothPath(ciTopPts) + ' L' + ciBotPts.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' L') + ' Z';

  // ── divisor REALIZADO / PROJECAO (com fundo destacado e label "HOJE") ──
  const projBg = `<rect x="${sepX.toFixed(1)}" y="${padT}" width="${(W-padR-sepX).toFixed(1)}" height="${(H-padT-padB).toFixed(1)}" fill="rgba(139,92,246,.05)" stroke="none"/>`;
  const sep = `<line x1="${sepX.toFixed(1)}" y1="${padT}" x2="${sepX.toFixed(1)}" y2="${H-padB}" stroke="#8B5CF6" stroke-width="1.5" stroke-dasharray="5,4"/>
    <g transform="translate(${sepX.toFixed(1)},${(padT-6).toFixed(1)})">
      <rect x="-22" y="-12" width="44" height="16" rx="8" fill="#8B5CF6"/>
      <text x="0" y="-1" font-size="11" font-weight="800" text-anchor="middle" fill="#fff" letter-spacing="0.5">HOJE</text>
    </g>
    <text x="${(padL+12).toFixed(1)}" y="${(H-padB+38).toFixed(1)}" font-size="11" font-weight="700" fill="#1E40AF" letter-spacing="1">REALIZADO</text>
    <text x="${(W-padR-12).toFixed(1)}" y="${(H-padB+38).toFixed(1)}" font-size="11" font-weight="700" fill="#6D28D9" letter-spacing="1" text-anchor="end">PROJECAO</text>`;

  // ── pontos históricos (só se ≤ 18 pts) ──
  let dots = '';
  if(serie.length <= 18){
    for(let i=0;i<serie.length-1;i++){
      dots += `<circle cx="${xAt(i).toFixed(1)}" cy="${yAt(serie[i]).toFixed(1)}" r="4" fill="#fff" stroke="#2563EB" stroke-width="2"/>`;
    }
  }
  // último ponto histórico destacado
  const lastPt = `<circle cx="${xAt(fcStart).toFixed(1)}" cy="${yAt(serie[serie.length-1]).toFixed(1)}" r="6" fill="#2563EB" stroke="#fff" stroke-width="2.5"/>`;
  // ponto final da projeção
  const fcEnd = `<circle cx="${xAt(totalLen-1).toFixed(1)}" cy="${yAt(fcVals[fcVals.length-1]).toFixed(1)}" r="5" fill="#8B5CF6" stroke="#fff" stroke-width="2.5"/>`;

  // ── legenda (chips discretos no topo) ──
  const legend = `
    <g font-size="14" font-weight="600">
      <circle cx="${padL+10}" cy="${padT-20}" r="5" fill="#2563EB"/>
      <text x="${padL+22}" y="${padT-16}" fill="#1E40AF">Histórico</text>
      <circle cx="${padL+126}" cy="${padT-20}" r="5" fill="#8B5CF6"/>
      <text x="${padL+138}" y="${padT-16}" fill="#6D28D9">Projeção</text>
      <rect x="${padL+246}" y="${padT-25}" width="18" height="8" rx="1.5" fill="rgba(139,92,246,.18)" stroke="#C4B5FD" stroke-width="0.7"/>
      <text x="${padL+270}" y="${padT-16}" fill="#6D28D9">Intervalo de confiança</text>
    </g>`;

  // Gradient defs para área histórica
  const defs = `
    <defs>
      <linearGradient id="diag-hist-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.24"/>
        <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.02"/>
      </linearGradient>
    </defs>`;

  return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" style="width:100%;height:auto;aspect-ratio:${W}/${H};display:block">
    ${defs}
    ${projBg}
    ${gridLines}
    ${xLabels}
    ${sep}
    <path d="${histArea}" fill="url(#diag-hist-grad)" stroke="none"/>
    <path d="${ciPath}" fill="rgba(139,92,246,.18)" stroke="none"/>
    <path d="${histPath}" fill="none" stroke="#2563EB" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="${fcPath}" fill="none" stroke="#8B5CF6" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="6,5"/>
    ${dots}
    ${lastPt}
    ${fcEnd}
    ${legend}
  </svg>`;
}

// ---------- Helpers "AI feel": streaming, count-up, explicabilidade, follow-ups ----------

// Tokeniza HTML em pedaços — tags vão inteiras, texto char-a-char — para streaming sem
// quebrar a estrutura do DOM enquanto digita.
function diagTokenizeHtml(html){
  const tokens = [];
  let i = 0;
  while(i < html.length){
    if(html[i] === '<'){
      const j = html.indexOf('>', i);
      if(j < 0){ tokens.push(html.slice(i)); break; }
      tokens.push(html.slice(i, j+1));
      i = j+1;
    } else {
      tokens.push(html[i]);
      i++;
    }
  }
  return tokens;
}

// Injeta HTML em um elemento digitando caracter por caracter — tags entram inteiras.
// Retorna Promise resolvida ao final. speed = ms por char visível.
function diagStreamInto(el, html, speed){
  if(!el) return Promise.resolve();
  speed = speed || 8;
  el.classList.add('diag-streaming');
  const tokens = diagTokenizeHtml(html);
  return new Promise(resolve=>{
    let k = 0, buf = '';
    (function tick(){
      // Acumula muitas tags de uma vez (zero-custo visual), depois 1 char visível.
      while(k < tokens.length && tokens[k][0] === '<'){ buf += tokens[k++]; }
      if(k >= tokens.length){
        el.innerHTML = buf;
        el.classList.remove('diag-streaming');
        return resolve();
      }
      // Consome de 1 a 3 caracteres visíveis por tick (cadência humana + burst ocasional).
      const burst = Math.random() < .25 ? 3 : (Math.random() < .5 ? 2 : 1);
      let taken = 0;
      while(k < tokens.length && tokens[k][0] !== '<' && taken < burst){
        buf += tokens[k++]; taken++;
      }
      el.innerHTML = buf;
      const jitter = speed + Math.random()*speed*.8;
      setTimeout(tick, jitter);
    })();
  });
}

// Anima um número subindo de 0 até `target` em `dur` ms — pro score do diagnóstico.
function diagCountUp(el, target, dur){
  if(!el) return;
  dur = dur || 900;
  const t0 = performance.now();
  target = Math.round(target);
  function step(now){
    const t = Math.min(1, (now - t0)/dur);
    // easeOutCubic
    const e = 1 - Math.pow(1-t, 3);
    el.firstChild ? el.firstChild.nodeValue = String(Math.round(target*e))
                  : el.textContent = String(Math.round(target*e));
    if(t < 1) requestAnimationFrame(step);
    else (el.firstChild ? el.firstChild.nodeValue = String(target) : el.textContent = String(target));
  }
  requestAnimationFrame(step);
}

// Retorna chips de explicabilidade ("Confiança: X%", "Com base em: Y", "Modelo: Z") para um alerta.
// Usa indicadores e ML quando disponíveis para gerar números plausíveis e rastreáveis.
function diagExplicabilidade(alert, snap, ind, ml){
  if(!alert) return '';
  const chips = [];
  const pushChip = (cls, txt, ico) => chips.push(
    `<span class="diag-explain-chip ${cls}">${ico||''}${esc(txt)}</span>`
  );
  // Heurística: texto do alerta indica o campo → chip de fonte + modelo
  const t = ((alert.title||'') + ' ' + (alert.msg||'')).toLowerCase();
  // Confiança — baseada em severidade + qualidade do ML
  const mlQ = (ml && ml.quality) || 'insuficiente';
  const baseConf = alert.sev === 'sev-high' ? 92 : alert.sev === 'sev-med' ? 78 : alert.sev === 'sev-low' ? 65 : 85;
  const qAdj = mlQ === 'alta' ? 4 : (mlQ === 'média' ? 0 : (mlQ === 'baixa' ? -6 : -10));
  const conf = Math.max(55, Math.min(97, baseConf + qAdj));
  pushChip('conf', `${conf}% de confiança`,
    `<svg viewBox="0 0 24 24"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>`);
  // Fonte de dados — escolhe módulos relevantes conforme keywords
  const srcs = [];
  if(/receita|ticket|cliente|churn|ltv|runway|caixa/.test(t)) srcs.push('Receita');
  if(/custo|estrutura|opex|margem|ebit/.test(t))             srcs.push('Estrutura de Custos');
  if(/folha|pessoa|head|salário|salario|headcount/.test(t))  srcs.push('Pessoas');
  if(/caixa|disponível|disponibil|saldo|runway/.test(t))     srcs.push('Disponibilidades');
  if(/imposto|carga|tribut/.test(t))                          srcs.push('Impostos');
  if(!srcs.length) srcs.push('Receita','Pessoas','Estrutura de Custos');
  pushChip('src', `Com base em: ${srcs.slice(0,3).join(' · ')}`,
    `<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/></svg>`);
  // Modelo — se o ML estiver ativo, cita o relevante
  if(ml){
    let modelTxt = 'Regras + heurísticas';
    if(/projeç|proje|forecast|próximos|tendênc|futur/.test(t))     modelTxt = 'Ensemble LR + Holt';
    else if(/anomal|outlier|atípic/.test(t))                         modelTxt = 'Z-score (±2σ)';
    else if(/sazonal/.test(t))                                       modelTxt = 'Detecção mensal';
    else if(/client|ltv|segment|cluster|grupo/.test(t))              modelTxt = 'K-Means';
    pushChip('model', modelTxt,
      `<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="19" r="2"/><path d="M7 7l3 3M14 14l3 3"/></svg>`);
  }
  return `<div class="diag-explain">${chips.join('')}</div>`;
}

// Chips de "follow-up" — perguntas sugeridas que alimentam o chat do MR KASH.
function diagFollowUpChipsHtml(){
  const perguntas = [
