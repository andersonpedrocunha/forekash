async function extBulkBaixar(){
  const ids = [..._extSelected];
  if(ids.length === 0) return;
  const all = _extCollect();
  const pendentes = ids.filter(id => {
    const it = all.find(x => x.id === id);
    return it && it.status === 'pendente';
  });
  if(pendentes.length === 0){
    if(typeof toast === 'function') toast('Nenhum item pendente entre os selecionados');
    return;
  }
  const ok = await _dkbConfirm({
    icon: '✓',
    title: 'Dar baixa em ' + pendentes.length + ' lançamento(s)?',
    html: 'Os <b>' + pendentes.length + '</b> lançamento(s) pendente(s) serão marcados como <b>Pago/Recebido</b>, usando hoje como data de pagamento e <b>sem registrar conta/banco específicos</b>.<br><br>Para registrar detalhes (conta, juros, etc.), abra cada lançamento individualmente.'
      + (pendentes.length < ids.length ? '<div class="dkb-confirm-meta">⚠ ' + (ids.length - pendentes.length) + ' já estavam pagos e serão ignorados.</div>' : ''),
    okText: 'Sim, dar baixa em todos',
    cancelText: 'Cancelar'
  });
  if(!ok) return;
  let count = 0;
  const today = new Date().toISOString().slice(0,10);
  for(const id of pendentes){
    try {
      if(id.startsWith('m:')){
        const realId = parseInt(id.replace(/^m:/,''),10);
        const l = (extratoData.lancamentos||[]).find(x => x.id === realId);
        if(l){ l.status = 'pago'; l.dataPagamento = today; count++; }
      } else if(id.startsWith('rec:')){
        const parts = id.split(':');
        const y = parseInt(parts[1],10), rowId = parseInt(parts[2],10), mAbbr = parts[3];
        const cell = receita?.years?.[y]?.clients?.find(r => r.id === rowId)?.meses?.[mAbbr];
        if(cell){ cell.status = 'recebido'; cell.dataRecebimento = today; count++; }
      } else if(id.startsWith('dkb:')){
        const parts = id.split(':');
        const ctxId = parts[1], itemId = parts.slice(2, parts.length-1).join(':'), ym = parts[parts.length-1];
        const ad = DKB_ADAPTERS[ctxId];
        if(ad){
          const it = (ad.items() || []).find(x => String(x.id) === itemId || x.id === parseInt(itemId,10));
          if(it){ ad.setPago(it, ym, true); const meta = _dkbMeta(it, ym); meta.dataPagamento = today; count++; }
        }
      } else if(id.startsWith('loan:')){
        const parts = id.split(':');
        const loanId = parseInt(parts[1],10), idx = parseInt(parts[2],10);
        const ln = (typeof loans !== 'undefined' && Array.isArray(loans)) ? loans.find(x => x.id === loanId) : null;
        if(ln){
          const pagas = parseInt(ln.parcelasPagas,10) || 0;
          if(idx === pagas){ ln.parcelasPagas = idx + 1; count++; }
        }
      }
    } catch(e){ console.warn('bulk baixar:', id, e); }
  }
  if(typeof receitaSave === 'function') receitaSave();
  if(typeof estSave === 'function') estSave();
  if(typeof pessoasSave === 'function') pessoasSave();
  if(typeof impSave === 'function') impSave();
  if(typeof saveData === 'function') saveData();
  _extSave();
  extBulkLimpar();
  renderExtrato();
  if(typeof toast === 'function') toast('✓ ' + count + ' lançamento(s) baixado(s)');
}
