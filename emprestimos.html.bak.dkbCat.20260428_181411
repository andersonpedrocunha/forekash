    .fk-sheet-table td.open{color:#D97706;font-weight:600}
    .fk-sheet-table td.sim{background:#EDE9FE;color:#6D28D9;font-weight:600}
    .fk-sheet-table td.total{background:#F3F4F6;font-weight:800;color:#0F172A;border-top:1px solid #E5E7EB}
