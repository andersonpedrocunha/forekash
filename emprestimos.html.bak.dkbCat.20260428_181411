// ─── Tags de Fornecedor (helpers) ───
function _wfFornTagColor(text){
  let h = 0;
  for(const c of (text||'')) h = (h*31 + c.charCodeAt(0)) >>> 0;
  const hue = h % 360;
  return { bg: 'hsl(' + hue + ',60%,92%)', fg: 'hsl(' + hue + ',55%,28%)' };
}
function _wfFornTagsCellHtml(p){
  const tags = Array.isArray(p.tags) ? p.tags : [];
  const chips = tags.map((t, i) => {
    const c = _wfFornTagColor(t);
    return '<span class="wf-forn-tag" style="background:' + c.bg + ';color:' + c.fg + '">'
      + '<span class="wf-forn-tag-txt" onclick="event.stopPropagation();wfFornEditTag(' + p.id + ',' + i + ')" title="Editar">' + _bdEsc(t) + '</span>'
      + '<button class="wf-forn-tag-rm" onclick="event.stopPropagation();wfFornDelTag(' + p.id + ',' + i + ')" title="Remover">×</button>'
      + '</span>';
  }).join('');
  const addBtn = '<button class="wf-forn-tag-add" onclick="wfFornAddTag(' + p.id + ')" title="Adicionar tag">+</button>';
  return '<div class="wf-forn-tags-cell">' + chips + addBtn + '</div>';
}
// ─── Pool global de tags (todas as tags já usadas em todos os fornecedores) ───
function _wfFornAllTags(){
  const set = new Set();
  for(const p of pesRegistry()){
    if(Array.isArray(p.tags)) for(const t of p.tags) if(t) set.add(t);
  }
  return Array.from(set).sort((a,b) => a.localeCompare(b, 'pt'));
}

// ─── Tag Picker (modal customizado com sugestões) ───
let _wfTpCtx = null; // { pid, mode: 'add'|'edit', idx?, atual? }

function wfTpOpen(ctx){
  _wfTpCtx = ctx;
  const p = pesRegistry().find(x => x.id === ctx.pid);
  if(!p) return;
  const ov = document.getElementById('wf-tp-ov');
  if(!ov) return;
  if(ov.parentElement !== document.body) document.body.appendChild(ov);
  document.getElementById('wf-tp-title').textContent = ctx.mode === 'edit' ? 'Editar tag' : 'Adicionar tag';
  document.getElementById('wf-tp-sub').textContent = 'Para: ' + (p.nome || 'fornecedor');
  const inp = document.getElementById('wf-tp-input');
  inp.value = ctx.mode === 'edit' ? (ctx.atual || '') : '';
  ov.style.display = 'flex';
  setTimeout(() => { inp.focus(); inp.select(); }, 30);
  wfTpFilter();
}
function wfTpClose(){
  const ov = document.getElementById('wf-tp-ov');
  if(ov) ov.style.display = 'none';
  _wfTpCtx = null;
}
function wfTpFilter(){
  if(!_wfTpCtx) return;
  const ctx = _wfTpCtx;
  const p = pesRegistry().find(x => x.id === ctx.pid);
  if(!p) return;
  const q = (document.getElementById('wf-tp-input')?.value || '').trim().toLowerCase();
  const allTags = _wfFornAllTags();
  // Tags já usadas neste fornecedor (exceto a sendo editada)
  const usadas = new Set(p.tags || []);
  if(ctx.mode === 'edit' && ctx.atual) usadas.delete(ctx.atual);
  const sugestoes = allTags.filter(t => !usadas.has(t) && (q === '' || t.toLowerCase().includes(q)));
  const list = document.getElementById('wf-tp-list');
  const empty = document.getElementById('wf-tp-empty');
  const lbl   = document.getElementById('wf-tp-suggest-lbl');
  if(sugestoes.length === 0){
    list.innerHTML = '';
    if(allTags.length === 0){ empty.style.display = 'block'; lbl.style.display = 'none'; }
    else { empty.style.display = 'none'; lbl.style.display = 'block'; lbl.textContent = q ? 'Nenhuma tag corresponde — pressione Enter para criar' : 'Sugestões'; }
  } else {
    empty.style.display = 'none';
    lbl.style.display = 'block';
    lbl.textContent = q ? 'Sugestões (' + sugestoes.length + ')' : 'Sugestões existentes (' + sugestoes.length + ')';
    list.innerHTML = sugestoes.map((t, i) => {
      const c = _wfFornTagColor(t);
      // Conta em quantos fornecedores essa tag aparece
      const usedBy = pesRegistry().filter(x => Array.isArray(x.tags) && x.tags.includes(t)).length;
      return '<button class="wf-tp-chip" style="background:' + c.bg + ';color:' + c.fg + '" data-tp-idx="' + i + '" onclick="wfTpPickSuggestByIdx(' + i + ')">'
        + '<span class="wf-tp-chip-txt">' + _bdEsc(t) + '</span>'
        + '<span class="wf-tp-chip-cnt">' + usedBy + '</span>'
        + '</button>';
    }).join('');
    // Cache as sugestões pra resolver via índice
    _wfTpCtx._suggestCache = sugestoes;
  }
  // Atualiza label do botão
  const btn = document.getElementById('wf-tp-create');
  const txt = (document.getElementById('wf-tp-input')?.value || '').trim();
  if(!txt){
    btn.textContent = ctx.mode === 'edit' ? 'Remover tag' : 'Confirmar';
    btn.disabled = ctx.mode !== 'edit';
  } else {
    const exists = allTags.includes(txt);
    btn.textContent = exists ? 'Aplicar "' + txt + '"' : 'Criar nova: "' + txt + '"';
    btn.disabled = false;
  }
}
function wfTpPickSuggest(text){
  const inp = document.getElementById('wf-tp-input');
  if(inp){ inp.value = text; }
  wfTpConfirm();
}
function wfTpPickSuggestByIdx(idx){
  if(!_wfTpCtx || !Array.isArray(_wfTpCtx._suggestCache)) return;
  const text = _wfTpCtx._suggestCache[idx];
  if(text == null) return;
  wfTpPickSuggest(text);
}
try { window.wfTpPickSuggestByIdx = wfTpPickSuggestByIdx; } catch(e){}
function wfTpConfirm(){
  if(!_wfTpCtx) return;
  const ctx = _wfTpCtx;
  const p = pesRegistry().find(x => x.id === ctx.pid);
  if(!p) return;
  if(!Array.isArray(p.tags)) p.tags = [];
  const txt = (document.getElementById('wf-tp-input')?.value || '').trim();
  if(ctx.mode === 'add'){
    if(!txt) return;
    if(p.tags.includes(txt)){ if(typeof toast === 'function') toast('⚠ Tag já existe neste fornecedor'); return; }
    p.tags.push(txt);
  } else if(ctx.mode === 'edit'){
    if(!txt){
      // Vazio = remove
      p.tags.splice(ctx.idx, 1);
    } else if(txt !== ctx.atual){
      if(p.tags.includes(txt)){ if(typeof toast === 'function') toast('⚠ Tag já existe neste fornecedor'); return; }
      p.tags[ctx.idx] = txt;
    }
  }
  if(typeof pessoasSave === 'function') pessoasSave();
  wfTpClose();
  renderWfFornecedores();
}
function wfTpKey(ev){
  if(ev.key === 'Escape'){ ev.preventDefault(); wfTpClose(); }
  else if(ev.key === 'Enter'){ ev.preventDefault(); wfTpConfirm(); }
}
try {
  window.wfTpClose = wfTpClose;
  window.wfTpFilter = wfTpFilter;
  window.wfTpPickSuggest = wfTpPickSuggest;
  window.wfTpConfirm = wfTpConfirm;
  window.wfTpKey = wfTpKey;
} catch(e){}

