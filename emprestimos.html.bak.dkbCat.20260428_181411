// Retorna o registro efetivado de saldo mais recente ANTES de uma data
// (só considera meses EFETIVADOS — desefetivados voltam pra projeção).
function getRegBase(loan, beforeDate){
  const regs = (loan.registros||[])
    .filter(r => r.saldoEfetivado !== '' && r.saldoEfetivado != null
              && typeof isMesEfetivado === 'function' && isMesEfetivado(r.mes)
              && new Date(r.mes+'-01T00:00:00') < beforeDate)
    .sort((a,b) => b.mes.localeCompare(a.mes));
  if(!regs.length) return null;
  return {saldo: parseFloat(regs[0].saldoEfetivado)||0, date: new Date(regs[0].mes+'-01T00:00:00')};
}

// Projeta o saldo de um empréstimo a partir de um ponto base até uma data alvo
function projectFromBase(loan, baseSaldo, baseDate, targetDate){
  const mDiff=(targetDate.getFullYear()-baseDate.getFullYear())*12+(targetDate.getMonth()-baseDate.getMonth());
  if(mDiff<=0)return baseSaldo;
  if(baseSaldo===0)return 0;
  const parcela=parseFloat(loan.parcelaVal)||0;
  const taxa=parseFloat(loan.taxa)||0;
  const r=taxa/100;
  const termino=loan.termino?new Date(loan.termino+'T00:00:00'):null;
  if(termino&&targetDate>termino)return 0;
  if(parcela===0)return baseSaldo;
  if(r===0)return Math.max(0,baseSaldo-parcela*mDiff);
  if(isSACEngine(loan.tipo)){
    const mRest=termino
      ?Math.max(1,(termino.getFullYear()-baseDate.getFullYear())*12+(termino.getMonth()-baseDate.getMonth()))
      :null;
    const amort=mRest?baseSaldo/(mRest+1):Math.max(0,parcela-baseSaldo*r);
    return Math.max(0,baseSaldo-amort*mDiff);
  }
  const factor=Math.pow(1+r,mDiff);
  return Math.max(0,baseSaldo*factor-(parcela*(factor-1))/r);
}

function buildTimeline(){
  if(loans.length===0)return{labels:[],data:[],isRegistrado:[],isCurrent:[]};

  const today=new Date(); today.setDate(1); today.setHours(0,0,0,0);

  // Data inicial = mês mais antigo com registro efetivado passado (ou hoje)
  // — só considera meses EFETIVADOS.
  let minDate=new Date(today);
  loans.forEach(l=>{
    (l.registros||[]).forEach(r=>{
      if(r.saldoEfetivado===''||r.saldoEfetivado==null)return;
      if(typeof isMesEfetivado==='function' && !isMesEfetivado(r.mes))return;
      const d=new Date(r.mes+'-01T00:00:00');
      if(d<today && d<minDate)minDate=d; // só meses já encerrados
    });
  });

  // Data final = maior termino, cap 10 anos
  let maxDate=new Date(today);
  loans.forEach(l=>{
    if(!l.termino)return;
    const d=new Date(l.termino+'T00:00:00');
    if(d>maxDate)maxDate=d;
  });
  const cap=new Date(today); cap.setFullYear(cap.getFullYear()+10);
  if(maxDate>cap)maxDate=cap;

  const labels=[],totals=[],isRegistrado=[],isCurrent=[];
  const cur=new Date(minDate);

  while(cur<=maxDate){
    const mesStr=cur.getFullYear()+'-'+(cur.getMonth()+1).toString().padStart(2,'0');
    labels.push(cur.toLocaleDateString('pt-BR',{month:'short',year:'2-digit'}));

    const isCurrentMes  = cur.getTime() === today.getTime();
    let total=0, regCount=0;

    loans.forEach(l=>{
      // Mês EFETIVADO (passado, atual OU futuro) com saldoEfetivado → usa registro
      const totEf = _flxRegEfetivadoTotais(l, mesStr);
      if(totEf && totEf.hasSaldo){
        total += totEf.saldo;
        regCount++;
        return;
      }
      // Projeção — ancora no registro efetivado mais recente antes deste mês
      const base=getRegBase(l,cur);
      if(base) total+=projectFromBase(l,base.saldo,base.date,cur);
      else { const s=parseFloat(l.saldo)||0; if(s>0) total+=projectFromBase(l,s,today,cur); }
    });

    totals.push(Math.round(total*100)/100);
    isRegistrado.push(loans.length>0 && regCount===loans.length);
    isCurrent.push(isCurrentMes);
    cur.setMonth(cur.getMonth()+1);
    if(totals.length>1&&totals[totals.length-1]===0)break;
  }
  return{labels,data:totals,isRegistrado,isCurrent};
}

// ── Parcela timeline (SAC decrescente + Price/custom fixo + registros) ──
function buildParcelaTimeline(){
  if(loans.length===0) return {labels:[], data:[], isRegistrado:[]};

  const today=new Date(); today.setDate(1); today.setHours(0,0,0,0);

  // Data inicial = mês mais antigo com registro de parcela efetivada PASSADO (ou hoje)
  // — só considera meses EFETIVADOS.
  let minDate=new Date(today);
  loans.forEach(l=>{
    (l.registros||[]).forEach(r=>{
      if(r.parcelaEfetivada===''||r.parcelaEfetivada==null)return;
      if(typeof isMesEfetivado==='function' && !isMesEfetivado(r.mes))return;
      const d=new Date(r.mes+'-01T00:00:00');
      if(d<today && d<minDate)minDate=d;
    });
  });

  // Data final = maior termino, cap 10 anos
  let maxDate=new Date(today);
  loans.forEach(l=>{
    if(!l.termino)return;
    const d=new Date(l.termino+'T00:00:00');
    if(d>maxDate)maxDate=d;
  });
  const cap=new Date(today); cap.setFullYear(cap.getFullYear()+10);
  if(maxDate>cap)maxDate=cap;

  // Pré-calcula estado inicial de cada empréstimo
  const loanStates=loans.map(l=>{
    const saldo  =parseFloat(l.saldo)    ||0;
    const parcela=parseFloat(l.parcelaVal)||0;
    const taxa   =parseFloat(l.taxa)     ||0;
    const termino=l.termino?new Date(l.termino+'T00:00:00'):null;
    let amortConst=0;
    if(isSACEngine(l.tipo)&&parcela>0&&saldo>0){
      if(termino){
        const mRest=(termino.getFullYear()-today.getFullYear())*12+(termino.getMonth()-today.getMonth());
        amortConst=mRest>0?saldo/(mRest+1):Math.max(0,parcela-saldo*(taxa/100));
      } else {
        amortConst=Math.max(0,parcela-saldo*(taxa/100));
      }
    }
    return {l,saldo,parcela,taxa,termino,amortConst};
  });

  const labels=[],data=[],isRegistrado=[],isCurrent=[];
  const cur=new Date(minDate);

  while(cur<=maxDate){
    const mesStr=cur.getFullYear()+'-'+(cur.getMonth()+1).toString().padStart(2,'0');
    labels.push(cur.toLocaleDateString('pt-BR',{month:'short',year:'2-digit'}));
    const mDiff=(cur.getFullYear()-today.getFullYear())*12+(cur.getMonth()-today.getMonth());
    const isPast       = cur.getTime() < today.getTime();
    const isCurrentMes = cur.getTime() === today.getTime();
    let total=0, regCount=0;

    loanStates.forEach(({l,saldo,parcela,taxa,termino,amortConst})=>{
      const totEf = _flxRegEfetivadoTotais(l, mesStr);
      if(totEf && totEf.hasParcela){
        // Mês EFETIVADO com parcela registrada: usa valor efetivado (main + extras)
        total += totEf.parcela;
        regCount++;
      } else {
        // Mês atual / futuro / passado sem registro: projeção
        if(parcela===0)return;
        if(termino&&cur>termino)return;
        // Carência: se empréstimo tem "início" e o mês atual é antes, não conta parcela
        if(l.inicio){
          try {
            const iniD = new Date(l.inicio+'T00:00:00');
            const iniMes = new Date(iniD.getFullYear(), iniD.getMonth(), 1);
            if(cur < iniMes) return;
          } catch(e){}
        }
        if(mDiff===0){
          total+=parcela;
        } else if(isSACEngine(l.tipo)&&amortConst>0){
          const saldoFut=Math.max(0,saldo-amortConst*mDiff);
          total+=saldoFut>0?amortConst+saldoFut*(taxa/100):0;
        } else {
          total+=parcela;
        }
      }
    });

    data.push(Math.round(total*100)/100);
    isRegistrado.push(loans.length>0 && regCount===loans.length);
    isCurrent.push(isCurrentMes);
    cur.setMonth(cur.getMonth()+1);
    if(data.length>1&&data[data.length-1]===0)break;
  }

  return {labels,data,isRegistrado,isCurrent};
}

