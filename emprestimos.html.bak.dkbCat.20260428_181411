// Garante que existe uma row em pessoas.people no ano corrente vinculada ao registry pid
function _wfCadEnsurePesRow(pid){
  if(typeof pessoas === 'undefined' || !pessoas) return null;
  if(!Array.isArray(pessoas.people)) pessoas.people = [];
  if(!Array.isArray(pessoas.tipos) || pessoas.tipos.length === 0) return null;
  // Procura row existente (não simulação) com este pessoaId
  let row = pessoas.people.find(p => p.pessoaId === pid && !p.sim);
  if(row) return row;
  // Cria nova row
  const reg = pesRegistry().find(r => r.id === pid);
  if(!reg) return null;
  if(!pessoas.nextId) pessoas.nextId = 1;
  row = {
    id: pessoas.nextId++,
    pessoaId: pid,
    nome: reg.nome || '',
    ativo: true,
    tipoId: pessoas.tipos[0].id,
    salarios: {},
    sim: false
  };
  pessoas.people.push(row);
  if(typeof pessoasSave === 'function') pessoasSave();
  return row;
}

