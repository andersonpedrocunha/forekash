// ─── Tag filter (multi-select) pra Colaboradores e Fornecedores ───
const _wfTagFilter = { colaboradores: new Set(), fornecedores: new Set() };
const _wfTagSearch = { colaboradores: '', fornecedores: '' };

function _wfTagFilterUniqueTags(kind){
  const allReg = (typeof pesRegistry === 'function') ? pesRegistry() : [];
  const targetKind = (kind === 'colaboradores') ? 'colaborador' : 'fornecedor';
  const map = new Map(); // tag -> count
  for(const r of allReg){
    if(targetKind === 'colaborador' && r.kind !== 'colaborador') continue;
    if(targetKind === 'fornecedor' && r.kind === 'colaborador') continue;
    if(!Array.isArray(r.tags)) continue;
    for(const t of r.tags){
      const k = String(t || '').trim();
      if(!k) continue;
      map.set(k, (map.get(k) || 0) + 1);
    }
  }
  // Mantém apenas seleções que ainda existem
  const sel = _wfTagFilter[kind];
  for(const t of Array.from(sel)){ if(!map.has(t)) sel.delete(t); }
  // Ordena alfabeticamente
  const arr = Array.from(map.entries()).map(([t,c]) => ({tag:t, count:c}));
  arr.sort((a,b) => a.tag.localeCompare(b.tag, 'pt', { sensitivity:'base' }));
  return arr;
}
function _wfTagFilterRender(kind){
  const wrap = document.getElementById(kind === 'colaboradores' ? 'wf-colab-tagf' : 'wf-forn-tagf');
  if(!wrap) return;
  const tags = _wfTagFilterUniqueTags(kind);
  const sel = _wfTagFilter[kind];
  const search = (_wfTagSearch[kind] || '').toLowerCase().trim();
  const filtered = search ? tags.filter(t => t.tag.toLowerCase().includes(search)) : tags;
  const escFn = (s) => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  // Botão
  let btnInner;
  if(sel.size === 0){
    btnInner = '<span class="ic">🏷</span><span>Todas as tags</span>';
  } else if(sel.size === 1){
    const only = Array.from(sel)[0];
    btnInner = '<span class="ic">🏷</span><span>' + escFn(only) + '</span>';
  } else {
    btnInner = '<span class="ic">🏷</span><span>Tags</span><span class="badge">' + sel.size + '</span>';
  }
  // Lista
  let optsHtml = '';
  if(filtered.length === 0){
    optsHtml = '<div class="wf-tagf-empty">' + (search ? 'Nenhuma tag encontrada' : 'Nenhuma tag cadastrada ainda') + '</div>';
  } else {
    for(const t of filtered){
      const isSel = sel.has(t.tag);
      const safe = t.tag.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
      optsHtml += '<button type="button" class="wf-tagf-opt' + (isSel ? ' is-sel' : '') + '" '
        + 'onclick="event.stopPropagation();_wfTagToggle(\'' + kind + '\',\'' + safe + '\')">'
        + '<span class="chk"></span>'
        + '<span class="nm">' + escFn(t.tag) + '</span>'
        + '<span class="cnt">' + t.count + '</span>'
        + '</button>';
    }
  }
  wrap.innerHTML = '<button type="button" class="wf-tagf-btn" onclick="event.stopPropagation();_wfTagFilterToggle(\'' + kind + '\')">'
    + btnInner + '<span class="caret">▾</span>'
    + '</button>'
    + '<div class="wf-tagf-list" hidden>'
      + '<div class="wf-tagf-search"><input type="text" placeholder="Buscar tag..." oninput="_wfTagSearchInput(\'' + kind + '\',this.value)" onclick="event.stopPropagation()" onkeydown="event.stopPropagation()" value="' + escFn(_wfTagSearch[kind] || '') + '"></div>'
      + '<div class="wf-tagf-actions">'
        + '<button type="button" onclick="event.stopPropagation();_wfTagSelectAll(\'' + kind + '\')">Selecionar todas</button>'
        + '<button type="button" onclick="event.stopPropagation();_wfTagClear(\'' + kind + '\')">Limpar</button>'
      + '</div>'
      + '<div class="wf-tagf-options">' + optsHtml + '</div>'
    + '</div>';
}
function _wfTagFilterToggle(kind){
  const wrap = document.getElementById(kind === 'colaboradores' ? 'wf-colab-tagf' : 'wf-forn-tagf');
  if(!wrap) return;
  const list = wrap.querySelector('.wf-tagf-list');
  const btn = wrap.querySelector('.wf-tagf-btn');
  if(!list) return;
  // Fecha outros
  document.querySelectorAll('.wf-tagf-list').forEach(l => {
    if(l !== list){
      l.setAttribute('hidden','');
      const b = l.parentElement && l.parentElement.querySelector('.wf-tagf-btn');
      if(b) b.classList.remove('is-open');
    }
  });
  const opening = list.hasAttribute('hidden');
  if(opening){
    list.removeAttribute('hidden');
    if(btn) btn.classList.add('is-open');
    setTimeout(() => {
      const off = (e) => {
        if(wrap.contains(e.target)) return;
        list.setAttribute('hidden','');
        if(btn) btn.classList.remove('is-open');
        _wfTagSearch[kind] = '';
        document.removeEventListener('mousedown', off);
      };
      document.addEventListener('mousedown', off);
    }, 0);
  } else {
    list.setAttribute('hidden','');
    if(btn) btn.classList.remove('is-open');
    _wfTagSearch[kind] = '';
  }
}
function _wfTagToggle(kind, tag){
  const sel = _wfTagFilter[kind];
  if(sel.has(tag)) sel.delete(tag);
  else sel.add(tag);
  // Re-renderiza só o dropdown (sem fechar)
  _wfTagFilterRender(kind);
  // Re-render da lista
  if(kind === 'colaboradores') renderWfColaboradores();
  else renderWfFornecedores();
  // Reabre dropdown
  setTimeout(() => {
    const wrap = document.getElementById(kind === 'colaboradores' ? 'wf-colab-tagf' : 'wf-forn-tagf');
    const list = wrap && wrap.querySelector('.wf-tagf-list');
    const btn = wrap && wrap.querySelector('.wf-tagf-btn');
    if(list){ list.removeAttribute('hidden'); if(btn) btn.classList.add('is-open'); }
  }, 0);
}
function _wfTagSearchInput(kind, val){
  _wfTagSearch[kind] = val || '';
  _wfTagFilterRender(kind);
  // Re-foca o input
  setTimeout(() => {
    const wrap = document.getElementById(kind === 'colaboradores' ? 'wf-colab-tagf' : 'wf-forn-tagf');
    const list = wrap && wrap.querySelector('.wf-tagf-list');
    const btn = wrap && wrap.querySelector('.wf-tagf-btn');
    if(list){ list.removeAttribute('hidden'); if(btn) btn.classList.add('is-open'); }
    const inp = wrap && wrap.querySelector('.wf-tagf-search input');
    if(inp){ inp.focus(); try { inp.setSelectionRange(inp.value.length, inp.value.length); } catch(e){} }
  }, 0);
}
function _wfTagSelectAll(kind){
  const tags = _wfTagFilterUniqueTags(kind);
  const search = (_wfTagSearch[kind] || '').toLowerCase().trim();
  const filtered = search ? tags.filter(t => t.tag.toLowerCase().includes(search)) : tags;
  const sel = _wfTagFilter[kind];
  for(const t of filtered) sel.add(t.tag);
  if(kind === 'colaboradores') renderWfColaboradores();
  else renderWfFornecedores();
  setTimeout(() => {
    const wrap = document.getElementById(kind === 'colaboradores' ? 'wf-colab-tagf' : 'wf-forn-tagf');
    const list = wrap && wrap.querySelector('.wf-tagf-list');
    const btn = wrap && wrap.querySelector('.wf-tagf-btn');
    if(list){ list.removeAttribute('hidden'); if(btn) btn.classList.add('is-open'); }
  }, 0);
}
function _wfTagClear(kind){
  _wfTagFilter[kind].clear();
  if(kind === 'colaboradores') renderWfColaboradores();
  else renderWfFornecedores();
  setTimeout(() => {
    const wrap = document.getElementById(kind === 'colaboradores' ? 'wf-colab-tagf' : 'wf-forn-tagf');
    const list = wrap && wrap.querySelector('.wf-tagf-list');
    const btn = wrap && wrap.querySelector('.wf-tagf-btn');
    if(list){ list.removeAttribute('hidden'); if(btn) btn.classList.add('is-open'); }
  }, 0);
}
try {
  window._wfTagFilterToggle = _wfTagFilterToggle;
  window._wfTagToggle = _wfTagToggle;
  window._wfTagSearchInput = _wfTagSearchInput;
  window._wfTagSelectAll = _wfTagSelectAll;
  window._wfTagClear = _wfTagClear;
} catch(e){}

function renderWfFornecedores(){
  const body = document.getElementById('wf-forn-body');
  if(!body) return;
  const search = (document.getElementById('wf-forn-search')?.value || '').toLowerCase().trim();
  const filter = _wfCadFilters.fornecedores || 'all';
  const allReg = (typeof pesRegistry === 'function') ? pesRegistry() : [];
  // Filtra somente kind != 'colaborador' (entries sem kind contam como fornecedor — fallback de migração)
  const all = allReg.filter(p => p.kind !== 'colaborador');
  let list = search
    ? all.filter(p => (p.nome||'').toLowerCase().includes(search))
    : all.slice();
  // Conta uso em pessoas.people pra mostrar se está ativo no ano
  const peopleByPesId = {};
  try {
    if(typeof pessoas !== 'undefined' && Array.isArray(pessoas.people)){
      for(const p of pessoas.people){
        const k = String(p.pessoaId || 0);
        if(!peopleByPesId[k]) peopleByPesId[k] = [];
        peopleByPesId[k].push(p);
      }
    }
  } catch(e){}
  if(filter === 'active')   list = list.filter(p => _wfCadAtivoForn(p, peopleByPesId));
  if(filter === 'inactive') list = list.filter(p => !_wfCadAtivoForn(p, peopleByPesId));
  // Filtro por tags
  const selTags = _wfTagFilter.fornecedores;
  if(selTags && selTags.size > 0){
    list = list.filter(p => Array.isArray(p.tags) && p.tags.some(t => selTags.has(t)));
  }
  list.sort((a,b) => (a.nome||'').localeCompare(b.nome||'','pt'));
  const cnt = document.getElementById('wf-forn-count');
  if(cnt) cnt.textContent = '(' + all.length + ')';
  // Atualiza dropdown de tags
  try { _wfTagFilterRender('fornecedores'); } catch(e){}
  if(list.length === 0){
    body.innerHTML = '<div class="wf-cad-empty"><span class="ico">🏢</span>'
      + '<div class="title">' + (search ? 'Nenhum fornecedor encontrado' : (selTags.size > 0 ? 'Nenhum fornecedor com essas tags' : 'Nenhum fornecedor cadastrado')) + '</div>'
      + '<div class="sub">' + (search ? 'Ajuste o termo de busca' : (selTags.size > 0 ? 'Limpe ou ajuste o filtro de tags' : 'Clique em + Novo fornecedor pra começar')) + '</div></div>';
    return;
  }
  let html = '<table class="wf-cad-table"><thead><tr>'
    + '<th>Fornecedor</th><th>CNPJ / CPF</th><th>Tags</th><th>Status</th><th></th>'
    + '</tr></thead><tbody>';
  for(const p of list){
    if(!Array.isArray(p.tags)) p.tags = [];
    const initials = (p.nome||'?').trim().split(/\s+/).slice(0,2).map(s => s[0]||'').join('').toUpperCase() || '?';
    const ava = p.foto
      ? '<img src="' + p.foto + '" alt="" class="wf-cad-ava">'
      : '<span class="wf-cad-ava-ini" style="background:#10B981">' + initials + '</span>';
    const ativo = (p.ativo !== false);
    // Documento conforme tipoPessoa
    let doc = '—';
    const fmtCnpj = (v) => { const d = String(v||'').replace(/\D/g,''); return (d.length === 14) ? d.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5') : (v||''); };
    const fmtCpf  = (v) => { const d = String(v||'').replace(/\D/g,''); return (d.length === 11) ? d.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/, '$1.$2.$3-$4') : (v||''); };
    if(p.tipoPessoa === 'pj' && p.cnpj) doc = fmtCnpj(p.cnpj);
    else if(p.tipoPessoa === 'pf' && p.cpf) doc = fmtCpf(p.cpf);
    else if(p.tipoPessoa === 'est' && p.taxId) doc = p.taxId;
    else if(p.cnpj) doc = fmtCnpj(p.cnpj);
    else if(p.cpf) doc = fmtCpf(p.cpf);
    else if(p.documento){
      // Heurística: se tiver 14 dígitos é CNPJ, 11 é CPF
      const digits = String(p.documento).replace(/\D/g,'');
      if(digits.length === 14) doc = fmtCnpj(digits);
      else if(digits.length === 11) doc = fmtCpf(digits);
      else doc = p.documento;
    }
    const tagsCell = _wfFornTagsCellHtml(p);
    html += '<tr>'
      + '<td><div class="wf-cad-name-cell">' + ava + '<div class="wf-cad-name">' + _bdEsc(p.nome||'(sem nome)') + '</div></div></td>'
      + '<td style="font-family:Menlo,Consolas,monospace;font-size:.78rem;color:#64748B">' + _bdEsc(doc) + '</td>'
      + '<td>' + tagsCell + '</td>'
      + '<td><span class="wf-cad-status-btn ' + (ativo ? 'is-on' : 'is-off') + '" title="Status do fornecedor">' + (ativo ? '● Ativo' : '○ Inativo') + '</span></td>'
      + '<td><div class="wf-cad-actions">'
      +     '<button class="wf-cad-link" onclick="wfCadEditFornecedor(' + p.id + ')">✎ Editar</button>'
      +     '<button class="wf-cad-del" onclick="wfCadDeleteFornecedor(' + p.id + ')" title="Excluir fornecedor">🗑</button>'
      +   '</div></td>'
      + '</tr>';
  }
  html += '</tbody></table>';
  body.innerHTML = html;
}
try { window.renderWfFornecedores = renderWfFornecedores; } catch(e){}

// ─── Render Colaboradores (registry com kind='colaborador') ───
function renderWfColaboradores(){
  const body = document.getElementById('wf-colab-body');
  if(!body) return;
  const search = (document.getElementById('wf-colab-search')?.value || '').toLowerCase().trim();
  const filter = _wfCadFilters.colaboradores || 'all';
  const allReg = (typeof pesRegistry === 'function') ? pesRegistry() : [];
  const all = allReg.filter(p => p.kind === 'colaborador');
  let list = search
    ? all.filter(p => (p.nome||'').toLowerCase().includes(search))
    : all.slice();
  const peopleByPesId = {};
  try {
    if(typeof pessoas !== 'undefined' && Array.isArray(pessoas.people)){
      for(const pp of pessoas.people){
        const k = String(pp.pessoaId || 0);
        if(!peopleByPesId[k]) peopleByPesId[k] = [];
        peopleByPesId[k].push(pp);
      }
    }
  } catch(e){}
  if(filter === 'active')   list = list.filter(p => _wfCadAtivoForn(p, peopleByPesId));
  if(filter === 'inactive') list = list.filter(p => !_wfCadAtivoForn(p, peopleByPesId));
  // Filtro por tags
  const selTags = _wfTagFilter.colaboradores;
  if(selTags && selTags.size > 0){
    list = list.filter(p => Array.isArray(p.tags) && p.tags.some(t => selTags.has(t)));
  }
  list.sort((a,b) => (a.nome||'').localeCompare(b.nome||'','pt'));
  const cnt = document.getElementById('wf-colab-count');
  if(cnt) cnt.textContent = '(' + all.length + ')';
  try { _wfTagFilterRender('colaboradores'); } catch(e){}
  if(list.length === 0){
    body.innerHTML = '<div class="wf-cad-empty"><span class="ico">👥</span>'
      + '<div class="title">' + (search ? 'Nenhum colaborador encontrado' : (selTags.size > 0 ? 'Nenhum colaborador com essas tags' : 'Nenhum colaborador cadastrado')) + '</div>'
      + '<div class="sub">' + (search ? 'Ajuste o termo de busca' : (selTags.size > 0 ? 'Limpe ou ajuste o filtro de tags' : 'Adicione no módulo Pessoas ou clique em + Novo colaborador')) + '</div></div>';
    return;
  }
  let html = '<table class="wf-cad-table"><thead><tr>'
    + '<th>Pessoa</th><th>Tipo</th><th>Tags</th><th>Linhas folha</th><th>Status</th><th></th>'
    + '</tr></thead><tbody>';
  for(const p of list){
    if(!Array.isArray(p.tags)) p.tags = [];
    const initials = (p.nome||'?').trim().split(/\s+/).slice(0,2).map(s => s[0]||'').join('').toUpperCase() || '?';
    const ava = p.foto
      ? '<img src="' + p.foto + '" alt="" class="wf-cad-ava">'
      : '<span class="wf-cad-ava-ini" style="background:#7C3AED">' + initials + '</span>';
    const rows = peopleByPesId[String(p.id)] || [];
    const tipos = new Set();
    let temAtivo = false;
    for(const r of rows){
      if(r.tipoId) tipos.add(r.tipoId);
      if(r.ativo !== false && !r.sim) temAtivo = true;
    }
    const tipoNomes = Array.from(tipos).map(tid => {
      const t = (typeof pesTipo === 'function') ? pesTipo(tid) : null;
      return t ? t.nome : tid;
    }).join(' · ') || '—';
    const tagsCell = (typeof _wfFornTagsCellHtml === 'function') ? _wfFornTagsCellHtml(p) : '—';
    html += '<tr>'
      + '<td><div class="wf-cad-name-cell">' + ava + '<div class="wf-cad-name">' + _bdEsc(p.nome||'(sem nome)') + '</div></div></td>'
      + '<td>' + _bdEsc(tipoNomes) + '</td>'
      + '<td>' + tagsCell + '</td>'
      + '<td>' + rows.length + ' linha(s)</td>'
      + '<td><span class="wf-cad-status-btn ' + (temAtivo ? 'is-on' : 'is-off') + '" title="Status (gerenciado pelo módulo Pessoas)">' + (temAtivo ? '● Ativo' : '○ Inativo') + '</span></td>'
      + '<td><div class="wf-cad-actions">'
      +     '<button class="wf-cad-link" onclick="wfCadEditFornecedor(' + p.id + ')">✎ Editar</button>'
      +     '<button class="wf-cad-del" onclick="wfCadDeleteFornecedor(' + p.id + ')" title="Excluir colaborador">🗑</button>'
      +   '</div></td>'
      + '</tr>';
  }
  html += '</tbody></table>';
  body.innerHTML = html;
}
try { window.renderWfColaboradores = renderWfColaboradores; } catch(e){}

